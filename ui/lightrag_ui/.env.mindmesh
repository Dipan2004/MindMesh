# MindMesh integration config for the LightRAG WebUI
# Copy this to .env.development to point the UI at MindMesh's backend
#
# MindMesh runs on port 8000; LightRAG default was 9621.
# The API prefix is empty (MindMesh serves at root).
VITE_BACKEND_URL=http://localhost:8000
VITE_API_PROXY=true
VITE_API_ENDPOINTS=/api,/documents,/graphs,/graph,/health,/query,/docs,/redoc,/openapi.json,/login,/auth-status,/auth/verify,/ui/customization,/static
