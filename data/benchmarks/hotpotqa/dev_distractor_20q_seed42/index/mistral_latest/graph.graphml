  <data key="d1">[{"text": "A former Brazilian basketball player, often considered one of the greatest female basketball players in Brazil and regarded as one of the world's greatest female basketball players of all time.", "chunk_id": "1321686acc66e514", "doc_id": "hp_83fa8f93997d337a"}]</data>
  <data key="d2">[{"text": "Hortência Marcari is a former basketball player who is often considered to be one of the greatest female basketball players in Brazil, along with Paula, and regarded by specialists as one of the world's greatest female basketball players of all time.", "chunk_id": "1321686acc66e514", "doc_id": "hp_83fa8f93997d337a"}]</data>
