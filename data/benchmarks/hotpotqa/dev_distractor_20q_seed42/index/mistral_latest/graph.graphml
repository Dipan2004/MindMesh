</node>
<node id="mixed choir a cappella">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A choir consisting of both male and female singers without instrumental accompaniment.", "chunk_id": "f75b53e3e77141e7", "doc_id": "hp_857bd66259cbd40e"}]</data>
  <data key="d2">[{"text": "by Johannes Brahms. Composed in 1888 when Brahms was a 55-year-old bachelor,", "chunk_id": "f75b53e3e77141e7", "doc_id": "hp_857bd66259cbd40e"}]</data>
  <data key="d3">["hp_857bd66259cbd40e"]</data>
  <data key="d4">False</data>
</node>
<node id="1888">
  <data key="d0">EVENT</data>
