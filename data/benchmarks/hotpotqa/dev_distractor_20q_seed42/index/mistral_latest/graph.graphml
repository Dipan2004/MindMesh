  <data key="d2">[{"text": "The Golden Horn Metro Bridge (Turkish: 'Haliç Metro Köprüsü' ) is a cable-stayed bridge spanning the Golden Horn in Istanbul, Turkey.", "chunk_id": "d05fd6d6f995b106", "doc_id": "hp_2c8d0af31d5b5173"}, {"text": "Vefa is a quarter in Istanbul, Turkey.", "chunk_id": "6013e704fcb7a673", "doc_id": "hp_4d092195517898d9"}, {"text": "The Yeni Cami (pronounced 'Yeni jami'), meaning New Mosque; originally named the Valide Sultan Mosque (Turkish: 'Valide Sultan Camii' ) and later New Valide Sultan Mosque (Turkish: 'Yeni Valide Sultan Camii' ) after its partial reconstruction and completion between 1660 and 1665; is an Ottoman imperial mosque located in the Eminönü quarter of Istanbul, Turkey.", "chunk_id": "23642768860b1af7", "doc_id": "hp_8add77b4bf75704a"}, {"text": "At present, Galata is a quarter within the borough of Beyoğlu (Pera) in Istanbul,", "chunk_id": "8a864c2a09d706a5", "doc_id": "hp_9485f62ca5073136"}, {"text": "Eminönü is a former district of Istanbul in Turkey, currently a quarter of Fatih, the province's capital district.", "chunk_id": "8ce96a987e1bfdb2", "doc_id": "hp_c78ca2de7a779d48"}, {"text": "The Port of Istanbul is situated at Karaköy neighborhood of Beyoğlu district in Istanbul, Turkey.", "chunk_id": "feb4d8bd4527a1b5", "doc_id": "hp_d08efe5332f5a682"}]</data>
