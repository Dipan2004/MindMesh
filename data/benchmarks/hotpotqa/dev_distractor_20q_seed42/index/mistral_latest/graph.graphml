<node id="Seattle, Washington">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The city where Matt Cameron got his start with the Seattle-based bands Bam Bam and Skin Yard.", "chunk_id": "ff51adc6561b5ed8", "doc_id": "hp_0748d5c101636e45"}, {"text": "The city where Skin Yard originated.", "chunk_id": "f214ceb752342b01", "doc_id": "hp_a8d8b97768a7a5ac"}, {"text": "The location where Cat Butt was formed.", "chunk_id": "83900d84b46529a2", "doc_id": "hp_bb540f2beee795b9"}, {"text": "The city where Goodness was from.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
  <data key="d2">[{"text": "After getting his start with the Seattle, Washington-based bands Bam Bam and Skin Yard,", "chunk_id": "ff51adc6561b5ed8", "doc_id": "hp_0748d5c101636e45"}, {"text": "Skin Yard was an American grunge band from Seattle, Washington,", "chunk_id": "f214ceb752342b01", "doc_id": "hp_a8d8b97768a7a5ac"}, {"text": "Cat Butt was a Seattle, Washington rock group formed in 1987.", "chunk_id": "83900d84b46529a2", "doc_id": "hp_bb540f2beee795b9"}, {"text": "Goodness was an American rock band from Seattle, Washington,", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
  <data key="d3">["hp_0748d5c101636e45", "hp_a8d8b97768a7a5ac", "hp_bb540f2beee795b9", "hp_cf04d33334830067"]</data>
