  <data key="d1">[{"text": "A coal mining company that currently owns and operates the Belle Ayr Mine.", "chunk_id": "7fe46afd6de65c3a", "doc_id": "hp_3731824073231cd8"}, {"text": "A coal mining company that currently owns and operates the Eagle Butte Mine.", "chunk_id": "78a7fc54937a3252", "doc_id": "hp_3951a9fbbce59e29"}]</data>
  <data key="d2">[{"text": "The mine is currently owned and operated by Alpha Natural Resources", "chunk_id": "7fe46afd6de65c3a", "doc_id": "hp_3731824073231cd8"}, {"text": "The mine is currently owned and operated by Alpha Natural Resources after being acquired in a merger with Foundation Coal in 2009.", "chunk_id": "78a7fc54937a3252", "doc_id": "hp_3951a9fbbce59e29"}]</data>
