<node id="Academy Award for Best Actress">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "Award given annually by the Academy of Motion Picture Arts and Sciences to recognize an actress's performance in a leading role in a film.", "chunk_id": "ab9c0365b8dd8a08", "doc_id": "hp_52ccb7f4b77e7575"}]</data>
  <data key="d2">[{"text": "Garbo was nominated three times for the Academy Award for Best Actress", "chunk_id": "ab9c0365b8dd8a08", "doc_id": "hp_52ccb7f4b77e7575"}]</data>
  <data key="d3">["hp_52ccb7f4b77e7575"]</data>
  <data key="d4">False</data>
</node>
<node id="Academy Honorary Award">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "An award given by the Academy of Motion Picture Arts and Sciences to honor a person or group for outstanding contributions to the motion picture industry.", "chunk_id": "ab9c0365b8dd8a08", "doc_id": "hp_52ccb7f4b77e7575"}]</data>
  <data key="d2">[{"text": "In 1954, she received an Academy Honorary Award in 1954 for her 'luminous and unforgettable screen performances.'", "chunk_id": "ab9c0365b8dd8a08", "doc_id": "hp_52ccb7f4b77e7575"}]</data>
  <data key="d3">["hp_52ccb7f4b77e7575"]</data>
  <data key="d4">False</data>
</node>
