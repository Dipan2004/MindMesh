<node id="Jennifer Aniston">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Actor in She's Funny That Way", "chunk_id": "14c64a26cf2ce506", "doc_id": "hp_29afcea943976657"}, {"text": "American actress known for her role as Rachel Green in 'Friends'", "chunk_id": "c597fc325ac5879a", "doc_id": "hp_3360ceaa1d43f0b1"}, {"text": "American actress, producer, and businesswoman", "chunk_id": "c6d28b12dff33299", "doc_id": "hp_7062cb7532c4e037"}, {"text": "An American actress and producer, best known for her role as Rachel Green in the NBC sitcom Friends.", "chunk_id": "cc9981f89b3d1923", "doc_id": "hp_7e6ecca5f60697cd"}, {"text": "The actress who played Rachel Green in the sitcom 'Friends'.", "chunk_id": "8f5e44d5eaa0b180", "doc_id": "hp_fe2995b8c6a6f60f"}]</data>
  <data key="d2">[{"text": "stars Jennifer Aniston", "chunk_id": "14c64a26cf2ce506", "doc_id": "hp_29afcea943976657"}, {"text": "American actress Jennifer Aniston made her screen debut in the television series 'Molloy' (1990).", "chunk_id": "c597fc325ac5879a", "doc_id": "hp_3360ceaa1d43f0b1"}, {"text": "Jennifer Aniston is an American actress, producer, and businesswoman.", "chunk_id": "c6d28b12dff33299", "doc_id": "hp_7062cb7532c4e037"}, {"text": "Jennifer Aniston's then-husband Brad Pitt in the uncredited role of Will Colbert, who reveals that he and Ross (David Schwimmer) were part of an 'I hate Rachel' club.", "chunk_id": "cc9981f89b3d1923", "doc_id": "hp_7e6ecca5f60697cd"}, {"text": "It featured six main cast members: Rachel Green (Jennifer Aniston)", "chunk_id": "8f5e44d5eaa0b180", "doc_id": "hp_fe2995b8c6a6f60f"}]</data>
  <data key="d3">["hp_29afcea943976657", "hp_3360ceaa1d43f0b1", "hp_7062cb7532c4e037", "hp_7e6ecca5f60697cd", "hp_fe2995b8c6a6f60f"]</data>
  <data key="d4">False</data>
</node>
<node id="Orson Scott Card">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A science fiction author known for 'The Ender saga' and 'Homecoming Saga'", "chunk_id": "a9e4797c7484d429", "doc_id": "hp_2a5d68cc3d308a55"}, {"text": "The author who created the character Ender Wiggin", "chunk_id": "47edadf6e6ee0fba", "doc_id": "hp_34bc485eca379384"}, {"text": "Author of A War of Gifts: An Ender Story.", "chunk_id": "6346895e57a90285", "doc_id": "hp_6a33b6ea9a3a04f5"}, {"text": "The author of the Ender's Game series.", "chunk_id": "2930b450b52cf755", "doc_id": "hp_6b8c3524cc1eacff"}, {"text": "Author of the Ender's Game series", "chunk_id": "5641991848afac1d", "doc_id": "hp_c306232b10a60f4a"}, {"text": "The author of the 'Ender's Shadow' and 'Ender's Game' series.", "chunk_id": "cab513250e896903", "doc_id": "hp_ca5f7f8dd6060ff9"}, {"text": "An American novelist, critic, public speaker, essayist, and columnist.", "chunk_id": "b72b04661c1a92f6", "doc_id": "hp_e66a1f54686744dd"}, {"text": "The author of the novel.", "chunk_id": "6d24502c923a3644", "doc_id": "hp_ef5c436bf5c8784a"}]</data>
  <data key="d2">[{"text": "This is a list of the works of Orson Scott Card.", "chunk_id": "a9e4797c7484d429", "doc_id": "hp_2a5d68cc3d308a55"}, {"text": "created by Orson Scott Card", "chunk_id": "47edadf6e6ee0fba", "doc_id": "hp_34bc485eca379384"}, {"text": "A War of Gifts: An Ender Story (2007) is a science fiction novel by Orson Scott Card.", "chunk_id": "6346895e57a90285", "doc_id": "hp_6a33b6ea9a3a04f5"}, {"text": "Ender's Game is a story by Orson Scott Card.", "chunk_id": "2930b450b52cf755", "doc_id": "hp_6b8c3524cc1eacff"}, {"text": "List of Ender's Game series short stories", "chunk_id": "5641991848afac1d", "doc_id": "hp_c306232b10a60f4a"}, {"text": "by Orson Scott Card.", "chunk_id": "cab513250e896903", "doc_id": "hp_ca5f7f8dd6060ff9"}, {"text": "Orson Scott Card (born August 24, 1951) is an American novelist, critic, public speaker, essayist, and columnist.", "chunk_id": "b72b04661c1a92f6", "doc_id": "hp_e66a1f54686744dd"}, {"text": "Ender in Exile is a science fiction novel by Orson Scott Card,", "chunk_id": "6d24502c923a3644", "doc_id": "hp_ef5c436bf5c8784a"}]</data>
  <data key="d3">["hp_2a5d68cc3d308a55", "hp_34bc485eca379384", "hp_6a33b6ea9a3a04f5", "hp_6b8c3524cc1eacff", "hp_c306232b10a60f4a", "hp_ca5f7f8dd6060ff9", "hp_e66a1f54686744dd", "hp_ef5c436bf5c8784a"]</data>
  <data key="d4">False</data>
</node>
