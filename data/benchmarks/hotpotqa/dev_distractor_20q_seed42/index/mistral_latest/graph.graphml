<node id="New Mosque (Istanbul)">
  <data key="d0">BUILDING</data>
  <data key="d1">[{"text": "An Ottoman imperial mosque located in Eminönü quarter of Istanbul, Turkey.", "chunk_id": "23642768860b1af7", "doc_id": "hp_8add77b4bf75704a"}]</data>
  <data key="d2">[{"text": "The Yeni Cami (pronounced 'Yeni jami'), meaning New Mosque; originally named the Valide Sultan Mosque (Turkish: 'Valide Sultan Camii' ) and later New Valide Sultan Mosque (Turkish: 'Yeni Valide Sultan Camii' ) after its partial reconstruction and completion between 1660 and 1665; is an Ottoman imperial mosque located in the Eminönü quarter of Istanbul, Turkey.", "chunk_id": "23642768860b1af7", "doc_id": "hp_8add77b4bf75704a"}]</data>
  <data key="d3">["hp_8add77b4bf75704a"]</data>
  <data key="d4">False</data>
</node>
