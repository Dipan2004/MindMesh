  <data key="d2">[{"text": "This compilation was re-released in 2009 as a Limited Edition 3.0 package with an additional disc of bonus songs that were not on the original release.", "chunk_id": "91eefb0bb72f64bb", "doc_id": "hp_73fddf99709403c0"}]</data>
