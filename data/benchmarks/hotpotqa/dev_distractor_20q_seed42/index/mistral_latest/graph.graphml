<node id="Ghanam Krishna Iyer">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A composer of Carnatic music known for his 'padams'", "chunk_id": "c15d9808c4518469", "doc_id": "hp_b2c43ef9d16e84d5"}]</data>
  <data key="d2">[{"text": "Ghanam Krishna Iyer Ghanam Krishna Iyar (1790–1854) was a composer of Carnatic music and was famous for his 'padams'.", "chunk_id": "c15d9808c4518469", "doc_id": "hp_b2c43ef9d16e84d5"}]</data>
  <data key="d3">["hp_b2c43ef9d16e84d5"]</data>
  <data key="d4">False</data>
</node>
<node id="Pacchimiriam Adiyappa">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A famous composer who was the teacher of Ghanam Krishna Iyer", "chunk_id": "c15d9808c4518469", "doc_id": "hp_b2c43ef9d16e84d5"}]</data>
  <data key="d2">[{"text": "He was a student of the famous composer, Pacchimiriam Adiyappa.", "chunk_id": "c15d9808c4518469", "doc_id": "hp_b2c43ef9d16e84d5"}]</data>
  <data key="d3">["hp_b2c43ef9d16e84d5"]</data>
  <data key="d4">False</data>
</node>
<node id="Gopalakrishna Bharathi">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A musician who influenced Ghanam Krishna Iyer", "chunk_id": "c15d9808c4518469", "doc_id": "hp_b2c43ef9d16e84d5"}]</data>
  <data key="d2">[{"text": "He was also influenced by Gopalakrishna Bharathi.", "chunk_id": "c15d9808c4518469", "doc_id": "hp_b2c43ef9d16e84d5"}]</data>
  <data key="d3">["hp_b2c43ef9d16e84d5"]</data>
  <data key="d4">False</data>
</node>
<node id="padam">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Expressive songs of three or more stanzas used as an accompaniment to classical dance", "chunk_id": "c15d9808c4518469", "doc_id": "hp_b2c43ef9d16e84d5"}]</data>
  <data key="d2">[{"text": "'Padams' are expressive songs of three of more stanzas, used generally as an accompaniment to classical dance.", "chunk_id": "c15d9808c4518469", "doc_id": "hp_b2c43ef9d16e84d5"}]</data>
  <data key="d3">["hp_b2c43ef9d16e84d5"]</data>
  <data key="d4">False</data>
</node>
<node id="deep">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A term associated with music meaning 'deep' or 'grand'", "chunk_id": "c15d9808c4518469", "doc_id": "hp_b2c43ef9d16e84d5"}]</data>
  <data key="d2">[{"text": "The title 'Ghanam', which associated with music means 'deep' or 'grand', relates to his style of singing.", "chunk_id": "c15d9808c4518469", "doc_id": "hp_b2c43ef9d16e84d5"}]</data>
  <data key="d3">["hp_b2c43ef9d16e84d5"]</data>
  <data key="d4">False</data>
</node>
