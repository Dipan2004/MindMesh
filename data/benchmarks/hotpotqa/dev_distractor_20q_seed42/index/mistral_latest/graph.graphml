<node id="David Schwimmer">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An American actor, producer, and director, best known for his role as Ross Geller in the NBC sitcom Friends.", "chunk_id": "cc9981f89b3d1923", "doc_id": "hp_7e6ecca5f60697cd"}, {"text": "The actor who portrays Dr. Ross Eustace Geller in the NBC sitcom 'Friends'.", "chunk_id": "1d759448fd704b25", "doc_id": "hp_ebd15cd476a830f6"}, {"text": "The actor who played Ross Geller in the sitcom 'Friends'.", "chunk_id": "8f5e44d5eaa0b180", "doc_id": "hp_fe2995b8c6a6f60f"}]</data>
  <data key="d2">[{"text": "Ross (David Schwimmer) was part of an 'I hate Rachel' club.", "chunk_id": "cc9981f89b3d1923", "doc_id": "hp_7e6ecca5f60697cd"}, {"text": "Ross is portrayed by David Schwimmer.", "chunk_id": "1d759448fd704b25", "doc_id": "hp_ebd15cd476a830f6"}, {"text": "It featured six main cast members: Rachel Green (Jennifer Aniston), Phoebe Buffay (Lisa Kudrow), Joey Tribbiani (Matt LeBlanc), Chandler Bing (Matthew Perry), Ross Geller (David Schwimmer)", "chunk_id": "8f5e44d5eaa0b180", "doc_id": "hp_fe2995b8c6a6f60f"}]</data>
