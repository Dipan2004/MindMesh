  <data key="d2">[{"text": "'Bird in a Cage' became a firm favourite with Irish radio, in particular with Irish DJ Tony Fenton who championed them.", "chunk_id": "c543d9f719f81ba3", "doc_id": "hp_22cdae208a33e842"}]</data>
