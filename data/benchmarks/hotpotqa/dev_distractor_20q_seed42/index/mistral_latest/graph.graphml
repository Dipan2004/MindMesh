<node id="Galata Tower">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A tower built by the Genoese in 1348 at the northernmost and highest point of the citadel.", "chunk_id": "8a864c2a09d706a5", "doc_id": "hp_9485f62ca5073136"}]</data>
  <data key="d2">[{"text": "The famous Galata Tower was built by the Genoese in 1348 at the northernmost and highest point of the citadel.", "chunk_id": "8a864c2a09d706a5", "doc_id": "hp_9485f62ca5073136"}]</data>
  <data key="d3">["hp_9485f62ca5073136"]</data>
