  <data key="d1">[{"text": "'Friends' is a television sitcom where Jennifer Aniston played the role of Rachel Green", "chunk_id": "c597fc325ac5879a", "doc_id": "hp_3360ceaa1d43f0b1"}, {"text": "Television sitcom", "chunk_id": "c6d28b12dff33299", "doc_id": "hp_7062cb7532c4e037"}, {"text": "An American television situation comedy that aired on NBC from September 22, 1994, to May 6, 2004.", "chunk_id": "cc9981f89b3d1923", "doc_id": "hp_7e6ecca5f60697cd"}, {"text": "A popular NBC sitcom that aired from 1994 to 2004.", "chunk_id": "1d759448fd704b25", "doc_id": "hp_ebd15cd476a830f6"}, {"text": "A sitcom that aired for ten seasons on NBC from 1994 to 2004.", "chunk_id": "8f5e44d5eaa0b180", "doc_id": "hp_fe2995b8c6a6f60f"}]</data>
  <data key="d2">[{"text": "She gained worldwide recognition in the 1990s for portraying Rachel Green on the television sitcom 'Friends' (1994–2004).", "chunk_id": "c597fc325ac5879a", "doc_id": "hp_3360ceaa1d43f0b1"}, {"text": "'Friends' (1994–2004)", "chunk_id": "c6d28b12dff33299", "doc_id": "hp_7062cb7532c4e037"}, {"text": "The One with the Rumor is the ninth episode of the eighth season of the American television situation comedy 'Friends'.", "chunk_id": "cc9981f89b3d1923", "doc_id": "hp_7e6ecca5f60697cd"}, {"text": "Dr. Ross Eustace Geller, Ph.D., is a fictional character from the NBC sitcom 'Friends'", "chunk_id": "1d759448fd704b25", "doc_id": "hp_ebd15cd476a830f6"}, {"text": "Various characters appeared in the sitcom 'Friends'", "chunk_id": "8f5e44d5eaa0b180", "doc_id": "hp_fe2995b8c6a6f60f"}]</data>
