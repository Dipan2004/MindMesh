  <data key="d2">[{"text": "6 mi east of Markleeville and 24 mi southeast of Lake Tahoe.", "chunk_id": "68bd3d3d89f94b86", "doc_id": "hp_983bcc019c6566bb"}]</data>
  <data key="d3">["hp_983bcc019c6566bb"]</data>
  <data key="d4">False</data>
</node>
<node id="East Fork of the Carson River">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A river that the contaminated water from the Leviathan Mine eventually empties into.", "chunk_id": "68bd3d3d89f94b86", "doc_id": "hp_983bcc019c6566bb"}]</data>
  <data key="d2">[{"text": "These water bodies are listed as 303(d) impaired.", "chunk_id": "68bd3d3d89f94b86", "doc_id": "hp_983bcc019c6566bb"}]</data>
  <data key="d3">["hp_983bcc019c6566bb"]</data>
  <data key="d4">False</data>
</node>
<node id="303(d) impaired">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A designation for water bodies that do not meet water quality standards.", "chunk_id": "68bd3d3d89f94b86", "doc_id": "hp_983bcc019c6566bb"}]</data>
  <data key="d2">[{"text": "These water bodies are listed as 303(d) impaired.", "chunk_id": "68bd3d3d89f94b86", "doc_id": "hp_983bcc019c6566bb"}]</data>
