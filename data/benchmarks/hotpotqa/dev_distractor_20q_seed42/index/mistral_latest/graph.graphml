  <data key="d2">[{"text": "It is the band's second best selling album in the US, selling as many copies in three years as 'Burn My Eyes' sold in almost eight years (1994–2002)", "chunk_id": "bbcb86d3cccd4eba", "doc_id": "hp_0379bcf90b6051ff"}]</data>
