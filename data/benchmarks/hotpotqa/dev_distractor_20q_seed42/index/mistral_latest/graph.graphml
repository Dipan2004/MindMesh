  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A single from Between Now and Forever and his last Number One hit.", "chunk_id": "129815da81af955b", "doc_id": "hp_a6a817357cb63d2e"}]</data>
  <data key="d2">[{"text": "In order of release, these were 'I'm Not Supposed to Love You Anymore' (number 4), 'So Much for Pretending' (number 1), 'That's Another Song' (number 15), and 'Sittin' on Go' (number 1). 'Sittin' on Go' was also his last Number One hit.", "chunk_id": "129815da81af955b", "doc_id": "hp_a6a817357cb63d2e"}]</data>
  <data key="d3">["hp_a6a817357cb63d2e"]</data>
  <data key="d4">False</data>
</node>
