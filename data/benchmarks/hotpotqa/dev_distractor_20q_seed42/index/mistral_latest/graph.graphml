  <data key="d1">[{"text": "A grunge band that Mark Arm is the vocalist for.", "chunk_id": "cae565d472109bc9", "doc_id": "hp_013fb9aeb127f70e"}, {"text": "A grunge band.", "chunk_id": "7990c5b328a154e9", "doc_id": "hp_c1de7fdb47a70603"}]</data>
  <data key="d2">[{"text": "Mark Arm is the vocalist for the grunge band Mudhoney.", "chunk_id": "cae565d472109bc9", "doc_id": "hp_013fb9aeb127f70e"}, {"text": "Endino worked on seminal albums from bands such as Mudhoney,", "chunk_id": "7990c5b328a154e9", "doc_id": "hp_c1de7fdb47a70603"}]</data>
