<node id="Big Daddy Kane">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A rapper who worked with Soul Supreme.", "chunk_id": "d010d64c5585b76a", "doc_id": "hp_02cdfef001149f0f"}, {"text": "Grammy Award-winning American rapper and actor", "chunk_id": "cbaeee2e2b70c684", "doc_id": "hp_458e0e88071005e6"}, {"text": "A rapper who collaborated on the track 'Cameo Afro' in the 'Afro Samurai OST'.", "chunk_id": "31423454b7a115c5", "doc_id": "hp_cbeadd0af7b1f731"}]</data>
  <data key="d2">[{"text": "He has worked with the likes of KRS-One, Pete Rock and Big Daddy Kane.", "chunk_id": "d010d64c5585b76a", "doc_id": "hp_02cdfef001149f0f"}, {"text": "Big Daddy Kane, is a Grammy Award-winning American rapper and actor", "chunk_id": "cbaeee2e2b70c684", "doc_id": "hp_458e0e88071005e6"}, {"text": "Featuring the historic collaboration between Big Daddy Kane &amp; GZA", "chunk_id": "31423454b7a115c5", "doc_id": "hp_cbeadd0af7b1f731"}]</data>
  <data key="d3">["hp_02cdfef001149f0f", "hp_458e0e88071005e6", "hp_cbeadd0af7b1f731"]</data>
  <data key="d4">False</data>
</node>
<node id="Grit Records">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Boston based label that Soul Supreme released his debut album under.", "chunk_id": "d010d64c5585b76a", "doc_id": "hp_02cdfef001149f0f"}]</data>
  <data key="d2">[{"text": "In 2003 he released his debut and self-produced album “The Saturday Night Agenda” under the name Soul Supreme on the Boston based label Grit Records.", "chunk_id": "d010d64c5585b76a", "doc_id": "hp_02cdfef001149f0f"}]</data>
  <data key="d3">["hp_02cdfef001149f0f"]</data>
  <data key="d4">False</data>
</node>
<node id="URB Magazine">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A magazine that listed Soul Supreme in its list of the next 100 producers.", "chunk_id": "d010d64c5585b76a", "doc_id": "hp_02cdfef001149f0f"}]</data>
  <data key="d2">[{"text": "In 2006 he made URB Magazine’s list of the next 100 producers", "chunk_id": "d010d64c5585b76a", "doc_id": "hp_02cdfef001149f0f"}]</data>
  <data key="d3">["hp_02cdfef001149f0f"]</data>
