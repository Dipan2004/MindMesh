<node id="Cleveland Thyagaraja Festival">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A 12-day festival of South Indian classical music and dance in Cleveland, Ohio, held annually around Easter weekend.", "chunk_id": "d31633346194395b", "doc_id": "hp_66b69530e352b6ff"}]</data>
  <data key="d2">[{"text": "The Cleveland Thyagaraja Festival is a 12-day festival of South Indian classical music and dance in Cleveland, Ohio, and is held each year around Easter weekend.", "chunk_id": "d31633346194395b", "doc_id": "hp_66b69530e352b6ff"}]</data>
  <data key="d3">["hp_66b69530e352b6ff"]</data>
  <data key="d4">False</data>
</node>
<node id="Tyagaraja">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A famous composer of Carnatic music who composed thousands of devotional compositions, most in Telugu language.", "chunk_id": "d31633346194395b", "doc_id": "hp_66b69530e352b6ff"}, {"text": "A famous composer of Carnatic music whose traditions were followed by Pallavi Seshayyar.", "chunk_id": "5854eec81cd8ae74", "doc_id": "hp_aa4783fa3ad3d831"}, {"text": "A musician who influenced Ghanam Krishna Iyer", "chunk_id": "c15d9808c4518469", "doc_id": "hp_b2c43ef9d16e84d5"}]</data>
  <data key="d2">[{"text": "The festival is a celebration in honor of Tyagaraja, the famous composer of Carnatic music, who composed thousands of devotional compositions, most in Telugu language .", "chunk_id": "d31633346194395b", "doc_id": "hp_66b69530e352b6ff"}, {"text": "Pallavi Seshayyar (1842–1909) was a composer of Carnatic music, who followed the traditions of the famous composer Tyagaraja.", "chunk_id": "5854eec81cd8ae74", "doc_id": "hp_aa4783fa3ad3d831"}, {"text": "He was also influenced by Tyagaraja.", "chunk_id": "c15d9808c4518469", "doc_id": "hp_b2c43ef9d16e84d5"}]</data>
  <data key="d3">["hp_66b69530e352b6ff", "hp_aa4783fa3ad3d831", "hp_b2c43ef9d16e84d5"]</data>
  <data key="d4">False</data>
</node>
<node id="Cleveland, Ohio">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The city where the Cleveland Thyagaraja Festival takes place.", "chunk_id": "d31633346194395b", "doc_id": "hp_66b69530e352b6ff"}]</data>
  <data key="d2">[{"text": "The Cleveland Thyagaraja Festival is a 12-day festival of South Indian classical music and dance in Cleveland, Ohio,", "chunk_id": "d31633346194395b", "doc_id": "hp_66b69530e352b6ff"}]</data>
  <data key="d3">["hp_66b69530e352b6ff"]</data>
  <data key="d4">False</data>
</node>
