<node id="sex reassignment surgery">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A surgical procedure to change a person's physical sex characteristics to align with their gender identity.", "chunk_id": "7ac08a74cbccd041", "doc_id": "hp_20a176ec128ccbc1"}]</data>
  <data key="d2">[{"text": "one of the first identifiable recipients of sex reassignment surgery", "chunk_id": "7ac08a74cbccd041", "doc_id": "hp_20a176ec128ccbc1"}]</data>
  <data key="d3">["hp_20a176ec128ccbc1"]</data>
