  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A cable-stayed bridge along the M2 line of the Istanbul Metro, spanning the Golden Horn in Istanbul, Turkey.", "chunk_id": "d05fd6d6f995b106", "doc_id": "hp_2c8d0af31d5b5173"}]</data>
  <data key="d2">[{"text": "The Golden Horn Metro Bridge (Turkish: 'Haliç Metro Köprüsü' ) is a cable-stayed bridge along the M2 line of the Istanbul Metro, spanning the Golden Horn in Istanbul, Turkey.", "chunk_id": "d05fd6d6f995b106", "doc_id": "hp_2c8d0af31d5b5173"}]</data>
  <data key="d3">["hp_2c8d0af31d5b5173"]</data>
  <data key="d4">False</data>
</node>
