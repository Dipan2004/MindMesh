  <data key="d2">[{"text": "The Bone People (styled by the writer and in some editions as the bone people) is a Booker Prize-winning 1984 novel by New Zealand writer Keri Hulme.", "chunk_id": "cdb45bf1a7348aa1", "doc_id": "hp_6b37decbdc54f25f"}, {"text": "Keri Hulme (born 9 March 1947) is a New Zealand writer.", "chunk_id": "c23448474d98242c", "doc_id": "hp_d58b292c062324be"}]</data>
