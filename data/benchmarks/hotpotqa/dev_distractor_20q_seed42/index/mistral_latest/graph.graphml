<node id="Hasan Fehmi">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Editor-in-chief of 'Serbestî', an Ottoman newspaper who wrote articles against the Committee of Union and Progress.", "chunk_id": "07827c20865c32a2", "doc_id": "hp_99b2c263cece8240"}]</data>
  <data key="d2">[{"text": "Hasan Fehmi Bey (1874 – April 6, 1909) was the editor-in-chief of 'Serbestî', an Ottoman newspaper,", "chunk_id": "07827c20865c32a2", "doc_id": "hp_99b2c263cece8240"}]</data>
  <data key="d3">["hp_99b2c263cece8240"]</data>
  <data key="d4">False</data>
</node>
<node id="Serbestî">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "An Ottoman newspaper.", "chunk_id": "07827c20865c32a2", "doc_id": "hp_99b2c263cece8240"}]</data>
  <data key="d2">[{"text": "Hasan Fehmi Bey (1874 – April 6, 1909) was the editor-in-chief of 'Serbestî', an Ottoman newspaper,", "chunk_id": "07827c20865c32a2", "doc_id": "hp_99b2c263cece8240"}]</data>
  <data key="d3">["hp_99b2c263cece8240"]</data>
  <data key="d4">False</data>
</node>
<node id="Committee of Union and Progress">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A political committee that was emerging during the time of Hasan Fehmi.", "chunk_id": "07827c20865c32a2", "doc_id": "hp_99b2c263cece8240"}]</data>
  <data key="d2">[{"text": "Hasan Fehmi wrote articles against the newly emerging Committee of Union and Progress.", "chunk_id": "07827c20865c32a2", "doc_id": "hp_99b2c263cece8240"}]</data>
  <data key="d3">["hp_99b2c263cece8240"]</data>
  <data key="d4">False</data>
</node>
<node id="Suanfa Tongzong">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A mathematical text written by Cheng Dawei in the 16th century.", "chunk_id": "7f2595edab3decbc", "doc_id": "hp_9a45a1ffc6455c53"}]</data>
  <data key="d2">[{"text": "Suanfa Tongzong (General Source of Computational Methods) is a mathematical text written by sixteenth century Chinese mathematician Cheng Dawei", "chunk_id": "7f2595edab3decbc", "doc_id": "hp_9a45a1ffc6455c53"}]</data>
  <data key="d3">["hp_9a45a1ffc6455c53"]</data>
  <data key="d4">False</data>
</node>
<node id="Cheng Dawei">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A 16th century Chinese mathematician who wrote Suanfa Tongzong.", "chunk_id": "7f2595edab3decbc", "doc_id": "hp_9a45a1ffc6455c53"}]</data>
  <data key="d2">[{"text": "written by sixteenth century Chinese mathematician Cheng Dawei", "chunk_id": "7f2595edab3decbc", "doc_id": "hp_9a45a1ffc6455c53"}]</data>
  <data key="d3">["hp_9a45a1ffc6455c53"]</data>
  <data key="d4">False</data>
</node>
<node id="Suanfa Zuanyao">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A book published by Cheng Dawei six years after Suanfa Tongzong.", "chunk_id": "7f2595edab3decbc", "doc_id": "hp_9a45a1ffc6455c53"}]</data>
  <data key="d2">[{"text": "Six years after the publication of Suanfa Tongzong, Cheng Dawei published another book titled 'Suanfa Zuanyao'", "chunk_id": "7f2595edab3decbc", "doc_id": "hp_9a45a1ffc6455c53"}]</data>
  <data key="d3">["hp_9a45a1ffc6455c53"]</data>
  <data key="d4">False</data>
</node>
<node id="1592">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The year Suanfa Tongzong was published.", "chunk_id": "7f2595edab3decbc", "doc_id": "hp_9a45a1ffc6455c53"}]</data>
  <data key="d2">[{"text": "The book contains 595 problems divided into 17 chapters. The book is essentially general arithmetic for the abacus. The book was the main source available to scholars concerning mathematics as it developed in China’s tradition. Six years after the publication of Suanfa Tongzong, Cheng Dawei published another book titled 'Suanfa Zuanyao'", "chunk_id": "7f2595edab3decbc", "doc_id": "hp_9a45a1ffc6455c53"}]</data>
  <data key="d3">["hp_9a45a1ffc6455c53"]</data>
  <data key="d4">False</data>
</node>
<node id="Constantine Garrievich Orbelian, Jr.">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The full name of Constantine Orbelian.", "chunk_id": "185b3ac3a93315a8", "doc_id": "hp_9b088777f58c1aa0"}]</data>
  <data key="d2">[{"text": "Constantine Garrievich Orbelian, Jr. (Armenian: Կոնստանտին Օրբելյան , Russian: Константин Гарриевич Орбелян , born San Francisco, 27 August 1956) is an American conductor and pianist of Armenian and Russian descent.", "chunk_id": "185b3ac3a93315a8", "doc_id": "hp_9b088777f58c1aa0"}]</data>
  <data key="d3">["hp_9b088777f58c1aa0"]</data>
  <data key="d4">False</data>
</node>
<node id="Konstantin Orbelyan">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A major Armenian composer, who Constantine Orbelian is named after.", "chunk_id": "185b3ac3a93315a8", "doc_id": "hp_9b088777f58c1aa0"}]</data>
  <data key="d2">[{"text": "He is named after his paternal uncle Konstantin Orbelyan, a major Armenian composer.", "chunk_id": "185b3ac3a93315a8", "doc_id": "hp_9b088777f58c1aa0"}]</data>
  <data key="d3">["hp_9b088777f58c1aa0"]</data>
  <data key="d4">False</data>
</node>
