  <data key="d1">[{"text": "Singer of Drowning Pool.", "chunk_id": "d6eb6532f8d34a23", "doc_id": "hp_2bc1fd7192286912"}, {"text": "The frontman of Soil who left the group in late 2004.", "chunk_id": "9bf6c5d9ac078751", "doc_id": "hp_6d3fb3f9a8564cfc"}]</data>
  <data key="d2">[{"text": "Ryan McCombs remained with Drowning Pool after their 2007 album 'Full Circle', although he did, however, leave the band in 2011 to rejoin his previous band SOiL.", "chunk_id": "d6eb6532f8d34a23", "doc_id": "hp_2bc1fd7192286912"}, {"text": "In late 2004 frontman Ryan McCombs left the group.", "chunk_id": "9bf6c5d9ac078751", "doc_id": "hp_6d3fb3f9a8564cfc"}]</data>
