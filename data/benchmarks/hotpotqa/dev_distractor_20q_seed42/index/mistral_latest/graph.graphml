  <data key="d2">[{"text": "'Ender's Game' first appeared in the August 1977 issue of 'Analog' magazine.", "chunk_id": "2930b450b52cf755", "doc_id": "hp_6b8c3524cc1eacff"}]</data>
  <data key="d3">["hp_6b8c3524cc1eacff"]</data>
  <data key="d4">False</data>
</node>
<node id="Jack Osbourne">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An English media personality with dual American and British citizenship, known for starring on MTV's reality series 'The Osbournes' and later pursuing a career as a fitness and travel reporter.", "chunk_id": "a336632347978a4e", "doc_id": "hp_6d2014cbadd82348"}, {"text": "The son of Ozzy and Sharon Osbourne who organises each yearly tour of Ozzfest.", "chunk_id": "8d4a7e958e831048", "doc_id": "hp_a3e96a3b5cb0ef4a"}]</data>
  <data key="d2">[{"text": "Jack Osbourne", "chunk_id": "a336632347978a4e", "doc_id": "hp_6d2014cbadd82348"}, {"text": "both of whom also organise each yearly tour with their son Jack Osbourne.", "chunk_id": "8d4a7e958e831048", "doc_id": "hp_a3e96a3b5cb0ef4a"}]</data>
  <data key="d3">["hp_6d2014cbadd82348", "hp_a3e96a3b5cb0ef4a"]</data>
