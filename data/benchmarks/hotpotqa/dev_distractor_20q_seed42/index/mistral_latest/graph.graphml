<node id="Rachel Green">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Character portrayed by Jennifer Aniston on Friends", "chunk_id": "c6d28b12dff33299", "doc_id": "hp_7062cb7532c4e037"}, {"text": "A character played by Jennifer Aniston in the NBC sitcom Friends.", "chunk_id": "cc9981f89b3d1923", "doc_id": "hp_7e6ecca5f60697cd"}, {"text": "A character from the TV show 'Friends', Rachel is a friend of Monica who Chandler meets during Thanksgiving.", "chunk_id": "b1a1a41853d278db", "doc_id": "hp_8eaeb16bb356f2c5"}, {"text": "A character from the NBC sitcom 'Friends', portrayed by Jennifer Aniston.", "chunk_id": "702e5a74aed1bc94", "doc_id": "hp_e8285dadbc32439e"}, {"text": "A character played by Jennifer Aniston in the sitcom 'Friends'.", "chunk_id": "8f5e44d5eaa0b180", "doc_id": "hp_fe2995b8c6a6f60f"}]</data>
  <data key="d2">[{"text": "Aniston gained worldwide recognition for portraying Rachel Green on the television sitcom 'Friends'", "chunk_id": "c6d28b12dff33299", "doc_id": "hp_7062cb7532c4e037"}, {"text": "Jennifer Aniston's then-husband Brad Pitt in the uncredited role of Will Colbert, who reveals that he and Ross (David Schwimmer) were part of an 'I hate Rachel' club.", "chunk_id": "cc9981f89b3d1923", "doc_id": "hp_7e6ecca5f60697cd"}, {"text": "He met Ross's sister, Monica Geller, and her friend, Rachel Green, while celebrating Thanksgiving at Ross's House.", "chunk_id": "b1a1a41853d278db", "doc_id": "hp_8eaeb16bb356f2c5"}, {"text": "hangs out in a tight-knit group of friends - Chandler Bing, Ross Geller, Monica Geller-Bing, Rachel Green", "chunk_id": "702e5a74aed1bc94", "doc_id": "hp_e8285dadbc32439e"}, {"text": "It featured six main cast members: Rachel Green (Jennifer Aniston)", "chunk_id": "8f5e44d5eaa0b180", "doc_id": "hp_fe2995b8c6a6f60f"}]</data>
  <data key="d3">["hp_7062cb7532c4e037", "hp_7e6ecca5f60697cd", "hp_8eaeb16bb356f2c5", "hp_e8285dadbc32439e", "hp_fe2995b8c6a6f60f"]</data>
  <data key="d4">False</data>
</node>
<node id="Blizzard of Ozz">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "First album by Ozzy Osbourne.", "chunk_id": "91eefb0bb72f64bb", "doc_id": "hp_73fddf99709403c0"}, {"text": "One of Ozzy Osbourne's best-selling albums in North America.", "chunk_id": "4d51ae482748920f", "doc_id": "hp_d2e0b0fe646d3d01"}]</data>
  <data key="d2">[{"text": "Tracks featured here from the first two albums are the re-recorded versions from recent reissues (see \"Blizzard of Ozz\")", "chunk_id": "91eefb0bb72f64bb", "doc_id": "hp_73fddf99709403c0"}, {"text": "It is also one of Osbourne's two best-selling albums in North America, along with 'Blizzard of Ozz'", "chunk_id": "4d51ae482748920f", "doc_id": "hp_d2e0b0fe646d3d01"}]</data>
  <data key="d3">["hp_73fddf99709403c0", "hp_d2e0b0fe646d3d01"]</data>
