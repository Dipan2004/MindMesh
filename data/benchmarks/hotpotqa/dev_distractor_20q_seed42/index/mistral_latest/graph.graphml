  <data key="d1">[{"text": "A premier institution in India for Western Classical music and Contemporary classical music, established in 1915.", "chunk_id": "e135f2e20308e863", "doc_id": "hp_5290019d032852f5"}]</data>
  <data key="d2">[{"text": "Calcutta School of Music established in 1915 by Phillipe Sandre is one of the premier institutions of India, in the field of Western Classical music and Contemporary classical music.", "chunk_id": "e135f2e20308e863", "doc_id": "hp_5290019d032852f5"}]</data>
  <data key="d3">["hp_5290019d032852f5"]</data>
  <data key="d4">False</data>
</node>
<node id="Phillipe Sandre">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A musician who established the Calcutta School of Music in 1915.", "chunk_id": "e135f2e20308e863", "doc_id": "hp_5290019d032852f5"}]</data>
  <data key="d2">[{"text": "It was established in the year 1915 by Phillipé Sandré, a musician of considerable calibre,", "chunk_id": "e135f2e20308e863", "doc_id": "hp_5290019d032852f5"}]</data>
  <data key="d3">["hp_5290019d032852f5"]</data>
  <data key="d4">False</data>
</node>
<node id="Saint Saëns">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A famous composer who was a contemporary and friend of Phillipe Sandre.", "chunk_id": "e135f2e20308e863", "doc_id": "hp_5290019d032852f5"}]</data>
  <data key="d2">[{"text": "Phillipé Sandré, a musician of considerable calibre, and a contemporary and friend of the famous composer Saint Saëns.", "chunk_id": "e135f2e20308e863", "doc_id": "hp_5290019d032852f5"}]</data>
  <data key="d3">["hp_5290019d032852f5"]</data>
  <data key="d4">False</data>
</node>
<node id="Kolkata">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The city where the Calcutta School of Music is located.", "chunk_id": "e135f2e20308e863", "doc_id": "hp_5290019d032852f5"}]</data>
  <data key="d2">[{"text": "The School is an important element of the city of Kolkata,", "chunk_id": "e135f2e20308e863", "doc_id": "hp_5290019d032852f5"}]</data>
  <data key="d3">["hp_5290019d032852f5"]</data>
  <data key="d4">False</data>
</node>
<node id="Indian Music &amp; Dance">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A faculty of the Calcutta School of Music.", "chunk_id": "e135f2e20308e863", "doc_id": "hp_5290019d032852f5"}]</data>
  <data key="d2">[{"text": "The great sitar maestro Pandit Ravi Shankar inaugurated the faculty of Indian Music &amp; Dance during the year 1975.", "chunk_id": "e135f2e20308e863", "doc_id": "hp_5290019d032852f5"}]</data>
  <data key="d3">["hp_5290019d032852f5"]</data>
  <data key="d4">False</data>
</node>
<node id="Yehudi Menuhin">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A maestro who visited the Calcutta School of Music.", "chunk_id": "e135f2e20308e863", "doc_id": "hp_5290019d032852f5"}]</data>
  <data key="d2">[{"text": "Many visiting luminaries of the musical world have visited the School throughout its existence. this include maestros Yehudi Menuhin,", "chunk_id": "e135f2e20308e863", "doc_id": "hp_5290019d032852f5"}]</data>
  <data key="d3">["hp_5290019d032852f5"]</data>
  <data key="d4">False</data>
</node>
