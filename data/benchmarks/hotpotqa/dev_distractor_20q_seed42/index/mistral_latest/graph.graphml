</edge>
<edge source="Settimia Caccini" target="Monodic Music">
  <data key="d5">["USED_FOR"]</data>
  <data key="d6">Settimia Caccini used monodic music in her compositions.</data>
  <data key="d7">[{"text": "This type of music opposed traditional music then, by having expressive melodies and evocative chords.", "chunk_id": "95c365ca672cb565", "doc_id": "hp_854c21bf573c6370", "type": "USED_FOR"}]</data>
  <data key="d8">hp_854c21bf573c6370</data>
</edge>
<edge source="Settimia Caccini" target="Italy">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">Settimia Caccini lived and had her career in Italy.</data>
  <data key="d7">[{"text": "Settimia Caccini (6 October 1591 – ca. 1638, Italy) was a well-known Italian singer and composer during the 1600s being one of the first women to have a successful career in music.", "chunk_id": "95c365ca672cb565", "doc_id": "hp_854c21bf573c6370", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_854c21bf573c6370</data>
</edge>
