<node id="Pallavi Seshayyar">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A composer of Carnatic music who followed the traditions of Tyagaraja and was an expert of the techniques of 'Ragam-Thanam-Pallavi'.", "chunk_id": "5854eec81cd8ae74", "doc_id": "hp_aa4783fa3ad3d831"}]</data>
  <data key="d2">[{"text": "Pallavi Seshayyar (1842–1909) was a composer of Carnatic music, who followed the traditions of the famous composer Tyagaraja.", "chunk_id": "5854eec81cd8ae74", "doc_id": "hp_aa4783fa3ad3d831"}]</data>
  <data key="d3">["hp_aa4783fa3ad3d831"]</data>
  <data key="d4">False</data>
</node>
<node id="king of Mysore">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The ruler of the Kingdom of Mysore where Pallavi Seshayyar served as a singer.", "chunk_id": "5854eec81cd8ae74", "doc_id": "hp_aa4783fa3ad3d831"}]</data>
  <data key="d2">[{"text": "Seshayyar was a singer in the court of the king of Mysore.", "chunk_id": "5854eec81cd8ae74", "doc_id": "hp_aa4783fa3ad3d831"}]</data>
  <data key="d3">["hp_aa4783fa3ad3d831"]</data>
