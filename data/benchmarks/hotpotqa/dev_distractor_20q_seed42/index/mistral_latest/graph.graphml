  <data key="d2">[{"text": "Rawhide produces a low-sulfur, sub-bituminous coal from the Roland and Smith seams", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}, {"text": "The mine is an open pit, 'truck and shovel', mine producing a low-sulfur, sub-bituminous coal from the Roland and Smith seams that is used for domestic energy generation.", "chunk_id": "78a7fc54937a3252", "doc_id": "hp_3951a9fbbce59e29"}]</data>
