<node id="Hahn series">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A type of formal infinite series that is a generalization of Puiseux series, introduced by Hans Hahn in 1907.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d2">[{"text": "Hahn series (sometimes also known as Hahn–Mal'cev–Neumann series) are a type of formal infinite series.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d3">["hp_6b4b5cbeeb7835af"]</data>
  <data key="d4">False</data>
</node>
<node id="Hans Hahn">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A mathematician who introduced Hahn series in 1907.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d2">[{"text": "They were first introduced by Hans Hahn in 1907.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d3">["hp_6b4b5cbeeb7835af"]</data>
  <data key="d4">False</data>
</node>
<node id="Puiseux series">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A type of formal power series, which are generalized by Hahn series.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d2">[{"text": "Hahn series (sometimes also known as Hahn–Mal'cev–Neumann series) are a generalization of Puiseux series.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d3">["hp_6b4b5cbeeb7835af"]</data>
  <data key="d4">False</data>
</node>
<node id="Anatoly Maltsev">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A mathematician who generalized Hahn series to a non-commutative setting.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}, {"text": "A mathematician known for his work on the decidability of various algebraic groups.", "chunk_id": "c59938cdf2826d2c", "doc_id": "hp_d20ba85a57590c30"}]</data>
  <data key="d2">[{"text": "They were then further generalized by Anatoly Maltsev and Bernhard Neumann to a non-commutative setting.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}, {"text": "Anatoly Maltsev Anatoly Ivanovich Maltsev (also: Malcev, Mal'cev; Russian: Анато́лий Ива́нович Ма́льцев; 27 November N.S./14 November O.S. 1909, Moscow Governorate – 7 June 1967, Novosibirsk) was born in Misheronsky, near Moscow, and died in Novosibirsk, USSR.", "chunk_id": "c59938cdf2826d2c", "doc_id": "hp_d20ba85a57590c30"}]</data>
  <data key="d3">["hp_6b4b5cbeeb7835af", "hp_d20ba85a57590c30"]</data>
  <data key="d4">False</data>
</node>
<node id="Bernhard Neumann">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A mathematician who generalized Hahn series to a non-commutative setting.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d2">[{"text": "They were then further generalized by Anatoly Maltsev and Bernhard Neumann to a non-commutative setting.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d3">["hp_6b4b5cbeeb7835af"]</data>
  <data key="d4">False</data>
</node>
<node id="formula_1">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A well-ordered subset of the value group supporting Hahn series.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d2">[{"text": "They allow for arbitrary exponents of the indeterminate so long as the set supporting them forms a well-ordered subset of the value group (typically formula_1 or formula_2).", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d3">["hp_6b4b5cbeeb7835af"]</data>
  <data key="d4">False</data>
</node>
<node id="formula_2">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A well-ordered subset of the value group supporting Hahn series.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d2">[{"text": "They allow for arbitrary exponents of the indeterminate so long as the set supporting them forms a well-ordered subset of the value group (typically formula_1 or formula_2).", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d3">["hp_6b4b5cbeeb7835af"]</data>
  <data key="d4">False</data>
</node>
<node id="Hahn embedding theorem">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A theorem in mathematics, the proof of which involved the introduction of Hahn series as groups.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d2">[{"text": "Hahn series were first introduced, as groups, in the course of the proof of the Hahn embedding theorem.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d3">["hp_6b4b5cbeeb7835af"]</data>
  <data key="d4">False</data>
</node>
<node id="Hilbert's seventeenth problem">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A problem in mathematics, which was studied by Hans Hahn using Hahn series as fields.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d2">[{"text": "Then studied by him as fields in his approach to Hilbert's seventeenth problem.", "chunk_id": "f40ff7fcf0c6d4d5", "doc_id": "hp_6b4b5cbeeb7835af"}]</data>
  <data key="d3">["hp_6b4b5cbeeb7835af"]</data>
  <data key="d4">False</data>
</node>
