<node id="Georgia Anne Muldrow">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "One of the guest vocalists on The Ecstatic.", "chunk_id": "f2f6bd8122079227", "doc_id": "hp_8f34b0e5a3d7884e"}]</data>
  <data key="d2">[{"text": "Singer Georgia Anne Muldrow, formerly of the record label, was one of the album's few guest vocalists, along with rappers Slick Rick and Talib Kweli.", "chunk_id": "f2f6bd8122079227", "doc_id": "hp_8f34b0e5a3d7884e"}]</data>
