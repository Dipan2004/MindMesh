<node id="intensely nostalgic and even tragic mood">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The emotional tone of Fünf Gesänge, Op. 104.", "chunk_id": "f75b53e3e77141e7", "doc_id": "hp_857bd66259cbd40e"}]</data>
  <data key="d2">[{"text": "Brahms has chosen texts which centre on lost youth, summer turning into fall and, ultimately, man's mortality.", "chunk_id": "f75b53e3e77141e7", "doc_id": "hp_857bd66259cbd40e"}]</data>
