<node id="Green River">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "One of the first grunge bands, which Mark Arm was a part of.", "chunk_id": "cae565d472109bc9", "doc_id": "hp_013fb9aeb127f70e"}, {"text": "A band produced by Chris Hanzsek in the mid-1980s.", "chunk_id": "bb0ba4b3aa5dba2f", "doc_id": "hp_56d41e480504ab00"}]</data>
  <data key="d2">[{"text": "His former group, Green River, is one of the first grunge bands,", "chunk_id": "cae565d472109bc9", "doc_id": "hp_013fb9aeb127f70e"}, {"text": "Many of the bands he produced in the mid-1980s are regarded as the foundation of Seattle’s “grunge” scene, such as,", "chunk_id": "bb0ba4b3aa5dba2f", "doc_id": "hp_56d41e480504ab00"}]</data>
  <data key="d3">["hp_013fb9aeb127f70e", "hp_56d41e480504ab00"]</data>
  <data key="d4">False</data>
</node>
