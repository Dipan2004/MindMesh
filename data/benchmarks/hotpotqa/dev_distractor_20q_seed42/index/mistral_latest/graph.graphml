  <data key="d2">[{"text": "It is rich of monuments, both Byzantine, like the mosques of Kalenderhane and Vefa Kilise", "chunk_id": "6013e704fcb7a673", "doc_id": "hp_4d092195517898d9"}, {"text": "Kalenderhane Mosque (Turkish: 'Kalenderhane Camii' ) is a former Eastern Orthodox church in Istanbul, converted into a mosque by the Ottomans.", "chunk_id": "2f1b532952105657", "doc_id": "hp_db6d3a8033a7728c"}]</data>
