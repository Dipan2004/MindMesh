<node id="Railroad">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "The means of transporting the coal produced by the Rawhide Mine.", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}, {"text": "A system of tracks for transporting goods and passengers.", "chunk_id": "7fe46afd6de65c3a", "doc_id": "hp_3731824073231cd8"}, {"text": "A system of tracks for transporting goods and passengers.", "chunk_id": "78a7fc54937a3252", "doc_id": "hp_3951a9fbbce59e29"}, {"text": "A system of connected rails with vehicles that run along them.", "chunk_id": "32c65ffbe028b14f", "doc_id": "hp_3b8f0ed3cc516d96"}, {"text": "A system of tracks for transporting goods and passengers.", "chunk_id": "53b795222c7c739d", "doc_id": "hp_b3b54c991b626270"}]</data>
  <data key="d2">[{"text": "The coal is shipped to customers via railroad", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}, {"text": "Coal produced by the mine is shipped to its customers via railroad", "chunk_id": "7fe46afd6de65c3a", "doc_id": "hp_3731824073231cd8"}, {"text": "Coal produced by the mine is shipped to its customers via railroad.", "chunk_id": "78a7fc54937a3252", "doc_id": "hp_3951a9fbbce59e29"}, {"text": "The mine ships its coal to other customers via railroad", "chunk_id": "32c65ffbe028b14f", "doc_id": "hp_3b8f0ed3cc516d96"}, {"text": "The coal is shipped to customers via railroad", "chunk_id": "53b795222c7c739d", "doc_id": "hp_b3b54c991b626270"}]</data>
  <data key="d3">["hp_017f49f90d534b1e", "hp_3731824073231cd8", "hp_3951a9fbbce59e29", "hp_3b8f0ed3cc516d96", "hp_b3b54c991b626270"]</data>
  <data key="d4">False</data>
</node>
