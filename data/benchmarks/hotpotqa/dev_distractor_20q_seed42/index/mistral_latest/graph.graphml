  <data key="d1">[{"text": "A field of study related to the work of American pop musician Madonna using an interdisciplinary approach incorporating cultural studies and media studies.", "chunk_id": "babc7677e763a2e0", "doc_id": "hp_ab68093729b5f80d"}]</data>
  <data key="d2">[{"text": "Madonna Studies is a term which has been used to refer to a development of a field in several studios since late 1980s.", "chunk_id": "babc7677e763a2e0", "doc_id": "hp_ab68093729b5f80d"}]</data>
