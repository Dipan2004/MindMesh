  <data key="d7">[{"text": "Promoted as 'A collection of the band's most rare tracks all sharing one thing in common in that they were recorded when the band didn't give a crap, so they are fun, funny, and unpretentious'", "chunk_id": "879efd1bd02bdbeb", "doc_id": "hp_f29e7204b18dfaef", "type": "IS"}]</data>
