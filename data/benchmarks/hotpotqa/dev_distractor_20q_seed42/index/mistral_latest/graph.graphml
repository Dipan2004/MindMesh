<node id="Hawaii Five-0">
  <data key="d0">TV_SERIES</data>
  <data key="d1">[{"text": "A CBS crime drama series that premiered in 2010 and centers on a specialized task force investigating crimes on the Hawaiian islands.", "chunk_id": "32bc1bb3818ef3ee", "doc_id": "hp_4f3a38b2a8eb6aa9"}, {"text": "A CBS police procedural drama series that premiered in 2010", "chunk_id": "cddd6b4dd1338ff1", "doc_id": "hp_606f6baf8df7d319"}, {"text": "A TV series created by Peter M. Lenkov.", "chunk_id": "458defe9ee05720a", "doc_id": "hp_61e73a97ee7fe7c0"}, {"text": "A TV series in which Serinda Swan guest starred in one episode.", "chunk_id": "9080b6dc20173833", "doc_id": "hp_bcc6b56f9fed5bf9"}, {"text": "A TV show where Keo Woolford's work is mentioned.", "chunk_id": "6584eacfa9e28c91", "doc_id": "hp_d9caf141fa7dc3c3"}, {"text": "A CBS crime drama series that investigates a wide series of crimes on the islands of Hawaii.", "chunk_id": "3d49511f8c3edd63", "doc_id": "hp_fa9ffe891ace7e19"}]</data>
  <data key="d2">[{"text": "The first season of the CBS crime drama series 'Hawaii Five-0' premiered on September 20, 2010,", "chunk_id": "32bc1bb3818ef3ee", "doc_id": "hp_4f3a38b2a8eb6aa9"}, {"text": "Hawaii Five-0 (2010 TV series, season 7)", "chunk_id": "cddd6b4dd1338ff1", "doc_id": "hp_606f6baf8df7d319"}, {"text": "'Hawaii Five-0', In 2011, Hawaii Five-0 was awarded Best New Drama at the People’s Choice Awards.", "chunk_id": "458defe9ee05720a", "doc_id": "hp_61e73a97ee7fe7c0"}, {"text": "Swan also guest starred in one episode of 'Hawaii Five-0'.", "chunk_id": "9080b6dc20173833", "doc_id": "hp_bcc6b56f9fed5bf9"}, {"text": "He was Sergeant Detective Chang on 'Hawaii Five-0'.", "chunk_id": "6584eacfa9e28c91", "doc_id": "hp_d9caf141fa7dc3c3"}, {"text": "The second season of the CBS crime drama series 'Hawaii Five-0' premiered on September 19, 2011.", "chunk_id": "3d49511f8c3edd63", "doc_id": "hp_fa9ffe891ace7e19"}]</data>
  <data key="d3">["hp_4f3a38b2a8eb6aa9", "hp_606f6baf8df7d319", "hp_61e73a97ee7fe7c0", "hp_bcc6b56f9fed5bf9", "hp_d9caf141fa7dc3c3", "hp_fa9ffe891ace7e19"]</data>
