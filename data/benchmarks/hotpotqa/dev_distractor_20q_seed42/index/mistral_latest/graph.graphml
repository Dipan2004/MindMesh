  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "British musician who is the lead vocalist and primary songwriter of the group Tears for Fears.", "chunk_id": "9892ac5d3834396b", "doc_id": "hp_b85781f5c27d9ba3"}, {"text": "A person who formed the band Tears for Fears with Curt Smith.", "chunk_id": "d6e257c954b25f79", "doc_id": "hp_d203e5e340f2b0de"}]</data>
  <data key="d2">[{"text": "Tomcats Screaming Outside is the first solo album from British musician Roland Orzabal of the group Tears for Fears,", "chunk_id": "9892ac5d3834396b", "doc_id": "hp_b85781f5c27d9ba3"}, {"text": "He is best known for forming the band Tears for Fears, along with childhood friend Roland Orzabal.", "chunk_id": "d6e257c954b25f79", "doc_id": "hp_d203e5e340f2b0de"}]</data>
