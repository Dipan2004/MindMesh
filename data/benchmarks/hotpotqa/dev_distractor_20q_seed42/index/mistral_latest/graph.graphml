<node id="Powder River Basin">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A coal-rich basin in northeastern Wyoming and southeastern Montana, USA.", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}, {"text": "A coal-rich basin in northeastern Wyoming and southeastern Montana, United States.", "chunk_id": "7fe46afd6de65c3a", "doc_id": "hp_3731824073231cd8"}, {"text": "A coal-rich basin in northeastern Wyoming and southeastern Montana, United States.", "chunk_id": "78a7fc54937a3252", "doc_id": "hp_3951a9fbbce59e29"}, {"text": "A coal-rich basin in northeastern Wyoming and southeastern Montana, United States.", "chunk_id": "32c65ffbe028b14f", "doc_id": "hp_3b8f0ed3cc516d96"}, {"text": "A coal-rich basin in northeastern Wyoming and southeastern Montana, United States.", "chunk_id": "53b795222c7c739d", "doc_id": "hp_b3b54c991b626270"}]</data>
  <data key="d2">[{"text": "The Rawhide Mine is located in the coal-rich Powder River Basin.", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}, {"text": "The Belle Ayr mine is located in the coal-rich Powder River Basin.", "chunk_id": "7fe46afd6de65c3a", "doc_id": "hp_3731824073231cd8"}, {"text": "The Eagle Butte mine is a coal mine located 7 mi north of Gillette, Wyoming in the coal-rich Powder River Basin.", "chunk_id": "78a7fc54937a3252", "doc_id": "hp_3951a9fbbce59e29"}, {"text": "The Wyodak mine is located in the coal-rich Powder River Basin", "chunk_id": "32c65ffbe028b14f", "doc_id": "hp_3b8f0ed3cc516d96"}, {"text": "The Dry Fork mine is located in the coal-rich Powder River Basin", "chunk_id": "53b795222c7c739d", "doc_id": "hp_b3b54c991b626270"}]</data>
  <data key="d3">["hp_017f49f90d534b1e", "hp_3731824073231cd8", "hp_3951a9fbbce59e29", "hp_3b8f0ed3cc516d96", "hp_b3b54c991b626270"]</data>
  <data key="d4">False</data>
</node>
<node id="Peabody Energy">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An American coal company that owns and operates the Rawhide Mine.", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}]</data>
  <data key="d2">[{"text": "The mine is currently owned and operated by Peabody Energy.", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}]</data>
  <data key="d3">["hp_017f49f90d534b1e"]</data>
  <data key="d4">False</data>
</node>
<node id="Cast blast/dozer push">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A mining method used at the Rawhide Mine.", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}]</data>
  <data key="d2">[{"text": "The mine utilizes a combination of cast blast/dozer push and truck/shovel mining methods", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}]</data>
  <data key="d3">["hp_017f49f90d534b1e"]</data>
  <data key="d4">False</data>
</node>
<node id="Truck/shovel mining">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A mining method used at the Rawhide Mine.", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}]</data>
  <data key="d2">[{"text": "The mine utilizes a combination of cast blast/dozer push and truck/shovel mining methods", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}]</data>
  <data key="d3">["hp_017f49f90d534b1e"]</data>
  <data key="d4">False</data>
</node>
<node id="Coal">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A fossil fuel that is mined at the Rawhide Mine.", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}, {"text": "A fossil fuel that is used for energy generation.", "chunk_id": "78a7fc54937a3252", "doc_id": "hp_3951a9fbbce59e29"}]</data>
  <data key="d2">[{"text": "Rawhide produces a low-sulfur, sub-bituminous coal", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}, {"text": "The mine is an open pit, 'truck and shovel', mine producing a low-sulfur, sub-bituminous coal from the Roland and Smith seams that is used for domestic energy generation.", "chunk_id": "78a7fc54937a3252", "doc_id": "hp_3951a9fbbce59e29"}]</data>
  <data key="d3">["hp_017f49f90d534b1e", "hp_3951a9fbbce59e29"]</data>
  <data key="d4">False</data>
</node>
<node id="Low-sulfur, sub-bituminous coal">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A type of coal produced by the Rawhide Mine.", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}, {"text": "A type of coal with low sulfur content and less energy density than bituminous coal.", "chunk_id": "7fe46afd6de65c3a", "doc_id": "hp_3731824073231cd8"}, {"text": "A type of coal with low sulfur content and less than bituminous rank.", "chunk_id": "78a7fc54937a3252", "doc_id": "hp_3951a9fbbce59e29"}, {"text": "A type of coal with low sulfur content and less energy density than bituminous coal.", "chunk_id": "32c65ffbe028b14f", "doc_id": "hp_3b8f0ed3cc516d96"}, {"text": "A type of coal with low sulfur content and less energy density than bituminous coal.", "chunk_id": "53b795222c7c739d", "doc_id": "hp_b3b54c991b626270"}]</data>
  <data key="d2">[{"text": "Rawhide produces a low-sulfur, sub-bituminous coal", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}, {"text": "The mine produces a low-sulfur, sub-bituminous coal", "chunk_id": "7fe46afd6de65c3a", "doc_id": "hp_3731824073231cd8"}, {"text": "The mine is an open pit, 'truck and shovel', mine producing a low-sulfur, sub-bituminous coal from the Roland and Smith seams that is used for domestic energy generation.", "chunk_id": "78a7fc54937a3252", "doc_id": "hp_3951a9fbbce59e29"}, {"text": "The mine produces a low-sulfur, sub-bituminous coal", "chunk_id": "32c65ffbe028b14f", "doc_id": "hp_3b8f0ed3cc516d96"}, {"text": "The mine mines a low-sulfur, sub-bituminous coal", "chunk_id": "53b795222c7c739d", "doc_id": "hp_b3b54c991b626270"}]</data>
  <data key="d3">["hp_017f49f90d534b1e", "hp_3731824073231cd8", "hp_3951a9fbbce59e29", "hp_3b8f0ed3cc516d96", "hp_b3b54c991b626270"]</data>
  <data key="d4">False</data>
</node>
<node id="Domestic energy generation">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The use of the coal produced by the Rawhide Mine for energy generation within the USA.", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}, {"text": "The use of energy within a country for various purposes.", "chunk_id": "7fe46afd6de65c3a", "doc_id": "hp_3731824073231cd8"}, {"text": "The use of coal for generating electricity within a country.", "chunk_id": "78a7fc54937a3252", "doc_id": "hp_3951a9fbbce59e29"}, {"text": "The production of energy for local consumption.", "chunk_id": "32c65ffbe028b14f", "doc_id": "hp_3b8f0ed3cc516d96"}, {"text": "The production of energy for local consumption.", "chunk_id": "53b795222c7c739d", "doc_id": "hp_b3b54c991b626270"}]</data>
  <data key="d2">[{"text": "This coal is used for domestic energy generation", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}, {"text": "The coal produced by the mine is used for domestic energy generation", "chunk_id": "7fe46afd6de65c3a", "doc_id": "hp_3731824073231cd8"}, {"text": "The mine is an open pit, 'truck and shovel', mine producing a low-sulfur, sub-bituminous coal from the Roland and Smith seams that is used for domestic energy generation.", "chunk_id": "78a7fc54937a3252", "doc_id": "hp_3951a9fbbce59e29"}, {"text": "The low-sulfur, sub-bituminous coal is used for domestic energy generation", "chunk_id": "32c65ffbe028b14f", "doc_id": "hp_3b8f0ed3cc516d96"}, {"text": "The low-sulfur, sub-bituminous coal is used for domestic energy generation", "chunk_id": "53b795222c7c739d", "doc_id": "hp_b3b54c991b626270"}]</data>
  <data key="d3">["hp_017f49f90d534b1e", "hp_3731824073231cd8", "hp_3951a9fbbce59e29", "hp_3b8f0ed3cc516d96", "hp_b3b54c991b626270"]</data>
  <data key="d4">False</data>
</node>
