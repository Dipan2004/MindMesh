<node id="Faith No More">
  <data key="d0">MUSIC_GROUP</data>
  <data key="d1">[{"text": "An American rock band.", "chunk_id": "f129dad49448a4ca", "doc_id": "hp_743313a46a13f336"}, {"text": "A rock band that collaborated with Boo-Yaa T.R.I.B.E. to create the song 'Another Body Murdered'", "chunk_id": "a5bd4df89e72d5b3", "doc_id": "hp_9815115e29c2a258"}, {"text": "A rock band whose B-side included remixes of 'Just Another Victim'.", "chunk_id": "1e68db603285a2db", "doc_id": "hp_cb5e5343a474bad9"}]</data>
  <data key="d2">[{"text": "Another Body Murdered by Faith No More and Boo-Yaa T.R.I.B.E.", "chunk_id": "f129dad49448a4ca", "doc_id": "hp_743313a46a13f336"}, {"text": "Another Body Murdered is a song created as a collaboration between Faith No More and Boo-Yaa T.R.I.B.E.", "chunk_id": "a5bd4df89e72d5b3", "doc_id": "hp_9815115e29c2a258"}, {"text": "Aside from the original version of the song, the single also included several remixes by producer T-Ray that also appeared on the B-side of Faith No More and Boo-Yaa T.R.I.B.E.'s Another Body Murdered.", "chunk_id": "1e68db603285a2db", "doc_id": "hp_cb5e5343a474bad9"}]</data>
  <data key="d3">["hp_743313a46a13f336", "hp_9815115e29c2a258", "hp_cb5e5343a474bad9"]</data>
  <data key="d4">False</data>
</node>
