<node id="Gore Verbinski">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Director of the first Budweiser Frogs commercial", "chunk_id": "b3372712df8d7f5e", "doc_id": "hp_011359774e6954fd"}, {"text": "An American film director, screenwriter, producer, and musician.", "chunk_id": "ce0b55ad059115bf", "doc_id": "hp_1fbd60beb768a4ea"}, {"text": "A film director with whom Dariusz Wolski has collaborated.", "chunk_id": "05c8a9112bf1a9e4", "doc_id": "hp_360ec5676bddcf0a"}, {"text": "The director of the film Rango.", "chunk_id": "243e0ad68432f8c7", "doc_id": "hp_4c73677a6deee9ed"}, {"text": "An American film director.", "chunk_id": "534cebfeb057792f", "doc_id": "hp_50e8eb24495abfd4"}, {"text": "A director.", "chunk_id": "ae226777521a6673", "doc_id": "hp_dc186b8cd496389c"}, {"text": "The director of the movie A Cure for Wellness.", "chunk_id": "a6e65010d0d95983", "doc_id": "hp_ea61059d2e892eb6"}]</data>
  <data key="d2">[{"text": "The commercial was directed by Gore Verbinski", "chunk_id": "b3372712df8d7f5e", "doc_id": "hp_011359774e6954fd"}, {"text": "Gore Verbinski (born March 16, 1964) is an American film director, screenwriter, producer and musician.", "chunk_id": "ce0b55ad059115bf", "doc_id": "hp_1fbd60beb768a4ea"}, {"text": "Many of his collaborations include working with film directors like Ridley Scott", "chunk_id": "05c8a9112bf1a9e4", "doc_id": "hp_360ec5676bddcf0a"}, {"text": "directed by Gore Verbinski", "chunk_id": "243e0ad68432f8c7", "doc_id": "hp_4c73677a6deee9ed"}, {"text": "Pirates of the Caribbean: At World's End is a 2007 American epic fantasy swashbuckler film directed by Gore Verbinski", "chunk_id": "534cebfeb057792f", "doc_id": "hp_50e8eb24495abfd4"}, {"text": "The Lone Ranger is a 2013 American western action film directed by Gore Verbinski", "chunk_id": "ae226777521a6673", "doc_id": "hp_dc186b8cd496389c"}, {"text": "Benjamin Wallfisch collaborated with Verbinski to create thematic melodies in a varied score featuring orchestral ensembles, choruses, and electronics.", "chunk_id": "a6e65010d0d95983", "doc_id": "hp_ea61059d2e892eb6"}]</data>
  <data key="d3">["hp_011359774e6954fd", "hp_1fbd60beb768a4ea", "hp_360ec5676bddcf0a", "hp_4c73677a6deee9ed", "hp_50e8eb24495abfd4", "hp_dc186b8cd496389c", "hp_ea61059d2e892eb6"]</data>
  <data key="d4">False</data>
</node>
