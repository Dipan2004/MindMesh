  <data key="d1">[{"text": "A city in Campbell County, Wyoming, USA.", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}, {"text": "A city in Campbell County, Wyoming, United States.", "chunk_id": "7fe46afd6de65c3a", "doc_id": "hp_3731824073231cd8"}, {"text": "A city in Campbell County, Wyoming, United States.", "chunk_id": "78a7fc54937a3252", "doc_id": "hp_3951a9fbbce59e29"}, {"text": "A city in Campbell County, Wyoming, United States.", "chunk_id": "32c65ffbe028b14f", "doc_id": "hp_3b8f0ed3cc516d96"}, {"text": "A city in Campbell County, Wyoming, United States.", "chunk_id": "53b795222c7c739d", "doc_id": "hp_b3b54c991b626270"}]</data>
  <data key="d2">[{"text": "The Rawhide Mine is a coal mine located 10 miles (16.1km) north of Gillette, Wyoming", "chunk_id": "eb1a65c2888d2011", "doc_id": "hp_017f49f90d534b1e"}, {"text": "located 18 miles southeast of Gillette, Wyoming", "chunk_id": "7fe46afd6de65c3a", "doc_id": "hp_3731824073231cd8"}, {"text": "The Eagle Butte mine is a coal mine located 7 mi north of Gillette, Wyoming in the United States in the coal-rich Powder River Basin.", "chunk_id": "78a7fc54937a3252", "doc_id": "hp_3951a9fbbce59e29"}, {"text": "The Wyodak mine is located 6 miles east of Gillette, Wyoming", "chunk_id": "32c65ffbe028b14f", "doc_id": "hp_3b8f0ed3cc516d96"}, {"text": "The Dry Fork mine is located 8 miles north of Gillette, Wyoming", "chunk_id": "53b795222c7c739d", "doc_id": "hp_b3b54c991b626270"}]</data>
  <data key="d3">["hp_017f49f90d534b1e", "hp_3731824073231cd8", "hp_3951a9fbbce59e29", "hp_3b8f0ed3cc516d96", "hp_b3b54c991b626270"]</data>
  <data key="d4">False</data>
