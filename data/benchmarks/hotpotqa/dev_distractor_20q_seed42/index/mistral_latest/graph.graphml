<node id="Ender Wiggin">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A fictional character created by Orson Scott Card in his science fiction novel 'Ender's Game'", "chunk_id": "47edadf6e6ee0fba", "doc_id": "hp_34bc485eca379384"}, {"text": "A character in the Ender's Game series.", "chunk_id": "6346895e57a90285", "doc_id": "hp_6a33b6ea9a3a04f5"}]</data>
  <data key="d2">[{"text": "Ender Wiggin is a fictional character from Orson Scott Card's 1985 science fiction novel 'Ender's Game'", "chunk_id": "47edadf6e6ee0fba", "doc_id": "hp_34bc485eca379384"}, {"text": "This book is set in Card's Ender's Game series and takes place during Ender Wiggin's time at Battle School as described in Card's novels 'Ender's Game' and 'Ender's Shadow'.", "chunk_id": "6346895e57a90285", "doc_id": "hp_6a33b6ea9a3a04f5"}]</data>
  <data key="d3">["hp_34bc485eca379384", "hp_6a33b6ea9a3a04f5"]</data>
  <data key="d4">False</data>
</node>
<node id="Ender's Game">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A science fiction novel written by Orson Scott Card, featuring the character Ender Wiggin", "chunk_id": "47edadf6e6ee0fba", "doc_id": "hp_34bc485eca379384"}, {"text": "A short story by Orson Scott Card that was later expanded into a novel.", "chunk_id": "2930b450b52cf755", "doc_id": "hp_6b8c3524cc1eacff"}, {"text": "The original novelette in the Ender's Game series", "chunk_id": "5641991848afac1d", "doc_id": "hp_c306232b10a60f4a"}, {"text": "The first novel in the 'Ender's Game' series by Orson Scott Card.", "chunk_id": "cab513250e896903", "doc_id": "hp_ca5f7f8dd6060ff9"}, {"text": "A science fiction novel written by Orson Scott Card.", "chunk_id": "b72b04661c1a92f6", "doc_id": "hp_e66a1f54686744dd"}, {"text": "An award-winning novel, the first in the series.", "chunk_id": "6d24502c923a3644", "doc_id": "hp_ef5c436bf5c8784a"}]</data>
  <data key="d2">[{"text": "Orson Scott Card's 1985 science fiction novel 'Ender's Game'", "chunk_id": "47edadf6e6ee0fba", "doc_id": "hp_34bc485eca379384"}, {"text": "Ender's Game is a story by Orson Scott Card.", "chunk_id": "2930b450b52cf755", "doc_id": "hp_6b8c3524cc1eacff"}, {"text": "This collection contains the original novelette 'Ender's Game' plus three other stories", "chunk_id": "5641991848afac1d", "doc_id": "hp_c306232b10a60f4a"}, {"text": "Bean, a largely peripheral character in the original novel 'Ender's Game'", "chunk_id": "cab513250e896903", "doc_id": "hp_ca5f7f8dd6060ff9"}, {"text": "His novel 'Ender's Game' (1985) and its sequel 'Speaker for the Dead' (1986) both won Hugo and Nebula Awards,", "chunk_id": "b72b04661c1a92f6", "doc_id": "hp_e66a1f54686744dd"}, {"text": "It takes place between the two award-winning novels: 'Ender's Game' and 'Speaker for the Dead'.", "chunk_id": "6d24502c923a3644", "doc_id": "hp_ef5c436bf5c8784a"}]</data>
  <data key="d3">["hp_34bc485eca379384", "hp_6b8c3524cc1eacff", "hp_c306232b10a60f4a", "hp_ca5f7f8dd6060ff9", "hp_e66a1f54686744dd", "hp_ef5c436bf5c8784a"]</data>
  <data key="d4">False</data>
</node>
