<node id="Ozzy Osbourne">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "English singer, songwriter, and actor", "chunk_id": "e472a3dd7d5e3621", "doc_id": "hp_20d467def1fec319"}, {"text": "British heavy metal singer and songwriter", "chunk_id": "09c1266d4add04e3", "doc_id": "hp_352cd1599ea9ffbf"}, {"text": "Heavy metal musician.", "chunk_id": "5d1c1f9c0d5d3709", "doc_id": "hp_59c709312f028d1c"}, {"text": "Heavy metal singer, father of Jack Osbourne.", "chunk_id": "a336632347978a4e", "doc_id": "hp_6d2014cbadd82348"}, {"text": "Singer of Black Sabbath.", "chunk_id": "4b76c540d4063666", "doc_id": "hp_7018d3531d380e6e"}, {"text": "British heavy metal singer.", "chunk_id": "91eefb0bb72f64bb", "doc_id": "hp_73fddf99709403c0"}, {"text": "A heavy metal singer who founded Ozzfest along with his wife Sharon Osbourne.", "chunk_id": "8d4a7e958e831048", "doc_id": "hp_a3e96a3b5cb0ef4a"}, {"text": "Vocalist of Black Sabbath and solo singer", "chunk_id": "5c2a0b0ed9938e1a", "doc_id": "hp_bc0e2e921bc34adb"}, {"text": "British heavy metal vocalist and songwriter.", "chunk_id": "4d51ae482748920f", "doc_id": "hp_d2e0b0fe646d3d01"}]</data>
  <data key="d2">[{"text": "Ozzy Osbourne is an English singer, songwriter, and actor.", "chunk_id": "e472a3dd7d5e3621", "doc_id": "hp_20d467def1fec319"}, {"text": "Zakk Wylde is best known as the guitarist for Ozzy Osbourne", "chunk_id": "09c1266d4add04e3", "doc_id": "hp_352cd1599ea9ffbf"}, {"text": "The song was written by Osbourne, Bob Daisley, Lee Kerslake and Randy Rhoads.", "chunk_id": "5d1c1f9c0d5d3709", "doc_id": "hp_59c709312f028d1c"}, {"text": "as the son of heavy metal singer Ozzy Osbourne", "chunk_id": "a336632347978a4e", "doc_id": "hp_6d2014cbadd82348"}, {"text": "The music and lyrics were written by singer Ozzy Osbourne and guitarist Tony Iommi.", "chunk_id": "4b76c540d4063666", "doc_id": "hp_7018d3531d380e6e"}, {"text": "by British heavy metal singer Ozzy Osbourne,", "chunk_id": "91eefb0bb72f64bb", "doc_id": "hp_73fddf99709403c0"}, {"text": "It was founded by Ozzy Osbourne and his wife Sharon Osbourne,", "chunk_id": "8d4a7e958e831048", "doc_id": "hp_a3e96a3b5cb0ef4a"}, {"text": "Trust Me, I'm Dr. Ozzy is a book by Ozzy Osbourne", "chunk_id": "5c2a0b0ed9938e1a", "doc_id": "hp_bc0e2e921bc34adb"}, {"text": "No More Tears is the sixth studio album by British heavy metal vocalist and songwriter Ozzy Osbourne.", "chunk_id": "4d51ae482748920f", "doc_id": "hp_d2e0b0fe646d3d01"}]</data>
  <data key="d3">["hp_20d467def1fec319", "hp_352cd1599ea9ffbf", "hp_59c709312f028d1c", "hp_6d2014cbadd82348", "hp_7018d3531d380e6e", "hp_73fddf99709403c0", "hp_a3e96a3b5cb0ef4a", "hp_bc0e2e921bc34adb", "hp_d2e0b0fe646d3d01"]</data>
  <data key="d4">False</data>
</node>
