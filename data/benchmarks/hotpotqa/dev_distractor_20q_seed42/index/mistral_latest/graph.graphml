<node id="Rawkus Records">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Record label that released Black on Both Sides", "chunk_id": "81628c4e342f6c9a", "doc_id": "hp_78dda05d8f1bda23"}, {"text": "Record label that Mos Def was featured on the roster of", "chunk_id": "643533cff5f45740", "doc_id": "hp_7df4d2c802253b1b"}, {"text": "A record label", "chunk_id": "22baaf955e3d521b", "doc_id": "hp_8aff4546ec7963cd"}]</data>
  <data key="d2">[{"text": "Black on Both Sides was released on October 12, 1999, by Rawkus Records", "chunk_id": "81628c4e342f6c9a", "doc_id": "hp_78dda05d8f1bda23"}, {"text": "subsequently formed the duo Black Star, alongside fellow Brooklyn-based rapper Talib Kweli, and they released their eponymous debut album in 1998. He was featured on the roster of Rawkus Records", "chunk_id": "643533cff5f45740", "doc_id": "hp_7df4d2c802253b1b"}, {"text": "In 1998, he made his mainstream debut on Rawkus Records", "chunk_id": "22baaf955e3d521b", "doc_id": "hp_8aff4546ec7963cd"}]</data>
  <data key="d3">["hp_78dda05d8f1bda23", "hp_7df4d2c802253b1b", "hp_8aff4546ec7963cd"]</data>
  <data key="d4">False</data>
</node>
<node id="Columbia Records">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Record label that released Black on Both Sides", "chunk_id": "81628c4e342f6c9a", "doc_id": "hp_78dda05d8f1bda23"}, {"text": "Record label", "chunk_id": "186f64d3b7829d32", "doc_id": "hp_8b0e50661f172c2f"}]</data>
  <data key="d2">[{"text": "Black on Both Sides was released on October 12, 1999, by Rawkus Records and Columbia Records", "chunk_id": "81628c4e342f6c9a", "doc_id": "hp_78dda05d8f1bda23"}, {"text": "was released as a worldwide vinyl on November 27, 2015 by Columbia Records", "chunk_id": "186f64d3b7829d32", "doc_id": "hp_8b0e50661f172c2f"}]</data>
  <data key="d3">["hp_78dda05d8f1bda23", "hp_8b0e50661f172c2f"]</data>
  <data key="d4">False</data>
</node>
<node id="Talib Kweli">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Rapper who collaborated with Mos Def", "chunk_id": "81628c4e342f6c9a", "doc_id": "hp_78dda05d8f1bda23"}, {"text": "Fellow Brooklyn-based rapper who formed Black Star with Mos Def", "chunk_id": "643533cff5f45740", "doc_id": "hp_7df4d2c802253b1b"}, {"text": "A rapper", "chunk_id": "22baaf955e3d521b", "doc_id": "hp_8aff4546ec7963cd"}, {"text": "One of the guest rappers on The Ecstatic.", "chunk_id": "f2f6bd8122079227", "doc_id": "hp_8f34b0e5a3d7884e"}, {"text": "The other half of the Black Star rap duo.", "chunk_id": "4a4d9b71b7761312", "doc_id": "hp_9dba01f371715553"}, {"text": "A rapper who is featured in the 'Afro Samurai OST'.", "chunk_id": "31423454b7a115c5", "doc_id": "hp_cbeadd0af7b1f731"}]</data>
  <data key="d2">[{"text": "Prior to the album's recording, Mos Def had collaborated with rapper Talib Kweli", "chunk_id": "81628c4e342f6c9a", "doc_id": "hp_78dda05d8f1bda23"}, {"text": "he subsequently formed the duo Black Star, alongside fellow Brooklyn-based rapper Talib Kweli", "chunk_id": "643533cff5f45740", "doc_id": "hp_7df4d2c802253b1b"}, {"text": "In 1998, he made his mainstream debut on Rawkus Records in the trio Black Star with rapper Talib Kweli", "chunk_id": "22baaf955e3d521b", "doc_id": "hp_8aff4546ec7963cd"}, {"text": "Singer Georgia Anne Muldrow, formerly of the record label, was one of the album's few guest vocalists, along with rappers Slick Rick and Talib Kweli.", "chunk_id": "f2f6bd8122079227", "doc_id": "hp_8f34b0e5a3d7884e"}, {"text": "The duo is composed of rappers Yasiin Bey (Mos Def) and Talib Kweli.", "chunk_id": "4a4d9b71b7761312", "doc_id": "hp_9dba01f371715553"}, {"text": "Featuring big names such as Big Daddy Kane, Talib Kweli,", "chunk_id": "31423454b7a115c5", "doc_id": "hp_cbeadd0af7b1f731"}]</data>
  <data key="d3">["hp_78dda05d8f1bda23", "hp_7df4d2c802253b1b", "hp_8aff4546ec7963cd", "hp_8f34b0e5a3d7884e", "hp_9dba01f371715553", "hp_cbeadd0af7b1f731"]</data>
  <data key="d4">False</data>
</node>
