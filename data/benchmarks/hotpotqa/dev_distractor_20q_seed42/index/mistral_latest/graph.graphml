  <data key="d2">[{"text": "The Golden Horn Metro Bridge (Turkish: 'Haliç Metro Köprüsü' ) is a cable-stayed bridge along the M2 line of the Istanbul Metro,", "chunk_id": "d05fd6d6f995b106", "doc_id": "hp_2c8d0af31d5b5173"}]</data>
  <data key="d3">["hp_2c8d0af31d5b5173"]</data>
  <data key="d4">False</data>
</node>
<node id="Golden Horn">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A natural harbor in Istanbul, Turkey.", "chunk_id": "d05fd6d6f995b106", "doc_id": "hp_2c8d0af31d5b5173"}, {"text": "A waterway in Istanbul, Turkey where the New Mosque (Istanbul) is situated.", "chunk_id": "23642768860b1af7", "doc_id": "hp_8add77b4bf75704a"}, {"text": "An inlet which separates Galata from the historic peninsula of old Constantinople.", "chunk_id": "8a864c2a09d706a5", "doc_id": "hp_9485f62ca5073136"}, {"text": "A natural harbor on the Bosphorus in Istanbul, Turkey.", "chunk_id": "97ed00f7e059e872", "doc_id": "hp_b850b52a559af773"}, {"text": "A natural harbor in Istanbul.", "chunk_id": "8ce96a987e1bfdb2", "doc_id": "hp_c78ca2de7a779d48"}, {"text": "A natural harbor in Istanbul, Turkey.", "chunk_id": "feb4d8bd4527a1b5", "doc_id": "hp_d08efe5332f5a682"}]</data>
  <data key="d2">[{"text": "The Golden Horn Metro Bridge (Turkish: 'Haliç Metro Köprüsü' ) is a cable-stayed bridge spanning the Golden Horn in Istanbul, Turkey.", "chunk_id": "d05fd6d6f995b106", "doc_id": "hp_2c8d0af31d5b5173"}, {"text": "It is situated on the Golden Horn,", "chunk_id": "23642768860b1af7", "doc_id": "hp_8add77b4bf75704a"}, {"text": "Galata was a neighbourhood opposite Constantinople (today's Istanbul, Turkey), located at the northern shore of the Golden Horn,", "chunk_id": "8a864c2a09d706a5", "doc_id": "hp_9485f62ca5073136"}, {"text": "The Galata Bridge (Turkish: 'Galata Köprüsü' , ] ) is a bridge that spans the Golden Horn in Istanbul, Turkey.", "chunk_id": "97ed00f7e059e872", "doc_id": "hp_b850b52a559af773"}, {"text": "The Galata Bridge crosses the Golden Horn into Eminönü", "chunk_id": "8ce96a987e1bfdb2", "doc_id": "hp_c78ca2de7a779d48"}, {"text": "It consists of two adjoining piers, the Galata Pier and the Salıpazarı Pier, extending from the Galata Bridge on the Golden Horn to Salıpazarı on the west coast of the Bosporus.", "chunk_id": "feb4d8bd4527a1b5", "doc_id": "hp_d08efe5332f5a682"}]</data>
  <data key="d3">["hp_2c8d0af31d5b5173", "hp_8add77b4bf75704a", "hp_9485f62ca5073136", "hp_b850b52a559af773", "hp_c78ca2de7a779d48", "hp_d08efe5332f5a682"]</data>
  <data key="d4">False</data>
</node>
<node id="Istanbul">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city in Turkey.", "chunk_id": "d05fd6d6f995b106", "doc_id": "hp_2c8d0af31d5b5173"}, {"text": "The city where Vefa is located.", "chunk_id": "6013e704fcb7a673", "doc_id": "hp_4d092195517898d9"}, {"text": "The city in Turkey where the New Mosque (Istanbul) is located.", "chunk_id": "23642768860b1af7", "doc_id": "hp_8add77b4bf75704a"}, {"text": "The city where Galata is located today.", "chunk_id": "8a864c2a09d706a5", "doc_id": "hp_9485f62ca5073136"}, {"text": "The city where Hasan Fehmi was murdered.", "chunk_id": "07827c20865c32a2", "doc_id": "hp_99b2c263cece8240"}, {"text": "The largest city in Turkey, located on the Bosphorus Strait.", "chunk_id": "97ed00f7e059e872", "doc_id": "hp_b850b52a559af773"}, {"text": "A city in Turkey.", "chunk_id": "8ce96a987e1bfdb2", "doc_id": "hp_c78ca2de7a779d48"}, {"text": "A city in Turkey.", "chunk_id": "feb4d8bd4527a1b5", "doc_id": "hp_d08efe5332f5a682"}, {"text": "The largest city in Turkey, historically known as Byzantium and Constantinople.", "chunk_id": "2f1b532952105657", "doc_id": "hp_db6d3a8033a7728c"}]</data>
  <data key="d2">[{"text": "The Golden Horn Metro Bridge (Turkish: 'Haliç Metro Köprüsü' ) is a cable-stayed bridge spanning the Golden Horn in Istanbul, Turkey.", "chunk_id": "d05fd6d6f995b106", "doc_id": "hp_2c8d0af31d5b5173"}, {"text": "Vefa is a quarter in Istanbul, Turkey.", "chunk_id": "6013e704fcb7a673", "doc_id": "hp_4d092195517898d9"}, {"text": "The Yeni Cami (pronounced 'Yeni jami'), meaning New Mosque; originally named the Valide Sultan Mosque (Turkish: 'Valide Sultan Camii' ) and later New Valide Sultan Mosque (Turkish: 'Yeni Valide Sultan Camii' ) after its partial reconstruction and completion between 1660 and 1665; is an Ottoman imperial mosque located in the Eminönü quarter of Istanbul, Turkey.", "chunk_id": "23642768860b1af7", "doc_id": "hp_8add77b4bf75704a"}, {"text": "At present, Galata is a quarter within the borough of Beyoğlu (Pera) in Istanbul,", "chunk_id": "8a864c2a09d706a5", "doc_id": "hp_9485f62ca5073136"}, {"text": "He was murdered by unidentified assailants on the evening of April 6, 1909, as he was crossing the Galata Bridge in Istanbul.", "chunk_id": "07827c20865c32a2", "doc_id": "hp_99b2c263cece8240"}, {"text": "The Galata Bridge (Turkish: 'Galata Köprüsü' , ] ) is a bridge that spans the Golden Horn in Istanbul, Turkey.", "chunk_id": "97ed00f7e059e872", "doc_id": "hp_b850b52a559af773"}, {"text": "Eminönü is a former district of Istanbul in Turkey, currently a quarter of Fatih, the province's capital district.", "chunk_id": "8ce96a987e1bfdb2", "doc_id": "hp_c78ca2de7a779d48"}, {"text": "The Port of Istanbul is situated at Karaköy neighborhood of Beyoğlu district in Istanbul, Turkey.", "chunk_id": "feb4d8bd4527a1b5", "doc_id": "hp_d08efe5332f5a682"}, {"text": "converted into a mosque by the Ottomans in Istanbul.", "chunk_id": "2f1b532952105657", "doc_id": "hp_db6d3a8033a7728c"}]</data>
  <data key="d3">["hp_2c8d0af31d5b5173", "hp_4d092195517898d9", "hp_8add77b4bf75704a", "hp_9485f62ca5073136", "hp_99b2c263cece8240", "hp_b850b52a559af773", "hp_c78ca2de7a779d48", "hp_d08efe5332f5a682", "hp_db6d3a8033a7728c"]</data>
