<node id="Damon Albarn">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "English musician, singer-songwriter, and record producer.", "chunk_id": "d79cc507887594f0", "doc_id": "hp_16a863c85d294b86"}, {"text": "English musician", "chunk_id": "dd67e43ec51498e9", "doc_id": "hp_47d8fbed075a2f7b"}, {"text": "The vocalist of the song 2D", "chunk_id": "18aba0732cb837ca", "doc_id": "hp_851def46b317d434"}, {"text": "A musician who wrote and performed the score for Ravenous.", "chunk_id": "0d017a55dd95e10d", "doc_id": "hp_c20074fdff7afd7a"}, {"text": "An English singer, songwriter, and multi-instrumentalist.", "chunk_id": "2da381f11665165b", "doc_id": "hp_c7ba2e25b7b36939"}]</data>
  <data key="d2">[{"text": "The album features guest appearances from Wiley, Giggs, Jme and Damon Albarn.", "chunk_id": "d79cc507887594f0", "doc_id": "hp_16a863c85d294b86"}, {"text": "English musician Damon Albarn", "chunk_id": "dd67e43ec51498e9", "doc_id": "hp_47d8fbed075a2f7b"}, {"text": "The song itself was also the fourth and final single from that album, released on 25 February 2002", "chunk_id": "18aba0732cb837ca", "doc_id": "hp_851def46b317d434"}, {"text": "It was written and performed by Damon Albarn and Michael Nyman", "chunk_id": "0d017a55dd95e10d", "doc_id": "hp_c20074fdff7afd7a"}, {"text": "Damon Albarn, OBE ( ; born 23 March 1968) is an English singer, songwriter, and multi-instrumentalist.", "chunk_id": "2da381f11665165b", "doc_id": "hp_c7ba2e25b7b36939"}]</data>
  <data key="d3">["hp_16a863c85d294b86", "hp_47d8fbed075a2f7b", "hp_851def46b317d434", "hp_c20074fdff7afd7a", "hp_c7ba2e25b7b36939"]</data>
