<node id="The Melvins">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A band produced by Chris Hanzsek in the mid-1980s.", "chunk_id": "bb0ba4b3aa5dba2f", "doc_id": "hp_56d41e480504ab00"}, {"text": "A band whose music was released by C/Z Records.", "chunk_id": "f6302076c8582b74", "doc_id": "hp_9d5ed8e03a7228e1"}]</data>
  <data key="d2">[{"text": "Many of the bands he produced in the mid-1980s are regarded as the foundation of Seattle’s “grunge” scene, such as,", "chunk_id": "bb0ba4b3aa5dba2f", "doc_id": "hp_56d41e480504ab00"}, {"text": "C/Z Records released music by many bands including The Melvins,", "chunk_id": "f6302076c8582b74", "doc_id": "hp_9d5ed8e03a7228e1"}]</data>
  <data key="d3">["hp_56d41e480504ab00", "hp_9d5ed8e03a7228e1"]</data>
