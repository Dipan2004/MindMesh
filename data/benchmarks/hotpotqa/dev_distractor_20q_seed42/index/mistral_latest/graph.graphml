  <data key="d1">[{"text": "A neighborhood opposite Constantinople (today's Istanbul, Turkey), located at the northern shore of the Golden Horn.", "chunk_id": "8a864c2a09d706a5", "doc_id": "hp_9485f62ca5073136"}]</data>
