  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A list where 'Galveston' ranked number 8", "chunk_id": "55f8359be534869b", "doc_id": "hp_34e842e587c27d41"}]</data>
  <data key="d2">[{"text": "In 2003, this song ranked number 8 in 'CMT's 100 Greatest Songs in Country Music'", "chunk_id": "55f8359be534869b", "doc_id": "hp_34e842e587c27d41"}]</data>
