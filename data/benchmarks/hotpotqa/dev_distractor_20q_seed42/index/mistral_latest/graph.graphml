  <data key="d2">[{"text": "All of their studio albums have been certified gold in Denmark. Their second album 'Rock the Rebel/Metal the Devil' received platinum status,", "chunk_id": "a1be31889d49283c", "doc_id": "hp_63397630deb516ba"}]</data>
  <data key="d3">["hp_63397630deb516ba"]</data>
