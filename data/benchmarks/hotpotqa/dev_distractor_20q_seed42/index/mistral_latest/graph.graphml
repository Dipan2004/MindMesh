<node id="Galata Bridge">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A bridge in Istanbul, Turkey.", "chunk_id": "d05fd6d6f995b106", "doc_id": "hp_2c8d0af31d5b5173"}, {"text": "A bridge in Istanbul, Turkey where the New Mosque (Istanbul) is located at the southern end.", "chunk_id": "23642768860b1af7", "doc_id": "hp_8add77b4bf75704a"}, {"text": "A bridge crossing the Golden Horn.", "chunk_id": "8a864c2a09d706a5", "doc_id": "hp_9485f62ca5073136"}, {"text": "A bridge in Istanbul, Turkey.", "chunk_id": "07827c20865c32a2", "doc_id": "hp_99b2c263cece8240"}, {"text": "A bridge that spans the Golden Horn in Istanbul, Turkey.", "chunk_id": "97ed00f7e059e872", "doc_id": "hp_b850b52a559af773"}, {"text": "A bridge in Istanbul.", "chunk_id": "8ce96a987e1bfdb2", "doc_id": "hp_c78ca2de7a779d48"}, {"text": "A bridge on the Golden Horn.", "chunk_id": "feb4d8bd4527a1b5", "doc_id": "hp_d08efe5332f5a682"}]</data>
  <data key="d2">[{"text": "It is located between the Galata Bridge and Atatürk Bridge,", "chunk_id": "d05fd6d6f995b106", "doc_id": "hp_2c8d0af31d5b5173"}, {"text": "at the southern end of the Galata Bridge,", "chunk_id": "23642768860b1af7", "doc_id": "hp_8add77b4bf75704a"}, {"text": "The Golden Horn is crossed by several bridges, most notably the Galata Bridge.", "chunk_id": "8a864c2a09d706a5", "doc_id": "hp_9485f62ca5073136"}, {"text": "He was murdered by unidentified assailants on the evening of April 6, 1909, as he was crossing the Galata Bridge in Istanbul.", "chunk_id": "07827c20865c32a2", "doc_id": "hp_99b2c263cece8240"}, {"text": "The Galata Bridge (Turkish: 'Galata Köprüsü' , ] ) is a bridge that spans the Golden Horn in Istanbul, Turkey.", "chunk_id": "97ed00f7e059e872", "doc_id": "hp_b850b52a559af773"}, {"text": "The Galata Bridge crosses the Golden Horn into Eminönü", "chunk_id": "8ce96a987e1bfdb2", "doc_id": "hp_c78ca2de7a779d48"}, {"text": "It consists of two adjoining piers, the Galata Pier and the Salıpazarı Pier, extending from the Galata Bridge on the Golden Horn to Salıpazarı on the west coast of the Bosporus.", "chunk_id": "feb4d8bd4527a1b5", "doc_id": "hp_d08efe5332f5a682"}]</data>
  <data key="d3">["hp_2c8d0af31d5b5173", "hp_8add77b4bf75704a", "hp_9485f62ca5073136", "hp_99b2c263cece8240", "hp_b850b52a559af773", "hp_c78ca2de7a779d48", "hp_d08efe5332f5a682"]</data>
