<node id="Animality Studies">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "An emerging interdisciplinary academic field focused on the cultural study of animals and animality.", "chunk_id": "5fc31ffb146ddffb", "doc_id": "hp_960f69dbac6fa186"}]</data>
  <data key="d2">[{"text": "Animality studies is an emerging interdisciplinary academic field focused on the cultural study of animals and animality.", "chunk_id": "5fc31ffb146ddffb", "doc_id": "hp_960f69dbac6fa186"}]</data>
  <data key="d3">["hp_960f69dbac6fa186"]</data>
  <data key="d4">False</data>
</node>
<node id="Michael Lundblad">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A scholar who has contributed to the understanding of Animality Studies.", "chunk_id": "5fc31ffb146ddffb", "doc_id": "hp_960f69dbac6fa186"}]</data>
  <data key="d2">[{"text": "According to Michael Lundblad, 'If animal studies can be seen as work that explores representations of animality and related discourses with an emphasis on advocacy for nonhuman animals, animality studies becomes work that emphasizes the history of animality in relation to human cultural studies, without an explicit call for nonhuman advocacy.'", "chunk_id": "5fc31ffb146ddffb", "doc_id": "hp_960f69dbac6fa186"}]</data>
  <data key="d3">["hp_960f69dbac6fa186"]</data>
  <data key="d4">False</data>
</node>
<node id="Animal Studies">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A field of study that explores representations of animality and related discourses with an emphasis on advocacy for nonhuman animals.", "chunk_id": "5fc31ffb146ddffb", "doc_id": "hp_960f69dbac6fa186"}]</data>
  <data key="d2">[{"text": "If animal studies can be seen as work that explores representations of animality and related discourses with an emphasis on advocacy for nonhuman animals,", "chunk_id": "5fc31ffb146ddffb", "doc_id": "hp_960f69dbac6fa186"}]</data>
  <data key="d3">["hp_960f69dbac6fa186"]</data>
  <data key="d4">False</data>
</node>
