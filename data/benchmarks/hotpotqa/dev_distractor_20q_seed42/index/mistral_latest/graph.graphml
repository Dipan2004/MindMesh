<node id="David Byrne">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "American musician, singer, songwriter, and record producer", "chunk_id": "0c51c0fd5fd6bc00", "doc_id": "hp_c3aae0f5d44dec11"}]</data>
  <data key="d2">[{"text": "Discussing 'SexyBack', Timberlake revealed that he went 'left', singing the song in a rock style, not an R&amp;B style. He described the song as musicians David Bowie and David Byrne 'covering' James Brown's 1970 song 'Sex Machine'.", "chunk_id": "0c51c0fd5fd6bc00", "doc_id": "hp_c3aae0f5d44dec11"}]</data>
  <data key="d3">["hp_c3aae0f5d44dec11"]</data>
  <data key="d4">False</data>
</node>
<node id="James Brown">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "American singer, songwriter, and dancer", "chunk_id": "0c51c0fd5fd6bc00", "doc_id": "hp_c3aae0f5d44dec11"}]</data>
  <data key="d2">[{"text": "It was written and produced by Nate Hills, Tim Mosley, and Timberlake himself. Discussing 'SexyBack', Timberlake revealed that he went 'left', singing the song in a rock style, not an R&amp;B style. He described the song as musicians David Bowie and David Byrne 'covering' James Brown's 1970 song 'Sex Machine'.", "chunk_id": "0c51c0fd5fd6bc00", "doc_id": "hp_c3aae0f5d44dec11"}]</data>
  <data key="d3">["hp_c3aae0f5d44dec11"]</data>
  <data key="d4">False</data>
</node>
