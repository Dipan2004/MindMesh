  <data key="d2">[{"text": "As a singer, he was an expert of the techniques of 'Ragam-Thanam-Pallavi'.", "chunk_id": "5854eec81cd8ae74", "doc_id": "hp_aa4783fa3ad3d831"}]</data>
  <data key="d3">["hp_aa4783fa3ad3d831"]</data>
