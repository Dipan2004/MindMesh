</node>
<node id="Kocky">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An alias of Soul Supreme for his more electro themed music.", "chunk_id": "d010d64c5585b76a", "doc_id": "hp_02cdfef001149f0f"}]</data>
  <data key="d2">[{"text": "Soul Supreme also makes more electro themed music (his own name of this style is rapclash) under the name Kocky.", "chunk_id": "d010d64c5585b76a", "doc_id": "hp_02cdfef001149f0f"}]</data>
  <data key="d3">["hp_02cdfef001149f0f"]</data>
