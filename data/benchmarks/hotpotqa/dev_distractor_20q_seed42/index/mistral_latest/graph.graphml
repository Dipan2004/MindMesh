<node id="The Rockfords">
  <data key="d0">MUSIC_GROUP</data>
  <data key="d1">[{"text": "An American rock band formed in Seattle, Washington in 1999 by members of Goodness, Pearl Jam, and Jodie Watts.", "chunk_id": "e75c71d95fdb03f2", "doc_id": "hp_05e3ff9fbf16bf9f"}, {"text": "A rock band formed by some members of Goodness and Mike McCready of Pearl Jam.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
  <data key="d2">[{"text": "The Rockfords were an American rock band formed in Seattle, Washington, in 1999 by Carrie Akre, Chris Friel, and Danny Newcomb of Goodness, Mike McCready of Pearl Jam, and Rick Friel of Jodie Watts.", "chunk_id": "e75c71d95fdb03f2", "doc_id": "hp_05e3ff9fbf16bf9f"}, {"text": "Akre, Friel, and Newcomb later joined Mike McCready of Pearl Jam and Rick Friel to form the rock band The Rockfords.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
  <data key="d3">["hp_05e3ff9fbf16bf9f", "hp_cf04d33334830067"]</data>
  <data key="d4">False</data>
</node>
<node id="Carrie Akre">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A member of The Rockfords who was also a member of Goodness.", "chunk_id": "e75c71d95fdb03f2", "doc_id": "hp_05e3ff9fbf16bf9f"}, {"text": "An American musician known for her work with Seattle underground bands Hammerbox and Goodness.", "chunk_id": "0d888cee944dc2cb", "doc_id": "hp_2afa90f7ec34b459"}, {"text": "American artist who released the album 'Home' as a solo effort.", "chunk_id": "605e16b648692dcc", "doc_id": "hp_3c2e01e472de9860"}, {"text": "The American artist who released the second solo studio album 'Invitation'.", "chunk_id": "b18abfa9fd7927c5", "doc_id": "hp_690e5c7c5fa7319e"}, {"text": "American artist.", "chunk_id": "cc9810d79e9cd34d", "doc_id": "hp_79210cfd3b874967"}, {"text": "A musician who was the leader of Goodness and is now primarily a solo artist.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
  <data key="d2">[{"text": "The Rockfords were an American rock band formed in Seattle, Washington, in 1999 by Carrie Akre, Chris Friel, and Danny Newcomb of Goodness, Mike McCready of Pearl Jam, and Rick Friel of Jodie Watts.", "chunk_id": "e75c71d95fdb03f2", "doc_id": "hp_05e3ff9fbf16bf9f"}, {"text": "Carrie Akre is an American musician best known for her work with Seattle underground bands Hammerbox and Goodness.", "chunk_id": "0d888cee944dc2cb", "doc_id": "hp_2afa90f7ec34b459"}, {"text": "Home is the debut solo studio album by the American artist Carrie Akre.", "chunk_id": "605e16b648692dcc", "doc_id": "hp_3c2e01e472de9860"}, {"text": "Invitation is the second solo studio album by the American artist Carrie Akre.", "chunk_id": "b18abfa9fd7927c5", "doc_id": "hp_690e5c7c5fa7319e"}, {"text": "Last the Evening is the third solo studio album by the American artist Carrie Akre.", "chunk_id": "cc9810d79e9cd34d", "doc_id": "hp_79210cfd3b874967"}, {"text": "Goodness was an American rock band from Seattle, Washington, led by Carrie Akre,", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
  <data key="d3">["hp_05e3ff9fbf16bf9f", "hp_2afa90f7ec34b459", "hp_3c2e01e472de9860", "hp_690e5c7c5fa7319e", "hp_79210cfd3b874967", "hp_cf04d33334830067"]</data>
  <data key="d4">False</data>
</node>
