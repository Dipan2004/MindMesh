  <data key="d1">[{"text": "'Stop the Lights' is The Walls' third album released in 2012.", "chunk_id": "c543d9f719f81ba3", "doc_id": "hp_22cdae208a33e842"}]</data>
  <data key="d2">[{"text": "The band's third album 'Stop the Lights' was released in 2012.", "chunk_id": "c543d9f719f81ba3", "doc_id": "hp_22cdae208a33e842"}]</data>
