<node id="Donald Davenport">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A billionaire genius who marries Leo Dooley's mother.", "chunk_id": "ddba7c8ee8c2f4a2", "doc_id": "hp_f788a91a3c89341c"}]</data>
  <data key="d2">[{"text": "He meets Adam, Bree, and Chase, three bionic superhumans, with whom he develops an immediate friendship. It should be noted that the names of the Lab Rats imply that they were originally known as subjects A, B, C and D. Adam was born first, then Bree, then Chase, and finally Daniel.", "chunk_id": "ddba7c8ee8c2f4a2", "doc_id": "hp_f788a91a3c89341c"}]</data>
