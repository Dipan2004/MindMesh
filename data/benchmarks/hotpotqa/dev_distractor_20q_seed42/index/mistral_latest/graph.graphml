  <data key="d2">[{"text": "Lili Elbe (28 December 1882 – 13 September 1931), was a Danish transgender woman and one of the first identifiable recipients of sex reassignment surgery.", "chunk_id": "7ac08a74cbccd041", "doc_id": "hp_20a176ec128ccbc1"}]</data>
  <data key="d3">["hp_20a176ec128ccbc1"]</data>
