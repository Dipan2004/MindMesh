</node>
<node id="successful painter">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A person who creates art using painting as their primary medium and has achieved success in their career.", "chunk_id": "7ac08a74cbccd041", "doc_id": "hp_20a176ec128ccbc1"}]</data>
  <data key="d2">[{"text": "She was a successful painter under that name", "chunk_id": "7ac08a74cbccd041", "doc_id": "hp_20a176ec128ccbc1"}]</data>
