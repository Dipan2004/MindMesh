<node id="Nic Harcourt">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "'Nic Harcourt' is a radio DJ who invited The Walls to play a session on his show 'Morning Becomes Eclectic'.", "chunk_id": "c543d9f719f81ba3", "doc_id": "hp_22cdae208a33e842"}]</data>
  <data key="d2">[{"text": "The first track on the album 'Open Road' proved a favourite with Nic Harcourt on his KCRW show 'Morning Becomes Eclectic' and he invited the band to play a session on the show in 2006.", "chunk_id": "c543d9f719f81ba3", "doc_id": "hp_22cdae208a33e842"}]</data>
  <data key="d3">["hp_22cdae208a33e842"]</data>
  <data key="d4">False</data>
</node>
<node id="SXSW">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "'SXSW' is a music festival in Austin, Texas where The Walls played.", "chunk_id": "c543d9f719f81ba3", "doc_id": "hp_22cdae208a33e842"}]</data>
  <data key="d2">[{"text": "They played SXSW in Austin, Texas, a few days beforehand.", "chunk_id": "c543d9f719f81ba3", "doc_id": "hp_22cdae208a33e842"}]</data>
  <data key="d3">["hp_22cdae208a33e842"]</data>
