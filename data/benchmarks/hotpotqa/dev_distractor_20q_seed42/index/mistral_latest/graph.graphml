  <data key="d2">[{"text": "The season continues to center on the 'Five-0', a specialized task force established by the Hawaiian Governor that investigates a wide series of crimes on the islands, including murder, terrorism and human trafficking.", "chunk_id": "3d49511f8c3edd63", "doc_id": "hp_fa9ffe891ace7e19"}]</data>
