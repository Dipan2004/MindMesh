<node id="Alex O'Loughlin">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An Australian actor who plays Lieutenant Commander Steve McGarrett on CBS' remake of the TV series 'Hawaii Five-0'.", "chunk_id": "cfd994121564872e", "doc_id": "hp_20060fbadf0d0f35"}, {"text": "Plays the role of Mick St. John in Moonlight (TV series).", "chunk_id": "a4ceb8b6ffc33d70", "doc_id": "hp_ddb4be1f6446790d"}, {"text": "An actor who plays Steve McGarrett in the remake of the TV series 'Hawaii Five-O'.", "chunk_id": "17b50df45a4d6de4", "doc_id": "hp_e80df4db57feed70"}, {"text": "The main actor of 'Hawaii Five-0' who briefly did not appear in episodes 20 and 21 due to seeking drug treatment.", "chunk_id": "3d49511f8c3edd63", "doc_id": "hp_fa9ffe891ace7e19"}]</data>
  <data key="d2">[{"text": "Alex O'Loughlin (born 24 August 1976) is an Australian actor, who plays Lieutenant Commander Steve McGarrett on CBS' remake of the TV series 'Hawaii Five-0'.", "chunk_id": "cfd994121564872e", "doc_id": "hp_20060fbadf0d0f35"}, {"text": "Mick St. John (Alex O'Loughlin)", "chunk_id": "a4ceb8b6ffc33d70", "doc_id": "hp_ddb4be1f6446790d"}, {"text": "also by Alex O'Loughlin in the remake.", "chunk_id": "17b50df45a4d6de4", "doc_id": "hp_e80df4db57feed70"}, {"text": "Alex O'Loughlin appears briefly in episode 20 and does not appear in episode 21 as he was seeking drug treatment for pain management medication during the production of those two episodes.", "chunk_id": "3d49511f8c3edd63", "doc_id": "hp_fa9ffe891ace7e19"}]</data>
  <data key="d3">["hp_20060fbadf0d0f35", "hp_ddb4be1f6446790d", "hp_e80df4db57feed70", "hp_fa9ffe891ace7e19"]</data>
  <data key="d4">False</data>
</node>
