  <data key="d1">[{"text": "A music group that Mike McCready was also a member of.", "chunk_id": "e75c71d95fdb03f2", "doc_id": "hp_05e3ff9fbf16bf9f"}, {"text": "An American rock band that Matt Cameron is a drummer for.", "chunk_id": "ff51adc6561b5ed8", "doc_id": "hp_0748d5c101636e45"}, {"text": "A rock band that some members of Goodness later joined.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
  <data key="d2">[{"text": "The Rockfords were an American rock band formed in Seattle, Washington, in 1999 by Carrie Akre, Chris Friel, and Danny Newcomb of Goodness, Mike McCready of Pearl Jam, and Rick Friel of Jodie Watts.", "chunk_id": "e75c71d95fdb03f2", "doc_id": "hp_05e3ff9fbf16bf9f"}, {"text": "Pearl Jam and Soundgarden are the American rock bands that Matt Cameron is a drummer for.", "chunk_id": "ff51adc6561b5ed8", "doc_id": "hp_0748d5c101636e45"}, {"text": "Akre, Friel, and Newcomb later joined Mike McCready of Pearl Jam and Rick Friel to form the rock band The Rockfords.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
