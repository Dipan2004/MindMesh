  <data key="d2">[{"text": "along with his father, mother Sharon", "chunk_id": "a336632347978a4e", "doc_id": "hp_6d2014cbadd82348"}, {"text": "It was founded by Ozzy Osbourne and his wife Sharon Osbourne,", "chunk_id": "8d4a7e958e831048", "doc_id": "hp_a3e96a3b5cb0ef4a"}]</data>
