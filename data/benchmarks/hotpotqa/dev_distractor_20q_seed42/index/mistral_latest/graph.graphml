  <data key="d2">[{"text": "Constantine 'Vision' Walker, also known as 'Vision' or 'Dream' (born Constantine Anthony Walker, Jr., 19 October 1951, Jamaica), is a singer songwriter and musician.", "chunk_id": "4e49b289111a751e", "doc_id": "hp_90c59ae0834808d2"}]</data>
