  <data key="d1">[{"text": "The full name of Anatoly Maltsev.", "chunk_id": "c59938cdf2826d2c", "doc_id": "hp_d20ba85a57590c30"}]</data>
  <data key="d2">[{"text": "Anatoly Ivanovich Maltsev (also: Malcev, Mal'cev; Russian: Анато́лий Ива́нович Ма́льцев; 27 November N.S./14 November O.S. 1909, Moscow Governorate – 7 June 1967, Novosibirsk) was born in Misheronsky, near Moscow, and died in Novosibirsk, USSR.", "chunk_id": "c59938cdf2826d2c", "doc_id": "hp_d20ba85a57590c30"}]</data>
  <data key="d3">["hp_d20ba85a57590c30"]</data>
  <data key="d4">False</data>
</node>
