  <data key="d1">[{"text": "'Drowning Pool' is a single from The Walls' album 'New Dawn Breaking'.", "chunk_id": "c543d9f719f81ba3", "doc_id": "hp_22cdae208a33e842"}, {"text": "American rock band.", "chunk_id": "d6eb6532f8d34a23", "doc_id": "hp_2bc1fd7192286912"}, {"text": "An American rock band.", "chunk_id": "e7ca1b057b3c3a05", "doc_id": "hp_389288c2c9645042"}, {"text": "An American rock band formed in Dallas, Texas in 1996.", "chunk_id": "2b4a74884d741640", "doc_id": "hp_5ecd62dcccb5e178"}, {"text": "A music band that Ryan McCombs became the new vocalist of in the following year.", "chunk_id": "9bf6c5d9ac078751", "doc_id": "hp_6d3fb3f9a8564cfc"}, {"text": "An American rock band.", "chunk_id": "7830d4b4aeada632", "doc_id": "hp_7007c67b9629d513"}, {"text": "An American rock band.", "chunk_id": "a04d0d1adf9fe998", "doc_id": "hp_9c1cb830d1e8e8d8"}, {"text": "American rock band.", "chunk_id": "87c64cae2dacb9b9", "doc_id": "hp_ab2568200ef5820b"}, {"text": "American rock band.", "chunk_id": "95b512d4f2ca3a69", "doc_id": "hp_bd9ff2902eabd8e6"}, {"text": "An American rock band.", "chunk_id": "2a19866561212519", "doc_id": "hp_cb968384356313ee"}]</data>
  <data key="d2">[{"text": "'New Dawn Breaking' included 'To the Bright and Shining Sun' and three other singles: 'Drowning Pool', 'Passing Through' and 'Black and Blue'.", "chunk_id": "c543d9f719f81ba3", "doc_id": "hp_22cdae208a33e842"}, {"text": "Drowning Pool is the eponymous fourth studio album by American rock band Drowning Pool.", "chunk_id": "d6eb6532f8d34a23", "doc_id": "hp_2bc1fd7192286912"}, {"text": "Drowning Pool's self-titled album.", "chunk_id": "e7ca1b057b3c3a05", "doc_id": "hp_389288c2c9645042"}, {"text": "Drowning Pool is an American rock band formed in Dallas, Texas in 1996.", "chunk_id": "2b4a74884d741640", "doc_id": "hp_5ecd62dcccb5e178"}, {"text": "He would go on to become the new vocalist of Drowning Pool the following year.", "chunk_id": "9bf6c5d9ac078751", "doc_id": "hp_6d3fb3f9a8564cfc"}, {"text": "Loudest Common Denominator is a live album by American rock band Drowning Pool,", "chunk_id": "7830d4b4aeada632", "doc_id": "hp_7007c67b9629d513"}, {"text": "Step Up is a single by American rock band Drowning Pool.", "chunk_id": "a04d0d1adf9fe998", "doc_id": "hp_9c1cb830d1e8e8d8"}, {"text": "Resilience is the fifth studio album by American rock band Drowning Pool.", "chunk_id": "87c64cae2dacb9b9", "doc_id": "hp_ab2568200ef5820b"}, {"text": "Drowning Pool is the debut studio album by American rock band Drowning Pool.", "chunk_id": "95b512d4f2ca3a69", "doc_id": "hp_bd9ff2902eabd8e6"}, {"text": "37 Stitches is a song by American rock band Drowning Pool", "chunk_id": "2a19866561212519", "doc_id": "hp_cb968384356313ee"}]</data>
  <data key="d3">["hp_22cdae208a33e842", "hp_2bc1fd7192286912", "hp_389288c2c9645042", "hp_5ecd62dcccb5e178", "hp_6d3fb3f9a8564cfc", "hp_7007c67b9629d513", "hp_9c1cb830d1e8e8d8", "hp_ab2568200ef5820b", "hp_bd9ff2902eabd8e6", "hp_cb968384356313ee"]</data>
