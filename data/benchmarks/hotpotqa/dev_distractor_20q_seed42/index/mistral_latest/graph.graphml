  <data key="d2">[{"text": "Many visiting luminaries of the musical world have visited the School throughout its existence. this include maestros Yehudi Menuhin, Isaac Stern and Mstislav Rostropovich.", "chunk_id": "e135f2e20308e863", "doc_id": "hp_5290019d032852f5"}]</data>
