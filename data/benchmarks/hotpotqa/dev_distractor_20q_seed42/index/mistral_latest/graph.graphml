<node id="NBC">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The National Broadcasting Company, an American commercial broadcast television and radio network headquartered in New York City.", "chunk_id": "cc9981f89b3d1923", "doc_id": "hp_7e6ecca5f60697cd"}, {"text": "A major American broadcast television network.", "chunk_id": "702e5a74aed1bc94", "doc_id": "hp_e8285dadbc32439e"}, {"text": "A major American broadcast television network.", "chunk_id": "1d759448fd704b25", "doc_id": "hp_ebd15cd476a830f6"}, {"text": "The television network that aired the sitcom 'Friends'.", "chunk_id": "8f5e44d5eaa0b180", "doc_id": "hp_fe2995b8c6a6f60f"}]</data>
