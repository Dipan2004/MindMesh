  <data key="d2">[{"text": "It was released on July 18, 2006, to US mainstream and rhythmic radio stations by Jive Records as the lead single from the album.", "chunk_id": "0c51c0fd5fd6bc00", "doc_id": "hp_c3aae0f5d44dec11"}]</data>
