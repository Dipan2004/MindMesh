  <data key="d1">[{"text": "'Ennistymon' is the hometown of The Walls where a video was shot for the song 'Stop the Lights'.", "chunk_id": "c543d9f719f81ba3", "doc_id": "hp_22cdae208a33e842"}]</data>
  <data key="d2">[{"text": "A video was shot for the song in the brother's hometown, Ennistymon, and in the Dublin mountains.", "chunk_id": "c543d9f719f81ba3", "doc_id": "hp_22cdae208a33e842"}]</data>
