  <data key="d2">[{"text": "Greta Garbo (born Greta Lovisa Gustafsson; ] ; 18 September 1905 – 15 April 1990), was a Swedish-born American film actress during the 1920s and 1930s.", "chunk_id": "ab9c0365b8dd8a08", "doc_id": "hp_52ccb7f4b77e7575"}]</data>
