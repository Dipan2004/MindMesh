<node id="Ender's Game series">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A series of science fiction novels.", "chunk_id": "6346895e57a90285", "doc_id": "hp_6a33b6ea9a3a04f5"}, {"text": "A series of science fiction novels that includes 'Ender's Game'.", "chunk_id": "2930b450b52cf755", "doc_id": "hp_6b8c3524cc1eacff"}, {"text": "A science fiction series by Orson Scott Card", "chunk_id": "5641991848afac1d", "doc_id": "hp_c306232b10a60f4a"}, {"text": "A series of novels by Orson Scott Card.", "chunk_id": "cab513250e896903", "doc_id": "hp_ca5f7f8dd6060ff9"}, {"text": "A series of science fiction novels.", "chunk_id": "6d24502c923a3644", "doc_id": "hp_ef5c436bf5c8784a"}]</data>
  <data key="d2">[{"text": "This book is set in Card's Ender's Game series and takes place during Ender Wiggin's time at Battle School as described in Card's novels 'Ender's Game' and 'Ender's Shadow'.", "chunk_id": "6346895e57a90285", "doc_id": "hp_6a33b6ea9a3a04f5"}, {"text": "Although the foundation of the Ender's Game series, the short story is not properly part of the 'Ender's Game' universe.", "chunk_id": "2930b450b52cf755", "doc_id": "hp_6b8c3524cc1eacff"}, {"text": "List of Ender's Game series short stories", "chunk_id": "5641991848afac1d", "doc_id": "hp_c306232b10a60f4a"}, {"text": "It is also the sixth novel in the 'Ender's Game' series.", "chunk_id": "cab513250e896903", "doc_id": "hp_ca5f7f8dd6060ff9"}, {"text": "Ender in Exile is part of the 'Ender's Game' series,", "chunk_id": "6d24502c923a3644", "doc_id": "hp_ef5c436bf5c8784a"}]</data>
  <data key="d3">["hp_6a33b6ea9a3a04f5", "hp_6b8c3524cc1eacff", "hp_c306232b10a60f4a", "hp_ca5f7f8dd6060ff9", "hp_ef5c436bf5c8784a"]</data>
  <data key="d4">False</data>
</node>
