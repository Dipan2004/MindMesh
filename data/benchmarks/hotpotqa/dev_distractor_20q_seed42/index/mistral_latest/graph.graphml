  <data key="d2">[{"text": "and founder of the heavy metal band Black Label Society", "chunk_id": "09c1266d4add04e3", "doc_id": "hp_352cd1599ea9ffbf"}, {"text": "Nick Catanese (born June 2, 1971) is the former rhythm guitarist for Black Label Society.", "chunk_id": "6f8cd692ca8c4c37", "doc_id": "hp_c3744e475528ea1b"}]</data>
