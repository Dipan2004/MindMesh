<node id="Black Sabbath">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Heavy metal band", "chunk_id": "e472a3dd7d5e3621", "doc_id": "hp_20d467def1fec319"}, {"text": "A heavy metal band.", "chunk_id": "4b76c540d4063666", "doc_id": "hp_7018d3531d380e6e"}, {"text": "A heavy metal band that has played the Ozzfest tour several times over the years.", "chunk_id": "8d4a7e958e831048", "doc_id": "hp_a3e96a3b5cb0ef4a"}, {"text": "A heavy metal band", "chunk_id": "5c2a0b0ed9938e1a", "doc_id": "hp_bc0e2e921bc34adb"}]</data>
  <data key="d2">[{"text": "He rose to prominence in the early 1970s as the lead vocalist of the heavy metal band Black Sabbath.", "chunk_id": "e472a3dd7d5e3621", "doc_id": "hp_20d467def1fec319"}, {"text": "\"Psycho Man\" is a single by heavy metal band Black Sabbath.", "chunk_id": "4b76c540d4063666", "doc_id": "hp_7018d3531d380e6e"}, {"text": "Ozzy Osbourne and Black Sabbath have played the tour several times over the years.", "chunk_id": "8d4a7e958e831048", "doc_id": "hp_a3e96a3b5cb0ef4a"}, {"text": "Trust Me, I'm Dr. Ozzy is a book by Ozzy Osbourne", "chunk_id": "5c2a0b0ed9938e1a", "doc_id": "hp_bc0e2e921bc34adb"}]</data>
  <data key="d3">["hp_20d467def1fec319", "hp_7018d3531d380e6e", "hp_a3e96a3b5cb0ef4a", "hp_bc0e2e921bc34adb"]</data>
