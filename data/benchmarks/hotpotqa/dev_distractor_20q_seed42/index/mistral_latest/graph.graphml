<node id="Semyon Aranovich Gershgorin">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A Soviet mathematician born in Pruzhany, Belarus, Russian Empire.", "chunk_id": "a041460133d02683", "doc_id": "hp_9b099ecbc2af015a"}]</data>
  <data key="d2">[{"text": "Semyon Aranovich Gershgorin (August 24, 1901 – May 30, 1933) was a Soviet (born in Pruzhany, Belarus, Russian Empire) mathematician.", "chunk_id": "a041460133d02683", "doc_id": "hp_9b099ecbc2af015a"}]</data>
  <data key="d3">["hp_9b099ecbc2af015a"]</data>
  <data key="d4">False</data>
</node>
<node id="Petrograd Technological Institute">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The institute where Semyon Aranovich Gershgorin started as a student.", "chunk_id": "a041460133d02683", "doc_id": "hp_9b099ecbc2af015a"}]</data>
  <data key="d2">[{"text": "He began as a student at the Petrograd Technological Institute in 1923,", "chunk_id": "a041460133d02683", "doc_id": "hp_9b099ecbc2af015a"}]</data>
  <data key="d3">["hp_9b099ecbc2af015a"]</data>
  <data key="d4">False</data>
</node>
<node id="Leningrad Mechanical Engineering Institute">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The institute where Semyon Aranovich Gershgorin was given an appointment in 1930.", "chunk_id": "a041460133d02683", "doc_id": "hp_9b099ecbc2af015a"}]</data>
  <data key="d2">[{"text": "and was given an appointment at the Leningrad Mechanical Engineering Institute in the same year.", "chunk_id": "a041460133d02683", "doc_id": "hp_9b099ecbc2af015a"}]</data>
  <data key="d3">["hp_9b099ecbc2af015a"]</data>
  <data key="d4">False</data>
</node>
