<node id="February 15, 2014">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The date when the Golden Horn Metro Bridge entered service.", "chunk_id": "d05fd6d6f995b106", "doc_id": "hp_2c8d0af31d5b5173"}]</data>
  <data key="d2">[{"text": "The bridge enables a direct connection between the Hacıosman metro station in the Sarıyer district (at the northern end of the M2 line), with the Yenikapı transport hub in the Fatih district (at the southern end of the M2 line.) It is the fourth bridge across the Golden Horn and entered service on February 15, 2014.", "chunk_id": "d05fd6d6f995b106", "doc_id": "hp_2c8d0af31d5b5173"}]</data>
  <data key="d3">["hp_2c8d0af31d5b5173"]</data>
  <data key="d4">False</data>
</node>
