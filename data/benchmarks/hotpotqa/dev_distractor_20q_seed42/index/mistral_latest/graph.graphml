<node id="RIAA">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An organization that certified 'Galveston' gold", "chunk_id": "55f8359be534869b", "doc_id": "hp_34e842e587c27d41"}, {"text": "An organization that awarded a gold disc for selling over one million copies of 'Daddy Don't You Walk So Fast'", "chunk_id": "f21c075b3102cbb1", "doc_id": "hp_386e8adc135dee41"}, {"text": "Recording Industry Association of America.", "chunk_id": "91eefb0bb72f64bb", "doc_id": "hp_73fddf99709403c0"}, {"text": "The Recording Industry Association of America.", "chunk_id": "4d51ae482748920f", "doc_id": "hp_d2e0b0fe646d3d01"}]</data>
  <data key="d2">[{"text": "It was certified gold by the RIAA in October 1969.", "chunk_id": "55f8359be534869b", "doc_id": "hp_34e842e587c27d41"}, {"text": "The song sold over one million copies and was awarded a gold disc by the RIAA in July 1972", "chunk_id": "f21c075b3102cbb1", "doc_id": "hp_386e8adc135dee41"}, {"text": "The album was certified Gold by the RIAA on 5 February 2005 with an excess of 500,000 copies sold,", "chunk_id": "91eefb0bb72f64bb", "doc_id": "hp_73fddf99709403c0"}, {"text": "having been certified quadruple platinum by the RIAA", "chunk_id": "4d51ae482748920f", "doc_id": "hp_d2e0b0fe646d3d01"}]</data>
  <data key="d3">["hp_34e842e587c27d41", "hp_386e8adc135dee41", "hp_73fddf99709403c0", "hp_d2e0b0fe646d3d01"]</data>
  <data key="d4">False</data>
</node>
<node id="Zakk Wylde">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "American musician, singer, songwriter, multi-instrumentalist and occasional actor", "chunk_id": "09c1266d4add04e3", "doc_id": "hp_352cd1599ea9ffbf"}, {"text": "Guitarist who is a returning member of Black Utopia.", "chunk_id": "647d44f6e0c49d5f", "doc_id": "hp_5a2664ec13cdb5d0"}, {"text": "Lead player for Black Label Society", "chunk_id": "6f8cd692ca8c4c37", "doc_id": "hp_c3744e475528ea1b"}]</data>
  <data key="d2">[{"text": "Zakk Wylde (born Jeffrey Phillip Wielandt on January 14, 1967) is an American musician, singer, songwriter, multi-instrumentalist and occasional actor", "chunk_id": "09c1266d4add04e3", "doc_id": "hp_352cd1599ea9ffbf"}, {"text": "In addition to the returning members Zakk Wylde, Simon Phillips and Steve Lukather,", "chunk_id": "647d44f6e0c49d5f", "doc_id": "hp_5a2664ec13cdb5d0"}, {"text": "He supported lead player Zakk Wylde,", "chunk_id": "6f8cd692ca8c4c37", "doc_id": "hp_c3744e475528ea1b"}]</data>
  <data key="d3">["hp_352cd1599ea9ffbf", "hp_5a2664ec13cdb5d0", "hp_c3744e475528ea1b"]</data>
  <data key="d4">False</data>
</node>
