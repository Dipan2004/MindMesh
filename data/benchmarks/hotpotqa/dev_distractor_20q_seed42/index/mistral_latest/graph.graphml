  <data key="d2">[{"text": "CBS' remake of the TV series 'Hawaii Five-0'.", "chunk_id": "cfd994121564872e", "doc_id": "hp_20060fbadf0d0f35"}, {"text": "The first season of the CBS crime drama series 'Hawaii Five-0' premiered on September 20, 2010,", "chunk_id": "32bc1bb3818ef3ee", "doc_id": "hp_4f3a38b2a8eb6aa9"}, {"text": "The seventh season of the CBS police procedural drama series 'Hawaii Five-0' premiered on Friday September 23, 2016,", "chunk_id": "cddd6b4dd1338ff1", "doc_id": "hp_606f6baf8df7d319"}, {"text": "The second season of the CBS crime drama series 'Hawaii Five-0' premiered on September 19, 2011.", "chunk_id": "3d49511f8c3edd63", "doc_id": "hp_fa9ffe891ace7e19"}]</data>
