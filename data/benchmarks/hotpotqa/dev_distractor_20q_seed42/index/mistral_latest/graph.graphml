<node id="Republic of Genoa">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A medieval maritime republic based in Genoa, Italy.", "chunk_id": "8a864c2a09d706a5", "doc_id": "hp_9485f62ca5073136"}]</data>
  <data key="d2">[{"text": "The medieval citadel of Galata was a colony of the Republic of Genoa between 1273 and 1453.", "chunk_id": "8a864c2a09d706a5", "doc_id": "hp_9485f62ca5073136"}]</data>
  <data key="d3">["hp_9485f62ca5073136"]</data>
