<node id="Ole Bull">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The orchestra's concertmaster for the National Peace Jubilee.", "chunk_id": "54c4e158ee117648", "doc_id": "hp_a184463289502adc"}]</data>
  <data key="d2">[{"text": "More than 11,000 performers participated, including the famous violinist Ole Bull as the orchestra's concertmaster,", "chunk_id": "54c4e158ee117648", "doc_id": "hp_a184463289502adc"}]</data>
  <data key="d3">["hp_a184463289502adc"]</data>
