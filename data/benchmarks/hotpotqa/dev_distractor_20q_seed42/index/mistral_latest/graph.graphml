  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A grunge band, along with others, that was active before Mark Arm's Green River.", "chunk_id": "cae565d472109bc9", "doc_id": "hp_013fb9aeb127f70e"}, {"text": "A band produced by Chris Hanzsek in the mid-1980s.", "chunk_id": "bb0ba4b3aa5dba2f", "doc_id": "hp_56d41e480504ab00"}]</data>
  <data key="d2">[{"text": "along with Malfunkshun,", "chunk_id": "cae565d472109bc9", "doc_id": "hp_013fb9aeb127f70e"}, {"text": "Many of the bands he produced in the mid-1980s are regarded as the foundation of Seattle’s “grunge” scene, such as,", "chunk_id": "bb0ba4b3aa5dba2f", "doc_id": "hp_56d41e480504ab00"}]</data>
  <data key="d3">["hp_013fb9aeb127f70e", "hp_56d41e480504ab00"]</data>
  <data key="d4">False</data>
</node>
<node id="Soundgarden">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A grunge band, along with others, that was active before Mark Arm's Green River.", "chunk_id": "cae565d472109bc9", "doc_id": "hp_013fb9aeb127f70e"}, {"text": "An American rock band that Matt Cameron was a drummer for.", "chunk_id": "ff51adc6561b5ed8", "doc_id": "hp_0748d5c101636e45"}, {"text": "A band produced by Chris Hanzsek in the mid-1980s.", "chunk_id": "bb0ba4b3aa5dba2f", "doc_id": "hp_56d41e480504ab00"}, {"text": "An American grunge band formed in Seattle in 1984", "chunk_id": "8f7c543867f8149e", "doc_id": "hp_acb30982d60159fb"}, {"text": "A grunge band.", "chunk_id": "7990c5b328a154e9", "doc_id": "hp_c1de7fdb47a70603"}]</data>
  <data key="d2">[{"text": "along with Soundgarden,", "chunk_id": "cae565d472109bc9", "doc_id": "hp_013fb9aeb127f70e"}, {"text": "Pearl Jam and Soundgarden are the American rock bands that Matt Cameron is a drummer for.", "chunk_id": "ff51adc6561b5ed8", "doc_id": "hp_0748d5c101636e45"}, {"text": "Many of the bands he produced in the mid-1980s are regarded as the foundation of Seattle’s “grunge” scene, such as,", "chunk_id": "bb0ba4b3aa5dba2f", "doc_id": "hp_56d41e480504ab00"}, {"text": "Norman Scott also briefly joined Soundgarden", "chunk_id": "8f7c543867f8149e", "doc_id": "hp_acb30982d60159fb"}, {"text": "Endino worked on seminal albums from bands such as Mudhoney, Soundgarden,", "chunk_id": "7990c5b328a154e9", "doc_id": "hp_c1de7fdb47a70603"}]</data>
  <data key="d3">["hp_013fb9aeb127f70e", "hp_0748d5c101636e45", "hp_56d41e480504ab00", "hp_acb30982d60159fb", "hp_c1de7fdb47a70603"]</data>
  <data key="d4">False</data>
</node>
<node id="Skin Yard">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A grunge band, along with others, that was active before Mark Arm's Green River.", "chunk_id": "cae565d472109bc9", "doc_id": "hp_013fb9aeb127f70e"}, {"text": "A Seattle-based band that Matt Cameron was a part of.", "chunk_id": "ff51adc6561b5ed8", "doc_id": "hp_0748d5c101636e45"}, {"text": "A band produced by Chris Hanzsek in the mid-1980s.", "chunk_id": "bb0ba4b3aa5dba2f", "doc_id": "hp_56d41e480504ab00"}, {"text": "A band that released the album Skin Yard in January, 1987.", "chunk_id": "9434d79f77345376", "doc_id": "hp_787ac37fd5dd2e81"}, {"text": "A band that Daniel House co-founded and was a bass-player for, active from 1985 to 1992.", "chunk_id": "f6302076c8582b74", "doc_id": "hp_9d5ed8e03a7228e1"}, {"text": "An American grunge band from Seattle, Washington active from 1985 to 1993.", "chunk_id": "f214ceb752342b01", "doc_id": "hp_a8d8b97768a7a5ac"}, {"text": "Early Grunge pioneers", "chunk_id": "8f7c543867f8149e", "doc_id": "hp_acb30982d60159fb"}, {"text": "The music group Jack Endino was a member of.", "chunk_id": "83900d84b46529a2", "doc_id": "hp_bb540f2beee795b9"}, {"text": "A Seattle-based band.", "chunk_id": "7990c5b328a154e9", "doc_id": "hp_c1de7fdb47a70603"}]</data>
  <data key="d2">[{"text": "along with Skin Yard,", "chunk_id": "cae565d472109bc9", "doc_id": "hp_013fb9aeb127f70e"}, {"text": "After getting his start with the Seattle, Washington-based bands Bam Bam and Skin Yard,", "chunk_id": "ff51adc6561b5ed8", "doc_id": "hp_0748d5c101636e45"}, {"text": "Many of the bands he produced in the mid-1980s are regarded as the foundation of Seattle’s “grunge” scene, such as,", "chunk_id": "bb0ba4b3aa5dba2f", "doc_id": "hp_56d41e480504ab00"}, {"text": "Skin Yard was the first album released by the band Skin Yard in January, 1987.", "chunk_id": "9434d79f77345376", "doc_id": "hp_787ac37fd5dd2e81"}, {"text": "He was a co-founder and bass-player for Skin Yard, a band that was active from 1985 to 1992,", "chunk_id": "f6302076c8582b74", "doc_id": "hp_9d5ed8e03a7228e1"}, {"text": "Skin Yard was an American grunge band from Seattle, Washington, who were active from 1985 to 1993.", "chunk_id": "f214ceb752342b01", "doc_id": "hp_a8d8b97768a7a5ac"}, {"text": "Norman Scott, drummer of Gruntruck, was previously from early Grunge pioneers Skin Yard", "chunk_id": "8f7c543867f8149e", "doc_id": "hp_acb30982d60159fb"}, {"text": "It was produced by Jack Endino of Skin Yard.", "chunk_id": "83900d84b46529a2", "doc_id": "hp_bb540f2beee795b9"}, {"text": "Endino was also the guitarist for the Seattle band Skin Yard which was active between 1985 and 1992.", "chunk_id": "7990c5b328a154e9", "doc_id": "hp_c1de7fdb47a70603"}]</data>
  <data key="d3">["hp_013fb9aeb127f70e", "hp_0748d5c101636e45", "hp_56d41e480504ab00", "hp_787ac37fd5dd2e81", "hp_9d5ed8e03a7228e1", "hp_a8d8b97768a7a5ac", "hp_acb30982d60159fb", "hp_bb540f2beee795b9", "hp_c1de7fdb47a70603"]</data>
  <data key="d4">False</data>
</node>
