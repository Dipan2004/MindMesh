<node id="C/Z Records">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A record label co-founded by Chris Hanzsek and Tina Casale in 1984.", "chunk_id": "bb0ba4b3aa5dba2f", "doc_id": "hp_56d41e480504ab00"}, {"text": "A Seattle-based independent record label owned by Daniel House that released music by many bands.", "chunk_id": "f6302076c8582b74", "doc_id": "hp_9d5ed8e03a7228e1"}]</data>
  <data key="d2">[{"text": "Chris Hanzsek and Tina Casale co-founded C/Z Records in 1984.", "chunk_id": "bb0ba4b3aa5dba2f", "doc_id": "hp_56d41e480504ab00"}, {"text": "He was President and owner of C/Z Records,", "chunk_id": "f6302076c8582b74", "doc_id": "hp_9d5ed8e03a7228e1"}]</data>
