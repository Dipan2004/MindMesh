<graph edgedefault="directed"><node id="Budweiser Frogs">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Three lifelike puppet frogs used in Budweiser beer commercials", "chunk_id": "b3372712df8d7f5e", "doc_id": "hp_011359774e6954fd"}]</data>
  <data key="d2">[{"text": "The Budweiser Frogs are three lifelike puppet frogs named 'Bud', 'Weis', and 'Er', who began appearing in American television commercials for Budweiser beer", "chunk_id": "b3372712df8d7f5e", "doc_id": "hp_011359774e6954fd"}]</data>
