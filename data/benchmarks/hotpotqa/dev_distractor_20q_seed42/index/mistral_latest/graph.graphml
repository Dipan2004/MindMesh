<node id="Mos Def">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An American rapper and actor who collaborated with Jill Scott on 'Love Rain'.", "chunk_id": "b24a26a0e617e930", "doc_id": "hp_1ad25513177f0f20"}, {"text": "American rapper", "chunk_id": "850b6d47f0851c92", "doc_id": "hp_685ae04edcf36e54"}, {"text": "American rapper", "chunk_id": "81628c4e342f6c9a", "doc_id": "hp_78dda05d8f1bda23"}, {"text": "American hip hop recording artist, actor, and activist", "chunk_id": "643533cff5f45740", "doc_id": "hp_7df4d2c802253b1b"}, {"text": "An American rapper", "chunk_id": "22baaf955e3d521b", "doc_id": "hp_8aff4546ec7963cd"}, {"text": "American rapper who released The Ecstatic in 2009.", "chunk_id": "f2f6bd8122079227", "doc_id": "hp_8f34b0e5a3d7884e"}, {"text": "A rapper, actor, and musician who hosted the Def Poetry Jam television series.", "chunk_id": "18204867dabae48d", "doc_id": "hp_fd7e658ea942e6ec"}]</data>
  <data key="d2">[{"text": "The song appears twice on Scott's debut album 'Who Is Jill Scott? Words and Sounds Vol. 1' with Mos Def.", "chunk_id": "b24a26a0e617e930", "doc_id": "hp_1ad25513177f0f20"}, {"text": "True Magic is the third studio album by American rapper Mos Def.", "chunk_id": "850b6d47f0851c92", "doc_id": "hp_685ae04edcf36e54"}, {"text": "Black on Both Sides is the debut album of American rapper Mos Def", "chunk_id": "81628c4e342f6c9a", "doc_id": "hp_78dda05d8f1bda23"}, {"text": "Mos Def Yasiin Bey ( ) (born Dante Terrell Smith; December 11, 1973), best known by his stage name Mos Def ( ), is an American hip hop recording artist, actor and activist", "chunk_id": "643533cff5f45740", "doc_id": "hp_7df4d2c802253b1b"}, {"text": "The discography of Yasiin Bey / Mos Def, an American rapper,", "chunk_id": "22baaf955e3d521b", "doc_id": "hp_8aff4546ec7963cd"}, {"text": "Mos Def signed with Downtown Records and recorded 'The Ecstatic' primarily at the Record Plant in Los Angeles.", "chunk_id": "f2f6bd8122079227", "doc_id": "hp_8f34b0e5a3d7884e"}, {"text": "The series features performances by established and up-coming spoken word poets. Performances also include special appearances by well-known actors and musicians, as well as occasional performances by Mos Def himself.", "chunk_id": "18204867dabae48d", "doc_id": "hp_fd7e658ea942e6ec"}]</data>
  <data key="d3">["hp_1ad25513177f0f20", "hp_685ae04edcf36e54", "hp_78dda05d8f1bda23", "hp_7df4d2c802253b1b", "hp_8aff4546ec7963cd", "hp_8f34b0e5a3d7884e", "hp_fd7e658ea942e6ec"]</data>
  <data key="d4">False</data>
</node>
