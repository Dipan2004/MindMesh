  <data key="d1">[{"text": "A science fiction novel that is part of the series featuring Ender Wiggin", "chunk_id": "47edadf6e6ee0fba", "doc_id": "hp_34bc485eca379384"}, {"text": "A science fiction novel written by Orson Scott Card.", "chunk_id": "b72b04661c1a92f6", "doc_id": "hp_e66a1f54686744dd"}, {"text": "An award-winning novel, the sequel to 'Ender's Game'.", "chunk_id": "6d24502c923a3644", "doc_id": "hp_ef5c436bf5c8784a"}]</data>
  <data key="d2">[{"text": "and its sequels ('Speaker for the Dead', 'Xenocide', 'Children of the Mind', 'Ender in Exile')", "chunk_id": "47edadf6e6ee0fba", "doc_id": "hp_34bc485eca379384"}, {"text": "His novel 'Ender's Game' (1985) and its sequel 'Speaker for the Dead' (1986) both won Hugo and Nebula Awards,", "chunk_id": "b72b04661c1a92f6", "doc_id": "hp_e66a1f54686744dd"}, {"text": "It takes place between the two award-winning novels: 'Ender's Game' and 'Speaker for the Dead'.", "chunk_id": "6d24502c923a3644", "doc_id": "hp_ef5c436bf5c8784a"}]</data>
