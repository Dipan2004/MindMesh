</node>
<node id="La Vida Locash">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The label that released Soul Supreme's electro-house album under his alias Kocky.", "chunk_id": "d010d64c5585b76a", "doc_id": "hp_02cdfef001149f0f"}]</data>
  <data key="d2">[{"text": "The album was released by La Vida Locash and features guest appearances by Timbuktu, Chords, Mapei, and Jens Lekman.", "chunk_id": "d010d64c5585b76a", "doc_id": "hp_02cdfef001149f0f"}]</data>
