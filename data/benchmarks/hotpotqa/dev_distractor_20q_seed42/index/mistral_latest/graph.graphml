<node id="Constantine Orbelian">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A person who directed the Russian folk ensemble Style of Five in the album I Met You, My Love", "chunk_id": "5f6f3da94d6c3ec5", "doc_id": "hp_26c8b41bd7f102d4"}, {"text": "An American conductor and pianist of Armenian and Russian descent.", "chunk_id": "185b3ac3a93315a8", "doc_id": "hp_9b088777f58c1aa0"}, {"text": "Conductor who worked with Dmitry Hvorostovsky on the album", "chunk_id": "cebb948ca2b64e89", "doc_id": "hp_eb61935064babbc1"}]</data>
  <data key="d2">[{"text": "directed Constantine Orbelian.", "chunk_id": "5f6f3da94d6c3ec5", "doc_id": "hp_26c8b41bd7f102d4"}, {"text": "Constantine Orbelian, Constantine Garrievich Orbelian, Jr. (Armenian: Կոնստանտին Օրբելյան , Russian: Константин Гарриевич Орбелян , born San Francisco, 27 August 1956) is an American conductor and pianist of Armenian and Russian descent.", "chunk_id": "185b3ac3a93315a8", "doc_id": "hp_9b088777f58c1aa0"}, {"text": "baritone Dmitry Hvorostovsky and conductor Constantine Orbelian for Delos Productions", "chunk_id": "cebb948ca2b64e89", "doc_id": "hp_eb61935064babbc1"}]</data>
  <data key="d3">["hp_26c8b41bd7f102d4", "hp_9b088777f58c1aa0", "hp_eb61935064babbc1"]</data>
  <data key="d4">False</data>
</node>
