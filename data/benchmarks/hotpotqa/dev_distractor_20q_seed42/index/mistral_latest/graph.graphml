  <data key="d2">[{"text": "The mine is owned by Freeport-McMoRan.", "chunk_id": "096a17c17e8970c6", "doc_id": "hp_8c5c533bb57bcc22"}]</data>
  <data key="d3">["hp_8c5c533bb57bcc22"]</data>
  <data key="d4">False</data>
</node>
<node id="chalcopyrite">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A copper mineral.", "chunk_id": "096a17c17e8970c6", "doc_id": "hp_8c5c533bb57bcc22"}]</data>
  <data key="d2">[{"text": "Copper is produced from chalcopyrite and molybdenum from molybdenite.", "chunk_id": "096a17c17e8970c6", "doc_id": "hp_8c5c533bb57bcc22"}]</data>
  <data key="d3">["hp_8c5c533bb57bcc22"]</data>
  <data key="d4">False</data>
</node>
<node id="molybdenite">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A mineral containing molybdenum.", "chunk_id": "096a17c17e8970c6", "doc_id": "hp_8c5c533bb57bcc22"}]</data>
  <data key="d2">[{"text": "Copper is produced from chalcopyrite and molybdenum from molybdenite.", "chunk_id": "096a17c17e8970c6", "doc_id": "hp_8c5c533bb57bcc22"}]</data>
  <data key="d3">["hp_8c5c533bb57bcc22"]</data>
  <data key="d4">False</data>
