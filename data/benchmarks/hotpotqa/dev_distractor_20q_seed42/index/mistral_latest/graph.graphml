  <data key="d1">[{"text": "A singer who performs in concerts.", "chunk_id": "c8c7ed513bc29557", "doc_id": "hp_bea168b1d94d1cf5"}]</data>
  <data key="d2">[{"text": "She began her career in the 1940s as a concert singer...", "chunk_id": "c8c7ed513bc29557", "doc_id": "hp_bea168b1d94d1cf5"}]</data>
  <data key="d3">["hp_bea168b1d94d1cf5"]</data>
  <data key="d4">False</data>
</node>
<node id="opera">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A theatrical performance that is typically sung through, with a libretto, music, and orchestra.", "chunk_id": "c8c7ed513bc29557", "doc_id": "hp_bea168b1d94d1cf5"}]</data>
  <data key="d2">[{"text": "She did not draw wider acclaim until she began singing opera in her late thirties.", "chunk_id": "c8c7ed513bc29557", "doc_id": "hp_bea168b1d94d1cf5"}]</data>
  <data key="d3">["hp_bea168b1d94d1cf5"]</data>
  <data key="d4">False</data>
</node>
<node id="oratorio">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A musical composition for solo voices, choir, and orchestra, usually based on a religious text.", "chunk_id": "c8c7ed513bc29557", "doc_id": "hp_bea168b1d94d1cf5"}]</data>
  <data key="d2">[{"text": "She often chose, against tradition, to sing oratorios from memory.", "chunk_id": "c8c7ed513bc29557", "doc_id": "hp_bea168b1d94d1cf5"}]</data>
  <data key="d3">["hp_bea168b1d94d1cf5"]</data>
  <data key="d4">False</data>
</node>
<node id="Metropolitan Opera">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A major opera company located in New York City.", "chunk_id": "c8c7ed513bc29557", "doc_id": "hp_bea168b1d94d1cf5"}]</data>
  <data key="d2">[{"text": "She had a long and celebrated career at the Metropolitan Opera in New York City from 1962 through 1986.", "chunk_id": "c8c7ed513bc29557", "doc_id": "hp_bea168b1d94d1cf5"}]</data>
  <data key="d3">["hp_bea168b1d94d1cf5"]</data>
  <data key="d4">False</data>
</node>
<node id="New York City">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The most populous city in the United States.", "chunk_id": "c8c7ed513bc29557", "doc_id": "hp_bea168b1d94d1cf5"}, {"text": "The most populous city in the U.S. state of New York.", "chunk_id": "702e5a74aed1bc94", "doc_id": "hp_e8285dadbc32439e"}]</data>
  <data key="d2">[{"text": "She had a long and celebrated career at the Metropolitan Opera in New York City from 1962 through 1986.", "chunk_id": "c8c7ed513bc29557", "doc_id": "hp_bea168b1d94d1cf5"}, {"text": "he lives in New York City", "chunk_id": "702e5a74aed1bc94", "doc_id": "hp_e8285dadbc32439e"}]</data>
  <data key="d3">["hp_bea168b1d94d1cf5", "hp_e8285dadbc32439e"]</data>
  <data key="d4">False</data>
</node>
<node id="Girl studies">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "An interdisciplinary academic field of study focused on girlhood and girls' culture that combines advocacy and the direct perspectives and thoughts of girls themselves.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d2">[{"text": "Girl studies, also known as girlhood studies, is an interdisciplinary academic field of study that is focused on girlhood and girls' culture that combines advocacy and the direct perspectives and thoughts of girls themselves.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d3">["hp_c08097d1ab5e6587"]</data>
  <data key="d4">False</data>
</node>
<node id="girlhood studies">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A term used to refer to girl studies.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d2">[{"text": "Girl studies, also known as girlhood studies,", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d3">["hp_c08097d1ab5e6587"]</data>
  <data key="d4">False</data>
</node>
<node id="scholars within girl studies">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Individuals who work in the field of girl studies.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d2">[{"text": "Scholars within girl studies examine social and cultural elements of girlhood and move away from an adult-centered focus.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d3">["hp_c08097d1ab5e6587"]</data>
  <data key="d4">False</data>
</node>
<node id="sociology">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The study of society and social behavior.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d2">[{"text": "Those working in the field of girl studies have studied it primarily in relation to other fields that include sociology,", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d3">["hp_c08097d1ab5e6587"]</data>
  <data key="d4">False</data>
</node>
<node id="psychology">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The scientific study of behavior, mind, and mental processes.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d2">[{"text": "Those working in the field of girl studies have studied it primarily in relation to other fields that include psychology,", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d3">["hp_c08097d1ab5e6587"]</data>
  <data key="d4">False</data>
</node>
<node id="education">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The process of facilitating and guiding learning.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d2">[{"text": "Those working in the field of girl studies have studied it primarily in relation to other fields that include education,", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d3">["hp_c08097d1ab5e6587"]</data>
  <data key="d4">False</data>
</node>
<node id="history">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The study of past events, particularly in human history.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d2">[{"text": "Those working in the field of girl studies have studied it primarily in relation to other fields that include history,", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d3">["hp_c08097d1ab5e6587"]</data>
  <data key="d4">False</data>
</node>
<node id="literary studies">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The academic study of literature.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d2">[{"text": "Those working in the field of girl studies have studied it primarily in relation to other fields that include literary studies,", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d3">["hp_c08097d1ab5e6587"]</data>
  <data key="d4">False</data>
</node>
<node id="media studies">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The academic study of media and its impact on society.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d2">[{"text": "Those working in the field of girl studies have studied it primarily in relation to other fields that include media studies,", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d3">["hp_c08097d1ab5e6587"]</data>
  <data key="d4">False</data>
</node>
<node id="communication studies">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The academic study of human communication in social, cultural, and institutional contexts.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d2">[{"text": "Those working in the field of girl studies have studied it primarily in relation to other fields that include communication studies,", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d3">["hp_c08097d1ab5e6587"]</data>
  <data key="d4">False</data>
</node>
<node id="women's studies">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The academic study of women, women's issues, and feminism.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d2">[{"text": "The field officially emerged in the 1990s after decades of falling under the broader field of women’s studies.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d3">["hp_c08097d1ab5e6587"]</data>
  <data key="d4">False</data>
</node>
<node id="boyhood studies">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A field of study that focuses on boyhood and boys' culture.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d2">[{"text": "Scholars in girl studies also explore the connection the field has to women's studies, boyhood studies, and masculinity studies.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d3">["hp_c08097d1ab5e6587"]</data>
  <data key="d4">False</data>
</node>
<node id="masculinity studies">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A field of study that focuses on masculinity and men's issues.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d2">[{"text": "Scholars in girl studies also explore the connection the field has to women's studies, boyhood studies, and masculinity studies.", "chunk_id": "ab2182b1bd93ddc0", "doc_id": "hp_c08097d1ab5e6587"}]</data>
  <data key="d3">["hp_c08097d1ab5e6587"]</data>
  <data key="d4">False</data>
</node>
