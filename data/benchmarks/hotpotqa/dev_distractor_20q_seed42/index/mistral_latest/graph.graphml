  <data key="d1">[{"text": "Guitarist/vocalist of Kekal.", "chunk_id": "6721554446d9968a", "doc_id": "hp_744c00c06093c70c"}]</data>
  <data key="d2">[{"text": "Frequently labeled as black metal, progressive metal, and avant-garde metal, Kekal plays a very diverse range of music styles within the frame of metal and rock, incorporating many other music genres such as ambient, electronic, jazz fusion, and progressive rock. Over the course of its career, Kekal has transitioned from a heavy metal-based style to a more experimental and electronic sound.", "chunk_id": "6721554446d9968a", "doc_id": "hp_744c00c06093c70c"}]</data>
  <data key="d3">["hp_744c00c06093c70c"]</data>
