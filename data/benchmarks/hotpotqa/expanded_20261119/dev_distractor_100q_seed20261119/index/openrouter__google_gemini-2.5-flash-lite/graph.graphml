<node id="South Asia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A subregion of Asia.", "chunk_id": "9432ffb2818fa833", "doc_id": "hp_9c94d1d46a54f88d"}, {"text": "A geographical region where Sino-Tibetan languages are spoken.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d2">[{"text": "As a gateway to Southeast and South Asia, Changshui Airport is a hub for China Eastern Airlines, Kunming Airlines, Lucky Air, Sichuan Airlines and Ruili Airlines.", "chunk_id": "9432ffb2818fa833", "doc_id": "hp_9c94d1d46a54f88d"}, {"text": "The Sino-Tibetan languages, in a few sources also known as Tibeto-Burman or Trans-Himalayan, are a family of more than 400 languages spoken in East Asia, Southeast Asia and South Asia.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d3">["hp_9c94d1d46a54f88d", "hp_b4175e524ae4a823"]</data>
  <data key="d4">False</data>
</node>
