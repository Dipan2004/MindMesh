<node id="Joseph D. Pistone">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A former FBI agent who worked undercover for six years infiltrating the Bonanno crime family and to a lesser extent the Colombo crime family.", "chunk_id": "e73f7ce666aa44ac", "doc_id": "hp_e188311f102838e1"}]</data>
  <data key="d2">[{"text": "Joseph Dominick \"Joe\" Pistone, alias Donnie Brasco, (born September 17, 1939), is a former FBI agent who worked undercover for six years infiltrating the Bonanno crime family and to a lesser extent the Colombo crime family, two of the Five Families of the Mafia in New York City.", "chunk_id": "e73f7ce666aa44ac", "doc_id": "hp_e188311f102838e1"}]</data>
  <data key="d3">["hp_e188311f102838e1"]</data>
  <data key="d4">False</data>
</node>
