<node id="NBC">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A television network where the first series aired.", "chunk_id": "aff35d971d199517", "doc_id": "hp_1ccc4746739c0eec"}]</data>
  <data key="d2">[{"text": "The first series aired on NBC from 1949 to 1950, and was hosted by Robert L. Ripley until his death, after which several substitute hosts filled in.", "chunk_id": "aff35d971d199517", "doc_id": "hp_1ccc4746739c0eec"}]</data>
  <data key="d3">["hp_1ccc4746739c0eec"]</data>
