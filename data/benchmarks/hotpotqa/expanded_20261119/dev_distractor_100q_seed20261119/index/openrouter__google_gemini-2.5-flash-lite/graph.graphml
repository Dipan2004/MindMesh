  <data key="d2">[{"text": "Manon Lescaut is an opera in four acts by Giacomo Puccini, composed between 1890 and 1893.", "chunk_id": "41a807c0946f5ef1", "doc_id": "hp_de6d3adc813848a7"}]</data>
  <data key="d3">["hp_de6d3adc813848a7"]</data>
  <data key="d4">False</data>
</node>
<node id="L'histoire du chevalier des Grieux et de Manon Lescaut">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A novel written in 1731 by the Abbé Prévost.", "chunk_id": "41a807c0946f5ef1", "doc_id": "hp_de6d3adc813848a7"}]</data>
  <data key="d2">[{"text": "The story is based on the 1731 novel \"L'histoire du chevalier des Grieux et de Manon Lescaut\" by the Abbé Prévost and should not be confused with \"Manon\", an 1884 opera by Jules Massenet based on the same novel.", "chunk_id": "41a807c0946f5ef1", "doc_id": "hp_de6d3adc813848a7"}]</data>
  <data key="d3">["hp_de6d3adc813848a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Jules Massenet">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The composer of the opera \"Manon\".", "chunk_id": "41a807c0946f5ef1", "doc_id": "hp_de6d3adc813848a7"}]</data>
  <data key="d2">[{"text": "The story is based on the 1731 novel \"L'histoire du chevalier des Grieux et de Manon Lescaut\" by the Abbé Prévost and should not be confused with \"Manon\", an 1884 opera by Jules Massenet based on the same novel.", "chunk_id": "41a807c0946f5ef1", "doc_id": "hp_de6d3adc813848a7"}]</data>
  <data key="d3">["hp_de6d3adc813848a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Freedom of movement">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The ability of citizens to move freely between states within the United States.", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d2">[{"text": "Freedom of movement under United States law is governed primarily by the Privileges and Immunities Clause of the United States Constitution which states, \"The Citizens of each State shall be entitled to all Privileges and Immunities of Citizens in the several States.\"", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d3">["hp_de77e95616995229"]</data>
  <data key="d4">False</data>
</node>
<node id="United States law">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The legal system of the United States.", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d2">[{"text": "Freedom of movement under United States law is governed primarily by the Privileges and Immunities Clause of the United States Constitution which states, \"The Citizens of each State shall be entitled to all Privileges and Immunities of Citizens in the several States.\"", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d3">["hp_de77e95616995229"]</data>
  <data key="d4">False</data>
</node>
<node id="Privileges and Immunities Clause">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A clause in the United States Constitution that governs the rights of citizens moving between states.", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d2">[{"text": "Freedom of movement under United States law is governed primarily by the Privileges and Immunities Clause of the United States Constitution which states, \"The Citizens of each State shall be entitled to all Privileges and Immunities of Citizens in the several States.\"", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d3">["hp_de77e95616995229"]</data>
  <data key="d4">False</data>
</node>
<node id="United States Constitution">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The supreme law of the United States.", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d2">[{"text": "Freedom of movement under United States law is governed primarily by the Privileges and Immunities Clause of the United States Constitution which states, \"The Citizens of each State shall be entitled to all Privileges and Immunities of Citizens in the several States.\"", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d3">["hp_de77e95616995229"]</data>
  <data key="d4">False</data>
</node>
<node id="Corfield v. Coryell">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A circuit court ruling from 1823 that recognized freedom of movement as a fundamental constitutional right.", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d2">[{"text": "As far back as the circuit court ruling in \"Corfield v. Coryell,\" 6 Fed. Cas. 546 (1823), freedom of movement has been judicially recognized as a fundamental Constitutional right.", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d3">["hp_de77e95616995229"]</data>
  <data key="d4">False</data>
</node>
<node id="Paul v. Virginia">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Supreme Court case from 1869 that defined freedom of movement.", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d2">[{"text": "In \"Paul v. Virginia,\" 75 U.S. 168 (1869), the Court defined freedom of movement as \"right of free ingress into other States, and egress from them.\"", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d3">["hp_de77e95616995229"]</data>
  <data key="d4">False</data>
</node>
<node id="Ward v. Maryland">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Supreme Court case from 1871.", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d2">[{"text": "Under the \"privileges and immunities\" clause, this authority was given to the states, a position the Court held consistently through the years in cases such as \"Ward v. Maryland,\" 79 U.S. 418 (1871), the \"Slaughter-House Cases,\" 83 U.S. 36 (1873) and \"United States v. Harris,\" 106 U.S. 629 (1883).", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d3">["hp_de77e95616995229"]</data>
  <data key="d4">False</data>
</node>
<node id="Slaughter-House Cases">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Supreme Court case from 1873.", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d2">[{"text": "Under the \"privileges and immunities\" clause, this authority was given to the states, a position the Court held consistently through the years in cases such as \"Ward v. Maryland,\" 79 U.S. 418 (1871), the \"Slaughter-House Cases,\" 83 U.S. 36 (1873) and \"United States v. Harris,\" 106 U.S. 629 (1883).", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d3">["hp_de77e95616995229"]</data>
  <data key="d4">False</data>
</node>
<node id="United States v. Harris">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Supreme Court case from 1883.", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d2">[{"text": "Under the \"privileges and immunities\" clause, this authority was given to the states, a position the Court held consistently through the years in cases such as \"Ward v. Maryland,\" 79 U.S. 418 (1871), the \"Slaughter-House Cases,\" 83 U.S. 36 (1873) and \"United States v. Harris,\" 106 U.S. 629 (1883).", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d3">["hp_de77e95616995229"]</data>
  <data key="d4">False</data>
</node>
<node id="Jack Ryan">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A former FBI agent and police officer.", "chunk_id": "d4daa9d905f1b0e6", "doc_id": "hp_df0d4a55e8bc0f2f"}]</data>
  <data key="d2">[{"text": "John C. \"Jack\" Ryan (born 19 June 1938) is a former FBI agent and police officer.", "chunk_id": "d4daa9d905f1b0e6", "doc_id": "hp_df0d4a55e8bc0f2f"}]</data>
  <data key="d3">["hp_df0d4a55e8bc0f2f"]</data>
  <data key="d4">False</data>
</node>
<node id="LA Times">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A newspaper that published a report about Jack Ryan.", "chunk_id": "d4daa9d905f1b0e6", "doc_id": "hp_df0d4a55e8bc0f2f"}]</data>
  <data key="d2">[{"text": "In a report by the \"LA Times\", he stated his belief that the Bureau could reinstate him to a position which would not conflict with his personal beliefs that U.S. involvement in Central America is \"violent, illegal and immoral.\"", "chunk_id": "d4daa9d905f1b0e6", "doc_id": "hp_df0d4a55e8bc0f2f"}]</data>
  <data key="d3">["hp_df0d4a55e8bc0f2f"]</data>
  <data key="d4">False</data>
</node>
<node id="Andrew G. Kaufman">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The full name of the American comedian, actor, writer, performance artist, and professional wrestler.", "chunk_id": "a8189041218c65c9", "doc_id": "hp_df54057a167e76d7"}]</data>
  <data key="d2">[{"text": "Andrew G. Kaufman (January 17, 1949 – May 16, 1984) was an American comedian, actor, writer, performance artist and professional wrestler.", "chunk_id": "a8189041218c65c9", "doc_id": "hp_df54057a167e76d7"}]</data>
  <data key="d3">["hp_df54057a167e76d7"]</data>
  <data key="d4">False</data>
</node>
<node id="comedian">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A person who makes people laugh by telling jokes or funny stories.", "chunk_id": "a8189041218c65c9", "doc_id": "hp_df54057a167e76d7"}]</data>
  <data key="d2">[{"text": "While often referred to as a comedian, Kaufman described himself instead as a \"song and dance man.\"", "chunk_id": "a8189041218c65c9", "doc_id": "hp_df54057a167e76d7"}]</data>
  <data key="d3">["hp_df54057a167e76d7"]</data>
  <data key="d4">False</data>
</node>
<node id="song and dance man">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A performer who sings and dances.", "chunk_id": "a8189041218c65c9", "doc_id": "hp_df54057a167e76d7"}]</data>
  <data key="d2">[{"text": "While often referred to as a comedian, Kaufman described himself instead as a \"song and dance man.\"", "chunk_id": "a8189041218c65c9", "doc_id": "hp_df54057a167e76d7"}]</data>
  <data key="d3">["hp_df54057a167e76d7"]</data>
  <data key="d4">False</data>
</node>
<node id="joke">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A thing that someone says to cause amusement or laughter.", "chunk_id": "a8189041218c65c9", "doc_id": "hp_df54057a167e76d7"}]</data>
  <data key="d2">[{"text": "He disdained telling jokes and engaging in comedy as it was traditionally understood, once saying in a rare introspective interview, \"I am not a comic, I have never told a joke.", "chunk_id": "a8189041218c65c9", "doc_id": "hp_df54057a167e76d7"}]</data>
  <data key="d3">["hp_df54057a167e76d7"]</data>
  <data key="d4">False</data>
</node>
