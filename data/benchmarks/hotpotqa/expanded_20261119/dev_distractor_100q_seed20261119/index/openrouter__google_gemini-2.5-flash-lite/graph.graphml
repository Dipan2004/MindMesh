  <data key="d7">[{"text": "Based on Hans Christian Andersen's short story \"Isjomfruen\" (English: The Ice-Maiden), the work is an homage to Pyotr Ilyich Tchaikovsky, for the 35th anniversary of the composer's death.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707", "type": "AUTHORED"}]</data>
