  <data key="d1">[{"text": "The Federal government is the national government of the United States.", "chunk_id": "06c3adf08bf6725c", "doc_id": "hp_c096d61b038c9025"}, {"text": "The national government of the United States.", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d2">[{"text": "The park was founded in 1960, when the Federal government sold most of the former Oklahoma Ordnance Works to a public trust, the Oklahoma Ordnance Works Authority.", "chunk_id": "06c3adf08bf6725c", "doc_id": "hp_c096d61b038c9025"}, {"text": "However, the Supreme Court did not invest the federal government with the authority to protect freedom of movement.", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d3">["hp_c096d61b038c9025", "hp_de77e95616995229"]</data>
