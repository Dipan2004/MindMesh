<node id="Standard Oil of Iowa">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A subsidiary of the Standard Oil Trust created in 1885 to handle marketing along the Pacific Coast states.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}]</data>
  <data key="d2">[{"text": "Standard Oil Company of Iowa was created in 1885 as a subsidiary of the Standard Oil Trust to handle marketing along the Pacific Coast states of Idaho, Oregon, Washington, California, and Arizona.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}]</data>
  <data key="d3">["hp_777b99a15f2523b1"]</data>
