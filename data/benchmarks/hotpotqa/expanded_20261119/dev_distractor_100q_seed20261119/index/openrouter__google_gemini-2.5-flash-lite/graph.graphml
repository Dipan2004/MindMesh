<node id="clavie">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A collection of casks split in two, lit as a bonfire in the evening of 11 January.", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d2">[{"text": "The \"clavie\" is a collection of casks split in two, lit as a bonfire in the evening of 11 January, i.e. New Year's Eve (in Scotland, Hogmanay) by the Julian Calendar.", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d3">["hp_d679e270f6739fa5"]</data>
  <data key="d4">False</data>
</node>
<node id="New Year's Eve">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The evening of 11 January, also known as Hogmanay in Scotland, when the clavie is lit.", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d2">[{"text": "The \"clavie\" is a collection of casks split in two, lit as a bonfire in the evening of 11 January, i.e. New Year's Eve (in Scotland, Hogmanay) by the Julian Calendar.", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d3">["hp_d679e270f6739fa5"]</data>
  <data key="d4">False</data>
</node>
<node id="Hogmanay">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Scottish name for New Year's Eve.", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d2">[{"text": "The \"clavie\" is a collection of casks split in two, lit as a bonfire in the evening of 11 January, i.e. New Year's Eve (in Scotland, Hogmanay) by the Julian Calendar.", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d3">["hp_d679e270f6739fa5"]</data>
  <data key="d4">False</data>
</node>
<node id="Julian Calendar">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The calendar system by which New Year's Eve is observed in Scotland for the Burning of the Clavie.", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d2">[{"text": "The \"clavie\" is a collection of casks split in two, lit as a bonfire in the evening of 11 January, i.e. New Year's Eve (in Scotland, Hogmanay) by the Julian Calendar.", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d3">["hp_d679e270f6739fa5"]</data>
  <data key="d4">False</data>
</node>
<node id="clavis">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Latin word for 'nail'.", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d2">[{"text": "One of these casks is joined together again by a huge nail (Latin \"clavis\"; hence the term, it may also be from Scottish Gaelic \"cliabh\", a basket used for holding combustibles).", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d3">["hp_d679e270f6739fa5"]</data>
  <data key="d4">False</data>
</node>
<node id="cliabh">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Scottish Gaelic word for 'basket used for holding combustibles'.", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d2">[{"text": "One of these casks is joined together again by a huge nail (Latin \"clavis\"; hence the term, it may also be from Scottish Gaelic \"cliabh\", a basket used for holding combustibles).", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d3">["hp_d679e270f6739fa5"]</data>
  <data key="d4">False</data>
</node>
<node id="Doorie">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The local name for the ruins of an altar on a headland.", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d2">[{"text": "It is then filled with tar, lighted and carried flaming round the village and finally up to a headland upon which stands the ruins of an altar, locally called the \"Doorie\".", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d3">["hp_d679e270f6739fa5"]</data>
  <data key="d4">False</data>
</node>
<node id="Operations on the Ancre">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "Military operations that occurred on the Ancre river between the British Fifth Army and the German 1st Army.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d2">[{"text": "Operations on the Ancre, January–March 1917", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d3">["hp_d6e57e7111053cad"]</data>
  <data key="d4">False</data>
</node>
<node id="Ancre">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A river where military operations took place.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d2">[{"text": "Operations on the Ancre, January–March 1917", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d3">["hp_d6e57e7111053cad"]</data>
  <data key="d4">False</data>
</node>
<node id="British Fifth Army">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A British army that participated in operations on the Ancre.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d2">[{"text": "Operations on the Ancre took place from 11 January – 13 March 1917, between the British Fifth Army and the German 1st Army, on the Somme front during the First World War.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d3">["hp_d6e57e7111053cad"]</data>
  <data key="d4">False</data>
</node>
<node id="German 1st Army">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A German army that participated in operations on the Ancre.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d2">[{"text": "Operations on the Ancre took place from 11 January – 13 March 1917, between the British Fifth Army and the German 1st Army, on the Somme front during the First World War.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d3">["hp_d6e57e7111053cad"]</data>
  <data key="d4">False</data>
</node>
<node id="Somme front">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A military front where operations on the Ancre took place.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d2">[{"text": "Operations on the Ancre took place from 11 January – 13 March 1917, between the British Fifth Army and the German 1st Army, on the Somme front during the First World War.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d3">["hp_d6e57e7111053cad"]</data>
  <data key="d4">False</data>
</node>
<node id="Battle of the Ancre">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A previous battle that occurred on the Ancre.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d2">[{"text": "After the Battle of the Ancre (13–18 November 1916), British attacks on the Somme front stopped for the winter.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d3">["hp_d6e57e7111053cad"]</data>
  <data key="d4">False</data>
</node>
<node id="Field Marshal Sir Douglas Haig">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A military leader who instructed the Fifth Army.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d2">[{"text": "The Fifth Army was instructed by Field Marshal Sir Douglas Haig to prepare systematic attacks to capture portions of the German defences.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d3">["hp_d6e57e7111053cad"]</data>
  <data key="d4">False</data>
</node>
<node id="Arras">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location where an offensive was planned.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d2">[{"text": "As preparations for the offensive at Arras due in the spring of 1917 continued, the British attempted to keep German attention on the Somme.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d3">["hp_d6e57e7111053cad"]</data>
  <data key="d4">False</data>
</node>
<node id="Serre">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A village to the north of the Ancre valley that was threatened by British advances.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d2">[{"text": "Short advances could progressively uncover the remaining German positions in the Ancre valley, threaten the German hold on the village of Serre to the north and expose German positions beyond to ground observation.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d3">["hp_d6e57e7111053cad"]</data>
  <data key="d4">False</data>
</node>
<node id="Ancre valley">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A valley associated with the Ancre river.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d2">[{"text": "Short advances could progressively uncover the remaining German positions in the Ancre valley, threaten the German hold on the village of Serre to the north and expose German positions beyond to ground observation.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}]</data>
  <data key="d3">["hp_d6e57e7111053cad"]</data>
  <data key="d4">False</data>
</node>
