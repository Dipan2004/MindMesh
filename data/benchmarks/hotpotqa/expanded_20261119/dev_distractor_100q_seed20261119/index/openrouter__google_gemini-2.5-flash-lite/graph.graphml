  <data key="d2">[{"text": "Outrage Coda (アウトレイジ 最終章 ) is a 2017 Japanese yakuza film directed by Takeshi Kitano, starring Kitano (a.k.a. \"Beat Takeshi\"), and is scheduled for release in Japan on October 7, 2017.", "chunk_id": "b645440e66e580ca", "doc_id": "hp_b8efddf6bd2e02c9"}]</data>
