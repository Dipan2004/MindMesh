  <data key="d7">[{"text": "The 2010 Individual Speedway World Championship Grand Prix Qualification were a series of motorcycle speedway meetings used to determine the three riders who qualified for the 2010 Speedway Grand Prix.", "chunk_id": "41d562b159afe9d1", "doc_id": "hp_025c1875e6de72c3", "type": "QUALIFIED_FOR"}]</data>
