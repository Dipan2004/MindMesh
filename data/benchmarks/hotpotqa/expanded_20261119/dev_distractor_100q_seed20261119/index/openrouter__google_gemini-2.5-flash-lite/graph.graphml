  <data key="d1">[{"text": "A state in the United States where the Governor's Mansion is located.", "chunk_id": "8f43bdf21d1f96f0", "doc_id": "hp_c748835c7175602a"}]</data>
  <data key="d2">[{"text": "The current structure, located at 1 Mansion Drive in Santa Fe, New Mexico, has served as the Governor's official residence since 1954.", "chunk_id": "8f43bdf21d1f96f0", "doc_id": "hp_c748835c7175602a"}]</data>
  <data key="d3">["hp_c748835c7175602a"]</data>
  <data key="d4">False</data>
</node>
<node id="A Looking in View">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A song by American metal band Alice in Chains.", "chunk_id": "e152947c3cf74e57", "doc_id": "hp_c79be23e68ef1865"}]</data>
  <data key="d2">[{"text": "\"A Looking in View\" is a song by American metal band Alice in Chains, featured on their fourth studio album \"Black Gives Way to Blue\" (2009).", "chunk_id": "e152947c3cf74e57", "doc_id": "hp_c79be23e68ef1865"}]</data>
  <data key="d3">["hp_c79be23e68ef1865"]</data>
  <data key="d4">False</data>
</node>
<node id="June 30, 2009">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The release date of the song \"A Looking in View\" as a single.", "chunk_id": "e152947c3cf74e57", "doc_id": "hp_c79be23e68ef1865"}]</data>
  <data key="d2">[{"text": "It was released as the lead single from the album on June 30, 2009, marking it as the band's first single since the previous decade.", "chunk_id": "e152947c3cf74e57", "doc_id": "hp_c79be23e68ef1865"}]</data>
  <data key="d3">["hp_c79be23e68ef1865"]</data>
  <data key="d4">False</data>
</node>
<node id="Outrage porn">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Outrage porn refers to any type of media that is designed to invoke outrage for the purpose getting traffic or attention online.", "chunk_id": "0638fb6ada4b48b1", "doc_id": "hp_c7a84daa739ebe3d"}]</data>
  <data key="d2">[{"text": "Outrage porn refers to any type of media that is designed to invoke outrage for the purpose getting traffic or attention online.", "chunk_id": "0638fb6ada4b48b1", "doc_id": "hp_c7a84daa739ebe3d"}]</data>
  <data key="d3">["hp_c7a84daa739ebe3d"]</data>
  <data key="d4">False</data>
</node>
<node id="Tim Kreider">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Tim Kreider is a political cartoonist and essayist who coined the term \"outrage porn\".", "chunk_id": "0638fb6ada4b48b1", "doc_id": "hp_c7a84daa739ebe3d"}]</data>
  <data key="d2">[{"text": "The term \"outrage porn\" was coined by political cartoonist and essayist Tim Kreider of The \"New York Times\".", "chunk_id": "0638fb6ada4b48b1", "doc_id": "hp_c7a84daa739ebe3d"}]</data>
  <data key="d3">["hp_c7a84daa739ebe3d"]</data>
  <data key="d4">False</data>
</node>
<node id="The &quot;New York Times&quot;">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The \"New York Times\" is a media organization where political cartoonist and essayist Tim Kreider worked.", "chunk_id": "0638fb6ada4b48b1", "doc_id": "hp_c7a84daa739ebe3d"}, {"text": "The New York Times is a newspaper that praised Hazel Dickens's advocacy.", "chunk_id": "12b5fe23f857cd32", "doc_id": "hp_2295401c0eccc650"}, {"text": "A newspaper for which Alex Ross, a music critic, writes.", "chunk_id": "90b05205269973c5", "doc_id": "hp_51b683ecaa90fcc5"}, {"text": "The New York Times is a newspaper that described Jan Švankmajer.", "chunk_id": "7947a367f556d5b8", "doc_id": "hp_6b88bc8862070da2"}]</data>
  <data key="d2">[{"text": "The term \"outrage porn\" was coined by political cartoonist and essayist Tim Kreider of The \"New York Times\".", "chunk_id": "0638fb6ada4b48b1", "doc_id": "hp_c7a84daa739ebe3d"}, {"text": "\"The New York Times\" extolled her as \"a clarion-voiced advocate for coal miners and working people and a pioneer among women in bluegrass music.\"", "chunk_id": "12b5fe23f857cd32", "doc_id": "hp_2295401c0eccc650"}, {"text": "In a review of a performance by the S.E.M. Ensemble in 1992 at the Paula Cooper Gallery, the music critic of \"The New York Times\", Alex Ross, described the piece as \"merely a timid, spastic prelude to György Ligeti's monumental \"Poème symphonique\" for 100 metronomes\".", "chunk_id": "90b05205269973c5", "doc_id": "hp_51b683ecaa90fcc5"}, {"text": "The style of the film is surrealist, and the director Jan Švankmajer has been described by \"The New York Times\" as being \"One of cinema's most visionary surrealists\".", "chunk_id": "7947a367f556d5b8", "doc_id": "hp_6b88bc8862070da2"}]</data>
  <data key="d3">["hp_2295401c0eccc650", "hp_51b683ecaa90fcc5", "hp_6b88bc8862070da2", "hp_c7a84daa739ebe3d"]</data>
  <data key="d4">False</data>
</node>
<node id="Ryan Holiday">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Ryan Holiday is an author and media critic who popularized the term \"outrage porn\".", "chunk_id": "0638fb6ada4b48b1", "doc_id": "hp_c7a84daa739ebe3d"}]</data>
  <data key="d2">[{"text": "Coined in 2009, the term was later popularized by author and \"Observer\" media critic Ryan Holiday.", "chunk_id": "0638fb6ada4b48b1", "doc_id": "hp_c7a84daa739ebe3d"}]</data>
  <data key="d3">["hp_c7a84daa739ebe3d"]</data>
  <data key="d4">False</data>
</node>
<node id="&quot;Observer&quot;">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "\"Observer\" is a media outlet where Ryan Holiday worked as a media critic.", "chunk_id": "0638fb6ada4b48b1", "doc_id": "hp_c7a84daa739ebe3d"}]</data>
  <data key="d2">[{"text": "Coined in 2009, the term was later popularized by author and \"Observer\" media critic Ryan Holiday.", "chunk_id": "0638fb6ada4b48b1", "doc_id": "hp_c7a84daa739ebe3d"}]</data>
  <data key="d3">["hp_c7a84daa739ebe3d"]</data>
  <data key="d4">False</data>
</node>
