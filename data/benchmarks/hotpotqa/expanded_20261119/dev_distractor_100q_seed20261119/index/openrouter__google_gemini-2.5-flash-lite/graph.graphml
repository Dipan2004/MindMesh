  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Wesleyan University is an institution with a campus where the Edward Augustus Russell House is located.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d2">[{"text": "The Edward Augustus Russell House is a Greek Revival house on the Wesleyan University campus.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d3">["hp_a8f5a77458dad7ce"]</data>
