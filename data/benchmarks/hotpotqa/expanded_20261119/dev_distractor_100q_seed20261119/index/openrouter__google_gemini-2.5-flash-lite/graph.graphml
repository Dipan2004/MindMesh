  <data key="d2">[{"text": "\"What the Water Gave Me\" is a song by English indie rock band Florence and the Machine from their second studio album \"Ceremonials\" (2011).", "chunk_id": "4a33b3fb6c1ee1fa", "doc_id": "hp_7804b34667739a36"}]</data>
