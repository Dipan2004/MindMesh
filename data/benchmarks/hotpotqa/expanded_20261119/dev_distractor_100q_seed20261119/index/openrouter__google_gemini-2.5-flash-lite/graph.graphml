  <data key="d7">[{"text": "The Baikal Nature Reserve ( ; Russian: Байка́льский запове́дник , \"Baikalski Zapovednik\") is a nature reserve on the southeast shore of Lake Baikal, in southern Buryatia, Russia.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83", "type": "LOCATED_IN"}]</data>
