</node>
<node id="NCAA Tournament Championship">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The NCAA Tournament Championship is an event that the University of Maryland won in 2002 under Gary Williams.", "chunk_id": "777d709f2b113bd2", "doc_id": "hp_a8de6e8688186343"}]</data>
  <data key="d2">[{"text": "In 2002, he led Maryland to win the NCAA Tournament Championship.", "chunk_id": "777d709f2b113bd2", "doc_id": "hp_a8de6e8688186343"}]</data>
  <data key="d3">["hp_a8de6e8688186343"]</data>
  <data key="d4">False</data>
</node>
<node id="Big Ten Network">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Big Ten Network is a media organization for which Gary Williams works as a college basketball analyst.", "chunk_id": "777d709f2b113bd2", "doc_id": "hp_a8de6e8688186343"}]</data>
  <data key="d2">[{"text": "Williams retired after the 2010–11 season, and is now a college basketball analyst for the Big Ten Network.", "chunk_id": "777d709f2b113bd2", "doc_id": "hp_a8de6e8688186343"}]</data>
  <data key="d3">["hp_a8de6e8688186343"]</data>
  <data key="d4">False</data>
</node>
