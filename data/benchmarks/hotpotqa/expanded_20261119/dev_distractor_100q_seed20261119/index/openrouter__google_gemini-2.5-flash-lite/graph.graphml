  <data key="d2">[{"text": "She's held the CMLL World Women's Championship, and she was the first AAA Reina de Reinas (Spanish for \"Queen of Queens\").", "chunk_id": "beab562ef9fe8887", "doc_id": "hp_e53c480ef8a45aab"}]</data>
