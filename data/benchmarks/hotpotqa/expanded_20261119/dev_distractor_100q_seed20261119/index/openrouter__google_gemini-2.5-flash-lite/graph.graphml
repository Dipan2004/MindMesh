<edge source="The May Department Stores Company" target="Federated Department Stores">
  <data key="d5">["MERGED_WITH"]</data>
  <data key="d6">The May Department Stores Company merged with Federated Department Stores.</data>
  <data key="d7">[{"text": "It was founded by David May in 1877, and merged with Federated Department Stores (now Macy's, Inc.) in 2005.", "chunk_id": "7eaecb7c8ff690f9", "doc_id": "hp_537a416acef9e8ad", "type": "MERGED_WITH"}]</data>
