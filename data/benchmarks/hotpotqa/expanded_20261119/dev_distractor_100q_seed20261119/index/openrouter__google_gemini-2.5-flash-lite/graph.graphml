  <data key="d2">[{"text": "Beta testing of Cinestill Film's \"800Tungsten Xpro C-41\" began in late 2012, the film is based on Kodak's \"Vision 3 5219\" motion picture cinema film.", "chunk_id": "95552dd280ce88ab", "doc_id": "hp_fad0e22310177840"}]</data>
