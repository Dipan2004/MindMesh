<node id="Bertrand de Bar-sur-Aube">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An Old French poet from the Champagne region of France who wrote a number of \"chansons de geste\".", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d2">[{"text": "Bertrand de Bar-sur-Aube (i.e. Bertrand from Bar-sur-Aube) (end of the 12th century – early 13th century) was an Old French poet from the Champagne region of France who wrote a number of \"chansons de geste\".", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d3">["hp_8aed4603836974ec"]</data>
  <data key="d4">False</data>
</node>
<node id="Bar-sur-Aube">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location associated with Bertrand de Bar-sur-Aube.", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d2">[{"text": "Bertrand de Bar-sur-Aube (i.e. Bertrand from Bar-sur-Aube) (end of the 12th century – early 13th century) was an Old French poet from the Champagne region of France who wrote a number of \"chansons de geste\".", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d3">["hp_8aed4603836974ec"]</data>
  <data key="d4">False</data>
</node>
<node id="Champagne">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A region in France where Bertrand de Bar-sur-Aube was from.", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d2">[{"text": "Bertrand de Bar-sur-Aube (i.e. Bertrand from Bar-sur-Aube) (end of the 12th century – early 13th century) was an Old French poet from the Champagne region of France who wrote a number of \"chansons de geste\".", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d3">["hp_8aed4603836974ec"]</data>
  <data key="d4">False</data>
</node>
<node id="chansons de geste">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A genre of Old French epic poetry.", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}, {"text": "Chansons de geste are medieval epic poems.", "chunk_id": "b3a9c00150a552e2", "doc_id": "hp_b4f3b2a3a6af0d4a"}, {"text": "A genre of Old French epic poetry.", "chunk_id": "bc44d364b9f11c58", "doc_id": "hp_bd117ea391b64dae"}]</data>
  <data key="d2">[{"text": "Bertrand de Bar-sur-Aube (i.e. Bertrand from Bar-sur-Aube) (end of the 12th century – early 13th century) was an Old French poet from the Champagne region of France who wrote a number of \"chansons de geste\".", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}, {"text": "Holger Danske, or Ogier the Dane, is a legendary character appearing in medieval chansons de geste.", "chunk_id": "b3a9c00150a552e2", "doc_id": "hp_b4f3b2a3a6af0d4a"}, {"text": "The character gives his name to the second cycle of Old French \"chansons de geste\", \"La Geste de Garin de Monglane\".", "chunk_id": "bc44d364b9f11c58", "doc_id": "hp_bd117ea391b64dae"}]</data>
  <data key="d3">["hp_8aed4603836974ec", "hp_b4f3b2a3a6af0d4a", "hp_bd117ea391b64dae"]</data>
  <data key="d4">False</data>
</node>
<node id="Girard de Vienne">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A work written by Bertrand de Bar-sur-Aube.", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d2">[{"text": "He is the author of \"Girard de Vienne\", and it is likely that he also wrote \"Aymeri de Narbonne\".", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d3">["hp_8aed4603836974ec"]</data>
  <data key="d4">False</data>
</node>
<node id="Aymeri de Narbonne">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A work that Bertrand de Bar-sur-Aube likely wrote.", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d2">[{"text": "He is the author of \"Girard de Vienne\", and it is likely that he also wrote \"Aymeri de Narbonne\".", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d3">["hp_8aed4603836974ec"]</data>
  <data key="d4">False</data>
</node>
<node id="Narbonnais">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A \"chanson de geste\" that has been attributed to Bertrand de Bar-sur-Aube.", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d2">[{"text": "The \"chansons de geste\" \"Narbonnais\" and \"Beuve de Hantone\" have also been attributed to him, but these attributions are contested.", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d3">["hp_8aed4603836974ec"]</data>
  <data key="d4">False</data>
</node>
<node id="Beuve de Hantone">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A \"chanson de geste\" that has been attributed to Bertrand de Bar-sur-Aube.", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d2">[{"text": "The \"chansons de geste\" \"Narbonnais\" and \"Beuve de Hantone\" have also been attributed to him, but these attributions are contested.", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d3">["hp_8aed4603836974ec"]</data>
  <data key="d4">False</data>
</node>
<node id="clerc">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A term used by the author of \"Girart de Vienne\" to describe himself, meaning cleric.", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d2">[{"text": "At the beginning of \"Girart de Vienne\", the author describes himself as a \"clerc\" or cleric.", "chunk_id": "528eebe85217e215", "doc_id": "hp_8aed4603836974ec"}]</data>
  <data key="d3">["hp_8aed4603836974ec"]</data>
  <data key="d4">False</data>
</node>
<node id="Weak heap">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A weak heap is a data structure that combines binary heap and binomial heap for priority queues.", "chunk_id": "4e083a006738f750", "doc_id": "hp_8afebc679cacb617"}]</data>
  <data key="d2">[{"text": "A weak heap is a combination of the binary heap and binomial heap data structures for implementing priority queues.", "chunk_id": "4e083a006738f750", "doc_id": "hp_8afebc679cacb617"}]</data>
  <data key="d3">["hp_8afebc679cacb617"]</data>
  <data key="d4">False</data>
</node>
<node id="binary heap">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A binary heap is a data structure that can be stored in an array as an implicit binary tree.", "chunk_id": "4e083a006738f750", "doc_id": "hp_8afebc679cacb617"}]</data>
  <data key="d2">[{"text": "A weak heap is a combination of the binary heap and binomial heap data structures for implementing priority queues.", "chunk_id": "4e083a006738f750", "doc_id": "hp_8afebc679cacb617"}]</data>
  <data key="d3">["hp_8afebc679cacb617"]</data>
  <data key="d4">False</data>
</node>
<node id="binomial heap">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A binomial heap is a data structure that provides efficiency guarantees.", "chunk_id": "4e083a006738f750", "doc_id": "hp_8afebc679cacb617"}]</data>
  <data key="d2">[{"text": "A weak heap is a combination of the binary heap and binomial heap data structures for implementing priority queues.", "chunk_id": "4e083a006738f750", "doc_id": "hp_8afebc679cacb617"}]</data>
  <data key="d3">["hp_8afebc679cacb617"]</data>
  <data key="d4">False</data>
</node>
<node id="priority queues">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Priority queues are data structures that can be implemented using weak heaps.", "chunk_id": "4e083a006738f750", "doc_id": "hp_8afebc679cacb617"}]</data>
  <data key="d2">[{"text": "A weak heap is a combination of the binary heap and binomial heap data structures for implementing priority queues.", "chunk_id": "4e083a006738f750", "doc_id": "hp_8afebc679cacb617"}]</data>
  <data key="d3">["hp_8afebc679cacb617"]</data>
  <data key="d4">False</data>
</node>
<node id="Henry Elijah Alvord">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Henry Elijah Alvord was an American university administrator, educator, and Army officer.", "chunk_id": "3cd3c8487045d3d4", "doc_id": "hp_8b1f7c86ce5cb296"}]</data>
  <data key="d2">[{"text": "Henry Elijah Alvord (March 11, 1844 – October 1, 1904) was an American university administrator, educator, and Army officer.", "chunk_id": "3cd3c8487045d3d4", "doc_id": "hp_8b1f7c86ce5cb296"}]</data>
  <data key="d3">["hp_8b1f7c86ce5cb296"]</data>
  <data key="d4">False</data>
</node>
<node id="Oklahoma Agricultural and Mechanical College">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Oklahoma Agricultural and Mechanical College is an institution that Henry Elijah Alvord served as president of.", "chunk_id": "3cd3c8487045d3d4", "doc_id": "hp_8b1f7c86ce5cb296"}]</data>
  <data key="d2">[{"text": "He served as the president of the Oklahoma Agricultural and Mechanical College (now Oklahoma State University) and the Maryland Agricultural College (now the University of Maryland) as well teaching Military Science at Massachusetts Agricultural College (Now the University of Massachusetts - Amherst).", "chunk_id": "3cd3c8487045d3d4", "doc_id": "hp_8b1f7c86ce5cb296"}]</data>
  <data key="d3">["hp_8b1f7c86ce5cb296"]</data>
  <data key="d4">False</data>
</node>
<node id="Oklahoma State University">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Oklahoma State University is the current name for Oklahoma Agricultural and Mechanical College.", "chunk_id": "3cd3c8487045d3d4", "doc_id": "hp_8b1f7c86ce5cb296"}]</data>
  <data key="d2">[{"text": "He served as the president of the Oklahoma Agricultural and Mechanical College (now Oklahoma State University) and the Maryland Agricultural College (now the University of Maryland) as well teaching Military Science at Massachusetts Agricultural College (Now the University of Massachusetts - Amherst).", "chunk_id": "3cd3c8487045d3d4", "doc_id": "hp_8b1f7c86ce5cb296"}]</data>
  <data key="d3">["hp_8b1f7c86ce5cb296"]</data>
  <data key="d4">False</data>
</node>
