<node id="industrial park">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A 400-acre industrial park located east of Plant City Airport.", "chunk_id": "47b19fbaa70c2777", "doc_id": "hp_357ddba773097c91"}]</data>
  <data key="d2">[{"text": "It supports a 400 acre industrial park located about one mile (1.6 km) east of the airport.", "chunk_id": "47b19fbaa70c2777", "doc_id": "hp_357ddba773097c91"}]</data>
  <data key="d3">["hp_357ddba773097c91"]</data>
