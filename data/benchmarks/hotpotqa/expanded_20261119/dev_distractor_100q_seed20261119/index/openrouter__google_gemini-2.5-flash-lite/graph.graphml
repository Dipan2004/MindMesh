</node>
<node id="Tokyo">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Tokyo is the birthplace of Ken Itō.", "chunk_id": "0098840943bb12b3", "doc_id": "hp_0c547ebaf27ccc35"}, {"text": "The location of The Bridgestone Doubles Championships in 1975.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}, {"text": "The birthplace of Takanori Arisawa.", "chunk_id": "a288b38bfb013c0a", "doc_id": "hp_be8748f7d316f7c3"}, {"text": "The capital city of Japan.", "chunk_id": "7fcbe97a0e441ab4", "doc_id": "hp_d534800743a3d491"}]</data>
  <data key="d2">[{"text": "Ken Itō (伊東 乾 , Itō Ken ) is a Japanese composer, conductor, and writer born in Tokyo on January 27, 1965.", "chunk_id": "0098840943bb12b3", "doc_id": "hp_0c547ebaf27ccc35"}, {"text": "She wore the first all black outfit in the history of tennis in 1975 at The Bridgestone Doubles Championships in Tokyo, starting a trend that is still popular today.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}, {"text": "Born in Tokyo, Arisawa began to learn piano at the age of 20.", "chunk_id": "a288b38bfb013c0a", "doc_id": "hp_be8748f7d316f7c3"}, {"text": "Pizza of Death is a Japanese record label based in Tokyo, Japan, and was founded by Hi-Standard front man Ken Yokoyama.", "chunk_id": "7fcbe97a0e441ab4", "doc_id": "hp_d534800743a3d491"}]</data>
  <data key="d3">["hp_0c547ebaf27ccc35", "hp_8e9d4247e8ae3a7a", "hp_be8748f7d316f7c3", "hp_d534800743a3d491"]</data>
  <data key="d4">False</data>
</node>
<node id="January 27, 1965">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "January 27, 1965 is the birth date of Ken Itō.", "chunk_id": "0098840943bb12b3", "doc_id": "hp_0c547ebaf27ccc35"}]</data>
  <data key="d2">[{"text": "Ken Itō (伊東 乾 , Itō Ken ) is a Japanese composer, conductor, and writer born in Tokyo on January 27, 1965.", "chunk_id": "0098840943bb12b3", "doc_id": "hp_0c547ebaf27ccc35"}]</data>
  <data key="d3">["hp_0c547ebaf27ccc35"]</data>
  <data key="d4">False</data>
</node>
<node id="Leonard Bernstein">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Leonard Bernstein is an individual with whom Ken Itō claimed to have studied composition and conducting.", "chunk_id": "0098840943bb12b3", "doc_id": "hp_0c547ebaf27ccc35"}]</data>
  <data key="d2">[{"text": "He has claimed to have studied composition and conducting with Leonard Bernstein, Pierre Boulez, John Cage, and others.", "chunk_id": "0098840943bb12b3", "doc_id": "hp_0c547ebaf27ccc35"}]</data>
  <data key="d3">["hp_0c547ebaf27ccc35"]</data>
  <data key="d4">False</data>
</node>
<node id="Pierre Boulez">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Pierre Boulez is an individual with whom Ken Itō claimed to have studied composition and conducting.", "chunk_id": "0098840943bb12b3", "doc_id": "hp_0c547ebaf27ccc35"}]</data>
  <data key="d2">[{"text": "He has claimed to have studied composition and conducting with Leonard Bernstein, Pierre Boulez, John Cage, and others.", "chunk_id": "0098840943bb12b3", "doc_id": "hp_0c547ebaf27ccc35"}]</data>
  <data key="d3">["hp_0c547ebaf27ccc35"]</data>
  <data key="d4">False</data>
</node>
<node id="John Cage">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "John Cage is an individual with whom Ken Itō claimed to have studied composition and conducting.", "chunk_id": "0098840943bb12b3", "doc_id": "hp_0c547ebaf27ccc35"}, {"text": "John Cage was an American composer who supported the formation of Zaj.", "chunk_id": "b647f648f08782f6", "doc_id": "hp_205b52451626bfb6"}, {"text": "An artist whose performance in Tokyo in 1962 influenced Shigeko Kubota's involvement with Fluxus.", "chunk_id": "bb303342f684188a", "doc_id": "hp_25e106b688a6f938"}, {"text": "John Cage was one of Toshi Ichiyanagi's teachers.", "chunk_id": "0d8ff17508c0bbc6", "doc_id": "hp_63ccc0ae800eae3c"}, {"text": "A composer with whom Richard Bunger Evans worked.", "chunk_id": "f317bf6030b1131e", "doc_id": "hp_a09bf8eaffccdd21"}, {"text": "An American avant-garde composer.", "chunk_id": "46e2753873dd1884", "doc_id": "hp_abe4b15111caba47"}, {"text": "An American avant-garde composer known for his work with prepared piano.", "chunk_id": "b7f8e7da447a5f1c", "doc_id": "hp_e9f272e0c789745f"}]</data>
  <data key="d2">[{"text": "He has claimed to have studied composition and conducting with Leonard Bernstein, Pierre Boulez, John Cage, and others.", "chunk_id": "0098840943bb12b3", "doc_id": "hp_0c547ebaf27ccc35"}, {"text": "Zaj was an experimental music and performance art group formed in 1959 in Milan, Italy by composers and intermedia artists Walter Marchetti and Juan Hidalgo with the support of the American composer John Cage.", "chunk_id": "b647f648f08782f6", "doc_id": "hp_205b52451626bfb6"}, {"text": "She was a key member and influence on Fluxus, the international group of avant-garde artists centered on George Maciunas, having been involved with the group since witnessing John Cage perform in Tokyo in 1962 and subsequently moving to New York in 1964.", "chunk_id": "bb303342f684188a", "doc_id": "hp_25e106b688a6f938"}, {"text": "He studied with Tomojiro Ikenouchi, Kishio Hirao, and John Cage.", "chunk_id": "0d8ff17508c0bbc6", "doc_id": "hp_63ccc0ae800eae3c"}, {"text": "Richard Bunger Evans, also known as Richard Bunger, (born 1942) is an American composer and pianist who worked with John Cage and subsequently wrote \"the classic book on John Cage,\" \"The Well-Prepared Piano\".", "chunk_id": "f317bf6030b1131e", "doc_id": "hp_a09bf8eaffccdd21"}, {"text": "Sonatas and Interludes is a collection of twenty pieces for prepared piano by American avant-garde composer John Cage (1912–1992).", "chunk_id": "46e2753873dd1884", "doc_id": "hp_abe4b15111caba47"}, {"text": "American avant-garde composer John Cage (1912–1992) started composing pieces for solo prepared piano around 1938–40.", "chunk_id": "b7f8e7da447a5f1c", "doc_id": "hp_e9f272e0c789745f"}]</data>
  <data key="d3">["hp_0c547ebaf27ccc35", "hp_205b52451626bfb6", "hp_25e106b688a6f938", "hp_63ccc0ae800eae3c", "hp_a09bf8eaffccdd21", "hp_abe4b15111caba47", "hp_e9f272e0c789745f"]</data>
  <data key="d4">False</data>
</node>
<node id="University of Tokyo">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "University of Tokyo is an institution where Ken Itō has been an assistant professor.", "chunk_id": "0098840943bb12b3", "doc_id": "hp_0c547ebaf27ccc35"}]</data>
  <data key="d2">[{"text": "Ito has been assistant professor at University of Tokyo since 2000.", "chunk_id": "0098840943bb12b3", "doc_id": "hp_0c547ebaf27ccc35"}]</data>
  <data key="d3">["hp_0c547ebaf27ccc35"]</data>
  <data key="d4">False</data>
</node>
<node id="Villanuco de Las Encartaciones">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Spanish breed of dog typical of the region of Las Encartaciones, Cantabria and northern Burgos.", "chunk_id": "e020cb702daeb7ff", "doc_id": "hp_0c6f0946ec61d258"}]</data>
  <data key="d2">[{"text": "The Villanuco de Las Encartaciones (Basque: \"Enkarterriko billanuko\" , Cantabrian: \"Villanucu\", English: Little Villein of Las Encartaciones ) is a Spanish breed of dog typical of the region of Las Encartaciones (Biscay), Cantabria and northern Burgos (Spain).", "chunk_id": "e020cb702daeb7ff", "doc_id": "hp_0c6f0946ec61d258"}]</data>
  <data key="d3">["hp_0c6f0946ec61d258"]</data>
  <data key="d4">False</data>
</node>
<node id="Cantabria">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A region in northern Spain, typical for the Villanuco de Las Encartaciones dog breed.", "chunk_id": "e020cb702daeb7ff", "doc_id": "hp_0c6f0946ec61d258"}, {"text": "A region in Spain that forms the southern border of Enkarterri.", "chunk_id": "f62cc3566a0b0ee0", "doc_id": "hp_73ee189aee60b299"}, {"text": "Cantabria is a region in Spain.", "chunk_id": "25108324a3783908", "doc_id": "hp_cb38c3abf7bd85ae"}]</data>
  <data key="d2">[{"text": "The Villanuco de Las Encartaciones (Basque: \"Enkarterriko billanuko\" , Cantabrian: \"Villanucu\", English: Little Villein of Las Encartaciones ) is a Spanish breed of dog typical of the region of Las Encartaciones (Biscay), Cantabria and northern Burgos (Spain).", "chunk_id": "e020cb702daeb7ff", "doc_id": "hp_0c6f0946ec61d258"}, {"text": "Enkarterri stretches from the river Nervion and the Estuary of Bilbao in the east to the mountains that form its southern border with Cantabria and Castile-Leon in the west and south.", "chunk_id": "f62cc3566a0b0ee0", "doc_id": "hp_73ee189aee60b299"}, {"text": "The Villano de Las Encartaciones (Basque: \"Enkarterriko billano\" , Cantabrian: \"Villanu\", English: Villein of las Encartaciones ) is a Spanish working dog originated in Las Encartaciones, a comarca of the province of Biscay, in the Basque country, eastern Cantabria and northern Burgos.", "chunk_id": "25108324a3783908", "doc_id": "hp_cb38c3abf7bd85ae"}]</data>
  <data key="d3">["hp_0c6f0946ec61d258", "hp_73ee189aee60b299", "hp_cb38c3abf7bd85ae"]</data>
  <data key="d4">False</data>
</node>
<node id="northern Burgos">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A region in northern Spain, typical for the Villanuco de Las Encartaciones dog breed.", "chunk_id": "e020cb702daeb7ff", "doc_id": "hp_0c6f0946ec61d258"}]</data>
  <data key="d2">[{"text": "The Villanuco de Las Encartaciones (Basque: \"Enkarterriko billanuko\" , Cantabrian: \"Villanucu\", English: Little Villein of Las Encartaciones ) is a Spanish breed of dog typical of the region of Las Encartaciones (Biscay), Cantabria and northern Burgos (Spain).", "chunk_id": "e020cb702daeb7ff", "doc_id": "hp_0c6f0946ec61d258"}]</data>
  <data key="d3">["hp_0c6f0946ec61d258"]</data>
  <data key="d4">False</data>
</node>
<node id="The Devil Put Dinosaurs Here">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The fifth studio album by the American rock band Alice in Chains.", "chunk_id": "ac14247b71085709", "doc_id": "hp_0c8c04014969d68b"}, {"text": "The Devil Put Dinosaurs Here is an album by Alice in Chains released in 2013.", "chunk_id": "d4b180f1810dfb51", "doc_id": "hp_98b62ec679c7b310"}]</data>
  <data key="d2">[{"text": "The Devil Put Dinosaurs Here is the fifth studio album by the American rock band Alice in Chains, released on May 28, 2013.", "chunk_id": "ac14247b71085709", "doc_id": "hp_0c8c04014969d68b"}, {"text": "DuVall joined Alice in Chains in 2006, and he appears on the 2009 album \"Black Gives Way to Blue\" as well as the 2013 follow-up \"The Devil Put Dinosaurs Here\".", "chunk_id": "d4b180f1810dfb51", "doc_id": "hp_98b62ec679c7b310"}]</data>
  <data key="d3">["hp_0c8c04014969d68b", "hp_98b62ec679c7b310"]</data>
