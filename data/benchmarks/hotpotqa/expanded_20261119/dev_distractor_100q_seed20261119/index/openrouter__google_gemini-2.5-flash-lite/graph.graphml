<node id="Joseon">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A Korean dynasty that achieved a significant victory during the Imjin Waeran.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d2">[{"text": "The battle, one of the three great battles won by Joseon during the Imjin Waeran, carried great import, because Joseon's forces now came to dominate the southern seas.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d3">["hp_4e9436b9b6a97ad9"]</data>
  <data key="d4">False</data>
</node>
<node id="Imjin Waeran">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A series of invasions of Korea by Japan that occurred in the late 16th century.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d2">[{"text": "The battle, one of the three great battles won by Joseon during the Imjin Waeran, carried great import, because Joseon's forces now came to dominate the southern seas.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d3">["hp_4e9436b9b6a97ad9"]</data>
  <data key="d4">False</data>
</node>
