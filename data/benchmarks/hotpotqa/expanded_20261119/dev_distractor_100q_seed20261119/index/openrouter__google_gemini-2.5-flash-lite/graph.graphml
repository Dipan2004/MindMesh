  <data key="d5">["PART_OF"]</data>
  <data key="d6">The Battle of Saint-Mihiel was a battle within World War I.</data>
  <data key="d7">[{"text": "The Battle of Saint-Mihiel was a major World War I battle fought from 12–15 September 1918, involving the American Expeditionary Force (AEF) and 110,000 French troops under the command of General John J. Pershing of the United States against German positions.", "chunk_id": "45856128b6a22257", "doc_id": "hp_7e06d5c1c2ef0dce", "type": "PART_OF"}]</data>
