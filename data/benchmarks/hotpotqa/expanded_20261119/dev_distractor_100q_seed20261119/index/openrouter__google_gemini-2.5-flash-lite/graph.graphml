</node>
<node id="World Series">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The World Series was an event that included the Thailand Masters in 1991/92.", "chunk_id": "9719756e39f01e98", "doc_id": "hp_b2a5885a3a67beea"}]</data>
  <data key="d2">[{"text": "An event called the \"Thailand Masters\" also formed part of the \"World Series\" in 1991/92, with Steve Davis beating Stephen Hendry 6–3.", "chunk_id": "9719756e39f01e98", "doc_id": "hp_b2a5885a3a67beea"}]</data>
  <data key="d3">["hp_b2a5885a3a67beea"]</data>
