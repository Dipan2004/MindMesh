  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The entity that compiled the California Birth Index (CABI).", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d2">[{"text": "The California Birth Index (CABI) is a database compiled by the California Office of Health Information and Research.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d3">["hp_20acafffd5f50194"]</data>
  <data key="d4">False</data>
</node>
<node id="California">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The state where the birth records in the California Birth Index are from.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}, {"text": "The state where Pacific Palisades, the place of Ingo Preminger's death, is located.", "chunk_id": "11399d9e6ed9e2a4", "doc_id": "hp_2f3cd8d24b5f56f1"}, {"text": "California is a state where San Francisco is located.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}, {"text": "The state where Reseda is located, and where Tyler Asemota has lived most of his life.", "chunk_id": "21c5f5a9893cff0d", "doc_id": "hp_449285fab9db13ba"}, {"text": "California is a state in the United States.", "chunk_id": "75ff884d3fae85e2", "doc_id": "hp_46658770e8628bf3"}, {"text": "A state in the United States where Los Angeles is located.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}, {"text": "California is a state where Robinsons-May had its headquarters.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}, {"text": "A state in the Pacific Coast region that was part of Standard Oil of Iowa's marketing area.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}, {"text": "A state in the United States where Sacramento is located.", "chunk_id": "3cb5e197f21c88e2", "doc_id": "hp_89406a2f1bd87039"}, {"text": "A state in the United States where Palo Alto is located.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}, {"text": "A state in the United States.", "chunk_id": "a2f7562b6d871ad4", "doc_id": "hp_900332dfe25fe511"}, {"text": "California is a state where Los Angeles is located.", "chunk_id": "fc0023c8ca0ec81c", "doc_id": "hp_9355db235edf3f84"}, {"text": "A state in the United States where Aptos is located.", "chunk_id": "6c8ea648c2d5ed76", "doc_id": "hp_980453e19b052243"}, {"text": "California is a location mentioned as the birthplace of Aaron Embry.", "chunk_id": "35b4acf5c74b48d4", "doc_id": "hp_995e15f7f8919993"}, {"text": "State in the United States, formerly governed by Ronald Reagan.", "chunk_id": "54142f25de20997e", "doc_id": "hp_adfdee30bf450e7d"}, {"text": "A state in the United States where Burbank is located.", "chunk_id": "69ea2310084e6973", "doc_id": "hp_b786bea89d57e8fa"}, {"text": "California is a state in the United States where Los Angeles is located.", "chunk_id": "d7b89ee6722d4043", "doc_id": "hp_dfded5f3a8af70af"}, {"text": "A state in the United States where Arcadia is located.", "chunk_id": "f0615d70c859fc21", "doc_id": "hp_f0298c6f3a685325"}, {"text": "A state in the Western United States.", "chunk_id": "ea967b117448c7a9", "doc_id": "hp_f960cf6c89ae3463"}, {"text": "A state in the United States where Los Angeles is located and the band was formed.", "chunk_id": "508eaa5477ac7bce", "doc_id": "hp_f98356ff88ddd6a3"}, {"text": "A state in the United States.", "chunk_id": "62dbcbf4d4fa43a6", "doc_id": "hp_fc280682a135c497"}]</data>
  <data key="d2">[{"text": "The index contains birth records of all registered births in California between 1905 and 1995.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}, {"text": "Ingwald \"Ingo\" Preminger (25 February 1911 in Czernowitz, Austria-Hungary (now Chernivtsi, Ukraine) – 7 June 2006 in Pacific Palisades, California) was a film producer.", "chunk_id": "11399d9e6ed9e2a4", "doc_id": "hp_2f3cd8d24b5f56f1"}, {"text": "The Occidental Hotel opened in 1861 in San Francisco, California.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}, {"text": "Living in Reseda, California most of his life, Asemota looked up to many high profile athletes from Notre Dame High School, such as Koa Farmer, Khalfani Muhammed, and notable alumni Giancarlo Stanton.", "chunk_id": "21c5f5a9893cff0d", "doc_id": "hp_449285fab9db13ba"}, {"text": "Rio Hondo College is a community college located in the city of Whittier, California, United States, named after the Rio Hondo.", "chunk_id": "75ff884d3fae85e2", "doc_id": "hp_46658770e8628bf3"}, {"text": "The event was held at the Commerce Casino in Los Angeles, California, the same host city as the 2012 World's Strongest Man contest.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}, {"text": "Robinsons-May was a chain of department stores operating in Southern California, Arizona and Las Vegas, Nevada, previously with headquarters in North Hollywood, California.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}, {"text": "Standard Oil Company of Iowa was created in 1885 as a subsidiary of the Standard Oil Trust to handle marketing along the Pacific Coast states of Idaho, Oregon, Washington, California, and Arizona.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}, {"text": "The story, which takes place near Sacramento, California, centers on a book club consisting of five women and one man who meet once a month to discuss Jane Austen's six novels.", "chunk_id": "3cb5e197f21c88e2", "doc_id": "hp_89406a2f1bd87039"}, {"text": "Stanford Research Park is a technology park located in Palo Alto, California on land owned by Stanford University.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}, {"text": "The Rio Hondo Bike Path is a Class 1 bicycle path that parallels the Rio Hondo (creek) through the San Gabriel Valley, in eastern Los Angeles County, California.", "chunk_id": "a2f7562b6d871ad4", "doc_id": "hp_900332dfe25fe511"}, {"text": "Marty Belafsky (born September 19, 1975) is an American actor/comedian born in Los Angeles, California.", "chunk_id": "fc0023c8ca0ec81c", "doc_id": "hp_9355db235edf3f84"}, {"text": "Salvia 'Jean's Purple Passion' is a \"Salvia\" cultivar discovered at Cabrillo College in Aptos, California.", "chunk_id": "6c8ea648c2d5ed76", "doc_id": "hp_980453e19b052243"}, {"text": "Aaron Embry (born November 10, 1975, Bellflower, California) is an American songwriter and record producer.", "chunk_id": "35b4acf5c74b48d4", "doc_id": "hp_995e15f7f8919993"}, {"text": "Nixon considered selecting former Texas Governor John Connally, New York Governor Nelson Rockefeller, and California Governor Ronald Reagan.", "chunk_id": "54142f25de20997e", "doc_id": "hp_adfdee30bf450e7d"}, {"text": "He currently owns MT Studios for BlueThumbProductions in Burbank, California where he has produced, engineered and mixed albums for artists such as \"The Eels\" and \"Trapt\".", "chunk_id": "69ea2310084e6973", "doc_id": "hp_b786bea89d57e8fa"}, {"text": "Brides of Destruction was a short-lived American hard rock supergroup from Los Angeles, California, formed in 2002.", "chunk_id": "d7b89ee6722d4043", "doc_id": "hp_dfded5f3a8af70af"}, {"text": "Founded in 1964, it is located in Arcadia, California.", "chunk_id": "f0615d70c859fc21", "doc_id": "hp_f0298c6f3a685325"}, {"text": "The match that took place at The Home Depot Center in Carson, California on November 14, 2004.", "chunk_id": "ea967b117448c7a9", "doc_id": "hp_f960cf6c89ae3463"}, {"text": "Edward Sharpe and the Magnetic Zeros is an American folk rock band formed in Los Angeles, California in 2007.", "chunk_id": "508eaa5477ac7bce", "doc_id": "hp_f98356ff88ddd6a3"}, {"text": "Notre Dame High School, Belmont is a private, All-Female, Catholic, college preparatory high school located in the San Mateo County suburb of Belmont, California.", "chunk_id": "62dbcbf4d4fa43a6", "doc_id": "hp_fc280682a135c497"}]</data>
  <data key="d3">["hp_20acafffd5f50194", "hp_2f3cd8d24b5f56f1", "hp_350233375cc7c884", "hp_449285fab9db13ba", "hp_46658770e8628bf3", "hp_5d64f24bd8d85ba4", "hp_70e1b920ca70d1e9", "hp_777b99a15f2523b1", "hp_89406a2f1bd87039", "hp_8e65f4aec073c221", "hp_900332dfe25fe511", "hp_9355db235edf3f84", "hp_980453e19b052243", "hp_995e15f7f8919993", "hp_adfdee30bf450e7d", "hp_b786bea89d57e8fa", "hp_dfded5f3a8af70af", "hp_f0298c6f3a685325", "hp_f960cf6c89ae3463", "hp_f98356ff88ddd6a3", "hp_fc280682a135c497"]</data>
  <data key="d4">False</data>
</node>
<node id="birth records">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Records of registered births, which are abstracted into the California Birth Index.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d2">[{"text": "The index contains birth records of all registered births in California between 1905 and 1995.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d3">["hp_20acafffd5f50194"]</data>
  <data key="d4">False</data>
</node>
<node id="birth certificate">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A document from which records in the California Birth Index are abstracted.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d2">[{"text": "Each record is an abstract of a person's birth certificate, including date of birth, full name, county of birth, gender, and mother's maiden name.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d3">["hp_20acafffd5f50194"]</data>
  <data key="d4">False</data>
</node>
<node id="genealogy tool">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A tool used for researching family history, such as the CABI.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d2">[{"text": "The CABI is considered a valuable genealogy tool but is also criticized for privacy issues.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d3">["hp_20acafffd5f50194"]</data>
  <data key="d4">False</data>
</node>
<node id="privacy issues">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Concerns related to the confidentiality and protection of personal information, which have been raised regarding the CABI.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d2">[{"text": "The CABI is considered a valuable genealogy tool but is also criticized for privacy issues.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d3">["hp_20acafffd5f50194"]</data>
  <data key="d4">False</data>
</node>
<node id="statewide civil registration of births">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The official system for recording births across an entire state, which began in California on July 1, 1905.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d2">[{"text": "California began statewide civil registration of births on July 1, 1905.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d3">["hp_20acafffd5f50194"]</data>
  <data key="d4">False</data>
</node>
<node id="county">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A geographical administrative division within a state, where earlier birth records might exist.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d2">[{"text": "Earlier birth records may exist in the county where the birth took place or at the church where a baptism took place.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d3">["hp_20acafffd5f50194"]</data>
  <data key="d4">False</data>
</node>
<node id="church">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A place of worship where earlier birth records might exist in the form of baptism records.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d2">[{"text": "Earlier birth records may exist in the county where the birth took place or at the church where a baptism took place.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d3">["hp_20acafffd5f50194"]</data>
  <data key="d4">False</data>
</node>
