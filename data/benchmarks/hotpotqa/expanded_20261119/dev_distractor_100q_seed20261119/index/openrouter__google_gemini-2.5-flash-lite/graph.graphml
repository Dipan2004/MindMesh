  <data key="d7">[{"text": "To the southeast the reserve borders on the Unterlüß Firing Range (\"Schießplatz Unterlüß\"), belonging to the firm of Rheinmetall, and the \"Große Heide\" (\"Large Heath\") near Unterlüß, that is closed to the public.", "chunk_id": "582723cb6f560140", "doc_id": "hp_5fffbcc1125c9880", "type": "OWNED_BY"}]</data>
