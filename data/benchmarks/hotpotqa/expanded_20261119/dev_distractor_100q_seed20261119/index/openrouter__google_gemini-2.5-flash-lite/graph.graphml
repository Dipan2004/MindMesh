  <data key="d2">[{"text": "Karp grew up first in Scranton and Wilkes-Barre and then, in the later part of her childhood, in Williamsport, Pennsylvania and the surrounding Lycoming County area.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}]</data>
  <data key="d3">["hp_65a971e7a10d79c8"]</data>
