<node id="Elsimar Metzker Coutinho">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Elsimar Metzker Coutinho is a Brazilian scientist of Luso-Austrian descent, professor, gynecologist and television personality.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0"}]</data>
  <data key="d2">[{"text": "Elsimar Metzker Coutinho (Pojuca, May 18, 1930) is a Brazilian scientist of Luso-Austrian descent, professor, gynecologist and television personality, and character named as \"Prince of Itapoan\", in the books of Jorge Amado which references the Coutinho family's land in Itapoan where Amado himself lived.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0"}]</data>
  <data key="d3">["hp_ac3086730c4518d0"]</data>
  <data key="d4">False</data>
</node>
<node id="Pojuca">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Pojuca is a location associated with the birth of Elsimar Metzker Coutinho.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0"}]</data>
  <data key="d2">[{"text": "Elsimar Metzker Coutinho (Pojuca, May 18, 1930) is a Brazilian scientist of Luso-Austrian descent, professor, gynecologist and television personality, and character named as \"Prince of Itapoan\", in the books of Jorge Amado which references the Coutinho family's land in Itapoan where Amado himself lived.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0"}]</data>
  <data key="d3">["hp_ac3086730c4518d0"]</data>
  <data key="d4">False</data>
</node>
<node id="Luso-Austrian">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Luso-Austrian refers to the descent of Elsimar Metzker Coutinho.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0"}]</data>
  <data key="d2">[{"text": "Elsimar Metzker Coutinho (Pojuca, May 18, 1930) is a Brazilian scientist of Luso-Austrian descent, professor, gynecologist and television personality, and character named as \"Prince of Itapoan\", in the books of Jorge Amado which references the Coutinho family's land in Itapoan where Amado himself lived.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0"}]</data>
  <data key="d3">["hp_ac3086730c4518d0"]</data>
  <data key="d4">False</data>
</node>
<node id="Prince of Itapoan">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Prince of Itapoan is a character name associated with Elsimar Metzker Coutinho in the books of Jorge Amado.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0"}]</data>
  <data key="d2">[{"text": "Elsimar Metzker Coutinho (Pojuca, May 18, 1930) is a Brazilian scientist of Luso-Austrian descent, professor, gynecologist and television personality, and character named as \"Prince of Itapoan\", in the books of Jorge Amado which references the Coutinho family's land in Itapoan where Amado himself lived.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0"}]</data>
  <data key="d3">["hp_ac3086730c4518d0"]</data>
  <data key="d4">False</data>
</node>
<node id="Coutinho family's land">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Coutinho family's land is located in Itapoan and was referenced in the books of Jorge Amado.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0"}]</data>
  <data key="d2">[{"text": "Elsimar Metzker Coutinho (Pojuca, May 18, 1930) is a Brazilian scientist of Luso-Austrian descent, professor, gynecologist and television personality, and character named as \"Prince of Itapoan\", in the books of Jorge Amado which references the Coutinho family's land in Itapoan where Amado himself lived.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0"}]</data>
  <data key="d3">["hp_ac3086730c4518d0"]</data>
  <data key="d4">False</data>
</node>
<node id="Itapoan">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Itapoan is a location where the Coutinho family's land is situated and where Jorge Amado lived.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0"}]</data>
  <data key="d2">[{"text": "Elsimar Metzker Coutinho (Pojuca, May 18, 1930) is a Brazilian scientist of Luso-Austrian descent, professor, gynecologist and television personality, and character named as \"Prince of Itapoan\", in the books of Jorge Amado which references the Coutinho family's land in Itapoan where Amado himself lived.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0"}]</data>
  <data key="d3">["hp_ac3086730c4518d0"]</data>
  <data key="d4">False</data>
</node>
<node id="Firuz Agha Mosque">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An old Ottoman mosque in the Fatih district of Istanbul, Turkey.", "chunk_id": "f4b3646a27921496", "doc_id": "hp_ac4c6b296e4e7b01"}]</data>
  <data key="d2">[{"text": "The Firuz Ağa Mosque (Turkish: \"Firuz Ağa Camii\" ) is an old Ottoman mosque in the Fatih district of Istanbul, Turkey.", "chunk_id": "f4b3646a27921496", "doc_id": "hp_ac4c6b296e4e7b01"}]</data>
  <data key="d3">["hp_ac4c6b296e4e7b01"]</data>
  <data key="d4">False</data>
</node>
<node id="Firuz Ağa">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The head treasurer of Sultan Beyazıt II, who built the Firuz Agha Mosque.", "chunk_id": "f4b3646a27921496", "doc_id": "hp_ac4c6b296e4e7b01"}]</data>
  <data key="d2">[{"text": "It was built by Firuz Ağa, the head treasurer of Sultan Beyazıt II.", "chunk_id": "f4b3646a27921496", "doc_id": "hp_ac4c6b296e4e7b01"}]</data>
  <data key="d3">["hp_ac4c6b296e4e7b01"]</data>
  <data key="d4">False</data>
</node>
<node id="Sultan Beyazıt II">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The Sultan to whom Firuz Ağa was the head treasurer.", "chunk_id": "f4b3646a27921496", "doc_id": "hp_ac4c6b296e4e7b01"}]</data>
  <data key="d2">[{"text": "It was built by Firuz Ağa, the head treasurer of Sultan Beyazıt II.", "chunk_id": "f4b3646a27921496", "doc_id": "hp_ac4c6b296e4e7b01"}]</data>
  <data key="d3">["hp_ac4c6b296e4e7b01"]</data>
