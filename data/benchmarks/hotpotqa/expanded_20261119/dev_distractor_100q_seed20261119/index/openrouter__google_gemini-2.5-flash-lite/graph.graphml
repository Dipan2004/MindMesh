  <data key="d2">[{"text": "As promotion, he uploaded the songs \"Rise\" and \"Walk Tall\" to his personal website on 13 May.", "chunk_id": "bb2b762aba15f55a", "doc_id": "hp_24b106283a2f2b9f"}]</data>
