  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A dairy farm was where Eli James Harrison worked before joining New South Wales Railways.", "chunk_id": "53f3bbd1c43e3155", "doc_id": "hp_7820faef8a00d610"}]</data>
  <data key="d2">[{"text": "He then worked on a dairy farm before joining New South Wales Railways in 1925.", "chunk_id": "53f3bbd1c43e3155", "doc_id": "hp_7820faef8a00d610"}]</data>
