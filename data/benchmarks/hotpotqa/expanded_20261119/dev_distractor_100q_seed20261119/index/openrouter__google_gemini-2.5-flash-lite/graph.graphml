  <data key="d7">[{"text": "James Vladimir Taranik (April 23, 1940 – June 21, 2011) was an American scientist and educator who worked in the area of earth-observation satellite remote sensing.", "chunk_id": "a257f50e0bcd3ee4", "doc_id": "hp_a3c13d7a17deb19d", "type": "WORKED_IN"}]</data>
