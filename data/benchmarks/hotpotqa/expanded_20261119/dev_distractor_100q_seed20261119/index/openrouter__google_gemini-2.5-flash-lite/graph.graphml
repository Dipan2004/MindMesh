  <data key="d5">["ACCEPTED_POSITION"]</data>
  <data key="d6">Jules Perrot accepted the position of 'Premier maître de ballet' of the St. Petersburg Imperial Theatres.</data>
  <data key="d7">[{"text": "In 1850 Perrot departed London for Russia, having accepted the position of \"Premier maître de ballet\" of the St. Petersburg Imperial Theatres at the behest of Carlotta Grisi, who was engaged as \"Prima ballerina\".", "chunk_id": "b78dcabed6812ef8", "doc_id": "hp_031cfe5a8b4da13f", "type": "ACCEPTED_POSITION"}]</data>
  <data key="d8">hp_031cfe5a8b4da13f</data>
