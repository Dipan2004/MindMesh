</node>
<node id="load-bearing masonry">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Load-bearing masonry is a structural system.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d2">[{"text": "The structural system consists of load-bearing masonry with a flat roof, and materials include brick and flushboarding walls and a brownstone foundation.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d3">["hp_a8f5a77458dad7ce"]</data>
  <data key="d4">False</data>
</node>
