</node>
<node id="CBS Sports Network">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A broadcasting network in the United States that will air the 2013 World's Strongest Man event.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "A television network that will broadcast the 2014 World's Strongest Man event in the United States.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d2">[{"text": "The event was sponsored by the Commerce Casino and will be broadcast in the United States on the CBS Sports Network.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "The event was sponsored by the Commerce Casino and will begin broadcasting in the United States on the CBS Sports Network from July 4-August 13, 2014.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
