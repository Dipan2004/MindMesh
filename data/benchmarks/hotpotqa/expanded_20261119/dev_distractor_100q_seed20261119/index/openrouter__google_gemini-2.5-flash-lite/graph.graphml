</node>
<node id="Won Gyun">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Won Gyun was a Korean general and admiral during the Joseon Dynasty.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d2">[{"text": "Won Gyun (Korean: 원균, hanja:元均 ; 12 February 1540 – 27 August 1597) was a Korean general and admiral during the Joseon Dynasty.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d3">["hp_75d8594536b8ad92"]</data>
  <data key="d4">False</data>
</node>
<node id="Joseon Dynasty">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Joseon Dynasty was the last royal dynasty of Korea.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}, {"text": "A Korean dynasty that ruled the Korean peninsula from July 1392 to October 1897.", "chunk_id": "ab78baf12b2f8b16", "doc_id": "hp_b840ad7146ba28d6"}, {"text": "A historical Korean dynasty during which Admiral Yi Sun-sin lived.", "chunk_id": "99c215cb87242ef5", "doc_id": "hp_d01934819d3bc4ad"}]</data>
  <data key="d2">[{"text": "Won Gyun (Korean: 원균, hanja:元均 ; 12 February 1540 – 27 August 1597) was a Korean general and admiral during the Joseon Dynasty.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}, {"text": "As with all aspects of Korean life during the past century, the film industry has often been at the mercy of political events, from the late Joseon dynasty to the Korean War to domestic governmental interference.", "chunk_id": "ab78baf12b2f8b16", "doc_id": "hp_b840ad7146ba28d6"}, {"text": "Nanjung Ilgi or War Diary of Yi Sun-sin is the personal diary of Admiral Yi Sun-sin (Hangul: 이순신, Hanja: 李舜臣), a Korean naval commander who lived during the Joseon Dynasty.", "chunk_id": "99c215cb87242ef5", "doc_id": "hp_d01934819d3bc4ad"}]</data>
  <data key="d3">["hp_75d8594536b8ad92", "hp_b840ad7146ba28d6", "hp_d01934819d3bc4ad"]</data>
  <data key="d4">False</data>
</node>
<node id="Hideyoshi's invasions of Korea">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "Hideyoshi's invasions of Korea were military campaigns launched by Toyotomi Hideyoshi of Japan against Korea.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d2">[{"text": "He is best known for his campaigns against Japanese during Hideyoshi's invasions of Korea.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d3">["hp_75d8594536b8ad92"]</data>
  <data key="d4">False</data>
</node>
<node id="Wonju Won family">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Wonju Won family was a well-known family for its members' military accomplishments.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d2">[{"text": "Won was a member of Wonju Won family, which was well known for its members' military accomplishments.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d3">["hp_75d8594536b8ad92"]</data>
  <data key="d4">False</data>
</node>
<node id="Pyeongtaek">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Pyeongtaek is a city in Gyeonggi Province, South Korea.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d2">[{"text": "He was born in 1540 near Pyeongtaek and demonstrated his skill as warrior at a young age.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d3">["hp_75d8594536b8ad92"]</data>
  <data key="d4">False</data>
</node>
<node id="Jurchens">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Jurchens were a Tungistic people who inhabited Manchuria.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d2">[{"text": "He was qualified as a military officer and was first assigned to the northern border to defend against the Jurchens, who frequently raided Korean villages.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d3">["hp_75d8594536b8ad92"]</data>
  <data key="d4">False</data>
</node>
<node id="Yi Il">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Yi Il was a Korean general who fought against the Jurchens.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d2">[{"text": "Won led many successful campaigns with Yi Il and Yi Sun-sin against the Jurchens.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d3">["hp_75d8594536b8ad92"]</data>
  <data key="d4">False</data>
</node>
<node id="Gyeongsang Province">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Gyeongsang Province was a province in southeastern Korea during the Joseon Dynasty.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d2">[{"text": "After considerable accomplishments on the northern frontier, he was promoted to admiral in 1592 and sent to the southern coast of Gyeongsang Province to command the province's Western Fleet, along with Yi Sun-sin, who became admiral before Won and took command of Jeolla Province's Eastern Fleet.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d3">["hp_75d8594536b8ad92"]</data>
  <data key="d4">False</data>
</node>
<node id="Jeolla Province">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Jeolla Province was a province in southwestern Korea during the Joseon Dynasty.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d2">[{"text": "After considerable accomplishments on the northern frontier, he was promoted to admiral in 1592 and sent to the southern coast of Gyeongsang Province to command the province's Western Fleet, along with Yi Sun-sin, who became admiral before Won and took command of Jeolla Province's Eastern Fleet.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}]</data>
  <data key="d3">["hp_75d8594536b8ad92"]</data>
  <data key="d4">False</data>
</node>
<node id="Ambroise Thomas">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Charles Louis Ambroise Thomas was a French composer.", "chunk_id": "3facf7eaa59386bf", "doc_id": "hp_75db37c8dc73936b"}]</data>
  <data key="d2">[{"text": "Charles Louis Ambroise Thomas (5 August 1811 – 12 February 1896) was a French composer, best known for his operas \"Mignon\" (1866) and \"Hamlet\" (1868, after Shakespeare) and as Director of the Conservatoire de Paris from 1871 till his death.", "chunk_id": "3facf7eaa59386bf", "doc_id": "hp_75db37c8dc73936b"}]</data>
  <data key="d3">["hp_75db37c8dc73936b"]</data>
  <data key="d4">False</data>
</node>
<node id="Mignon">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Mignon is an opera by Ambroise Thomas, first performed in 1866.", "chunk_id": "3facf7eaa59386bf", "doc_id": "hp_75db37c8dc73936b"}]</data>
  <data key="d2">[{"text": "Charles Louis Ambroise Thomas (5 August 1811 – 12 February 1896) was a French composer, best known for his operas \"Mignon\" (1866) and \"Hamlet\" (1868, after Shakespeare) and as Director of the Conservatoire de Paris from 1871 till his death.", "chunk_id": "3facf7eaa59386bf", "doc_id": "hp_75db37c8dc73936b"}]</data>
  <data key="d3">["hp_75db37c8dc73936b"]</data>
  <data key="d4">False</data>
</node>
<node id="Hamlet">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Hamlet is an opera by Ambroise Thomas, first performed in 1868, based on Shakespeare's play.", "chunk_id": "3facf7eaa59386bf", "doc_id": "hp_75db37c8dc73936b"}]</data>
  <data key="d2">[{"text": "Charles Louis Ambroise Thomas (5 August 1811 – 12 February 1896) was a French composer, best known for his operas \"Mignon\" (1866) and \"Hamlet\" (1868, after Shakespeare) and as Director of the Conservatoire de Paris from 1871 till his death.", "chunk_id": "3facf7eaa59386bf", "doc_id": "hp_75db37c8dc73936b"}]</data>
  <data key="d3">["hp_75db37c8dc73936b"]</data>
  <data key="d4">False</data>
</node>
<node id="Conservatoire de Paris">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Conservatoire de Paris is an institution where Ambroise Thomas served as Director.", "chunk_id": "3facf7eaa59386bf", "doc_id": "hp_75db37c8dc73936b"}]</data>
  <data key="d2">[{"text": "Charles Louis Ambroise Thomas (5 August 1811 – 12 February 1896) was a French composer, best known for his operas \"Mignon\" (1866) and \"Hamlet\" (1868, after Shakespeare) and as Director of the Conservatoire de Paris from 1871 till his death.", "chunk_id": "3facf7eaa59386bf", "doc_id": "hp_75db37c8dc73936b"}]</data>
  <data key="d3">["hp_75db37c8dc73936b"]</data>
  <data key="d4">False</data>
</node>
<node id="Davis Cup">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "Davis Cup is a competition in which Nenad Zimonjić has played 54 ties and achieved 43 victories.", "chunk_id": "d03416aefc62fa72", "doc_id": "hp_75e8629db66341ba"}]</data>
  <data key="d2">[{"text": "A 22 year span consisting of 54 Davis Cup ties including 43 victories has resulted in him becoming the most accomplished Davis Cup player in his nations history.", "chunk_id": "d03416aefc62fa72", "doc_id": "hp_75e8629db66341ba"}]</data>
  <data key="d3">["hp_75e8629db66341ba"]</data>
  <data key="d4">False</data>
</node>
<node id="11 Downing Street">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "11 Downing Street is the official residence of Britain's Chancellor of the Exchequer.", "chunk_id": "9f673348a0fb7a1f", "doc_id": "hp_75fe9fb18dc6c720"}]</data>
  <data key="d2">[{"text": "11 Downing Street (sometimes referred to as just Number 11) is the official residence of Britain's Chancellor of the Exchequer (who traditionally also has the title of Second Lord of the Treasury).", "chunk_id": "9f673348a0fb7a1f", "doc_id": "hp_75fe9fb18dc6c720"}]</data>
  <data key="d3">["hp_75fe9fb18dc6c720"]</data>
  <data key="d4">False</data>
</node>
<node id="Number 11">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Number 11 is an alternative name for 11 Downing Street.", "chunk_id": "9f673348a0fb7a1f", "doc_id": "hp_75fe9fb18dc6c720"}]</data>
  <data key="d2">[{"text": "11 Downing Street (sometimes referred to as just Number 11) is the official residence of Britain's Chancellor of the Exchequer (who traditionally also has the title of Second Lord of the Treasury).", "chunk_id": "9f673348a0fb7a1f", "doc_id": "hp_75fe9fb18dc6c720"}]</data>
  <data key="d3">["hp_75fe9fb18dc6c720"]</data>
  <data key="d4">False</data>
</node>
<node id="Britain's Chancellor of the Exchequer">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Britain's Chancellor of the Exchequer is a government official who traditionally also holds the title of Second Lord of the Treasury.", "chunk_id": "9f673348a0fb7a1f", "doc_id": "hp_75fe9fb18dc6c720"}]</data>
  <data key="d2">[{"text": "11 Downing Street (sometimes referred to as just Number 11) is the official residence of Britain's Chancellor of the Exchequer (who traditionally also has the title of Second Lord of the Treasury).", "chunk_id": "9f673348a0fb7a1f", "doc_id": "hp_75fe9fb18dc6c720"}]</data>
  <data key="d3">["hp_75fe9fb18dc6c720"]</data>
  <data key="d4">False</data>
</node>
<node id="Second Lord of the Treasury">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The Second Lord of the Treasury is a traditional title held by Britain's Chancellor of the Exchequer.", "chunk_id": "9f673348a0fb7a1f", "doc_id": "hp_75fe9fb18dc6c720"}]</data>
  <data key="d2">[{"text": "11 Downing Street (sometimes referred to as just Number 11) is the official residence of Britain's Chancellor of the Exchequer (who traditionally also has the title of Second Lord of the Treasury).", "chunk_id": "9f673348a0fb7a1f", "doc_id": "hp_75fe9fb18dc6c720"}]</data>
  <data key="d3">["hp_75fe9fb18dc6c720"]</data>
  <data key="d4">False</data>
</node>
<node id="Downing Street">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Downing Street is a street in London where official residences are located.", "chunk_id": "9f673348a0fb7a1f", "doc_id": "hp_75fe9fb18dc6c720"}]</data>
  <data key="d2">[{"text": "The residence, in Downing Street in London, was built alongside the official residence of the Prime Minister at Number 10 in 1682.", "chunk_id": "9f673348a0fb7a1f", "doc_id": "hp_75fe9fb18dc6c720"}]</data>
  <data key="d3">["hp_75fe9fb18dc6c720"]</data>
  <data key="d4">False</data>
</node>
<node id="Number 10">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Number 10 is the official residence of the Prime Minister.", "chunk_id": "9f673348a0fb7a1f", "doc_id": "hp_75fe9fb18dc6c720"}]</data>
  <data key="d2">[{"text": "The residence, in Downing Street in London, was built alongside the official residence of the Prime Minister at Number 10 in 1682.", "chunk_id": "9f673348a0fb7a1f", "doc_id": "hp_75fe9fb18dc6c720"}]</data>
  <data key="d3">["hp_75fe9fb18dc6c720"]</data>
  <data key="d4">False</data>
</node>
<node id="Prime Minister">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The Prime Minister is an official whose residence is at Number 10 Downing Street.", "chunk_id": "9f673348a0fb7a1f", "doc_id": "hp_75fe9fb18dc6c720"}]</data>
  <data key="d2">[{"text": "The residence, in Downing Street in London, was built alongside the official residence of the Prime Minister at Number 10 in 1682.", "chunk_id": "9f673348a0fb7a1f", "doc_id": "hp_75fe9fb18dc6c720"}]</data>
  <data key="d3">["hp_75fe9fb18dc6c720"]</data>
