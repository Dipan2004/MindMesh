<node id="Pennsylvania">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Pennsylvania is a location where Barrie Karp grew up.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}, {"text": "Pennsylvania is a state where Philadelphia is located.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d2">[{"text": "Karp grew up first in Scranton and Wilkes-Barre and then, in the later part of her childhood, in Williamsport, Pennsylvania and the surrounding Lycoming County area.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}, {"text": "Cynthia G. Mason is a songwriter based in Philadelphia, Pennsylvania.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d3">["hp_65a971e7a10d79c8", "hp_a4ea94be7751c86c"]</data>
