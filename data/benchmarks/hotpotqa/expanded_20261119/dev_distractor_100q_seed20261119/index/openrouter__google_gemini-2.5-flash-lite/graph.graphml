  <data key="d7">[{"text": "Eugene Anthony Bleymaier (born 1953) is an American university administrator who was most recently special advisor to the president at San Jose State University.", "chunk_id": "c61e317be1f763fa", "doc_id": "hp_070129db81e76e31", "type": "WORKS_AT"}, {"text": "Bleymaier was previously an athletic director, first at Boise State University from 1982 to 2011 and San Jose State from 2012 to 2017.", "chunk_id": "c61e317be1f763fa", "doc_id": "hp_070129db81e76e31", "type": "WORKS_AT"}]</data>
