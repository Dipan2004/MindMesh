  <data key="d1">[{"text": "New South Wales Railways was an organization that Eli James Harrison joined in 1925.", "chunk_id": "53f3bbd1c43e3155", "doc_id": "hp_7820faef8a00d610"}]</data>
  <data key="d2">[{"text": "He then worked on a dairy farm before joining New South Wales Railways in 1925.", "chunk_id": "53f3bbd1c43e3155", "doc_id": "hp_7820faef8a00d610"}]</data>
