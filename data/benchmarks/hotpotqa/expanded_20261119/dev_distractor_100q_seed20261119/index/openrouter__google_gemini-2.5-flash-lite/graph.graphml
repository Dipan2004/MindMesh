  <data key="d5">["REPLACED"]</data>
  <data key="d6">Manley Field House was built to replace Archbold Gymnasium.</data>
  <data key="d7">[{"text": "It was built to replace the old Archbold Gymnasium, which had served for almost 60 years prior.", "chunk_id": "f2b57f4a59e6b366", "doc_id": "hp_3e92bdc5489290ce", "type": "REPLACED"}]</data>
  <data key="d8">hp_3e92bdc5489290ce</data>
</edge>
