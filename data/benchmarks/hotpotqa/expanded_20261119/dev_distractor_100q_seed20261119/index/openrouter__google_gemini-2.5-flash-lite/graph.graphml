  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The cultural legacy and traditions associated with people of German origin, significant to the St. Anne's Hill neighborhood.", "chunk_id": "b3dd1a340e6929c9", "doc_id": "hp_58345f001027ee37"}]</data>
  <data key="d2">[{"text": "The neighborhood is significant for its German heritage.", "chunk_id": "b3dd1a340e6929c9", "doc_id": "hp_58345f001027ee37"}]</data>
