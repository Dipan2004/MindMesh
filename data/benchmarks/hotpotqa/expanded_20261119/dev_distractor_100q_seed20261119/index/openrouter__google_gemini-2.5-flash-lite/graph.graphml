<node id="Fineco">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Fineco was a parent company of FinecoBank and a subsidiary of Capitalia.", "chunk_id": "72a1812ec3e8f939", "doc_id": "hp_9cd8d72b2f8786ea"}]</data>
  <data key="d2">[{"text": "Founded as a subsidiary of Fineco (itself a subsidiary of Capitalia), the bank became a subsidiary of UniCredit after Capitalia was acquired in 2007.", "chunk_id": "72a1812ec3e8f939", "doc_id": "hp_9cd8d72b2f8786ea"}]</data>
