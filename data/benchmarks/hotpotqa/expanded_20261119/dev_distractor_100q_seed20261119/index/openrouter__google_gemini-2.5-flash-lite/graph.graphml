  <data key="d2">[{"text": "The 2008 Kansas City Wizards season was the first season played at the temporary home Community America Ballpark in Kansas City, Kansas.", "chunk_id": "e6a59a32f07d004d", "doc_id": "hp_ad68101ffb82caf3"}]</data>
  <data key="d3">["hp_ad68101ffb82caf3"]</data>
