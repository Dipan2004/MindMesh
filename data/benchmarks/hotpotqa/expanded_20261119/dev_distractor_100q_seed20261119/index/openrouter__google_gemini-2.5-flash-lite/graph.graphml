</node>
<node id="Black hole bomb">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A black hole bomb is the name given to a physical effect utilizing how a bosonic field impinging on a rotating black hole can be amplified through superradiant scattering.", "chunk_id": "7e7db6cd424d1ca0", "doc_id": "hp_0a14829980a416a2"}]</data>
  <data key="d2">[{"text": "A black hole bomb is the name given to a physical effect utilizing how a bosonic field impinging on a rotating black hole can be amplified through superradiant scattering.", "chunk_id": "7e7db6cd424d1ca0", "doc_id": "hp_0a14829980a416a2"}]</data>
  <data key="d3">["hp_0a14829980a416a2"]</data>
  <data key="d4">False</data>
</node>
<node id="bosonic field">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A bosonic field is a field that must have a rest mass different from zero to be amplified through superradiant scattering by a rotating black hole.", "chunk_id": "7e7db6cd424d1ca0", "doc_id": "hp_0a14829980a416a2"}]</data>
  <data key="d2">[{"text": "An additional condition which must be met is that the field must have a rest mass different from zero.", "chunk_id": "7e7db6cd424d1ca0", "doc_id": "hp_0a14829980a416a2"}]</data>
  <data key="d3">["hp_0a14829980a416a2"]</data>
  <data key="d4">False</data>
</node>
<node id="rotating black hole">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A rotating black hole is a black hole that can amplify a bosonic field impinging on it through superradiant scattering.", "chunk_id": "7e7db6cd424d1ca0", "doc_id": "hp_0a14829980a416a2"}, {"text": "A rotating black hole is a black hole that possesses rotational energy, from which energy can be extracted via the Penrose process.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "A black hole bomb is the name given to a physical effect utilizing how a bosonic field impinging on a rotating black hole can be amplified through superradiant scattering.", "chunk_id": "7e7db6cd424d1ca0", "doc_id": "hp_0a14829980a416a2"}, {"text": "The Penrose process (also called Penrose mechanism) is a process theorised by Roger Penrose wherein energy can be extracted from a rotating black hole.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_0a14829980a416a2", "hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="superradiant scattering">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Superradiant scattering is a physical effect where a bosonic field impinging on a rotating black hole can be amplified.", "chunk_id": "7e7db6cd424d1ca0", "doc_id": "hp_0a14829980a416a2"}]</data>
  <data key="d2">[{"text": "A black hole bomb is the name given to a physical effect utilizing how a bosonic field impinging on a rotating black hole can be amplified through superradiant scattering.", "chunk_id": "7e7db6cd424d1ca0", "doc_id": "hp_0a14829980a416a2"}]</data>
  <data key="d3">["hp_0a14829980a416a2"]</data>
  <data key="d4">False</data>
</node>
<node id="superradiant instability">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Superradiant instability is the mechanism by which the black hole bomb functions.", "chunk_id": "7e7db6cd424d1ca0", "doc_id": "hp_0a14829980a416a2"}]</data>
  <data key="d2">[{"text": "The mechanism by which the black hole bomb functions is called superradiant instability.", "chunk_id": "7e7db6cd424d1ca0", "doc_id": "hp_0a14829980a416a2"}]</data>
  <data key="d3">["hp_0a14829980a416a2"]</data>
  <data key="d4">False</data>
</node>
<node id="Fernando Fernández">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A Mexican actor and singer known as \"El Crooner de México\".", "chunk_id": "f22987b0a2a07a86", "doc_id": "hp_0a82eabb231d743f"}]</data>
  <data key="d2">[{"text": "Fernando Fernández \"El Crooner de México\" (1916–1999) was a Mexican actor and singer.", "chunk_id": "f22987b0a2a07a86", "doc_id": "hp_0a82eabb231d743f"}]</data>
  <data key="d3">["hp_0a82eabb231d743f"]</data>
  <data key="d4">False</data>
</node>
