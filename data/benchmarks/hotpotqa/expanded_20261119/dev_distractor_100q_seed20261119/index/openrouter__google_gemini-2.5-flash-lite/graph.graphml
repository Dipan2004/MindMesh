  <data key="d2">[{"text": "St Philip's was built in the early 18th century in the Baroque style by Thomas Archer and is located on Colmore Row, Birmingham, England.", "chunk_id": "11a5bbb4b1c95f73", "doc_id": "hp_7986a45cdf0624b2"}]</data>
