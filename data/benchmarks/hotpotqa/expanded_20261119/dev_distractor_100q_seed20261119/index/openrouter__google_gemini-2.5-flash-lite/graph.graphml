<node id="People's Prize">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The People's Prize is a North Korean arts and sciences award.", "chunk_id": "52bc9c8a3edf5d97", "doc_id": "hp_2307c875fa5f5cf1"}]</data>
  <data key="d2">[{"text": "The People's Prize (Korean: 인민상 ) is a North Korean arts and sciences award.", "chunk_id": "52bc9c8a3edf5d97", "doc_id": "hp_2307c875fa5f5cf1"}]</data>
  <data key="d3">["hp_2307c875fa5f5cf1"]</data>
  <data key="d4">False</data>
</node>
<node id="People's Prize Awarding Commission">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The People's Prize Awarding Commission is an organization that awards the People's Prize.", "chunk_id": "52bc9c8a3edf5d97", "doc_id": "hp_2307c875fa5f5cf1"}]</data>
  <data key="d2">[{"text": "It is awarded by the People's Prize Awarding Commission, which is working directly under the Cabinet of North Korea.", "chunk_id": "52bc9c8a3edf5d97", "doc_id": "hp_2307c875fa5f5cf1"}]</data>
  <data key="d3">["hp_2307c875fa5f5cf1"]</data>
  <data key="d4">False</data>
</node>
<node id="Cabinet of North Korea">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Cabinet of North Korea is the executive body of North Korea.", "chunk_id": "52bc9c8a3edf5d97", "doc_id": "hp_2307c875fa5f5cf1"}]</data>
  <data key="d2">[{"text": "It is awarded by the People's Prize Awarding Commission, which is working directly under the Cabinet of North Korea.", "chunk_id": "52bc9c8a3edf5d97", "doc_id": "hp_2307c875fa5f5cf1"}]</data>
  <data key="d3">["hp_2307c875fa5f5cf1"]</data>
  <data key="d4">False</data>
</node>
<node id="North Korean cinema">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "North Korean cinema is a field in which the People's Prize has been an important award.", "chunk_id": "52bc9c8a3edf5d97", "doc_id": "hp_2307c875fa5f5cf1"}, {"text": "The cinema of North Korea, which is characterized by its isolated nature and difficulty in obtaining unbiased information.", "chunk_id": "7cd59a2829630305", "doc_id": "hp_bb98f886833576c8"}, {"text": "The film industry of North Korea, which saw its largest investment ever made in the history of its cinema for the 'Nation and Destiny' series.", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882"}]</data>
  <data key="d2">[{"text": "People's Prize has been an important award in the field of North Korean cinema.", "chunk_id": "52bc9c8a3edf5d97", "doc_id": "hp_2307c875fa5f5cf1"}, {"text": "Because of the isolated nature of the country, information—particularly unbiased information—on North Korean cinema is difficult to find.", "chunk_id": "7cd59a2829630305", "doc_id": "hp_bb98f886833576c8"}, {"text": "Conceived as the largest film series ever produced in any country, it was the largest investment ever made in the history of North Korean cinema.", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882"}]</data>
  <data key="d3">["hp_2307c875fa5f5cf1", "hp_bb98f886833576c8", "hp_d64aea307fb47882"]</data>
  <data key="d4">False</data>
</node>
<node id="Canada's grand railway hotels">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A series of five-star grand hotels across Canada, each a local and national landmark and an icon of Canadian history and architecture.", "chunk_id": "0dce13f47d13eaac", "doc_id": "hp_2317e91f61e4f40d"}]</data>
  <data key="d2">[{"text": "Canada's grand railway hotels", "chunk_id": "0dce13f47d13eaac", "doc_id": "hp_2317e91f61e4f40d"}]</data>
  <data key="d3">["hp_2317e91f61e4f40d"]</data>
  <data key="d4">False</data>
</node>
<node id="Canadian railway companies">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Companies that owned and operated railways in Canada.", "chunk_id": "0dce13f47d13eaac", "doc_id": "hp_2317e91f61e4f40d"}]</data>
  <data key="d2">[{"text": "Each hotel was originally built by the Canadian railway companies, or the railways acted as a catalyst for the hotel’s construction.", "chunk_id": "0dce13f47d13eaac", "doc_id": "hp_2317e91f61e4f40d"}]</data>
  <data key="d3">["hp_2317e91f61e4f40d"]</data>
  <data key="d4">False</data>
</node>
<node id="Canadian history">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The historical events, figures, and developments related to Canada.", "chunk_id": "0dce13f47d13eaac", "doc_id": "hp_2317e91f61e4f40d"}, {"text": "The historical record of Canada.", "chunk_id": "8c9123487c66f805", "doc_id": "hp_f23b02c7bab7a782"}]</data>
  <data key="d2">[{"text": "Each hotel was originally built by the Canadian railway companies, or the railways acted as a catalyst for the hotel’s construction.", "chunk_id": "0dce13f47d13eaac", "doc_id": "hp_2317e91f61e4f40d"}, {"text": "They are recognized as being one of the best senior hockey teams in Canadian history.", "chunk_id": "8c9123487c66f805", "doc_id": "hp_f23b02c7bab7a782"}]</data>
  <data key="d3">["hp_2317e91f61e4f40d", "hp_f23b02c7bab7a782"]</data>
  <data key="d4">False</data>
</node>
<node id="architecture">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The art and science of designing and constructing buildings.", "chunk_id": "0dce13f47d13eaac", "doc_id": "hp_2317e91f61e4f40d"}]</data>
  <data key="d2">[{"text": "Each hotel was originally built by the Canadian railway companies, or the railways acted as a catalyst for the hotel’s construction.", "chunk_id": "0dce13f47d13eaac", "doc_id": "hp_2317e91f61e4f40d"}]</data>
  <data key="d3">["hp_2317e91f61e4f40d"]</data>
  <data key="d4">False</data>
</node>
<node id="rail travel">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The act of traveling by train.", "chunk_id": "0dce13f47d13eaac", "doc_id": "hp_2317e91f61e4f40d"}]</data>
  <data key="d2">[{"text": "The hotels were designed to serve the passengers of the country's then expanding rail network and they celebrated rail travel in style.", "chunk_id": "0dce13f47d13eaac", "doc_id": "hp_2317e91f61e4f40d"}]</data>
  <data key="d3">["hp_2317e91f61e4f40d"]</data>
  <data key="d4">False</data>
</node>
<node id="Lola">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A 1961 romantic drama film, the debut film directed by Jacques Demy.", "chunk_id": "f58d74090a79d846", "doc_id": "hp_231ed622feb34588"}, {"text": "A 1960 French-language film by Jacques Demy.", "chunk_id": "3488ae8198c6ceab", "doc_id": "hp_654ac6630b014afb"}]</data>
  <data key="d2">[{"text": "Lola, is a 1961 romantic drama film, the debut film directed by Jacques Demy as a tribute to director Max Ophüls and is described by Demy as a \"musical without music\".", "chunk_id": "f58d74090a79d846", "doc_id": "hp_231ed622feb34588"}, {"text": "Aimée reprises the title role from Demy's 1960 French-language film \"Lola\".", "chunk_id": "3488ae8198c6ceab", "doc_id": "hp_654ac6630b014afb"}]</data>
  <data key="d3">["hp_231ed622feb34588", "hp_654ac6630b014afb"]</data>
  <data key="d4">False</data>
</node>
<node id="Max Ophüls">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A director to whom Jacques Demy paid tribute with the film Lola.", "chunk_id": "f58d74090a79d846", "doc_id": "hp_231ed622feb34588"}]</data>
  <data key="d2">[{"text": "Lola, is a 1961 romantic drama film, the debut film directed by Jacques Demy as a tribute to director Max Ophüls and is described by Demy as a \"musical without music\".", "chunk_id": "f58d74090a79d846", "doc_id": "hp_231ed622feb34588"}]</data>
  <data key="d3">["hp_231ed622feb34588"]</data>
  <data key="d4">False</data>
</node>
<node id="Anouk Aimée">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The actress who starred in the title role of the film Lola.", "chunk_id": "f58d74090a79d846", "doc_id": "hp_231ed622feb34588"}, {"text": "An actress who starred in the film 'Model Shop' and reprised a role from 'Lola'.", "chunk_id": "3488ae8198c6ceab", "doc_id": "hp_654ac6630b014afb"}]</data>
  <data key="d2">[{"text": "Anouk Aimée starred in the title role.", "chunk_id": "f58d74090a79d846", "doc_id": "hp_231ed622feb34588"}, {"text": "Model Shop is a 1969 American film by French writer-director Jacques Demy starring Gary Lockwood, Alexandra Hay and Anouk Aimée and featuring a guest appearance by Spirit who also recorded the soundtrack.", "chunk_id": "3488ae8198c6ceab", "doc_id": "hp_654ac6630b014afb"}]</data>
  <data key="d3">["hp_231ed622feb34588", "hp_654ac6630b014afb"]</data>
  <data key="d4">False</data>
</node>
<node id="Agnès Varda">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The widow of Jacques Demy and a French filmmaker who restored and re-released the film Lola.", "chunk_id": "f58d74090a79d846", "doc_id": "hp_231ed622feb34588"}]</data>
  <data key="d2">[{"text": "The film was restored and re-released by Demy's widow, French filmmaker Agnès Varda.", "chunk_id": "f58d74090a79d846", "doc_id": "hp_231ed622feb34588"}]</data>
  <data key="d3">["hp_231ed622feb34588"]</data>
  <data key="d4">False</data>
</node>
<node id="Hot Girls">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A song by Lil' Mo, also known as 'Hot Boys, Hot Girls'.", "chunk_id": "4fbe89b0d5faec6f", "doc_id": "hp_233600b46cd7c338"}]</data>
  <data key="d2">[{"text": "\"Hot Girls,\" also known as its alternate title \"Hot Boys, Hot Girls,\" is song recorded by American recording artist Lil' Mo for her unreleased album, \"Syndicated: The Lil' Mo Hour\" (2005).", "chunk_id": "4fbe89b0d5faec6f", "doc_id": "hp_233600b46cd7c338"}]</data>
  <data key="d3">["hp_233600b46cd7c338"]</data>
  <data key="d4">False</data>
</node>
