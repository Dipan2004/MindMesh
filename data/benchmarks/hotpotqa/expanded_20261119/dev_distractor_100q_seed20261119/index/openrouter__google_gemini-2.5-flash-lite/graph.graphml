  <data key="d2">[{"text": "Batman: Original Motion Picture Score is the score album for the 1989 film \"Batman\" by Danny Elfman.", "chunk_id": "8c1c86c18a223728", "doc_id": "hp_f90b8fdeee8924ac"}]</data>
