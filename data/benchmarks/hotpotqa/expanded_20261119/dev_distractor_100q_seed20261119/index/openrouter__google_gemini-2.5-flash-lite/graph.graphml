  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A case argued and won by Stephen Halbrook before the US Supreme Court.", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d2">[{"text": "He has argued and won three cases before the US Supreme Court: \"Printz v. United States\", \"United States v. Thompson-Center Arms Company\", and \"Castillo v. United States\".", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d3">["hp_3196bc16ccdc716d"]</data>
  <data key="d4">False</data>
</node>
<node id="Small v. United States">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A Supreme Court case for which Stephen Halbrook wrote briefs.", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d2">[{"text": "He has also written briefs in many other cases, including the Supreme Court cases \"Small v. United States\" (pertaining to the Gun Control Act of 1968) and \"McDonald v. Chicago\".", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d3">["hp_3196bc16ccdc716d"]</data>
  <data key="d4">False</data>
</node>
<node id="Gun Control Act of 1968">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A law pertaining to which Stephen Halbrook wrote briefs in the case \"Small v. United States\".", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d2">[{"text": "He has also written briefs in many other cases, including the Supreme Court cases \"Small v. United States\" (pertaining to the Gun Control Act of 1968) and \"McDonald v. Chicago\".", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d3">["hp_3196bc16ccdc716d"]</data>
  <data key="d4">False</data>
</node>
<node id="McDonald v. Chicago">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A Supreme Court case for which Stephen Halbrook wrote briefs.", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d2">[{"text": "He has also written briefs in many other cases, including the Supreme Court cases \"Small v. United States\" (pertaining to the Gun Control Act of 1968) and \"McDonald v. Chicago\".", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d3">["hp_3196bc16ccdc716d"]</data>
  <data key="d4">False</data>
</node>
<node id="District of Columbia v. Heller">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A Supreme Court case in which Stephen Halbrook wrote a brief on behalf of the majority of both houses of Congress.", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d2">[{"text": "In \"District of Columbia v. Heller\", he wrote a brief on behalf of the majority of both houses of Congress.", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d3">["hp_3196bc16ccdc716d"]</data>
  <data key="d4">False</data>
</node>
<node id="Heller">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A Supreme Court decision that was intellectually founded by Stephen Halbrook's research on the Second Amendment.", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d2">[{"text": "More broadly, his decades of research on the Second Amendment contributed to the intellectual foundation of the \"Heller\" decision.", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d3">["hp_3196bc16ccdc716d"]</data>
  <data key="d4">False</data>
</node>
<node id="That Every Man Be Armed">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A book written by Stephen Halbrook, considered his most important scholarly contribution.", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d2">[{"text": "Halbrook’s most important scholarly contribution, however, was the book \"That Every Man Be Armed\", originally published in 1986.", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d3">["hp_3196bc16ccdc716d"]</data>
  <data key="d4">False</data>
</node>
<node id="US Supreme Court">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The highest court in the United States, where Stephen Halbrook has argued cases and had his writings cited.", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d2">[{"text": "He has argued and won three cases before the US Supreme Court: \"Printz v. United States\", \"United States v. Thompson-Center Arms Company\", and \"Castillo v. United States\".", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d3">["hp_3196bc16ccdc716d"]</data>
  <data key="d4">False</data>
</node>
<node id="Alexander (Alex Ebert album)">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Alexander is the first solo album by American musician Alex Ebert.", "chunk_id": "1f1504795345835d", "doc_id": "hp_319b85ef31304b0b"}]</data>
  <data key="d2">[{"text": "Alexander is the first solo album by American musician Alex Ebert, lead singer of Edward Sharpe and the Magnetic Zeros and Ima Robot.", "chunk_id": "1f1504795345835d", "doc_id": "hp_319b85ef31304b0b"}]</data>
  <data key="d3">["hp_319b85ef31304b0b"]</data>
  <data key="d4">False</data>
</node>
<node id="Alex Ebert">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Alex Ebert is an American musician and lead singer of Edward Sharpe and the Magnetic Zeros and Ima Robot.", "chunk_id": "1f1504795345835d", "doc_id": "hp_319b85ef31304b0b"}, {"text": "The frontman of Edward Sharpe and the Magnetic Zeros.", "chunk_id": "8fa693f0549c8311", "doc_id": "hp_f1ec6c8b9136d77b"}, {"text": "Lead singer of the band Edward Sharpe and the Magnetic Zeros.", "chunk_id": "508eaa5477ac7bce", "doc_id": "hp_f98356ff88ddd6a3"}]</data>
  <data key="d2">[{"text": "Alexander is the first solo album by American musician Alex Ebert, lead singer of Edward Sharpe and the Magnetic Zeros and Ima Robot.", "chunk_id": "1f1504795345835d", "doc_id": "hp_319b85ef31304b0b"}, {"text": "Frontman Alex Ebert stated that \"These songs mean everything to me - It's the rawest, most liberated, most rambunctious stuff we've done.\"", "chunk_id": "8fa693f0549c8311", "doc_id": "hp_f1ec6c8b9136d77b"}, {"text": "The group is led by lead singer Alex Ebert.", "chunk_id": "508eaa5477ac7bce", "doc_id": "hp_f98356ff88ddd6a3"}]</data>
  <data key="d3">["hp_319b85ef31304b0b", "hp_f1ec6c8b9136d77b", "hp_f98356ff88ddd6a3"]</data>
  <data key="d4">False</data>
</node>
<node id="Edward Sharpe and the Magnetic Zeros">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Edward Sharpe and the Magnetic Zeros is a band.", "chunk_id": "1f1504795345835d", "doc_id": "hp_319b85ef31304b0b"}, {"text": "The band that released the album PersonA.", "chunk_id": "d696d901bdf6b659", "doc_id": "hp_54ea6d2f9b8d7c96"}, {"text": "Edward Sharpe and the Magnetic Zeros is an artist with whom Aaron Embry has worked as a studio musician and touring pianist.", "chunk_id": "35b4acf5c74b48d4", "doc_id": "hp_995e15f7f8919993"}, {"text": "An American group that wrote and recorded the song \"Home\".", "chunk_id": "502d1ec5b75a536d", "doc_id": "hp_d99c63a0b04e6061"}, {"text": "The third album by Edward Sharpe and the Magnetic Zeros.", "chunk_id": "8fa693f0549c8311", "doc_id": "hp_f1ec6c8b9136d77b"}, {"text": "The musical group that released the album.", "chunk_id": "8fa693f0549c8311", "doc_id": "hp_f1ec6c8b9136d77b"}, {"text": "An American folk rock band formed in Los Angeles, California in 2007.", "chunk_id": "508eaa5477ac7bce", "doc_id": "hp_f98356ff88ddd6a3"}, {"text": "The third album by Edward Sharpe and the Magnetic Zeros.", "chunk_id": "508eaa5477ac7bce", "doc_id": "hp_f98356ff88ddd6a3"}]</data>
  <data key="d2">[{"text": "Alexander is the first solo album by American musician Alex Ebert, lead singer of Edward Sharpe and the Magnetic Zeros and Ima Robot.", "chunk_id": "1f1504795345835d", "doc_id": "hp_319b85ef31304b0b"}, {"text": "PersonA (pronounced \"Persona\") is the fourth studio album by the band Edward Sharpe and the Magnetic Zeros.", "chunk_id": "d696d901bdf6b659", "doc_id": "hp_54ea6d2f9b8d7c96"}, {"text": "A periodic studio musician and touring pianist with artists such as Elliott Smith and Edward Sharpe and the Magnetic Zeros, he has also helped write albums by Jane's Addiction and produced albums by artists such as Avi Buffalo.", "chunk_id": "35b4acf5c74b48d4", "doc_id": "hp_995e15f7f8919993"}, {"text": "\"Home\" is a song written and recorded by American group Edward Sharpe and the Magnetic Zeros.", "chunk_id": "502d1ec5b75a536d", "doc_id": "hp_d99c63a0b04e6061"}, {"text": "Edward Sharpe and the Magnetic Zeros is the third album by Edward Sharpe and the Magnetic Zeros.", "chunk_id": "8fa693f0549c8311", "doc_id": "hp_f1ec6c8b9136d77b"}, {"text": "Edward Sharpe and the Magnetic Zeros is the third album by Edward Sharpe and the Magnetic Zeros.", "chunk_id": "8fa693f0549c8311", "doc_id": "hp_f1ec6c8b9136d77b"}, {"text": "Edward Sharpe and the Magnetic Zeros is an American folk rock band formed in Los Angeles, California in 2007.", "chunk_id": "508eaa5477ac7bce", "doc_id": "hp_f98356ff88ddd6a3"}, {"text": "The group released their second full-length album, \"Here\", on May 29, 2012, and third album, \"Edward Sharpe and the Magnetic Zeros\", on July 23, 2013.", "chunk_id": "508eaa5477ac7bce", "doc_id": "hp_f98356ff88ddd6a3"}]</data>
  <data key="d3">["hp_319b85ef31304b0b", "hp_54ea6d2f9b8d7c96", "hp_995e15f7f8919993", "hp_d99c63a0b04e6061", "hp_f1ec6c8b9136d77b", "hp_f98356ff88ddd6a3"]</data>
  <data key="d4">False</data>
</node>
<node id="Ima Robot">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Ima Robot is a band.", "chunk_id": "1f1504795345835d", "doc_id": "hp_319b85ef31304b0b"}]</data>
  <data key="d2">[{"text": "Alexander is the first solo album by American musician Alex Ebert, lead singer of Edward Sharpe and the Magnetic Zeros and Ima Robot.", "chunk_id": "1f1504795345835d", "doc_id": "hp_319b85ef31304b0b"}]</data>
  <data key="d3">["hp_319b85ef31304b0b"]</data>
  <data key="d4">False</data>
</node>
<node id="Community Records">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Community Records is a label under which the album Alexander was released.", "chunk_id": "1f1504795345835d", "doc_id": "hp_319b85ef31304b0b"}, {"text": "The record label that released the album \"Up from Below\".", "chunk_id": "508eaa5477ac7bce", "doc_id": "hp_f98356ff88ddd6a3"}]</data>
  <data key="d2">[{"text": "It was released on March 1, 2011 under the Community Records label.", "chunk_id": "1f1504795345835d", "doc_id": "hp_319b85ef31304b0b"}, {"text": "Their first studio album, \"Up from Below\", was released on July 7, 2009 on Community Records and featured the popular single \"Home\".", "chunk_id": "508eaa5477ac7bce", "doc_id": "hp_f98356ff88ddd6a3"}]</data>
  <data key="d3">["hp_319b85ef31304b0b", "hp_f98356ff88ddd6a3"]</data>
  <data key="d4">False</data>
</node>
