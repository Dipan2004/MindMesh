  <data key="d2">[{"text": "An even broader definition includes Soviet citizens and prisoners of war, homosexuals, Jehovah's Witnesses, black people, and political opponents of the Nazis.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d3">["hp_58dc44606385cdf1"]</data>
  <data key="d4">False</data>
</node>
<node id="political opponents of the Nazis">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A group included in an even broader definition of Holocaust victims.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d2">[{"text": "An even broader definition includes Soviet citizens and prisoners of war, homosexuals, Jehovah's Witnesses, black people, and political opponents of the Nazis.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d3">["hp_58dc44606385cdf1"]</data>
  <data key="d4">False</data>
</node>
<node id="J. Michael Lennon">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Emeritus Professor of English at Wilkes University and Norman Mailer's archivist and authorized biographer.", "chunk_id": "645ac4bb539e8387", "doc_id": "hp_58ea4a9bbd58a7e0"}]</data>
  <data key="d2">[{"text": "J. Michael Lennon is Emeritus Professor of English at Wilkes University and the late Norman Mailer’s archivist and authorized biographer.", "chunk_id": "645ac4bb539e8387", "doc_id": "hp_58ea4a9bbd58a7e0"}]</data>
  <data key="d3">["hp_58ea4a9bbd58a7e0"]</data>
  <data key="d4">False</data>
</node>
<node id="Wilkes University">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A university where J. Michael Lennon is an Emeritus Professor of English.", "chunk_id": "645ac4bb539e8387", "doc_id": "hp_58ea4a9bbd58a7e0"}]</data>
  <data key="d2">[{"text": "J. Michael Lennon is Emeritus Professor of English at Wilkes University and the late Norman Mailer’s archivist and authorized biographer.", "chunk_id": "645ac4bb539e8387", "doc_id": "hp_58ea4a9bbd58a7e0"}]</data>
  <data key="d3">["hp_58ea4a9bbd58a7e0"]</data>
  <data key="d4">False</data>
</node>
<node id="Norman Mailer: A Double Life">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The official biography of Norman Mailer published by J. Michael Lennon.", "chunk_id": "645ac4bb539e8387", "doc_id": "hp_58ea4a9bbd58a7e0"}]</data>
  <data key="d2">[{"text": "He published Mailer's official biography \"Norman Mailer: A Double Life\" in 2013.", "chunk_id": "645ac4bb539e8387", "doc_id": "hp_58ea4a9bbd58a7e0"}]</data>
  <data key="d3">["hp_58ea4a9bbd58a7e0"]</data>
  <data key="d4">False</data>
</node>
<node id="Random House">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The publisher of Mailer's selected letters.", "chunk_id": "645ac4bb539e8387", "doc_id": "hp_58ea4a9bbd58a7e0"}]</data>
  <data key="d2">[{"text": "He edited Mailer's selected letters, which were published by Random House in 2014.", "chunk_id": "645ac4bb539e8387", "doc_id": "hp_58ea4a9bbd58a7e0"}]</data>
  <data key="d3">["hp_58ea4a9bbd58a7e0"]</data>
  <data key="d4">False</data>
</node>
<node id="Sweden">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A country where the song was released.", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}, {"text": "A country represented in the \"So You Think You Can Dance Scandinavia\" television show.", "chunk_id": "96e04c197c9ce333", "doc_id": "hp_a3467d4329bdabd5"}, {"text": "The country Lars Hedlund is from.", "chunk_id": "22af8bb1815b8995", "doc_id": "hp_b1381d79c5b4d390"}, {"text": "Sweden is the country Fredrik Jonsson is from.", "chunk_id": "9b7ed97fc332f36e", "doc_id": "hp_fde1f38d00136854"}]</data>
  <data key="d2">[{"text": "It was released in Sweden on September 21, 2002, where it became her highest charting single since 1995's \"Do You Really Want Me (Show Respect)\".", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}, {"text": "So You Think You Can Dance Scandinavia was an entry in the international \"So You Think You Can Dance\" franchise of dance competition television shows which represented Denmark, Norway, and Sweden.", "chunk_id": "96e04c197c9ce333", "doc_id": "hp_a3467d4329bdabd5"}, {"text": "Lars Hedlund from Sweden finished second after finishing second the previous year, and Geoff Capes from the United Kingdom finished third.", "chunk_id": "22af8bb1815b8995", "doc_id": "hp_b1381d79c5b4d390"}, {"text": "Fredrik Jonsson (born 28 March 1977 in Malmö) is a retired tennis player from Sweden, who turned professional in 1996.", "chunk_id": "9b7ed97fc332f36e", "doc_id": "hp_fde1f38d00136854"}]</data>
  <data key="d3">["hp_593b07de5fa84d4e", "hp_a3467d4329bdabd5", "hp_b1381d79c5b4d390", "hp_fde1f38d00136854"]</data>
  <data key="d4">False</data>
</node>
<node id="Do You Really Want Me (Show Respect)">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A song by Robyn that charted in 1995.", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}]</data>
  <data key="d2">[{"text": "It was released in Sweden on September 21, 2002, where it became her highest charting single since 1995's \"Do You Really Want Me (Show Respect)\".", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}]</data>
  <data key="d3">["hp_593b07de5fa84d4e"]</data>
  <data key="d4">False</data>
</node>
<node id="By Your Side">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The name under which \"Keep This Fire Burning\" was released as a single in Australia.", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}]</data>
  <data key="d2">[{"text": "The song was also released as a single in Australia under the name \"By Your Side\", due to the Australian bush fires which were happening at the time.", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}]</data>
  <data key="d3">["hp_593b07de5fa84d4e"]</data>
  <data key="d4">False</data>
</node>
<node id="Australian bush fires">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "Fires that were happening in Australia at the time of the song's release there.", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}]</data>
  <data key="d2">[{"text": "The song was also released as a single in Australia under the name \"By Your Side\", due to the Australian bush fires which were happening at the time.", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}]</data>
  <data key="d3">["hp_593b07de5fa84d4e"]</data>
  <data key="d4">False</data>
</node>
<node id="Robyn's eponymous album">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The self-titled album by Robyn, which had a special edition released in 2008.", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}]</data>
  <data key="d2">[{"text": "In 2008, a re-recorded version of the song appeared on the special edition of Robyn's eponymous album.", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}]</data>
  <data key="d3">["hp_593b07de5fa84d4e"]</data>
  <data key="d4">False</data>
</node>
<node id="Reynard">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Reynard is the main character in a literary cycle of allegorical Dutch, English, French and German fables.", "chunk_id": "8fcb4a5f29ed4d18", "doc_id": "hp_59ca239a2da6a609"}]</data>
  <data key="d2">[{"text": "Reynard (Dutch: \"Reinaert\" ; French: \"Renard\" ; German: \"Reineke or Reinicke\" ; Latin: \"Renartus\" ) is the main character in a literary cycle of allegorical Dutch, English, French and German fables.", "chunk_id": "8fcb4a5f29ed4d18", "doc_id": "hp_59ca239a2da6a609"}]</data>
  <data key="d3">["hp_59ca239a2da6a609"]</data>
  <data key="d4">False</data>
</node>
<node id="Isengrim">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Isengrim is Reynard's main enemy and victim across the cycle, and is Reynard's uncle.", "chunk_id": "8fcb4a5f29ed4d18", "doc_id": "hp_59ca239a2da6a609"}]</data>
  <data key="d2">[{"text": "His main enemy and victim across the cycle is his uncle, the wolf Isengrim (or Ysengrim).", "chunk_id": "8fcb4a5f29ed4d18", "doc_id": "hp_59ca239a2da6a609"}]</data>
  <data key="d3">["hp_59ca239a2da6a609"]</data>
  <data key="d4">False</data>
</node>
<node id="anthropomorphic red fox">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An anthropomorphic red fox and trickster figure who is the main character in a literary cycle of fables.", "chunk_id": "8fcb4a5f29ed4d18", "doc_id": "hp_59ca239a2da6a609"}]</data>
  <data key="d2">[{"text": "Those stories are largely concerned with Reynard, an anthropomorphic red fox and trickster figure.", "chunk_id": "8fcb4a5f29ed4d18", "doc_id": "hp_59ca239a2da6a609"}]</data>
  <data key="d3">["hp_59ca239a2da6a609"]</data>
  <data key="d4">False</data>
</node>
<node id="wolf">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A wolf who is Reynard's main enemy and victim across the cycle, and is Reynard's uncle.", "chunk_id": "8fcb4a5f29ed4d18", "doc_id": "hp_59ca239a2da6a609"}]</data>
  <data key="d2">[{"text": "His main enemy and victim across the cycle is his uncle, the wolf Isengrim (or Ysengrim).", "chunk_id": "8fcb4a5f29ed4d18", "doc_id": "hp_59ca239a2da6a609"}]</data>
  <data key="d3">["hp_59ca239a2da6a609"]</data>
  <data key="d4">False</data>
</node>
<node id="Running">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A song by the alternative rock band Evermore.", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb"}]</data>
  <data key="d2">[{"text": "\"Running\" is the lead single by alternative rock band Evermore, taken from their second studio album, \"Real Life\" (July 2006).", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb"}]</data>
  <data key="d3">["hp_5a1e23a825efe5cb"]</data>
  <data key="d4">False</data>
</node>
<node id="Real Life">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The second studio album by the alternative rock band Evermore.", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb"}, {"text": "Real Life is the second studio album by Evermore.", "chunk_id": "d4c212cc890b725d", "doc_id": "hp_b314ee58b364424a"}]</data>
  <data key="d2">[{"text": "\"Running\" is the lead single by alternative rock band Evermore, taken from their second studio album, \"Real Life\" (July 2006).", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb"}, {"text": "\"Light Surrounding You\" is the second single by alternative rock band, Evermore, taken from their second studio album, \"Real Life\" (June 2006).", "chunk_id": "d4c212cc890b725d", "doc_id": "hp_b314ee58b364424a"}]</data>
  <data key="d3">["hp_5a1e23a825efe5cb", "hp_b314ee58b364424a"]</data>
  <data key="d4">False</data>
</node>
<node id="Jon">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A co-producer of the song \"Running\".", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb"}]</data>
  <data key="d2">[{"text": "It was co-produced by Jon with John Alagía (Dave Matthews Band, John Mayer).", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb"}]</data>
  <data key="d3">["hp_5a1e23a825efe5cb"]</data>
  <data key="d4">False</data>
</node>
<node id="John Alagía">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A co-producer of the song \"Running\".", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb"}]</data>
  <data key="d2">[{"text": "It was co-produced by Jon with John Alagía (Dave Matthews Band, John Mayer).", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb"}]</data>
  <data key="d3">["hp_5a1e23a825efe5cb"]</data>
  <data key="d4">False</data>
</node>
