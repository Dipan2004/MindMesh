<node id="Neo Software">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Neo Software was founded on 4 January 1993 by Hannes Seifert and Niki Laber.", "chunk_id": "0cc52c6f4ba06192", "doc_id": "hp_034d7f4890c999d2"}]</data>
  <data key="d2">[{"text": "Neo Software was founded on 4 January 1993 by Hannes Seifert and Niki Laber, and was acquired by Take-Two Interactive in February 2001.", "chunk_id": "0cc52c6f4ba06192", "doc_id": "hp_034d7f4890c999d2"}]</data>
  <data key="d3">["hp_034d7f4890c999d2"]</data>
  <data key="d4">False</data>
</node>
<node id="Hannes Seifert">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Hannes Seifert was a founder of Neo Software and a former employee of Rockstar Vienna.", "chunk_id": "0cc52c6f4ba06192", "doc_id": "hp_034d7f4890c999d2"}]</data>
  <data key="d2">[{"text": "Neo Software was founded on 4 January 1993 by Hannes Seifert and Niki Laber, and was acquired by Take-Two Interactive in February 2001.", "chunk_id": "0cc52c6f4ba06192", "doc_id": "hp_034d7f4890c999d2"}]</data>
