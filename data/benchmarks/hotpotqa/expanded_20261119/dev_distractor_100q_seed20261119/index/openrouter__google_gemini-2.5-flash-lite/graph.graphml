<node id="Lincolnshire">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Lincolnshire is a county in England.", "chunk_id": "7547e33be5d5dab0", "doc_id": "hp_334151f118143081"}, {"text": "Lincolnshire is a county in England where Gibraltar Point national nature reserve is located.", "chunk_id": "a241395280ad7f2b", "doc_id": "hp_d424c14b2a283420"}]</data>
  <data key="d2">[{"text": "Seacroft is a linear settlement in the East Lindsey district of Lincolnshire, England.", "chunk_id": "7547e33be5d5dab0", "doc_id": "hp_334151f118143081"}, {"text": "Gibraltar Point national nature reserve is an area of approximately 4.3 km2 in Lincolnshire, England.", "chunk_id": "a241395280ad7f2b", "doc_id": "hp_d424c14b2a283420"}]</data>
