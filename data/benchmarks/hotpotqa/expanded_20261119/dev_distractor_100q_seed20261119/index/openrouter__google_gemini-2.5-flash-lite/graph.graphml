  <data key="d5">["WROTE"]</data>
  <data key="d6">Francis McPeake 1st wrote the song "Wild Mountain Thyme" for his wife.</data>
  <data key="d7">[{"text": "\"Wild Mountain Thyme\" (also known as \"Purple Heather\" and \"Will Ye Go, Lassie, Go?\") is a Scottish folk song that was collected by Francis McPeake 1st, who wrote the song himself for his wife.", "chunk_id": "1fcb72fd1832f8a4", "doc_id": "hp_7778e88209c46514", "type": "WROTE"}]</data>
