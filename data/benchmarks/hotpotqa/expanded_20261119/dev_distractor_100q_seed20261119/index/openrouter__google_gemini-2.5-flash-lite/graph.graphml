<edge source="North Irvington Gardens Historic District" target="Indianapolis">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">The North Irvington Gardens Historic District is located in Indianapolis.</data>
  <data key="d7">[{"text": "The North Irvington Gardens Historic District is a neighborhood and national historic district in Indianapolis, Indiana.", "chunk_id": "0c32c75514abc0dc", "doc_id": "hp_53c0688141ca0284", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_53c0688141ca0284</data>
