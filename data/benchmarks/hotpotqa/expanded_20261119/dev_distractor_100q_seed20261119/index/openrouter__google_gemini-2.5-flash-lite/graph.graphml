  <data key="d2">[{"text": "Thomas was previously athletic director at the University of Illinois from 2011-2015, University of Cincinnati from 2005-2011, and the University of Akron from 2000-2005.", "chunk_id": "304723baf35bd7c6", "doc_id": "hp_395f74d5c0c36b8a"}]</data>
