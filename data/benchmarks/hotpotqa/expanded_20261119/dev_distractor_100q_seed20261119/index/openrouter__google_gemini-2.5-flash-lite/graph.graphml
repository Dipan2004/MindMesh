<node id="Ogier the Dane">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Ogier the Dane is a legendary character who first appears in an Old French chanson de geste.", "chunk_id": "707fa67e1952a89d", "doc_id": "hp_0ab939b45e2f3fdb"}, {"text": "Ogier the Dane is a legendary character appearing in medieval chansons de geste.", "chunk_id": "b3a9c00150a552e2", "doc_id": "hp_b4f3b2a3a6af0d4a"}]</data>
  <data key="d2">[{"text": "Ogier the Dane (French: \"Ogier le Danois\" or archaically \"Ogier de Danemarche\", Danish: \"Holger Danske\") is a legendary character who first appears in an Old French \"chanson de geste\", in the cycle of poems \"Geste de Doon de Mayence\".", "chunk_id": "707fa67e1952a89d", "doc_id": "hp_0ab939b45e2f3fdb"}, {"text": "Holger Danske, or Ogier the Dane, is a legendary character appearing in medieval chansons de geste.", "chunk_id": "b3a9c00150a552e2", "doc_id": "hp_b4f3b2a3a6af0d4a"}]</data>
  <data key="d3">["hp_0ab939b45e2f3fdb", "hp_b4f3b2a3a6af0d4a"]</data>
  <data key="d4">False</data>
</node>
<node id="Ogier le Danois">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Ogier le Danois is the French name for the legendary character Ogier the Dane.", "chunk_id": "707fa67e1952a89d", "doc_id": "hp_0ab939b45e2f3fdb"}]</data>
  <data key="d2">[{"text": "Ogier the Dane (French: \"Ogier le Danois\" or archaically \"Ogier de Danemarche\", Danish: \"Holger Danske\") is a legendary character who first appears in an Old French \"chanson de geste\", in the cycle of poems \"Geste de Doon de Mayence\".", "chunk_id": "707fa67e1952a89d", "doc_id": "hp_0ab939b45e2f3fdb"}]</data>
  <data key="d3">["hp_0ab939b45e2f3fdb"]</data>
