<edge source="Dime novel" target="quick-written, lurid potboilers">
  <data key="d5">["REFERRED_TO_AS"]</data>
  <data key="d6">In the modern age, the term "dime novel" has been used to refer to quickly written, lurid potboilers.</data>
  <data key="d7">[{"text": "In the modern age, the term \"dime novel\" has been used to refer to quickly written, lurid potboilers, usually as a pejorative to describe a sensationalized but superficial literary work.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf", "type": "REFERRED_TO_AS"}]</data>
