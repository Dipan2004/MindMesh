  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Hammerbox is a Seattle underground band.", "chunk_id": "0d888cee944dc2cb", "doc_id": "hp_2afa90f7ec34b459"}, {"text": "Hammerbox was a band formerly associated with Carrie Akre.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
  <data key="d2">[{"text": "Carrie Akre (born September 24, 1966) is an American musician best known for her work with Seattle underground bands Hammerbox and Goodness.", "chunk_id": "0d888cee944dc2cb", "doc_id": "hp_2afa90f7ec34b459"}, {"text": "Goodness was an American rock band from Seattle, Washington, led by Carrie Akre, formerly of Hammerbox and now primarily a solo artist.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
  <data key="d3">["hp_2afa90f7ec34b459", "hp_cf04d33334830067"]</data>
  <data key="d4">False</data>
</node>
<node id="Dregea">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Dregea is a genus of vines in the Apocynaceae.", "chunk_id": "b434d13cc8863180", "doc_id": "hp_2b52b5ab8c2b4e73"}]</data>
  <data key="d2">[{"text": "Dregea is a genus of vines in the Apocynaceae, first described as a genus with this name in 1838.", "chunk_id": "b434d13cc8863180", "doc_id": "hp_2b52b5ab8c2b4e73"}]</data>
  <data key="d3">["hp_2b52b5ab8c2b4e73"]</data>
  <data key="d4">False</data>
</node>
<node id="southern Asia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Southern Asia is a region of the Asian continent.", "chunk_id": "b434d13cc8863180", "doc_id": "hp_2b52b5ab8c2b4e73"}]</data>
  <data key="d2">[{"text": "It is native to Africa and southern Asia.", "chunk_id": "b434d13cc8863180", "doc_id": "hp_2b52b5ab8c2b4e73"}]</data>
  <data key="d3">["hp_2b52b5ab8c2b4e73"]</data>
  <data key="d4">False</data>
</node>
<node id="Singha Durbar">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Singha Durbar is a palace in Nepal.", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d2">[{"text": "Singha Durbar", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d3">["hp_2bdac4251efc5b9b"]</data>
  <data key="d4">False</data>
</node>
<node id="Shumsher">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Shumsher was a Prime Minister who built Singha Durbar.", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d2">[{"text": "It was built by Shumsher immediately after accession to the post of Prime Minister.", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d3">["hp_2bdac4251efc5b9b"]</data>
  <data key="d4">False</data>
</node>
<node id="Government of Nepal">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Government of Nepal purchased Singha Durbar from Shumsher.", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d2">[{"text": "Immediately after construction Shumsher sold this property to the Government of Nepal for 20 million Nepali rupee as the official residence of Prime minister.", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d3">["hp_2bdac4251efc5b9b"]</data>
  <data key="d4">False</data>
</node>
<node id="Padma Shumsher JBR">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Padma Shumsher JBR was a Prime Minister of the Rana dynasty who did not live in Singha Durbar.", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d2">[{"text": "The last Rana Prime minister to occupy Singha Durbar was Mohan Shumsher JBR.", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d3">["hp_2bdac4251efc5b9b"]</data>
  <data key="d4">False</data>
</node>
<node id="Bishalnagar Durbar">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Bishalnagar Durbar was the private residence of Padma Shumsher JBR.", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d2">[{"text": "The last Rana Prime minister to occupy Singha Durbar was Mohan Shumsher JBR.", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d3">["hp_2bdac4251efc5b9b"]</data>
  <data key="d4">False</data>
</node>
<node id="Mohan Shumsher JBR">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Mohan Shumsher JBR was the last Rana Prime Minister to occupy Singha Durbar.", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d2">[{"text": "The last Rana Prime minister to occupy Singha Durbar was Mohan Shumsher JBR.", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d3">["hp_2bdac4251efc5b9b"]</data>
  <data key="d4">False</data>
</node>
<node id="Rana Dynasty">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Rana Dynasty was a ruling dynasty in Nepal.", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d2">[{"text": "After his death in 1929, it was used as the official residence of prime ministers of Rana dynasty except Padma Shumsher JBR, who lived in his own Bishalnagar Durbar.", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d3">["hp_2bdac4251efc5b9b"]</data>
  <data key="d4">False</data>
</node>
<node id="His Majesty's Government">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "His Majesty's Government ordered Mohan Shumsher JBR to leave Singha Durbar.", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d2">[{"text": "Even after the fall of Rana Dynasty in 1951, Mohan used this place, but in 1953 he was ordered by His Majesty's Government to leave the palace which became a National Property.", "chunk_id": "d825b9ccce2e950e", "doc_id": "hp_2bdac4251efc5b9b"}]</data>
  <data key="d3">["hp_2bdac4251efc5b9b"]</data>
  <data key="d4">False</data>
</node>
<node id="United States v. Nixon">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A landmark United States Supreme Court decision that ordered President Richard Nixon to deliver presidential tape recordings and other subpoenaed materials to the District Court.", "chunk_id": "2d33ed84f83873de", "doc_id": "hp_2c019fb6db7dcbec"}]</data>
  <data key="d2">[{"text": "United States v. Nixon, 418 U.S. 683 (1974), was a landmark United States Supreme Court decision which resulted in a unanimous 8–0 ruling against President Richard Nixon, ordering him to deliver presidential tape recordings and other subpoenaed materials to the District Court.", "chunk_id": "2d33ed84f83873de", "doc_id": "hp_2c019fb6db7dcbec"}]</data>
  <data key="d3">["hp_2c019fb6db7dcbec"]</data>
  <data key="d4">False</data>
</node>
<node id="Richard Nixon">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The President of the United States during the time of the Watergate scandal and the United States v. Nixon Supreme Court case.", "chunk_id": "2d33ed84f83873de", "doc_id": "hp_2c019fb6db7dcbec"}, {"text": "Richard Nixon was a former President.", "chunk_id": "e30c7d10b2ec1fb2", "doc_id": "hp_48543c32e5e1a23b"}, {"text": "The employer of H.R. Haldeman, who referred to himself as 'Richard Nixon's son of a bitch'.", "chunk_id": "d0b1e443837cd70f", "doc_id": "hp_5042be17d44308ee"}, {"text": "President of the United States who received the Zilch memo and described the bombing campaign as a failure.", "chunk_id": "51c2cb97c1a1900f", "doc_id": "hp_7681eb8af0f9cd50"}, {"text": "Richard Nixon was a politician whose secretary was Rose Mary Woods.", "chunk_id": "7a98a826c469ba66", "doc_id": "hp_866e1a0ee1799d1f"}, {"text": "Republican President who had the task of selecting a new vice president in 1973.", "chunk_id": "54142f25de20997e", "doc_id": "hp_adfdee30bf450e7d"}, {"text": "Richard Nixon was an American politician who served as the 37th president of the United States.", "chunk_id": "17e54dbd5dd980bc", "doc_id": "hp_cdb59476dc4f3e8a"}, {"text": "The President whose resignation was allegedly affected by John H. Meier.", "chunk_id": "922d12307dca0bd3", "doc_id": "hp_d491b739e827ef2c"}]</data>
  <data key="d2">[{"text": "United States v. Nixon, 418 U.S. 683 (1974), was a landmark United States Supreme Court decision which resulted in a unanimous 8–0 ruling against President Richard Nixon, ordering him to deliver presidential tape recordings and other subpoenaed materials to the District Court.", "chunk_id": "2d33ed84f83873de", "doc_id": "hp_2c019fb6db7dcbec"}, {"text": "He is the nephew of former President Richard Nixon and the son of Richard Nixon's brother, Donald Nixon and Clara Jane.", "chunk_id": "e30c7d10b2ec1fb2", "doc_id": "hp_48543c32e5e1a23b"}, {"text": "Charles Colson was known as a hatchet man for President Richard Nixon, as was H.R. Haldeman, who proudly described himself as \"Richard Nixon's 'son of a bitch'\".", "chunk_id": "d0b1e443837cd70f", "doc_id": "hp_5042be17d44308ee"}, {"text": "A memorandum known as the Zilch memo was an American government document sent by National Security Advisor Henry Kissinger to President Richard Nixon on January 3, 1972, about the military situation in Laos during the Vietnam War.", "chunk_id": "51c2cb97c1a1900f", "doc_id": "hp_7681eb8af0f9cd50"}, {"text": "Rose Mary Woods (December 26, 1917 – January 22, 2005) was Richard Nixon's secretary from his days in Congress in 1951, through the end of his political career.", "chunk_id": "7a98a826c469ba66", "doc_id": "hp_866e1a0ee1799d1f"}, {"text": "Republican President Richard Nixon thus had the task of selecting a vice president who could receive the majority support of both houses of Congress.", "chunk_id": "54142f25de20997e", "doc_id": "hp_adfdee30bf450e7d"}, {"text": "Walker served in the administration of President Richard Nixon, first as the first Director of the White House Office of Presidential Advance, and later as Director of the National Park Service (1972–1975).", "chunk_id": "17e54dbd5dd980bc", "doc_id": "hp_cdb59476dc4f3e8a"}, {"text": "The book argues that Meier was one of the people who played a role in affecting President Richard Nixon's resignation in the wake of the Watergate scandal.", "chunk_id": "922d12307dca0bd3", "doc_id": "hp_d491b739e827ef2c"}]</data>
  <data key="d3">["hp_2c019fb6db7dcbec", "hp_48543c32e5e1a23b", "hp_5042be17d44308ee", "hp_7681eb8af0f9cd50", "hp_866e1a0ee1799d1f", "hp_adfdee30bf450e7d", "hp_cdb59476dc4f3e8a", "hp_d491b739e827ef2c"]</data>
  <data key="d4">False</data>
</node>
<node id="District Court">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The court to which President Richard Nixon was ordered to deliver presidential tape recordings and other subpoenaed materials.", "chunk_id": "2d33ed84f83873de", "doc_id": "hp_2c019fb6db7dcbec"}]</data>
  <data key="d2">[{"text": "United States v. Nixon, 418 U.S. 683 (1974), was a landmark United States Supreme Court decision which resulted in a unanimous 8–0 ruling against President Richard Nixon, ordering him to deliver presidential tape recordings and other subpoenaed materials to the District Court.", "chunk_id": "2d33ed84f83873de", "doc_id": "hp_2c019fb6db7dcbec"}]</data>
  <data key="d3">["hp_2c019fb6db7dcbec"]</data>
  <data key="d4">False</data>
</node>
<node id="Watergate scandal">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A major political scandal in the United States involving the administration of President Richard Nixon.", "chunk_id": "2d33ed84f83873de", "doc_id": "hp_2c019fb6db7dcbec"}, {"text": "A political scandal in the United States involving an administration's illegal activities.", "chunk_id": "d0b1e443837cd70f", "doc_id": "hp_5042be17d44308ee"}, {"text": "A major political scandal in the United States that led to President Nixon's resignation.", "chunk_id": "54142f25de20997e", "doc_id": "hp_adfdee30bf450e7d"}, {"text": "A scandal that led to President Richard Nixon's resignation.", "chunk_id": "922d12307dca0bd3", "doc_id": "hp_d491b739e827ef2c"}]</data>
  <data key="d2">[{"text": "Issued on July 24, 1974, the ruling was important to the late stages of the Watergate scandal, when there was an ongoing impeachment process against Richard Nixon.", "chunk_id": "2d33ed84f83873de", "doc_id": "hp_2c019fb6db7dcbec"}, {"text": "In the context of the Watergate scandal, the term hatchet man was used to refer to a trusted and particularly orthodox subordinate tasked by his employer with destroying a political opponent by any means necessary.", "chunk_id": "d0b1e443837cd70f", "doc_id": "hp_5042be17d44308ee"}, {"text": "In 1974, Ford ascended to the presidency after the Watergate scandal led to the resignation of President Nixon.", "chunk_id": "54142f25de20997e", "doc_id": "hp_adfdee30bf450e7d"}, {"text": "The book argues that Meier was one of the people who played a role in affecting President Richard Nixon's resignation in the wake of the Watergate scandal.", "chunk_id": "922d12307dca0bd3", "doc_id": "hp_d491b739e827ef2c"}]</data>
  <data key="d3">["hp_2c019fb6db7dcbec", "hp_5042be17d44308ee", "hp_adfdee30bf450e7d", "hp_d491b739e827ef2c"]</data>
  <data key="d4">False</data>
</node>
<node id="executive privilege">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The privilege claimed by the President and other members of the executive branch of government to withhold information in their possession from the other branches of government.", "chunk_id": "2d33ed84f83873de", "doc_id": "hp_2c019fb6db7dcbec"}]</data>
  <data key="d2">[{"text": "\"United States v. Nixon\" is considered a crucial precedent limiting the power of any U.S. president to claim executive privilege.", "chunk_id": "2d33ed84f83873de", "doc_id": "hp_2c019fb6db7dcbec"}]</data>
  <data key="d3">["hp_2c019fb6db7dcbec"]</data>
  <data key="d4">False</data>
</node>
<node id="Liriodendron tulipifera">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Liriodendron tulipifera is a species of flowering tree known by several common names including tulip tree, American tulip tree, tuliptree, tulip poplar, whitewood, fiddletree, and yellow-poplar.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}, {"text": "Liriodendron tulipifera is a plant from which Phytophthora kernoviae has been isolated.", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}, {"text": "A species of tree, also known as the American tulip tree, often associated with Morchella ulmaria.", "chunk_id": "90e3a51e13c6358a", "doc_id": "hp_a1c843f7fa58c1d3"}]</data>
  <data key="d2">[{"text": "Liriodendron tulipifera—known as the tulip tree, American tulip tree, tuliptree, tulip poplar, whitewood, fiddletree, and yellow-poplar—is the Western Hemisphere representative of the two-species genus \"Liriodendron,\" and the tallest eastern hardwood.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}, {"text": "It has also been isolated from \"Quercus robur\" and \"Liriodendron tulipifera\".", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}, {"text": "The species occurs in the forests of Midwestern North America, often associated with white ash (\"Fraxinus americana\"), the American tulip tree (\"Liriodendron tulipifera\") or species of maple or elm.", "chunk_id": "90e3a51e13c6358a", "doc_id": "hp_a1c843f7fa58c1d3"}]</data>
  <data key="d3">["hp_2c1beb2f73cca8d4", "hp_7b90b80a57936da9", "hp_a1c843f7fa58c1d3"]</data>
  <data key="d4">False</data>
</node>
<node id="tulip tree">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The tulip tree is another name for Liriodendron tulipifera.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}]</data>
  <data key="d2">[{"text": "Liriodendron tulipifera—known as the tulip tree, American tulip tree, tuliptree, tulip poplar, whitewood, fiddletree, and yellow-poplar—is the Western Hemisphere representative of the two-species genus \"Liriodendron,\" and the tallest eastern hardwood.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}]</data>
