  <data key="d5">["PARTICIPATED_IN"]</data>
  <data key="d6">Michael Jackson was involved in the concert film "Michael Jackson's This Is It".</data>
  <data key="d7">[{"text": "\"This Is It\" was released to coincide with the theatrical release of \"Michael Jackson's This Is It\", a concert film documenting Michael Jackson's rehearsals for the This Is It concert series at London's O2 Arena.", "chunk_id": "f1142eb95496f6b8", "doc_id": "hp_19aa948e90d5a7f6", "type": "PARTICIPATED_IN"}]</data>
