<node id="feminism">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Feminism is envisioned by Karp as a movement that can work across disciplinary boundaries and be informed by various traditions of inquiry.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}]</data>
  <data key="d2">[{"text": "Karp envisions feminism as a movement that can work across disciplinary boundaries and be informed by various traditions of inquiry.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}]</data>
  <data key="d3">["hp_65a971e7a10d79c8"]</data>
  <data key="d4">False</data>
</node>
<node id="psychoanalysis">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Psychoanalysis is a field of study that has informed Karp's work.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}]</data>
  <data key="d2">[{"text": "Her work has been informed by her lifelong study of psychoanalysis.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}]</data>
  <data key="d3">["hp_65a971e7a10d79c8"]</data>
  <data key="d4">False</data>
</node>
<node id="On the Issues Magazine">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "On the Issues Magazine is a publication where Karp's paintings appeared.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}]</data>
  <data key="d2">[{"text": "Paintings of Karp's appeared in the November/December 2008 issue of \"Tikkun\" magazine and by the \"Tikkun\" editor's August 2009 online blog and in the spring 2012 issue of \"On the Issues\" Magazine.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}]</data>
  <data key="d3">["hp_65a971e7a10d79c8"]</data>
  <data key="d4">False</data>
</node>
<node id="Everhart Museum">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Everhart Museum is a museum where Barrie Karp had a one-person exhibition.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}]</data>
  <data key="d2">[{"text": "In 1988, she had a one-person exhibition at the Everhart Museum in Scranton, Pennsylvania.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}]</data>
  <data key="d3">["hp_65a971e7a10d79c8"]</data>
  <data key="d4">False</data>
</node>
<node id="Dregea volubilis">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Dregea volubilis is a species of plant in the Apocynaceae family.", "chunk_id": "578db93c2087665a", "doc_id": "hp_65e5dd7a12e038cc"}]</data>
  <data key="d2">[{"text": "Dregea volubilis is a species of plant in the Apocynaceae family that is native to India.", "chunk_id": "578db93c2087665a", "doc_id": "hp_65e5dd7a12e038cc"}]</data>
  <data key="d3">["hp_65e5dd7a12e038cc"]</data>
  <data key="d4">False</data>
</node>
<node id="Zeltnera">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Zeltnera is a genus of flowering plants in the gentian family.", "chunk_id": "8be93ea5f19db826", "doc_id": "hp_662cb87fc39342e0"}]</data>
  <data key="d2">[{"text": "Zeltnera is a genus of flowering plants in the gentian family.", "chunk_id": "8be93ea5f19db826", "doc_id": "hp_662cb87fc39342e0"}]</data>
  <data key="d3">["hp_662cb87fc39342e0"]</data>
  <data key="d4">False</data>
</node>
<node id="gentian family">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The gentian family is a family of flowering plants.", "chunk_id": "8be93ea5f19db826", "doc_id": "hp_662cb87fc39342e0"}]</data>
  <data key="d2">[{"text": "Zeltnera is a genus of flowering plants in the gentian family.", "chunk_id": "8be93ea5f19db826", "doc_id": "hp_662cb87fc39342e0"}]</data>
  <data key="d3">["hp_662cb87fc39342e0"]</data>
  <data key="d4">False</data>
</node>
<node id="Centaurium">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Centaurium is a genus of plants, also known as the centauries.", "chunk_id": "8be93ea5f19db826", "doc_id": "hp_662cb87fc39342e0"}]</data>
  <data key="d2">[{"text": "It was erected in 2004 when the genus \"Centaurium\" (the centauries) was split.", "chunk_id": "8be93ea5f19db826", "doc_id": "hp_662cb87fc39342e0"}]</data>
  <data key="d3">["hp_662cb87fc39342e0"]</data>
  <data key="d4">False</data>
</node>
<node id="centauries">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Centauries are plants belonging to the genus Centaurium.", "chunk_id": "8be93ea5f19db826", "doc_id": "hp_662cb87fc39342e0"}]</data>
  <data key="d2">[{"text": "It was erected in 2004 when the genus \"Centaurium\" (the centauries) was split.", "chunk_id": "8be93ea5f19db826", "doc_id": "hp_662cb87fc39342e0"}]</data>
  <data key="d3">["hp_662cb87fc39342e0"]</data>
  <data key="d4">False</data>
</node>
<node id="Gyrandra">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Gyrandra is a genus of plants that includes Mexican species previously in Centaurium.", "chunk_id": "8be93ea5f19db826", "doc_id": "hp_662cb87fc39342e0"}]</data>
  <data key="d2">[{"text": "The Mexican species now belong to genus \"Gyrandra\", and the Mediterranean and Australian plants are in genus \"Schenkia\".", "chunk_id": "8be93ea5f19db826", "doc_id": "hp_662cb87fc39342e0"}]</data>
  <data key="d3">["hp_662cb87fc39342e0"]</data>
  <data key="d4">False</data>
</node>
<node id="Schenkia">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Schenkia is a genus of plants that includes Mediterranean and Australian species previously in Centaurium.", "chunk_id": "8be93ea5f19db826", "doc_id": "hp_662cb87fc39342e0"}]</data>
  <data key="d2">[{"text": "The Mexican species now belong to genus \"Gyrandra\", and the Mediterranean and Australian plants are in genus \"Schenkia\".", "chunk_id": "8be93ea5f19db826", "doc_id": "hp_662cb87fc39342e0"}]</data>
  <data key="d3">["hp_662cb87fc39342e0"]</data>
  <data key="d4">False</data>
</node>
<node id="William de Ropp">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "William de Ropp was a British agent involved in dealings with Nazi Germany before and during the Second World War.", "chunk_id": "c718da7aed95bfa4", "doc_id": "hp_6693cb8c76cc99b6"}]</data>
  <data key="d2">[{"text": "Baron William Sylvester de Ropp, originally Sylvester Wilhelm Gotthard von der Ropp (12 December 1886 - 1973 ) was a British agent involved in dealings with Nazi Germany before and during the Second World War.", "chunk_id": "c718da7aed95bfa4", "doc_id": "hp_6693cb8c76cc99b6"}]</data>
  <data key="d3">["hp_6693cb8c76cc99b6"]</data>
