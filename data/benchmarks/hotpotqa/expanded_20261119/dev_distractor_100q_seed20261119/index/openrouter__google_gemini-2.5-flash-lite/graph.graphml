  <data key="d7">[{"text": "The battle was fought between the 27th British Commonwealth Brigade and the North Korean 239th Regiment which was encircled east of Yongju, where it was attacking the US 187th Airborne Regimental Combat Team (US 187 RCT).", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc", "type": "ENCIRCLED_EAST_OF"}]</data>
  <data key="d8">hp_c1f8f58c74899fbc</data>
</edge>
