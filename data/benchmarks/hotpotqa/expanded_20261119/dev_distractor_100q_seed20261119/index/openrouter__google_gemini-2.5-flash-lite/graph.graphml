  <data key="d5">["PART_OF"]</data>
  <data key="d6">The song 'Hot Girls' was intended for the album 'Syndicated: The Lil' Mo Hour'.</data>
  <data key="d7">[{"text": "\"Hot Girls,\" also known as its alternate title \"Hot Boys, Hot Girls,\" is song recorded by American recording artist Lil' Mo for her unreleased album, \"Syndicated: The Lil' Mo Hour\" (2005).", "chunk_id": "4fbe89b0d5faec6f", "doc_id": "hp_233600b46cd7c338", "type": "PART_OF"}]</data>
