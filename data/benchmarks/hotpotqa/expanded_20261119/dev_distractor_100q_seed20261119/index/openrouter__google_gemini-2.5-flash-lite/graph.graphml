<node id="Democratic Party">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Democratic Party is one of the two major contemporary political parties in the United States.", "chunk_id": "e3f12262205bc9b4", "doc_id": "hp_831c6e1412980f7a"}]</data>
  <data key="d2">[{"text": "A member of the Democratic Party, he served as the 21st governor of Oklahoma from 1975 to 1979 and in the United States Senate from 1979 to 1994.", "chunk_id": "e3f12262205bc9b4", "doc_id": "hp_831c6e1412980f7a"}]</data>
