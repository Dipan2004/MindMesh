<node id="Kangpenqing">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Kangpenqing is a mountain in the Baiku Himalayas of Tibet, China.", "chunk_id": "e4b8cfa2e82ef0c0", "doc_id": "hp_3918c7f9f1efe04d"}]</data>
  <data key="d2">[{"text": "Kangpenqing (also Gang Benchhen) is a mountain in the Baiku Himalayas of Tibet, China.", "chunk_id": "e4b8cfa2e82ef0c0", "doc_id": "hp_3918c7f9f1efe04d"}]</data>
  <data key="d3">["hp_3918c7f9f1efe04d"]</data>
  <data key="d4">False</data>
</node>
<node id="Baiku Himalayas">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Baiku Himalayas are a mountain range in Tibet, China.", "chunk_id": "e4b8cfa2e82ef0c0", "doc_id": "hp_3918c7f9f1efe04d"}]</data>
  <data key="d2">[{"text": "Kangpenqing (also Gang Benchhen) is a mountain in the Baiku Himalayas of Tibet, China.", "chunk_id": "e4b8cfa2e82ef0c0", "doc_id": "hp_3918c7f9f1efe04d"}]</data>
  <data key="d3">["hp_3918c7f9f1efe04d"]</data>
  <data key="d4">False</data>
</node>
<node id="7281 m">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "7281 m is the elevation of Kangpenqing.", "chunk_id": "e4b8cfa2e82ef0c0", "doc_id": "hp_3918c7f9f1efe04d"}]</data>
  <data key="d2">[{"text": "At an elevation of 7281 m it is the 90th highest mountain in the world.", "chunk_id": "e4b8cfa2e82ef0c0", "doc_id": "hp_3918c7f9f1efe04d"}]</data>
  <data key="d3">["hp_3918c7f9f1efe04d"]</data>
  <data key="d4">False</data>
</node>
