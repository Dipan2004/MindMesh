<node id="TT motorcycle race">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A motorcycle race that served as the filming location for the movie 'No Limit'.", "chunk_id": "9243d3da01ac4911", "doc_id": "hp_4fd72be01c14fbaf"}]</data>
  <data key="d2">[{"text": "The film, which was directed by Monty Banks, was made on location at the TT motorcycle race on the Isle of Man.", "chunk_id": "9243d3da01ac4911", "doc_id": "hp_4fd72be01c14fbaf"}]</data>
  <data key="d3">["hp_4fd72be01c14fbaf"]</data>
