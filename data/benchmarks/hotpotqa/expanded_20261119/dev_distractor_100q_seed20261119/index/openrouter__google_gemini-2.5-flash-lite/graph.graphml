  <data key="d1">[{"text": "Euryops is a genus to which Euryops chrysanthemoides was moved.", "chunk_id": "402abfe881c67ee7", "doc_id": "hp_2c7ea4fcf64b2cee"}]</data>
  <data key="d2">[{"text": "The species was moved to \"Euryops\" from the genus \"Gamolepis\" on the basis of chromosome counts.", "chunk_id": "402abfe881c67ee7", "doc_id": "hp_2c7ea4fcf64b2cee"}]</data>
