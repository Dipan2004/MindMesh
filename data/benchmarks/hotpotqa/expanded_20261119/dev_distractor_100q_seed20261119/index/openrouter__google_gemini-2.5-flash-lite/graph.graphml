<node id="Relativism">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Relativism is the idea that views are relative to differences in perception and consideration.", "chunk_id": "2f5ba414c03fa6f6", "doc_id": "hp_b2d28f54786ad1eb"}]</data>
  <data key="d2">[{"text": "Relativism is the idea that views are relative to differences in perception and consideration.", "chunk_id": "2f5ba414c03fa6f6", "doc_id": "hp_b2d28f54786ad1eb"}]</data>
  <data key="d3">["hp_b2d28f54786ad1eb"]</data>
  <data key="d4">False</data>
</node>
<node id="universal, objective truth">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "According to relativism, there is no universal, objective truth.", "chunk_id": "2f5ba414c03fa6f6", "doc_id": "hp_b2d28f54786ad1eb"}]</data>
  <data key="d2">[{"text": "There is no universal, objective truth according to relativism; rather each point of view has its own truth.", "chunk_id": "2f5ba414c03fa6f6", "doc_id": "hp_b2d28f54786ad1eb"}]</data>
  <data key="d3">["hp_b2d28f54786ad1eb"]</data>
  <data key="d4">False</data>
</node>
