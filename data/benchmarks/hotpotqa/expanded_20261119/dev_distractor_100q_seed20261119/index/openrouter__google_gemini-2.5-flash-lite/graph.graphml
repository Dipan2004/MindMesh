<node id="Moor Allerton">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Moor Allerton is a location where Godwin Birchenough served as Vicar.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d2">[{"text": "Birchenough was ordained in 1905 and was Vicar of Moor Allerton between 1913 and 1921.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d3">["hp_b4ae5293eb8657fc"]</data>
  <data key="d4">False</data>
</node>
<node id="Ripon Cathedral">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Ripon Cathedral is a cathedral where Godwin Birchenough became Dean.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d2">[{"text": "He became an honorary Canon of Chelmsford Cathedral in 1933 and in 1941 became Dean of Ripon Cathedral, becoming Dean Emeritus in 1951.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d3">["hp_b4ae5293eb8657fc"]</data>
  <data key="d4">False</data>
</node>
<node id="Additional Curates Society">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Additional Curates Society is an organization where Godwin Birchenough served as vice chairman.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d2">[{"text": "An eminent author, he was also vice chairman of the Additional Curates Society between 1934 and 1944.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d3">["hp_b4ae5293eb8657fc"]</data>
