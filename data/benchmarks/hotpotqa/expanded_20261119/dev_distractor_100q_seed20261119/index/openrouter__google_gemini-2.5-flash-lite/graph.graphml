  <data key="d2">[{"text": "St Philip's is the third smallest cathedral in England after Derby and Chelmsford.", "chunk_id": "11a5bbb4b1c95f73", "doc_id": "hp_7986a45cdf0624b2"}, {"text": "Chelmsford Cathedral in the city of Chelmsford, Essex, England, is dedicated to St Mary the Virgin, St Peter and St Cedd.", "chunk_id": "a46d15f8c3fc12ac", "doc_id": "hp_c098515d47bb4e6e"}, {"text": "He was then a Canon Residentiary of Chelmsford Cathedral until 1978 when he was appointed Provost of Chelmsford.", "chunk_id": "2d54d3fa9439ab8e", "doc_id": "hp_e808a689dfcac703"}]</data>
