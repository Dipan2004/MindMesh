  <data key="d7">[{"text": "The Hunter is the first EP (and follow up to the 2010 solo album \"The Boxer\") by Kele Okereke (under the professional name Kele), lead singer and rhythm guitarist of the British rock band Bloc Party.", "chunk_id": "145e5d0c1408e198", "doc_id": "hp_e5470b4e6fa8bc35", "type": "RELEASED_BY"}]</data>
