<node id="Royal Ballet">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Royal Ballet is a ballet company based at the Royal Opera House in London.", "chunk_id": "9d00c4570c3c8f48", "doc_id": "hp_945d3839e857ef30"}]</data>
  <data key="d2">[{"text": "He served as the Principal Conductor of the Royal Ballet from 1959 to 1972, Principal Conductor of the Australian Ballet from 1972 to 1977, and Director of the American Ballet Theatre from 1978 to 1980.", "chunk_id": "9d00c4570c3c8f48", "doc_id": "hp_945d3839e857ef30"}]</data>
