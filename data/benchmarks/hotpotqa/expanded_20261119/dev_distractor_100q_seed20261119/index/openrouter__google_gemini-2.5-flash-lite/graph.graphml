  <data key="d1">[{"text": "July 2002 is the release date of the song Starry Eyed Surprise.", "chunk_id": "0e3a5e1368eb79fe", "doc_id": "hp_c1e92b892fa0c36f"}]</data>
  <data key="d2">[{"text": "It was released in July 2002 as the second single from his album \"Bunkka\".", "chunk_id": "0e3a5e1368eb79fe", "doc_id": "hp_c1e92b892fa0c36f"}]</data>
  <data key="d3">["hp_c1e92b892fa0c36f"]</data>
