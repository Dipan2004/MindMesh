<node id="Marshal of England">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Marshal of England is a hereditary office.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}]</data>
  <data key="d2">[{"text": "The Duke of Norfolk is, moreover, the Earl Marshal and hereditary Marshal of England.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}]</data>
  <data key="d3">["hp_c50a06491df52f2d"]</data>
