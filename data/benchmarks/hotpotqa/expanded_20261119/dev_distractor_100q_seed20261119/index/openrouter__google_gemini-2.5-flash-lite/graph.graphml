<node id="State Fair">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A film released in 1962.", "chunk_id": "a4bf6fd9b2b898ee", "doc_id": "hp_09bbc1d69c7ef40f"}]</data>
  <data key="d2">[{"text": "It was the last film Faye made as a major Hollywood star, and she did not make another film until \"State Fair\" (1962).", "chunk_id": "a4bf6fd9b2b898ee", "doc_id": "hp_09bbc1d69c7ef40f"}]</data>
  <data key="d3">["hp_09bbc1d69c7ef40f"]</data>
