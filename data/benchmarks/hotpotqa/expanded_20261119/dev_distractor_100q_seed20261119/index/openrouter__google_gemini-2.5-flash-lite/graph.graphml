<node id="Don't It Make My Brown Eyes Blue">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Crystal Gayle's signature song released in 1977, which brought her crossover pop success.", "chunk_id": "79f2e927bc5b3f09", "doc_id": "hp_3b9acbbdcc47f797"}]</data>
  <data key="d2">[{"text": "Gayle released \"Don't It Make My Brown Eyes Blue\" in 1977 which became her signature song and brought her crossover pop success.", "chunk_id": "79f2e927bc5b3f09", "doc_id": "hp_3b9acbbdcc47f797"}]</data>
  <data key="d3">["hp_3b9acbbdcc47f797"]</data>
  <data key="d4">False</data>
</node>
<node id="Ready for the Times to Get Better">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A number one country single by Crystal Gayle.", "chunk_id": "79f2e927bc5b3f09", "doc_id": "hp_3b9acbbdcc47f797"}]</data>
  <data key="d2">[{"text": "Its success elevated Gayle's career and was followed by three more number one country singles: \"Ready for the Times to Get Better\", \"Why Have You Left the One You Left Me For\", and the top-twenty pop hit \"Talking in Your Sleep\".", "chunk_id": "79f2e927bc5b3f09", "doc_id": "hp_3b9acbbdcc47f797"}]</data>
  <data key="d3">["hp_3b9acbbdcc47f797"]</data>
  <data key="d4">False</data>
</node>
