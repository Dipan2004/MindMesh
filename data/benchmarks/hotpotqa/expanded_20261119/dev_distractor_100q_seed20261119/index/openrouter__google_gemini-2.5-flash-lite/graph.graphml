  <data key="d2">[{"text": "In 2006, Driscoll was found guilty on 2 counts of tax evasion and one count of conspiracy, and was sentenced to serve one year in Federal prison, beginning on March 14, 2007.", "chunk_id": "73ee4754182774e7", "doc_id": "hp_0e12ea58b60d4b89"}]</data>
