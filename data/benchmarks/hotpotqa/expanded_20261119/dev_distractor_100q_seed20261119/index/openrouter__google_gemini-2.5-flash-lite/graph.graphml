<node id="Disney">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Disney is a film production company.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}, {"text": "The production company of the film 'The Strongest Man in the World'.", "chunk_id": "a3410e8d0b05e170", "doc_id": "hp_eca795c668d02ff7"}]</data>
  <data key="d2">[{"text": "He is best known for his portrayal of Nick Szalinski in the 1989 Disney film, \"Honey, I Shrunk the Kids\", for which he was nominated for a Young Artist Award and a Saturn Award.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}, {"text": "The Strongest Man in the World is a 1975 Disney film starring Kurt Russell, still a student in the fictional Medfield College.", "chunk_id": "a3410e8d0b05e170", "doc_id": "hp_eca795c668d02ff7"}]</data>
