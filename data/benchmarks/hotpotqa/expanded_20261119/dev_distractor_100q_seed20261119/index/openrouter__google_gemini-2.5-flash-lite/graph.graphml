  <data key="d7">[{"text": "Jorge Leal Amado de Faria (] , 10 August 1912 – 6 August 2001) was a Brazilian writer of the modernist school.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c", "type": "IS_A"}]</data>
