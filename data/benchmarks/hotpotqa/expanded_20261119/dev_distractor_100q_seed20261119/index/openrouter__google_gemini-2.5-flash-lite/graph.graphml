  <data key="d1">[{"text": "A major regional shopping centre located in the western suburb of Indooroopilly in the City of Brisbane, Queensland, Australia.", "chunk_id": "2dd066198b3cb968", "doc_id": "hp_079ae3daf7c24649"}, {"text": "A shopping center that includes the Indooroopilly Bus Station as part of it.", "chunk_id": "338a75991da8943e", "doc_id": "hp_3e042ad47b60933e"}]</data>
  <data key="d2">[{"text": "Indooroopilly Shopping Centre (formerly Indooroopilly Shoppingtown) is a major regional shopping centre in the western suburb of Indooroopilly in the City of Brisbane, Queensland, Australia.", "chunk_id": "2dd066198b3cb968", "doc_id": "hp_079ae3daf7c24649"}, {"text": "It is part of the Indooroopilly Shopping Centre and is a major interchange for University of Queensland bus services.", "chunk_id": "338a75991da8943e", "doc_id": "hp_3e042ad47b60933e"}]</data>
  <data key="d3">["hp_079ae3daf7c24649", "hp_3e042ad47b60933e"]</data>
