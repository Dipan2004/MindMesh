  <data key="d7">[{"text": "Boulevard Solitude is a \"Lyrisches Drama \" (lyric drama) or opera in one act by Hans Werner Henze to a German libretto by Grete Weil after the play by Walter Jockisch, in its turn a modern retelling of François Prévost's \"Manon Lescaut\".", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1", "type": "WROTE_LIBRETTO_FOR"}]</data>
