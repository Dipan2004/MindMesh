</node>
<node id="Siege of Leith">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Siege of Leith ended a twelve-year encampment of French troops at Leith.", "chunk_id": "fed038ae0c566b69", "doc_id": "hp_26004159736d7249"}]</data>
  <data key="d2">[{"text": "The Siege of Leith ended a twelve-year encampment of French troops at Leith, the port near Edinburgh, Scotland.", "chunk_id": "fed038ae0c566b69", "doc_id": "hp_26004159736d7249"}]</data>
  <data key="d3">["hp_26004159736d7249"]</data>
  <data key="d4">False</data>
</node>
