<node id="Theaceae">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A family of flowering plants.", "chunk_id": "a5aa45896dba5811", "doc_id": "hp_e59ae7221bb43fd2"}]</data>
  <data key="d2">[{"text": "It is of the genus \"Camellia\" () of flowering plants in the family Theaceae.", "chunk_id": "a5aa45896dba5811", "doc_id": "hp_e59ae7221bb43fd2"}]</data>
  <data key="d3">["hp_e59ae7221bb43fd2"]</data>
