  <data key="d2">[{"text": "At an elevation of 7281 m it is the 90th highest mountain in the world.", "chunk_id": "e4b8cfa2e82ef0c0", "doc_id": "hp_3918c7f9f1efe04d"}]</data>
  <data key="d3">["hp_3918c7f9f1efe04d"]</data>
  <data key="d4">False</data>
</node>
<node id="1982">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "1982 is the year the peak was first climbed.", "chunk_id": "e4b8cfa2e82ef0c0", "doc_id": "hp_3918c7f9f1efe04d"}]</data>
  <data key="d2">[{"text": "The peak was first climbed in 1982.", "chunk_id": "e4b8cfa2e82ef0c0", "doc_id": "hp_3918c7f9f1efe04d"}]</data>
  <data key="d3">["hp_3918c7f9f1efe04d"]</data>
