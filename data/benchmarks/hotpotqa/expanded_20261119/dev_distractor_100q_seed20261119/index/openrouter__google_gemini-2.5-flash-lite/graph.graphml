<edge source="Glasshouse" target="Port Central">
  <data key="d5">["JOINT_VENTURE_WITH"]</data>
  <data key="d6">The Glasshouse project was initially a joint venture with Port Central.</data>
  <data key="d7">[{"text": "The project, initially a joint venture with the management of the neighbouring shopping centre, Port Central, was originally expected to cost the Council A$ 7.3 million.", "chunk_id": "203bcd26d9746ba7", "doc_id": "hp_d399c5634a0f3001", "type": "JOINT_VENTURE_WITH"}]</data>
  <data key="d8">hp_d399c5634a0f3001</data>
