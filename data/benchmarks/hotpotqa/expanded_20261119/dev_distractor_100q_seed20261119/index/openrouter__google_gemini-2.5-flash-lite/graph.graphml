  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city along the route of the Dali-Ruili Railway.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d2">[{"text": "Cities and towns along route include Dali, Yangbi Yi Autonomous County, Yongping County, Baoshan, Mang City (also known as Mangshi or Dehong) and Ruili.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d3">["hp_c90ebb0b4e670d3e"]</data>
  <data key="d4">False</data>
