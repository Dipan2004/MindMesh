<node id="electronica">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Electronica is a genre of music that retains elements of Bloc Party's brand of music.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
  <data key="d2">[{"text": "Their brand of music, whilst rooted in rock, retains elements of other genres such as electronica and house music.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
  <data key="d3">["hp_69c70a8b17b9692e"]</data>
  <data key="d4">False</data>
</node>
<node id="house music">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "House music is a genre of music that retains elements of Bloc Party's brand of music.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
  <data key="d2">[{"text": "Their brand of music, whilst rooted in rock, retains elements of other genres such as electronica and house music.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
  <data key="d3">["hp_69c70a8b17b9692e"]</data>
