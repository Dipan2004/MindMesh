<node id="Marquis de Sade">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "His works partly inspired the film Lunacy.", "chunk_id": "c947b5f039c20a78", "doc_id": "hp_dfa620b8112ac9e5"}]</data>
  <data key="d2">[{"text": "It is also partly inspired by the works of the Marquis de Sade.", "chunk_id": "c947b5f039c20a78", "doc_id": "hp_dfa620b8112ac9e5"}]</data>
  <data key="d3">["hp_dfa620b8112ac9e5"]</data>
