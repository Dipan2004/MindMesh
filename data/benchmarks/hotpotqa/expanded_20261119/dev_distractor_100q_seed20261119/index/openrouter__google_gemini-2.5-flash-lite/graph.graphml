<node id="polio">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A viral disease that can cause paralysis.", "chunk_id": "0c36f0ee21621170", "doc_id": "hp_5f3acaf62e7d41e6"}]</data>
  <data key="d2">[{"text": "Howard Lloyd Bachrach (May 21, 1920 – June 26, 2008) was an American scientist who made research contributions to the understanding of viruses such as foot-and-mouth disease and polio.", "chunk_id": "0c36f0ee21621170", "doc_id": "hp_5f3acaf62e7d41e6"}]</data>
  <data key="d3">["hp_5f3acaf62e7d41e6"]</data>
  <data key="d4">False</data>
</node>
<node id="genetic engineering">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "The direct manipulation of an organism's genes using biotechnology.", "chunk_id": "0c36f0ee21621170", "doc_id": "hp_5f3acaf62e7d41e6"}]</data>
  <data key="d2">[{"text": "Bachrach's work led to the first vaccination developed through genetic engineering techniques.", "chunk_id": "0c36f0ee21621170", "doc_id": "hp_5f3acaf62e7d41e6"}]</data>
  <data key="d3">["hp_5f3acaf62e7d41e6"]</data>
  <data key="d4">False</data>
</node>
<node id="United States Department of Agriculture">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The United States federal executive department responsible for developing and executing federal laws related to farming, forestry, and food.", "chunk_id": "0c36f0ee21621170", "doc_id": "hp_5f3acaf62e7d41e6"}]</data>
  <data key="d2">[{"text": "He worked for the United States Department of Agriculture and was chief scientist at the Plum Island Animal Disease Center.", "chunk_id": "0c36f0ee21621170", "doc_id": "hp_5f3acaf62e7d41e6"}]</data>
  <data key="d3">["hp_5f3acaf62e7d41e6"]</data>
  <data key="d4">False</data>
</node>
<node id="Plum Island Animal Disease Center">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A United States federal research facility dedicated to the study of animal diseases.", "chunk_id": "0c36f0ee21621170", "doc_id": "hp_5f3acaf62e7d41e6"}]</data>
  <data key="d2">[{"text": "He worked for the United States Department of Agriculture and was chief scientist at the Plum Island Animal Disease Center.", "chunk_id": "0c36f0ee21621170", "doc_id": "hp_5f3acaf62e7d41e6"}]</data>
  <data key="d3">["hp_5f3acaf62e7d41e6"]</data>
  <data key="d4">False</data>
</node>
<node id="National Medal of Science">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The highest honor for scientific achievement in the United States.", "chunk_id": "0c36f0ee21621170", "doc_id": "hp_5f3acaf62e7d41e6"}]</data>
  <data key="d2">[{"text": "Bachrach was a recipient of the National Medal of Science and was a member of the National Academy of Sciences.", "chunk_id": "0c36f0ee21621170", "doc_id": "hp_5f3acaf62e7d41e6"}]</data>
  <data key="d3">["hp_5f3acaf62e7d41e6"]</data>
  <data key="d4">False</data>
</node>
<node id="National Academy of Sciences">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A private, non-profit society of distinguished scholars.", "chunk_id": "0c36f0ee21621170", "doc_id": "hp_5f3acaf62e7d41e6"}]</data>
  <data key="d2">[{"text": "Bachrach was a recipient of the National Medal of Science and was a member of the National Academy of Sciences.", "chunk_id": "0c36f0ee21621170", "doc_id": "hp_5f3acaf62e7d41e6"}]</data>
  <data key="d3">["hp_5f3acaf62e7d41e6"]</data>
  <data key="d4">False</data>
</node>
