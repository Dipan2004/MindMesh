<edge source="Fisher School–High Street Historic District" target="Hartford Street">
  <data key="d5">["INTERSECTS"]</data>
  <data key="d6">The historic district extends from just south of its junction with Hartford Street.</data>
  <data key="d7">[{"text": "It includes a relatively short stretch of High Street (Massachusetts Route 109) south of Westwood's commercial heart, extending from just south of its junction with Hartford Street to the cemetery at High and Nahatan Streets.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d", "type": "INTERSECTS"}]</data>
  <data key="d8">hp_cdf4d14bbc02d78d</data>
</edge>
