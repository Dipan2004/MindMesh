  <data key="d7">[{"text": "Volume 1 is the debut studio album by indie super-group BNQT, lead by Eric Pulido (Midlake) with Ben Bridwell (Band of Horses), Alex Kapranos (Franz Ferdinand), Fran Healy (Travis) and Jason Lytle (Grandaddy), backed by the other members of Midlake.", "chunk_id": "f0e4892b3b37bba4", "doc_id": "hp_7cc233817d9e07c7", "type": "PART_OF"}]</data>
