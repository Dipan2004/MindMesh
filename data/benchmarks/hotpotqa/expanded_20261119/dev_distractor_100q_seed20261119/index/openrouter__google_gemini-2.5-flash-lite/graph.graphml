  <data key="d8">hp_cc911f866aa0efaa</data>
</edge>
<edge source="River Farset" target="County Antrim">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">The River Farset is on the County Antrim side of the Lagan.</data>
  <data key="d7">[{"text": "The River Farset is on the County Antrim side of the Lagan and joins the Lagan close to its outflow into Belfast Lough.", "chunk_id": "ffad64e807ea3b1b", "doc_id": "hp_cc911f866aa0efaa", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_cc911f866aa0efaa</data>
</edge>
