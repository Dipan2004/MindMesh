  <data key="d7">[{"text": "With the title track from her third studio album \"True Blue\" (1986), Madonna's impact on MTV and popular music was established when a contest entitled \"Making My Video\", was held to create a music video for the song.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00", "type": "LED_TO_CONTEST"}]</data>
