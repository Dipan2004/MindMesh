</node>
<node id="Individual Speedway Junior European Championship">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Individual Speedway Junior European Championship is an event Kurt Hansen participated in.", "chunk_id": "d6fe74a0006ca3d2", "doc_id": "hp_3ef08a9a31e4463e"}]</data>
  <data key="d2">[{"text": "He was in 1984 Individual Speedway Junior European Championship, 1985 Individual Speedway Junior European Championship and 1993 Individual Speedway World Championship.", "chunk_id": "d6fe74a0006ca3d2", "doc_id": "hp_3ef08a9a31e4463e"}]</data>
  <data key="d3">["hp_3ef08a9a31e4463e"]</data>
  <data key="d4">False</data>
</node>
