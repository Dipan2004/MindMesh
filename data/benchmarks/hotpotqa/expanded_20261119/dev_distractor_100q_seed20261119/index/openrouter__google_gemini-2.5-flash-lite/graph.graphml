  <data key="d7">[{"text": "Notre Dame High School for Girls was founded in 1938 by the Sisters of Notre Dame de Namur and in 2009, was incorporated by the Archdiocese of Chicago, making it part of the St. Ferdinand Parish.", "chunk_id": "e1f93f4fdb5e61f5", "doc_id": "hp_db88fb2791fae586", "type": "INCORPORATED_BY"}]</data>
