  <data key="d2">[{"text": "The Country Girl is a 1954 American drama film directed by George Seaton and starring Bing Crosby, Grace Kelly, and William Holden.", "chunk_id": "0429f47598da120a", "doc_id": "hp_a4ca7ebec626db42"}]</data>
