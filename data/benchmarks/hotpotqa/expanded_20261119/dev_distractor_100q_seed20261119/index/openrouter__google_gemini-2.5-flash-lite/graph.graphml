<node id="Stanford Chaparral">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A humor magazine published by students of Stanford University.", "chunk_id": "6656ba65996693f7", "doc_id": "hp_494b8f24cca0ee94"}, {"text": "The Stanford Chaparral is a campus magazine that featured Vicky Brago-Mitchell.", "chunk_id": "b9e66f096d2d52e7", "doc_id": "hp_a9fead16be02ae83"}, {"text": "The Stanford Chaparral is a publication where Josh Weinstein was editor-in-chief.", "chunk_id": "f450f6caed97e558", "doc_id": "hp_fb680b86915566c0"}]</data>
  <data key="d2">[{"text": "The Stanford Chaparral (also known as the Chappie) is a humor magazine published by students of Stanford University since 1899.", "chunk_id": "6656ba65996693f7", "doc_id": "hp_494b8f24cca0ee94"}, {"text": "In 1967 she was the first American college girl to appear nude in a campus magazine, the Stanford Chaparral (\"Stanford Chaparral\", Spring 1967).", "chunk_id": "b9e66f096d2d52e7", "doc_id": "hp_a9fead16be02ae83"}, {"text": "Weinstein and Bill Oakley became best friends and writing partners at St. Albans High School; Weinstein then attended Stanford University and was editor-in-chief of the \"Stanford Chaparral\".", "chunk_id": "f450f6caed97e558", "doc_id": "hp_fb680b86915566c0"}]</data>
  <data key="d3">["hp_494b8f24cca0ee94", "hp_a9fead16be02ae83", "hp_fb680b86915566c0"]</data>
  <data key="d4">False</data>
</node>
<node id="Chappie">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An alternative name for the Stanford Chaparral humor magazine.", "chunk_id": "6656ba65996693f7", "doc_id": "hp_494b8f24cca0ee94"}]</data>
  <data key="d2">[{"text": "The Stanford Chaparral (also known as the Chappie) is a humor magazine published by students of Stanford University since 1899.", "chunk_id": "6656ba65996693f7", "doc_id": "hp_494b8f24cca0ee94"}]</data>
  <data key="d3">["hp_494b8f24cca0ee94"]</data>
  <data key="d4">False</data>
</node>
<node id="Stanford University">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A university where the Stanford Chaparral is published by its students.", "chunk_id": "6656ba65996693f7", "doc_id": "hp_494b8f24cca0ee94"}, {"text": "A university founded by Leland Stanford.", "chunk_id": "232d1486ef3116d2", "doc_id": "hp_69dbe4380588b108"}, {"text": "The university that owns the land on which Stanford Research Park is located.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}, {"text": "Stanford University is an institution attended by Vicky Brago-Mitchell.", "chunk_id": "b9e66f096d2d52e7", "doc_id": "hp_a9fead16be02ae83"}, {"text": "A university where Daniel C. Goldie played tennis before turning pro.", "chunk_id": "f3bc6bdeb3b7f477", "doc_id": "hp_ce1cd3eb59940b9f"}, {"text": "Stanford University is where Josh Weinstein attended after high school.", "chunk_id": "f450f6caed97e558", "doc_id": "hp_fb680b86915566c0"}]</data>
  <data key="d2">[{"text": "The Stanford Chaparral (also known as the Chappie) is a humor magazine published by students of Stanford University since 1899.", "chunk_id": "6656ba65996693f7", "doc_id": "hp_494b8f24cca0ee94"}, {"text": "Thomas Welton Stanford (1832 - 1918), also known as Welton Stanford, was an American-born Australian businessman, spiritualist and philanthropist, most notably toward Stanford University, which was founded by his older brother Leland Stanford.", "chunk_id": "232d1486ef3116d2", "doc_id": "hp_69dbe4380588b108"}, {"text": "Stanford Research Park is a technology park located in Palo Alto, California on land owned by Stanford University.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}, {"text": "Vicky Brago-Mitchell is an American fractal artist known in the 1960s as a Stanford University student who, while working as a topless dancer, ran for student body president.", "chunk_id": "b9e66f096d2d52e7", "doc_id": "hp_a9fead16be02ae83"}, {"text": "Before turning pro, Goldie played tennis for Stanford University, where he won the 1986 National Singles Championship before graduating with a degree in Economics.", "chunk_id": "f3bc6bdeb3b7f477", "doc_id": "hp_ce1cd3eb59940b9f"}, {"text": "Weinstein and Bill Oakley became best friends and writing partners at St. Albans High School; Weinstein then attended Stanford University and was editor-in-chief of the \"Stanford Chaparral\".", "chunk_id": "f450f6caed97e558", "doc_id": "hp_fb680b86915566c0"}]</data>
  <data key="d3">["hp_494b8f24cca0ee94", "hp_69dbe4380588b108", "hp_8e65f4aec073c221", "hp_a9fead16be02ae83", "hp_ce1cd3eb59940b9f", "hp_fb680b86915566c0"]</data>
  <data key="d4">False</data>
</node>
