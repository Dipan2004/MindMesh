  <data key="d7">[{"text": "The firm is commonly depicted in the pages of the \"She-Hulk\" comic books - named after Marvel Founders Martin Goodman, Stan Lee, under his birth name Stanley Lieber, and Jack Kirby, using his birth name Jacob Kurtzberg.", "chunk_id": "8668a35a82ba8929", "doc_id": "hp_3caacc282a8db693", "type": "APPEARS_IN"}]</data>
