  <data key="d2">[{"text": "It is written by newspaper reporter Gerald Bellett and was published by the Las Vegas Free Press in 2015.", "chunk_id": "922d12307dca0bd3", "doc_id": "hp_d491b739e827ef2c"}]</data>
