  <data key="d7">[{"text": "The Grand Anglo-Français Blanc et Noir (FCI No.323) translated into English as the Great Anglo-French White and Black Hound, is a breed of dog used in hunting as a scenthound, usually in packs.", "chunk_id": "6a4f265a07c810a2", "doc_id": "hp_499a4bbcdeae5a6b", "type": "TRANSLATED_AS"}]</data>
