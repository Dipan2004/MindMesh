</node>
<node id="Dann Hume">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Dann Hume is a singer-songwriter and record producer.", "chunk_id": "d4587b7df6346e8b", "doc_id": "hp_43e4303474c939c5"}, {"text": "Backing vocalist and drummer for Evermore, who wrote the song \"Running\".", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb"}, {"text": "Dann Hume is the group's drummer and lead singer and guitarist for Evermore.", "chunk_id": "d4c212cc890b725d", "doc_id": "hp_b314ee58b364424a"}]</data>
  <data key="d2">[{"text": "Dann Hume (born Daniel Benjamin Cobbe, 1 September 1987, Whangaparaoa, New Zealand) is a singer-songwriter and record producer.", "chunk_id": "d4587b7df6346e8b", "doc_id": "hp_43e4303474c939c5"}, {"text": "It was written by backing vocalist and drummer, Dann Hume.", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb"}, {"text": "It was written by Dann Hume, the group's drummer and lead singer and guitarists Jon Hume.", "chunk_id": "d4c212cc890b725d", "doc_id": "hp_b314ee58b364424a"}]</data>
  <data key="d3">["hp_43e4303474c939c5", "hp_5a1e23a825efe5cb", "hp_b314ee58b364424a"]</data>
  <data key="d4">False</data>
</node>
