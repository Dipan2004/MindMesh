  <data key="d2">[{"text": "The game and its many expansions are also published by Mayfair Games, Filosofia, Capcom, 999 Games, Κάισσα, and Devir.", "chunk_id": "492ee6567ec9e1c7", "doc_id": "hp_27d7c27c384bbb29"}]</data>
