  <data key="d1">[{"text": "An original single included on the album Happy Love Sick.", "chunk_id": "fb6d4773c5a537c1", "doc_id": "hp_5dba59e0680b3340"}]</data>
  <data key="d2">[{"text": "The album includes the original singles \"Slide Along Side\" and \"Turning Me On\".", "chunk_id": "fb6d4773c5a537c1", "doc_id": "hp_5dba59e0680b3340"}]</data>
