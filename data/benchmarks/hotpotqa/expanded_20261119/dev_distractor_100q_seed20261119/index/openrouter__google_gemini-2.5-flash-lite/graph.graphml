</node>
<node id="Marcia Strassman">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Marcia Ann Strassman was an American actress and singer.", "chunk_id": "3ee681daaaaf1d61", "doc_id": "hp_122377c2fa6d536d"}]</data>
  <data key="d2">[{"text": "Marcia Ann Strassman (April 28, 1948\r\n\r\n– October 24, 2014) was an American actress and singer, best known for her roles as Nurse Margie Cutler on \"M*A*S*H\", as Julie Kotter on \"Welcome Back, Kotter\" and as Diane Szalinski in the feature film \"Honey, I Shrunk the Kids\" (1989); its sequel \"Honey, I Blew Up the Kid\" (1992); and the 3-D film spin-off \"Honey, I Shrunk the Audience!\" (1994), which was shown at several Disney theme parks through mid-2010.", "chunk_id": "3ee681daaaaf1d61", "doc_id": "hp_122377c2fa6d536d"}]</data>
  <data key="d3">["hp_122377c2fa6d536d"]</data>
  <data key="d4">False</data>
</node>
<node id="M*A*S*H">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "M*A*S*H is a television series where Marcia Strassman played Nurse Margie Cutler.", "chunk_id": "3ee681daaaaf1d61", "doc_id": "hp_122377c2fa6d536d"}]</data>
  <data key="d2">[{"text": "Marcia Ann Strassman (April 28, 1948\r\n\r\n– October 24, 2014) was an American actress and singer, best known for her roles as Nurse Margie Cutler on \"M*A*S*H\", as Julie Kotter on \"Welcome Back, Kotter\" and as Diane Szalinski in the feature film \"Honey, I Shrunk the Kids\" (1989); its sequel \"Honey, I Blew Up the Kid\" (1992); and the 3-D film spin-off \"Honey, I Shrunk the Audience!\" (1994), which was shown at several Disney theme parks through mid-2010.", "chunk_id": "3ee681daaaaf1d61", "doc_id": "hp_122377c2fa6d536d"}]</data>
  <data key="d3">["hp_122377c2fa6d536d"]</data>
  <data key="d4">False</data>
</node>
<node id="Welcome Back, Kotter">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Welcome Back, Kotter is a television series where Marcia Strassman played Julie Kotter.", "chunk_id": "3ee681daaaaf1d61", "doc_id": "hp_122377c2fa6d536d"}]</data>
  <data key="d2">[{"text": "Marcia Ann Strassman (April 28, 1948\r\n\r\n– October 24, 2014) was an American actress and singer, best known for her roles as Nurse Margie Cutler on \"M*A*S*H\", as Julie Kotter on \"Welcome Back, Kotter\" and as Diane Szalinski in the feature film \"Honey, I Shrunk the Kids\" (1989); its sequel \"Honey, I Blew Up the Kid\" (1992); and the 3-D film spin-off \"Honey, I Shrunk the Audience!\" (1994), which was shown at several Disney theme parks through mid-2010.", "chunk_id": "3ee681daaaaf1d61", "doc_id": "hp_122377c2fa6d536d"}]</data>
  <data key="d3">["hp_122377c2fa6d536d"]</data>
  <data key="d4">False</data>
</node>
<node id="Honey, I Shrunk the Kids">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "Honey, I Shrunk the Kids is a feature film released in 1989 in which Marcia Strassman played Diane Szalinski.", "chunk_id": "3ee681daaaaf1d61", "doc_id": "hp_122377c2fa6d536d"}, {"text": "\"Honey, I Shrunk the Kids\" is a 1989 Disney film.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}, {"text": "Honey, I Shrunk the Kids is a 1989 Disney film in which Amy O'Neill played Amy Szalinski.", "chunk_id": "6f7849fc13c087db", "doc_id": "hp_7ed9ce59d4321c4f"}, {"text": "The original film in the \"Honey, I Shrunk the Kids\" trilogy.", "chunk_id": "dc5757b648896eba", "doc_id": "hp_a279428a0dd44903"}]</data>
  <data key="d2">[{"text": "Marcia Ann Strassman (April 28, 1948\r\n\r\n– October 24, 2014) was an American actress and singer, best known for her roles as Nurse Margie Cutler on \"M*A*S*H\", as Julie Kotter on \"Welcome Back, Kotter\" and as Diane Szalinski in the feature film \"Honey, I Shrunk the Kids\" (1989); its sequel \"Honey, I Blew Up the Kid\" (1992); and the 3-D film spin-off \"Honey, I Shrunk the Audience!\" (1994), which was shown at several Disney theme parks through mid-2010.", "chunk_id": "3ee681daaaaf1d61", "doc_id": "hp_122377c2fa6d536d"}, {"text": "He is best known for his portrayal of Nick Szalinski in the 1989 Disney film, \"Honey, I Shrunk the Kids\", for which he was nominated for a Young Artist Award and a Saturn Award.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}, {"text": "After appearing in several sitcoms and starring as Molly Stark on \"The Young and the Restless\" in 1986, she was cast in her notable role as Amy Szalinski in the 1989 Disney film, \"Honey, I Shrunk the Kids\", for which she was nominated for a Young Artist Award.", "chunk_id": "6f7849fc13c087db", "doc_id": "hp_7ed9ce59d4321c4f"}, {"text": "Honey, We Shrunk Ourselves is a 1997 live-action direct-to-video sequel to \"Honey, I Shrunk the Kids\" and \"Honey, I Blew Up the Kid\".", "chunk_id": "dc5757b648896eba", "doc_id": "hp_a279428a0dd44903"}]</data>
  <data key="d3">["hp_122377c2fa6d536d", "hp_23773bc65d0154a3", "hp_7ed9ce59d4321c4f", "hp_a279428a0dd44903"]</data>
  <data key="d4">False</data>
</node>
<node id="Honey, I Blew Up the Kid">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "Honey, I Blew Up the Kid is a sequel film released in 1992.", "chunk_id": "3ee681daaaaf1d61", "doc_id": "hp_122377c2fa6d536d"}, {"text": "\"Honey, I Blew Up the Kid\" is a 1992 sequel.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}, {"text": "A film that accompanied the animated short film Off His Rockers during its theatrical release.", "chunk_id": "97a79b79a3ae9091", "doc_id": "hp_6986703f323816c0"}, {"text": "Honey, I Blew Up the Kid is a film directed by Thom Eberhardt.", "chunk_id": "83728c058facf91d", "doc_id": "hp_75c1f2306f429a41"}, {"text": "Honey, I Blew Up the Kid is a 1992 sequel to \"Honey, I Shrunk the Kids\".", "chunk_id": "6f7849fc13c087db", "doc_id": "hp_7ed9ce59d4321c4f"}, {"text": "The second film in the \"Honey, I Shrunk the Kids\" trilogy.", "chunk_id": "dc5757b648896eba", "doc_id": "hp_a279428a0dd44903"}]</data>
  <data key="d2">[{"text": "Marcia Ann Strassman (April 28, 1948\r\n\r\n– October 24, 2014) was an American actress and singer, best known for her roles as Nurse Margie Cutler on \"M*A*S*H\", as Julie Kotter on \"Welcome Back, Kotter\" and as Diane Szalinski in the feature film \"Honey, I Shrunk the Kids\" (1989); its sequel \"Honey, I Blew Up the Kid\" (1992); and the 3-D film spin-off \"Honey, I Shrunk the Audience!\" (1994), which was shown at several Disney theme parks through mid-2010.", "chunk_id": "3ee681daaaaf1d61", "doc_id": "hp_122377c2fa6d536d"}, {"text": "He reprised the role in the 1992 sequel, \"Honey, I Blew Up the Kid\" and the 3D film, \"Honey, I Shrunk the Audience\".", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}, {"text": "It was released theatrically accompanying the film \"Honey, I Blew Up the Kid\".", "chunk_id": "97a79b79a3ae9091", "doc_id": "hp_6986703f323816c0"}, {"text": "He is most noted for his work on \"Captain Ron\", \"Honey, I Blew Up the Kid\", and the cult classic \"Night of the Comet\".", "chunk_id": "83728c058facf91d", "doc_id": "hp_75c1f2306f429a41"}, {"text": "She reprised her role as Amy Szalinski in the 1992 sequel, \"Honey, I Blew Up the Kid\" and appeared as Lisa Barnes in \"Where's Rodney?\".", "chunk_id": "6f7849fc13c087db", "doc_id": "hp_7ed9ce59d4321c4f"}, {"text": "Honey, We Shrunk Ourselves is a 1997 live-action direct-to-video sequel to \"Honey, I Shrunk the Kids\" and \"Honey, I Blew Up the Kid\".", "chunk_id": "dc5757b648896eba", "doc_id": "hp_a279428a0dd44903"}]</data>
  <data key="d3">["hp_122377c2fa6d536d", "hp_23773bc65d0154a3", "hp_6986703f323816c0", "hp_75c1f2306f429a41", "hp_7ed9ce59d4321c4f", "hp_a279428a0dd44903"]</data>
  <data key="d4">False</data>
</node>
