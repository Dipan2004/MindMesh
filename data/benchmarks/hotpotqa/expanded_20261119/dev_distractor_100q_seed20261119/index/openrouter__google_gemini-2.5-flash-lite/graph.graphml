  <data key="d2">[{"text": "Built in 1799, it is located in Carl Schurz Park, at East End Avenue and 88th Street in the Yorkville neighborhood of Manhattan.", "chunk_id": "3d263a06d589ae09", "doc_id": "hp_4c7c0e0e98b5650e"}]</data>
