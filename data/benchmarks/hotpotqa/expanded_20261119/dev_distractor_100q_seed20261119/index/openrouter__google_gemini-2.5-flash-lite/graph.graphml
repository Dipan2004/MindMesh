<node id="Curley Byrd">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Harry Clifton \"Curley\" Byrd was an American university administrator, educator, athlete, coach, segregationist, and politician.", "chunk_id": "1f441264283262f8", "doc_id": "hp_15cc461d9fb14947"}]</data>
  <data key="d2">[{"text": "Harry Clifton \"Curley\" Byrd (February 12, 1889 – October 2, 1970) was an American university administrator, educator, athlete, coach, segregationist, and politician.", "chunk_id": "1f441264283262f8", "doc_id": "hp_15cc461d9fb14947"}]</data>
  <data key="d3">["hp_15cc461d9fb14947"]</data>
  <data key="d4">False</data>
</node>
<node id="University of Maryland">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The University of Maryland is an institution with which Curley Byrd had a long association.", "chunk_id": "1f441264283262f8", "doc_id": "hp_15cc461d9fb14947"}, {"text": "The University of Maryland is the current name for Maryland Agricultural College.", "chunk_id": "3cd3c8487045d3d4", "doc_id": "hp_8b1f7c86ce5cb296"}, {"text": "The University of Maryland is an institution where Gary Williams served as head coach.", "chunk_id": "777d709f2b113bd2", "doc_id": "hp_a8de6e8688186343"}]</data>
  <data key="d2">[{"text": "Byrd began a long association with the University of Maryland as an undergraduate in 1905, and eventually rose to the position of university president from 1936 to 1954.", "chunk_id": "1f441264283262f8", "doc_id": "hp_15cc461d9fb14947"}, {"text": "He served as the president of the Oklahoma Agricultural and Mechanical College (now Oklahoma State University) and the Maryland Agricultural College (now the University of Maryland) as well teaching Military Science at Massachusetts Agricultural College (Now the University of Massachusetts - Amherst).", "chunk_id": "3cd3c8487045d3d4", "doc_id": "hp_8b1f7c86ce5cb296"}, {"text": "He served as the head coach at the University of Maryland, Ohio State University, Boston College, and American University.", "chunk_id": "777d709f2b113bd2", "doc_id": "hp_a8de6e8688186343"}]</data>
  <data key="d3">["hp_15cc461d9fb14947", "hp_8b1f7c86ce5cb296", "hp_a8de6e8688186343"]</data>
  <data key="d4">False</data>
</node>
<node id="M7 highway (Russia)">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A major trunk road in Russia, also known as the \"Volga Highway\".", "chunk_id": "70054dbfb5decd76", "doc_id": "hp_161706e9647362c5"}]</data>
  <data key="d2">[{"text": "The Russian Route M7 (also known as the \"Volga Highway\") is a major trunk road running from Moscow through Vladimir and Nizhny Novgorod to Kazan in Tatarstan and Ufa in Bashkortostan.", "chunk_id": "70054dbfb5decd76", "doc_id": "hp_161706e9647362c5"}]</data>
  <data key="d3">["hp_161706e9647362c5"]</data>
  <data key="d4">False</data>
</node>
