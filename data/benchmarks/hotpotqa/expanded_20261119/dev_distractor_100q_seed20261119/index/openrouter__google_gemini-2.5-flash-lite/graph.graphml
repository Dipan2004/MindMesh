  <data key="d2">[{"text": "It also details how Meier was supposedly pursued for 20 years by the CIA, the Hughes organization, as well as Nixon sympathizers.", "chunk_id": "922d12307dca0bd3", "doc_id": "hp_d491b739e827ef2c"}]</data>
