<node id="Margaret Court">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Margaret Court is an Australian former tennis player.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}, {"text": "Margaret Court is a tennis player who won the Grand Slam in 1970.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d2">[{"text": "This is a list of the main career statistics of Australian former tennis player Margaret Court.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}, {"text": "Her father Jerry, a well known coach, helped Margaret Court win the coveted Grand Slam (all four Grand Slam titles in one year) in 1970 and Virginia Wade to her 1977 Wimbledon triumph.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d3">["hp_80a1699490fb30e6", "hp_8e9d4247e8ae3a7a"]</data>
  <data key="d4">False</data>
</node>
<node id="Grand Slam singles titles">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Grand Slam singles titles are championships won in singles matches at Grand Slam tournaments.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}, {"text": "Grand Slam singles titles are the highest level of singles championships in tennis.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d2">[{"text": "Her 24 Grand Slam singles titles and 21 in mixed doubles are also all-time records for both sexes.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}, {"text": "He won a record 23 tennis Majors including 8 Grand Slam singles titles and before the Open Era a record 15 Pro Slam titles and a record 35 Major finals overall.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d3">["hp_80a1699490fb30e6", "hp_a8d43feead8ab699"]</data>
  <data key="d4">False</data>
</node>
<node id="mixed doubles">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Mixed doubles is a tennis format where a male and female player form a team.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}]</data>
  <data key="d2">[{"text": "Her 24 Grand Slam singles titles and 21 in mixed doubles are also all-time records for both sexes.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}]</data>
  <data key="d3">["hp_80a1699490fb30e6"]</data>
  <data key="d4">False</data>
</node>
<node id="career Grand Slam">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A career Grand Slam is achieved by winning all four major championships in a single discipline.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}]</data>
  <data key="d2">[{"text": "She achieved a career Grand Slam in singles, doubles, and mixed doubles.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}]</data>
  <data key="d3">["hp_80a1699490fb30e6"]</data>
  <data key="d4">False</data>
</node>
<node id="doubles">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Doubles is a tennis format where two players compete against another pair.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}]</data>
  <data key="d2">[{"text": "She achieved a career Grand Slam in singles, doubles, and mixed doubles.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}]</data>
  <data key="d3">["hp_80a1699490fb30e6"]</data>
  <data key="d4">False</data>
</node>
<node id="calendar year Grand Slam">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A calendar year Grand Slam is achieved by winning all four major championships in a single calendar year.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}]</data>
  <data key="d2">[{"text": "She is one of two women to have achieved \"the\" calendar year Grand Slam in singles in the Open Era (alongside Steffi Graf), and is the only woman to have achieved the mixed doubles Grand Slam, which she did twice.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}]</data>
  <data key="d3">["hp_80a1699490fb30e6"]</data>
  <data key="d4">False</data>
</node>
<node id="Open Era">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The Open Era in tennis refers to the period starting in 1968 when professional players were allowed to compete in Grand Slam tournaments.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}, {"text": "The Open Era in tennis refers to the period starting in 1968 when professional players were allowed to compete in Grand Slam tournaments.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d2">[{"text": "She is one of two women to have achieved \"the\" calendar year Grand Slam in singles in the Open Era (alongside Steffi Graf), and is the only woman to have achieved the mixed doubles Grand Slam, which she did twice.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}, {"text": "He won a record 23 tennis Majors including 8 Grand Slam singles titles and before the Open Era a record 15 Pro Slam titles and a record 35 Major finals overall.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d3">["hp_80a1699490fb30e6", "hp_a8d43feead8ab699"]</data>
  <data key="d4">False</data>
</node>
<node id="Steffi Graf">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Steffi Graf is a female tennis player.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}]</data>
  <data key="d2">[{"text": "She is one of two women to have achieved \"the\" calendar year Grand Slam in singles in the Open Era (alongside Steffi Graf), and is the only woman to have achieved the mixed doubles Grand Slam, which she did twice.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}]</data>
  <data key="d3">["hp_80a1699490fb30e6"]</data>
  <data key="d4">False</data>
</node>
<node id="mixed doubles Grand Slam">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A mixed doubles Grand Slam is achieved by winning all four major mixed doubles championships in a single calendar year.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}]</data>
  <data key="d2">[{"text": "She is one of two women to have achieved \"the\" calendar year Grand Slam in singles in the Open Era (alongside Steffi Graf), and is the only woman to have achieved the mixed doubles Grand Slam, which she did twice.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}]</data>
  <data key="d3">["hp_80a1699490fb30e6"]</data>
  <data key="d4">False</data>
</node>
