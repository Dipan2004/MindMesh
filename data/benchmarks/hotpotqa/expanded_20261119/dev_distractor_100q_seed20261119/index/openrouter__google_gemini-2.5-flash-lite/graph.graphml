  <data key="d2">[{"text": "Gnetophyta is a division of plants, grouped within the gymnosperms (which also includes conifers, cycads, and ginkgos), that consists of some 70 species across the three relict genera: \"Gnetum\" (family Gnetaceae), \"Welwitschia\" (family Welwitschiaceae), and \"Ephedra\" (family Ephedraceae).", "chunk_id": "e8e7eb907eb94958", "doc_id": "hp_3ea3f73701bd3b33"}]</data>
  <data key="d3">["hp_3ea3f73701bd3b33"]</data>
  <data key="d4">False</data>
</node>
