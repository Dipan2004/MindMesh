<node id="MLS">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A professional soccer league.", "chunk_id": "29dfa2df58a551ed", "doc_id": "hp_132ccee5aa3dd85c"}, {"text": "A professional soccer league.", "chunk_id": "8ec9e2e0b3532cdf", "doc_id": "hp_1eeecb27d77cc2fb"}, {"text": "Major League Soccer, a professional soccer league.", "chunk_id": "ca56de409a030dd6", "doc_id": "hp_33b159b8faca1ec8"}, {"text": "Major League Soccer, a professional soccer league in the United States and Canada.", "chunk_id": "1dcb1ca9df627726", "doc_id": "hp_8ad05a86a63976c5"}]</data>
  <data key="d2">[{"text": "The 1997 Kansas City Wizards season was the second in team and MLS history.", "chunk_id": "29dfa2df58a551ed", "doc_id": "hp_132ccee5aa3dd85c"}, {"text": "The Earthquakes finished 8th overall in MLS and finished in the Eastern Conference finals of the MLS Cup playoffs before losing to the Colorado Rapids.", "chunk_id": "8ec9e2e0b3532cdf", "doc_id": "hp_1eeecb27d77cc2fb"}, {"text": "The 1998 Kansas City Wizards season was the third MLS history.", "chunk_id": "ca56de409a030dd6", "doc_id": "hp_33b159b8faca1ec8"}, {"text": "MLS did not allow matches to end in ties in 1999 and thus Shootouts were used to decide draws, the stats that follow do not include shootout goals scored and the teams actually point total in the regular season was 20 even though it is shown below as 24.", "chunk_id": "1dcb1ca9df627726", "doc_id": "hp_8ad05a86a63976c5"}]</data>
  <data key="d3">["hp_132ccee5aa3dd85c", "hp_1eeecb27d77cc2fb", "hp_33b159b8faca1ec8", "hp_8ad05a86a63976c5"]</data>
  <data key="d4">False</data>
</node>
<node id="Arrowhead Stadium">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The stadium where the Kansas City Wizards played their matches.", "chunk_id": "29dfa2df58a551ed", "doc_id": "hp_132ccee5aa3dd85c"}, {"text": "A stadium located in Kansas City, Missouri.", "chunk_id": "ca56de409a030dd6", "doc_id": "hp_33b159b8faca1ec8"}, {"text": "A stadium located in Kansas City, Missouri.", "chunk_id": "1dcb1ca9df627726", "doc_id": "hp_8ad05a86a63976c5"}]</data>
  <data key="d2">[{"text": "Played at Arrowhead Stadium in Kansas City, Missouri.", "chunk_id": "29dfa2df58a551ed", "doc_id": "hp_132ccee5aa3dd85c"}, {"text": "Played at Arrowhead Stadium in Kansas City, Missouri.", "chunk_id": "ca56de409a030dd6", "doc_id": "hp_33b159b8faca1ec8"}, {"text": "The 1999 Kansas City Wizards season was played at Arrowhead Stadium in Kansas City, Missouri.", "chunk_id": "1dcb1ca9df627726", "doc_id": "hp_8ad05a86a63976c5"}]</data>
