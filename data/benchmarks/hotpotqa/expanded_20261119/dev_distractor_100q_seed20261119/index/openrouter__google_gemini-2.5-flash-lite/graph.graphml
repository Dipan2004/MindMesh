  <data key="d7">[{"text": "He reached the ATP final at Bogotá in 1998 and the fourth round of the 1998 French Open, defeating Pete Sampras in the second round.", "chunk_id": "15bc153260909107", "doc_id": "hp_2a4f96406daecf89", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_2a4f96406daecf89</data>
</edge>
