<node id="dog">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A domesticated mammal, typically with a long snout, an acute sense of smell, and a barking, howling, or whining voice.", "chunk_id": "64230ad5f64c09df", "doc_id": "hp_1098786addde3675"}, {"text": "A domesticated mammal, specifically a breed of scenthound type.", "chunk_id": "434a4988e0d48510", "doc_id": "hp_551a94d4b6ae14c7"}, {"text": "A domesticated mammal, often kept as a pet or for work.", "chunk_id": "f80e060f5f51afc7", "doc_id": "hp_a7eae4981b3aeb7c"}]</data>
  <data key="d2">[{"text": "The Grand Anglo-Français Blanc et Orange (FCI No.324) translated into English as the Great Anglo-French White and Orange Hound, is a breed of dog used in hunting as a scenthound, usually in packs.", "chunk_id": "64230ad5f64c09df", "doc_id": "hp_1098786addde3675"}, {"text": "The Chien Français Tricolore (FCI No.219) translated into English as the French Tricolour Hound, is a breed of dog of the scenthound type, originating in France.", "chunk_id": "434a4988e0d48510", "doc_id": "hp_551a94d4b6ae14c7"}, {"text": "Podenco Canario (In English: \"Canary Islands Hound\", \"Canarian Warren Hound\") is a breed of dog originally from the Canary Islands.", "chunk_id": "f80e060f5f51afc7", "doc_id": "hp_a7eae4981b3aeb7c"}]</data>
  <data key="d3">["hp_1098786addde3675", "hp_551a94d4b6ae14c7", "hp_a7eae4981b3aeb7c"]</data>
  <data key="d4">False</data>
</node>
<node id="scenthound">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A type of dog used for hunting by scent.", "chunk_id": "64230ad5f64c09df", "doc_id": "hp_1098786addde3675"}, {"text": "A type of dog used for tracking by scent.", "chunk_id": "434a4988e0d48510", "doc_id": "hp_551a94d4b6ae14c7"}]</data>
  <data key="d2">[{"text": "The Grand Anglo-Français Blanc et Orange (FCI No.324) translated into English as the Great Anglo-French White and Orange Hound, is a breed of dog used in hunting as a scenthound, usually in packs.", "chunk_id": "64230ad5f64c09df", "doc_id": "hp_1098786addde3675"}, {"text": "The Chien Français Tricolore (FCI No.219) translated into English as the French Tricolour Hound, is a breed of dog of the scenthound type, originating in France.", "chunk_id": "434a4988e0d48510", "doc_id": "hp_551a94d4b6ae14c7"}]</data>
  <data key="d3">["hp_1098786addde3675", "hp_551a94d4b6ae14c7"]</data>
  <data key="d4">False</data>
</node>
<node id="Anglo-French hound breeds">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A category of dog breeds resulting from the crossbreeding of French scenthounds and English foxhounds.", "chunk_id": "64230ad5f64c09df", "doc_id": "hp_1098786addde3675"}, {"text": "A group of dog breeds created by crossing French scenthounds with English Foxhounds.", "chunk_id": "6a4f265a07c810a2", "doc_id": "hp_499a4bbcdeae5a6b"}]</data>
  <data key="d2">[{"text": "It is one of the Anglo-French hound breeds which were created by crossing French scenthounds with English (Anglo) foxhounds.", "chunk_id": "64230ad5f64c09df", "doc_id": "hp_1098786addde3675"}, {"text": "It is one of the Anglo-French hound breeds which were created by crossing French scenthounds with English (Anglo) Foxhounds.", "chunk_id": "6a4f265a07c810a2", "doc_id": "hp_499a4bbcdeae5a6b"}]</data>
  <data key="d3">["hp_1098786addde3675", "hp_499a4bbcdeae5a6b"]</data>
  <data key="d4">False</data>
</node>
