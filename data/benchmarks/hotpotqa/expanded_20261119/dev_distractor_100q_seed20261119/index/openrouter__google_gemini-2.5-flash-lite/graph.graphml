<node id="Chicago Fire">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Chicago Fire is a professional soccer team that plays in Major League Soccer.", "chunk_id": "fa8b75f19429db6d", "doc_id": "hp_f0968af3cbb3184b"}]</data>
  <data key="d2">[{"text": "Zach Thornton (born October 10, 1973 in Edgewood, Maryland) is a retired goalkeeper who spent 16 seasons in Major League Soccer (MLS) with the New York/New Jersey MetroStars (1996–1997), Chicago Fire (1998–2006), Colorado Rapids (2007), New York Red Bulls (2008) and Chivas USA (2008–2011).", "chunk_id": "fa8b75f19429db6d", "doc_id": "hp_f0968af3cbb3184b"}]</data>
  <data key="d3">["hp_f0968af3cbb3184b"]</data>
  <data key="d4">False</data>
</node>
<node id="Chivas USA">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Chivas USA was a professional soccer team that played in Major League Soccer.", "chunk_id": "fa8b75f19429db6d", "doc_id": "hp_f0968af3cbb3184b"}]</data>
  <data key="d2">[{"text": "Zach Thornton (born October 10, 1973 in Edgewood, Maryland) is a retired goalkeeper who spent 16 seasons in Major League Soccer (MLS) with the New York/New Jersey MetroStars (1996–1997), Chicago Fire (1998–2006), Colorado Rapids (2007), New York Red Bulls (2008) and Chivas USA (2008–2011).", "chunk_id": "fa8b75f19429db6d", "doc_id": "hp_f0968af3cbb3184b"}]</data>
  <data key="d3">["hp_f0968af3cbb3184b"]</data>
  <data key="d4">False</data>
</node>
<node id="MLS Cup '98">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "MLS Cup '98 was a soccer championship won by the Chicago Fire.", "chunk_id": "fa8b75f19429db6d", "doc_id": "hp_f0968af3cbb3184b"}]</data>
  <data key="d2">[{"text": "He was the starting goalkeeper for the Fire when it won MLS Cup '98 in its inaugural year.", "chunk_id": "fa8b75f19429db6d", "doc_id": "hp_f0968af3cbb3184b"}]</data>
  <data key="d3">["hp_f0968af3cbb3184b"]</data>
  <data key="d4">False</data>
</node>
<node id="Chris Armas">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Chris Armas is a former soccer player and teammate of Zach Thornton.", "chunk_id": "fa8b75f19429db6d", "doc_id": "hp_f0968af3cbb3184b"}]</data>
  <data key="d2">[{"text": "He, along with Chris Armas and C. J. Brown, are the only three Fire players to be a part of all six of the club's domestic championships from 1998 through 2006.", "chunk_id": "fa8b75f19429db6d", "doc_id": "hp_f0968af3cbb3184b"}]</data>
  <data key="d3">["hp_f0968af3cbb3184b"]</data>
  <data key="d4">False</data>
</node>
<node id="C. J. Brown">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "C. J. Brown is a former soccer player and teammate of Zach Thornton.", "chunk_id": "fa8b75f19429db6d", "doc_id": "hp_f0968af3cbb3184b"}]</data>
  <data key="d2">[{"text": "He, along with Chris Armas and C. J. Brown, are the only three Fire players to be a part of all six of the club's domestic championships from 1998 through 2006.", "chunk_id": "fa8b75f19429db6d", "doc_id": "hp_f0968af3cbb3184b"}]</data>
  <data key="d3">["hp_f0968af3cbb3184b"]</data>
  <data key="d4">False</data>
</node>
<node id="Nan Fink Gefen">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Nan Fink Gefen was a co-founder of Tikkun magazine.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1"}]</data>
  <data key="d2">[{"text": "The magazine was founded in 1986 by Michael Lerner and his then-wife Nan Fink Gefen.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1"}]</data>
  <data key="d3">["hp_f15a13a6272383b1"]</data>
  <data key="d4">False</data>
</node>
<node id="Duke University Press">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Duke University Press has been the publisher of Tikkun magazine since 2012.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1"}]</data>
  <data key="d2">[{"text": "Since 2012, its publisher is Duke University Press.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1"}]</data>
  <data key="d3">["hp_f15a13a6272383b1"]</data>
  <data key="d4">False</data>
</node>
<node id="Rabbi Michael Lerner">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Rabbi Michael Lerner leads the Beyt Tikkun Synagogue.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1"}]</data>
  <data key="d2">[{"text": "Beyt Tikkun Synagogue, led by Rabbi Michael Lerner, is loosely affiliated with Tikkun magazine.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1"}]</data>
  <data key="d3">["hp_f15a13a6272383b1"]</data>
  <data key="d4">False</data>
</node>
<node id="Utne Reader">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Utne Reader awarded Tikkun magazine the 'Independent Press Award for Best Spiritual Coverage' in 2006 and 2011.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1"}]</data>
  <data key="d2">[{"text": "In 2006 and 2011, the magazine was awarded the \"Independent Press Award for Best Spiritual Coverage\" by \"Utne Reader\" for its analysis of the inability of many progressives to understand people's yearning for faith, and the American fundamentalists' political influence on the international conflict among religious zealots.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1"}]</data>
  <data key="d3">["hp_f15a13a6272383b1"]</data>
  <data key="d4">False</data>
</node>
