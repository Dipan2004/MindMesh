  <data key="d2">[{"text": "Founded in 2000 as part of the development system for the Colorado Rapids Major League Soccer franchise, the team played in the USL Premier Development League (PDL), the fourth tier of the American Soccer Pyramid, until 2008, when the franchise folded and the team left the league.", "chunk_id": "2fbe7eef52bbabf7", "doc_id": "hp_b1d9c15ce97f0f1f"}]</data>
