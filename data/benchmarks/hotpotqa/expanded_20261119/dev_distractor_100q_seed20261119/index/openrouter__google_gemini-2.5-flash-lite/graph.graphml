<node id="2013 World's Strongest Man">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 36th edition of the World's Strongest Man competition.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "The 2013 World's Strongest Man is a competition that Robert Oberst competed in.", "chunk_id": "fd867132c1c55e97", "doc_id": "hp_ab10a66f84257538"}]</data>
  <data key="d2">[{"text": "The 2013 World's Strongest Man was the 36th edition of World's Strongest Man.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "He is a yearly competitor of the World's Strongest Man including the 2013 World's Strongest Man, 2014 World's Strongest Man, 2015 World's Strongest Man and the 2016 World's Strongest Man competitions.", "chunk_id": "fd867132c1c55e97", "doc_id": "hp_ab10a66f84257538"}]</data>
