  <data key="d2">[{"text": "It was initiated in February 1991 by science fiction authors Pat Murphy and Karen Joy Fowler, and is awarded and discussed yearly at WisCon.", "chunk_id": "c247beb830b15400", "doc_id": "hp_bf2ea5d754ea7865"}]</data>
