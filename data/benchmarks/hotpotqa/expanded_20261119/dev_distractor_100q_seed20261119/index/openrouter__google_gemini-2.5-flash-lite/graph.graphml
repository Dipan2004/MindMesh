</node>
<node id="Jon Peters">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The producer of the 1989 film \"Batman\" who was initially unsure about Danny Elfman as a composer.", "chunk_id": "8c1c86c18a223728", "doc_id": "hp_f90b8fdeee8924ac"}]</data>
  <data key="d2">[{"text": "According to the \"Batman\" DVD Special Edition, Elfman said that producer Jon Peters was not sure about him as a composer until Tim Burton made him play the main titles.", "chunk_id": "8c1c86c18a223728", "doc_id": "hp_f90b8fdeee8924ac"}]</data>
  <data key="d3">["hp_f90b8fdeee8924ac"]</data>
  <data key="d4">False</data>
</node>
<node id="The Batman Theme">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An iconic piece composed by Danny Elfman that served as the basis for theme music of a subsequent production.", "chunk_id": "8c1c86c18a223728", "doc_id": "hp_f90b8fdeee8924ac"}]</data>
  <data key="d2">[{"text": "Elfman's \"The Batman Theme\" went on to become an iconic piece.", "chunk_id": "8c1c86c18a223728", "doc_id": "hp_f90b8fdeee8924ac"}]</data>
  <data key="d3">["hp_f90b8fdeee8924ac"]</data>
  <data key="d4">False</data>
</node>
<node id="Batman the Ride">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A ride at various Six Flags theme parks where parts of the Elfman score are played.", "chunk_id": "8c1c86c18a223728", "doc_id": "hp_f90b8fdeee8924ac"}]</data>
  <data key="d2">[{"text": "Parts are also played in the queue, and on the station platform of Batman the Ride at various Six Flags theme parks.", "chunk_id": "8c1c86c18a223728", "doc_id": "hp_f90b8fdeee8924ac"}]</data>
  <data key="d3">["hp_f90b8fdeee8924ac"]</data>
  <data key="d4">False</data>
</node>
