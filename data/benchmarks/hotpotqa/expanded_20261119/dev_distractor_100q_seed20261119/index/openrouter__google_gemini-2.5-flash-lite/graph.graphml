  <data key="d2">[{"text": "The footage was filmed in Los Angeles at the Staples Center and The Forum, and features a clip from East Rutherford's Arena where Jackson publicly announced the concert series.", "chunk_id": "e8f7b78282274913", "doc_id": "hp_7df09ceedd2a307f"}]</data>
  <data key="d3">["hp_7df09ceedd2a307f"]</data>
  <data key="d4">False</data>
</node>
<node id="East Rutherford's Arena">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A venue where Michael Jackson publicly announced the concert series.", "chunk_id": "e8f7b78282274913", "doc_id": "hp_7df09ceedd2a307f"}]</data>
  <data key="d2">[{"text": "The footage was filmed in Los Angeles at the Staples Center and The Forum, and features a clip from East Rutherford's Arena where Jackson publicly announced the concert series.", "chunk_id": "e8f7b78282274913", "doc_id": "hp_7df09ceedd2a307f"}]</data>
  <data key="d3">["hp_7df09ceedd2a307f"]</data>
  <data key="d4">False</data>
</node>
<node id="Battle of Saint-Mihiel">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A major World War I battle fought from 12–15 September 1918.", "chunk_id": "45856128b6a22257", "doc_id": "hp_7e06d5c1c2ef0dce"}]</data>
  <data key="d2">[{"text": "The Battle of Saint-Mihiel was a major World War I battle fought from 12–15 September 1918, involving the American Expeditionary Force (AEF) and 110,000 French troops under the command of General John J. Pershing of the United States against German positions.", "chunk_id": "45856128b6a22257", "doc_id": "hp_7e06d5c1c2ef0dce"}]</data>
  <data key="d3">["hp_7e06d5c1c2ef0dce"]</data>
  <data key="d4">False</data>
</node>
<node id="American Expeditionary Force (AEF)">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The American military force that fought in World War I.", "chunk_id": "45856128b6a22257", "doc_id": "hp_7e06d5c1c2ef0dce"}]</data>
  <data key="d2">[{"text": "The Battle of Saint-Mihiel was a major World War I battle fought from 12–15 September 1918, involving the American Expeditionary Force (AEF) and 110,000 French troops under the command of General John J. Pershing of the United States against German positions.", "chunk_id": "45856128b6a22257", "doc_id": "hp_7e06d5c1c2ef0dce"}]</data>
  <data key="d3">["hp_7e06d5c1c2ef0dce"]</data>
  <data key="d4">False</data>
</node>
<node id="General John J. Pershing">
  <data key="d0">PERSON</data>
