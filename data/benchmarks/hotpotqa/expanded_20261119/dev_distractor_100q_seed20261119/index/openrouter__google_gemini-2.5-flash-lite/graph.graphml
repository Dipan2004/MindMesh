  <data key="d1">[{"text": "The winner of the British Speedway Championship.", "chunk_id": "539ff347cbaa67c2", "doc_id": "hp_4ff036de49247657"}]</data>
  <data key="d2">[{"text": "The winner of the event becomes the British Speedway Champion.", "chunk_id": "539ff347cbaa67c2", "doc_id": "hp_4ff036de49247657"}]</data>
  <data key="d3">["hp_4ff036de49247657"]</data>
