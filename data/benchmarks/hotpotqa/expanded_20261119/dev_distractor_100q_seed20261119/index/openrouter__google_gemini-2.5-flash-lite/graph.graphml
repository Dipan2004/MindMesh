<node id="John Lanchbery">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "John Lanchbery was an English, later Australian, composer and conductor, famous for his ballet arrangements.", "chunk_id": "9d00c4570c3c8f48", "doc_id": "hp_945d3839e857ef30"}]</data>
  <data key="d2">[{"text": "John Arthur Lanchbery OBE (15 May 1923 - 27 February 2003) was an English, later Australian, composer and conductor, famous for his ballet arrangements.", "chunk_id": "9d00c4570c3c8f48", "doc_id": "hp_945d3839e857ef30"}]</data>
  <data key="d3">["hp_945d3839e857ef30"]</data>
