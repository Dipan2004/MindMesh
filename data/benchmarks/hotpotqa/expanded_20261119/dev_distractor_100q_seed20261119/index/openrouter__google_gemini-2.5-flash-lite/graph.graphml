  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The fourth edition of the World's Strongest Man competition.", "chunk_id": "22af8bb1815b8995", "doc_id": "hp_b1381d79c5b4d390"}]</data>
  <data key="d2">[{"text": "The 1980 World's Strongest Man was the fourth edition of World's Strongest Man and was won by Bill Kazmaier from the United States.", "chunk_id": "22af8bb1815b8995", "doc_id": "hp_b1381d79c5b4d390"}]</data>
