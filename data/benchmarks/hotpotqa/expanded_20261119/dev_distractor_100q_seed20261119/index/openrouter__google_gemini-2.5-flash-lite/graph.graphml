<edge source="Glasshouse" target="Port Macquarie">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">The Glasshouse is located in Port Macquarie.</data>
  <data key="d7">[{"text": "The dismissal of the Port Macquarie-Hastings Council on 27 February 2008 marked the end of a series of events involving a project which was initiated in 2001 in the New South Wales coastal town of Port Macquarie to build a cultural and entertainment centre, known to locals as the Glasshouse.", "chunk_id": "203bcd26d9746ba7", "doc_id": "hp_d399c5634a0f3001", "type": "LOCATED_IN"}]</data>
