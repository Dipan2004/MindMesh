<node id="United States">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A country where Ashland, Ohio is located.", "chunk_id": "015a08864b0b59a3", "doc_id": "hp_0fac18ff47357f6d"}, {"text": "A country where ITC Transmission operates.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}, {"text": "A country in North America.", "chunk_id": "df2d0d5f172fe969", "doc_id": "hp_1345505e9a844632"}, {"text": "A country where Monty Banks achieved success.", "chunk_id": "1e569c2aa40d90c4", "doc_id": "hp_15caf36624649b1e"}, {"text": "The United States is a country where Zaj toured in the late 1970s.", "chunk_id": "b647f648f08782f6", "doc_id": "hp_205b52451626bfb6"}, {"text": "The team that the Toronto National Sea Fleas lost to in the final game of the 1933 World Ice Hockey Championships.", "chunk_id": "fecd6ff50a6d6817", "doc_id": "hp_2509ce49ef3c84a3"}, {"text": "The United States is where Lonicera morrowii is colloquially called 'bush honeysuckle'.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}, {"text": "A country in North America.", "chunk_id": "da467109040d67f5", "doc_id": "hp_2ea484cb715401dc"}, {"text": "A country where multiple hotels named Occidental were located.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}, {"text": "A country in North America.", "chunk_id": "47b19fbaa70c2777", "doc_id": "hp_357ddba773097c91"}, {"text": "A country where Ohio is located.", "chunk_id": "74d72822b81604a9", "doc_id": "hp_39b03b4ecdf340de"}, {"text": "A country where the 2013 World's Strongest Man event will be broadcast on CBS Sports Network.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "The United States is a country.", "chunk_id": "75ff884d3fae85e2", "doc_id": "hp_46658770e8628bf3"}, {"text": "The United States is a country where New York City is located and the band Das Damen was formed.", "chunk_id": "2a770550ab855da2", "doc_id": "hp_487457843d9527fb"}, {"text": "A country where Dayton, Ohio is located.", "chunk_id": "b3dd1a340e6929c9", "doc_id": "hp_58345f001027ee37"}, {"text": "A country from which Brian Shaw originates.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}, {"text": "A country in North America.", "chunk_id": "1221adbf4371c7a0", "doc_id": "hp_60e7d9ac9e049733"}, {"text": "The United States is a country where certain Echinacea species are listed as endangered.", "chunk_id": "940bcdf581a12ef8", "doc_id": "hp_69fd7358b20b9865"}, {"text": "The United States is a country in North America.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}, {"text": "A country where Dayton, Ohio is located.", "chunk_id": "967deaf2512420da", "doc_id": "hp_6f092134262031b8"}, {"text": "The United States is a location where The Black Hole was released.", "chunk_id": "5adc5270c9844bc8", "doc_id": "hp_75144a703046903e"}, {"text": "The country that conducted a decade-long bombing campaign in Southeast Asia.", "chunk_id": "51c2cb97c1a1900f", "doc_id": "hp_7681eb8af0f9cd50"}, {"text": "The country where the episode \"Donnie Fatso\" first aired.", "chunk_id": "e04e5b86f01e2f28", "doc_id": "hp_79034157698c4480"}, {"text": "The United States is a country in North America.", "chunk_id": "7430715d26fd6b11", "doc_id": "hp_7a28631371b5d588"}, {"text": "A country in North America, the origin of General John J. Pershing.", "chunk_id": "45856128b6a22257", "doc_id": "hp_7e06d5c1c2ef0dce"}, {"text": "The United States is the country Jim Pugh is from.", "chunk_id": "7b5e0db5ada508ba", "doc_id": "hp_8ec8cd0791ca8bff"}, {"text": "The United States is a country.", "chunk_id": "d0fb2c3c709ff033", "doc_id": "hp_946666f5c2bbd323"}, {"text": "The country Bill Kazmaier is from.", "chunk_id": "22af8bb1815b8995", "doc_id": "hp_b1381d79c5b4d390"}, {"text": "A country where the Colorado Rapids U-23 team was based.", "chunk_id": "2fbe7eef52bbabf7", "doc_id": "hp_b1d9c15ce97f0f1f"}, {"text": "The United States is a country in North America.", "chunk_id": "bbb6119acb937cda", "doc_id": "hp_c38e964da8a4abbb"}, {"text": "A country Ravel traveled in before composing the concerto.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}, {"text": "A country where the television program Live to Dance is based.", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}, {"text": "The United States is a country where Davey Tree provides services.", "chunk_id": "a9e806e2d99c31d9", "doc_id": "hp_d2d8272fe5506239"}, {"text": "A country in North America.", "chunk_id": "7fcbe97a0e441ab4", "doc_id": "hp_d534800743a3d491"}, {"text": "A country in North America.", "chunk_id": "cfcc8f8ff86d83c3", "doc_id": "hp_dbf42d0cc7b618be"}, {"text": "The country where the horror film Diary of a Cannibal was produced.", "chunk_id": "e4fc625ee54ece8f", "doc_id": "hp_e24e3312ad888691"}, {"text": "The United States is a country where Tikkun magazine is published.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1"}, {"text": "The United States was the team that defeated the Toronto National Sea Fleas in the final game of the 1933 World Ice Hockey Championships.", "chunk_id": "4bbb68cf46284da6", "doc_id": "hp_f18e54e3d937fb49"}]</data>
  <data key="d2">[{"text": "Center Street Historic District is a historic district in Ashland, Ohio, United States.", "chunk_id": "015a08864b0b59a3", "doc_id": "hp_0fac18ff47357f6d"}, {"text": "In 2004, ITC Transmission became the first, fully independent electricity transmission company in the United States following the 2003 transfer of ownership from DTE Energy to ITC Transmission’s parent company, ITC Holdings Corp.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}, {"text": "The Seminole Casino Immokalee is a Class III tribal gaming casino in the town of Immokalee, Florida, United States, 35 miles from Naples.", "chunk_id": "df2d0d5f172fe969", "doc_id": "hp_1345505e9a844632"}, {"text": "Monty Banks Montague (Monty) Banks (15 July 1897 [registered on 18 July 1897] – 7 January 1950 born Mario Bianchi) was an Italian comedian and film director who achieved success in the United States and in England.", "chunk_id": "1e569c2aa40d90c4", "doc_id": "hp_15caf36624649b1e"}, {"text": "With the help of John Cage and his agent Mimi Johnson, Zaj also toured in different cities in the United States in the late 1970s.", "chunk_id": "b647f648f08782f6", "doc_id": "hp_205b52451626bfb6"}, {"text": "The Toronto National Sea Fleas were a senior men's amateur ice hockey team that won the 1932 Allan Cup, and also represented Canada at the 1933 World Ice Hockey Championships held in Prague, Czechoslovakia where the team lost the final game to the United States in overtime to capture the silver medal for Canada.", "chunk_id": "fecd6ff50a6d6817", "doc_id": "hp_2509ce49ef3c84a3"}, {"text": "It is colloquially called \"bush honeysuckle\" in the United States, and is considered an invasive species.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}, {"text": "Carnival Eats is a Canadian television series about various eating establishments at carnivals in Canada and the United States.", "chunk_id": "da467109040d67f5", "doc_id": "hp_2ea484cb715401dc"}, {"text": "It was one of the many hotels named Occidental in the United States, and it was among the few luxury hotels in San Francisco that catered to wealthy travelers.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}, {"text": "Plant City Airport (ICAO: KPCM, FAA LID: PCM) is a public-use airport located two nautical miles (4 km) southwest of the central business district of Plant City in Hillsborough County, Florida, United States.", "chunk_id": "47b19fbaa70c2777", "doc_id": "hp_357ddba773097c91"}, {"text": "The Historic Inner East neighborhood is located in Dayton, Ohio, United States.", "chunk_id": "74d72822b81604a9", "doc_id": "hp_39b03b4ecdf340de"}, {"text": "The event was sponsored by the Commerce Casino and will be broadcast in the United States on the CBS Sports Network.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "Rio Hondo College is a community college located in the city of Whittier, California, United States, named after the Rio Hondo.", "chunk_id": "75ff884d3fae85e2", "doc_id": "hp_46658770e8628bf3"}, {"text": "Das Damen was an alternative rock band from New York City, United States, formed in 1984.", "chunk_id": "2a770550ab855da2", "doc_id": "hp_487457843d9527fb"}, {"text": "Saint Anne's Hill Historic District is part of the Historic Inner East neighborhood in Dayton, Ohio, United States.", "chunk_id": "b3dd1a340e6929c9", "doc_id": "hp_58345f001027ee37"}, {"text": "Hafþór Júlíus Björnsson from Iceland finished in second place, and Brian Shaw from the United States came in third.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}, {"text": "The 2010 Major League Soccer season was the 98th season of FIFA-sanctioned soccer, the 32nd with a national first-division league, in the United States and Canada, and the 15th in MLS history.", "chunk_id": "1221adbf4371c7a0", "doc_id": "hp_60e7d9ac9e049733"}, {"text": "Two of the species, \"E. tennesseensis\" and \"E. laevigata\", are listed in the United States as endangered species.", "chunk_id": "940bcdf581a12ef8", "doc_id": "hp_69fd7358b20b9865"}, {"text": "Frederick is a city and county seat of Tillman County, Oklahoma, United States.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}, {"text": "The Central Avenue Historic District is a small segment of the larger Grafton Hill neighborhood of Dayton, Ohio, United States.", "chunk_id": "967deaf2512420da", "doc_id": "hp_6f092134262031b8"}, {"text": "The film was released on December 18, 1979 in the United Kingdom and on December 21, 1979 in the United States.", "chunk_id": "5adc5270c9844bc8", "doc_id": "hp_75144a703046903e"}, {"text": "On the memo, in his own handwriting, Nixon described the decade-long bombing campaign by the United States in Southeast Asia as a \"failure,\" having achieved \"zilch,\" despite public comments to the contrary.", "chunk_id": "51c2cb97c1a1900f", "doc_id": "hp_7681eb8af0f9cd50"}, {"text": "It first aired on the Fox network in the United States on December 12, 2010.", "chunk_id": "e04e5b86f01e2f28", "doc_id": "hp_79034157698c4480"}, {"text": "East Walnut Hills is a neighborhood in Cincinnati, Ohio, United States.", "chunk_id": "7430715d26fd6b11", "doc_id": "hp_7a28631371b5d588"}, {"text": "The Battle of Saint-Mihiel was a major World War I battle fought from 12–15 September 1918, involving the American Expeditionary Force (AEF) and 110,000 French troops under the command of General John J. Pershing of the United States against German positions.", "chunk_id": "45856128b6a22257", "doc_id": "hp_7e06d5c1c2ef0dce"}, {"text": "Jim Pugh (born February 5, 1964 in Burbank, California) is a former professional tennis player from the United States.", "chunk_id": "7b5e0db5ada508ba", "doc_id": "hp_8ec8cd0791ca8bff"}, {"text": "Pureland Industrial Complex is a 3000 acre industrial park located in Logan Township in Gloucester County, New Jersey, United States.", "chunk_id": "d0fb2c3c709ff033", "doc_id": "hp_946666f5c2bbd323"}, {"text": "The 1980 World's Strongest Man was the fourth edition of World's Strongest Man and was won by Bill Kazmaier from the United States.", "chunk_id": "22af8bb1815b8995", "doc_id": "hp_b1381d79c5b4d390"}, {"text": "Colorado Rapids U–23 was an American soccer team based in Boulder, Colorado, United States.", "chunk_id": "2fbe7eef52bbabf7", "doc_id": "hp_b1d9c15ce97f0f1f"}, {"text": "The Huffman Historic District is a historic neighborhood in eastern Dayton, Ohio, United States.", "chunk_id": "bbb6119acb937cda", "doc_id": "hp_c38e964da8a4abbb"}, {"text": "Ravel composed the concerto after travelling in the United States and is reported to have described the work as \"... written in very much the same spirit as those of Mozart and Saint-Saëns,\" and said that \"it uses certain effects borrowed from jazz, but only in moderation.\"", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}, {"text": "Live to Dance is a United States television reality program and dance competition on the CBS network based on the British series \"Got to Dance\".", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}, {"text": "The Davey Tree Expert Company, also known as Davey Tree, is an American multinational employee-owned corporation that provides tree, utility, lawn care, and environmental consulting services in the green industry throughout the United States and Canada.", "chunk_id": "a9e806e2d99c31d9", "doc_id": "hp_d2d8272fe5506239"}, {"text": "The label currently holds 19 bands, 5 of which are based in The United States and Europe.", "chunk_id": "7fcbe97a0e441ab4", "doc_id": "hp_d534800743a3d491"}, {"text": "Stenocereus (Gk. stenos, narrow, L. cereus, candle) is a genus of columnar or tree-like cacti from the Baja California Peninsula and other parts of Mexico, Arizona in the United States, Colombia, Costa Rica, Guatemala, Venezuela and the ABC islands of the Dutch Caribbean.", "chunk_id": "cfcc8f8ff86d83c3", "doc_id": "hp_dbf42d0cc7b618be"}, {"text": "Diary of a Cannibal (also known as Cannibal) is a 2007 United States production horror film directed by Ulli Lommel.", "chunk_id": "e4fc625ee54ece8f", "doc_id": "hp_e24e3312ad888691"}, {"text": "Tikkun is a quarterly interfaith Jewish left-progressive magazine, published in the United States, that analyzes American and Israeli culture, politics, religion, and history in the English language.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1"}, {"text": "This team went on to represent Canada at the 1933 World Ice Hockey Championships held in Prague, Czechoslovakia where the team lost the final game to the United States in overtime to capture the silver medal for Canada.", "chunk_id": "4bbb68cf46284da6", "doc_id": "hp_f18e54e3d937fb49"}]</data>
  <data key="d3">["hp_0fac18ff47357f6d", "hp_1199b329dbff9419", "hp_1345505e9a844632", "hp_15caf36624649b1e", "hp_205b52451626bfb6", "hp_2509ce49ef3c84a3", "hp_2dbc22a588912449", "hp_2ea484cb715401dc", "hp_350233375cc7c884", "hp_357ddba773097c91", "hp_39b03b4ecdf340de", "hp_45c17b9e08342c16", "hp_46658770e8628bf3", "hp_487457843d9527fb", "hp_58345f001027ee37", "hp_5d64f24bd8d85ba4", "hp_60e7d9ac9e049733", "hp_69fd7358b20b9865", "hp_6eb8e4170df0651b", "hp_6f092134262031b8", "hp_75144a703046903e", "hp_7681eb8af0f9cd50", "hp_79034157698c4480", "hp_7a28631371b5d588", "hp_7e06d5c1c2ef0dce", "hp_8ec8cd0791ca8bff", "hp_946666f5c2bbd323", "hp_b1381d79c5b4d390", "hp_b1d9c15ce97f0f1f", "hp_c38e964da8a4abbb", "hp_c8a6c3f50e115d2a", "hp_c98c5f35b4927af5", "hp_d2d8272fe5506239", "hp_d534800743a3d491", "hp_dbf42d0cc7b618be", "hp_e24e3312ad888691", "hp_f15a13a6272383b1", "hp_f18e54e3d937fb49"]</data>
  <data key="d4">False</data>
</node>
<node id="National Register of Historic Places">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A register where the Center Street Historic District was placed.", "chunk_id": "015a08864b0b59a3", "doc_id": "hp_0fac18ff47357f6d"}, {"text": "A register on which the East Windsor Hill Historic District was listed in 1986.", "chunk_id": "7bfcc18e594af3bb", "doc_id": "hp_11772f6fd63db74e"}, {"text": "A register that lists historic places in the United States.", "chunk_id": "0c32c75514abc0dc", "doc_id": "hp_53c0688141ca0284"}, {"text": "The National Register of Historic Places is the official list of U.S. buildings, structures, sites, objects, and districts that are deemed worthy of preservation.", "chunk_id": "60d483d501d17f6f", "doc_id": "hp_936dd5018d3d1151"}]</data>
  <data key="d2">[{"text": "Placed on the National Register of Historic Places in 1976 with a boundary increase that took place in 1992, Center Street features Victorian homes built in the late 19th and early 20th centuries.", "chunk_id": "015a08864b0b59a3", "doc_id": "hp_0fac18ff47357f6d"}, {"text": "It was listed on the National Register of Historic Places in 1986.", "chunk_id": "7bfcc18e594af3bb", "doc_id": "hp_11772f6fd63db74e"}, {"text": "It was placed on the National Register of Historic Places on June 27, 2008.", "chunk_id": "0c32c75514abc0dc", "doc_id": "hp_53c0688141ca0284"}, {"text": "In 2000, the home was added to the National Register of Historic Places.", "chunk_id": "60d483d501d17f6f", "doc_id": "hp_936dd5018d3d1151"}]</data>
  <data key="d3">["hp_0fac18ff47357f6d", "hp_11772f6fd63db74e", "hp_53c0688141ca0284", "hp_936dd5018d3d1151"]</data>
  <data key="d4">False</data>
</node>
