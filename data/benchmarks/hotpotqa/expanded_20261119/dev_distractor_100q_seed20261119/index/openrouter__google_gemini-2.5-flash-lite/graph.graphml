<node id="Mount Jizu">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A holy mountain in Buddhism situated in Dali Prefecture, Yunnan Province, China.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d2">[{"text": "Mount Jizu () is situated Dali Prefecture, Yunnan Province, China.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d3">["hp_b7298b1cd3170cc8"]</data>
  <data key="d4">False</data>
</node>
<node id="Dali Prefecture">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A prefecture in Yunnan Province, China, where Mount Jizu is situated.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d2">[{"text": "Mount Jizu () is situated Dali Prefecture, Yunnan Province, China.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d3">["hp_b7298b1cd3170cc8"]</data>
  <data key="d4">False</data>
</node>
<node id="Erhai">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A body of water located to the southwest of Mount Jizu.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d2">[{"text": "The mountain is located to the northeast of Erhai and forms the tripoint of three counties: Heqing, Binchuan, and Dali City.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d3">["hp_b7298b1cd3170cc8"]</data>
  <data key="d4">False</data>
</node>
<node id="Heqing">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A county that forms a tripoint with Binchuan and Dali City, near Mount Jizu.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d2">[{"text": "The mountain is located to the northeast of Erhai and forms the tripoint of three counties: Heqing, Binchuan, and Dali City.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
