  <data key="d7">[{"text": "Karma learnt basic Chokey alphabets and prayers from his father, who is an incarnate priest and farmer from the Tsakaling Choje family, a religious nobility which claims descent from Bhutan's foremost spiritual saint Pema Lingpa and Tarshong Chukpo house of Ura.", "chunk_id": "a871fb84038a99a1", "doc_id": "hp_e30d91b396b0e3e8", "type": "DESCENDED_FROM"}]</data>
