  <data key="d5">["ORGANIZED"]</data>
  <data key="d6">George Maciunas organized Fluxus events.</data>
  <data key="d7">[{"text": "During the 1960s, members of Zaj took part in different Fluxus events organised by George Maciunas.", "chunk_id": "b647f648f08782f6", "doc_id": "hp_205b52451626bfb6", "type": "ORGANIZED"}]</data>
  <data key="d8">hp_205b52451626bfb6</data>
</edge>
