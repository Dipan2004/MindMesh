<node id="Auber">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Auber is a composer who previously adapted the Manon Lescaut story operatically.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}]</data>
  <data key="d2">[{"text": "The piece is a reworking of the Manon Lescaut story, already adapted operatically by Auber, Massenet and Puccini, and here relocated to Paris after the Second World War where, as is noted in Grove, the focus of the story moves away from Manon and towards Armand des Grieux.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}]</data>
  <data key="d3">["hp_ce10cea1030952d1"]</data>
  <data key="d4">False</data>
</node>
<node id="Massenet">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Massenet is a composer who previously adapted the Manon Lescaut story operatically.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}]</data>
  <data key="d2">[{"text": "The piece is a reworking of the Manon Lescaut story, already adapted operatically by Auber, Massenet and Puccini, and here relocated to Paris after the Second World War where, as is noted in Grove, the focus of the story moves away from Manon and towards Armand des Grieux.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}]</data>
  <data key="d3">["hp_ce10cea1030952d1"]</data>
  <data key="d4">False</data>
</node>
<node id="Puccini">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Puccini is a composer who previously adapted the Manon Lescaut story operatically.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}]</data>
  <data key="d2">[{"text": "The piece is a reworking of the Manon Lescaut story, already adapted operatically by Auber, Massenet and Puccini, and here relocated to Paris after the Second World War where, as is noted in Grove, the focus of the story moves away from Manon and towards Armand des Grieux.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}]</data>
  <data key="d3">["hp_ce10cea1030952d1"]</data>
  <data key="d4">False</data>
</node>
<node id="Grove">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Grove is a source that notes the shift in focus in Boulevard Solitude.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}]</data>
  <data key="d2">[{"text": "The piece is a reworking of the Manon Lescaut story, already adapted operatically by Auber, Massenet and Puccini, and here relocated to Paris after the Second World War where, as is noted in Grove, the focus of the story moves away from Manon and towards Armand des Grieux.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}]</data>
  <data key="d3">["hp_ce10cea1030952d1"]</data>
  <data key="d4">False</data>
</node>
<node id="Manon">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Manon is a character whose focus shifts away from her in Boulevard Solitude.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}, {"text": "An opera by Jules Massenet from 1884, based on the novel \"L'histoire du chevalier des Grieux et de Manon Lescaut\".", "chunk_id": "41a807c0946f5ef1", "doc_id": "hp_de6d3adc813848a7"}]</data>
  <data key="d2">[{"text": "The piece is a reworking of the Manon Lescaut story, already adapted operatically by Auber, Massenet and Puccini, and here relocated to Paris after the Second World War where, as is noted in Grove, the focus of the story moves away from Manon and towards Armand des Grieux.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}, {"text": "The story is based on the 1731 novel \"L'histoire du chevalier des Grieux et de Manon Lescaut\" by the Abbé Prévost and should not be confused with \"Manon\", an 1884 opera by Jules Massenet based on the same novel.", "chunk_id": "41a807c0946f5ef1", "doc_id": "hp_de6d3adc813848a7"}]</data>
  <data key="d3">["hp_ce10cea1030952d1", "hp_de6d3adc813848a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Armand des Grieux">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Armand des Grieux is a character towards whom the focus of Boulevard Solitude moves.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}]</data>
  <data key="d2">[{"text": "The piece is a reworking of the Manon Lescaut story, already adapted operatically by Auber, Massenet and Puccini, and here relocated to Paris after the Second World War where, as is noted in Grove, the focus of the story moves away from Manon and towards Armand des Grieux.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}]</data>
  <data key="d3">["hp_ce10cea1030952d1"]</data>
  <data key="d4">False</data>
</node>
<node id="jazz influences">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Jazz influences are a notable feature of Boulevard Solitude.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}]</data>
  <data key="d2">[{"text": "The work stands out for its strong jazz influences, from a composer who had hitherto been associated with twelve tone technique.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}]</data>
  <data key="d3">["hp_ce10cea1030952d1"]</data>
  <data key="d4">False</data>
</node>
<node id="twelve tone technique">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Twelve tone technique is a musical compositional method previously associated with Hans Werner Henze.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}]</data>
  <data key="d2">[{"text": "The work stands out for its strong jazz influences, from a composer who had hitherto been associated with twelve tone technique.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}]</data>
  <data key="d3">["hp_ce10cea1030952d1"]</data>
  <data key="d4">False</data>
</node>
<node id="Daniel C. Goldie">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A former tennis player from the United States.", "chunk_id": "f3bc6bdeb3b7f477", "doc_id": "hp_ce1cd3eb59940b9f"}]</data>
  <data key="d2">[{"text": "Daniel C. Goldie (born October 3, 1963) is a former tennis player from the United States who won 2 singles (1987, Newport and 1988, Seoul) and 2 doubles titles (1986, Wellington and 1987, Newport).", "chunk_id": "f3bc6bdeb3b7f477", "doc_id": "hp_ce1cd3eb59940b9f"}]</data>
  <data key="d3">["hp_ce1cd3eb59940b9f"]</data>
  <data key="d4">False</data>
</node>
<node id="Newport">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location where Daniel C. Goldie won tennis titles.", "chunk_id": "f3bc6bdeb3b7f477", "doc_id": "hp_ce1cd3eb59940b9f"}, {"text": "A city in South Wales where Friars Walk is located.", "chunk_id": "4eee42e99e11960b", "doc_id": "hp_ef8cacebb236ea23"}]</data>
  <data key="d2">[{"text": "Daniel C. Goldie (born October 3, 1963) is a former tennis player from the United States who won 2 singles (1987, Newport and 1988, Seoul) and 2 doubles titles (1986, Wellington and 1987, Newport).", "chunk_id": "f3bc6bdeb3b7f477", "doc_id": "hp_ce1cd3eb59940b9f"}, {"text": "Friars Walk is a partially under-cover shopping centre and leisure complex in Newport city centre, South Wales.", "chunk_id": "4eee42e99e11960b", "doc_id": "hp_ef8cacebb236ea23"}]</data>
  <data key="d3">["hp_ce1cd3eb59940b9f", "hp_ef8cacebb236ea23"]</data>
  <data key="d4">False</data>
</node>
<node id="Seoul">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location where Daniel C. Goldie won tennis titles.", "chunk_id": "f3bc6bdeb3b7f477", "doc_id": "hp_ce1cd3eb59940b9f"}, {"text": "The capital city of South Korea, known for landmarks like the statue of Admiral Yi Sun-sin.", "chunk_id": "14151d0231146059", "doc_id": "hp_dd641696f4729ecc"}]</data>
  <data key="d2">[{"text": "Daniel C. Goldie (born October 3, 1963) is a former tennis player from the United States who won 2 singles (1987, Newport and 1988, Seoul) and 2 doubles titles (1986, Wellington and 1987, Newport).", "chunk_id": "f3bc6bdeb3b7f477", "doc_id": "hp_ce1cd3eb59940b9f"}, {"text": "The statue of Admiral Yi Sun-sin is located at the Sejongno, Gwanghwamun Plaza in Seoul, South Korea.", "chunk_id": "14151d0231146059", "doc_id": "hp_dd641696f4729ecc"}]</data>
  <data key="d3">["hp_ce1cd3eb59940b9f", "hp_dd641696f4729ecc"]</data>
