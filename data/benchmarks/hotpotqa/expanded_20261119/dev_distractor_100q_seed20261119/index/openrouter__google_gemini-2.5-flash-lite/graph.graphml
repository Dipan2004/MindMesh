  <data key="d7">[{"text": "Shkëlzen Taib Gashi (born 15 July 1988) is an Albanian professional footballer who plays as a midfielder and forward for Major League Soccer club Colorado Rapids and the Albania national team.", "chunk_id": "8d4b7cbdddb5b474", "doc_id": "hp_4f29423425e909b7", "type": "PART_OF"}, {"text": "Ian Francis Joyce (born July 12, 1985) is an American soccer player who most recently played for Major League Soccer club Colorado Rapids.", "chunk_id": "43aad4e477f8ff50", "doc_id": "hp_daef9730974fe681", "type": "PART_OF"}]</data>
  <data key="d8">hp_4f29423425e909b7</data>
