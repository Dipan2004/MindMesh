<node id="urban life">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A concept representing the environment that can have an alienating effect on youth.", "chunk_id": "197489edd7e615b2", "doc_id": "hp_e2eedc11b3a4a9ee"}]</data>
  <data key="d2">[{"text": "It is a story of troubled youth, dissatisfaction, and the alienating effect of urban life.", "chunk_id": "197489edd7e615b2", "doc_id": "hp_e2eedc11b3a4a9ee"}]</data>
  <data key="d3">["hp_e2eedc11b3a4a9ee"]</data>
  <data key="d4">False</data>
</node>
<node id="Animal Planet">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Animal Planet is a television network where the show My Cat from Hell airs.", "chunk_id": "18077b0a382d61f9", "doc_id": "hp_e30217bdf8dc2eea"}]</data>
  <data key="d2">[{"text": "My Cat from Hell is an American reality television series that airs on Animal Planet and premiered in May 2011.", "chunk_id": "18077b0a382d61f9", "doc_id": "hp_e30217bdf8dc2eea"}]</data>
  <data key="d3">["hp_e30217bdf8dc2eea"]</data>
  <data key="d4">False</data>
</node>
<node id="cat behaviorist">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A cat behaviorist is a professional who studies and helps resolve behavioral issues in cats.", "chunk_id": "18077b0a382d61f9", "doc_id": "hp_e30217bdf8dc2eea"}]</data>
  <data key="d2">[{"text": "It stars Jackson Galaxy, a cat behaviorist by day and a musician by night, who visits the homes of cat owners in order to resolve conflicts or behavior issues between the owners and their cats or between the cats and other pets.", "chunk_id": "18077b0a382d61f9", "doc_id": "hp_e30217bdf8dc2eea"}]</data>
  <data key="d3">["hp_e30217bdf8dc2eea"]</data>
  <data key="d4">False</data>
</node>
<node id="cat owners">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Cat owners are individuals who own cats.", "chunk_id": "18077b0a382d61f9", "doc_id": "hp_e30217bdf8dc2eea"}]</data>
  <data key="d2">[{"text": "It stars Jackson Galaxy, a cat behaviorist by day and a musician by night, who visits the homes of cat owners in order to resolve conflicts or behavior issues between the owners and their cats or between the cats and other pets.", "chunk_id": "18077b0a382d61f9", "doc_id": "hp_e30217bdf8dc2eea"}]</data>
  <data key="d3">["hp_e30217bdf8dc2eea"]</data>
  <data key="d4">False</data>
</node>
<node id="cats">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Cats are domesticated carnivorous mammals that are often kept as pets.", "chunk_id": "18077b0a382d61f9", "doc_id": "hp_e30217bdf8dc2eea"}]</data>
  <data key="d2">[{"text": "It stars Jackson Galaxy, a cat behaviorist by day and a musician by night, who visits the homes of cat owners in order to resolve conflicts or behavior issues between the owners and their cats or between the cats and other pets.", "chunk_id": "18077b0a382d61f9", "doc_id": "hp_e30217bdf8dc2eea"}]</data>
  <data key="d3">["hp_e30217bdf8dc2eea"]</data>
  <data key="d4">False</data>
</node>
<node id="other pets">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Other pets refers to animals kept for companionship other than cats.", "chunk_id": "18077b0a382d61f9", "doc_id": "hp_e30217bdf8dc2eea"}]</data>
  <data key="d2">[{"text": "It stars Jackson Galaxy, a cat behaviorist by day and a musician by night, who visits the homes of cat owners in order to resolve conflicts or behavior issues between the owners and their cats or between the cats and other pets.", "chunk_id": "18077b0a382d61f9", "doc_id": "hp_e30217bdf8dc2eea"}]</data>
  <data key="d3">["hp_e30217bdf8dc2eea"]</data>
  <data key="d4">False</data>
</node>
<node id="Behavioral issues">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Behavioral issues are problems related to the conduct or actions of an individual, in this context, cats.", "chunk_id": "18077b0a382d61f9", "doc_id": "hp_e30217bdf8dc2eea"}]</data>
  <data key="d2">[{"text": "Behavioral issues can include attacks by the cats on their owners.", "chunk_id": "18077b0a382d61f9", "doc_id": "hp_e30217bdf8dc2eea"}]</data>
  <data key="d3">["hp_e30217bdf8dc2eea"]</data>
  <data key="d4">False</data>
</node>
<node id="Karma Phuntsho">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A person born in 1968 in Ura gewog, Bumthang district, central Bhutan.", "chunk_id": "a871fb84038a99a1", "doc_id": "hp_e30d91b396b0e3e8"}]</data>
  <data key="d2">[{"text": "Lopen Karma Phuntsho (born 1968?) was born in Ura gewog in the Bumthang district of central Bhutan.", "chunk_id": "a871fb84038a99a1", "doc_id": "hp_e30d91b396b0e3e8"}]</data>
  <data key="d3">["hp_e30d91b396b0e3e8"]</data>
