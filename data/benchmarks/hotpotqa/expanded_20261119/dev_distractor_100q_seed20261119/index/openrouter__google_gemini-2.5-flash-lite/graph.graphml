<node id="Tiny Prayers">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "\"Tiny Prayers\" is the title of Aaron Embry's solo album released in 2012.", "chunk_id": "35b4acf5c74b48d4", "doc_id": "hp_995e15f7f8919993"}]</data>
  <data key="d2">[{"text": "In 2012 he released his solo album \"Tiny Prayers\" on Vagrant Records.", "chunk_id": "35b4acf5c74b48d4", "doc_id": "hp_995e15f7f8919993"}]</data>
