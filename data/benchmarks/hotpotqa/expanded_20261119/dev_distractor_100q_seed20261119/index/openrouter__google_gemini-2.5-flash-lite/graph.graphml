  <data key="d2">[{"text": "It was launched with a magazine in September 2000 to bridge the gap between design professionals and enthusiasts by Lara Hedberg Deam with architecture and design critic Karrie Jacobs as its Editor-in-Chief.", "chunk_id": "e3034f5ee568e837", "doc_id": "hp_d20dd81b0b3d11dc"}]</data>
