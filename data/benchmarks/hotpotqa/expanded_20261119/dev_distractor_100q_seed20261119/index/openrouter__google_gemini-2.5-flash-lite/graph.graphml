  <data key="d2">[{"text": "American Scientist (informally abbreviated AmSci) is an American bimonthly science and technology magazine published since 1913 by Sigma Xi, The Scientific Research Society.", "chunk_id": "ab8bde31e9a15134", "doc_id": "hp_86c935d873dc0c15"}]</data>
  <data key="d3">["hp_86c935d873dc0c15"]</data>
  <data key="d4">False</data>
</node>
