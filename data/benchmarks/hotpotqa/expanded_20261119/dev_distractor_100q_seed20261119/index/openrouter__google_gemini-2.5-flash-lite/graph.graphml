<node id="Falange Española de las JONS">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A Fascist and National Syndicalist political party founded in 1934 in Spain.", "chunk_id": "da2cebd3507fe424", "doc_id": "hp_b7901eef5f6745f0"}]</data>
  <data key="d2">[{"text": "Falange Española de las Juntas de Ofensiva Nacional-Sindicalista (Spanish for \"Spanish Phalanx of the Councils of the National-Syndicalist Offensive\"; \"FE de las JONS\" for short), or simply called the \"Falange\" (  ), was a Fascist and National Syndicalist political party founded in 1934 in Spain as merger of the Falange Española (founded in October 1933) and the Juntas de Ofensiva Nacional-Sindicalista (founded in October 1931).", "chunk_id": "da2cebd3507fe424", "doc_id": "hp_b7901eef5f6745f0"}]</data>
  <data key="d3">["hp_b7901eef5f6745f0"]</data>
  <data key="d4">False</data>
</node>
<node id="Falange Española">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A political party founded in October 1933.", "chunk_id": "da2cebd3507fe424", "doc_id": "hp_b7901eef5f6745f0"}]</data>
  <data key="d2">[{"text": "Falange Española de las Juntas de Ofensiva Nacional-Sindicalista (Spanish for \"Spanish Phalanx of the Councils of the National-Syndicalist Offensive\"; \"FE de las JONS\" for short), or simply called the \"Falange\" (  ), was a Fascist and National Syndicalist political party founded in 1934 in Spain as merger of the Falange Española (founded in October 1933) and the Juntas de Ofensiva Nacional-Sindicalista (founded in October 1931).", "chunk_id": "da2cebd3507fe424", "doc_id": "hp_b7901eef5f6745f0"}]</data>
  <data key="d3">["hp_b7901eef5f6745f0"]</data>
  <data key="d4">False</data>
</node>
<node id="Juntas de Ofensiva Nacional-Sindicalista">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A political organization founded in October 1931.", "chunk_id": "da2cebd3507fe424", "doc_id": "hp_b7901eef5f6745f0"}]</data>
  <data key="d2">[{"text": "Falange Española de las Juntas de Ofensiva Nacional-Sindicalista (Spanish for \"Spanish Phalanx of the Councils of the National-Syndicalist Offensive\"; \"FE de las JONS\" for short), or simply called the \"Falange\" (  ), was a Fascist and National Syndicalist political party founded in 1934 in Spain as merger of the Falange Española (founded in October 1933) and the Juntas de Ofensiva Nacional-Sindicalista (founded in October 1931).", "chunk_id": "da2cebd3507fe424", "doc_id": "hp_b7901eef5f6745f0"}]</data>
  <data key="d3">["hp_b7901eef5f6745f0"]</data>
  <data key="d4">False</data>
</node>
<node id="Falange">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A Fascist and National Syndicalist political party.", "chunk_id": "da2cebd3507fe424", "doc_id": "hp_b7901eef5f6745f0"}]</data>
  <data key="d2">[{"text": "Falange Española de las Juntas de Ofensiva Nacional-Sindicalista (Spanish for \"Spanish Phalanx of the Councils of the National-Syndicalist Offensive\"; \"FE de las JONS\" for short), or simply called the \"Falange\" (  ), was a Fascist and National Syndicalist political party founded in 1934 in Spain as merger of the Falange Española (founded in October 1933) and the Juntas de Ofensiva Nacional-Sindicalista (founded in October 1931).", "chunk_id": "da2cebd3507fe424", "doc_id": "hp_b7901eef5f6745f0"}]</data>
  <data key="d3">["hp_b7901eef5f6745f0"]</data>
  <data key="d4">False</data>
</node>
<node id="General Francisco Franco">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A general who merged Falange Española de las JONS with the Traditionalists during the Spanish Civil War.", "chunk_id": "da2cebd3507fe424", "doc_id": "hp_b7901eef5f6745f0"}]</data>
  <data key="d2">[{"text": "The Falange Española de las JONS ceased to exist as such when, during the Spanish Civil War, General Francisco Franco merged it with the Traditionalists in April 1937 to form the similarly named Falange Española Tradicionalista y de las Juntas de Ofensiva Nacional Sindicalista, which became the sole legal party in Spain until its dissolution in 1977.", "chunk_id": "da2cebd3507fe424", "doc_id": "hp_b7901eef5f6745f0"}]</data>
  <data key="d3">["hp_b7901eef5f6745f0"]</data>
  <data key="d4">False</data>
</node>
<node id="Falange Española Tradicionalista y de las Juntas de Ofensiva Nacional Sindicalista">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The sole legal party in Spain formed by the merger of Falange Española de las JONS and the Traditionalists.", "chunk_id": "da2cebd3507fe424", "doc_id": "hp_b7901eef5f6745f0"}]</data>
  <data key="d2">[{"text": "The Falange Española de las JONS ceased to exist as such when, during the Spanish Civil War, General Francisco Franco merged it with the Traditionalists in April 1937 to form the similarly named Falange Española Tradicionalista y de las Juntas de Ofensiva Nacional Sindicalista, which became the sole legal party in Spain until its dissolution in 1977.", "chunk_id": "da2cebd3507fe424", "doc_id": "hp_b7901eef5f6745f0"}]</data>
  <data key="d3">["hp_b7901eef5f6745f0"]</data>
  <data key="d4">False</data>
</node>
<node id="Tikkun HaKlali">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A set of ten Psalms whose recital serves as repentance for all sins, particularly those related to wasted seed.", "chunk_id": "45f2af9ee3147719", "doc_id": "hp_b7e7ca08cd26001a"}]</data>
  <data key="d2">[{"text": "Tikkun HaKlali (Hebrew: תיקון הכללי‎ ‎ , lit., \"The General (or Comprehensive) Rectification\"), also known as The General Remedy, is a set of ten Psalms whose recital serves as \"teshuvah\" (repentance) for all sins — in particular the sin of wasted seed through involuntary nocturnal emission or masturbation.", "chunk_id": "45f2af9ee3147719", "doc_id": "hp_b7e7ca08cd26001a"}]</data>
  <data key="d3">["hp_b7e7ca08cd26001a"]</data>
  <data key="d4">False</data>
</node>
<node id="The General Remedy">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "An alternative name for Tikkun HaKlali, a set of ten Psalms for repentance.", "chunk_id": "45f2af9ee3147719", "doc_id": "hp_b7e7ca08cd26001a"}]</data>
  <data key="d2">[{"text": "Tikkun HaKlali (Hebrew: תיקון הכללי‎ ‎ , lit., \"The General (or Comprehensive) Rectification\"), also known as The General Remedy, is a set of ten Psalms whose recital serves as \"teshuvah\" (repentance) for all sins — in particular the sin of wasted seed through involuntary nocturnal emission or masturbation.", "chunk_id": "45f2af9ee3147719", "doc_id": "hp_b7e7ca08cd26001a"}]</data>
  <data key="d3">["hp_b7e7ca08cd26001a"]</data>
  <data key="d4">False</data>
</node>
<node id="teshuvah">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Hebrew word for repentance.", "chunk_id": "45f2af9ee3147719", "doc_id": "hp_b7e7ca08cd26001a"}]</data>
  <data key="d2">[{"text": "Tikkun HaKlali (Hebrew: תיקון הכללי‎ ‎ , lit., \"The General (or Comprehensive) Rectification\"), also known as The General Remedy, is a set of ten Psalms whose recital serves as \"teshuvah\" (repentance) for all sins — in particular the sin of wasted seed through involuntary nocturnal emission or masturbation.", "chunk_id": "45f2af9ee3147719", "doc_id": "hp_b7e7ca08cd26001a"}]</data>
  <data key="d3">["hp_b7e7ca08cd26001a"]</data>
  <data key="d4">False</data>
</node>
<node id="Rebbe Nachman of Breslov">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The originator of the Tikkun HaKlali, a set of ten Psalms for repentance.", "chunk_id": "45f2af9ee3147719", "doc_id": "hp_b7e7ca08cd26001a"}]</data>
  <data key="d2">[{"text": "The \"Tikkun HaKlali\" is a unique innovation of Rebbe Nachman of Breslov, and its recital is a regular practice of Breslover Hasidim to this day.", "chunk_id": "45f2af9ee3147719", "doc_id": "hp_b7e7ca08cd26001a"}]</data>
  <data key="d3">["hp_b7e7ca08cd26001a"]</data>
  <data key="d4">False</data>
</node>
<node id="Breslover Hasidim">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Followers of Rebbe Nachman of Breslov who regularly practice the recital of the Tikkun HaKlali.", "chunk_id": "45f2af9ee3147719", "doc_id": "hp_b7e7ca08cd26001a"}]</data>
  <data key="d2">[{"text": "The \"Tikkun HaKlali\" is a unique innovation of Rebbe Nachman of Breslov, and its recital is a regular practice of Breslover Hasidim to this day.", "chunk_id": "45f2af9ee3147719", "doc_id": "hp_b7e7ca08cd26001a"}]</data>
  <data key="d3">["hp_b7e7ca08cd26001a"]</data>
  <data key="d4">False</data>
</node>
