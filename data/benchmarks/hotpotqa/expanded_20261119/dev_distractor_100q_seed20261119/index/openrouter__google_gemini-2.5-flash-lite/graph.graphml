<edge source="25th Amendment" target="United States vice presidential selection, 1973">
  <data key="d5">["GOVERNS"]</data>
  <data key="d6">The 25th Amendment provides the framework for filling a vice presidential vacancy.</data>
  <data key="d7">[{"text": "Under the terms of the 25th Amendment, a vice presidential vacancy is filled when the president nominates a candidate who is confirmed by both houses of Congress.", "chunk_id": "54142f25de20997e", "doc_id": "hp_adfdee30bf450e7d", "type": "GOVERNS"}]</data>
  <data key="d8">hp_adfdee30bf450e7d</data>
</edge>
