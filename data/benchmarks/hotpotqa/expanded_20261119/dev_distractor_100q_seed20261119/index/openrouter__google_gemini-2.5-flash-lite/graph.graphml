</node>
<node id="All My Children">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "All My Children is a soap opera where Finola Hughes also appeared as Anna.", "chunk_id": "810ab9175e7a3cff", "doc_id": "hp_d4c39db8215c1516"}]</data>
  <data key="d2">[{"text": "Hughes also appeared as Anna on \"All My Children\", and the \"General Hospital\" prime time, spin-off series, \"\".", "chunk_id": "810ab9175e7a3cff", "doc_id": "hp_d4c39db8215c1516"}]</data>
  <data key="d3">["hp_d4c39db8215c1516"]</data>
  <data key="d4">False</data>
</node>
<node id="Gloria Monty">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Gloria Monty was the executive producer who created and introduced Anna Devane.", "chunk_id": "810ab9175e7a3cff", "doc_id": "hp_d4c39db8215c1516"}]</data>
  <data key="d2">[{"text": "The character was created and introduced by executive producer, Gloria Monty, and co-head writers, Pat Falken Smith and Norma Monty.", "chunk_id": "810ab9175e7a3cff", "doc_id": "hp_d4c39db8215c1516"}]</data>
  <data key="d3">["hp_d4c39db8215c1516"]</data>
  <data key="d4">False</data>
</node>
<node id="Pat Falken Smith">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Pat Falken Smith was a co-head writer who created and introduced Anna Devane.", "chunk_id": "810ab9175e7a3cff", "doc_id": "hp_d4c39db8215c1516"}]</data>
  <data key="d2">[{"text": "The character was created and introduced by executive producer, Gloria Monty, and co-head writers, Pat Falken Smith and Norma Monty.", "chunk_id": "810ab9175e7a3cff", "doc_id": "hp_d4c39db8215c1516"}]</data>
  <data key="d3">["hp_d4c39db8215c1516"]</data>
  <data key="d4">False</data>
</node>
<node id="Norma Monty">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Norma Monty was a co-head writer who created and introduced Anna Devane.", "chunk_id": "810ab9175e7a3cff", "doc_id": "hp_d4c39db8215c1516"}]</data>
  <data key="d2">[{"text": "The character was created and introduced by executive producer, Gloria Monty, and co-head writers, Pat Falken Smith and Norma Monty.", "chunk_id": "810ab9175e7a3cff", "doc_id": "hp_d4c39db8215c1516"}]</data>
  <data key="d3">["hp_d4c39db8215c1516"]</data>
