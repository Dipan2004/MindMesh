<edge source="Dali–Ruili Railway" target="Dali">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">The Dali-Ruili Railway runs from Dali.</data>
  <data key="d7">[{"text": "The line is slated to run 336.39 km from Dali in central Yunnan to Ruili in southwestern Yunnan on the border with Myanmar.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_c90ebb0b4e670d3e</data>
</edge>
