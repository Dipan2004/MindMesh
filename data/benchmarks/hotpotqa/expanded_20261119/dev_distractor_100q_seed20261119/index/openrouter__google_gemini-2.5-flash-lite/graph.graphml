  <data key="d5">["RELEASED_ON"]</data>
  <data key="d6">The album Sugar Ray was released on June 12, 2001.</data>
  <data key="d7">[{"text": "The album was released on June 12, 2001, and debuted at number 6 on the \"Billboard\" 200 chart,&lt;ref name=\"sugar ray/billboard\"&gt; &lt;/ref&gt; and eventually went gold.", "chunk_id": "2b0c2ab47deb6703", "doc_id": "hp_0af4358e100679ad", "type": "RELEASED_ON"}]</data>
