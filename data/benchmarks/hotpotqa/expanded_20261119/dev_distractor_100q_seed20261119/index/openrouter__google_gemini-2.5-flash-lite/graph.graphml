  <data key="d2">[{"text": "The Russian route M2 (also known as the \"Crimea Highway\", (\"автодорога \"Крым\"\" )) is a major trunk road that connects Moscow to the Crimea.", "chunk_id": "697dec343c6a0907", "doc_id": "hp_6c6156e6e2dae378"}]</data>
