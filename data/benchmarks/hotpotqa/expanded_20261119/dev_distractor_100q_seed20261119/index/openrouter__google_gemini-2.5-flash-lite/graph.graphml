<node id="Bernard Fitzalan-Howard, 16th Duke of Norfolk">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Bernard Fitzalan-Howard was the 16th Duke of Norfolk, a British peer and politician.", "chunk_id": "004e4fd012a54ec8", "doc_id": "hp_4f583d3862c645a8"}]</data>
  <data key="d2">[{"text": "Bernard Fitzalan-Howard, 16th Duke of Norfolk", "chunk_id": "004e4fd012a54ec8", "doc_id": "hp_4f583d3862c645a8"}]</data>
  <data key="d3">["hp_4f583d3862c645a8"]</data>
  <data key="d4">False</data>
</node>
<node id="Earl of Arundel and Surrey">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Earl of Arundel and Surrey was a title styled by Bernard Fitzalan-Howard until 1917.", "chunk_id": "004e4fd012a54ec8", "doc_id": "hp_4f583d3862c645a8"}]</data>
  <data key="d2">[{"text": "styled Earl of Arundel and Surrey until 1917, was a British peer and politician.", "chunk_id": "004e4fd012a54ec8", "doc_id": "hp_4f583d3862c645a8"}]</data>
  <data key="d3">["hp_4f583d3862c645a8"]</data>
  <data key="d4">False</data>
</node>
<node id="Henry Fitzalan-Howard, 15th Duke of Norfolk">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Henry Fitzalan-Howard was the 15th Duke of Norfolk and the father of Bernard Fitzalan-Howard.", "chunk_id": "004e4fd012a54ec8", "doc_id": "hp_4f583d3862c645a8"}]</data>
  <data key="d2">[{"text": "He was the eldest surviving son of Henry Fitzalan-Howard, 15th Duke of Norfolk, who died when Bernard was only 9 years old.", "chunk_id": "004e4fd012a54ec8", "doc_id": "hp_4f583d3862c645a8"}]</data>
  <data key="d3">["hp_4f583d3862c645a8"]</data>
  <data key="d4">False</data>
</node>
<node id="Gwendolen Fitzalan-Howard">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Gwendolen Fitzalan-Howard was the mother of Bernard Fitzalan-Howard and the 12th Lady Herries of Terregles.", "chunk_id": "004e4fd012a54ec8", "doc_id": "hp_4f583d3862c645a8"}]</data>
  <data key="d2">[{"text": "His mother was Gwendolen Fitzalan-Howard, \"suo jure\" Gwendoline Mary Herries, 12th Lady Herries of Terregles, and he inherited her peerage when she died in 1947.", "chunk_id": "004e4fd012a54ec8", "doc_id": "hp_4f583d3862c645a8"}]</data>
  <data key="d3">["hp_4f583d3862c645a8"]</data>
  <data key="d4">False</data>
</node>
<node id="Gwendoline Mary Herries">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Gwendoline Mary Herries was the 12th Lady Herries of Terregles and the mother of Bernard Fitzalan-Howard.", "chunk_id": "004e4fd012a54ec8", "doc_id": "hp_4f583d3862c645a8"}]</data>
  <data key="d2">[{"text": "His mother was Gwendolen Fitzalan-Howard, \"suo jure\" Gwendoline Mary Herries, 12th Lady Herries of Terregles, and he inherited her peerage when she died in 1947.", "chunk_id": "004e4fd012a54ec8", "doc_id": "hp_4f583d3862c645a8"}]</data>
  <data key="d3">["hp_4f583d3862c645a8"]</data>
  <data key="d4">False</data>
</node>
<node id="Silybum">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Silybum is a genus of two species of thistles in the daisy family.", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}]</data>
  <data key="d2">[{"text": "Silybum (milk thistle) is a genus of two species of thistles in the (daisy family).", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}]</data>
  <data key="d3">["hp_4fb3a0aca6cf5736"]</data>
  <data key="d4">False</data>
</node>
<node id="milk thistle">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Milk thistle is a common name for Silybum, a genus of two species of thistles in the daisy family.", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}]</data>
  <data key="d2">[{"text": "Silybum (milk thistle) is a genus of two species of thistles in the (daisy family).", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}]</data>
  <data key="d3">["hp_4fb3a0aca6cf5736"]</data>
  <data key="d4">False</data>
</node>
<node id="daisy family">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The daisy family is the family to which Silybum belongs.", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}]</data>
  <data key="d2">[{"text": "Silybum (milk thistle) is a genus of two species of thistles in the (daisy family).", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}]</data>
  <data key="d3">["hp_4fb3a0aca6cf5736"]</data>
  <data key="d4">False</data>
</node>
<node id="Mediterranean regions of Europe, North Africa, and the Middle East">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "These are the native regions of the plants in the Silybum genus.", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}]</data>
  <data key="d2">[{"text": "The plants are native to the Mediterranean regions of Europe, North Africa, and the Middle East.", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}]</data>
  <data key="d3">["hp_4fb3a0aca6cf5736"]</data>
  <data key="d4">False</data>
</node>
<node id="Mother Mary">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Mother Mary is associated with the milky bands on the leaves of milk thistle.", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}]</data>
  <data key="d2">[{"text": "Historically, these milky bands were said to be Mother Mary's milk, and this is the origin of another common name, St. Mary's thistle.", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}]</data>
  <data key="d3">["hp_4fb3a0aca6cf5736"]</data>
  <data key="d4">False</data>
</node>
<node id="St. Mary's thistle">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "St. Mary's thistle is another common name for milk thistle, derived from a legend about Mother Mary's milk.", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}]</data>
  <data key="d2">[{"text": "Historically, these milky bands were said to be Mother Mary's milk, and this is the origin of another common name, St. Mary's thistle.", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}]</data>
  <data key="d3">["hp_4fb3a0aca6cf5736"]</data>
  <data key="d4">False</data>
</node>
