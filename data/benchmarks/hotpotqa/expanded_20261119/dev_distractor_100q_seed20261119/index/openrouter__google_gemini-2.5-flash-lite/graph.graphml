  <data key="d7">[{"text": "The Merchant Ivory film, \"Shakespeare Wallah\", was loosely based on the family, which starred his father and his aunt, actress Felicity Kendal.", "chunk_id": "9fd31a2bf7019c95", "doc_id": "hp_55a86a5d2ce593ec", "type": "BASED_ON"}]</data>
