  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The New South Wales Legislative Council was a legislative body to which Eli James Harrison was elected in 1943.", "chunk_id": "53f3bbd1c43e3155", "doc_id": "hp_7820faef8a00d610"}]</data>
  <data key="d2">[{"text": "He was active in local Labor Party politics, and was elected to the New South Wales Legislative Council in 1943.", "chunk_id": "53f3bbd1c43e3155", "doc_id": "hp_7820faef8a00d610"}]</data>
  <data key="d3">["hp_7820faef8a00d610"]</data>
