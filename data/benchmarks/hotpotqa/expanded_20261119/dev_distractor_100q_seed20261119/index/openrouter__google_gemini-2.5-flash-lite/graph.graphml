</node>
<node id="Max Rostal">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Max Rostal was a violinist regarded as a great proponent of the Carl Flesch tradition alongside Alma Moodie.", "chunk_id": "5978fb5d2c7a87fb", "doc_id": "hp_ac759163e3bcf4aa"}]</data>
  <data key="d2">[{"text": "She and Max Rostal were regarded as the greatest proponents of the Carl Flesch tradition.", "chunk_id": "5978fb5d2c7a87fb", "doc_id": "hp_ac759163e3bcf4aa"}]</data>
