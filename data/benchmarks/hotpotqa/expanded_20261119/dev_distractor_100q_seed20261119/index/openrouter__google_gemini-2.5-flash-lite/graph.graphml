  <data key="d7">[{"text": "During the final of the European Cup Winners' Cup in the 1986–87 season, he suffered a serious injury against Swiss team FC Sion.", "chunk_id": "2463a2e6b54ba2b9", "doc_id": "hp_3d488dbab399d265", "type": "INJURED_BY"}]</data>
  <data key="d8">hp_3d488dbab399d265</data>
