  <data key="d5">["PARENT_OF"]</data>
  <data key="d6">Salvia gesneriflora 'Tequila' is presumed to be a parent of Salvia 'Jean's Purple Passion'.</data>
  <data key="d7">[{"text": "It was found growing between \"Salvia gesneriflora\" 'Tequila' and \"Salvia mexicana\", who are presumed to be its parents.", "chunk_id": "6c8ea648c2d5ed76", "doc_id": "hp_980453e19b052243", "type": "PARENT_OF"}]</data>
