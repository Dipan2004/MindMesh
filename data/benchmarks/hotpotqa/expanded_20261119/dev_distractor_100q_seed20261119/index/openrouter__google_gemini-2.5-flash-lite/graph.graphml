  <data key="d1">[{"text": "Speedway riders who are British nationals.", "chunk_id": "539ff347cbaa67c2", "doc_id": "hp_4ff036de49247657"}]</data>
  <data key="d2">[{"text": "The British Speedway Championship. is an annual motorcycle speedway competition open to British national speedway riders.", "chunk_id": "539ff347cbaa67c2", "doc_id": "hp_4ff036de49247657"}]</data>
  <data key="d3">["hp_4ff036de49247657"]</data>
