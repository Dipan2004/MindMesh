  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "NYC Popfest is a pop music festival.", "chunk_id": "ec71908382284000", "doc_id": "hp_353258028a95f6b9"}]</data>
  <data key="d2">[{"text": "In 2007, Hugpatch was one of the organizers of the pop music festival, NYC Popfest.", "chunk_id": "ec71908382284000", "doc_id": "hp_353258028a95f6b9"}]</data>
