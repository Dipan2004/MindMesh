  <data key="d2">[{"text": "Michael Lerner (born 1943) is an American political activist, the editor of \"Tikkun\", a progressive Jewish interfaith magazine based in Berkeley, California, and the rabbi of Beyt Tikkun Synagogue in Berkeley.", "chunk_id": "b15598f798e631b6", "doc_id": "hp_ebb527a8921b04b5"}, {"text": "Beyt Tikkun Synagogue, led by Rabbi Michael Lerner, is loosely affiliated with Tikkun magazine.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1"}]</data>
