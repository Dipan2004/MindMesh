<node id="That Darn Cat! (1965 film)">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A 1965 film that was remade in 1997.", "chunk_id": "d841470ff7de5ff5", "doc_id": "hp_557f842640eb825d"}]</data>
  <data key="d2">[{"text": "It is a remake of the 1965 film \"That Darn Cat!\", which in turn was based on the book \"Undercover Cat\" by Gordon and Mildred Gordon.", "chunk_id": "d841470ff7de5ff5", "doc_id": "hp_557f842640eb825d"}]</data>
  <data key="d3">["hp_557f842640eb825d"]</data>
