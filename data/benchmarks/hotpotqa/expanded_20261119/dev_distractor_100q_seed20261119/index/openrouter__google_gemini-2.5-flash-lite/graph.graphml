  <data key="d5">["INFECTS"]</data>
  <data key="d6">An infection on Pinus radiata in New Zealand in 1950 was caused by P. kernoviae.</data>
  <data key="d7">[{"text": "Molecular analysis has revealed that an infection on \"Pinus radiata\", recorded in New Zealand in 1950, was caused by \"P. kernoviae\".", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9", "type": "INFECTS"}]</data>
