  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Edward Fitzalan-Howard is the current 18th Duke of Norfolk.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}]</data>
  <data key="d2">[{"text": "The current Duke of Norfolk is Edward Fitzalan-Howard, 18th Duke of Norfolk.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}]</data>
  <data key="d3">["hp_c50a06491df52f2d"]</data>
