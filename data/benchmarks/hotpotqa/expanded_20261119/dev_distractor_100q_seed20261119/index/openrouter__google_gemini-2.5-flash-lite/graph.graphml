<edge source="Macoumba Kandji" target="Colorado Rapids">
  <data key="d5">["PLAYS_FOR"]</data>
  <data key="d6">Macoumba Kandji plays for the Colorado Rapids.</data>
  <data key="d7">[{"text": "Colorado Rapids won 2–1 over Dallas on an own goal in extra time, as a shot by Rapids forward Macoumba Kandji was deflected on goal by Dallas defender George John.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e", "type": "PLAYS_FOR"}]</data>
