  <data key="d2">[{"text": "She was born Georgina Susan Gore, the younger daughter of John Temple (\"Jack\") Gore (1931-) and his first wife Serena Margaret Mounsey.", "chunk_id": "665f9238f1f644c5", "doc_id": "hp_3896bbdafdb2575f"}]</data>
