  <data key="d7">[{"text": "The Retuertas horse, Spanish: Caballo de las Retuertas or Caballo de las Retuertas de Doñana , is a rare breed of horse indigenous to the Andalusia region of Spain.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b", "type": "INDIGENOUS_TO"}]</data>
