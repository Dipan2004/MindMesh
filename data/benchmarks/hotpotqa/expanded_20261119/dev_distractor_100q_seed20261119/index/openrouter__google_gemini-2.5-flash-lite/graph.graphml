  <data key="d1">[{"text": "A British-born rider who won the British Speedway Championship twice.", "chunk_id": "539ff347cbaa67c2", "doc_id": "hp_4ff036de49247657"}]</data>
  <data key="d2">[{"text": "In the first dozen finals, it was only won twice by a British born rider, both times by Peter Craven.", "chunk_id": "539ff347cbaa67c2", "doc_id": "hp_4ff036de49247657"}]</data>
