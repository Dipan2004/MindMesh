  <data key="d2">[{"text": "Une chambre en ville (also known as A Room in Town) is a 1982 French film directed by Jacques Demy, with music by Michel Colombier, and starring Dominique Sanda, Danielle Darrieux, and Michel Piccoli.", "chunk_id": "79ecca5757e35f6c", "doc_id": "hp_a7f67f1b79caebb6"}]</data>
