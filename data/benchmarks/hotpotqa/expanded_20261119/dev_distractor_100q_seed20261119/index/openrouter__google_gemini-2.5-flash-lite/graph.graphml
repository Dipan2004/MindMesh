<node id="U.S.">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The location of the \"Outrage tour\".", "chunk_id": "c598b20051280564", "doc_id": "hp_d6f470ddf3a3421c"}, {"text": "United States, a country.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}, {"text": "US is the country where Gigafactory 1 is located.", "chunk_id": "51ed4dfb52cf2e60", "doc_id": "hp_5df9f2d47c876b64"}]</data>
  <data key="d2">[{"text": "\"Outrage\" lead to the \"Outrage tour\" of the U.S. 2012-13.", "chunk_id": "c598b20051280564", "doc_id": "hp_d6f470ddf3a3421c"}, {"text": "The dime novel is a form of late 19th-century and early 20th-century U.S. popular fiction issued in series of inexpensive paperbound editions.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}, {"text": "The Tesla Gigafactory 1 is an operational lithium-ion battery factory under construction, primarily for Tesla Inc., at the Tahoe Reno Industrial Center (TRIC) in Storey County (near the Community of Clark, Nevada, US).", "chunk_id": "51ed4dfb52cf2e60", "doc_id": "hp_5df9f2d47c876b64"}]</data>
  <data key="d3">["hp_5df9f2d47c876b64", "hp_d6f470ddf3a3421c", "hp_e364a8973c287ebf"]</data>
  <data key="d4">False</data>
</node>
