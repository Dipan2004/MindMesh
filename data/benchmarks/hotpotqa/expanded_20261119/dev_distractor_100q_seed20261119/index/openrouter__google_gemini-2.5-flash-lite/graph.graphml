  <data key="d2">[{"text": "Ingwald \"Ingo\" Preminger (25 February 1911 in Czernowitz, Austria-Hungary (now Chernivtsi, Ukraine) – 7 June 2006 in Pacific Palisades, California) was a film producer.", "chunk_id": "11399d9e6ed9e2a4", "doc_id": "hp_2f3cd8d24b5f56f1"}]</data>
