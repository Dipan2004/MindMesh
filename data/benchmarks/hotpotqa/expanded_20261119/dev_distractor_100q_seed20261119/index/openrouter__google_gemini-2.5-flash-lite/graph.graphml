<edge source="Morchella ulmaria" target="Midwestern North America">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">Morchella ulmaria occurs in the forests of Midwestern North America.</data>
  <data key="d7">[{"text": "The species occurs in the forests of Midwestern North America, often associated with white ash (\"Fraxinus americana\"), the American tulip tree (\"Liriodendron tulipifera\") or species of maple or elm.", "chunk_id": "90e3a51e13c6358a", "doc_id": "hp_a1c843f7fa58c1d3", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_a1c843f7fa58c1d3</data>
</edge>
<edge source="Morchella ulmaria" target="Fraxinus americana">
  <data key="d5">["ASSOCIATED_WITH"]</data>
  <data key="d6">Morchella ulmaria is often associated with Fraxinus americana (white ash).</data>
  <data key="d7">[{"text": "The species occurs in the forests of Midwestern North America, often associated with white ash (\"Fraxinus americana\"), the American tulip tree (\"Liriodendron tulipifera\") or species of maple or elm.", "chunk_id": "90e3a51e13c6358a", "doc_id": "hp_a1c843f7fa58c1d3", "type": "ASSOCIATED_WITH"}]</data>
  <data key="d8">hp_a1c843f7fa58c1d3</data>
</edge>
