</node>
<node id="Little Otik">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Little Otik is a feature-length film by Jan Švankmajer that includes Meat Love as a commercial.", "chunk_id": "78d702eb64aa0c99", "doc_id": "hp_89ef8e61a35751f3"}]</data>
  <data key="d2">[{"text": "It appears as a commercial in Švankmajer's feature-length film \"Little Otik\".", "chunk_id": "78d702eb64aa0c99", "doc_id": "hp_89ef8e61a35751f3"}]</data>
  <data key="d3">["hp_89ef8e61a35751f3"]</data>
  <data key="d4">False</data>
</node>
<node id="MTV">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "MTV is a media organization that has shown the short film Meat Love.", "chunk_id": "78d702eb64aa0c99", "doc_id": "hp_89ef8e61a35751f3"}, {"text": "A television network that played a significant role in popularizing Madonna's music and image.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d2">[{"text": "It has also been shown on MTV.", "chunk_id": "78d702eb64aa0c99", "doc_id": "hp_89ef8e61a35751f3"}, {"text": "Her first video to receive attention on MTV was \"Borderline\", followed by \"Lucky Star\" and \"Like a Virgin\", which popularized Madonna's image and fashion among younger generation.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d3">["hp_89ef8e61a35751f3", "hp_f2eafe05aec63f00"]</data>
  <data key="d4">False</data>
</node>
