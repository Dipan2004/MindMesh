  <data key="d2">[{"text": "Resembling the British dance competition series \"Got to Dance\", the show was first shown on January 4, 2011, and was headlined by the \"American Idol\" judge Paula Abdul as lead judge with Andrew Günsberg as host.", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}]</data>
