<edge source="Ibutilide" target="Class III antiarrhythmic agent">
  <data key="d5">["IS_A"]</data>
  <data key="d6">Ibutilide is a type of Class III antiarrhythmic agent.</data>
  <data key="d7">[{"text": "Ibutilide is a Class III antiarrhythmic agent that is indicated for acute cardioconversion of atrial fibrillation and atrial flutter of a recent onset to sinus rhythm.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803", "type": "IS_A"}]</data>
  <data key="d8">hp_6db35b9eeaff2803</data>
</edge>
<edge source="Ibutilide" target="atrial fibrillation">
  <data key="d5">["INDICATED_FOR"]</data>
  <data key="d6">Ibutilide is indicated for the treatment of atrial fibrillation.</data>
  <data key="d7">[{"text": "Ibutilide is a Class III antiarrhythmic agent that is indicated for acute cardioconversion of atrial fibrillation and atrial flutter of a recent onset to sinus rhythm.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803", "type": "INDICATED_FOR"}]</data>
  <data key="d8">hp_6db35b9eeaff2803</data>
</edge>
<edge source="Ibutilide" target="atrial flutter">
  <data key="d5">["INDICATED_FOR"]</data>
  <data key="d6">Ibutilide is indicated for the treatment of atrial flutter.</data>
  <data key="d7">[{"text": "Ibutilide is a Class III antiarrhythmic agent that is indicated for acute cardioconversion of atrial fibrillation and atrial flutter of a recent onset to sinus rhythm.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803", "type": "INDICATED_FOR"}]</data>
