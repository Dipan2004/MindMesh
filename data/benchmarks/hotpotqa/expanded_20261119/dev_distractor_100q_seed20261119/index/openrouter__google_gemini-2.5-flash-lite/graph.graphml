<node id="podengos">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Podengos are the Portuguese name for a kind of breeds.", "chunk_id": "4fb94dbd625515c2", "doc_id": "hp_0a96d1fd16b1ff98"}]</data>
  <data key="d2">[{"text": "In Spanish, this kind of breeds are called \"podencos\" and in Portuguese, \"podengos\".", "chunk_id": "4fb94dbd625515c2", "doc_id": "hp_0a96d1fd16b1ff98"}]</data>
