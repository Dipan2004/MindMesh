</node>
<node id="stellar mass black hole">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A black hole formed from the gravitational collapse of a massive star.", "chunk_id": "b630ca764564e39f", "doc_id": "hp_6ffa173614708165"}]</data>
  <data key="d2">[{"text": "The system is made up of a stellar mass black hole and a companion star.", "chunk_id": "b630ca764564e39f", "doc_id": "hp_6ffa173614708165"}]</data>
  <data key="d3">["hp_6ffa173614708165"]</data>
  <data key="d4">False</data>
</node>
<node id="companion star">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A star that orbits another celestial body, in this case, a black hole.", "chunk_id": "b630ca764564e39f", "doc_id": "hp_6ffa173614708165"}]</data>
  <data key="d2">[{"text": "The system is made up of a stellar mass black hole and a companion star.", "chunk_id": "b630ca764564e39f", "doc_id": "hp_6ffa173614708165"}]</data>
