  <data key="d2">[{"text": "He married Catherine Brockholes (before 1724–1784), daughter of John Brockholes, on 8 November 1739.", "chunk_id": "82f681104648a1d9", "doc_id": "hp_d31213ec63e217cc"}]</data>
