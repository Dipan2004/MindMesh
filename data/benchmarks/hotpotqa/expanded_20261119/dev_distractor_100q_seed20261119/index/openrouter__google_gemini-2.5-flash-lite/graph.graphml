  <data key="d2">[{"text": "Lantana is a genus of about 150 species of perennial flowering plants in the verbena family, Verbenaceae.", "chunk_id": "e4f91f3cba1a9e61", "doc_id": "hp_112a39087a5960d5"}]</data>
