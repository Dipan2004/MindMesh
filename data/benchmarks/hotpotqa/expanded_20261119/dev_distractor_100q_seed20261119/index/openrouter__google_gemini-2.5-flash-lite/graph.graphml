<edge source="Suddenlink Communications" target="Altice USA">
  <data key="d5">["SUBSIDIARY_OF"]</data>
  <data key="d6">Suddenlink Communications is a subsidiary of Altice USA.</data>
  <data key="d7">[{"text": "Suddenlink Communications is an American telecommunications subsidiary of Altice USA which specializes in cable television, high-speed internet, broadband phone, home security and advertising.", "chunk_id": "830f5fe0561239db", "doc_id": "hp_a5b89b682cc56c9c", "type": "SUBSIDIARY_OF"}]</data>
  <data key="d8">hp_a5b89b682cc56c9c</data>
</edge>
<edge source="Suddenlink Communications" target="Cablevision">
  <data key="d5">["COMBINED_WITH"]</data>
  <data key="d6">Suddenlink Communications was combined with Cablevision.</data>
  <data key="d7">[{"text": "After Altice acquired Cablevision Systems Corporation (Cablevision) on November 30, 2016 Suddenlink was combined with Cablevision to become Altice's American division known as Altice USA.", "chunk_id": "830f5fe0561239db", "doc_id": "hp_a5b89b682cc56c9c", "type": "COMBINED_WITH"}]</data>
  <data key="d8">hp_a5b89b682cc56c9c</data>
</edge>
<edge source="Altice USA" target="Cablevision Systems Corporation">
  <data key="d5">["ACQUIRED_BY"]</data>
  <data key="d6">Altice USA acquired Cablevision Systems Corporation.</data>
  <data key="d7">[{"text": "After Altice acquired Cablevision Systems Corporation (Cablevision) on November 30, 2016 Suddenlink was combined with Cablevision to become Altice's American division known as Altice USA.", "chunk_id": "830f5fe0561239db", "doc_id": "hp_a5b89b682cc56c9c", "type": "ACQUIRED_BY"}]</data>
  <data key="d8">hp_a5b89b682cc56c9c</data>
</edge>
<edge source="Cablevision" target="Altice USA">
  <data key="d5">["PART_OF"]</data>
  <data key="d6">Cablevision became part of Altice USA after being combined with Suddenlink.</data>
  <data key="d7">[{"text": "After Altice acquired Cablevision Systems Corporation (Cablevision) on November 30, 2016 Suddenlink was combined with Cablevision to become Altice's American division known as Altice USA.", "chunk_id": "830f5fe0561239db", "doc_id": "hp_a5b89b682cc56c9c", "type": "PART_OF"}]</data>
  <data key="d8">hp_a5b89b682cc56c9c</data>
</edge>
<edge source="Cablevision" target="Optimum">
  <data key="d5">["HAS_BRAND"]</data>
  <data key="d6">Cablevision used Optimum as its service brand name for its products.</data>
  <data key="d7">[{"text": "Together with Optimum, the service brand name used by Cablevision for its products, Altice USA became the United States' fourth largest cable operator with 4.6 million subscribers and the sixth largest pay tv service provider with 3.50 million subscribers.", "chunk_id": "830f5fe0561239db", "doc_id": "hp_a5b89b682cc56c9c", "type": "HAS_BRAND"}]</data>
  <data key="d8">hp_a5b89b682cc56c9c</data>
</edge>
