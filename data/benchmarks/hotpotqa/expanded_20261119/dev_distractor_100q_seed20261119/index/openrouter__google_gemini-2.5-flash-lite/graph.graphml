<node id="Erin Andrews">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Erin Andrews is an American sportscaster and television personality.", "chunk_id": "001f6fdf75f523a2", "doc_id": "hp_0751ab2b5952161c"}, {"text": "Erin Andrews is a person who was replaced by Samantha Ponder on \"College GameDay\".", "chunk_id": "ffb58debd6825270", "doc_id": "hp_3b63ac1b118f03ce"}, {"text": "A co-host of the television series Dancing with the Stars.", "chunk_id": "1ae268ff3c0ca6ac", "doc_id": "hp_ac20c1a6b62d6705"}]</data>
  <data key="d2">[{"text": "Erin Jill Andrews (born May 4, 1978) is an American sportscaster and television personality.", "chunk_id": "001f6fdf75f523a2", "doc_id": "hp_0751ab2b5952161c"}, {"text": "Ponder replaced Erin Andrews on \"College GameDay\" Saturdays at 10 AM ET on ESPN, as well as co-host of the Saturday 9 AM ET edition on ESPNU.", "chunk_id": "ffb58debd6825270", "doc_id": "hp_3b63ac1b118f03ce"}, {"text": "The show is hosted by Tom Bergeron, alongside Erin Andrews, who became co-host in season eighteen.", "chunk_id": "1ae268ff3c0ca6ac", "doc_id": "hp_ac20c1a6b62d6705"}]</data>
  <data key="d3">["hp_0751ab2b5952161c", "hp_3b63ac1b118f03ce", "hp_ac20c1a6b62d6705"]</data>
  <data key="d4">False</data>
</node>
<node id="Dancing with the Stars">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Dancing with the Stars is a show hosted by Erin Andrews for ABC.", "chunk_id": "001f6fdf75f523a2", "doc_id": "hp_0751ab2b5952161c"}, {"text": "An American dance competition television series.", "chunk_id": "1ae268ff3c0ca6ac", "doc_id": "hp_ac20c1a6b62d6705"}]</data>
  <data key="d2">[{"text": "She hosts \"Dancing with the Stars\" for ABC and is a sideline reporter for Fox NFL.", "chunk_id": "001f6fdf75f523a2", "doc_id": "hp_0751ab2b5952161c"}, {"text": "Dancing with the Stars is an American dance competition television series that premiered on June 1, 2005, on ABC.", "chunk_id": "1ae268ff3c0ca6ac", "doc_id": "hp_ac20c1a6b62d6705"}]</data>
  <data key="d3">["hp_0751ab2b5952161c", "hp_ac20c1a6b62d6705"]</data>
  <data key="d4">False</data>
</node>
<node id="ABC">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "ABC is a television network for which Erin Andrews hosts \"Dancing with the Stars\".", "chunk_id": "001f6fdf75f523a2", "doc_id": "hp_0751ab2b5952161c"}, {"text": "A television network that revived the series in the 1980s.", "chunk_id": "aff35d971d199517", "doc_id": "hp_1ccc4746739c0eec"}, {"text": "The television network where The Fantastic Miss Piggy Show aired.", "chunk_id": "9fddbf6c969855ac", "doc_id": "hp_6926160a248b43c3"}, {"text": "The initial broadcaster of the show Good News Week.", "chunk_id": "fe189654c6399c85", "doc_id": "hp_993b59bab3ae17d3"}, {"text": "The television network on which Dancing with the Stars premiered.", "chunk_id": "1ae268ff3c0ca6ac", "doc_id": "hp_ac20c1a6b62d6705"}]</data>
  <data key="d2">[{"text": "She hosts \"Dancing with the Stars\" for ABC and is a sideline reporter for Fox NFL.", "chunk_id": "001f6fdf75f523a2", "doc_id": "hp_0751ab2b5952161c"}, {"text": "The series was revived for ABC in the 1980s, and was hosted primarily by Jack Palance.", "chunk_id": "aff35d971d199517", "doc_id": "hp_1ccc4746739c0eec"}, {"text": "The Fantastic Miss Piggy Show is a one-hour special that aired on ABC on September 17, 1982.", "chunk_id": "9fddbf6c969855ac", "doc_id": "hp_6926160a248b43c3"}, {"text": "The show's initial run aired on ABC until being bought by Network Ten in 1999.", "chunk_id": "fe189654c6399c85", "doc_id": "hp_993b59bab3ae17d3"}, {"text": "Dancing with the Stars is an American dance competition television series that premiered on June 1, 2005, on ABC.", "chunk_id": "1ae268ff3c0ca6ac", "doc_id": "hp_ac20c1a6b62d6705"}]</data>
  <data key="d3">["hp_0751ab2b5952161c", "hp_1ccc4746739c0eec", "hp_6926160a248b43c3", "hp_993b59bab3ae17d3", "hp_ac20c1a6b62d6705"]</data>
  <data key="d4">False</data>
</node>
