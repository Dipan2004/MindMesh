<edge source="Mirosław Dreszer" target="Tychy">
  <data key="d5">["BORN_IN"]</data>
  <data key="d6">Mirosław Dreszer was born in Tychy.</data>
  <data key="d7">[{"text": "Mirosław Dreszer (born 28 August 1965 in Tychy) is a Polish former football player who played goalkeeper.", "chunk_id": "2463a2e6b54ba2b9", "doc_id": "hp_3d488dbab399d265", "type": "BORN_IN"}]</data>
  <data key="d8">hp_3d488dbab399d265</data>
