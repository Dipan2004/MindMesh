<node id="Gorgeous Guy">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The name given to a man whose photo appeared on an internet message board.", "chunk_id": "95ce3af60d609d99", "doc_id": "hp_c1d373fc7a1fc058"}]</data>
  <data key="d2">[{"text": "The Gorgeous Guy was the name given to a man whose photo appeared on an internet message board, with various posts describing his life.", "chunk_id": "95ce3af60d609d99", "doc_id": "hp_c1d373fc7a1fc058"}]</data>
  <data key="d3">["hp_c1d373fc7a1fc058"]</data>
