<node id="Robert Oliveri">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Robert Oliveri is a former American actor.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}]</data>
  <data key="d2">[{"text": "Robert Dane Oliveri (born April 28, 1978) is a former American actor.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}]</data>
  <data key="d3">["hp_23773bc65d0154a3"]</data>
  <data key="d4">False</data>
</node>
<node id="Nick Szalinski">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Nick Szalinski is a character portrayed by Robert Oliveri.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}]</data>
  <data key="d2">[{"text": "He is best known for his portrayal of Nick Szalinski in the 1989 Disney film, \"Honey, I Shrunk the Kids\", for which he was nominated for a Young Artist Award and a Saturn Award.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}]</data>
  <data key="d3">["hp_23773bc65d0154a3"]</data>
  <data key="d4">False</data>
</node>
<node id="Young Artist Award">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Young Artist Award is an award for which Robert Oliveri was nominated.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}, {"text": "Young Artist Award is an award for which Amy O'Neill was nominated.", "chunk_id": "6f7849fc13c087db", "doc_id": "hp_7ed9ce59d4321c4f"}]</data>
  <data key="d2">[{"text": "He is best known for his portrayal of Nick Szalinski in the 1989 Disney film, \"Honey, I Shrunk the Kids\", for which he was nominated for a Young Artist Award and a Saturn Award.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}, {"text": "After appearing in several sitcoms and starring as Molly Stark on \"The Young and the Restless\" in 1986, she was cast in her notable role as Amy Szalinski in the 1989 Disney film, \"Honey, I Shrunk the Kids\", for which she was nominated for a Young Artist Award.", "chunk_id": "6f7849fc13c087db", "doc_id": "hp_7ed9ce59d4321c4f"}]</data>
  <data key="d3">["hp_23773bc65d0154a3", "hp_7ed9ce59d4321c4f"]</data>
  <data key="d4">False</data>
</node>
<node id="Saturn Award">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Saturn Award is an award for which Robert Oliveri was nominated.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}]</data>
  <data key="d2">[{"text": "He is best known for his portrayal of Nick Szalinski in the 1989 Disney film, \"Honey, I Shrunk the Kids\", for which he was nominated for a Young Artist Award and a Saturn Award.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}]</data>
  <data key="d3">["hp_23773bc65d0154a3"]</data>
  <data key="d4">False</data>
</node>
<node id="Honey, I Shrunk the Audience">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "\"Honey, I Shrunk the Audience\" is a 3D film.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}, {"text": "Honey, I Shrunk the Audience! is a 3-D film spin-off released in 1994.", "chunk_id": "3ee681daaaaf1d61", "doc_id": "hp_122377c2fa6d536d"}]</data>
  <data key="d2">[{"text": "He reprised the role in the 1992 sequel, \"Honey, I Blew Up the Kid\" and the 3D film, \"Honey, I Shrunk the Audience\".", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}, {"text": "Marcia Ann Strassman (April 28, 1948\r\n\r\n– October 24, 2014) was an American actress and singer, best known for her roles as Nurse Margie Cutler on \"M*A*S*H\", as Julie Kotter on \"Welcome Back, Kotter\" and as Diane Szalinski in the feature film \"Honey, I Shrunk the Kids\" (1989); its sequel \"Honey, I Blew Up the Kid\" (1992); and the 3-D film spin-off \"Honey, I Shrunk the Audience!\" (1994), which was shown at several Disney theme parks through mid-2010.", "chunk_id": "3ee681daaaaf1d61", "doc_id": "hp_122377c2fa6d536d"}]</data>
  <data key="d3">["hp_122377c2fa6d536d", "hp_23773bc65d0154a3"]</data>
  <data key="d4">False</data>
</node>
<node id="Kevin">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Kevin is a character played by Robert Oliveri, known as Winona Ryder's little brother.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}]</data>
  <data key="d2">[{"text": "He is also known as Kevin, Winona Ryder's little brother, in Tim Burton's \"Edward Scissorhands\".", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}]</data>
  <data key="d3">["hp_23773bc65d0154a3"]</data>
  <data key="d4">False</data>
</node>
<node id="Winona Ryder">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Winona Ryder is an actress whose brother is portrayed by Robert Oliveri.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}]</data>
  <data key="d2">[{"text": "He is also known as Kevin, Winona Ryder's little brother, in Tim Burton's \"Edward Scissorhands\".", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}]</data>
