<edge source="Town Bloody Hall" target="feminist history">
  <data key="d5">["PART_OF"]</data>
  <data key="d6">The "Town Bloody Hall" debate was intended to become a concrete moment in feminist history.</data>
  <data key="d7">[{"text": "The recording of the debate was intended to ensure the unbiased documentation, allowing it to become a concrete moment in feminist history.", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e", "type": "PART_OF"}]</data>
  <data key="d8">hp_535589d1805f024e</data>
</edge>
