  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A type of sport that involves feats of strength.", "chunk_id": "fb43fe49d9c01907", "doc_id": "hp_1183c20fecf2a891"}]</data>
  <data key="d2">[{"text": "The All-American Strongman Challenge is a leading competition in strength athletics that takes place within the annual Californian FitExpo.", "chunk_id": "fb43fe49d9c01907", "doc_id": "hp_1183c20fecf2a891"}]</data>
  <data key="d3">["hp_1183c20fecf2a891"]</data>
  <data key="d4">False</data>
</node>
<node id="Californian FitExpo">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "An annual event in California related to fitness.", "chunk_id": "fb43fe49d9c01907", "doc_id": "hp_1183c20fecf2a891"}]</data>
  <data key="d2">[{"text": "The All-American Strongman Challenge is a leading competition in strength athletics that takes place within the annual Californian FitExpo.", "chunk_id": "fb43fe49d9c01907", "doc_id": "hp_1183c20fecf2a891"}]</data>
  <data key="d3">["hp_1183c20fecf2a891"]</data>
  <data key="d4">False</data>
</node>
<node id="North America">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A continent comprising the northernmost part of the Americas.", "chunk_id": "fb43fe49d9c01907", "doc_id": "hp_1183c20fecf2a891"}, {"text": "In North America, Lonicera morrowii is commonly the first deciduous shrub with foliage in March.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}, {"text": "North America is a region where one species of Silybum has been introduced.", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}, {"text": "North America is a continent where Echinacea species are found growing.", "chunk_id": "940bcdf581a12ef8", "doc_id": "hp_69fd7358b20b9865"}, {"text": "A continent across which the Native Tour traveled.", "chunk_id": "fbf2e81187688813", "doc_id": "hp_bf77c9d36b5389d5"}, {"text": "A continent where the emerald ash borer is an invasive and destructive species, and where much of the research on its biology is focused.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}, {"text": "North America is a continent where Davey Tree is the largest residential tree care company.", "chunk_id": "a9e806e2d99c31d9", "doc_id": "hp_d2d8272fe5506239"}, {"text": "A continent where the album was released on July 23, 2013.", "chunk_id": "8fa693f0549c8311", "doc_id": "hp_f1ec6c8b9136d77b"}]</data>
  <data key="d2">[{"text": "Although North America has a number of prestigious strongman events determining the \"Strongest Man in America\", the \"Strongest Man in Canada\" and the \"Strongest Man in North America\", the All-American Strongman Challenge has added kudos because it is open to entrants from overseas with the potential to bring in leading international competitors as well.", "chunk_id": "fb43fe49d9c01907", "doc_id": "hp_1183c20fecf2a891"}, {"text": "It leafs out quite early in the spring, and in North America is commonly the first deciduous shrub with foliage in March.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}, {"text": "One species has been introduced elsewhere, including in North America.", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}, {"text": "They are found only in eastern and central North America, where they are found growing in moist to dry prairies and open wooded areas.", "chunk_id": "940bcdf581a12ef8", "doc_id": "hp_69fd7358b20b9865"}, {"text": "The tour has traveled across five continents; Asia, Europe, Oceania, North America, and Africa.", "chunk_id": "fbf2e81187688813", "doc_id": "hp_bf77c9d36b5389d5"}, {"text": "Outside its native range, it is an invasive species and is highly destructive to ash trees native to northwest Europe and North America.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}, {"text": "It is the largest residential tree care company in North America and was founded in 1880 making it the first national tree care company.", "chunk_id": "a9e806e2d99c31d9", "doc_id": "hp_d2d8272fe5506239"}, {"text": "It was released on July 23, 2013 in North America and was released on July 29, 2013 around the world through Vagrant Records, Rough Trade Records and Communion Records.", "chunk_id": "8fa693f0549c8311", "doc_id": "hp_f1ec6c8b9136d77b"}]</data>
  <data key="d3">["hp_1183c20fecf2a891", "hp_2dbc22a588912449", "hp_4fb3a0aca6cf5736", "hp_69fd7358b20b9865", "hp_bf77c9d36b5389d5", "hp_cc129f1449a3ee73", "hp_d2d8272fe5506239", "hp_f1ec6c8b9136d77b"]</data>
  <data key="d4">False</data>
</node>
<node id="Strongest Man in America">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A strongman event to determine the strongest man in America.", "chunk_id": "fb43fe49d9c01907", "doc_id": "hp_1183c20fecf2a891"}]</data>
  <data key="d2">[{"text": "Although North America has a number of prestigious strongman events determining the \"Strongest Man in America\", the \"Strongest Man in Canada\" and the \"Strongest Man in North America\", the All-American Strongman Challenge has added kudos because it is open to entrants from overseas with the potential to bring in leading international competitors as well.", "chunk_id": "fb43fe49d9c01907", "doc_id": "hp_1183c20fecf2a891"}]</data>
  <data key="d3">["hp_1183c20fecf2a891"]</data>
  <data key="d4">False</data>
</node>
