  <data key="d7">[{"text": "Nelson is an American rock band founded by singer/songwriters Matthew and Gunnar Nelson (twin sons of Ricky Nelson and Kristin Nelson).", "chunk_id": "692762cf78f5a878", "doc_id": "hp_52a5e192172e1781", "type": "CHILD_OF"}]</data>
