<node id="Redcliffe">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Redcliffe is a location where John Frawley was born.", "chunk_id": "f15e52cd4eed7a68", "doc_id": "hp_36218807b21ee7a5"}]</data>
  <data key="d2">[{"text": "John Frawley (born 4 July 1965 in Redcliffe) is an Australian retired tennis player.", "chunk_id": "f15e52cd4eed7a68", "doc_id": "hp_36218807b21ee7a5"}]</data>
  <data key="d3">["hp_36218807b21ee7a5"]</data>
  <data key="d4">False</data>
</node>
<node id="tennis">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Tennis is the sport played by John Frawley.", "chunk_id": "f15e52cd4eed7a68", "doc_id": "hp_36218807b21ee7a5"}, {"text": "Tennis is a passion of Alexander Amini that he combined in his project.", "chunk_id": "fd7d14febf5321c2", "doc_id": "hp_3b72e36a921b4635"}, {"text": "Tennis is the sport that Ross Case played professionally.", "chunk_id": "9f06e9e836369a70", "doc_id": "hp_9e113091020e9e0d"}]</data>
  <data key="d2">[{"text": "John Frawley (tennis)", "chunk_id": "f15e52cd4eed7a68", "doc_id": "hp_36218807b21ee7a5"}, {"text": "He is the first prize winner of the 23rd European Union Contest for Young Scientists and the 47th BT Young Scientist and Technology Exhibition in 2011 at the age of fifteen for his project entitled: “Tennis Sensor Data Analysis: An Automated System for Macro Motion Refinement”, in which he combined his passions for computer science, mathematics, and tennis.", "chunk_id": "fd7d14febf5321c2", "doc_id": "hp_3b72e36a921b4635"}, {"text": "Ross Case (born 1 November 1951) is an Australian former tennis player.", "chunk_id": "9f06e9e836369a70", "doc_id": "hp_9e113091020e9e0d"}]</data>
  <data key="d3">["hp_36218807b21ee7a5", "hp_3b72e36a921b4635", "hp_9e113091020e9e0d"]</data>
  <data key="d4">False</data>
</node>
<node id="World No. 35">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "World No. 35 is the career-high singles ranking achieved by John Frawley.", "chunk_id": "f15e52cd4eed7a68", "doc_id": "hp_36218807b21ee7a5"}]</data>
  <data key="d2">[{"text": "He reached a career-high singles ranking of World No. 35 in January 1988.", "chunk_id": "f15e52cd4eed7a68", "doc_id": "hp_36218807b21ee7a5"}]</data>
