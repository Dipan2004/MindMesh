  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">Zaj was formed in Milan.</data>
  <data key="d7">[{"text": "Zaj was an experimental music and performance art group formed in 1959 in Milan, Italy by composers and intermedia artists Walter Marchetti and Juan Hidalgo with the support of the American composer John Cage.", "chunk_id": "b647f648f08782f6", "doc_id": "hp_205b52451626bfb6", "type": "LOCATED_IN"}]</data>
