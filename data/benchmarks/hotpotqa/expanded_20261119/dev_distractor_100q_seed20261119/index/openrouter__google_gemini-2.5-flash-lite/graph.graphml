  <data key="d6">The Colorado Rapids defeated FC Dallas.</data>
  <data key="d7">[{"text": "Upon the completion of the regular season the 2010 MLS Cup Playoffs culminated on November 21 with a 2–1 victory by the Colorado Rapids over FC Dallas at Toronto's BMO Field.", "chunk_id": "1221adbf4371c7a0", "doc_id": "hp_60e7d9ac9e049733", "type": "DEFEATED"}]</data>
