  <data key="d2">[{"text": "Original guitarist Peter Green also took part in the sessions for \"Brown Eyes\", but his playing on the track is not credited on the album.", "chunk_id": "9ed3e6f68a811c70", "doc_id": "hp_6ba5d00f572e646d"}]</data>
