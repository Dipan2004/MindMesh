<edge source="Pinguicula moranensis" target="butterwort">
  <data key="d5">["IS_A"]</data>
  <data key="d6">Pinguicula moranensis is a species of butterwort.</data>
  <data key="d7">[{"text": "A species of butterwort, it forms summer rosettes of flat, succulent leaves up to 10\tcentimeters (4\tin) long, which are covered in mucilaginous (sticky) glands that attract, trap, and digest arthropod prey.", "chunk_id": "c64585feaab7ebe5", "doc_id": "hp_32c049306a94f329", "type": "IS_A"}]</data>
  <data key="d8">hp_32c049306a94f329</data>
</edge>
