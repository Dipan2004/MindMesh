  <data key="d2">[{"text": "Leucophyllum (barometer bush or barometerbush) is a genus of evergreen shrubs in the figwort family, Scrophulariaceae, native to the southwestern United States and Mexico.", "chunk_id": "d3f92c958cb5561c", "doc_id": "hp_51931a701df55281"}]</data>
