<node id="North Korean intelligence">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An intelligence agency that kidnapped Shin Sang-ok in 1978.", "chunk_id": "f5d5ccb7eff4c8c9", "doc_id": "hp_b6688ab9041dc4a0"}]</data>
  <data key="d2">[{"text": "Director Shin had been kidnapped in 1978 by North Korean intelligence on the orders of Kim Jong-il, son of the then-ruling Kim Il-sung.", "chunk_id": "f5d5ccb7eff4c8c9", "doc_id": "hp_b6688ab9041dc4a0"}]</data>
  <data key="d3">["hp_b6688ab9041dc4a0"]</data>
  <data key="d4">False</data>
</node>
