<node id="Undercover Cat">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A book that the 1965 film 'That Darn Cat!' was based on.", "chunk_id": "d841470ff7de5ff5", "doc_id": "hp_557f842640eb825d"}, {"text": "Undercover Cat is a 1963 novel that the film That Darn Cat! was based on.", "chunk_id": "15791e4c51cf1c4f", "doc_id": "hp_91f76bb6a0249df4"}]</data>
  <data key="d2">[{"text": "It is a remake of the 1965 film \"That Darn Cat!\", which in turn was based on the book \"Undercover Cat\" by Gordon and Mildred Gordon.", "chunk_id": "d841470ff7de5ff5", "doc_id": "hp_557f842640eb825d"}, {"text": "The film was based on the 1963 novel \"Undercover Cat\" by Gordon and Mildred Gordon and was directed by Robert Stevenson.", "chunk_id": "15791e4c51cf1c4f", "doc_id": "hp_91f76bb6a0249df4"}]</data>
  <data key="d3">["hp_557f842640eb825d", "hp_91f76bb6a0249df4"]</data>
  <data key="d4">False</data>
</node>
<node id="Gordon and Mildred Gordon">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The authors of the book 'Undercover Cat'.", "chunk_id": "d841470ff7de5ff5", "doc_id": "hp_557f842640eb825d"}, {"text": "Gordon and Mildred Gordon are the authors of the 1963 novel \"Undercover Cat\".", "chunk_id": "15791e4c51cf1c4f", "doc_id": "hp_91f76bb6a0249df4"}]</data>
  <data key="d2">[{"text": "It is a remake of the 1965 film \"That Darn Cat!\", which in turn was based on the book \"Undercover Cat\" by Gordon and Mildred Gordon.", "chunk_id": "d841470ff7de5ff5", "doc_id": "hp_557f842640eb825d"}, {"text": "The film was based on the 1963 novel \"Undercover Cat\" by Gordon and Mildred Gordon and was directed by Robert Stevenson.", "chunk_id": "15791e4c51cf1c4f", "doc_id": "hp_91f76bb6a0249df4"}]</data>
  <data key="d3">["hp_557f842640eb825d", "hp_91f76bb6a0249df4"]</data>
  <data key="d4">False</data>
</node>
<node id="Bob Spiers">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The director of the 1997 film 'That Darn Cat'.", "chunk_id": "d841470ff7de5ff5", "doc_id": "hp_557f842640eb825d"}]</data>
  <data key="d2">[{"text": "It is directed by British TV veteran Bob Spiers (most famous for \"Fawlty Towers\", as well as \"Spice World\") and written by Scott Alexander and Larry Karaszewski, best known for \"Ed Wood\" and the first two \"Problem Child\" films.", "chunk_id": "d841470ff7de5ff5", "doc_id": "hp_557f842640eb825d"}]</data>
  <data key="d3">["hp_557f842640eb825d"]</data>
