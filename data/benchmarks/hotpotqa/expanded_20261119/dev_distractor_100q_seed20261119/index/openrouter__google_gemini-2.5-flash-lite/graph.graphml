  <data key="d5">["DESTINATION"]</data>
  <data key="d6">Convoy TM 1 attempted to reach Gibraltar.</data>
  <data key="d7">[{"text": "Nine tankers, escorted by Royal Navy warships, attempted to reach Gibraltar from Trinidad.", "chunk_id": "c88e8c3532f53397", "doc_id": "hp_1ac7b848b0417759", "type": "DESTINATION"}]</data>
  <data key="d8">hp_1ac7b848b0417759</data>
</edge>
