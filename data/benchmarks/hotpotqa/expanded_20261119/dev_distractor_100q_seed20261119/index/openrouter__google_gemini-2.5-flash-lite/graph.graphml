<node id="Fluxus Organization">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The organization of Fluxus artists, where Shigeko Kubota was deemed 'Vice Chairman'.", "chunk_id": "bb303342f684188a", "doc_id": "hp_25e106b688a6f938"}]</data>
  <data key="d2">[{"text": "Kubota was deemed \"Vice Chairman\" of the Fluxus Organization by Maciunas.", "chunk_id": "bb303342f684188a", "doc_id": "hp_25e106b688a6f938"}]</data>
