  <data key="d7">[{"text": "Charles Louis Ambroise Thomas (5 August 1811 – 12 February 1896) was a French composer, best known for his operas \"Mignon\" (1866) and \"Hamlet\" (1868, after Shakespeare) and as Director of the Conservatoire de Paris from 1871 till his death.", "chunk_id": "3facf7eaa59386bf", "doc_id": "hp_75db37c8dc73936b", "type": "WROTE"}]</data>
