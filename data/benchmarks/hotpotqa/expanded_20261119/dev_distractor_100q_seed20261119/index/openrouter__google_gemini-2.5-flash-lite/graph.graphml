<node id="Madonna (album)">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Madonna's eponymous debut album, which included her early videos.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d2">[{"text": "\"Madonna\" (1984), which became the best-selling videocassette of 1985.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d3">["hp_f2eafe05aec63f00"]</data>
