  <data key="d7">[{"text": "It aims to show that the Korean people \"can live a glorious life only in the bosom of the Great Leader and socialist fatherland\".", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882", "type": "DEPICTS"}]</data>
