  <data key="d7">[{"text": "It is named for the comarca of Las Encartaciones (Enkarterri), in the province of Biscay (Bizkaia).", "chunk_id": "6c5e6325ed3b9eba", "doc_id": "hp_0a88edb8b9162de6", "type": "PART_OF"}, {"text": "The Villanuco de Las Encartaciones (Basque: \"Enkarterriko billanuko\" , Cantabrian: \"Villanucu\", English: Little Villein of Las Encartaciones ) is a Spanish breed of dog typical of the region of Las Encartaciones (Biscay), Cantabria and northern Burgos (Spain).", "chunk_id": "e020cb702daeb7ff", "doc_id": "hp_0c6f0946ec61d258", "type": "PART_OF"}]</data>
  <data key="d8">hp_0a88edb8b9162de6</data>
</edge>
