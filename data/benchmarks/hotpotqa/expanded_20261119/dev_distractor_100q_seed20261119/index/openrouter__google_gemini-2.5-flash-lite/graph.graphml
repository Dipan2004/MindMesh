  <data key="d2">[{"text": "The song was made available via digital download, and is featured on the soundtrack of the film \"Miss Peregrine's Home for Peculiar Children\" which was directed by Tim Burton.", "chunk_id": "1e3c115665e783ed", "doc_id": "hp_0f7ce516b52f11b8"}]</data>
