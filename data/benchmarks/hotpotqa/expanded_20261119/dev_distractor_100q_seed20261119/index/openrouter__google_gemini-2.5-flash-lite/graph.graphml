<node id="Hugpatch Records">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Hugpatch Records is a record label based out of Brooklyn, New York.", "chunk_id": "ec71908382284000", "doc_id": "hp_353258028a95f6b9"}]</data>
  <data key="d2">[{"text": "Hugpatch Records is a record label based out of Brooklyn, New York.", "chunk_id": "ec71908382284000", "doc_id": "hp_353258028a95f6b9"}]</data>
  <data key="d3">["hp_353258028a95f6b9"]</data>
  <data key="d4">False</data>
</node>
<node id="New York">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "New York is a state in the United States.", "chunk_id": "ec71908382284000", "doc_id": "hp_353258028a95f6b9"}, {"text": "A city in the United States, mentioned as the location of Columbia University.", "chunk_id": "054fd83d35ee6361", "doc_id": "hp_39d1d2299826213a"}, {"text": "New York is a location where Yannis Pappas was born and raised.", "chunk_id": "6c9e11b0297de1c6", "doc_id": "hp_5788c911b27e82a4"}, {"text": "There is also a wing of the label based in Brooklyn, New York that handles releases in the United States, as well as a German division called Domino Deutschland and a French division called Domino France.", "chunk_id": "ce488a80e2770168", "doc_id": "hp_928492f8f11b78de"}, {"text": "State in the United States, formerly governed by Nelson Rockefeller.", "chunk_id": "54142f25de20997e", "doc_id": "hp_adfdee30bf450e7d"}, {"text": "New York is a location associated with the Metropolitan Museum of Art and Gracie Mansion.", "chunk_id": "1207dedf3633b579", "doc_id": "hp_e2ee24b441181783"}]</data>
  <data key="d2">[{"text": "Hugpatch Records is a record label based out of Brooklyn, New York.", "chunk_id": "ec71908382284000", "doc_id": "hp_353258028a95f6b9"}, {"text": "Born in Chennai, India and educated at the University of Southern California and at Columbia University, New York, he is well known for his collaborative work with Carnatic vocalist Sikkil Gurucharan.", "chunk_id": "054fd83d35ee6361", "doc_id": "hp_39d1d2299826213a"}, {"text": "Yannis Pappas is a Greek-American comedian born and raised in Park Slope Brooklyn, New York.", "chunk_id": "6c9e11b0297de1c6", "doc_id": "hp_5788c911b27e82a4"}, {"text": "There is also a wing of the label based in Brooklyn, New York that handles releases in the United States, as well as a German division called Domino Deutschland and a French division called Domino France.", "chunk_id": "ce488a80e2770168", "doc_id": "hp_928492f8f11b78de"}, {"text": "Nixon considered selecting former Texas Governor John Connally, New York Governor Nelson Rockefeller, and California Governor Ronald Reagan.", "chunk_id": "54142f25de20997e", "doc_id": "hp_adfdee30bf450e7d"}, {"text": "His paintings can be found in the permanent collections of many museums, including the Metropolitan Museum of Art in New York, the National Museum of American Art, the Smithsonian Institution, the White House, Gracie Mansion in New York, the Senate Office Building, and the Museum of the City of New York.", "chunk_id": "1207dedf3633b579", "doc_id": "hp_e2ee24b441181783"}]</data>
  <data key="d3">["hp_353258028a95f6b9", "hp_39d1d2299826213a", "hp_5788c911b27e82a4", "hp_928492f8f11b78de", "hp_adfdee30bf450e7d", "hp_e2ee24b441181783"]</data>
  <data key="d4">False</data>
</node>
<node id="Maxwell Williams">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Maxwell Williams founded Hugpatch Records in 2006.", "chunk_id": "ec71908382284000", "doc_id": "hp_353258028a95f6b9"}]</data>
