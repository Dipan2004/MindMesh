<node id="Karen Joy Fowler">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An American writer and author of the novel 'We Are All Completely Beside Ourselves'.", "chunk_id": "ad844d39ed13dc56", "doc_id": "hp_201f87e77880c43e"}, {"text": "The author of the science fiction short story \"Always\".", "chunk_id": "1c78b034028958a6", "doc_id": "hp_57b69a5d16f4008c"}, {"text": "A prominent writer who has published in \"LCRW\".", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}, {"text": "The American author of the novel 'The Jane Austen Book Club'.", "chunk_id": "3cb5e197f21c88e2", "doc_id": "hp_89406a2f1bd87039"}, {"text": "Karen Joy Fowler is an American author of science fiction, fantasy, and literary fiction.", "chunk_id": "a437d927bff0c11c", "doc_id": "hp_af7dab417584284c"}, {"text": "A science fiction author who initiated the James Tiptree Jr. Award.", "chunk_id": "c247beb830b15400", "doc_id": "hp_bf2ea5d754ea7865"}, {"text": "The author of the 2004 novel 'The Jane Austen Book Club'.", "chunk_id": "960736ea8d07a2ff", "doc_id": "hp_dcfcbf551d8f7cb7"}]</data>
  <data key="d2">[{"text": "We Are All Completely Beside Ourselves is a 2013 novel by the American writer Karen Joy Fowler.", "chunk_id": "ad844d39ed13dc56", "doc_id": "hp_201f87e77880c43e"}, {"text": "\"Always\" is a science fiction short story written by Karen Joy Fowler.", "chunk_id": "1c78b034028958a6", "doc_id": "hp_57b69a5d16f4008c"}, {"text": "Link, Karen Joy Fowler, and Ursula K. Le Guin are among the most prominent of writers who have published in \"LCRW\".", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}, {"text": "The Jane Austen Book Club is a 2004 novel by American author Karen Joy Fowler.", "chunk_id": "3cb5e197f21c88e2", "doc_id": "hp_89406a2f1bd87039"}, {"text": "Karen Joy Fowler (born February 7, 1950) is an American author of science fiction, fantasy, and literary fiction.", "chunk_id": "a437d927bff0c11c", "doc_id": "hp_af7dab417584284c"}, {"text": "It was initiated in February 1991 by science fiction authors Pat Murphy and Karen Joy Fowler, and is awarded and discussed yearly at WisCon.", "chunk_id": "c247beb830b15400", "doc_id": "hp_bf2ea5d754ea7865"}, {"text": "The screenplay, adapted from the 2004 novel of the same name by Karen Joy Fowler, focuses on a book club formed specifically to discuss the six novels written by Jane Austen.", "chunk_id": "960736ea8d07a2ff", "doc_id": "hp_dcfcbf551d8f7cb7"}]</data>
  <data key="d3">["hp_201f87e77880c43e", "hp_57b69a5d16f4008c", "hp_657ef87ed4283a25", "hp_89406a2f1bd87039", "hp_af7dab417584284c", "hp_bf2ea5d754ea7865", "hp_dcfcbf551d8f7cb7"]</data>
  <data key="d4">False</data>
</node>
<node id="PEN/Faulkner Award for Fiction">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An award for fiction that the novel 'We Are All Completely Beside Ourselves' won in 2014.", "chunk_id": "ad844d39ed13dc56", "doc_id": "hp_201f87e77880c43e"}]</data>
  <data key="d2">[{"text": "The novel won the 2014 PEN/Faulkner Award for Fiction&lt;ref name=\"The Guardian - 3 April 2014 - Karen Joy Fowler wins PEN/Faulkner award for fiction\"&gt; &lt;/ref&gt;", "chunk_id": "ad844d39ed13dc56", "doc_id": "hp_201f87e77880c43e"}]</data>
  <data key="d3">["hp_201f87e77880c43e"]</data>
  <data key="d4">False</data>
</node>
