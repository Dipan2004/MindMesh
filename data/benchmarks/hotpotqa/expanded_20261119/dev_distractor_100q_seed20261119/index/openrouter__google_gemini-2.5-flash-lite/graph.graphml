</node>
<node id="Network Ten">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The network that bought Good News Week from ABC and broadcast its second run.", "chunk_id": "fe189654c6399c85", "doc_id": "hp_993b59bab3ae17d3"}]</data>
  <data key="d2">[{"text": "The show's initial run aired on ABC until being bought by Network Ten in 1999.", "chunk_id": "fe189654c6399c85", "doc_id": "hp_993b59bab3ae17d3"}]</data>
  <data key="d3">["hp_993b59bab3ae17d3"]</data>
  <data key="d4">False</data>
</node>
<node id="2007–2008 Writers Guild of America strike">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A labor dispute that led to the revival of Good News Week.", "chunk_id": "fe189654c6399c85", "doc_id": "hp_993b59bab3ae17d3"}]</data>
  <data key="d2">[{"text": "The show was revived for its second run when the 2007–2008 Writers Guild of America strike caused many of Network Ten's imported US programmes to cease production.", "chunk_id": "fe189654c6399c85", "doc_id": "hp_993b59bab3ae17d3"}]</data>
  <data key="d3">["hp_993b59bab3ae17d3"]</data>
  <data key="d4">False</data>
</node>
