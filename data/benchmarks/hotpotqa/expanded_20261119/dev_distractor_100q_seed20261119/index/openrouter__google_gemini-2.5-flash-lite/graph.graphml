  <data key="d8">hp_c90ebb0b4e670d3e</data>
</edge>
<edge source="Dali–Ruili Railway" target="Yunnan province">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">The Dali-Ruili Railway is under construction in Yunnan Province.</data>
  <data key="d7">[{"text": "The Dali–Ruili Railway or Darui Railway (), is a single-track electrified railroad under construction in Yunnan Province of Southwest China.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_c90ebb0b4e670d3e</data>
</edge>
<edge source="Dali–Ruili Railway" target="Gaoligong Mountains">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">A tunnel for the Dali-Ruili Railway will go through the Gaoligong Mountains.</data>
  <data key="d7">[{"text": "The line traverses rugged terrain, and bridges and tunnels will account for 75% of the total track length, including a 36-km tunnel through the Gaoligong Mountains.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_c90ebb0b4e670d3e</data>
</edge>
