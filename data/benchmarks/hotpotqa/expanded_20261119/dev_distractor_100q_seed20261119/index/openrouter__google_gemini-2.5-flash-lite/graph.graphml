  <data key="d7">[{"text": "Cities and towns along route include Dali, Yangbi Yi Autonomous County, Yongping County, Baoshan, Mang City (also known as Mangshi or Dehong) and Ruili.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e", "type": "LOCATED_IN"}]</data>
