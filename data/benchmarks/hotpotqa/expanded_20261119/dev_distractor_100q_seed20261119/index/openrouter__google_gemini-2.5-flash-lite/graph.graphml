  <data key="d2">[{"text": "Javed Jaffrey, Naved Jafri, and Ravi Behl are the permanent judges on the show.", "chunk_id": "0ed37f3f70846148", "doc_id": "hp_fa98fe724fcd50b7"}]</data>
