  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A 2015 book by Bob Woodward that published the Zilch memo.", "chunk_id": "51c2cb97c1a1900f", "doc_id": "hp_7681eb8af0f9cd50"}]</data>
  <data key="d2">[{"text": "Previously missing from the Richard Nixon Library, the memo was discovered in the possession of Alexander Butterfield, who served as the Deputy Assistant to President Nixon from 1969 to 1973, by \"Washington Post\" reporter Bob Woodward, who subsequently published it in his 2015 book \"The Last of the President's Men\".", "chunk_id": "51c2cb97c1a1900f", "doc_id": "hp_7681eb8af0f9cd50"}]</data>
