<node id="Manitoba AHA">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Manitoba AHA was a league in which the Warroad Lakers played.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e"}]</data>
  <data key="d2">[{"text": "The Lakers played in various Manitoba AHA and Thunder Bay AHA senior and intermediate leagues and were granted special eligibility for the Allan Cup and Hardy Cup by the Canadian Amateur Hockey Association.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e"}]</data>
  <data key="d3">["hp_0c2bb267ca87242e"]</data>
  <data key="d4">False</data>
</node>
<node id="Thunder Bay AHA">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Thunder Bay AHA was a league in which the Warroad Lakers played.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e"}]</data>
  <data key="d2">[{"text": "The Lakers played in various Manitoba AHA and Thunder Bay AHA senior and intermediate leagues and were granted special eligibility for the Allan Cup and Hardy Cup by the Canadian Amateur Hockey Association.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e"}]</data>
  <data key="d3">["hp_0c2bb267ca87242e"]</data>
  <data key="d4">False</data>
</node>
<node id="Allan Cup">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Allan Cup is a championship for which the Warroad Lakers were granted special eligibility and competed.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e"}, {"text": "The Allan Cup is a trophy that had a champion for the 11th time in 1918 and was awarded through a challenge series.", "chunk_id": "af23101286e3cc88", "doc_id": "hp_0cfa6ed1fb9c0e08"}, {"text": "A national championship for senior ice hockey in Canada.", "chunk_id": "c0af2c2509f54ce5", "doc_id": "hp_2072dc38221ffe1f"}, {"text": "The Allan Cup is a championship trophy in Canadian ice hockey.", "chunk_id": "727d9f658d48842e", "doc_id": "hp_a459053e0ba1eb53"}, {"text": "A famed trophy for which the league's champion contends.", "chunk_id": "8a85ab40137c3013", "doc_id": "hp_c2681de15433dd19"}, {"text": "A championship trophy in senior ice hockey in Canada.", "chunk_id": "8c9123487c66f805", "doc_id": "hp_f23b02c7bab7a782"}]</data>
  <data key="d2">[{"text": "The Lakers played in various Manitoba AHA and Thunder Bay AHA senior and intermediate leagues and were granted special eligibility for the Allan Cup and Hardy Cup by the Canadian Amateur Hockey Association.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e"}, {"text": "The 1918 playoff marked the 11th time the Allan Cup had a champion.", "chunk_id": "af23101286e3cc88", "doc_id": "hp_0cfa6ed1fb9c0e08"}, {"text": "The team is a member of the Allan Cup Hockey league of the Ontario Hockey Association, the top tier of senior ice hockey in Ontario, and eligible for the Allan Cup national championship.", "chunk_id": "c0af2c2509f54ce5", "doc_id": "hp_2072dc38221ffe1f"}, {"text": "The 1915 Allan Cup was the Canadian national senior ice hockey championship for the 1914-15 season.", "chunk_id": "727d9f658d48842e", "doc_id": "hp_a459053e0ba1eb53"}, {"text": "As a member of the Ontario Hockey Association and Hockey Canada, the league's champion contends for the famed Allan Cup each year.", "chunk_id": "8a85ab40137c3013", "doc_id": "hp_c2681de15433dd19"}, {"text": "The Smoke Eaters won their first Allan Cup in 1938; they won the 1939 World Ice Hockey Championships and the 1961 World Ice Hockey Championships; and they won another Allan Cup in 1962.", "chunk_id": "8c9123487c66f805", "doc_id": "hp_f23b02c7bab7a782"}]</data>
  <data key="d3">["hp_0c2bb267ca87242e", "hp_0cfa6ed1fb9c0e08", "hp_2072dc38221ffe1f", "hp_a459053e0ba1eb53", "hp_c2681de15433dd19", "hp_f23b02c7bab7a782"]</data>
  <data key="d4">False</data>
</node>
<node id="Hardy Cup">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Hardy Cup is a championship for which the Warroad Lakers were granted special eligibility and competed.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e"}]</data>
  <data key="d2">[{"text": "The Lakers played in various Manitoba AHA and Thunder Bay AHA senior and intermediate leagues and were granted special eligibility for the Allan Cup and Hardy Cup by the Canadian Amateur Hockey Association.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e"}]</data>
  <data key="d3">["hp_0c2bb267ca87242e"]</data>
  <data key="d4">False</data>
</node>
<node id="Canadian Amateur Hockey Association">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Canadian Amateur Hockey Association granted special eligibility for the Allan Cup and Hardy Cup to the Warroad Lakers.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e"}]</data>
  <data key="d2">[{"text": "The Lakers played in various Manitoba AHA and Thunder Bay AHA senior and intermediate leagues and were granted special eligibility for the Allan Cup and Hardy Cup by the Canadian Amateur Hockey Association.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e"}]</data>
  <data key="d3">["hp_0c2bb267ca87242e"]</data>
  <data key="d4">False</data>
</node>
<node id="Ken Itō">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Ken Itō is a Japanese composer, conductor, and writer.", "chunk_id": "0098840943bb12b3", "doc_id": "hp_0c547ebaf27ccc35"}]</data>
  <data key="d2">[{"text": "Ken Itō (伊東 乾 , Itō Ken ) is a Japanese composer, conductor, and writer born in Tokyo on January 27, 1965.", "chunk_id": "0098840943bb12b3", "doc_id": "hp_0c547ebaf27ccc35"}]</data>
  <data key="d3">["hp_0c547ebaf27ccc35"]</data>
  <data key="d4">False</data>
</node>
