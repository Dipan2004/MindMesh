  <data key="d6">Skellerup Glacier was named in honor of P. J. Skellerup.</data>
  <data key="d7">[{"text": "Named in honor of P. J. Skellerup, who sponsored the Antarctic wing at Canterbury Museum.", "chunk_id": "24745fbcaed93050", "doc_id": "hp_ddd63b870a280fcc", "type": "NAMED_AFTER"}]</data>
