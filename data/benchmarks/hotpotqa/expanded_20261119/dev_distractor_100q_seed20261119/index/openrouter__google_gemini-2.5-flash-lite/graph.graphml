  <data key="d7">[{"text": "He disdained telling jokes and engaging in comedy as it was traditionally understood, once saying in a rare introspective interview, \"I am not a comic, I have never told a joke.", "chunk_id": "a8189041218c65c9", "doc_id": "hp_df54057a167e76d7", "type": "DISDAINED"}]</data>
