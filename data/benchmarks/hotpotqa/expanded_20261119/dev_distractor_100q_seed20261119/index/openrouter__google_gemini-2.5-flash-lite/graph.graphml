<node id="European route E20">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A European route of which the A180 highway is its easternmost stretch.", "chunk_id": "53eccf7b7bf86b26", "doc_id": "hp_b85dbf7e5499fa3f"}]</data>
  <data key="d2">[{"text": "It is part of European route E20, making its easternmost stretch.", "chunk_id": "53eccf7b7bf86b26", "doc_id": "hp_b85dbf7e5499fa3f"}]</data>
  <data key="d3">["hp_b85dbf7e5499fa3f"]</data>
