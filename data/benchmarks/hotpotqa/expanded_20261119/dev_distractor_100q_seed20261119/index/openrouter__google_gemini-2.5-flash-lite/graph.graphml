  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The primary activity of Tikkun Leil Shabbat, occurring on Friday nights.", "chunk_id": "c80672aca910bdd6", "doc_id": "hp_96d9debe51005d2b"}]</data>
  <data key="d2">[{"text": "Its primary activity is Friday night (\"leil Shabbat\"), but it also meets on Jewish holidays and at other times.", "chunk_id": "c80672aca910bdd6", "doc_id": "hp_96d9debe51005d2b"}]</data>
