  <data key="d2">[{"text": "Ayala Malls is the one of the largest shopping mall retailer in the Philippines, along with SM Supermalls and Robinsons Malls.", "chunk_id": "00d6e00c58449962", "doc_id": "hp_1223b1c0f959c0b7"}]</data>
  <data key="d3">["hp_1223b1c0f959c0b7"]</data>
  <data key="d4">False</data>
</node>
<node id="Istiklal Mosque">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Istiklal Mosque, also known as Masjid Istiqlal, is one of the largest mosques in Otoka, Sarajevo, Bosnia and Herzegovina.", "chunk_id": "1cbf4009842f5c2b", "doc_id": "hp_1228d503d45e5b99"}]</data>
  <data key="d2">[{"text": "Istiqlal Mosque, or Masjid Istiqlal, (Independence Mosque) in Otoka, Sarajevo, Bosnia and Herzegovina is one of the largest mosques in the city.", "chunk_id": "1cbf4009842f5c2b", "doc_id": "hp_1228d503d45e5b99"}]</data>
  <data key="d3">["hp_1228d503d45e5b99"]</data>
  <data key="d4">False</data>
</node>
<node id="Masjid Istiqlal">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Masjid Istiqlal is another name for Istiklal Mosque.", "chunk_id": "1cbf4009842f5c2b", "doc_id": "hp_1228d503d45e5b99"}]</data>
  <data key="d2">[{"text": "Istiqlal Mosque, or Masjid Istiqlal, (Independence Mosque) in Otoka, Sarajevo, Bosnia and Herzegovina is one of the largest mosques in the city.", "chunk_id": "1cbf4009842f5c2b", "doc_id": "hp_1228d503d45e5b99"}]</data>
  <data key="d3">["hp_1228d503d45e5b99"]</data>
  <data key="d4">False</data>
</node>
<node id="Independence Mosque">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Independence Mosque is the English translation of Istiqlal Mosque.", "chunk_id": "1cbf4009842f5c2b", "doc_id": "hp_1228d503d45e5b99"}]</data>
  <data key="d2">[{"text": "Istiqlal Mosque, or Masjid Istiqlal, (Independence Mosque) in Otoka, Sarajevo, Bosnia and Herzegovina is one of the largest mosques in the city.", "chunk_id": "1cbf4009842f5c2b", "doc_id": "hp_1228d503d45e5b99"}]</data>
  <data key="d3">["hp_1228d503d45e5b99"]</data>
