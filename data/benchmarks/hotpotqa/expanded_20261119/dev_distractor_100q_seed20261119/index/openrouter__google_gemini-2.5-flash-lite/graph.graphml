  <data key="d7">[{"text": "No Light, No Light is a song by English indie rock band Florence and the Machine from their second studio album, \"Ceremonials\" (2011).", "chunk_id": "eacf230036b80618", "doc_id": "hp_099c2da4a99b4f6f", "type": "PART_OF"}]</data>
