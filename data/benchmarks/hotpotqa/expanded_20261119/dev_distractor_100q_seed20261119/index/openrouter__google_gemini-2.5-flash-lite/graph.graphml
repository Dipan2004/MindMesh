<node id="Napoleonic Wars">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A series of major conflicts pitting the French Empire against various European coalitions.", "chunk_id": "d43d20bf97a0fc28", "doc_id": "hp_56ae2e2bc0735743"}]</data>
  <data key="d2">[{"text": "After serving for four years as Whig Member of Parliament for Richmond, he was given command of the fifth-rate HMS \"Euryalus\" and took part in the unsuccessful Walcheren Campaign in July 1809 during the Napoleonic Wars.", "chunk_id": "d43d20bf97a0fc28", "doc_id": "hp_56ae2e2bc0735743"}]</data>
  <data key="d3">["hp_56ae2e2bc0735743"]</data>
  <data key="d4">False</data>
</node>
<node id="HMS &quot;Edinburgh&quot;">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A third-rate ship of the line in the Royal Navy.", "chunk_id": "d43d20bf97a0fc28", "doc_id": "hp_56ae2e2bc0735743"}]</data>
  <data key="d2">[{"text": "He transferred to the third-rate HMS \"Edinburgh\" and landed troops at Viareggio in Italy in November 1812 later in that War.", "chunk_id": "d43d20bf97a0fc28", "doc_id": "hp_56ae2e2bc0735743"}]</data>
  <data key="d3">["hp_56ae2e2bc0735743"]</data>
  <data key="d4">False</data>
</node>
<node id="Viareggio">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city and comune in the province of Lucca, Tuscany, Italy.", "chunk_id": "d43d20bf97a0fc28", "doc_id": "hp_56ae2e2bc0735743"}]</data>
  <data key="d2">[{"text": "He transferred to the third-rate HMS \"Edinburgh\" and landed troops at Viareggio in Italy in November 1812 later in that War.", "chunk_id": "d43d20bf97a0fc28", "doc_id": "hp_56ae2e2bc0735743"}]</data>
  <data key="d3">["hp_56ae2e2bc0735743"]</data>
  <data key="d4">False</data>
</node>
<node id="Orkney and Shetland">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A parliamentary constituency in Scotland.", "chunk_id": "d43d20bf97a0fc28", "doc_id": "hp_56ae2e2bc0735743"}]</data>
  <data key="d2">[{"text": "He went on to be Member of Parliament for Orkney and Shetland and became First Naval Lord in the First Melbourne ministry in August 1834 but died in office just two months later in October 1834.", "chunk_id": "d43d20bf97a0fc28", "doc_id": "hp_56ae2e2bc0735743"}]</data>
  <data key="d3">["hp_56ae2e2bc0735743"]</data>
