  <data key="d2">[{"text": "Upon the completion of the regular season the 2010 MLS Cup Playoffs culminated on November 21 with a 2–1 victory by the Colorado Rapids over FC Dallas at Toronto's BMO Field.", "chunk_id": "1221adbf4371c7a0", "doc_id": "hp_60e7d9ac9e049733"}, {"text": "Notre Dame High School (also known as NDHS, Notre Dame H.S., Notre Dame, or simply Dame) is an all-girls Roman Catholic secondary school in Toronto, Ontario, Canada.", "chunk_id": "59f1fceefedd98a3", "doc_id": "hp_97bc21ad7dfa71c1"}, {"text": "The championship was played at BMO Field in Toronto, Ontario, Canada on November 21, 2010.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}]</data>
  <data key="d3">["hp_60e7d9ac9e049733", "hp_97bc21ad7dfa71c1", "hp_b8c5eba035057a5e"]</data>
  <data key="d4">False</data>
