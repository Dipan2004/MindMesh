<node id="The Discovery of America by the Turks">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Brazilian Modernist novel.", "chunk_id": "eba842781d3e0f53", "doc_id": "hp_2fa6e4f30229c0a7"}]</data>
  <data key="d2">[{"text": "The Discovery of America by the Turks (Portuguese: A Descoberta da América pelos Turcos) is a Brazilian Modernist novel.", "chunk_id": "eba842781d3e0f53", "doc_id": "hp_2fa6e4f30229c0a7"}]</data>
  <data key="d3">["hp_2fa6e4f30229c0a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Jorge Amado">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The author of the novel 'The Discovery of America by the Turks'.", "chunk_id": "eba842781d3e0f53", "doc_id": "hp_2fa6e4f30229c0a7"}, {"text": "The author of the Brazilian Modernist novel, The Violent Land.", "chunk_id": "5b9d731909fa866e", "doc_id": "hp_3182b9b6096ed733"}, {"text": "The author of the Brazilian Modernist novel Sea of Death.", "chunk_id": "3fb4165ab8df2c3b", "doc_id": "hp_646fbde6ba07517a"}, {"text": "Jorge Amado was an internationally famous writer and the husband of Zélia Gattai.", "chunk_id": "004b3a821c0eea89", "doc_id": "hp_7793b1230ca9d0c3"}, {"text": "Jorge Amado is an author whose books reference the Coutinho family's land in Itapoan.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0"}, {"text": "A Brazilian writer of the modernist school.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c"}]</data>
  <data key="d2">[{"text": "It was written by Jorge Amado in 1994 but not published in English until 2012.", "chunk_id": "eba842781d3e0f53", "doc_id": "hp_2fa6e4f30229c0a7"}, {"text": "The Violent Land (Portuguese: Terras do Sem Fim) is a Brazilian Modernist novel written by Jorge Amado in 1943 and published in English in 1945.", "chunk_id": "5b9d731909fa866e", "doc_id": "hp_3182b9b6096ed733"}, {"text": "Sea of Death (Portuguese: Mar Morto) is a Brazilian Modernist novel written by Jorge Amado.", "chunk_id": "3fb4165ab8df2c3b", "doc_id": "hp_646fbde6ba07517a"}, {"text": "She was married to internationally famous writer Jorge Amado from 1945 until his death in 2001.", "chunk_id": "004b3a821c0eea89", "doc_id": "hp_7793b1230ca9d0c3"}, {"text": "Elsimar Metzker Coutinho (Pojuca, May 18, 1930) is a Brazilian scientist of Luso-Austrian descent, professor, gynecologist and television personality, and character named as \"Prince of Itapoan\", in the books of Jorge Amado which references the Coutinho family's land in Itapoan where Amado himself lived.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0"}, {"text": "Jorge Leal Amado de Faria (] , 10 August 1912 – 6 August 2001) was a Brazilian writer of the modernist school.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c"}]</data>
  <data key="d3">["hp_2fa6e4f30229c0a7", "hp_3182b9b6096ed733", "hp_646fbde6ba07517a", "hp_7793b1230ca9d0c3", "hp_ac3086730c4518d0", "hp_f34261cdc3c2359c"]</data>
  <data key="d4">False</data>
</node>
<node id="organization in Italy">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An organization based in Italy that commissioned Jorge Amado to write a story.", "chunk_id": "eba842781d3e0f53", "doc_id": "hp_2fa6e4f30229c0a7"}]</data>
  <data key="d2">[{"text": "Amado tells how, in 1991, he was approached by an organization in Italy to write a story to celebrate the fifth centennial of the discovery of the American continent.", "chunk_id": "eba842781d3e0f53", "doc_id": "hp_2fa6e4f30229c0a7"}]</data>
  <data key="d3">["hp_2fa6e4f30229c0a7"]</data>
  <data key="d4">False</data>
</node>
<node id="American continent">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The continent that was discovered.", "chunk_id": "eba842781d3e0f53", "doc_id": "hp_2fa6e4f30229c0a7"}]</data>
  <data key="d2">[{"text": "Amado tells how, in 1991, he was approached by an organization in Italy to write a story to celebrate the fifth centennial of the discovery of the American continent.", "chunk_id": "eba842781d3e0f53", "doc_id": "hp_2fa6e4f30229c0a7"}]</data>
  <data key="d3">["hp_2fa6e4f30229c0a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Norman Mailer">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A writer who was to contribute a story to a book celebrating the discovery of America.", "chunk_id": "eba842781d3e0f53", "doc_id": "hp_2fa6e4f30229c0a7"}, {"text": "An activist and writer who participated in the panel debate for \"Town Bloody Hall\".", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}, {"text": "The late archivist and authorized biographer of J. Michael Lennon.", "chunk_id": "645ac4bb539e8387", "doc_id": "hp_58ea4a9bbd58a7e0"}, {"text": "Norman Mailer was a 20th-century American author.", "chunk_id": "3ff1cc4e3a35ef9a", "doc_id": "hp_6d15d4f485e7732e"}, {"text": "The author of the short stories featured in the anthology.", "chunk_id": "d2f75ec874d75b32", "doc_id": "hp_c1e169e36d7f056a"}, {"text": "Norman Mailer was an American novelist, journalist, essayist, playwright, film-maker, actor, and political activist.", "chunk_id": "a9b706270ee53f26", "doc_id": "hp_f2e5ed08978257fc"}]</data>
  <data key="d2">[{"text": "This would be published in a book, together with stories by Norman Mailer and Carlos Fuentes, which would be handed out to passengers flying between Italy and Central, North and South America in 1992, the year of the fifth centennial.", "chunk_id": "eba842781d3e0f53", "doc_id": "hp_2fa6e4f30229c0a7"}, {"text": "Town Bloody Hall is a 1971 documentary film of a panel debate between feminist advocates and activist Norman Mailer.", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}, {"text": "J. Michael Lennon is Emeritus Professor of English at Wilkes University and the late Norman Mailer’s archivist and authorized biographer.", "chunk_id": "645ac4bb539e8387", "doc_id": "hp_58ea4a9bbd58a7e0"}, {"text": "Norman Mailer was a 20th-century American author.", "chunk_id": "3ff1cc4e3a35ef9a", "doc_id": "hp_6d15d4f485e7732e"}, {"text": "The Short Fiction of Norman Mailer is a 1967 anthology of short stories by Norman Mailer.", "chunk_id": "d2f75ec874d75b32", "doc_id": "hp_c1e169e36d7f056a"}, {"text": "Norman Kingsley Mailer (January 31, 1923 – November 10, 2007) was an American novelist, journalist, essayist, playwright, film-maker, actor, and political activist.", "chunk_id": "a9b706270ee53f26", "doc_id": "hp_f2e5ed08978257fc"}]</data>
  <data key="d3">["hp_2fa6e4f30229c0a7", "hp_535589d1805f024e", "hp_58ea4a9bbd58a7e0", "hp_6d15d4f485e7732e", "hp_c1e169e36d7f056a", "hp_f2e5ed08978257fc"]</data>
  <data key="d4">False</data>
</node>
