  <data key="d2">[{"text": "It lies at the south of, and is conjoined to, Skegness , and comprises the less than half-mile long residential road, Seacroft Esplanade, and a golf course at its south.", "chunk_id": "7547e33be5d5dab0", "doc_id": "hp_334151f118143081"}]</data>
