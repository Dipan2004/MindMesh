  <data key="d2">[{"text": "Professor Wale Adebanwi, (born 1969), is a Nigerian - born first Black African Rhodes Professor at Oxford University", "chunk_id": "ab55f0972c573850", "doc_id": "hp_a4bd1b62bab05425"}]</data>
