<node id="Shootouts">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A method used to decide draws in MLS matches.", "chunk_id": "29dfa2df58a551ed", "doc_id": "hp_132ccee5aa3dd85c"}, {"text": "A method used to decide draws in soccer matches when regular play ends in a tie.", "chunk_id": "ca56de409a030dd6", "doc_id": "hp_33b159b8faca1ec8"}, {"text": "A method used to decide draws in soccer matches when regular play ends in a tie.", "chunk_id": "1dcb1ca9df627726", "doc_id": "hp_8ad05a86a63976c5"}, {"text": "A method of extending an ice hockey game when scores are tied after regulation, involving a series of penalty shots.", "chunk_id": "2f0c7a6928ef44b4", "doc_id": "hp_2d53d1bdc10ca42f"}]</data>
  <data key="d2">[{"text": "MLS did not allow matches to end in ties and thus Shootouts were used to decide draws, the stats that follow do not include shootout goals scored and the teams actually point total in the regular season was 49 even though it is shown below as 63.", "chunk_id": "29dfa2df58a551ed", "doc_id": "hp_132ccee5aa3dd85c"}, {"text": "MLS did not allow matches to end in ties in 1998 and thus Shootouts were used to decide draws, the stats that follow do not include shootout goals scored and the teams actually point total in the regular season was 32 even though it is shown below as 36.", "chunk_id": "ca56de409a030dd6", "doc_id": "hp_33b159b8faca1ec8"}, {"text": "MLS did not allow matches to end in ties in 1999 and thus Shootouts were used to decide draws, the stats that follow do not include shootout goals scored and the teams actually point total in the regular season was 20 even though it is shown below as 24.", "chunk_id": "1dcb1ca9df627726", "doc_id": "hp_8ad05a86a63976c5"}, {"text": "The two main methods of extending the game are the overtime period (commonly referred to as overtime) and the shootout.", "chunk_id": "2f0c7a6928ef44b4", "doc_id": "hp_2d53d1bdc10ca42f"}]</data>
  <data key="d3">["hp_132ccee5aa3dd85c", "hp_2d53d1bdc10ca42f", "hp_33b159b8faca1ec8", "hp_8ad05a86a63976c5"]</data>
  <data key="d4">False</data>
</node>
