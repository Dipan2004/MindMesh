<node id="Western Swamp Tortoise">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Western Swamp Tortoise is an endangered species for which the Mogumber Nature Reserve serves as a refuge.", "chunk_id": "dca355f8299f1441", "doc_id": "hp_88918699b9d7513f"}]</data>
  <data key="d2">[{"text": "It is a refuge for the endangered Western Swamp Tortoise along with the Twin Swamps Nature Reserve and the Ellen Brook Nature Reserve.", "chunk_id": "dca355f8299f1441", "doc_id": "hp_88918699b9d7513f"}]</data>
  <data key="d3">["hp_88918699b9d7513f"]</data>
  <data key="d4">False</data>
</node>
