  <data key="d2">[{"text": "He performs in varying music genres and styles which include rock and roll, rhythm and blues, and patriotic music, and is best known for his work in Christian music and his longterm Christian ministry.", "chunk_id": "73ee4754182774e7", "doc_id": "hp_0e12ea58b60d4b89"}]</data>
