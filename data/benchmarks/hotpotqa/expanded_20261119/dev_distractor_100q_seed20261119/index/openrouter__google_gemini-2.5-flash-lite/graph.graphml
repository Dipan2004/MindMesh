</node>
<node id="Genadendal">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A town in South Africa after which Genadendal Residence is named.", "chunk_id": "f05b7044d350a953", "doc_id": "hp_20bf70e341654a18"}]</data>
  <data key="d2">[{"text": "Genadendal is situated in Cape Town, Western Cape, South Africa.", "chunk_id": "f05b7044d350a953", "doc_id": "hp_20bf70e341654a18"}]</data>
  <data key="d3">["hp_20bf70e341654a18"]</data>
  <data key="d4">False</data>
</node>
<node id="Western Cape">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A province in South Africa where Cape Town is located.", "chunk_id": "f05b7044d350a953", "doc_id": "hp_20bf70e341654a18"}]</data>
  <data key="d2">[{"text": "Genadendal is situated in Cape Town, Western Cape, South Africa.", "chunk_id": "f05b7044d350a953", "doc_id": "hp_20bf70e341654a18"}]</data>
  <data key="d3">["hp_20bf70e341654a18"]</data>
  <data key="d4">False</data>
</node>
<node id="South Africa">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A country in Africa.", "chunk_id": "f05b7044d350a953", "doc_id": "hp_20bf70e341654a18"}, {"text": "South Africa is a country where the majority of Phylica species are restricted.", "chunk_id": "6b62f66ee7182ec5", "doc_id": "hp_2ca4198c5242553c"}, {"text": "South Africa is a country where Salvia chamelaeagnea is endemic.", "chunk_id": "993393a5d9cfab3f", "doc_id": "hp_bae29dd7ee1c4c2e"}]</data>
  <data key="d2">[{"text": "Genadendal is situated in Cape Town, Western Cape, South Africa.", "chunk_id": "f05b7044d350a953", "doc_id": "hp_20bf70e341654a18"}, {"text": "It contains about 150 species, the majority of which are restricted to South Africa, where they form part of the \"fynbos \".", "chunk_id": "6b62f66ee7182ec5", "doc_id": "hp_2ca4198c5242553c"}, {"text": "It is endemic to South Africa, where it grows on the western coastline of the Cape of Good Hope.", "chunk_id": "993393a5d9cfab3f", "doc_id": "hp_bae29dd7ee1c4c2e"}]</data>
  <data key="d3">["hp_20bf70e341654a18", "hp_2ca4198c5242553c", "hp_bae29dd7ee1c4c2e"]</data>
  <data key="d4">False</data>
</node>
<node id="Nelson Mandela">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A former resident of Genadendal Residence and South African President.", "chunk_id": "f05b7044d350a953", "doc_id": "hp_20bf70e341654a18"}]</data>
  <data key="d2">[{"text": "It has been the official residence since 1994 when Nelson Mandela took up residence here rather than neighbouring Groote Schuur.", "chunk_id": "f05b7044d350a953", "doc_id": "hp_20bf70e341654a18"}]</data>
  <data key="d3">["hp_20bf70e341654a18"]</data>
  <data key="d4">False</data>
</node>
<node id="Groote Schuur">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A neighboring residence to Genadendal Residence.", "chunk_id": "f05b7044d350a953", "doc_id": "hp_20bf70e341654a18"}]</data>
  <data key="d2">[{"text": "It has been the official residence since 1994 when Nelson Mandela took up residence here rather than neighbouring Groote Schuur.", "chunk_id": "f05b7044d350a953", "doc_id": "hp_20bf70e341654a18"}]</data>
  <data key="d3">["hp_20bf70e341654a18"]</data>
  <data key="d4">False</data>
</node>
<node id="Westbrook">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The former name of Genadendal Residence.", "chunk_id": "f05b7044d350a953", "doc_id": "hp_20bf70e341654a18"}]</data>
  <data key="d2">[{"text": "The building, formerly known as Westbrook, is named after the town of Genadendal – itself an Afrikaans word meaning \"Valley of Mercy\".", "chunk_id": "f05b7044d350a953", "doc_id": "hp_20bf70e341654a18"}]</data>
  <data key="d3">["hp_20bf70e341654a18"]</data>
  <data key="d4">False</data>
</node>
<node id="Valley of Mercy">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The meaning of the Afrikaans word 'Genadendal'.", "chunk_id": "f05b7044d350a953", "doc_id": "hp_20bf70e341654a18"}]</data>
  <data key="d2">[{"text": "The building, formerly known as Westbrook, is named after the town of Genadendal – itself an Afrikaans word meaning \"Valley of Mercy\".", "chunk_id": "f05b7044d350a953", "doc_id": "hp_20bf70e341654a18"}]</data>
  <data key="d3">["hp_20bf70e341654a18"]</data>
  <data key="d4">False</data>
</node>
<node id="HMS Cyane">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A British warship involved in the capture.", "chunk_id": "f591b0cfb4d7763d", "doc_id": "hp_21bffffb5d2553d5"}, {"text": "A British warship that fought on 20 February 1815.", "chunk_id": "f591b0cfb4d7763d", "doc_id": "hp_21bffffb5d2553d5"}]</data>
  <data key="d2">[{"text": "Capture of HMS Cyane and HMS Levant", "chunk_id": "f591b0cfb4d7763d", "doc_id": "hp_21bffffb5d2553d5"}, {"text": "The British warships HMS \"Cyane\" and HMS \"Levant\" fought  on 20 February 1815 about 100 miles east of Madeira.", "chunk_id": "f591b0cfb4d7763d", "doc_id": "hp_21bffffb5d2553d5"}]</data>
  <data key="d3">["hp_21bffffb5d2553d5"]</data>
  <data key="d4">False</data>
</node>
<node id="HMS Levant">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A British warship involved in the capture.", "chunk_id": "f591b0cfb4d7763d", "doc_id": "hp_21bffffb5d2553d5"}, {"text": "A British warship that fought on 20 February 1815.", "chunk_id": "f591b0cfb4d7763d", "doc_id": "hp_21bffffb5d2553d5"}]</data>
  <data key="d2">[{"text": "Capture of HMS Cyane and HMS Levant", "chunk_id": "f591b0cfb4d7763d", "doc_id": "hp_21bffffb5d2553d5"}, {"text": "The British warships HMS \"Cyane\" and HMS \"Levant\" fought  on 20 February 1815 about 100 miles east of Madeira.", "chunk_id": "f591b0cfb4d7763d", "doc_id": "hp_21bffffb5d2553d5"}]</data>
  <data key="d3">["hp_21bffffb5d2553d5"]</data>
  <data key="d4">False</data>
</node>
<node id="Anglo-American War of 1812">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A war that took place between the Anglo-American sides.", "chunk_id": "f591b0cfb4d7763d", "doc_id": "hp_21bffffb5d2553d5"}]</data>
  <data key="d2">[{"text": "The capture of HMS \"Cyane\" and HMS \"Levant\" was an action which took place at the end of the Anglo-American War of 1812.", "chunk_id": "f591b0cfb4d7763d", "doc_id": "hp_21bffffb5d2553d5"}]</data>
  <data key="d3">["hp_21bffffb5d2553d5"]</data>
  <data key="d4">False</data>
</node>
<node id="Madeira">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location approximately 100 miles east of which the HMS Cyane and HMS Levant fought.", "chunk_id": "f591b0cfb4d7763d", "doc_id": "hp_21bffffb5d2553d5"}, {"text": "Madeira is a Portuguese archipelago and autonomous region in the North Atlantic Ocean.", "chunk_id": "e5eca2e6dd8b8b88", "doc_id": "hp_7e8473e41faea381"}]</data>
  <data key="d2">[{"text": "The British warships HMS \"Cyane\" and HMS \"Levant\" fought  on 20 February 1815 about 100 miles east of Madeira.", "chunk_id": "f591b0cfb4d7763d", "doc_id": "hp_21bffffb5d2553d5"}, {"text": "Semele is a genus of flowering plants native to the Canary Islands and Madeira.", "chunk_id": "e5eca2e6dd8b8b88", "doc_id": "hp_7e8473e41faea381"}]</data>
  <data key="d3">["hp_21bffffb5d2553d5", "hp_7e8473e41faea381"]</data>
  <data key="d4">False</data>
</node>
<node id="Treaty of Ghent">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A treaty that was ratified by both sides, ending the war.", "chunk_id": "f591b0cfb4d7763d", "doc_id": "hp_21bffffb5d2553d5"}]</data>
  <data key="d2">[{"text": "The war had actually finished a few days before the action with the ratification of the Treaty of Ghent by both sides, but the combatants were not aware of this.", "chunk_id": "f591b0cfb4d7763d", "doc_id": "hp_21bffffb5d2553d5"}]</data>
  <data key="d3">["hp_21bffffb5d2553d5"]</data>
  <data key="d4">False</data>
</node>
<node id="Hazel Dickens">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Hazel Jane Dickens was an American bluegrass singer, songwriter, double bassist and guitarist.", "chunk_id": "12b5fe23f857cd32", "doc_id": "hp_2295401c0eccc650"}, {"text": "Hazel Dickens was a musical collaborator of Alice Gerrard.", "chunk_id": "4cba1a343443cac4", "doc_id": "hp_d2b3c37a5329d341"}]</data>
  <data key="d2">[{"text": "Hazel Jane Dickens (June 1, 1935 – April 22, 2011) was an American bluegrass singer, songwriter, double bassist and guitarist.", "chunk_id": "12b5fe23f857cd32", "doc_id": "hp_2295401c0eccc650"}, {"text": "She performed in a duo with Hazel Dickens and as part of The Back Creek Buddies with Matokie Slaughter.", "chunk_id": "4cba1a343443cac4", "doc_id": "hp_d2b3c37a5329d341"}]</data>
  <data key="d3">["hp_2295401c0eccc650", "hp_d2b3c37a5329d341"]</data>
  <data key="d4">False</data>
</node>
<node id="Alice Gerrard">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Alice Gerrard was a collaborator with Hazel Dickens in bluegrass music.", "chunk_id": "12b5fe23f857cd32", "doc_id": "hp_2295401c0eccc650"}, {"text": "Alice Gerrard is an American bluegrass singer, banjoist, and guitar player.", "chunk_id": "4cba1a343443cac4", "doc_id": "hp_d2b3c37a5329d341"}]</data>
  <data key="d2">[{"text": "With Alice Gerrard, Dickens was one of the first women to record a bluegrass album.", "chunk_id": "12b5fe23f857cd32", "doc_id": "hp_2295401c0eccc650"}, {"text": "Alice Gerrard (born July 8, 1934) is an American bluegrass singer, banjoist, and guitar player.", "chunk_id": "4cba1a343443cac4", "doc_id": "hp_d2b3c37a5329d341"}]</data>
  <data key="d3">["hp_2295401c0eccc650", "hp_d2b3c37a5329d341"]</data>
  <data key="d4">False</data>
</node>
<node id="John Pietaro">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "John Pietaro is a cultural blogger who commented on Hazel Dickens's music and activism.", "chunk_id": "12b5fe23f857cd32", "doc_id": "hp_2295401c0eccc650"}]</data>
  <data key="d2">[{"text": "Cultural blogger John Pietaro noted that \"Dickens didn’t just sing the anthems of labor, she lived them and her place on many a picket line, staring down gunfire and goon squads, embedded her into the cause.\"", "chunk_id": "12b5fe23f857cd32", "doc_id": "hp_2295401c0eccc650"}]</data>
  <data key="d3">["hp_2295401c0eccc650"]</data>
  <data key="d4">False</data>
</node>
<node id="bluegrass music">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Bluegrass music is a genre of American roots music that developed in the 1940s in the Appalachian region of the United States.", "chunk_id": "12b5fe23f857cd32", "doc_id": "hp_2295401c0eccc650"}, {"text": "A genre of American roots music that developed in the 1940s in Appalachia.", "chunk_id": "63b2c11074f79f5e", "doc_id": "hp_86eb68204541c171"}]</data>
  <data key="d2">[{"text": "With Alice Gerrard, Dickens was one of the first women to record a bluegrass album.", "chunk_id": "12b5fe23f857cd32", "doc_id": "hp_2295401c0eccc650"}, {"text": "2005, won IBMA for Album of the Year and Recorded Event of the Year for his album \"40,\" celebrating his 40th year(2003) in bluegrass music.", "chunk_id": "63b2c11074f79f5e", "doc_id": "hp_86eb68204541c171"}]</data>
  <data key="d3">["hp_2295401c0eccc650", "hp_86eb68204541c171"]</data>
  <data key="d4">False</data>
</node>
