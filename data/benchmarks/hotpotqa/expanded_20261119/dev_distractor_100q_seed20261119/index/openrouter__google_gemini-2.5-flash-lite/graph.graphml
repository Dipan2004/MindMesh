<node id="F. Hugh Herbert">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The writer of the film 'The Moon Is Blue' and its source play.", "chunk_id": "5d85c27446c62606", "doc_id": "hp_eadec239ee6584cf"}]</data>
  <data key="d2">[{"text": "Written by F. Hugh Herbert and based on his 1951 play of the same title, the film is about a young woman who meets an architect on the observation deck of the Empire State Building and quickly turns his life upside down.", "chunk_id": "5d85c27446c62606", "doc_id": "hp_eadec239ee6584cf"}]</data>
