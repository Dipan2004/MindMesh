<node id="Duncan v. Kahanamoku">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A decision by the United States Supreme Court.", "chunk_id": "c1e246687344e804", "doc_id": "hp_38ad5fccbbab039a"}]</data>
  <data key="d2">[{"text": "Duncan v. Kahanamoku, 327 U.S. 304 (1946), was a decision by the United States Supreme Court.", "chunk_id": "c1e246687344e804", "doc_id": "hp_38ad5fccbbab039a"}]</data>
  <data key="d3">["hp_38ad5fccbbab039a"]</data>
  <data key="d4">False</data>
</node>
<node id="Japanese exclusion cases">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A group of cases associated with Duncan v. Kahanamoku.", "chunk_id": "c1e246687344e804", "doc_id": "hp_38ad5fccbbab039a"}]</data>
  <data key="d2">[{"text": "It is often associated with the Japanese exclusion cases (\"Hirabayashi v. United States\", \"Korematsu v. United States\" and \"Ex parte Endo\") because it involved wartime curtailment of fundamental civil liberties under the aegis of military authority, though in this case neither the plaintiff nor the nominal defendant were Japanese.", "chunk_id": "c1e246687344e804", "doc_id": "hp_38ad5fccbbab039a"}]</data>
  <data key="d3">["hp_38ad5fccbbab039a"]</data>
  <data key="d4">False</data>
</node>
<node id="Hirabayashi v. United States">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A case associated with the Japanese exclusion cases.", "chunk_id": "c1e246687344e804", "doc_id": "hp_38ad5fccbbab039a"}]</data>
  <data key="d2">[{"text": "It is often associated with the Japanese exclusion cases (\"Hirabayashi v. United States\", \"Korematsu v. United States\" and \"Ex parte Endo\") because it involved wartime curtailment of fundamental civil liberties under the aegis of military authority, though in this case neither the plaintiff nor the nominal defendant were Japanese.", "chunk_id": "c1e246687344e804", "doc_id": "hp_38ad5fccbbab039a"}]</data>
  <data key="d3">["hp_38ad5fccbbab039a"]</data>
  <data key="d4">False</data>
</node>
<node id="Ex parte Endo">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A case associated with the Japanese exclusion cases.", "chunk_id": "c1e246687344e804", "doc_id": "hp_38ad5fccbbab039a"}, {"text": "A United States Supreme Court ex parte decision handed down on December 18, 1944.", "chunk_id": "615cdfa10474d8b6", "doc_id": "hp_c36e9406d9e10267"}]</data>
  <data key="d2">[{"text": "It is often associated with the Japanese exclusion cases (\"Hirabayashi v. United States\", \"Korematsu v. United States\" and \"Ex parte Endo\") because it involved wartime curtailment of fundamental civil liberties under the aegis of military authority, though in this case neither the plaintiff nor the nominal defendant were Japanese.", "chunk_id": "c1e246687344e804", "doc_id": "hp_38ad5fccbbab039a"}, {"text": "Ex parte Endo, or Ex parte Mitsuye Endo, 323 U.S. 283 (1944), was a United States Supreme Court ex parte decision handed down on December 18, 1944, in which the Justices unanimously ruled that the U.S. government could not continue to detain a citizen who was \"concededly loyal\" to the United States.", "chunk_id": "615cdfa10474d8b6", "doc_id": "hp_c36e9406d9e10267"}]</data>
  <data key="d3">["hp_38ad5fccbbab039a", "hp_c36e9406d9e10267"]</data>
  <data key="d4">False</data>
</node>
<node id="wartime curtailment of fundamental civil liberties">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The reduction of basic freedoms during a period of war.", "chunk_id": "c1e246687344e804", "doc_id": "hp_38ad5fccbbab039a"}]</data>
  <data key="d2">[{"text": "It is often associated with the Japanese exclusion cases (\"Hirabayashi v. United States\", \"Korematsu v. United States\" and \"Ex parte Endo\") because it involved wartime curtailment of fundamental civil liberties under the aegis of military authority, though in this case neither the plaintiff nor the nominal defendant were Japanese.", "chunk_id": "c1e246687344e804", "doc_id": "hp_38ad5fccbbab039a"}]</data>
  <data key="d3">["hp_38ad5fccbbab039a"]</data>
  <data key="d4">False</data>
</node>
<node id="military authority">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The power and control exercised by the military.", "chunk_id": "c1e246687344e804", "doc_id": "hp_38ad5fccbbab039a"}]</data>
  <data key="d2">[{"text": "It is often associated with the Japanese exclusion cases (\"Hirabayashi v. United States\", \"Korematsu v. United States\" and \"Ex parte Endo\") because it involved wartime curtailment of fundamental civil liberties under the aegis of military authority, though in this case neither the plaintiff nor the nominal defendant were Japanese.", "chunk_id": "c1e246687344e804", "doc_id": "hp_38ad5fccbbab039a"}]</data>
  <data key="d3">["hp_38ad5fccbbab039a"]</data>
