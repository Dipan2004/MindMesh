  <data key="d2">[{"text": "The games have drawn comparison to the \"Professor Layton\" series, which is also published by Level-5.", "chunk_id": "a5fa71ec4370bfe1", "doc_id": "hp_94fc8885003296ef"}]</data>
  <data key="d3">["hp_94fc8885003296ef"]</data>
