<edge source="Warren Hound" target="smell">
  <data key="d5">["USED_FOR"]</data>
  <data key="d6">Warren hounds tend to work with the sense of smell.</data>
  <data key="d7">[{"text": "Unlike hounds or sighthounds which rely on just one sense, warren hounds tend to work with three senses: smell, sight and hearing.", "chunk_id": "4fb94dbd625515c2", "doc_id": "hp_0a96d1fd16b1ff98", "type": "USED_FOR"}]</data>
  <data key="d8">hp_0a96d1fd16b1ff98</data>
</edge>
