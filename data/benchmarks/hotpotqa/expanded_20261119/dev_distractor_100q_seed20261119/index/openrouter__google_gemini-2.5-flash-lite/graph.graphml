  <data key="d2">[{"text": "It guest starred John Ritter, George Hamilton, and Andy Kaufman (as \"Tony Clifton\")", "chunk_id": "9fddbf6c969855ac", "doc_id": "hp_6926160a248b43c3"}, {"text": "Tony Clifton is a character created by late performance artist Andy Kaufman, who also portrayed him in the late 1970s.", "chunk_id": "c6f60784815bbba5", "doc_id": "hp_89119e061210f745"}, {"text": "In this regard, UFO Phil may be an example of Poe's law and has been compared to Andy Kaufman's persona Tony Clifton.", "chunk_id": "a57b9509e1d93532", "doc_id": "hp_bb2da19e6d96b8c5"}]</data>
