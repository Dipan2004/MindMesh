  <data key="d2">[{"text": "The song was written by lead singer Florence Welch and Francis \"Eg\" White, and produced by Paul Epworth.", "chunk_id": "4a33b3fb6c1ee1fa", "doc_id": "hp_7804b34667739a36"}]</data>
