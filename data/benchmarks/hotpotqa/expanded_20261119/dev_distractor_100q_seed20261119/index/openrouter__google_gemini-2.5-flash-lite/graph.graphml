  <data key="d2">[{"text": "Rio Hondo College offers 23 associate degrees for transfer that guarantee transfer to California State Universities, 50 associate degrees and 60 certificates.", "chunk_id": "75ff884d3fae85e2", "doc_id": "hp_46658770e8628bf3"}]</data>
