  <data key="d7">[{"text": "The lyrics were written by vocalist/guitarist John Corabi and bassist Nikki Sixx, while the music was written by Corabi, Sixx, drummer Tommy Lee and guitarist Mick Mars.", "chunk_id": "624e18b05fcc8d7f", "doc_id": "hp_1b0a2bc66f05d3d7", "type": "WRITTEN_BY"}, {"text": "The lyrics were written by vocalist/guitarist John Corabi and bassist Nikki Sixx, while the music was written by Corabi, Sixx, drummer Tommy Lee and guitarist Mick Mars.", "chunk_id": "624e18b05fcc8d7f", "doc_id": "hp_1b0a2bc66f05d3d7", "type": "MUSIC_WRITTEN_BY"}]</data>
