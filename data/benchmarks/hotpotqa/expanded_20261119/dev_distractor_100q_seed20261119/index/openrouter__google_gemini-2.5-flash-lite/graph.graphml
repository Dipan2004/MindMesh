  <data key="d2">[{"text": "Born in Port Macquarie, New South Wales to farmer William Binney and Sophia Selina Turnbull, he was educated at state schools.", "chunk_id": "53f3bbd1c43e3155", "doc_id": "hp_7820faef8a00d610"}]</data>
