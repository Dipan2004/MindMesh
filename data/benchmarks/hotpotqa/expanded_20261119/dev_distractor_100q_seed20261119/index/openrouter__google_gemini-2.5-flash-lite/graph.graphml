<node id="Hoch Conservatory">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A school for music and the arts established for all age groups.", "chunk_id": "8866c9256d91177d", "doc_id": "hp_530d45fd86f01aa0"}, {"text": "The Hoch Conservatory is an institution founded by Cossmann in Frankfurt.", "chunk_id": "6edb4fdb819c98a3", "doc_id": "hp_67a26b8d9bf904cd"}, {"text": "The Hoch Conservatory in Frankfurt was an institution where Alma Moodie became a teacher.", "chunk_id": "5978fb5d2c7a87fb", "doc_id": "hp_ac759163e3bcf4aa"}, {"text": "The Hoch Conservatory was an institution in Frankfurt where Norman O'Neill studied.", "chunk_id": "4bfef8abd6a74664", "doc_id": "hp_ca727488ffb2c1ba"}, {"text": "The Hoch Conservatory is an institution where Iwan Knorr joined the faculty and became director.", "chunk_id": "902ae288e12f1dfb", "doc_id": "hp_d0d1ade1227af443"}, {"text": "Hoch Conservatory is an institution where Anton Biersack was a fellow.", "chunk_id": "35f0b94190768e0c", "doc_id": "hp_e546658adba29b4c"}]</data>
  <data key="d2">[{"text": "Dr. Hoch’s Konservatorium - Musikakademie was founded in Frankfurt am Main on 22 September 1878.", "chunk_id": "8866c9256d91177d", "doc_id": "hp_530d45fd86f01aa0"}, {"text": "However, in 1878, Cossmann helped found the Hoch Conservatory in Frankfurt, where he occupied the post of teacher of cello.", "chunk_id": "6edb4fdb819c98a3", "doc_id": "hp_67a26b8d9bf904cd"}, {"text": "She became a teacher at the Hoch Conservatory in Frankfurt.", "chunk_id": "5978fb5d2c7a87fb", "doc_id": "hp_ac759163e3bcf4aa"}, {"text": "He studied in London with Arthur Somervell and with Iwan Knorr at the Hoch Conservatory in Frankfurt from 1893 to 1897.", "chunk_id": "4bfef8abd6a74664", "doc_id": "hp_ca727488ffb2c1ba"}, {"text": "In 1883 he settled in Frankfurt, where he joined the faculty of the Hoch Conservatory; in 1908 he became director of the school.", "chunk_id": "902ae288e12f1dfb", "doc_id": "hp_d0d1ade1227af443"}, {"text": "From 1932-1936 he was a fellow at the Hoch Conservatory in Frankfurt am Main.", "chunk_id": "35f0b94190768e0c", "doc_id": "hp_e546658adba29b4c"}]</data>
  <data key="d3">["hp_530d45fd86f01aa0", "hp_67a26b8d9bf904cd", "hp_ac759163e3bcf4aa", "hp_ca727488ffb2c1ba", "hp_d0d1ade1227af443", "hp_e546658adba29b4c"]</data>
  <data key="d4">False</data>
</node>
<node id="Dr. Hoch’s Konservatorium - Musikakademie">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A school for music and the arts established for all age groups.", "chunk_id": "8866c9256d91177d", "doc_id": "hp_530d45fd86f01aa0"}]</data>
  <data key="d2">[{"text": "Dr. Hoch’s Konservatorium - Musikakademie was founded in Frankfurt am Main on 22 September 1878.", "chunk_id": "8866c9256d91177d", "doc_id": "hp_530d45fd86f01aa0"}]</data>
  <data key="d3">["hp_530d45fd86f01aa0"]</data>
  <data key="d4">False</data>
</node>
<node id="Frankfurt am Main">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The city where the Hoch Conservatory was founded.", "chunk_id": "8866c9256d91177d", "doc_id": "hp_530d45fd86f01aa0"}, {"text": "Frankfurt am Main is the city where Joseph Hoch was born and died.", "chunk_id": "43c8b1224e31b404", "doc_id": "hp_a82ec9e667a313c7"}, {"text": "Frankfurt am Main is a location associated with Anton Biersack's death and his professional career.", "chunk_id": "35f0b94190768e0c", "doc_id": "hp_e546658adba29b4c"}]</data>
  <data key="d2">[{"text": "Dr. Hoch’s Konservatorium - Musikakademie was founded in Frankfurt am Main on 22 September 1878.", "chunk_id": "8866c9256d91177d", "doc_id": "hp_530d45fd86f01aa0"}, {"text": "He was born and died in Frankfurt am Main.", "chunk_id": "43c8b1224e31b404", "doc_id": "hp_a82ec9e667a313c7"}, {"text": "Anton Biersack (30 November 1907, Greding - 18 November 1982, Frankfurt am Main) was a German composer and music educator.", "chunk_id": "35f0b94190768e0c", "doc_id": "hp_e546658adba29b4c"}]</data>
  <data key="d3">["hp_530d45fd86f01aa0", "hp_a82ec9e667a313c7", "hp_e546658adba29b4c"]</data>
  <data key="d4">False</data>
</node>
<node id="Joseph Hoch">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A generous benefactor who bequeathed one million German gold marks to the Conservatory.", "chunk_id": "8866c9256d91177d", "doc_id": "hp_530d45fd86f01aa0"}, {"text": "Joseph Hoch was a German lawyer and benefactor.", "chunk_id": "43c8b1224e31b404", "doc_id": "hp_a82ec9e667a313c7"}]</data>
  <data key="d2">[{"text": "Through the generosity of Frankfurter Joseph Hoch, who bequeathed the Conservatory one million German gold marks in his testament, a school for music and the arts was established for all age groups.", "chunk_id": "8866c9256d91177d", "doc_id": "hp_530d45fd86f01aa0"}, {"text": "Joseph Paul Johannes Hoch (May 3, 1815 – September 19, 1874) was a German lawyer and benefactor.", "chunk_id": "43c8b1224e31b404", "doc_id": "hp_a82ec9e667a313c7"}]</data>
  <data key="d3">["hp_530d45fd86f01aa0", "hp_a82ec9e667a313c7"]</data>
  <data key="d4">False</data>
</node>
<node id="Joachim Raff">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The director instrumental to the foundation, prosperity, and success of the Conservatory.", "chunk_id": "8866c9256d91177d", "doc_id": "hp_530d45fd86f01aa0"}]</data>
  <data key="d2">[{"text": "Instrumental to the foundation, prosperity and success of the Conservatory was its director Joachim Raff who did most of the work including setting the entire curriculum and hiring all its faculty.", "chunk_id": "8866c9256d91177d", "doc_id": "hp_530d45fd86f01aa0"}]</data>
  <data key="d3">["hp_530d45fd86f01aa0"]</data>
  <data key="d4">False</data>
</node>
<node id="Clara Schumann">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A distinguished teacher at the Conservatory in the late 19th century.", "chunk_id": "8866c9256d91177d", "doc_id": "hp_530d45fd86f01aa0"}, {"text": "A German musician and composer, considered one of the most distinguished pianists of the Romantic era.", "chunk_id": "933ccb664a9a5ee9", "doc_id": "hp_82f5ebc51e47c5a7"}]</data>
  <data key="d2">[{"text": "Many distinguished have taught there: in the late 19th century, with such teachers as Clara Schumann on the faculty, the Conservatory achieved international renown.", "chunk_id": "8866c9256d91177d", "doc_id": "hp_530d45fd86f01aa0"}, {"text": "Clara Schumann (\"née\" Clara Josephine Wieck; 13 September 1819 – 20 May 1896) was a German musician and composer, considered one of the most distinguished pianists of the Romantic era.", "chunk_id": "933ccb664a9a5ee9", "doc_id": "hp_82f5ebc51e47c5a7"}]</data>
  <data key="d3">["hp_530d45fd86f01aa0", "hp_82f5ebc51e47c5a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Town Bloody Hall">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A 1971 documentary film of a panel debate between feminist advocates and activist Norman Mailer.", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}]</data>
  <data key="d2">[{"text": "Town Bloody Hall is a 1971 documentary film of a panel debate between feminist advocates and activist Norman Mailer.", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}]</data>
  <data key="d3">["hp_535589d1805f024e"]</data>
  <data key="d4">False</data>
</node>
<node id="The Town Hall">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The venue in New York City where the panel debate for \"Town Bloody Hall\" was filmed.", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}]</data>
  <data key="d2">[{"text": "Filmed on April 30, 1971, in The Town Hall in New York City, \"Town Bloody Hall\" features a panel of feminist advocates for the women's liberation movement and Norman Mailer, the writer of \"The Prisoner of Sex\".", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}]</data>
  <data key="d3">["hp_535589d1805f024e"]</data>
  <data key="d4">False</data>
</node>
<node id="women's liberation movement">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A social movement advocating for women's rights and liberation, represented by feminist advocates in the \"Town Bloody Hall\" debate.", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}]</data>
  <data key="d2">[{"text": "Filmed on April 30, 1971, in The Town Hall in New York City, \"Town Bloody Hall\" features a panel of feminist advocates for the women's liberation movement and Norman Mailer, the writer of \"The Prisoner of Sex\".", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}]</data>
  <data key="d3">["hp_535589d1805f024e"]</data>
  <data key="d4">False</data>
</node>
<node id="The Prisoner of Sex">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A work written by Norman Mailer, mentioned in the context of the \"Town Bloody Hall\" documentary.", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}]</data>
  <data key="d2">[{"text": "Filmed on April 30, 1971, in The Town Hall in New York City, \"Town Bloody Hall\" features a panel of feminist advocates for the women's liberation movement and Norman Mailer, the writer of \"The Prisoner of Sex\".", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}]</data>
  <data key="d3">["hp_535589d1805f024e"]</data>
  <data key="d4">False</data>
</node>
<node id="Chris Hegedus">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "One of the producers of the \"Town Bloody Hall\" film.", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}]</data>
  <data key="d2">[{"text": "Chris Hegedus and D. A. Pennebaker produced the film, which stars Jacqueline Ceballos, Germaine Greer, Jill Johnston, Diane Trilling, and Norman Mailer.", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}]</data>
