<node id="Texas">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Texas is a state where NRG Energy is dual-headquartered.", "chunk_id": "0858b37893c7da84", "doc_id": "hp_550e1a84a858e0b2"}, {"text": "Texas is a location where Barrie Karp was born.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}, {"text": "Texas is a state in the USA.", "chunk_id": "4794c1c9636159ee", "doc_id": "hp_81c072f4caf17f94"}, {"text": "Texas is a state in the USA.", "chunk_id": "2d5dab65a3cc728c", "doc_id": "hp_820a487fadeec10e"}, {"text": "State in the United States, formerly governed by John Connally.", "chunk_id": "54142f25de20997e", "doc_id": "hp_adfdee30bf450e7d"}, {"text": "Texas is a state where Bothriochloa ischaemum var. songarica is an invasive weed.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d2">[{"text": "NRG Energy, Inc. is a large American energy company, dual-headquartered in West Windsor Township, New Jersey, and Houston, Texas.", "chunk_id": "0858b37893c7da84", "doc_id": "hp_550e1a84a858e0b2"}, {"text": "Barrie Karp (born 1945 in Laredo, Texas) is an artist, independent scholar and academic.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}, {"text": "Rio Hondo Independent School District is a public school district based in Rio Hondo, Texas (USA).", "chunk_id": "4794c1c9636159ee", "doc_id": "hp_81c072f4caf17f94"}, {"text": "The Swiss Avenue Historic District is a residential neighborhood in East Dallas, Dallas, Texas (USA).", "chunk_id": "2d5dab65a3cc728c", "doc_id": "hp_820a487fadeec10e"}, {"text": "Nixon considered selecting former Texas Governor John Connally, New York Governor Nelson Rockefeller, and California Governor Ronald Reagan.", "chunk_id": "54142f25de20997e", "doc_id": "hp_adfdee30bf450e7d"}, {"text": "Var. \"songarica\" is an invasive weed in Texas, where it is known as \"King Ranch bluestem\"; it has displaced native grasses in large areas of central and south Texas.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d3">["hp_550e1a84a858e0b2", "hp_65a971e7a10d79c8", "hp_81c072f4caf17f94", "hp_820a487fadeec10e", "hp_adfdee30bf450e7d", "hp_f7e1751d7e276925"]</data>
