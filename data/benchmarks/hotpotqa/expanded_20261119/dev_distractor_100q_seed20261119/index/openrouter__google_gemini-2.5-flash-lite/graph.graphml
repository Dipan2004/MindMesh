<node id="Minnesota">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Minnesota is a state in the United States where Warroad is located.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e"}, {"text": "Minnesota is a state in the United States.", "chunk_id": "60d483d501d17f6f", "doc_id": "hp_936dd5018d3d1151"}]</data>
  <data key="d2">[{"text": "The Warroad Lakers were an American Senior ice hockey team from Warroad, Minnesota.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e"}, {"text": "Eastcliff is a 20-room house overlooking the Mississippi River in St. Paul, Minnesota, which serves as the official residence of the president of the University of Minnesota system.", "chunk_id": "60d483d501d17f6f", "doc_id": "hp_936dd5018d3d1151"}]</data>
