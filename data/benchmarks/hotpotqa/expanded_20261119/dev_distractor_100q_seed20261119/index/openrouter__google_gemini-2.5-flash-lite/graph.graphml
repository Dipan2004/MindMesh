<node id="Marvel Cinematic Universe">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A shared continuity universe for films and television episodes based on Marvel Comics.", "chunk_id": "4da76e4d337b9c8c", "doc_id": "hp_e82af13d2d3c78de"}]</data>
  <data key="d2">[{"text": "It is the first television episode to be set in the Marvel Cinematic Universe (MCU), sharing continuity with the films of the franchise.", "chunk_id": "4da76e4d337b9c8c", "doc_id": "hp_e82af13d2d3c78de"}]</data>
