  <data key="d2">[{"text": "Honey, We Shrunk Ourselves is a 1997 live-action direct-to-video sequel to \"Honey, I Shrunk the Kids\" and \"Honey, I Blew Up the Kid\".", "chunk_id": "dc5757b648896eba", "doc_id": "hp_a279428a0dd44903"}]</data>
