  <data key="d7">[{"text": "Walker served in the administration of President Richard Nixon, first as the first Director of the White House Office of Presidential Advance, and later as Director of the National Park Service (1972–1975).", "chunk_id": "17e54dbd5dd980bc", "doc_id": "hp_cdb59476dc4f3e8a", "type": "WORKED_FOR"}]</data>
