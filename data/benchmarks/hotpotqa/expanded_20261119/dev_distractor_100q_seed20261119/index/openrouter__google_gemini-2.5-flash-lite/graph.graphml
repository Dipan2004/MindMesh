</node>
<node id="Hi-Standard">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A band associated with Ken Yokoyama.", "chunk_id": "7fcbe97a0e441ab4", "doc_id": "hp_d534800743a3d491"}]</data>
  <data key="d2">[{"text": "Pizza of Death is a Japanese record label based in Tokyo, Japan, and was founded by Hi-Standard front man Ken Yokoyama.", "chunk_id": "7fcbe97a0e441ab4", "doc_id": "hp_d534800743a3d491"}]</data>
  <data key="d3">["hp_d534800743a3d491"]</data>
  <data key="d4">False</data>
</node>
<node id="Fat Wreck Chords">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A record label that Pizza of Death Records was initially a part of.", "chunk_id": "7fcbe97a0e441ab4", "doc_id": "hp_d534800743a3d491"}]</data>
  <data key="d2">[{"text": "It was created in 1994 as a record label inside a record label (Fat Wreck Chords), and officially established itself as fully independent in 1999 with the release of Hi-Standard's \"Making the Road\".", "chunk_id": "7fcbe97a0e441ab4", "doc_id": "hp_d534800743a3d491"}]</data>
  <data key="d3">["hp_d534800743a3d491"]</data>
  <data key="d4">False</data>
</node>
<node id="Making the Road">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An album released by Hi-Standard in 1999.", "chunk_id": "7fcbe97a0e441ab4", "doc_id": "hp_d534800743a3d491"}]</data>
  <data key="d2">[{"text": "It was created in 1994 as a record label inside a record label (Fat Wreck Chords), and officially established itself as fully independent in 1999 with the release of Hi-Standard's \"Making the Road\".", "chunk_id": "7fcbe97a0e441ab4", "doc_id": "hp_d534800743a3d491"}]</data>
  <data key="d3">["hp_d534800743a3d491"]</data>
  <data key="d4">False</data>
</node>
<node id="Me First and the Gimme Gimmes">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A band associated with Pizza of Death Records and American punk musicians.", "chunk_id": "7fcbe97a0e441ab4", "doc_id": "hp_d534800743a3d491"}]</data>
  <data key="d2">[{"text": "One of these is \"Me First and the Gimme Gimmes\", which is associated with several well-known American punk musicians from the United States, including producer and bassist Fat Mike of NOFX.", "chunk_id": "7fcbe97a0e441ab4", "doc_id": "hp_d534800743a3d491"}]</data>
  <data key="d3">["hp_d534800743a3d491"]</data>
  <data key="d4">False</data>
</node>
