<node id="Retuertas horse">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Retuertas horse is a rare breed of horse indigenous to the Andalusia region of Spain.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d2">[{"text": "The Retuertas horse, Spanish: Caballo de las Retuertas or Caballo de las Retuertas de Doñana , is a rare breed of horse indigenous to the Andalusia region of Spain.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d3">["hp_f5a05d2ab71d3e1b"]</data>
  <data key="d4">False</data>
</node>
<node id="Caballo de las Retuertas">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Caballo de las Retuertas is the Spanish name for the Retuertas horse.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d2">[{"text": "The Retuertas horse, Spanish: Caballo de las Retuertas or Caballo de las Retuertas de Doñana , is a rare breed of horse indigenous to the Andalusia region of Spain.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d3">["hp_f5a05d2ab71d3e1b"]</data>
  <data key="d4">False</data>
