<node id="Battle of Yongju">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A battle that took place as part of the United Nations (UN) offensive towards the Yalu River, against the North Korean forces.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "The Battle of Yongju (21–22 October 1950), also known as the Battle of the Apple Orchard, took place as part of the United Nations (UN) offensive towards the Yalu River, against the North Korean forces which had invaded South Korea during the Korean War.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="Battle of the Apple Orchard">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "An alternative name for the Battle of Yongju.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "The Battle of Yongju (21–22 October 1950), also known as the Battle of the Apple Orchard, took place as part of the United Nations (UN) offensive towards the Yalu River, against the North Korean forces which had invaded South Korea during the Korean War.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="United Nations">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An international organization involved in the UN offensive towards the Yalu River.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "The Battle of Yongju (21–22 October 1950), also known as the Battle of the Apple Orchard, took place as part of the United Nations (UN) offensive towards the Yalu River, against the North Korean forces which had invaded South Korea during the Korean War.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="Yalu River">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A river towards which the United Nations (UN) offensive was directed.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "The Battle of Yongju (21–22 October 1950), also known as the Battle of the Apple Orchard, took place as part of the United Nations (UN) offensive towards the Yalu River, against the North Korean forces which had invaded South Korea during the Korean War.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="North Korean forces">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Forces that invaded South Korea and fought against the UN offensive.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "The Battle of Yongju (21–22 October 1950), also known as the Battle of the Apple Orchard, took place as part of the United Nations (UN) offensive towards the Yalu River, against the North Korean forces which had invaded South Korea during the Korean War.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="27th British Commonwealth Brigade">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A military brigade that fought in the Battle of Yongju.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "The battle was fought between the 27th British Commonwealth Brigade and the North Korean 239th Regiment which was encircled east of Yongju, where it was attacking the US 187th Airborne Regimental Combat Team (US 187 RCT).", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="North Korean 239th Regiment">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A regiment that fought against the 27th British Commonwealth Brigade and was encircled east of Yongju.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}, {"text": "A regiment that attacked the US 187th Airborne Regimental Combat Team as it advanced south.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "The battle was fought between the 27th British Commonwealth Brigade and the North Korean 239th Regiment which was encircled east of Yongju, where it was attacking the US 187th Airborne Regimental Combat Team (US 187 RCT).", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}, {"text": "However, on 21 October as US 187 RCT began to advance south to the clear the Sukchon to Yongju road towards Pyongyang the Americans came under heavy attack from the North Korean 239th Regiment, and requested assistance.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="Yongju">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location east of which the North Korean 239th Regiment was encircled.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "The battle was fought between the 27th British Commonwealth Brigade and the North Korean 239th Regiment which was encircled east of Yongju, where it was attacking the US 187th Airborne Regimental Combat Team (US 187 RCT).", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="US 187th Airborne Regimental Combat Team">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A US Army unit that was being attacked by the North Korean 239th Regiment east of Yongju.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "The battle was fought between the 27th British Commonwealth Brigade and the North Korean 239th Regiment which was encircled east of Yongju, where it was attacking the US 187th Airborne Regimental Combat Team (US 187 RCT).", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="US 187 RCT">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An abbreviation for the US 187th Airborne Regimental Combat Team.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "On 20 October US 187 RCT had parachuted ahead of the advancing UN spearheads into drop zones in Sukchon and Sunchon, 40 km north of the capital Pyongyang, with the objectives of cutting off the retreating North Korean forces that were withdrawing up the west coast of the Korean Peninsula and releasing American and South Korean prisoners of war.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="Sukchon">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A drop zone for the US 187 RCT, located north of Pyongyang.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "On 20 October US 187 RCT had parachuted ahead of the advancing UN spearheads into drop zones in Sukchon and Sunchon, 40 km north of the capital Pyongyang, with the objectives of cutting off the retreating North Korean forces that were withdrawing up the west coast of the Korean Peninsula and releasing American and South Korean prisoners of war.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="Sunchon">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A drop zone for the US 187 RCT, located north of Pyongyang.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "On 20 October US 187 RCT had parachuted ahead of the advancing UN spearheads into drop zones in Sukchon and Sunchon, 40 km north of the capital Pyongyang, with the objectives of cutting off the retreating North Korean forces that were withdrawing up the west coast of the Korean Peninsula and releasing American and South Korean prisoners of war.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="Pyongyang">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The capital city, located south of Sukchon and Sunchon.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "On 20 October US 187 RCT had parachuted ahead of the advancing UN spearheads into drop zones in Sukchon and Sunchon, 40 km north of the capital Pyongyang, with the objectives of cutting off the retreating North Korean forces that were withdrawing up the west coast of the Korean Peninsula and releasing American and South Korean prisoners of war.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="American and South Korean prisoners of war">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Prisoners that the US 187 RCT aimed to release.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "On 20 October US 187 RCT had parachuted ahead of the advancing UN spearheads into drop zones in Sukchon and Sunchon, 40 km north of the capital Pyongyang, with the objectives of cutting off the retreating North Korean forces that were withdrawing up the west coast of the Korean Peninsula and releasing American and South Korean prisoners of war.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="Ceanothus leucodermis">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Ceanothus leucodermis is a species of shrub in the buckthorn family Rhamnaceae.", "chunk_id": "c9bcac595ad54970", "doc_id": "hp_c2054f4e8704c0e5"}]</data>
  <data key="d2">[{"text": "Ceanothus leucodermis, with the common name chaparral whitethorn or chaparral white thorn, is a species of shrub in the buckthorn family Rhamnaceae.", "chunk_id": "c9bcac595ad54970", "doc_id": "hp_c2054f4e8704c0e5"}]</data>
  <data key="d3">["hp_c2054f4e8704c0e5"]</data>
  <data key="d4">False</data>
</node>
<node id="chaparral whitethorn">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Chaparral whitethorn is a common name for the species Ceanothus leucodermis.", "chunk_id": "c9bcac595ad54970", "doc_id": "hp_c2054f4e8704c0e5"}]</data>
  <data key="d2">[{"text": "Ceanothus leucodermis, with the common name chaparral whitethorn or chaparral white thorn, is a species of shrub in the buckthorn family Rhamnaceae.", "chunk_id": "c9bcac595ad54970", "doc_id": "hp_c2054f4e8704c0e5"}]</data>
  <data key="d3">["hp_c2054f4e8704c0e5"]</data>
  <data key="d4">False</data>
</node>
<node id="chaparral white thorn">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Chaparral white thorn is a common name for the species Ceanothus leucodermis.", "chunk_id": "c9bcac595ad54970", "doc_id": "hp_c2054f4e8704c0e5"}]</data>
  <data key="d2">[{"text": "Ceanothus leucodermis, with the common name chaparral whitethorn or chaparral white thorn, is a species of shrub in the buckthorn family Rhamnaceae.", "chunk_id": "c9bcac595ad54970", "doc_id": "hp_c2054f4e8704c0e5"}]</data>
  <data key="d3">["hp_c2054f4e8704c0e5"]</data>
  <data key="d4">False</data>
</node>
<node id="mule deer">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Mule deer are a type of ungulate that consumes Ceanothus leucodermis.", "chunk_id": "c9bcac595ad54970", "doc_id": "hp_c2054f4e8704c0e5"}]</data>
  <data key="d2">[{"text": "This \"Ceanothus\" is an importance browse for several types of ungulate, such as the mule deer and bighorn sheep, who prefer the new growth and shoots to the older, spiny parts.", "chunk_id": "c9bcac595ad54970", "doc_id": "hp_c2054f4e8704c0e5"}]</data>
  <data key="d3">["hp_c2054f4e8704c0e5"]</data>
  <data key="d4">False</data>
</node>
<node id="bighorn sheep">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Bighorn sheep are a type of ungulate that consumes Ceanothus leucodermis.", "chunk_id": "c9bcac595ad54970", "doc_id": "hp_c2054f4e8704c0e5"}]</data>
  <data key="d2">[{"text": "This \"Ceanothus\" is an importance browse for several types of ungulate, such as the mule deer and bighorn sheep, who prefer the new growth and shoots to the older, spiny parts.", "chunk_id": "c9bcac595ad54970", "doc_id": "hp_c2054f4e8704c0e5"}]</data>
  <data key="d3">["hp_c2054f4e8704c0e5"]</data>
  <data key="d4">False</data>
</node>
<node id="Catan: Cities &amp; Knights">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An expansion to the board game \"The Settlers of Catan\" for three to four players.", "chunk_id": "42769d289195cfc3", "doc_id": "hp_c20f6b270e53f1ff"}]</data>
  <data key="d2">[{"text": "Catan: Cities &amp; Knights (German: \"Städte und Ritter\" ), formerly \"The Cities and Knights of Catan\" is an expansion to the board game \"The Settlers of Catan\" for three to four players (five to six player play is also possible with the \"Settlers\" and \"Cities &amp; Knights\" five to six player extensions; two-player play is possible with the \"\" expansion).", "chunk_id": "42769d289195cfc3", "doc_id": "hp_c20f6b270e53f1ff"}]</data>
  <data key="d3">["hp_c20f6b270e53f1ff"]</data>
  <data key="d4">False</data>
</node>
<node id="Städte und Ritter">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The German name for Catan: Cities &amp; Knights.", "chunk_id": "42769d289195cfc3", "doc_id": "hp_c20f6b270e53f1ff"}]</data>
  <data key="d2">[{"text": "Catan: Cities &amp; Knights (German: \"Städte und Ritter\" ), formerly \"The Cities and Knights of Catan\" is an expansion to the board game \"The Settlers of Catan\" for three to four players (five to six player play is also possible with the \"Settlers\" and \"Cities &amp; Knights\" five to six player extensions; two-player play is possible with the \"\" expansion).", "chunk_id": "42769d289195cfc3", "doc_id": "hp_c20f6b270e53f1ff"}]</data>
  <data key="d3">["hp_c20f6b270e53f1ff"]</data>
  <data key="d4">False</data>
</node>
<node id="The Cities and Knights of Catan">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A former name for Catan: Cities &amp; Knights.", "chunk_id": "42769d289195cfc3", "doc_id": "hp_c20f6b270e53f1ff"}]</data>
  <data key="d2">[{"text": "Catan: Cities &amp; Knights (German: \"Städte und Ritter\" ), formerly \"The Cities and Knights of Catan\" is an expansion to the board game \"The Settlers of Catan\" for three to four players (five to six player play is also possible with the \"Settlers\" and \"Cities &amp; Knights\" five to six player extensions; two-player play is possible with the \"\" expansion).", "chunk_id": "42769d289195cfc3", "doc_id": "hp_c20f6b270e53f1ff"}]</data>
  <data key="d3">["hp_c20f6b270e53f1ff"]</data>
  <data key="d4">False</data>
</node>
<node id="knights">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A feature in Catan: Cities &amp; Knights used for attacking other players and defending Catan against a common foe.", "chunk_id": "42769d289195cfc3", "doc_id": "hp_c20f6b270e53f1ff"}]</data>
  <data key="d2">[{"text": "It contains features taken from \"The Settlers of Catan\", with emphasis on city development and the use of knights, which are used as a method of attacking other players as well as helping opponents defend Catan against a common foe.", "chunk_id": "42769d289195cfc3", "doc_id": "hp_c20f6b270e53f1ff"}]</data>
  <data key="d3">["hp_c20f6b270e53f1ff"]</data>
  <data key="d4">False</data>
</node>
<node id="city development">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A focus of the expansion Catan: Cities &amp; Knights.", "chunk_id": "42769d289195cfc3", "doc_id": "hp_c20f6b270e53f1ff"}]</data>
  <data key="d2">[{"text": "It contains features taken from \"The Settlers of Catan\", with emphasis on city development and the use of knights, which are used as a method of attacking other players as well as helping opponents defend Catan against a common foe.", "chunk_id": "42769d289195cfc3", "doc_id": "hp_c20f6b270e53f1ff"}]</data>
  <data key="d3">["hp_c20f6b270e53f1ff"]</data>
  <data key="d4">False</data>
</node>
<node id="Superior Bancorp">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Superior Bancorp was a southeastern community thrift with approximately $3.2 billion in assets in 2010.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d2">[{"text": "Superior Bancorp, and its principal subsidiary Superior Bank, was a southeastern community thrift with approximately $3.2 billion in assets in 2010.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d3">["hp_c26329b4dd98f983"]</data>
  <data key="d4">False</data>
</node>
<node id="Superior Bank">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Superior Bank was the principal subsidiary of Superior Bancorp.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d2">[{"text": "Superior Bancorp, and its principal subsidiary Superior Bank, was a southeastern community thrift with approximately $3.2 billion in assets in 2010.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d3">["hp_c26329b4dd98f983"]</data>
  <data key="d4">False</data>
</node>
<node id="Alabama">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Alabama is a state where Superior Bancorp had its corporate headquarters and a significant number of branch locations.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d2">[{"text": "The company was publicly held and had its corporate headquarters in Birmingham, Alabama.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d3">["hp_c26329b4dd98f983"]</data>
  <data key="d4">False</data>
</node>
<node id="The Banc Corporation">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Banc Corporation was the original name of Superior Bancorp when it was founded in 1997.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d2">[{"text": "Superior was founded in 1997 as The Banc Corporation.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d3">["hp_c26329b4dd98f983"]</data>
  <data key="d4">False</data>
</node>
<node id="Regions Financial Corporation">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Regions Financial Corporation was a larger community bank holding company in Alabama than Superior Bancorp.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d2">[{"text": "Before its demise, the company stood as the second-largest community bank holding company in Alabama, behind Regions Financial Corporation, and third largest when including foreign-based, but locally headquartered, BBVA Compass.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d3">["hp_c26329b4dd98f983"]</data>
  <data key="d4">False</data>
</node>
<node id="BBVA Compass">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "BBVA Compass was a foreign-based, but locally headquartered, entity that made Superior Bancorp the third largest community bank holding company in Alabama.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d2">[{"text": "Before its demise, the company stood as the second-largest community bank holding company in Alabama, behind Regions Financial Corporation, and third largest when including foreign-based, but locally headquartered, BBVA Compass.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d3">["hp_c26329b4dd98f983"]</data>
  <data key="d4">False</data>
</node>
<node id="John A. Hand Building">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The John A. Hand Building was a historic building on 20th Street North in downtown Birmingham where Superior Bancorp's corporate headquarters were located.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d2">[{"text": "The company's corporate headquarters were located in the historic John A. Hand Building on 20th Street North in downtown Birmingham, which is named after former AmSouth Bancorporation president John A. Hand.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d3">["hp_c26329b4dd98f983"]</data>
  <data key="d4">False</data>
</node>
<node id="20th Street North">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "20th Street North is a street in downtown Birmingham where the John A. Hand Building is located.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d2">[{"text": "The company's corporate headquarters were located in the historic John A. Hand Building on 20th Street North in downtown Birmingham, which is named after former AmSouth Bancorporation president John A. Hand.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d3">["hp_c26329b4dd98f983"]</data>
  <data key="d4">False</data>
</node>
<node id="John A. Hand">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "John A. Hand was the former president of AmSouth Bancorporation and the namesake of the John A. Hand Building.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d2">[{"text": "The company's corporate headquarters were located in the historic John A. Hand Building on 20th Street North in downtown Birmingham, which is named after former AmSouth Bancorporation president John A. Hand.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d3">["hp_c26329b4dd98f983"]</data>
  <data key="d4">False</data>
</node>
<node id="AmSouth Bancorporation">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "AmSouth Bancorporation was an organization whose former president was John A. Hand.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d2">[{"text": "The company's corporate headquarters were located in the historic John A. Hand Building on 20th Street North in downtown Birmingham, which is named after former AmSouth Bancorporation president John A. Hand.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d3">["hp_c26329b4dd98f983"]</data>
  <data key="d4">False</data>
</node>
<node id="FDIC">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "FDIC is an organization that closed Superior Bank on April 15, 2011.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d2">[{"text": "Superior Bank was closed by FDIC on April 15, 2011.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d3">["hp_c26329b4dd98f983"]</data>
  <data key="d4">False</data>
</node>
<node id="Community Bancorp">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Community Bancorp is an organization that created a subsidiary to acquire the assets and branches of Superior Bank.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d2">[{"text": "The bank's branches and its assets were acquired by a newly created subsidiary of Community Bancorp, operating as Superior Bank N.A.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d3">["hp_c26329b4dd98f983"]</data>
  <data key="d4">False</data>
</node>
<node id="Superior Bank N.A.">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Superior Bank N.A. was a newly created subsidiary of Community Bancorp that operated as Superior Bank after acquiring its assets and branches.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d2">[{"text": "The bank's branches and its assets were acquired by a newly created subsidiary of Community Bancorp, operating as Superior Bank N.A.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d3">["hp_c26329b4dd98f983"]</data>
  <data key="d4">False</data>
</node>
<node id="Hockey Canada">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An organization that Allan Cup Hockey is a member of.", "chunk_id": "8a85ab40137c3013", "doc_id": "hp_c2681de15433dd19"}]</data>
  <data key="d2">[{"text": "As a member of the Ontario Hockey Association and Hockey Canada, the league's champion contends for the famed Allan Cup each year.", "chunk_id": "8a85ab40137c3013", "doc_id": "hp_c2681de15433dd19"}]</data>
  <data key="d3">["hp_c2681de15433dd19"]</data>
  <data key="d4">False</data>
</node>
<node id="Eastern Ontario Senior Hockey League">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A senior hockey league that merged with Allan Cup Hockey in 2008.", "chunk_id": "8a85ab40137c3013", "doc_id": "hp_c2681de15433dd19"}]</data>
  <data key="d2">[{"text": "The league came to its latest incarnation when it lost several teams leaving it with two and as a result it merged with the Eastern Ontario Senior Hockey League in 2008.", "chunk_id": "8a85ab40137c3013", "doc_id": "hp_c2681de15433dd19"}]</data>
  <data key="d3">["hp_c2681de15433dd19"]</data>
  <data key="d4">False</data>
</node>
<node id="Major League Hockey">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The former name of Allan Cup Hockey before 2011.", "chunk_id": "8a85ab40137c3013", "doc_id": "hp_c2681de15433dd19"}]</data>
  <data key="d2">[{"text": "In 2011, the league changed its name from Major League Hockey to Allan Cup Hockey.", "chunk_id": "8a85ab40137c3013", "doc_id": "hp_c2681de15433dd19"}]</data>
  <data key="d3">["hp_c2681de15433dd19"]</data>
  <data key="d4">False</data>
</node>
<node id="National University of Santiago del Estero">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An Argentine national university.", "chunk_id": "248c25f8e90d936e", "doc_id": "hp_c2b1e3eedbd2cd43"}]</data>
  <data key="d2">[{"text": "The National University of Santiago del Estero (Spanish: \"Universidad Nacional de Santiago del Estero\" ) is an Argentine national university located in the capital of Santiago del Estero Province.", "chunk_id": "248c25f8e90d936e", "doc_id": "hp_c2b1e3eedbd2cd43"}]</data>
  <data key="d3">["hp_c2b1e3eedbd2cd43"]</data>
  <data key="d4">False</data>
</node>
<node id="Universidad Nacional de Santiago del Estero">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Spanish name for the National University of Santiago del Estero.", "chunk_id": "248c25f8e90d936e", "doc_id": "hp_c2b1e3eedbd2cd43"}]</data>
  <data key="d2">[{"text": "The National University of Santiago del Estero (Spanish: \"Universidad Nacional de Santiago del Estero\" ) is an Argentine national university located in the capital of Santiago del Estero Province.", "chunk_id": "248c25f8e90d936e", "doc_id": "hp_c2b1e3eedbd2cd43"}]</data>
  <data key="d3">["hp_c2b1e3eedbd2cd43"]</data>
  <data key="d4">False</data>
</node>
<node id="Tucumán University">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A university that had a school of agronomy established in 1949.", "chunk_id": "248c25f8e90d936e", "doc_id": "hp_c2b1e3eedbd2cd43"}]</data>
  <data key="d2">[{"text": "Its 1973 establishment gathered the existing Tucumán University school of agronomy (1949) and the Córdoba University forestry institute (1958), as well as new schools created for the purpose.", "chunk_id": "248c25f8e90d936e", "doc_id": "hp_c2b1e3eedbd2cd43"}]</data>
  <data key="d3">["hp_c2b1e3eedbd2cd43"]</data>
  <data key="d4">False</data>
</node>
<node id="school of agronomy">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A school of agronomy that was part of Tucumán University.", "chunk_id": "248c25f8e90d936e", "doc_id": "hp_c2b1e3eedbd2cd43"}]</data>
  <data key="d2">[{"text": "Its 1973 establishment gathered the existing Tucumán University school of agronomy (1949) and the Córdoba University forestry institute (1958), as well as new schools created for the purpose.", "chunk_id": "248c25f8e90d936e", "doc_id": "hp_c2b1e3eedbd2cd43"}]</data>
  <data key="d3">["hp_c2b1e3eedbd2cd43"]</data>
  <data key="d4">False</data>
</node>
<node id="Córdoba University">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A university that had a forestry institute established in 1958.", "chunk_id": "248c25f8e90d936e", "doc_id": "hp_c2b1e3eedbd2cd43"}]</data>
  <data key="d2">[{"text": "Its 1973 establishment gathered the existing Tucumán University school of agronomy (1949) and the Córdoba University forestry institute (1958), as well as new schools created for the purpose.", "chunk_id": "248c25f8e90d936e", "doc_id": "hp_c2b1e3eedbd2cd43"}]</data>
  <data key="d3">["hp_c2b1e3eedbd2cd43"]</data>
  <data key="d4">False</data>
</node>
<node id="forestry institute">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A forestry institute that was part of Córdoba University.", "chunk_id": "248c25f8e90d936e", "doc_id": "hp_c2b1e3eedbd2cd43"}]</data>
  <data key="d2">[{"text": "Its 1973 establishment gathered the existing Tucumán University school of agronomy (1949) and the Córdoba University forestry institute (1958), as well as new schools created for the purpose.", "chunk_id": "248c25f8e90d936e", "doc_id": "hp_c2b1e3eedbd2cd43"}]</data>
  <data key="d3">["hp_c2b1e3eedbd2cd43"]</data>
  <data key="d4">False</data>
</node>
<node id="surrealist">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A self-labeled surrealist known for animations and features.", "chunk_id": "199af7f0c12c9d9f", "doc_id": "hp_c3249c342e938cd5"}]</data>
  <data key="d2">[{"text": "He is a self-labeled surrealist known for his animations and features, which have greatly influenced other artists such as Terry Gilliam, the Brothers Quay, and many others.", "chunk_id": "199af7f0c12c9d9f", "doc_id": "hp_c3249c342e938cd5"}]</data>
  <data key="d3">["hp_c3249c342e938cd5"]</data>
  <data key="d4">False</data>
</node>
<node id="Terry Gilliam">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An artist influenced by Jan Švankmajer's work.", "chunk_id": "199af7f0c12c9d9f", "doc_id": "hp_c3249c342e938cd5"}]</data>
  <data key="d2">[{"text": "He is a self-labeled surrealist known for his animations and features, which have greatly influenced other artists such as Terry Gilliam, the Brothers Quay, and many others.", "chunk_id": "199af7f0c12c9d9f", "doc_id": "hp_c3249c342e938cd5"}]</data>
  <data key="d3">["hp_c3249c342e938cd5"]</data>
  <data key="d4">False</data>
</node>
<node id="the Brothers Quay">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Artists influenced by Jan Švankmajer's work.", "chunk_id": "199af7f0c12c9d9f", "doc_id": "hp_c3249c342e938cd5"}]</data>
  <data key="d2">[{"text": "He is a self-labeled surrealist known for his animations and features, which have greatly influenced other artists such as Terry Gilliam, the Brothers Quay, and many others.", "chunk_id": "199af7f0c12c9d9f", "doc_id": "hp_c3249c342e938cd5"}]</data>
  <data key="d3">["hp_c3249c342e938cd5"]</data>
  <data key="d4">False</data>
</node>
<node id="Ex parte Mitsuye Endo">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An alternative name for the United States Supreme Court case Ex parte Endo.", "chunk_id": "615cdfa10474d8b6", "doc_id": "hp_c36e9406d9e10267"}]</data>
  <data key="d2">[{"text": "Ex parte Endo, or Ex parte Mitsuye Endo, 323 U.S. 283 (1944), was a United States Supreme Court ex parte decision handed down on December 18, 1944, in which the Justices unanimously ruled that the U.S. government could not continue to detain a citizen who was \"concededly loyal\" to the United States.", "chunk_id": "615cdfa10474d8b6", "doc_id": "hp_c36e9406d9e10267"}]</data>
  <data key="d3">["hp_c36e9406d9e10267"]</data>
  <data key="d4">False</data>
</node>
<node id="U.S. government">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The federal government of the United States.", "chunk_id": "615cdfa10474d8b6", "doc_id": "hp_c36e9406d9e10267"}]</data>
  <data key="d2">[{"text": "Ex parte Endo, or Ex parte Mitsuye Endo, 323 U.S. 283 (1944), was a United States Supreme Court ex parte decision handed down on December 18, 1944, in which the Justices unanimously ruled that the U.S. government could not continue to detain a citizen who was \"concededly loyal\" to the United States.", "chunk_id": "615cdfa10474d8b6", "doc_id": "hp_c36e9406d9e10267"}]</data>
  <data key="d3">["hp_c36e9406d9e10267"]</data>
  <data key="d4">False</data>
</node>
<node id="West Coast">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The western coastal region of the United States.", "chunk_id": "615cdfa10474d8b6", "doc_id": "hp_c36e9406d9e10267"}]</data>
  <data key="d2">[{"text": "Although the Court did not touch on the constitutionality of the exclusion of people of Japanese ancestry from the West Coast—which they had found not to violate citizen rights in their \"Korematsu v. United States\" decision on the same date—the Endo ruling nonetheless led to the reopening of the West Coast to Japanese Americans after their incarceration in camps across the U.S. interior during World War II.", "chunk_id": "615cdfa10474d8b6", "doc_id": "hp_c36e9406d9e10267"}]</data>
  <data key="d3">["hp_c36e9406d9e10267"]</data>
  <data key="d4">False</data>
</node>
<node id="wealthy businessman">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A wealthy businessman was primarily responsible for forming the Huffman Historic District at the end of the nineteenth century.", "chunk_id": "bbb6119acb937cda", "doc_id": "hp_c38e964da8a4abbb"}]</data>
  <data key="d2">[{"text": "Formed at the end of the nineteenth century primarily by a wealthy businessman, it has long been home to people of many different occupations and numerous places on the social ladder.", "chunk_id": "bbb6119acb937cda", "doc_id": "hp_c38e964da8a4abbb"}]</data>
  <data key="d3">["hp_c38e964da8a4abbb"]</data>
  <data key="d4">False</data>
</node>
<node id="twentieth century">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The twentieth century was a period of time during which the Huffman Historic District saw very few changes.", "chunk_id": "bbb6119acb937cda", "doc_id": "hp_c38e964da8a4abbb"}]</data>
  <data key="d2">[{"text": "After seeing very few changes throughout the twentieth century, it was named a historic site in the 1980s.", "chunk_id": "bbb6119acb937cda", "doc_id": "hp_c38e964da8a4abbb"}]</data>
  <data key="d3">["hp_c38e964da8a4abbb"]</data>
  <data key="d4">False</data>
</node>
<node id="historic site">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Huffman Historic District was named a historic site in the 1980s.", "chunk_id": "bbb6119acb937cda", "doc_id": "hp_c38e964da8a4abbb"}]</data>
  <data key="d2">[{"text": "After seeing very few changes throughout the twentieth century, it was named a historic site in the 1980s.", "chunk_id": "bbb6119acb937cda", "doc_id": "hp_c38e964da8a4abbb"}]</data>
  <data key="d3">["hp_c38e964da8a4abbb"]</data>
  <data key="d4">False</data>
</node>
