  <data key="d2">[{"text": "It was also Federer's earliest exit in this tournament since 2002, and the first time that Federer lost to a player ranked lower than 100 since his loss to then World No. 101 Richard Gasquet at the 2005 Monte Carlo Masters.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608"}, {"text": "This page is a list of the main career statistics of French tennis player, Richard Gasquet.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}, {"text": "Richard Gasquet (] ; born 18 June 1986) is a French professional tennis player who is currently ranked world No. 30 in men's singles by the Association of Tennis Professionals (ATP).", "chunk_id": "9427c18f95847c63", "doc_id": "hp_be33f525d9693352"}]</data>
  <data key="d3">["hp_0e39951795747608", "hp_b9191c704d51a80c", "hp_be33f525d9693352"]</data>
