  <data key="d6">Darland's Lake Nature Reserve is owned by the London Borough of Barnet.</data>
  <data key="d7">[{"text": "It is owned by the London Borough of Barnet and was managed from 1971 by the Hertfordshire and Middlesex Wildlife Trust, and more recently by the borough council.", "chunk_id": "71ca2b70887b01d6", "doc_id": "hp_e61b677c687681e5", "type": "OWNED_BY"}]</data>
