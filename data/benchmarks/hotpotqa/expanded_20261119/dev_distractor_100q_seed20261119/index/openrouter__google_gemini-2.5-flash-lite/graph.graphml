<node id="Vladimirka road">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A historic road whose route is generally followed by the M7 highway.", "chunk_id": "70054dbfb5decd76", "doc_id": "hp_161706e9647362c5"}]</data>
  <data key="d2">[{"text": "It generally follows the route of the historic Vladimirka road and, to a large extent, forms part of the European route E22.", "chunk_id": "70054dbfb5decd76", "doc_id": "hp_161706e9647362c5"}]</data>
  <data key="d3">["hp_161706e9647362c5"]</data>
  <data key="d4">False</data>
</node>
<node id="European route E22">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An international road network of which the M7 highway forms a part.", "chunk_id": "70054dbfb5decd76", "doc_id": "hp_161706e9647362c5"}, {"text": "European route E22 is a highway that the M9 highway forms a part of.", "chunk_id": "2d8fd36c09df60bf", "doc_id": "hp_360b3afe94cb5e9d"}, {"text": "The European route E22 is one of the longest European routes.", "chunk_id": "048735b969f03581", "doc_id": "hp_f7b91e330a134361"}]</data>
  <data key="d2">[{"text": "It generally follows the route of the historic Vladimirka road and, to a large extent, forms part of the European route E22.", "chunk_id": "70054dbfb5decd76", "doc_id": "hp_161706e9647362c5"}, {"text": "The highway forms a part of the European route E22 which continues across the border to Rēzekne and Riga.", "chunk_id": "2d8fd36c09df60bf", "doc_id": "hp_360b3afe94cb5e9d"}, {"text": "The European route E22 is one of the longest European routes.", "chunk_id": "048735b969f03581", "doc_id": "hp_f7b91e330a134361"}]</data>
  <data key="d3">["hp_161706e9647362c5", "hp_360b3afe94cb5e9d", "hp_f7b91e330a134361"]</data>
  <data key="d4">False</data>
</node>
<node id="África de las Heras">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A Spanish Communist, naturalized Soviet citizen, and KGB Spy.", "chunk_id": "9c96657c56b59858", "doc_id": "hp_16186a29c9da8f74"}]</data>
  <data key="d2">[{"text": "África de las Heras Gavilán (Ceuta, 26 April 1909 – Moscow, 8 March 1988) was a Spanish Communist, naturalized Soviet citizen, and KGB Spy who went by the code name \"Patria\", but also used the names \"María Luisa de las Heras de Darbat\",\"María de la Sierra\",\"Patricia\", \"Ivonne\", \"María de las Heras\", \"Znoi\" and \"María Pavlovna\".", "chunk_id": "9c96657c56b59858", "doc_id": "hp_16186a29c9da8f74"}]</data>
  <data key="d3">["hp_16186a29c9da8f74"]</data>
  <data key="d4">False</data>
</node>
