  <data key="d2">[{"text": "Bauer and Ronna Gradus co-directed two documentary films, \"Sexy Baby\" (2012) and \"Hot Girls Wanted\" (2015).", "chunk_id": "e68c0632f8756f40", "doc_id": "hp_b25d5e6fd3855bd1"}]</data>
