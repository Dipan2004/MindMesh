<node id="Torrence Huffman">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A banker in Dayton, Ohio who loaned pasture land to the Wright brothers.", "chunk_id": "909c6d3ef553b8b9", "doc_id": "hp_8fc220871dced370"}]</data>
  <data key="d2">[{"text": "Torrence Huffman was a banker in Dayton, Ohio who loaned pasture land to the Wright brothers where they perfected their first airplanes and started the first pilot training school.", "chunk_id": "909c6d3ef553b8b9", "doc_id": "hp_8fc220871dced370"}]</data>
  <data key="d3">["hp_8fc220871dced370"]</data>
  <data key="d4">False</data>
</node>
<node id="Wright brothers">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Individuals who perfected their first airplanes and started the first pilot training school on land loaned by Torrence Huffman.", "chunk_id": "909c6d3ef553b8b9", "doc_id": "hp_8fc220871dced370"}]</data>
  <data key="d2">[{"text": "Torrence Huffman was a banker in Dayton, Ohio who loaned pasture land to the Wright brothers where they perfected their first airplanes and started the first pilot training school.", "chunk_id": "909c6d3ef553b8b9", "doc_id": "hp_8fc220871dced370"}]</data>
  <data key="d3">["hp_8fc220871dced370"]</data>
  <data key="d4">False</data>
</node>
<node id="Huffman Prairie">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "An 84-acre field, formerly Torrence Huffman's pasture, where the Wright brothers perfected their first airplanes.", "chunk_id": "909c6d3ef553b8b9", "doc_id": "hp_8fc220871dced370"}]</data>
  <data key="d2">[{"text": "The 84-acre field has since been known as Huffman Prairie and is designated a National Historic Landmark and part of Ohio's Dayton Aviation Heritage National Historical Park.", "chunk_id": "909c6d3ef553b8b9", "doc_id": "hp_8fc220871dced370"}]</data>
  <data key="d3">["hp_8fc220871dced370"]</data>
  <data key="d4">False</data>
</node>
<node id="Tom Crouch">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An aviation historian who commented on the significance of the Wright brothers' flights.", "chunk_id": "909c6d3ef553b8b9", "doc_id": "hp_8fc220871dced370"}]</data>
  <data key="d2">[{"text": "\"As their flights grew ever longer in September and October 1905, local citizens and area journalists finally realized that something extraordinary was taking place in the sky over Torrence Huffman’s pasture,\" notes aviation historian Tom Crouch.", "chunk_id": "909c6d3ef553b8b9", "doc_id": "hp_8fc220871dced370"}]</data>
  <data key="d3">["hp_8fc220871dced370"]</data>
  <data key="d4">False</data>
</node>
<node id="National Historic Landmark">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A designation given to Huffman Prairie.", "chunk_id": "909c6d3ef553b8b9", "doc_id": "hp_8fc220871dced370"}]</data>
  <data key="d2">[{"text": "The 84-acre field has since been known as Huffman Prairie and is designated a National Historic Landmark and part of Ohio's Dayton Aviation Heritage National Historical Park.", "chunk_id": "909c6d3ef553b8b9", "doc_id": "hp_8fc220871dced370"}]</data>
  <data key="d3">["hp_8fc220871dced370"]</data>
  <data key="d4">False</data>
</node>
<node id="Dayton Aviation Heritage National Historical Park">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A historical park in Ohio that includes Huffman Prairie.", "chunk_id": "909c6d3ef553b8b9", "doc_id": "hp_8fc220871dced370"}]</data>
  <data key="d2">[{"text": "The 84-acre field has since been known as Huffman Prairie and is designated a National Historic Landmark and part of Ohio's Dayton Aviation Heritage National Historical Park.", "chunk_id": "909c6d3ef553b8b9", "doc_id": "hp_8fc220871dced370"}]</data>
  <data key="d3">["hp_8fc220871dced370"]</data>
  <data key="d4">False</data>
</node>
