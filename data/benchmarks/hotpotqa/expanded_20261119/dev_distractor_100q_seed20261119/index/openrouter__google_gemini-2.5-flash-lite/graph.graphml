  <data key="d2">[{"text": "Michael Leslie Yorke was an Anglican priest in the last decades of the 20th century and the first years of the 21st.", "chunk_id": "8920fade874a14dc", "doc_id": "hp_51685a23dbd90e79"}]</data>
  <data key="d3">["hp_51685a23dbd90e79"]</data>
  <data key="d4">False</data>
</node>
<node id="Midhurst Grammar School">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A grammar school where Michael Yorke was educated.", "chunk_id": "8920fade874a14dc", "doc_id": "hp_51685a23dbd90e79"}]</data>
  <data key="d2">[{"text": "He was born on 25 March 1939 and educated at Midhurst Grammar School and Magdalene College, Cambridge.", "chunk_id": "8920fade874a14dc", "doc_id": "hp_51685a23dbd90e79"}]</data>
  <data key="d3">["hp_51685a23dbd90e79"]</data>
  <data key="d4">False</data>
</node>
<node id="Magdalene College, Cambridge">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A college at Cambridge where Michael Yorke was educated.", "chunk_id": "8920fade874a14dc", "doc_id": "hp_51685a23dbd90e79"}]</data>
  <data key="d2">[{"text": "He was born on 25 March 1939 and educated at Midhurst Grammar School and Magdalene College, Cambridge.", "chunk_id": "8920fade874a14dc", "doc_id": "hp_51685a23dbd90e79"}]</data>
  <data key="d3">["hp_51685a23dbd90e79"]</data>
  <data key="d4">False</data>
</node>
<node id="Croydon Parish Church">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A parish church where Michael Yorke had his first post as a curacy.", "chunk_id": "8920fade874a14dc", "doc_id": "hp_51685a23dbd90e79"}]</data>
  <data key="d2">[{"text": "Ordained in 1965 his first post was a curacy at Croydon Parish Church after which he served as Succentor, Precentor and Chaplain at Chelmsford Cathedral.", "chunk_id": "8920fade874a14dc", "doc_id": "hp_51685a23dbd90e79"}]</data>
  <data key="d3">["hp_51685a23dbd90e79"]</data>
  <data key="d4">False</data>
</node>
<node id="Hadstock">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location where Michael Yorke served as Rector.", "chunk_id": "8920fade874a14dc", "doc_id": "hp_51685a23dbd90e79"}]</data>
  <data key="d2">[{"text": "Following this he was Rector of Hadstock, a Canon Residentiary at Chelmsford Cathedral, Vicar of St Margaret’s with St Nicholas, King’s Lynn and Provost of Portsmouth Cathedral.", "chunk_id": "8920fade874a14dc", "doc_id": "hp_51685a23dbd90e79"}]</data>
  <data key="d3">["hp_51685a23dbd90e79"]</data>
