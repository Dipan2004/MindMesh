</node>
<node id="Santa Fe">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city in New Mexico where the Governor's Mansion is located.", "chunk_id": "8f43bdf21d1f96f0", "doc_id": "hp_c748835c7175602a"}, {"text": "A province neighbouring Santiago del Estero Province.", "chunk_id": "2d1b699909d5d732", "doc_id": "hp_ef86af7ae75bd3a2"}]</data>
  <data key="d2">[{"text": "The current structure, located at 1 Mansion Drive in Santa Fe, New Mexico, has served as the Governor's official residence since 1954.", "chunk_id": "8f43bdf21d1f96f0", "doc_id": "hp_c748835c7175602a"}, {"text": "Neighbouring provinces, clockwise from the north, are Salta, Chaco, Santa Fe, Córdoba, Catamarca and Tucumán.", "chunk_id": "2d1b699909d5d732", "doc_id": "hp_ef86af7ae75bd3a2"}]</data>
  <data key="d3">["hp_c748835c7175602a", "hp_ef86af7ae75bd3a2"]</data>
  <data key="d4">False</data>
</node>
<node id="New Mexico">
