</node>
<node id="Court Streets">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Court Streets is a street that forms a corner with High Street.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d2">[{"text": "The house, at 318 High Street, faces west from the east side of High Street north of the corner at High and Court Streets.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d3">["hp_a8f5a77458dad7ce"]</data>
  <data key="d4">False</data>
</node>
<node id="Honors College">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Honors College, also referred to as Russell House 1828, is located to the north of the Edward Augustus Russell House.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d2">[{"text": "A large wooded lawn extends to the Honors College (Russell House 1828) property to the north.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d3">["hp_a8f5a77458dad7ce"]</data>
  <data key="d4">False</data>
</node>
<node id="Russell House 1828">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Russell House 1828 is another name for the Honors College, located north of the Edward Augustus Russell House.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d2">[{"text": "A large wooded lawn extends to the Honors College (Russell House 1828) property to the north.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d3">["hp_a8f5a77458dad7ce"]</data>
  <data key="d4">False</data>
</node>
<node id="Middletown">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Middletown was a city where High Street was the most prestigious residential area during the 19th century.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d2">[{"text": "High Street between Church and Washington Streets was the most prestigious residential area in Middletown during the 19th century.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d3">["hp_a8f5a77458dad7ce"]</data>
  <data key="d4">False</data>
</node>
<node id="KNK Fraternity">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The KNK Fraternity is an organization that was later home to the Edward Augustus Russell House.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d2">[{"text": "It was later home to the KNK Fraternity of Wesleyan University.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d3">["hp_a8f5a77458dad7ce"]</data>
  <data key="d4">False</data>
</node>
<node id="Greek Revival">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Greek Revival is an architectural style.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d2">[{"text": "The Edward Augustus Russell House is a Greek Revival house on the Wesleyan University campus.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d3">["hp_a8f5a77458dad7ce"]</data>
