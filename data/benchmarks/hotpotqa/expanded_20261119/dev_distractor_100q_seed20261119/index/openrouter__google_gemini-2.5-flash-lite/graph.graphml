  <data key="d5">["PARTICIPATED_IN"]</data>
  <data key="d6">Boris Becker partnered with Slobodan Živojinović and withdrew prior to the semifinals match in the 1991 Donnay Indoor Championships – Doubles.</data>
  <data key="d7">[{"text": "Živojinović partnered Boris Becker, withdrawing prior to their semifinals match.", "chunk_id": "72b8f48b7ecf936b", "doc_id": "hp_335fb09af115eccf", "type": "PARTICIPATED_IN"}]</data>
  <data key="d8">hp_335fb09af115eccf</data>
</edge>
