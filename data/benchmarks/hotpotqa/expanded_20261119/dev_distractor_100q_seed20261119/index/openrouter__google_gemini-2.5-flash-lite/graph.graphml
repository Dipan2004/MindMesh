<edge source="Nadine Epstein" target="Moment (magazine)">
  <data key="d5">["EDITOR_OF"]</data>
  <data key="d6">Nadine Epstein took over as editor and executive publisher of Moment magazine.</data>
  <data key="d7">[{"text": "In 2004, Nadine Epstein took over as editor and executive publisher of \"Moment.\"", "chunk_id": "7156f0efb6184faa", "doc_id": "hp_02c3149273f48869", "type": "EDITOR_OF"}]</data>
