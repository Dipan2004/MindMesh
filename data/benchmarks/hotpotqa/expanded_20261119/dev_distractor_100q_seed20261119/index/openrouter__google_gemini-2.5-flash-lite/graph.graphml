</edge>
<edge source="Scombroid food poisoning" target="seafood poisoning">
  <data key="d5">["IS_A"]</data>
  <data key="d6">Scombroid food poisoning is a common type of seafood poisoning.</data>
  <data key="d7">[{"text": "Along with ciguatera, it is listed as a common type of seafood poisoning.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f", "type": "IS_A"}]</data>
  <data key="d8">hp_837937fae6ec3e6f</data>
</edge>
<edge source="Scombroid food poisoning" target="food allergy">
  <data key="d5">["MISIDENTIFIED_AS"]</data>
  <data key="d6">Scombroid food poisoning is often misidentified as a food allergy.</data>
  <data key="d7">[{"text": "As histamine is also the natural agent involved in allergic reactions, scombroid food poisoning often gets misidentified as a food allergy.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f", "type": "MISIDENTIFIED_AS"}]</data>
  <data key="d8">hp_837937fae6ec3e6f</data>
</edge>
<edge source="ciguatera" target="seafood poisoning">
  <data key="d5">["IS_A"]</data>
  <data key="d6">Ciguatera is a type of seafood poisoning.</data>
  <data key="d7">[{"text": "Along with ciguatera, it is listed as a common type of seafood poisoning.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f", "type": "IS_A"}]</data>
  <data key="d8">hp_837937fae6ec3e6f</data>
</edge>
<edge source="histamine" target="Scombroid food poisoning">
  <data key="d5">["RESPONSIBLE_FOR"]</data>
  <data key="d6">Histamine is the toxin believed to be responsible for scombroid food poisoning.</data>
  <data key="d7">[{"text": "The toxin believed to be responsible is histamine, formed as the flesh of the fish begins to decay.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f", "type": "RESPONSIBLE_FOR"}]</data>
  <data key="d8">hp_837937fae6ec3e6f</data>
</edge>
