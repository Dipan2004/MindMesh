  <data key="d6">Michael Jackson is the artist associated with the DVD box set Michael Jackson's Vision.</data>
  <data key="d7">[{"text": "Michael Jackson's Vision is a deluxe DVD box set by American recording artist Michael Jackson.", "chunk_id": "4386b9386a9184fc", "doc_id": "hp_93fcd5b2eb13932b", "type": "PRODUCED_BY"}]</data>
  <data key="d8">hp_93fcd5b2eb13932b</data>
</edge>
<edge source="Michael Jackson" target="short film">
