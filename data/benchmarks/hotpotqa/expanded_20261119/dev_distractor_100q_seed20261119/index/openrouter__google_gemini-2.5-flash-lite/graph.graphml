<node id="Catherine Clarke Fenselau">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An American scientist who was the first trained mass spectrometrist on the faculty of an American medical school.", "chunk_id": "df428fb68cf97b53", "doc_id": "hp_904974320f1d065d"}]</data>
  <data key="d2">[{"text": "Catherine Clarke Fenselau (born 15 April 1939) is an American scientist who was the first trained mass spectrometrist on the faculty of an American medical school; she joined Johns Hopkins School of Medicine in 1968.", "chunk_id": "df428fb68cf97b53", "doc_id": "hp_904974320f1d065d"}]</data>
  <data key="d3">["hp_904974320f1d065d"]</data>
  <data key="d4">False</data>
</node>
<node id="Johns Hopkins School of Medicine">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An American medical school where Catherine Clarke Fenselau joined in 1968.", "chunk_id": "df428fb68cf97b53", "doc_id": "hp_904974320f1d065d"}]</data>
  <data key="d2">[{"text": "Catherine Clarke Fenselau (born 15 April 1939) is an American scientist who was the first trained mass spectrometrist on the faculty of an American medical school; she joined Johns Hopkins School of Medicine in 1968.", "chunk_id": "df428fb68cf97b53", "doc_id": "hp_904974320f1d065d"}]</data>
  <data key="d3">["hp_904974320f1d065d"]</data>
  <data key="d4">False</data>
</node>
<node id="mass spectrometry">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A scientific technique used in biomedical applications and to study biomolecules.", "chunk_id": "df428fb68cf97b53", "doc_id": "hp_904974320f1d065d"}]</data>
  <data key="d2">[{"text": "She specializes in biomedical applications of mass spectrometry.", "chunk_id": "df428fb68cf97b53", "doc_id": "hp_904974320f1d065d"}]</data>
  <data key="d3">["hp_904974320f1d065d"]</data>
  <data key="d4">False</data>
</node>
<node id="bioanalytical chemistry">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A field in which Catherine Clarke Fenselau has been recognized as an outstanding scientist.", "chunk_id": "df428fb68cf97b53", "doc_id": "hp_904974320f1d065d"}]</data>
  <data key="d2">[{"text": "She has been recognized as an outstanding scientist in the field of bioanalytical chemistry because of her work using mass spectrometry to study biomolecules.", "chunk_id": "df428fb68cf97b53", "doc_id": "hp_904974320f1d065d"}]</data>
  <data key="d3">["hp_904974320f1d065d"]</data>
  <data key="d4">False</data>
</node>
<node id="biomolecules">
