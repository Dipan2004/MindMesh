  <data key="d2">[{"text": "The day after hitting one million subscribers, the video game channel G4 crowned Nice Peter the King of Dot Comedy on \"Attack of the Show\".", "chunk_id": "139ff0daddde19f6", "doc_id": "hp_47717c3619ee9332"}]</data>
