  <data key="d2">[{"text": "Gül Mosque (Turkish: \"Gül Camii\" , meaning: \"The Mosque of the Rose\" in English) is a former Eastern Orthodox church in Istanbul, Turkey, converted into a mosque by the Ottomans.", "chunk_id": "8567d31eef2db61e", "doc_id": "hp_7afc03b2a09c3287"}]</data>
  <data key="d3">["hp_7afc03b2a09c3287"]</data>
  <data key="d4">False</data>
</node>
<node id="The Mosque of the Rose">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The English meaning of the Turkish name \"Gül Camii\".", "chunk_id": "8567d31eef2db61e", "doc_id": "hp_7afc03b2a09c3287"}]</data>
  <data key="d2">[{"text": "Gül Mosque (Turkish: \"Gül Camii\" , meaning: \"The Mosque of the Rose\" in English) is a former Eastern Orthodox church in Istanbul, Turkey, converted into a mosque by the Ottomans.", "chunk_id": "8567d31eef2db61e", "doc_id": "hp_7afc03b2a09c3287"}]</data>
  <data key="d3">["hp_7afc03b2a09c3287"]</data>
  <data key="d4">False</data>
</node>
<node id="Eastern Orthodox church">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A type of Christian church that Gül Mosque was formerly.", "chunk_id": "8567d31eef2db61e", "doc_id": "hp_7afc03b2a09c3287"}]</data>
  <data key="d2">[{"text": "Gül Mosque (Turkish: \"Gül Camii\" , meaning: \"The Mosque of the Rose\" in English) is a former Eastern Orthodox church in Istanbul, Turkey, converted into a mosque by the Ottomans.", "chunk_id": "8567d31eef2db61e", "doc_id": "hp_7afc03b2a09c3287"}]</data>
  <data key="d3">["hp_7afc03b2a09c3287"]</data>
  <data key="d4">False</data>
</node>
<node id="Ottomans">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The group that converted the Gül Mosque into a mosque.", "chunk_id": "8567d31eef2db61e", "doc_id": "hp_7afc03b2a09c3287"}]</data>
  <data key="d2">[{"text": "Gül Mosque (Turkish: \"Gül Camii\" , meaning: \"The Mosque of the Rose\" in English) is a former Eastern Orthodox church in Istanbul, Turkey, converted into a mosque by the Ottomans.", "chunk_id": "8567d31eef2db61e", "doc_id": "hp_7afc03b2a09c3287"}]</data>
  <data key="d3">["hp_7afc03b2a09c3287"]</data>
  <data key="d4">False</data>
</node>
<node id="Phytophthora kernoviae">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Phytophthora kernoviae is a plant pathogen that infects European beech and Rhododendron ponticum.", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d2">[{"text": "Phytophthora kernoviae is a plant pathogen that mainly infects European beech (\"Fagus sylvatica\") and \"Rhododendron ponticum\".", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d3">["hp_7b90b80a57936da9"]</data>
  <data key="d4">False</data>
</node>
<node id="Fagus sylvatica">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Fagus sylvatica, also known as European beech, is a plant that can be infected by Phytophthora kernoviae.", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d2">[{"text": "Phytophthora kernoviae is a plant pathogen that mainly infects European beech (\"Fagus sylvatica\") and \"Rhododendron ponticum\".", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d3">["hp_7b90b80a57936da9"]</data>
  <data key="d4">False</data>
</node>
<node id="Rhododendron ponticum">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Rhododendron ponticum is a plant that can be infected by Phytophthora kernoviae, causing necrosis of stems and leaves.", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d2">[{"text": "Phytophthora kernoviae is a plant pathogen that mainly infects European beech (\"Fagus sylvatica\") and \"Rhododendron ponticum\".", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d3">["hp_7b90b80a57936da9"]</data>
  <data key="d4">False</data>
</node>
<node id="Cornwall">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Cornwall is a location in the UK where Phytophthora kernoviae was first identified in 2003.", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d2">[{"text": "It was first identified in 2003 in Cornwall, UK when scientists were surveying for the presence of \"Phytophthora ramorum\".", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d3">["hp_7b90b80a57936da9"]</data>
  <data key="d4">False</data>
</node>
<node id="UK">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The UK is a country where Phytophthora kernoviae was first identified and is the third new Phytophthora species found in a decade.", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}, {"text": "A country where the program 'Richard Hammond's Engineering Connections' is not available for purchase on DVD.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}, {"text": "A location where the tour was performed.", "chunk_id": "da03dc4aa612a116", "doc_id": "hp_b1fcfbca9c340147"}]</data>
  <data key="d2">[{"text": "It was first identified in 2003 in Cornwall, UK when scientists were surveying for the presence of \"Phytophthora ramorum\".", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}, {"text": "None of the three series of the programme are available to purchase on DVD in the UK, however, all three can be watched on demand for subscribers of National Geographic on Sky, Virgin Media and BT Vision.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}, {"text": "They performed in the UK in February - May in 2008 and were at Drury Lane, London for a month.", "chunk_id": "da03dc4aa612a116", "doc_id": "hp_b1fcfbca9c340147"}]</data>
  <data key="d3">["hp_7b90b80a57936da9", "hp_8429039f0ec9c01d", "hp_b1fcfbca9c340147"]</data>
  <data key="d4">False</data>
</node>
<node id="Phytophthora ramorum">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Phytophthora ramorum is a plant pathogen for which scientists were surveying when Phytophthora kernoviae was first identified.", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d2">[{"text": "It was first identified in 2003 in Cornwall, UK when scientists were surveying for the presence of \"Phytophthora ramorum\".", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d3">["hp_7b90b80a57936da9"]</data>
  <data key="d4">False</data>
</node>
<node id="Kernow">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Kernow is the ancient name for Cornwall, after which Phytophthora kernoviae was named.", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d2">[{"text": "It was named \"Phytophthora kernoviae\", after the ancient name for Cornwall, Kernow.", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d3">["hp_7b90b80a57936da9"]</data>
  <data key="d4">False</data>
</node>
<node id="Quercus robur">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Quercus robur is a plant from which Phytophthora kernoviae has been isolated.", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d2">[{"text": "It has also been isolated from \"Quercus robur\" and \"Liriodendron tulipifera\".", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d3">["hp_7b90b80a57936da9"]</data>
  <data key="d4">False</data>
</node>
<node id="Camellia">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Camellia is a genus of plants that the original paper describing Phytophthora kernoviae stated it can infect.", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}, {"text": "A genus of flowering plants in the family Theaceae.", "chunk_id": "a5aa45896dba5811", "doc_id": "hp_e59ae7221bb43fd2"}]</data>
  <data key="d2">[{"text": "The original paper describing the species, stated it can infect \"Magnolia\" and \"Camellia\" species, \"Pieris formosa\", \"Gevuina avellana\", \"Michelia doltsopa\" and \"Quercus ilex\".", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}, {"text": "It is of the genus \"Camellia\" () of flowering plants in the family Theaceae.", "chunk_id": "a5aa45896dba5811", "doc_id": "hp_e59ae7221bb43fd2"}]</data>
  <data key="d3">["hp_7b90b80a57936da9", "hp_e59ae7221bb43fd2"]</data>
  <data key="d4">False</data>
</node>
<node id="Pieris formosa">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Pieris formosa is a plant that the original paper describing Phytophthora kernoviae stated it can infect.", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d2">[{"text": "The original paper describing the species, stated it can infect \"Magnolia\" and \"Camellia\" species, \"Pieris formosa\", \"Gevuina avellana\", \"Michelia doltsopa\" and \"Quercus ilex\".", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d3">["hp_7b90b80a57936da9"]</data>
  <data key="d4">False</data>
</node>
<node id="Gevuina avellana">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Gevuina avellana is a plant that the original paper describing Phytophthora kernoviae stated it can infect.", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d2">[{"text": "The original paper describing the species, stated it can infect \"Magnolia\" and \"Camellia\" species, \"Pieris formosa\", \"Gevuina avellana\", \"Michelia doltsopa\" and \"Quercus ilex\".", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d3">["hp_7b90b80a57936da9"]</data>
  <data key="d4">False</data>
</node>
<node id="Michelia doltsopa">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Michelia doltsopa is a plant that the original paper describing Phytophthora kernoviae stated it can infect.", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d2">[{"text": "The original paper describing the species, stated it can infect \"Magnolia\" and \"Camellia\" species, \"Pieris formosa\", \"Gevuina avellana\", \"Michelia doltsopa\" and \"Quercus ilex\".", "chunk_id": "f0f758ffcef041f7", "doc_id": "hp_7b90b80a57936da9"}]</data>
  <data key="d3">["hp_7b90b80a57936da9"]</data>
