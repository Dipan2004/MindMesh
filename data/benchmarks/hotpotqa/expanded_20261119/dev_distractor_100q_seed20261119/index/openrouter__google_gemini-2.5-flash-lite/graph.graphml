  <data key="d2">[{"text": "The statue of Admiral Yi Sun-sin is located at the Sejongno, Gwanghwamun Plaza in Seoul, South Korea.", "chunk_id": "14151d0231146059", "doc_id": "hp_dd641696f4729ecc"}]</data>
