  <data key="d7">[{"text": "Rockstar Productions GmbH (formerly Neo Software Produktions GmbH), doing business as Rockstar Vienna, was an Austrian Video game developer based in Vienna, Austria, and a subsidiary of Rockstar Games.", "chunk_id": "0cc52c6f4ba06192", "doc_id": "hp_034d7f4890c999d2", "type": "SUBSIDIARY_OF"}, {"text": "In January 2003, during the company's tenth anniversary, the company was rebranded Rockstar Vienna and became part of the Rockstar Games umbrella.", "chunk_id": "0cc52c6f4ba06192", "doc_id": "hp_034d7f4890c999d2", "type": "PART_OF"}]</data>
