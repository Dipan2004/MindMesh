  <data key="d1">[{"text": "A gardening enthusiast for whom Salvia 'Jean's Purple Passion' is named.", "chunk_id": "6c8ea648c2d5ed76", "doc_id": "hp_980453e19b052243"}]</data>
  <data key="d2">[{"text": "It is named for Jean Coria, a gardening enthusiast who propagated many species in the genus Salvia for many years at Strybing Arboretum.", "chunk_id": "6c8ea648c2d5ed76", "doc_id": "hp_980453e19b052243"}]</data>
