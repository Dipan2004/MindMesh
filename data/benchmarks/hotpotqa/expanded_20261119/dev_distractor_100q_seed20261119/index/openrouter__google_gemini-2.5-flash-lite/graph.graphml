<node id="Manon Lescaut (Puccini)">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An opera in four acts by Giacomo Puccini.", "chunk_id": "41a807c0946f5ef1", "doc_id": "hp_de6d3adc813848a7"}]</data>
  <data key="d2">[{"text": "Manon Lescaut is an opera in four acts by Giacomo Puccini, composed between 1890 and 1893.", "chunk_id": "41a807c0946f5ef1", "doc_id": "hp_de6d3adc813848a7"}]</data>
  <data key="d3">["hp_de6d3adc813848a7"]</data>
