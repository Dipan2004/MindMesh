<node id="County Antrim">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A county in Northern Ireland on the side of the River Lagan where the River Farset is located.", "chunk_id": "ffad64e807ea3b1b", "doc_id": "hp_cc911f866aa0efaa"}]</data>
  <data key="d2">[{"text": "The River Farset is on the County Antrim side of the Lagan and joins the Lagan close to its outflow into Belfast Lough.", "chunk_id": "ffad64e807ea3b1b", "doc_id": "hp_cc911f866aa0efaa"}]</data>
  <data key="d3">["hp_cc911f866aa0efaa"]</data>
