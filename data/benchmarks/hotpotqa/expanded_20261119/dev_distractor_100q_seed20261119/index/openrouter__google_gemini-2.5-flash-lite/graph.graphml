<node id="Walter Schmidt">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A benefactor to then-St. Xavier College and the namesake of Schmidt Field House.", "chunk_id": "1e58cf5b1819e294", "doc_id": "hp_8ad2a2590b2211df"}]</data>
  <data key="d2">[{"text": "It is named for Walter Schmidt, Class of 1905, a benefactor to then-St. Xavier College who also donated money for Schmidt Hall (formerly the library, now the President's office) on campus.", "chunk_id": "1e58cf5b1819e294", "doc_id": "hp_8ad2a2590b2211df"}]</data>
  <data key="d3">["hp_8ad2a2590b2211df"]</data>
  <data key="d4">False</data>
</node>
