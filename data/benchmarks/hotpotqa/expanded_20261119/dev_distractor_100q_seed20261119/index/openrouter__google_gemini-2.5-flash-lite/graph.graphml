  <data key="d2">[{"text": "The Rockfords were an American rock band formed in Seattle, Washington, in 1999 by Carrie Akre, Chris Friel, and Danny Newcomb of Goodness, Mike McCready of Pearl Jam, and Rick Friel of Jodie Watts.", "chunk_id": "e75c71d95fdb03f2", "doc_id": "hp_05e3ff9fbf16bf9f"}, {"text": "Goodness featured Akre (vocals), Danny Newcomb (lead guitar), Garth Reeves (guitar), Fiia McGann (bass), and Chris Friel (drums).", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
