<node id="American">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "American refers to the nationality of Mike Cahill.", "chunk_id": "41e58b89c1397856", "doc_id": "hp_466f260eb669476e"}, {"text": "Refers to nationality or origin.", "chunk_id": "7aa9040c2a8f8aeb", "doc_id": "hp_5806d535bccd9d8b"}, {"text": "American refers to the nationality of the author.", "chunk_id": "a437d927bff0c11c", "doc_id": "hp_af7dab417584284c"}, {"text": "Alice Gerrard is from America.", "chunk_id": "4cba1a343443cac4", "doc_id": "hp_d2b3c37a5329d341"}, {"text": "American refers to the nationality of Mark O'Connor.", "chunk_id": "83ff2598ffe55600", "doc_id": "hp_f2e2e7c2a56a9856"}]</data>
  <data key="d2">[{"text": "Mike Cahill (born July 5, 1979) is an American film director and screenwriter.", "chunk_id": "41e58b89c1397856", "doc_id": "hp_466f260eb669476e"}, {"text": "George Seaton (April 17, 1911 – July 28, 1979) was an American screenwriter, playwright, film director and producer, and theatre director.", "chunk_id": "7aa9040c2a8f8aeb", "doc_id": "hp_5806d535bccd9d8b"}, {"text": "Karen Joy Fowler (born February 7, 1950) is an American author of science fiction, fantasy, and literary fiction.", "chunk_id": "a437d927bff0c11c", "doc_id": "hp_af7dab417584284c"}, {"text": "Alice Gerrard (born July 8, 1934) is an American bluegrass singer, banjoist, and guitar player.", "chunk_id": "4cba1a343443cac4", "doc_id": "hp_d2b3c37a5329d341"}, {"text": "Mark O'Connor (born August 5, 1961, Seattle) is an American bluegrass, jazz and country violinist, fiddler, composer and music teacher.", "chunk_id": "83ff2598ffe55600", "doc_id": "hp_f2e2e7c2a56a9856"}]</data>
  <data key="d3">["hp_466f260eb669476e", "hp_5806d535bccd9d8b", "hp_af7dab417584284c", "hp_d2b3c37a5329d341", "hp_f2e2e7c2a56a9856"]</data>
