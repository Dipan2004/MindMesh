  <data key="d5">["PROMOTED_BY", "EULOGIZED_BY"]</data>
  <data key="d6">The film series was heavily promoted by the North Korean media.</data>
  <data key="d7">[{"text": "Initially, the most senior writers, directors and actors were involved in the project and it was heavily promoted and eulogized by the North Korean media.", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882", "type": "PROMOTED_BY"}, {"text": "Initially, the most senior writers, directors and actors were involved in the project and it was heavily promoted and eulogized by the North Korean media.", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882", "type": "EULOGIZED_BY"}]</data>
