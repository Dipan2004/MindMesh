  <data key="d7">[{"text": "However, in 1878, Cossmann helped found the Hoch Conservatory in Frankfurt, where he occupied the post of teacher of cello.", "chunk_id": "6edb4fdb819c98a3", "doc_id": "hp_67a26b8d9bf904cd", "type": "FOUNDED"}, {"text": "However, in 1878, Cossmann helped found the Hoch Conservatory in Frankfurt, where he occupied the post of teacher of cello.", "chunk_id": "6edb4fdb819c98a3", "doc_id": "hp_67a26b8d9bf904cd", "type": "TEACHER_AT"}]</data>
