  <data key="d2">[{"text": "He went on to be Member of Parliament for Orkney and Shetland and became First Naval Lord in the First Melbourne ministry in August 1834 but died in office just two months later in October 1834.", "chunk_id": "d43d20bf97a0fc28", "doc_id": "hp_56ae2e2bc0735743"}]</data>
