<edge source="Michael Jackson" target="Ebony">
  <data key="d5">["INTERVIEWED_BY", "FEATURED_IN"]</data>
  <data key="d6">Michael Jackson did an interview for 'Ebony' magazine's December 2007 issue.</data>
  <data key="d7">[{"text": "Later that month, Jackson did another shoot and an interview for \"Ebony\" magazine's December 2007 issue.", "chunk_id": "824fceecb23d14cd", "doc_id": "hp_a2704beb739d6738", "type": "INTERVIEWED_BY"}, {"text": "Later that month, Jackson did another shoot and an interview for \"Ebony\" magazine's December 2007 issue.", "chunk_id": "824fceecb23d14cd", "doc_id": "hp_a2704beb739d6738", "type": "FEATURED_IN"}]</data>
