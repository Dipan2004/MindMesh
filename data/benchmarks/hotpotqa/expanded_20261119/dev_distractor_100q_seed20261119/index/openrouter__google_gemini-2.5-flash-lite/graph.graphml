<node id="wild Bactrian camel">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A critically endangered species of camel living in parts of northern China and southern Mongolia.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}, {"text": "The wild Bactrian camel is a critically endangered species with limited populations in northwest China and Mongolia.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d2">[{"text": "The wild Bactrian camel (\"Camelus ferus\") is a critically endangered species of camel living in parts of northern China and southern Mongolia.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}, {"text": "The three surviving species of camel are the dromedary, or one-humped camel (\"C. dromedarius\"), which inhabits the Middle East and the Horn of Africa; the Bactrian, or two-humped camel (\"C. bactrianus\"), which inhabits Central Asia; and the critically endangered wild Bactrian camel (\"C. ferus\") that has limited populations in remote areas of northwest China and Mongolia.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d3">["hp_353e9e34cd9559b7", "hp_706e5d69c6cb6d2b"]</data>
  <data key="d4">False</data>
</node>
<node id="Camelus ferus">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The scientific name for the wild Bactrian camel.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d2">[{"text": "The wild Bactrian camel (\"Camelus ferus\") is a critically endangered species of camel living in parts of northern China and southern Mongolia.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d3">["hp_353e9e34cd9559b7"]</data>
  <data key="d4">False</data>
</node>
<node id="domesticated Bactrian camel">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A domesticated species of camel closely related to the wild Bactrian camel.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d2">[{"text": "It is closely related to the domesticated Bactrian camel (\"Camelus bactrianus\").", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d3">["hp_353e9e34cd9559b7"]</data>
  <data key="d4">False</data>
</node>
<node id="Camelus bactrianus">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The scientific name for the domesticated Bactrian camel.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d2">[{"text": "It is closely related to the domesticated Bactrian camel (\"Camelus bactrianus\").", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d3">["hp_353e9e34cd9559b7"]</data>
  <data key="d4">False</data>
</node>
<node id="even-toed ungulates">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A group of mammals characterized by having an even number of toes on each foot.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d2">[{"text": "They are both large, even-toed ungulates native to the steppes of central Asia, with a double hump (small and pyramid-shaped).", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d3">["hp_353e9e34cd9559b7"]</data>
  <data key="d4">False</data>
</node>
<node id="steppes of central Asia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The native habitat of wild and domesticated Bactrian camels.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d2">[{"text": "They are both large, even-toed ungulates native to the steppes of central Asia, with a double hump (small and pyramid-shaped).", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d3">["hp_353e9e34cd9559b7"]</data>
  <data key="d4">False</data>
</node>
<node id="mitochondrial DNA">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Genetic material used to determine the evolutionary divergence of species.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d2">[{"text": "However, a 1.9% difference in mitochondrial DNA suggests a divergence date of 0.7 to 1.5 million years ago, long before the start of domestication.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d3">["hp_353e9e34cd9559b7"]</data>
  <data key="d4">False</data>
</node>
<node id="domestication">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The process of taming and breeding animals for human use.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d2">[{"text": "However, a 1.9% difference in mitochondrial DNA suggests a divergence date of 0.7 to 1.5 million years ago, long before the start of domestication.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d3">["hp_353e9e34cd9559b7"]</data>
  <data key="d4">False</data>
</node>
<node id="Gobi Desert">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A remote desert region in Mongolia where wild Bactrian camels are found.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d2">[{"text": "It is restricted in the wild to remote regions of the Gobi and Taklamakan Deserts of Mongolia and Xinjiang.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d3">["hp_353e9e34cd9559b7"]</data>
  <data key="d4">False</data>
</node>
<node id="Taklamakan Desert">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A remote desert region in Xinjiang where wild Bactrian camels are found.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d2">[{"text": "It is restricted in the wild to remote regions of the Gobi and Taklamakan Deserts of Mongolia and Xinjiang.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}]</data>
  <data key="d3">["hp_353e9e34cd9559b7"]</data>
  <data key="d4">False</data>
</node>
<node id="Mongolia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A country in East Asia where wild Bactrian camels are found.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}, {"text": "Mongolia is an area with limited populations of the wild Bactrian camel.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d2">[{"text": "It is restricted in the wild to remote regions of the Gobi and Taklamakan Deserts of Mongolia and Xinjiang.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7"}, {"text": "The three surviving species of camel are the dromedary, or one-humped camel (\"C. dromedarius\"), which inhabits the Middle East and the Horn of Africa; the Bactrian, or two-humped camel (\"C. bactrianus\"), which inhabits Central Asia; and the critically endangered wild Bactrian camel (\"C. ferus\") that has limited populations in remote areas of northwest China and Mongolia.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d3">["hp_353e9e34cd9559b7", "hp_706e5d69c6cb6d2b"]</data>
  <data key="d4">False</data>
</node>
<node id="Plant City Airport">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A public-use airport located southwest of the central business district of Plant City.", "chunk_id": "47b19fbaa70c2777", "doc_id": "hp_357ddba773097c91"}]</data>
  <data key="d2">[{"text": "Plant City Airport (ICAO: KPCM, FAA LID: PCM) is a public-use airport located two nautical miles (4 km) southwest of the central business district of Plant City in Hillsborough County, Florida, United States.", "chunk_id": "47b19fbaa70c2777", "doc_id": "hp_357ddba773097c91"}]</data>
  <data key="d3">["hp_357ddba773097c91"]</data>
  <data key="d4">False</data>
