  <data key="d8">hp_1ac7b848b0417759</data>
</edge>
<edge source="Second World War" target="World War I">
  <data key="d5">["SUCCESSOR_OF"]</data>
  <data key="d6">The Second World War started twenty-one years after World War I, with unresolved rivalries from the earlier conflict contributing to its start.</data>
  <data key="d7">[{"text": "Unresolved rivalries still extant at the end of the conflict contributed to the start of the Second World War only twenty-one years later.", "chunk_id": "b344f42adf99d038", "doc_id": "hp_831bc66834df032a", "type": "SUCCESSOR_OF"}]</data>
  <data key="d8">hp_831bc66834df032a</data>
</edge>
<edge source="Royal Navy" target="Convoy TM 1">
  <data key="d5">["ESCORTS"]</data>
  <data key="d6">Royal Navy warships escorted Convoy TM 1.</data>
  <data key="d7">[{"text": "Nine tankers, escorted by Royal Navy warships, attempted to reach Gibraltar from Trinidad.", "chunk_id": "c88e8c3532f53397", "doc_id": "hp_1ac7b848b0417759", "type": "ESCORTS"}]</data>
  <data key="d8">hp_1ac7b848b0417759</data>
</edge>
<edge source="merchant vessels" target="Convoy TM 1">
  <data key="d5">["PART_OF"]</data>
  <data key="d6">Most of the merchant vessels were part of Convoy TM 1.</data>
  <data key="d7">[{"text": "The convoy was attacked by a U-boat wolf pack in the central Atlantic Ocean, and most of the merchant vessels were sunk.", "chunk_id": "c88e8c3532f53397", "doc_id": "hp_1ac7b848b0417759", "type": "PART_OF"}]</data>
  <data key="d8">hp_1ac7b848b0417759</data>
</edge>
