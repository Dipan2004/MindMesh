<node id="Admiral Yi's 3rd Naval Campaign">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A naval campaign led by Admiral Yi, which included the Battle of Hansan Island as its first engagement.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d2">[{"text": "This battle is also the first in Admiral Yi's 3rd Naval Campaign.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d3">["hp_4e9436b9b6a97ad9"]</data>
