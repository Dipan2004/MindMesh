  <data key="d5">["MOVED_TO"]</data>
  <data key="d6">The society moved to Bath in 1979.</data>
  <data key="d7">[{"text": "It moved to Bath in 1979, and since 2004 its headquarters has been at Fenton House in Bath, England.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c", "type": "MOVED_TO"}]</data>
