<node id="Mumbai">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Mumbai is where Divya Rana currently lives.", "chunk_id": "1621f78ea00aa2b4", "doc_id": "hp_140ab3de808ede2a"}, {"text": "Mumbai is a city in India where several film studios were used to shoot Boogie Woogie.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}]</data>
  <data key="d2">[{"text": "She quit acting after her marriage and currently lives in Mumbai with her husband Fazal and goes by the name Salma Manekia.", "chunk_id": "1621f78ea00aa2b4", "doc_id": "hp_140ab3de808ede2a"}, {"text": "The early episodes were shot in Mehta Industrial Estate in Andheri, Mumbai and later, was also shot at other film studios in Mumbai including Natraj, Filmalaya, Filmistaan, Famous, Film City among others.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}]</data>
  <data key="d3">["hp_140ab3de808ede2a", "hp_a2a8fb62705d96e4"]</data>
  <data key="d4">False</data>
</node>
