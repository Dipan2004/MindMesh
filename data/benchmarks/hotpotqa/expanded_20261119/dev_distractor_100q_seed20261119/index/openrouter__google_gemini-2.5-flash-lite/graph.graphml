<node id="action">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A genre of film.", "chunk_id": "9196783ed67a5319", "doc_id": "hp_81d3603dff093a10"}]</data>
  <data key="d2">[{"text": "Ranging from action to comedy, sci-fi to horror, to genre-bending altogether, this year's films represented not only Korea's top box-office hits but also some of the industry's most creative and substantial movies to date.", "chunk_id": "9196783ed67a5319", "doc_id": "hp_81d3603dff093a10"}]</data>
  <data key="d3">["hp_81d3603dff093a10"]</data>
  <data key="d4">False</data>
</node>
<node id="comedy">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A genre of film.", "chunk_id": "9196783ed67a5319", "doc_id": "hp_81d3603dff093a10"}, {"text": "Entertainment consisting of jokes and satirical sketches, typically including slapstick or verbal humour.", "chunk_id": "a8189041218c65c9", "doc_id": "hp_df54057a167e76d7"}]</data>
  <data key="d2">[{"text": "Ranging from action to comedy, sci-fi to horror, to genre-bending altogether, this year's films represented not only Korea's top box-office hits but also some of the industry's most creative and substantial movies to date.", "chunk_id": "9196783ed67a5319", "doc_id": "hp_81d3603dff093a10"}, {"text": "He disdained telling jokes and engaging in comedy as it was traditionally understood, once saying in a rare introspective interview, \"I am not a comic, I have never told a joke.", "chunk_id": "a8189041218c65c9", "doc_id": "hp_df54057a167e76d7"}]</data>
  <data key="d3">["hp_81d3603dff093a10", "hp_df54057a167e76d7"]</data>
  <data key="d4">False</data>
</node>
