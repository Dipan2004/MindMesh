  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Eddie Hall is an English professional strongman.", "chunk_id": "9b0d62492a00ccff", "doc_id": "hp_6a07e9a4e90de729"}]</data>
  <data key="d2">[{"text": "Eddie Hall", "chunk_id": "9b0d62492a00ccff", "doc_id": "hp_6a07e9a4e90de729"}]</data>
