  <data key="d7">[{"text": "She was originally to be named \"Stranraer\", but was renamed before launch to avoid possible misunderstandings of having vessels named after coastal locations.", "chunk_id": "fc8924b200c0f580", "doc_id": "hp_5129e4fb643a43c0", "type": "RENAMED_FROM"}]</data>
