  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A member of Fleetwood Mac who wrote and sang \"Brown Eyes\".", "chunk_id": "9ed3e6f68a811c70", "doc_id": "hp_6ba5d00f572e646d"}]</data>
