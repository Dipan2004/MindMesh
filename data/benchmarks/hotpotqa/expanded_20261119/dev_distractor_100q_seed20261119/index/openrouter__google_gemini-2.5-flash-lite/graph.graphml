  <data key="d2">[{"text": "Bokuzen Hidari (左 卜全 , Hidari Bokuzen , 20 February 1894 - 26 May 1971) was a Japanese actor and comedian born in Kotesashi Village (now part of Tokorozawa), Iruma District, Saitama Prefecture, Japan.", "chunk_id": "bd018a45665dcb2e", "doc_id": "hp_a6decab6ae6a1912"}]</data>
