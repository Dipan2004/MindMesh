  <data key="d2">[{"text": "He first married Una Grace May Brown at Pleasant Plains, near Port Macquarie, NSW, on 15 October 1924, three days after reaching adulthood.", "chunk_id": "53f3bbd1c43e3155", "doc_id": "hp_7820faef8a00d610"}]</data>
