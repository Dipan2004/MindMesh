  <data key="d1">[{"text": "The English translation for the Chien Français Tricolore breed of dog.", "chunk_id": "434a4988e0d48510", "doc_id": "hp_551a94d4b6ae14c7"}]</data>
  <data key="d2">[{"text": "The Chien Français Tricolore (FCI No.219) translated into English as the French Tricolour Hound, is a breed of dog of the scenthound type, originating in France.", "chunk_id": "434a4988e0d48510", "doc_id": "hp_551a94d4b6ae14c7"}]</data>
  <data key="d3">["hp_551a94d4b6ae14c7"]</data>
  <data key="d4">False</data>
</node>
