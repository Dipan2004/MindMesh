</node>
<node id="St James the Less, Bethnal Green">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location in England where Ellis Gowing was on staff.", "chunk_id": "b450b5ae25bb633c", "doc_id": "hp_0e84d56941e20a86"}]</data>
  <data key="d2">[{"text": "Coming to England he was on the staff of St James the Less, Bethnal Green then domestic chaplain to the Bishop of Chelmsford from 1914 to 1917.", "chunk_id": "b450b5ae25bb633c", "doc_id": "hp_0e84d56941e20a86"}]</data>
  <data key="d3">["hp_0e84d56941e20a86"]</data>
  <data key="d4">False</data>
</node>
<node id="Bishop of Chelmsford">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The Bishop of Chelmsford, for whom Ellis Gowing served as a domestic chaplain.", "chunk_id": "b450b5ae25bb633c", "doc_id": "hp_0e84d56941e20a86"}, {"text": "The Bishop of Chelmsford is the ecclesiastical head of the Anglican Diocese of Chelmsford.", "chunk_id": "a46d15f8c3fc12ac", "doc_id": "hp_c098515d47bb4e6e"}, {"text": "The bishop whose seat is in Chelmsford Cathedral.", "chunk_id": "147b3f29c0fcd687", "doc_id": "hp_e801334348d2b1fc"}]</data>
  <data key="d2">[{"text": "Coming to England he was on the staff of St James the Less, Bethnal Green then domestic chaplain to the Bishop of Chelmsford from 1914 to 1917.", "chunk_id": "b450b5ae25bb633c", "doc_id": "hp_0e84d56941e20a86"}, {"text": "It became a cathedral when the Anglican Diocese of Chelmsford was created in 1914 and is the seat of the Bishop of Chelmsford.", "chunk_id": "a46d15f8c3fc12ac", "doc_id": "hp_c098515d47bb4e6e"}, {"text": "The cathedral is the mother church of the Diocese of Chelmsford and seat of the Bishop of Chelmsford.", "chunk_id": "147b3f29c0fcd687", "doc_id": "hp_e801334348d2b1fc"}]</data>
  <data key="d3">["hp_0e84d56941e20a86", "hp_c098515d47bb4e6e", "hp_e801334348d2b1fc"]</data>
  <data key="d4">False</data>
</node>
<node id="Prittlewell">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location where Ellis Gowing was vicar.", "chunk_id": "b450b5ae25bb633c", "doc_id": "hp_0e84d56941e20a86"}]</data>
  <data key="d2">[{"text": "He was vicar of Prittlewell from 1917 until his death; an honorary canon of Chelmsford Cathedral from 1921 to 1938 and Rural Dean of Canewdon from 1918 to 1938.", "chunk_id": "b450b5ae25bb633c", "doc_id": "hp_0e84d56941e20a86"}]</data>
  <data key="d3">["hp_0e84d56941e20a86"]</data>
  <data key="d4">False</data>
</node>
<node id="Chelmsford Cathedral">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A cathedral where Ellis Gowing was an honorary canon.", "chunk_id": "b450b5ae25bb633c", "doc_id": "hp_0e84d56941e20a86"}, {"text": "A cathedral where Michael Yorke served as Succentor, Precentor and Chaplain, and later as a Canon Residentiary.", "chunk_id": "8920fade874a14dc", "doc_id": "hp_51685a23dbd90e79"}, {"text": "Chelmsford Cathedral is a cathedral where Godwin Birchenough became an honorary Canon.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}, {"text": "Chelmsford Cathedral is a religious building located in Chelmsford, Essex, England.", "chunk_id": "a46d15f8c3fc12ac", "doc_id": "hp_c098515d47bb4e6e"}, {"text": "The Cathedral Church of St Mary the Virgin, St Peter and St Cedd.", "chunk_id": "147b3f29c0fcd687", "doc_id": "hp_e801334348d2b1fc"}, {"text": "A cathedral where Richard William Herrick served as Canon Residentiary.", "chunk_id": "2d54d3fa9439ab8e", "doc_id": "hp_e808a689dfcac703"}]</data>
  <data key="d2">[{"text": "He was vicar of Prittlewell from 1917 until his death; an honorary canon of Chelmsford Cathedral from 1921 to 1938 and Rural Dean of Canewdon from 1918 to 1938.", "chunk_id": "b450b5ae25bb633c", "doc_id": "hp_0e84d56941e20a86"}, {"text": "Ordained in 1965 his first post was a curacy at Croydon Parish Church after which he served as Succentor, Precentor and Chaplain at Chelmsford Cathedral.", "chunk_id": "8920fade874a14dc", "doc_id": "hp_51685a23dbd90e79"}, {"text": "He became an honorary Canon of Chelmsford Cathedral in 1933 and in 1941 became Dean of Ripon Cathedral, becoming Dean Emeritus in 1951.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}, {"text": "Chelmsford Cathedral in the city of Chelmsford, Essex, England, is dedicated to St Mary the Virgin, St Peter and St Cedd.", "chunk_id": "a46d15f8c3fc12ac", "doc_id": "hp_c098515d47bb4e6e"}, {"text": "The Dean of Chelmsford is the head (\"primus inter pares\" – first among equals) and chair of the Cathedral Chapter, the governing body of Chelmsford Cathedral, the Cathedral Church of St Mary the Virgin, St Peter and St Cedd.", "chunk_id": "147b3f29c0fcd687", "doc_id": "hp_e801334348d2b1fc"}, {"text": "He was then a Canon Residentiary of Chelmsford Cathedral until 1978 when he was appointed Provost of Chelmsford.", "chunk_id": "2d54d3fa9439ab8e", "doc_id": "hp_e808a689dfcac703"}]</data>
  <data key="d3">["hp_0e84d56941e20a86", "hp_51685a23dbd90e79", "hp_b4ae5293eb8657fc", "hp_c098515d47bb4e6e", "hp_e801334348d2b1fc", "hp_e808a689dfcac703"]</data>
  <data key="d4">False</data>
</node>
<node id="Canewdon">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location where Ellis Gowing served as Rural Dean.", "chunk_id": "b450b5ae25bb633c", "doc_id": "hp_0e84d56941e20a86"}]</data>
  <data key="d2">[{"text": "He was vicar of Prittlewell from 1917 until his death; an honorary canon of Chelmsford Cathedral from 1921 to 1938 and Rural Dean of Canewdon from 1918 to 1938.", "chunk_id": "b450b5ae25bb633c", "doc_id": "hp_0e84d56941e20a86"}]</data>
  <data key="d3">["hp_0e84d56941e20a86"]</data>
  <data key="d4">False</data>
</node>
<node id="County Borough of Southend-on-Sea">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A county borough from which Ellis Gowing was given the Freedom.", "chunk_id": "b450b5ae25bb633c", "doc_id": "hp_0e84d56941e20a86"}]</data>
  <data key="d2">[{"text": "He was given the Freedom of the County Borough of Southend-on-Sea in 1953.", "chunk_id": "b450b5ae25bb633c", "doc_id": "hp_0e84d56941e20a86"}]</data>
  <data key="d3">["hp_0e84d56941e20a86"]</data>
  <data key="d4">False</data>
</node>
<node id="Battle of Dinant">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "An engagement fought by French and German forces in and around the Belgian town of Dinant during the First World War.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d2">[{"text": "The Battle of Dinant was an engagement fought by French and German forces in and around the Belgian town of Dinant during the First World War during the German invasion of Belgium.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab"]</data>
  <data key="d4">False</data>
</node>
<node id="French">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Refers to the French forces involved in the Battle of Dinant.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}, {"text": "French refers to the nationality of Richard Gasquet.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}, {"text": "The nationality of the musical film Donkey Skin.", "chunk_id": "8d587d634a322b19", "doc_id": "hp_f52c762de35c34e7"}]</data>
  <data key="d2">[{"text": "The Battle of Dinant was an engagement fought by French and German forces in and around the Belgian town of Dinant during the First World War during the German invasion of Belgium.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}, {"text": "This page is a list of the main career statistics of French tennis player, Richard Gasquet.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}, {"text": "Peau d'Âne (English: Donkey Skin) is a 1970 French musical film directed by Jacques Demy.", "chunk_id": "8d587d634a322b19", "doc_id": "hp_f52c762de35c34e7"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab", "hp_b9191c704d51a80c", "hp_f52c762de35c34e7"]</data>
  <data key="d4">False</data>
</node>
<node id="German">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Refers to the German forces involved in the Battle of Dinant.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}, {"text": "Relating to Germany or its language.", "chunk_id": "bfcce5e0acb26b17", "doc_id": "hp_2f330331b69ce452"}, {"text": "German is a language that the band name 'Das Damen' is fake German for.", "chunk_id": "2a770550ab855da2", "doc_id": "hp_487457843d9527fb"}]</data>
  <data key="d2">[{"text": "The Battle of Dinant was an engagement fought by French and German forces in and around the Belgian town of Dinant during the First World War during the German invasion of Belgium.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}, {"text": "The Kriminal-Magazin (\"Crime Magazine\") was a German entertainment magazine that published crime fiction every month during 1929-1931.", "chunk_id": "bfcce5e0acb26b17", "doc_id": "hp_2f330331b69ce452"}, {"text": "The band's name is fake German and allegedly translates to \"the ladies\" (the correct German form would be \"Die Damen\").", "chunk_id": "2a770550ab855da2", "doc_id": "hp_487457843d9527fb"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab", "hp_2f330331b69ce452", "hp_487457843d9527fb"]</data>
  <data key="d4">False</data>
</node>
<node id="Dinant">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A Belgian town where the Battle of Dinant took place.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d2">[{"text": "The Battle of Dinant was an engagement fought by French and German forces in and around the Belgian town of Dinant during the First World War during the German invasion of Belgium.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab"]</data>
  <data key="d4">False</data>
</node>
<node id="First World War">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The global conflict during which the Battle of Dinant occurred.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}, {"text": "A global war that lasted from 1914 to 1918.", "chunk_id": "2eb3f367156872ac", "doc_id": "hp_69a8458a8adc29ab"}, {"text": "An alternative name for World War I.", "chunk_id": "b344f42adf99d038", "doc_id": "hp_831bc66834df032a"}, {"text": "A global war that lasted from 1914 to 1918.", "chunk_id": "18cfadbc25fe419e", "doc_id": "hp_cf67bd08ea76563b"}, {"text": "The global conflict during which operations on the Ancre occurred.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}, {"text": "A global conflict for which the Escapees' Medal was intended to honor combatants.", "chunk_id": "cd19157192f4048d", "doc_id": "hp_e60b5baaa105aa72"}]</data>
  <data key="d2">[{"text": "The Battle of Dinant was an engagement fought by French and German forces in and around the Belgian town of Dinant during the First World War during the German invasion of Belgium.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}, {"text": "The German Attack on Vimy Ridge, 21 May (\"Unternehmen Schleswig-Holstein\"/Operation Schleswig-Holstein) was a local attack on the Western Front during the First World War.", "chunk_id": "2eb3f367156872ac", "doc_id": "hp_69a8458a8adc29ab"}, {"text": "World War I (WWI or WW1), also known as the First World War, the Great War, or the War to End All Wars, was a global war originating in Europe that lasted from 28 July 1914 to 11 November 1918.", "chunk_id": "b344f42adf99d038", "doc_id": "hp_831bc66834df032a"}, {"text": "It also perpetuates the battle honours and traditions of a battalion that served on the Western Front during the First World War.", "chunk_id": "18cfadbc25fe419e", "doc_id": "hp_cf67bd08ea76563b"}, {"text": "Operations on the Ancre took place from 11 January – 13 March 1917, between the British Fifth Army and the German 1st Army, on the Somme front during the First World War.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad"}, {"text": "The \"Escapees' Medal\" was established by a 1926 law, intended to honour combatants not only of the First World War, but also of the Franco-Prussian War of 1870.", "chunk_id": "cd19157192f4048d", "doc_id": "hp_e60b5baaa105aa72"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab", "hp_69a8458a8adc29ab", "hp_831bc66834df032a", "hp_cf67bd08ea76563b", "hp_d6e57e7111053cad", "hp_e60b5baaa105aa72"]</data>
  <data key="d4">False</data>
</node>
<node id="German invasion of Belgium">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The military operation during which the Battle of Dinant took place.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d2">[{"text": "The Battle of Dinant was an engagement fought by French and German forces in and around the Belgian town of Dinant during the First World War during the German invasion of Belgium.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab"]</data>
  <data key="d4">False</data>
</node>
<node id="French Fifth Army">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A military unit of the French forces that advanced into Belgium.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d2">[{"text": "The French Fifth Army and the British Expeditionary Force (BEF) advanced into Belgium and fought the Battle of Charleroi (21–23 August) and Battle of Mons (23 August), from the Meuse crossings in the east, to Mons in the west.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab"]</data>
  <data key="d4">False</data>
</node>
<node id="British Expeditionary Force (BEF)">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A military force that advanced into Belgium alongside the French Fifth Army.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d2">[{"text": "The French Fifth Army and the British Expeditionary Force (BEF) advanced into Belgium and fought the Battle of Charleroi (21–23 August) and Battle of Mons (23 August), from the Meuse crossings in the east, to Mons in the west.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab"]</data>
  <data key="d4">False</data>
</node>
<node id="Belgium">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The country into which the French Fifth Army and BEF advanced.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}, {"text": "Belgium is the present-day location of Ligny.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d2">[{"text": "The French Fifth Army and the British Expeditionary Force (BEF) advanced into Belgium and fought the Battle of Charleroi (21–23 August) and Battle of Mons (23 August), from the Meuse crossings in the east, to Mons in the west.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}, {"text": "In this battle, French troops of the Armée du Nord under Napoleon's command, defeated part of a Prussian army under Field Marshal Prince Blücher, near Ligny in present-day Belgium.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab", "hp_45df433ff36c6e4e"]</data>
  <data key="d4">False</data>
</node>
<node id="Battle of Charleroi">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A battle fought by the French Fifth Army and BEF in Belgium.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d2">[{"text": "The French Fifth Army and the British Expeditionary Force (BEF) advanced into Belgium and fought the Battle of Charleroi (21–23 August) and Battle of Mons (23 August), from the Meuse crossings in the east, to Mons in the west.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab"]</data>
  <data key="d4">False</data>
</node>
