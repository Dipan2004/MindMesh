<node id="bluegrass">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A genre of American roots music that developed in the 1940s in Appalachia.", "chunk_id": "821ef327cc48dc3b", "doc_id": "hp_77b64f3c24b9e100"}, {"text": "Bluegrass is a genre of American roots music that Rhonda Vincent is associated with.", "chunk_id": "23d585cac1877284", "doc_id": "hp_8366c7a6ce08c469"}, {"text": "Bluegrass is a genre of American roots music.", "chunk_id": "4cba1a343443cac4", "doc_id": "hp_d2b3c37a5329d341"}, {"text": "Bluegrass is a genre of American roots music that Mark O'Connor plays.", "chunk_id": "83ff2598ffe55600", "doc_id": "hp_f2e2e7c2a56a9856"}]</data>
  <data key="d2">[{"text": "Malcolm B. Wiseman (born May 23, 1925), better known as Mac Wiseman, is an American bluegrass singer, nicknamed The Voice with a Heart.", "chunk_id": "821ef327cc48dc3b", "doc_id": "hp_77b64f3c24b9e100"}, {"text": "Rhonda Lea Vincent (born July 13, 1962) is an American bluegrass singer, songwriter, and multi-instrumentalist.", "chunk_id": "23d585cac1877284", "doc_id": "hp_8366c7a6ce08c469"}, {"text": "Alice Gerrard (born July 8, 1934) is an American bluegrass singer, banjoist, and guitar player.", "chunk_id": "4cba1a343443cac4", "doc_id": "hp_d2b3c37a5329d341"}, {"text": "Mark O'Connor (born August 5, 1961, Seattle) is an American bluegrass, jazz and country violinist, fiddler, composer and music teacher.", "chunk_id": "83ff2598ffe55600", "doc_id": "hp_f2e2e7c2a56a9856"}]</data>
  <data key="d3">["hp_77b64f3c24b9e100", "hp_8366c7a6ce08c469", "hp_d2b3c37a5329d341", "hp_f2e2e7c2a56a9856"]</data>
  <data key="d4">False</data>
</node>
