  <data key="d2">[{"text": "Each has a counterpart for riders under 21: the Speedway World Under 21 Championship and the Team Speedway Junior World Championship.", "chunk_id": "e5d5a4b02c67ef13", "doc_id": "hp_a39a6df00bec9318"}]</data>
