  <data key="d2">[{"text": "\"Rose syringa\" (syn. \"Philadelphus maculatus\") is the most commonly cultivated variety and has fragrant white flowers with a purple blotch in the centre.", "chunk_id": "ae8a20956c4e25a8", "doc_id": "hp_f73d55cc65e5508e"}]</data>
