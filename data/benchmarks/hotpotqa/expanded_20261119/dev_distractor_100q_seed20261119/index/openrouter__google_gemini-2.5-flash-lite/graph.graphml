<node id="2007">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "2007 is the year Bonifacio High Street opened.", "chunk_id": "851db6962c10e795", "doc_id": "hp_13b0e7c83e58b31d"}, {"text": "2007 is the year of Paul Oakenfold's album Greatest Hits &amp; Remixes, Vol. 1.", "chunk_id": "0e3a5e1368eb79fe", "doc_id": "hp_c1e92b892fa0c36f"}]</data>
  <data key="d2">[{"text": "It opened in the 2007 and it is one of Ayala Corporation's flagship projects.", "chunk_id": "851db6962c10e795", "doc_id": "hp_13b0e7c83e58b31d"}, {"text": "It was later included on Shifty Shellshock's 2004 album \"Happy Love Sick\", and Oakenfold's 2007 album \"Greatest Hits &amp; Remixes, Vol. 1\".", "chunk_id": "0e3a5e1368eb79fe", "doc_id": "hp_c1e92b892fa0c36f"}]</data>
