</node>
<node id="C-41 process">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "The C-41 process is a type of photographic film development process.", "chunk_id": "95552dd280ce88ab", "doc_id": "hp_fad0e22310177840"}]</data>
  <data key="d2">[{"text": "Cinestill Film uses a modified version of Kodak motion picture cinema film, allowing it to be developed with the C-41 process rather than the Eastman Color Negative process.", "chunk_id": "95552dd280ce88ab", "doc_id": "hp_fad0e22310177840"}]</data>
  <data key="d3">["hp_fad0e22310177840"]</data>
  <data key="d4">False</data>
</node>
<node id="Eastman Color Negative process">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "The Eastman Color Negative process is a type of photographic film development process.", "chunk_id": "95552dd280ce88ab", "doc_id": "hp_fad0e22310177840"}]</data>
  <data key="d2">[{"text": "Cinestill Film uses a modified version of Kodak motion picture cinema film, allowing it to be developed with the C-41 process rather than the Eastman Color Negative process.", "chunk_id": "95552dd280ce88ab", "doc_id": "hp_fad0e22310177840"}]</data>
