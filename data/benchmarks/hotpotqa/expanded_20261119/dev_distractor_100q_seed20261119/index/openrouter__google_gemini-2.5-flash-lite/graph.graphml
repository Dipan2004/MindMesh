  <data key="d2">[{"text": "Today, it is the most-visited public residence in the state (outpacing the Minnesota Governor's Residence), often hosting events five days a week.", "chunk_id": "60d483d501d17f6f", "doc_id": "hp_936dd5018d3d1151"}]</data>
