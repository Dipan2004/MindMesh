<node id="Live to Dance">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A United States television reality program and dance competition on the CBS network.", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}]</data>
  <data key="d2">[{"text": "Live to Dance is a United States television reality program and dance competition on the CBS network based on the British series \"Got to Dance\".", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}]</data>
  <data key="d3">["hp_c98c5f35b4927af5"]</data>
  <data key="d4">False</data>
</node>
<node id="CBS">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The television network on which Live to Dance aired.", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}, {"text": "The television network that aired the concerts as a special.", "chunk_id": "27c840a9f2ae6d8f", "doc_id": "hp_e324150cd91f309d"}]</data>
  <data key="d2">[{"text": "Live to Dance is a United States television reality program and dance competition on the CBS network based on the British series \"Got to Dance\".", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}, {"text": "In late November 2001, the CBS television network aired the concerts as a two-hour special in honor of Michael Jackson's thirtieth year as a solo entertainer (his first solo single, \"Got to Be There\", was recorded in 1971).", "chunk_id": "27c840a9f2ae6d8f", "doc_id": "hp_e324150cd91f309d"}]</data>
  <data key="d3">["hp_c98c5f35b4927af5", "hp_e324150cd91f309d"]</data>
  <data key="d4">False</data>
</node>
<node id="Got to Dance">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A British television series that served as the basis for Live to Dance.", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}]</data>
  <data key="d2">[{"text": "Live to Dance is a United States television reality program and dance competition on the CBS network based on the British series \"Got to Dance\".", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}]</data>
  <data key="d3">["hp_c98c5f35b4927af5"]</data>
  <data key="d4">False</data>
</node>
<node id="Dance Domes">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Specially constructed locations where dancers auditioned for Live to Dance.", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}]</data>
  <data key="d2">[{"text": "Dancers from all over the country auditioned for \"Live to Dance\" in \"specially constructed Dance Domes\".", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}]</data>
  <data key="d3">["hp_c98c5f35b4927af5"]</data>
  <data key="d4">False</data>
</node>
<node id="January 4, 2011">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The date when the show Live to Dance was first shown.", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}]</data>
  <data key="d2">[{"text": "Resembling the British dance competition series \"Got to Dance\", the show was first shown on January 4, 2011, and was headlined by the \"American Idol\" judge Paula Abdul as lead judge with Andrew Günsberg as host.", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}]</data>
  <data key="d3">["hp_c98c5f35b4927af5"]</data>
  <data key="d4">False</data>
</node>
<node id="American Idol">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A television program whose judge Paula Abdul was the lead judge for Live to Dance.", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}]</data>
  <data key="d2">[{"text": "Resembling the British dance competition series \"Got to Dance\", the show was first shown on January 4, 2011, and was headlined by the \"American Idol\" judge Paula Abdul as lead judge with Andrew Günsberg as host.", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}]</data>
  <data key="d3">["hp_c98c5f35b4927af5"]</data>
  <data key="d4">False</data>
</node>
<node id="Paula Abdul">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The lead judge for Live to Dance and an American Idol judge.", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}]</data>
  <data key="d2">[{"text": "Resembling the British dance competition series \"Got to Dance\", the show was first shown on January 4, 2011, and was headlined by the \"American Idol\" judge Paula Abdul as lead judge with Andrew Günsberg as host.", "chunk_id": "6f28f99354276835", "doc_id": "hp_c98c5f35b4927af5"}]</data>
