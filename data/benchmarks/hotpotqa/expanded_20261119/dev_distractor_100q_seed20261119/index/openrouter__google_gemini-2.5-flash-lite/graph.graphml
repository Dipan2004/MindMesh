  <data key="d1">[{"text": "An organization that operates bus routes served by the Indooroopilly Bus Station.", "chunk_id": "338a75991da8943e", "doc_id": "hp_3e042ad47b60933e"}, {"text": "A public transport authority in South East Queensland, Australia.", "chunk_id": "3a90b2ec007df76c", "doc_id": "hp_4585e3987830685a"}, {"text": "An organization that operates bus routes serviced by the Chermside bus station.", "chunk_id": "ba730c4e66833a5a", "doc_id": "hp_5e729b3de393ded8"}, {"text": "TransLink is an organization that operates bus routes and an integrated public transport system.", "chunk_id": "d45b60b7abaeaa6a", "doc_id": "hp_85a0b49c6ecc4877"}, {"text": "An organization that operates bus routes and an integrated public transport system.", "chunk_id": "d6ef5d0717d77f30", "doc_id": "hp_8651f8969219198d"}, {"text": "An organization that operates bus routes and an integrated public transport system.", "chunk_id": "6257f1836522b4a7", "doc_id": "hp_888262fe7c1aaa67"}, {"text": "TransLink is an organization that operates bus routes and an integrated public transport system.", "chunk_id": "fbf61adc749de348", "doc_id": "hp_c5ef67346cb356c5"}, {"text": "An organization that operates bus routes and an integrated public transport system.", "chunk_id": "e46c2a621963ae57", "doc_id": "hp_d9c16ac1a14c473e"}, {"text": "An organization that provides bus routes and an integrated public transport system.", "chunk_id": "73348332beb37e73", "doc_id": "hp_f5380a35f3a97562"}]</data>
  <data key="d2">[{"text": "The Indooroopilly Bus Station, at Indooroopilly, is served by TransLink bus routes.", "chunk_id": "338a75991da8943e", "doc_id": "hp_3e042ad47b60933e"}, {"text": "The University of Queensland Bus Station, at the University of Queensland's St Lucia Campus, is served by TransLink bus routes.", "chunk_id": "3a90b2ec007df76c", "doc_id": "hp_4585e3987830685a"}, {"text": "The Chermside bus station, at Chermside, Queensland, is serviced by TransLink bus routes.", "chunk_id": "ba730c4e66833a5a", "doc_id": "hp_5e729b3de393ded8"}, {"text": "The Springwood Bus Station, at Springwood, is served by TransLink bus routes.", "chunk_id": "d45b60b7abaeaa6a", "doc_id": "hp_85a0b49c6ecc4877"}, {"text": "Inala bus station at Inala, a south-western suburb in the City of Brisbane, is served by TransLink bus routes.", "chunk_id": "d6ef5d0717d77f30", "doc_id": "hp_8651f8969219198d"}, {"text": "The Browns Plains bus station, at Browns Plains, is serviced by TransLink bus routes.", "chunk_id": "6257f1836522b4a7", "doc_id": "hp_888262fe7c1aaa67"}, {"text": "The Aspley Bus Station, at Aspley, Queensland, Australia, is served by TransLink bus routes.", "chunk_id": "fbf61adc749de348", "doc_id": "hp_c5ef67346cb356c5"}, {"text": "The Victoria Point Bus Station, at Victoria Point Queensland, is serviced by TransLink bus routes.", "chunk_id": "e46c2a621963ae57", "doc_id": "hp_d9c16ac1a14c473e"}, {"text": "The Capalaba Bus Station, at Capalaba, Queensland, is serviced by TransLink bus routes.", "chunk_id": "73348332beb37e73", "doc_id": "hp_f5380a35f3a97562"}]</data>
