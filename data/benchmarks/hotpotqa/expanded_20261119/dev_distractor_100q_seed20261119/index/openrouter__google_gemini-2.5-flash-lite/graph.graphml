  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A non-Kapoor actor who appeared in the film Kal Aaj Aur Kal.", "chunk_id": "16a91e591a40c438", "doc_id": "hp_b3f0efe2307464b8"}]</data>
  <data key="d2">[{"text": "Among the non Kapoors in the film are Iftekhar.", "chunk_id": "16a91e591a40c438", "doc_id": "hp_b3f0efe2307464b8"}]</data>
  <data key="d3">["hp_b3f0efe2307464b8"]</data>
