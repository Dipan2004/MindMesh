  <data key="d4">False</data>
</node>
<node id="sweetbay magnolia">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Sweetbay magnolia is a common name for Magnolia virginiana.", "chunk_id": "0b6a1717369be2d5", "doc_id": "hp_09965476daf9cc57"}]</data>
  <data key="d2">[{"text": "Magnolia virginiana, most commonly known as sweetbay magnolia, or merely sweetbay (also laurel magnolia, swampbay, swamp magnolia, whitebay, or beaver tree), is a member of the magnolia family, Magnoliaceae.", "chunk_id": "0b6a1717369be2d5", "doc_id": "hp_09965476daf9cc57"}]</data>
  <data key="d3">["hp_09965476daf9cc57"]</data>
