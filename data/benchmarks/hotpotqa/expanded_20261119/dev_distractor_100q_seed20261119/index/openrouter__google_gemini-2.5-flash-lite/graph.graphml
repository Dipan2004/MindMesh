<node id="Grand Anglo-Français Blanc et Noir">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A breed of dog used in hunting as a scenthound, usually in packs.", "chunk_id": "6a4f265a07c810a2", "doc_id": "hp_499a4bbcdeae5a6b"}]</data>
  <data key="d2">[{"text": "The Grand Anglo-Français Blanc et Noir (FCI No.323) translated into English as the Great Anglo-French White and Black Hound, is a breed of dog used in hunting as a scenthound, usually in packs.", "chunk_id": "6a4f265a07c810a2", "doc_id": "hp_499a4bbcdeae5a6b"}]</data>
  <data key="d3">["hp_499a4bbcdeae5a6b"]</data>
