<edge source="Kiehnmoor" target="Germany">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">The Kiehnmoor nature reserve is located in Germany.</data>
  <data key="d7">[{"text": "The Kiehnmoor is a nature reserve in Germany.", "chunk_id": "582723cb6f560140", "doc_id": "hp_5fffbcc1125c9880", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_5fffbcc1125c9880</data>
</edge>
<edge source="Kiehnmoor" target="Celle district">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">A portion of the Kiehnmoor nature reserve lies within the Celle district.</data>
  <data key="d7">[{"text": "It has an area of 440 ha of which 100 ha lie in Celle district and 340 ha in Uelzen district.", "chunk_id": "582723cb6f560140", "doc_id": "hp_5fffbcc1125c9880", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_5fffbcc1125c9880</data>
</edge>
<edge source="Kiehnmoor" target="Uelzen district">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">A portion of the Kiehnmoor nature reserve lies within the Uelzen district.</data>
  <data key="d7">[{"text": "It has an area of 440 ha of which 100 ha lie in Celle district and 340 ha in Uelzen district.", "chunk_id": "582723cb6f560140", "doc_id": "hp_5fffbcc1125c9880", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_5fffbcc1125c9880</data>
</edge>
<edge source="Kiehnmoor" target="Südheide Nature Park">
  <data key="d5">["BORDERS"]</data>
  <data key="d6">The southern perimeter of the Kiehnmoor borders the Südheide Nature Park.</data>
  <data key="d7">[{"text": "Its southern perimeter borders immediately on the larger heathland area of the Südheide Nature Park.", "chunk_id": "582723cb6f560140", "doc_id": "hp_5fffbcc1125c9880", "type": "BORDERS"}]</data>
  <data key="d8">hp_5fffbcc1125c9880</data>
</edge>
<edge source="Kiehnmoor" target="Unterlüß Firing Range">
  <data key="d5">["BORDERS"]</data>
  <data key="d6">The Kiehnmoor reserve borders the Unterlüß Firing Range to the southeast.</data>
  <data key="d7">[{"text": "To the southeast the reserve borders on the Unterlüß Firing Range (\"Schießplatz Unterlüß\"), belonging to the firm of Rheinmetall, and the \"Große Heide\" (\"Large Heath\") near Unterlüß, that is closed to the public.", "chunk_id": "582723cb6f560140", "doc_id": "hp_5fffbcc1125c9880", "type": "BORDERS"}]</data>
  <data key="d8">hp_5fffbcc1125c9880</data>
</edge>
<edge source="Kiehnmoor" target="Große Heide">
  <data key="d5">["BORDERS"]</data>
  <data key="d6">The Kiehnmoor reserve borders the Große Heide to the southeast.</data>
  <data key="d7">[{"text": "To the southeast the reserve borders on the Unterlüß Firing Range (\"Schießplatz Unterlüß\"), belonging to the firm of Rheinmetall, and the \"Große Heide\" (\"Large Heath\") near Unterlüß, that is closed to the public.", "chunk_id": "582723cb6f560140", "doc_id": "hp_5fffbcc1125c9880", "type": "BORDERS"}]</data>
  <data key="d8">hp_5fffbcc1125c9880</data>
</edge>
