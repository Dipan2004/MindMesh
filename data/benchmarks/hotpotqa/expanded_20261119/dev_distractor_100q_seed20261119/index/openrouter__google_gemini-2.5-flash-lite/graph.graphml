<node id="investment and financial planning">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Services offered by the combined firms' subsidiaries.", "chunk_id": "fb77db64cb286920", "doc_id": "hp_24ed7c7e2985924e"}, {"text": "Investment and financial planning are services provided by subsidiary companies of Raymond James Financial.", "chunk_id": "60146d8f881241fd", "doc_id": "hp_39b8c05e25e40014"}]</data>
  <data key="d2">[{"text": "The combined firms’ subsidiaries engage primarily in investment and financial planning, investment banking, fixed income products and asset management.", "chunk_id": "fb77db64cb286920", "doc_id": "hp_24ed7c7e2985924e"}, {"text": "Raymond James Financial is an American diversified holding company providing financial services to individuals, corporations and municipalities through its subsidiary companies that engage primarily in investment and financial planning, in addition to investment banking and asset management.", "chunk_id": "60146d8f881241fd", "doc_id": "hp_39b8c05e25e40014"}]</data>
  <data key="d3">["hp_24ed7c7e2985924e", "hp_39b8c05e25e40014"]</data>
  <data key="d4">False</data>
</node>
