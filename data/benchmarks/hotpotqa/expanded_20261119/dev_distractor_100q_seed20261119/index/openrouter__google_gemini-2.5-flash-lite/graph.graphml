  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">Archbold Gymnasium is located in Syracuse, New York.</data>
  <data key="d7">[{"text": "Archbold Gymnasium is a gymnasium located on the campus of Syracuse University in Syracuse, New York.", "chunk_id": "9a89f86e35e64ab2", "doc_id": "hp_b8ec94a3c00016f8", "type": "LOCATED_IN"}]</data>
