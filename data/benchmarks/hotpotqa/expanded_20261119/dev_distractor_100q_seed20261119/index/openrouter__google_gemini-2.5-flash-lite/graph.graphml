<node id="Associated Talking Pictures">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A film production company with which George Formby made eleven films, including 'No Limit'.", "chunk_id": "9243d3da01ac4911", "doc_id": "hp_4fd72be01c14fbaf"}, {"text": "The production company for the film Keep Your Seats, Please.", "chunk_id": "fb573f40a01941a2", "doc_id": "hp_e86e098764e42f6e"}]</data>
  <data key="d2">[{"text": "It was the first of eleven films that Formby made with Associated Talking Pictures.", "chunk_id": "9243d3da01ac4911", "doc_id": "hp_4fd72be01c14fbaf"}, {"text": "The film was made by Associated Talking Pictures.", "chunk_id": "fb573f40a01941a2", "doc_id": "hp_e86e098764e42f6e"}]</data>
