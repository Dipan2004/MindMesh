  <data key="d2">[{"text": "It was founded by David May in 1877, and merged with Federated Department Stores (now Macy's, Inc.) in 2005.", "chunk_id": "7eaecb7c8ff690f9", "doc_id": "hp_537a416acef9e8ad"}]</data>
