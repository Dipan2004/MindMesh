<node id="Jaime Fernández">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The actor brother of Fernando Fernández.", "chunk_id": "f22987b0a2a07a86", "doc_id": "hp_0a82eabb231d743f"}, {"text": "A Mexican actor who won 3 Silver Ariel awards.", "chunk_id": "5caaa82e915cbb20", "doc_id": "hp_f4a1d9afa0828a54"}]</data>
  <data key="d2">[{"text": "He was brother of the famous film director Emilio Fernández and actor Jaime Fernández.", "chunk_id": "f22987b0a2a07a86", "doc_id": "hp_0a82eabb231d743f"}, {"text": "Jaime Fernández (actor)", "chunk_id": "5caaa82e915cbb20", "doc_id": "hp_f4a1d9afa0828a54"}]</data>
