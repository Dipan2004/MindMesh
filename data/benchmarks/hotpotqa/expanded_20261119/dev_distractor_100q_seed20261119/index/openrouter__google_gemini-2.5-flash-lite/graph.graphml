  <data key="d1">[{"text": "The Edward Augustus Russell House is a Greek Revival house located on the Wesleyan University campus.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d2">[{"text": "The Edward Augustus Russell House is a Greek Revival house on the Wesleyan University campus.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
