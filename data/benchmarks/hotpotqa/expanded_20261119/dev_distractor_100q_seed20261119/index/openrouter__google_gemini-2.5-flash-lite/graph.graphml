  <data key="d7">[{"text": "This story was first reported by the San Francisco Chronicle, May 1, 1968, then carried by wire services Associated Press and United Press International and published in newspapers worldwide.", "chunk_id": "b9e66f096d2d52e7", "doc_id": "hp_a9fead16be02ae83", "type": "REPORTED_ON"}]</data>
