<node id="Taiwan">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Taiwan is a location where Chen Chao-jung is popular as a TV actor.", "chunk_id": "b9f1ded51398adc0", "doc_id": "hp_4ed3904f8086a721"}, {"text": "Taiwan is a location where GeIL is based and has its headquarters.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}, {"text": "The native region of Tetrapanax papyrifer.", "chunk_id": "4bcf587974d76b12", "doc_id": "hp_f0145d341f76a4f3"}]</data>
  <data key="d2">[{"text": "He is also enormously popular in Taiwan as a TV actor.", "chunk_id": "b9f1ded51398adc0", "doc_id": "hp_4ed3904f8086a721"}, {"text": "Golden Emperor International Ltd. or commonly known as GeIL is a manufacturer of computer hardware components, based in Taipei, Taiwan with focus in DRAM and flash based memory products since 1993.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}, {"text": "It is endemic to Taiwan, but widely cultivated in East Asia and sometimes in other tropical regions as well.", "chunk_id": "4bcf587974d76b12", "doc_id": "hp_f0145d341f76a4f3"}]</data>
  <data key="d3">["hp_4ed3904f8086a721", "hp_a08e17bf87e824f4", "hp_f0145d341f76a4f3"]</data>
  <data key="d4">False</data>
</node>
