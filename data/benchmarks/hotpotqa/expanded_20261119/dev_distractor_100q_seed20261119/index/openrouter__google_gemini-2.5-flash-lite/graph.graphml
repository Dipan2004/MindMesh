</edge>
<edge source="Hershel Shanks" target="Moment (magazine)">
  <data key="d5">["EDITOR_OF"]</data>
  <data key="d6">Hershel Shanks served as the editor of Moment magazine.</data>
  <data key="d7">[{"text": "Hershel Shanks served as the editor from 1987 to 2004.", "chunk_id": "7156f0efb6184faa", "doc_id": "hp_02c3149273f48869", "type": "EDITOR_OF"}]</data>
