<edge source="Scotland" target="France">
  <data key="d5">["TREATY_SIGNED_WITH"]</data>
  <data key="d6">Scotland signed a treaty with France.</data>
  <data key="d7">[{"text": "The town was not taken by force and the French troops finally left peacefully under the terms of a treaty signed by Scotland, England and France.", "chunk_id": "fed038ae0c566b69", "doc_id": "hp_26004159736d7249", "type": "TREATY_SIGNED_WITH"}]</data>
