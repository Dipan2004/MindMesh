<node id="Korean cinema">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The cinematic output of Korea.", "chunk_id": "9196783ed67a5319", "doc_id": "hp_81d3603dff093a10"}, {"text": "The film industry and art form of Korea.", "chunk_id": "9196783ed67a5319", "doc_id": "hp_81d3603dff093a10"}, {"text": "The term encompassing the motion picture industries of North and South Korea.", "chunk_id": "ab78baf12b2f8b16", "doc_id": "hp_b840ad7146ba28d6"}]</data>
  <data key="d2">[{"text": "9th New York Korean Film Festival was held by the Korea Society showcasing a selection of the best of contemporary Korean cinema.", "chunk_id": "9196783ed67a5319", "doc_id": "hp_81d3603dff093a10"}, {"text": "Like previous festivals, the 2010 New York Korean Film Festival screened contemporary Korean films and also featured panel discussions with directors and other icons of Korean Cinema.", "chunk_id": "9196783ed67a5319", "doc_id": "hp_81d3603dff093a10"}, {"text": "The term \"Cinema of Korea\" (or \"Korean cinema\") encompasses the motion picture industries of North and South Korea.", "chunk_id": "ab78baf12b2f8b16", "doc_id": "hp_b840ad7146ba28d6"}]</data>
  <data key="d3">["hp_81d3603dff093a10", "hp_b840ad7146ba28d6"]</data>
  <data key="d4">False</data>
</node>
