  <data key="d5">["ESTABLISHED_BY"]</data>
  <data key="d6">Istanbul Şehir University was established by the Bilim ve Sanat Vakfı.</data>
  <data key="d7">[{"text": "It was established in 2008 by the Bilim ve Sanat Vakfı (BiSaV or BSV, English: Foundation for Science and Arts ).", "chunk_id": "c4ae848456d08dbd", "doc_id": "hp_0470400943ee62eb", "type": "ESTABLISHED_BY"}]</data>
