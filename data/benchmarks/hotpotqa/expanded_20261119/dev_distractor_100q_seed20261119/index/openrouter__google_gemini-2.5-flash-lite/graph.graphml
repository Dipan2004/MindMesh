  <data key="d1">[{"text": "Emilio Sánchez was a participant in the 1991 Donnay Indoor Championships – Doubles.", "chunk_id": "72b8f48b7ecf936b", "doc_id": "hp_335fb09af115eccf"}]</data>
  <data key="d2">[{"text": "Emilio Sánchez and Slobodan Živojinović were the defending champions, but Sánchez did not participate this year.", "chunk_id": "72b8f48b7ecf936b", "doc_id": "hp_335fb09af115eccf"}]</data>
