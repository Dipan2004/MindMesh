  <data key="d2">[{"text": "It borders Luqiao and Huangyan to the north, Yuhuan to the south, Yueqing to the west, looks out to the East China Sea to the east.", "chunk_id": "6cbf95d958c94cd7", "doc_id": "hp_8f217e15be3875b3"}]</data>
