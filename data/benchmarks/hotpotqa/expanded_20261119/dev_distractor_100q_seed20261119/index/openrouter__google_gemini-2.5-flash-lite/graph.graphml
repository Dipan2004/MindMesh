  <data key="d2">[{"text": "Gowing was educated at Fort Street High School and the University of Sydney; and ordained in 1907.", "chunk_id": "b450b5ae25bb633c", "doc_id": "hp_0e84d56941e20a86"}]</data>
  <data key="d3">["hp_0e84d56941e20a86"]</data>
