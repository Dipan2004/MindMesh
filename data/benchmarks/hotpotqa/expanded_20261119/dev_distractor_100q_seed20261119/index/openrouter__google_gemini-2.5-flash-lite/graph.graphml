  <data key="d2">[{"text": "The neighborhood includes the large historic district between the O'Bryonville business district (Evanston) and the DeSales Corner (East Walnut Hills), home to opulent mansions with large setbacks, as well as Annwood Park on Madison Road and the Bettman Preserve, an urban nature preserve.", "chunk_id": "7430715d26fd6b11", "doc_id": "hp_7a28631371b5d588"}]</data>
