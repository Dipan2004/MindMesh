<node id="Gwendolen Mary Fitzalan-Howard">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Gwendolen Mary Fitzalan-Howard was the Duchess of Norfolk and the 12th Lady Herries of Terregles.", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}]</data>
  <data key="d2">[{"text": "Gwendolen Mary Fitzalan-Howard, Duchess of Norfolk, 12th Lady Herries of Terregles (née Constable-Maxwell; 11 January 1877 – 28 August 1945) was the eldest child of Marmaduke Constable-Maxwell, 11th Lord Herries of Terregles and his wife, Angela (née Fitzalan-Howard).", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}]</data>
  <data key="d3">["hp_4b649ff51106ab0b"]</data>
  <data key="d4">False</data>
</node>
<node id="Lady Herries of Terregles">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Lady Herries of Terregles is a title held by Gwendolen Mary Fitzalan-Howard.", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}, {"text": "Lady Herries of Terregles was a peerage inherited by Bernard Fitzalan-Howard from his mother.", "chunk_id": "004e4fd012a54ec8", "doc_id": "hp_4f583d3862c645a8"}]</data>
  <data key="d2">[{"text": "Gwendolen Mary Fitzalan-Howard, Duchess of Norfolk, 12th Lady Herries of Terregles (née Constable-Maxwell; 11 January 1877 – 28 August 1945) was the eldest child of Marmaduke Constable-Maxwell, 11th Lord Herries of Terregles and his wife, Angela (née Fitzalan-Howard).", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}, {"text": "His mother was Gwendolen Fitzalan-Howard, \"suo jure\" Gwendoline Mary Herries, 12th Lady Herries of Terregles, and he inherited her peerage when she died in 1947.", "chunk_id": "004e4fd012a54ec8", "doc_id": "hp_4f583d3862c645a8"}]</data>
  <data key="d3">["hp_4b649ff51106ab0b", "hp_4f583d3862c645a8"]</data>
  <data key="d4">False</data>
</node>
<node id="Constable-Maxwell">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Constable-Maxwell was the maiden name of Gwendolen Mary Fitzalan-Howard.", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}]</data>
  <data key="d2">[{"text": "Gwendolen Mary Fitzalan-Howard, Duchess of Norfolk, 12th Lady Herries of Terregles (née Constable-Maxwell; 11 January 1877 – 28 August 1945) was the eldest child of Marmaduke Constable-Maxwell, 11th Lord Herries of Terregles and his wife, Angela (née Fitzalan-Howard).", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}]</data>
  <data key="d3">["hp_4b649ff51106ab0b"]</data>
  <data key="d4">False</data>
</node>
<node id="Marmaduke Constable-Maxwell">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Marmaduke Constable-Maxwell was the 11th Lord Herries of Terregles and the father of Gwendolen Mary Fitzalan-Howard.", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}]</data>
  <data key="d2">[{"text": "Gwendolen Mary Fitzalan-Howard, Duchess of Norfolk, 12th Lady Herries of Terregles (née Constable-Maxwell; 11 January 1877 – 28 August 1945) was the eldest child of Marmaduke Constable-Maxwell, 11th Lord Herries of Terregles and his wife, Angela (née Fitzalan-Howard).", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}]</data>
  <data key="d3">["hp_4b649ff51106ab0b"]</data>
  <data key="d4">False</data>
</node>
<node id="Lord Herries of Terregles">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Lord Herries of Terregles is a title held by Marmaduke Constable-Maxwell.", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}]</data>
  <data key="d2">[{"text": "Gwendolen Mary Fitzalan-Howard, Duchess of Norfolk, 12th Lady Herries of Terregles (née Constable-Maxwell; 11 January 1877 – 28 August 1945) was the eldest child of Marmaduke Constable-Maxwell, 11th Lord Herries of Terregles and his wife, Angela (née Fitzalan-Howard).", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}]</data>
  <data key="d3">["hp_4b649ff51106ab0b"]</data>
  <data key="d4">False</data>
</node>
<node id="Angela">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Angela was the wife of Marmaduke Constable-Maxwell and the mother of Gwendolen Mary Fitzalan-Howard.", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}]</data>
  <data key="d2">[{"text": "Gwendolen Mary Fitzalan-Howard, Duchess of Norfolk, 12th Lady Herries of Terregles (née Constable-Maxwell; 11 January 1877 – 28 August 1945) was the eldest child of Marmaduke Constable-Maxwell, 11th Lord Herries of Terregles and his wife, Angela (née Fitzalan-Howard).", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}]</data>
  <data key="d3">["hp_4b649ff51106ab0b"]</data>
  <data key="d4">False</data>
</node>
<node id="Fitzalan-Howard">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Fitzalan-Howard was the maiden name of Angela.", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}, {"text": "A surname resumed by Lord Edmund FitzAlan-Howard.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d2">[{"text": "Gwendolen Mary Fitzalan-Howard, Duchess of Norfolk, 12th Lady Herries of Terregles (née Constable-Maxwell; 11 January 1877 – 28 August 1945) was the eldest child of Marmaduke Constable-Maxwell, 11th Lord Herries of Terregles and his wife, Angela (née Fitzalan-Howard).", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}, {"text": "Shortly after being raised to the peerage he resumed the surnames of FitzAlan-Howard in lieu of Talbot.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d3">["hp_4b649ff51106ab0b", "hp_e45eb2b0da78e861"]</data>
  <data key="d4">False</data>
</node>
<node id="Duke of Norfolk">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Duke of Norfolk is a title held by Henry Fitzalan-Howard.", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}, {"text": "The Duke of Norfolk is the premier Duke in the peerage of England.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}, {"text": "Duke of Norfolk is a title that Charles Howard, 10th Duke of Norfolk succeeded to.", "chunk_id": "82f681104648a1d9", "doc_id": "hp_d31213ec63e217cc"}]</data>
  <data key="d2">[{"text": "On 5 February 1904, she married her first cousin once removed, the Henry Fitzalan-Howard, 15th Duke of Norfolk.", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}, {"text": "The Duke of Norfolk is the premier Duke in the peerage of England, and also, as Earl of Arundel, the premier Earl.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}, {"text": "He succeeded to the title of Duke of Norfolk in 1777 after the death of Edward Howard, 9th Duke of Norfolk.", "chunk_id": "82f681104648a1d9", "doc_id": "hp_d31213ec63e217cc"}]</data>
  <data key="d3">["hp_4b649ff51106ab0b", "hp_c50a06491df52f2d", "hp_d31213ec63e217cc"]</data>
  <data key="d4">False</data>
</node>
<node id="Glasgow">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city in Scotland where Notre Dame High School is located.", "chunk_id": "e7083278f65fe2f0", "doc_id": "hp_4b9fa482e8ceec5a"}, {"text": "Glasgow is a location in Scotland where the band Travis is from.", "chunk_id": "8043cae2ef7b7fae", "doc_id": "hp_5e36dcc4c1a872ca"}]</data>
  <data key="d2">[{"text": "Notre Dame High School is a comprehensive state school for girls located on Observatory Road in Glasgow, Scotland, and founded in 1897.", "chunk_id": "e7083278f65fe2f0", "doc_id": "hp_4b9fa482e8ceec5a"}, {"text": "Travis is an alternative rock band from Glasgow, Scotland, comprising Fran Healy (lead vocals, guitar, piano, banjo), Dougie Payne (bass guitar, backing vocals), Andy Dunlop (lead guitar, banjo, keyboards, backing vocals) and Neil Primrose (drums, percussion).", "chunk_id": "8043cae2ef7b7fae", "doc_id": "hp_5e36dcc4c1a872ca"}]</data>
  <data key="d3">["hp_4b9fa482e8ceec5a", "hp_5e36dcc4c1a872ca"]</data>
  <data key="d4">False</data>
</node>
<node id="Notre Dame High">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The only remaining single sex comprehensive school in Scotland.", "chunk_id": "e7083278f65fe2f0", "doc_id": "hp_4b9fa482e8ceec5a"}]</data>
  <data key="d2">[{"text": "Notre Dame High is the only remaining single sex comprehensive school in Scotland.", "chunk_id": "e7083278f65fe2f0", "doc_id": "hp_4b9fa482e8ceec5a"}]</data>
  <data key="d3">["hp_4b9fa482e8ceec5a"]</data>
  <data key="d4">False</data>
</node>
<node id="Strictly Come Dancing">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A British television dance contest featuring contestants, celebrities, and other people, with professional dance partners competing in a ballroom and Latin dance competition.", "chunk_id": "2b519def9b11851e", "doc_id": "hp_4bc5842422a7c734"}, {"text": "The UK series from which the US version of Dancing with the Stars is derived.", "chunk_id": "1ae268ff3c0ca6ac", "doc_id": "hp_ac20c1a6b62d6705"}]</data>
  <data key="d2">[{"text": "Strictly Come Dancing (informally known as Strictly) is a British television dance contest, featuring contestants, celebrities, and other people, from all walks of life, with professional dance partners competing in a ballroom and Latin dance competition.", "chunk_id": "2b519def9b11851e", "doc_id": "hp_4bc5842422a7c734"}, {"text": "It is the US version of the UK series \"Strictly Come Dancing\".", "chunk_id": "1ae268ff3c0ca6ac", "doc_id": "hp_ac20c1a6b62d6705"}]</data>
  <data key="d3">["hp_4bc5842422a7c734", "hp_ac20c1a6b62d6705"]</data>
  <data key="d4">False</data>
</node>
<node id="Strictly">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An informal name for the British television dance contest, Strictly Come Dancing.", "chunk_id": "2b519def9b11851e", "doc_id": "hp_4bc5842422a7c734"}]</data>
  <data key="d2">[{"text": "Strictly Come Dancing (informally known as Strictly) is a British television dance contest, featuring contestants, celebrities, and other people, from all walks of life, with professional dance partners competing in a ballroom and Latin dance competition.", "chunk_id": "2b519def9b11851e", "doc_id": "hp_4bc5842422a7c734"}]</data>
  <data key="d3">["hp_4bc5842422a7c734"]</data>
  <data key="d4">False</data>
</node>
<node id="Come Dancing">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A long-running British television dance series that Strictly Come Dancing suggests a continuation of.", "chunk_id": "2b519def9b11851e", "doc_id": "hp_4bc5842422a7c734"}]</data>
  <data key="d2">[{"text": "The title of the show suggests a continuation of the long-running series \"Come Dancing\", with an allusion to the film \"Strictly Ballroom\".", "chunk_id": "2b519def9b11851e", "doc_id": "hp_4bc5842422a7c734"}]</data>
  <data key="d3">["hp_4bc5842422a7c734"]</data>
  <data key="d4">False</data>
</node>
<node id="Strictly Dance Fever">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A modern dance-themed spin-off inspired by the format of Strictly Come Dancing.", "chunk_id": "2b519def9b11851e", "doc_id": "hp_4bc5842422a7c734"}]</data>
  <data key="d2">[{"text": "The format has been exported to over 40 other countries, and has also inspired a modern dance-themed spin-off \"Strictly Dance Fever\".", "chunk_id": "2b519def9b11851e", "doc_id": "hp_4bc5842422a7c734"}]</data>
  <data key="d3">["hp_4bc5842422a7c734"]</data>
  <data key="d4">False</data>
</node>
<node id="Tess Daly">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A presenter of the television show Strictly Come Dancing.", "chunk_id": "2b519def9b11851e", "doc_id": "hp_4bc5842422a7c734"}]</data>
  <data key="d2">[{"text": "The show is currently presented by Tess Daly and Claudia Winkleman.", "chunk_id": "2b519def9b11851e", "doc_id": "hp_4bc5842422a7c734"}]</data>
  <data key="d3">["hp_4bc5842422a7c734"]</data>
  <data key="d4">False</data>
</node>
