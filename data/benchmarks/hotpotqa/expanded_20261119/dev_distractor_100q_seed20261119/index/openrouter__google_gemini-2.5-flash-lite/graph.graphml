  <data key="d5">["DIRECTED"]</data>
  <data key="d6">Jacques Demy directed the film 'Model Shop'.</data>
  <data key="d7">[{"text": "Model Shop is a 1969 American film by French writer-director Jacques Demy starring Gary Lockwood, Alexandra Hay and Anouk Aimée and featuring a guest appearance by Spirit who also recorded the soundtrack.", "chunk_id": "3488ae8198c6ceab", "doc_id": "hp_654ac6630b014afb", "type": "DIRECTED"}]</data>
  <data key="d8">hp_654ac6630b014afb</data>
</edge>
