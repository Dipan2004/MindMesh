<node id="Chorizanthe watsonii">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Chorizanthe watsonii is a species of flowering plant in the buckwheat family.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d2">[{"text": "Chorizanthe watsonii is a species of flowering plant in the buckwheat family known by the common name fivetooth spineflower.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d3">["hp_42ea38daa77f53b1"]</data>
  <data key="d4">False</data>
</node>
<node id="fivetooth spineflower">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Fivetooth spineflower is the common name for the plant species Chorizanthe watsonii.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d2">[{"text": "Chorizanthe watsonii is a species of flowering plant in the buckwheat family known by the common name fivetooth spineflower.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d3">["hp_42ea38daa77f53b1"]</data>
  <data key="d4">False</data>
</node>
<node id="buckwheat family">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The buckwheat family is a plant family to which Chorizanthe watsonii belongs.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d2">[{"text": "Chorizanthe watsonii is a species of flowering plant in the buckwheat family known by the common name fivetooth spineflower.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d3">["hp_42ea38daa77f53b1"]</data>
  <data key="d4">False</data>
</node>
<node id="western United States">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The western United States is a region from which Chorizanthe watsonii is native.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d2">[{"text": "It is native to the western United States from Washington to the Mojave Desert.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d3">["hp_42ea38daa77f53b1"]</data>
  <data key="d4">False</data>
</node>
<node id="Mojave Desert">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Mojave Desert is a region in the western United States where Chorizanthe watsonii is native.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d2">[{"text": "It is native to the western United States from Washington to the Mojave Desert.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d3">["hp_42ea38daa77f53b1"]</data>
  <data key="d4">False</data>
</node>
<node id="desert scrub">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Desert scrub is a type of plant community where Chorizanthe watsonii can grow.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d2">[{"text": "It grows in many types of plant communities from desert scrub to woodland and sagebrush.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d3">["hp_42ea38daa77f53b1"]</data>
  <data key="d4">False</data>
</node>
<node id="woodland">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Woodland is a type of plant community where Chorizanthe watsonii can grow.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d2">[{"text": "It grows in many types of plant communities from desert scrub to woodland and sagebrush.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d3">["hp_42ea38daa77f53b1"]</data>
  <data key="d4">False</data>
</node>
<node id="sagebrush">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Sagebrush is a type of plant community where Chorizanthe watsonii can grow.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d2">[{"text": "It grows in many types of plant communities from desert scrub to woodland and sagebrush.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d3">["hp_42ea38daa77f53b1"]</data>
  <data key="d4">False</data>
</node>
<node id="woolly erect stem">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A woolly erect stem is a characteristic of the plant Chorizanthe watsonii, growing up to about 15 centimeters tall.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d2">[{"text": "This small plant grows a woolly erect stem up to about 15 centimeters tall.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d3">["hp_42ea38daa77f53b1"]</data>
  <data key="d4">False</data>
</node>
<node id="inflorescence">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The inflorescence is a cluster of flowers surrounded by five hairy greenish bracts tipped with hooked awns.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d2">[{"text": "The inflorescence is a cluster of flowers surrounded by five hairy greenish bracts tipped with hooked awns.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d3">["hp_42ea38daa77f53b1"]</data>
  <data key="d4">False</data>
</node>
<node id="hairy greenish bracts">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Hairy greenish bracts surround the cluster of flowers in the inflorescence and are tipped with hooked awns.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d2">[{"text": "The inflorescence is a cluster of flowers surrounded by five hairy greenish bracts tipped with hooked awns.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d3">["hp_42ea38daa77f53b1"]</data>
  <data key="d4">False</data>
</node>
<node id="hooked awns">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Hooked awns are found at the tips of the hairy greenish bracts.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d2">[{"text": "The inflorescence is a cluster of flowers surrounded by five hairy greenish bracts tipped with hooked awns.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}]</data>
  <data key="d3">["hp_42ea38daa77f53b1"]</data>
  <data key="d4">False</data>
</node>
<node id="Despoina">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "In Greek mythology, Despoina was the daughter of Demeter and Poseidon and sister of Arion.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d2">[{"text": "In Greek mythology, Despoina, Despoena or Despoine, was the daughter of Demeter and Poseidon and sister of Arion.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d3">["hp_438860de5931a74b"]</data>
  <data key="d4">False</data>
</node>
<node id="Despoena">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "In Greek mythology, Despoena was the daughter of Demeter and Poseidon and sister of Arion.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d2">[{"text": "In Greek mythology, Despoina, Despoena or Despoine, was the daughter of Demeter and Poseidon and sister of Arion.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d3">["hp_438860de5931a74b"]</data>
  <data key="d4">False</data>
</node>
<node id="Despoine">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "In Greek mythology, Despoine was the daughter of Demeter and Poseidon and sister of Arion.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d2">[{"text": "In Greek mythology, Despoina, Despoena or Despoine, was the daughter of Demeter and Poseidon and sister of Arion.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d3">["hp_438860de5931a74b"]</data>
  <data key="d4">False</data>
</node>
<node id="Demeter">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Demeter was a Greek goddess, mother of Despoina and Kore.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}, {"text": "A pagan female deity mentioned in the song 'Burning Times'.", "chunk_id": "bc64bf079d554c77", "doc_id": "hp_4e550c7b3015ae79"}]</data>
  <data key="d2">[{"text": "In Greek mythology, Despoina, Despoena or Despoine, was the daughter of Demeter and Poseidon and sister of Arion.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}, {"text": "Its chorus mentions several pagan female deities: \"Isis, Astarte, Diana, Hecate, Demeter, Kali... Inanna\".", "chunk_id": "bc64bf079d554c77", "doc_id": "hp_4e550c7b3015ae79"}]</data>
  <data key="d3">["hp_438860de5931a74b", "hp_4e550c7b3015ae79"]</data>
  <data key="d4">False</data>
</node>
<node id="Poseidon">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Poseidon was a Greek god, father of Despoina and Arion.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d2">[{"text": "In Greek mythology, Despoina, Despoena or Despoine, was the daughter of Demeter and Poseidon and sister of Arion.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d3">["hp_438860de5931a74b"]</data>
  <data key="d4">False</data>
</node>
<node id="Arion">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Arion was the sibling of Despoina.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d2">[{"text": "In Greek mythology, Despoina, Despoena or Despoine, was the daughter of Demeter and Poseidon and sister of Arion.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d3">["hp_438860de5931a74b"]</data>
  <data key="d4">False</data>
</node>
<node id="goddess of mysteries of Arcadian cults">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Despoina was the goddess of mysteries of Arcadian cults.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d2">[{"text": "She was the goddess of mysteries of Arcadian cults worshipped under the title \"Despoina\", \"the mistress\" alongside her mother Demeter, one of the goddesses of the Eleusinian mysteries.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d3">["hp_438860de5931a74b"]</data>
  <data key="d4">False</data>
</node>
<node id="Despoina (title)">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A title worshipped under, meaning 'the mistress'.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d2">[{"text": "She was the goddess of mysteries of Arcadian cults worshipped under the title \"Despoina\", \"the mistress\" alongside her mother Demeter, one of the goddesses of the Eleusinian mysteries.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d3">["hp_438860de5931a74b"]</data>
  <data key="d4">False</data>
</node>
<node id="the mistress">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A title worshipped under, meaning 'the mistress'.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d2">[{"text": "She was the goddess of mysteries of Arcadian cults worshipped under the title \"Despoina\", \"the mistress\" alongside her mother Demeter, one of the goddesses of the Eleusinian mysteries.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d3">["hp_438860de5931a74b"]</data>
  <data key="d4">False</data>
</node>
<node id="Eleusinian mysteries">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A set of religious rites and ceremonies.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d2">[{"text": "She was the goddess of mysteries of Arcadian cults worshipped under the title \"Despoina\", \"the mistress\" alongside her mother Demeter, one of the goddesses of the Eleusinian mysteries.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d3">["hp_438860de5931a74b"]</data>
  <data key="d4">False</data>
</node>
<node id="Kore">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Kore was the first daughter of Demeter and Zeus, later identified as Persephone.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d2">[{"text": "Pausanias spoke of Demeter as having two daughters; Kore being born first, then later Despoina.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d3">["hp_438860de5931a74b"]</data>
  <data key="d4">False</data>
</node>
<node id="Pausanias">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Pausanias was an ancient Greek writer who spoke of Demeter having two daughters.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d2">[{"text": "Pausanias spoke of Demeter as having two daughters; Kore being born first, then later Despoina.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d3">["hp_438860de5931a74b"]</data>
  <data key="d4">False</data>
</node>
<node id="Zeus">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Zeus was the father of Kore.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}, {"text": "Zeus was the father of Dionysus and consort of Semele.", "chunk_id": "237c807e83e54ea2", "doc_id": "hp_cac556477f0e3a91"}]</data>
  <data key="d2">[{"text": "With Zeus being the father of Kore, and Poseidon as the father of Despoina.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}, {"text": "Semele ( ; Greek: Σεμέλη \"Semelē\"), in Greek mythology, daughter of the Boeotian hero Cadmus and Harmonia, was the mortal mother of Dionysus by Zeus in one of his many origin myths.", "chunk_id": "237c807e83e54ea2", "doc_id": "hp_cac556477f0e3a91"}]</data>
  <data key="d3">["hp_438860de5931a74b", "hp_cac556477f0e3a91"]</data>
  <data key="d4">False</data>
</node>
<node id="Persephone">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Persephone is identified as Kore.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d2">[{"text": "Pausanias made it clear that Kore is Persephone, though he wouldn't reveal Despoina's proper name.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b"}]</data>
  <data key="d3">["hp_438860de5931a74b"]</data>
  <data key="d4">False</data>
</node>
<node id="Face">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Face is a 2009 Taiwanese-French film.", "chunk_id": "bf222019d166cecc", "doc_id": "hp_43d5603d87ef8a29"}]</data>
  <data key="d2">[{"text": "Face is a 2009 Taiwanese-French film written and directed by Tsai Ming-liang.", "chunk_id": "bf222019d166cecc", "doc_id": "hp_43d5603d87ef8a29"}]</data>
  <data key="d3">["hp_43d5603d87ef8a29"]</data>
  <data key="d4">False</data>
</node>
<node id="2009">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The year the film Face was released.", "chunk_id": "bf222019d166cecc", "doc_id": "hp_43d5603d87ef8a29"}, {"text": "The year the album \"Black Gives Way to Blue\" was released.", "chunk_id": "4943bcc30a38ea88", "doc_id": "hp_b5f26a3c7ae777dc"}, {"text": "The year Janusz Kołodziej won the Individual Speedway Polish Championship.", "chunk_id": "5ade499ae57701ad", "doc_id": "hp_ed02c3d2ffc66fa6"}]</data>
  <data key="d2">[{"text": "Face is a 2009 Taiwanese-French film written and directed by Tsai Ming-liang.", "chunk_id": "bf222019d166cecc", "doc_id": "hp_43d5603d87ef8a29"}, {"text": "\"Lesson Learned\" is a song by the American rock band Alice in Chains, featured on their fourth studio album, \"Black Gives Way to Blue\" (2009).", "chunk_id": "4943bcc30a38ea88", "doc_id": "hp_b5f26a3c7ae777dc"}, {"text": "Kołodziej, who won 2009 (host in 2010), 2010 Golden Helmet and 2010 Speedway World Cup was award nomination to the 2011 Speedway Grand Prix.", "chunk_id": "5ade499ae57701ad", "doc_id": "hp_ed02c3d2ffc66fa6"}]</data>
  <data key="d3">["hp_43d5603d87ef8a29", "hp_b5f26a3c7ae777dc", "hp_ed02c3d2ffc66fa6"]</data>
  <data key="d4">False</data>
</node>
<node id="Taiwanese-French">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The co-production origin of the film Face.", "chunk_id": "bf222019d166cecc", "doc_id": "hp_43d5603d87ef8a29"}]</data>
  <data key="d2">[{"text": "Face is a 2009 Taiwanese-French film written and directed by Tsai Ming-liang.", "chunk_id": "bf222019d166cecc", "doc_id": "hp_43d5603d87ef8a29"}]</data>
  <data key="d3">["hp_43d5603d87ef8a29"]</data>
