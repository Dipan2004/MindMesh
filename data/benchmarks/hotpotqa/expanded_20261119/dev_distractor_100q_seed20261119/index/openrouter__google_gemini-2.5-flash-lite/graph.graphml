<edge source="Port Macquarie Airport" target="Port Macquarie">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">Port Macquarie Airport is located in Port Macquarie.</data>
  <data key="d7">[{"text": "Port Macquarie Airport (IATA: PQQ, ICAO: YPMQ) is an airport in Port Macquarie, New South Wales, Australia.", "chunk_id": "1908956e32efc2d1", "doc_id": "hp_1414681ce139d8b0", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_1414681ce139d8b0</data>
</edge>
<edge source="Port Macquarie Airport" target="Port Macquarie-Hastings Council">
  <data key="d5">["OWNED_BY", "MANAGED_BY"]</data>
  <data key="d6">Port Macquarie Airport is owned by the Port Macquarie-Hastings Council.</data>
  <data key="d7">[{"text": "The airport is 2.25 NM west of the city center and is owned and managed by the Port Macquarie-Hastings Council (ABN 11 236 901 601) on behalf of its owners - the constituents of the Hastings.", "chunk_id": "1908956e32efc2d1", "doc_id": "hp_1414681ce139d8b0", "type": "OWNED_BY"}, {"text": "The airport is 2.25 NM west of the city center and is owned and managed by the Port Macquarie-Hastings Council (ABN 11 236 901 601) on behalf of its owners - the constituents of the Hastings.", "chunk_id": "1908956e32efc2d1", "doc_id": "hp_1414681ce139d8b0", "type": "MANAGED_BY"}]</data>
  <data key="d8">hp_1414681ce139d8b0</data>
</edge>
<edge source="Port Macquarie Airport" target="Port Macquarie Airport Proprietary Limited">
  <data key="d5">["OTHER"]</data>
  <data key="d6">The ownership of Port Macquarie Airport is not to be confused with Port Macquarie Airport Proprietary Limited.</data>
  <data key="d7">[{"text": "The ownership is not to be confused with the Port Macquarie Airport Proprietary Limited (ABN 88 002 323 122).", "chunk_id": "1908956e32efc2d1", "doc_id": "hp_1414681ce139d8b0", "type": "OTHER"}]</data>
  <data key="d8">hp_1414681ce139d8b0</data>
</edge>
<edge source="Port Macquarie" target="New South Wales">
  <data key="d5">["LOCATED_IN", "LOCATED_IN", "LOCATED_IN"]</data>
  <data key="d6">Port Macquarie is located in New South Wales.</data>
  <data key="d7">[{"text": "Port Macquarie Airport (IATA: PQQ, ICAO: YPMQ) is an airport in Port Macquarie, New South Wales, Australia.", "chunk_id": "1908956e32efc2d1", "doc_id": "hp_1414681ce139d8b0", "type": "LOCATED_IN"}, {"text": "Bonny Hills is a town in New South Wales, Australia about 30 minutes drive south of Port Macquarie.", "chunk_id": "17ec0b20721cd11e", "doc_id": "hp_9be184228ee1e48d", "type": "LOCATED_IN"}, {"text": "The dismissal of the Port Macquarie-Hastings Council on 27 February 2008 marked the end of a series of events involving a project which was initiated in 2001 in the New South Wales coastal town of Port Macquarie to build a cultural and entertainment centre, known to locals as the Glasshouse.", "chunk_id": "203bcd26d9746ba7", "doc_id": "hp_d399c5634a0f3001", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_1414681ce139d8b0</data>
</edge>
