  <data key="d2">[{"text": "The following is a list of winners and shortlisted works of the James Tiptree Jr. Award, an annual literary prize for works of science fiction or fantasy that expand or explore one's understanding of gender.", "chunk_id": "c247beb830b15400", "doc_id": "hp_bf2ea5d754ea7865"}]</data>
