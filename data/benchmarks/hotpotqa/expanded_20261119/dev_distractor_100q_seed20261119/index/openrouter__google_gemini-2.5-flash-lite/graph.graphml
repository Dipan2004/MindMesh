  <data key="d1">[{"text": "A competitor who holds 3 titles in Europe's Strongest Man.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}]</data>
  <data key="d2">[{"text": "Zydrunas Savickas, Geoff Capes, Riku Kiri and Hafþór Júlíus Björnsson each hold 3 titles.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}]</data>
