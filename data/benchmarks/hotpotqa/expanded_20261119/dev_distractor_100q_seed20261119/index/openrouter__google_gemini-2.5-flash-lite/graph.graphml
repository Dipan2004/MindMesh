<node id="witchcraft">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The practice of magic, especially sorcery.", "chunk_id": "bc64bf079d554c77", "doc_id": "hp_4e550c7b3015ae79"}]</data>
  <data key="d2">[{"text": "The song \"Burning Times\" concerns the persecution of women accused of witchcraft in the Middle Ages and early modern periods.", "chunk_id": "bc64bf079d554c77", "doc_id": "hp_4e550c7b3015ae79"}]</data>
  <data key="d3">["hp_4e550c7b3015ae79"]</data>
