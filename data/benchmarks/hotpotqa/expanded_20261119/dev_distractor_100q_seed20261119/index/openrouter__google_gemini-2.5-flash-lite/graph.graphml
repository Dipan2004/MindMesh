<node id="Ruili">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Ruili is a county-level city of Dehong Prefecture, in the west of Yunnan province, People's Republic of China.", "chunk_id": "105244edf12919e4", "doc_id": "hp_4584bae78bfb29b3"}, {"text": "A city in southwestern Yunnan on the border with Myanmar, which is the terminus of the Dali-Ruili Railway.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}, {"text": "A city in Yunnan, China, on the border with Burma, connected by the Hangzhou–Ruili Expressway.", "chunk_id": "b445d8e4dd3011b8", "doc_id": "hp_f8f508f7fcc4bad6"}]</data>
  <data key="d2">[{"text": "Ruili (; Burmese: ရွှေလီ ; Thai: เมืองมาว ) is a county-level city of Dehong Prefecture, in the west of Yunnan province, People's Republic of China.", "chunk_id": "105244edf12919e4", "doc_id": "hp_4584bae78bfb29b3"}, {"text": "The line is slated to run 336.39 km from Dali in central Yunnan to Ruili in southwestern Yunnan on the border with Myanmar.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}, {"text": "The Hangzhou–Ruili Expressway (), commonly referred to as the \"Hangrui Expressway\" () is an expressway in China that connects the cities of Hangzhou, Zhejiang, and Ruili, Yunnan, a city on the border with Burma.", "chunk_id": "b445d8e4dd3011b8", "doc_id": "hp_f8f508f7fcc4bad6"}]</data>
  <data key="d3">["hp_4584bae78bfb29b3", "hp_c90ebb0b4e670d3e", "hp_f8f508f7fcc4bad6"]</data>
  <data key="d4">False</data>
</node>
<node id="Yunnan province">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Yunnan province is a province in the People's Republic of China.", "chunk_id": "105244edf12919e4", "doc_id": "hp_4584bae78bfb29b3"}, {"text": "A province in China.", "chunk_id": "9432ffb2818fa833", "doc_id": "hp_9c94d1d46a54f88d"}, {"text": "A province in China where Dali Prefecture and Mount Jizu are located.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}, {"text": "A province in Southwest China where the Dali-Ruili Railway is under construction.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d2">[{"text": "Ruili (; Burmese: ရွှေလီ ; Thai: เมืองมาว ) is a county-level city of Dehong Prefecture, in the west of Yunnan province, People's Republic of China.", "chunk_id": "105244edf12919e4", "doc_id": "hp_4584bae78bfb29b3"}, {"text": "Kunming Changshui International Airport (IATA: KMG, ICAO: ZPPP) is the primary airport serving Kunming, the capital of Yunnan Province, China.", "chunk_id": "9432ffb2818fa833", "doc_id": "hp_9c94d1d46a54f88d"}, {"text": "Mount Jizu () is situated Dali Prefecture, Yunnan Province, China.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}, {"text": "The Dali–Ruili Railway or Darui Railway (), is a single-track electrified railroad under construction in Yunnan Province of Southwest China.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d3">["hp_4584bae78bfb29b3", "hp_9c94d1d46a54f88d", "hp_b7298b1cd3170cc8", "hp_c90ebb0b4e670d3e"]</data>
  <data key="d4">False</data>
</node>
<node id="Muse">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Muse is a town located across the border from Ruili, China.", "chunk_id": "105244edf12919e4", "doc_id": "hp_4584bae78bfb29b3"}]</data>
  <data key="d2">[{"text": "It is a major border crossing between China and Myanmar, with the town of Muse located across the border.", "chunk_id": "105244edf12919e4", "doc_id": "hp_4584bae78bfb29b3"}]</data>
  <data key="d3">["hp_4584bae78bfb29b3"]</data>
  <data key="d4">False</data>
</node>
