<node id="Meat Love">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Meat Love is a 1989 Czechoslovak animated short film.", "chunk_id": "78d702eb64aa0c99", "doc_id": "hp_89ef8e61a35751f3"}]</data>
  <data key="d2">[{"text": "Meat Love is a 1989 Czechoslovak animated short film directed and animated by Jan Švankmajer.", "chunk_id": "78d702eb64aa0c99", "doc_id": "hp_89ef8e61a35751f3"}]</data>
  <data key="d3">["hp_89ef8e61a35751f3"]</data>
