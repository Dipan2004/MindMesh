  <data key="d6">"Honey, We Shrunk Ourselves" is a sequel to "Honey, I Shrunk the Kids".</data>
  <data key="d7">[{"text": "Honey, We Shrunk Ourselves is a 1997 live-action direct-to-video sequel to \"Honey, I Shrunk the Kids\" and \"Honey, I Blew Up the Kid\".", "chunk_id": "dc5757b648896eba", "doc_id": "hp_a279428a0dd44903", "type": "SEQUEL_OF"}, {"text": "It is the third and final installment in the \"Honey, I Shrunk the Kids\" trilogy.", "chunk_id": "dc5757b648896eba", "doc_id": "hp_a279428a0dd44903", "type": "PART_OF"}]</data>
