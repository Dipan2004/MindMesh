  <data key="d2">[{"text": "A periodic studio musician and touring pianist with artists such as Elliott Smith and Edward Sharpe and the Magnetic Zeros, he has also helped write albums by Jane's Addiction and produced albums by artists such as Avi Buffalo.", "chunk_id": "35b4acf5c74b48d4", "doc_id": "hp_995e15f7f8919993"}]</data>
