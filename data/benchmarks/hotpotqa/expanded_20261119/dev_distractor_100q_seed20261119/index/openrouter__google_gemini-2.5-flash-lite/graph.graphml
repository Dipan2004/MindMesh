  <data key="d5">["PART_OF"]</data>
  <data key="d6">The operations on the Ancre were part of the First World War.</data>
  <data key="d7">[{"text": "Operations on the Ancre took place from 11 January – 13 March 1917, between the British Fifth Army and the German 1st Army, on the Somme front during the First World War.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad", "type": "PART_OF"}]</data>
