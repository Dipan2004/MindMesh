<node id="Trail">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city in British Columbia, Canada, where the Trail Smoke Eaters ice hockey team was based.", "chunk_id": "8c9123487c66f805", "doc_id": "hp_f23b02c7bab7a782"}]</data>
  <data key="d2">[{"text": "The Trail Smoke Eaters (previously named as the \"Trail Hockey Club\") were a senior level men's ice hockey team from Trail, British Columbia that played from 1926 to 1987.", "chunk_id": "8c9123487c66f805", "doc_id": "hp_f23b02c7bab7a782"}]</data>
