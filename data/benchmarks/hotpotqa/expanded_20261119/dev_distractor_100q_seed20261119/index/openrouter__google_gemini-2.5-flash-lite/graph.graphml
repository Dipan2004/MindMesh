  <data key="d2">[{"text": "Previously, he served as an associate athletic director at the University of Virginia and the University of Denver, and spent a year at the University of Iowa as an administrative intern.", "chunk_id": "304723baf35bd7c6", "doc_id": "hp_395f74d5c0c36b8a"}]</data>
  <data key="d3">["hp_395f74d5c0c36b8a"]</data>
  <data key="d4">False</data>
</node>
<node id="Nitrogen assimilation">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Nitrogen assimilation is the formation of organic nitrogen compounds like amino acids from inorganic nitrogen compounds present in the environment.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d2">[{"text": "Nitrogen assimilation is the formation of organic nitrogen compounds like amino acids from inorganic nitrogen compounds present in the environment.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d3">["hp_3982a727a8f0a796"]</data>
  <data key="d4">False</data>
</node>
<node id="amino acids">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Amino acids are organic nitrogen compounds formed during nitrogen assimilation.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d2">[{"text": "Nitrogen assimilation is the formation of organic nitrogen compounds like amino acids from inorganic nitrogen compounds present in the environment.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d3">["hp_3982a727a8f0a796"]</data>
  <data key="d4">False</data>
</node>
<node id="inorganic nitrogen compounds">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Inorganic nitrogen compounds are present in the environment and are used to form organic nitrogen compounds like amino acids through nitrogen assimilation.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d2">[{"text": "Nitrogen assimilation is the formation of organic nitrogen compounds like amino acids from inorganic nitrogen compounds present in the environment.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d3">["hp_3982a727a8f0a796"]</data>
  <data key="d4">False</data>
</node>
<node id="plants">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Plants are organisms that depend on nitrogen assimilation for their needs if they cannot fix nitrogen gas.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d2">[{"text": "Organisms like plants, fungi and certain bacteria that cannot fix nitrogen gas (N) depend on the ability to assimilate nitrate or ammonia for their needs.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d3">["hp_3982a727a8f0a796"]</data>
  <data key="d4">False</data>
</node>
<node id="fungi">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Fungi are organisms that depend on nitrogen assimilation for their needs if they cannot fix nitrogen gas.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d2">[{"text": "Organisms like plants, fungi and certain bacteria that cannot fix nitrogen gas (N) depend on the ability to assimilate nitrate or ammonia for their needs.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d3">["hp_3982a727a8f0a796"]</data>
  <data key="d4">False</data>
</node>
<node id="certain bacteria">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Certain bacteria are organisms that depend on nitrogen assimilation for their needs if they cannot fix nitrogen gas.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d2">[{"text": "Organisms like plants, fungi and certain bacteria that cannot fix nitrogen gas (N) depend on the ability to assimilate nitrate or ammonia for their needs.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d3">["hp_3982a727a8f0a796"]</data>
  <data key="d4">False</data>
</node>
<node id="nitrogen gas">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Nitrogen gas (N) is a compound that some organisms, like plants, fungi, and certain bacteria, cannot fix.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d2">[{"text": "Organisms like plants, fungi and certain bacteria that cannot fix nitrogen gas (N) depend on the ability to assimilate nitrate or ammonia for their needs.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d3">["hp_3982a727a8f0a796"]</data>
  <data key="d4">False</data>
</node>
<node id="nitrate">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Nitrate is a compound that some organisms depend on for their needs through assimilation.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d2">[{"text": "Organisms like plants, fungi and certain bacteria that cannot fix nitrogen gas (N) depend on the ability to assimilate nitrate or ammonia for their needs.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d3">["hp_3982a727a8f0a796"]</data>
  <data key="d4">False</data>
</node>
<node id="ammonia">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Ammonia is a compound that some organisms depend on for their needs through assimilation.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d2">[{"text": "Organisms like plants, fungi and certain bacteria that cannot fix nitrogen gas (N) depend on the ability to assimilate nitrate or ammonia for their needs.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d3">["hp_3982a727a8f0a796"]</data>
  <data key="d4">False</data>
</node>
<node id="animals">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Animals are organisms that depend entirely on organic nitrogen from their food.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d2">[{"text": "Other organisms, like animals, depend entirely on organic nitrogen from their food.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d3">["hp_3982a727a8f0a796"]</data>
  <data key="d4">False</data>
</node>
<node id="organic nitrogen">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Organic nitrogen is obtained by animals from their food.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d2">[{"text": "Other organisms, like animals, depend entirely on organic nitrogen from their food.", "chunk_id": "7ebc949535085acd", "doc_id": "hp_3982a727a8f0a796"}]</data>
  <data key="d3">["hp_3982a727a8f0a796"]</data>
  <data key="d4">False</data>
</node>
