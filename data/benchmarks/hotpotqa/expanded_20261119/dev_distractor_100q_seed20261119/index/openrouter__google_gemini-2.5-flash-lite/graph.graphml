  <data key="d5">["IDEATED_BY"]</data>
  <data key="d6">Frederick Terman is credited with the idea and success of the Stanford Research Park.</data>
  <data key="d7">[{"text": "Frederick Terman is often credited with the idea and success of the Stanford Research Park, which was the first university-owned industrial park at the time of its founding and played a key role in creation of Silicon Valley.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221", "type": "IDEATED_BY"}]</data>
  <data key="d8">hp_8e65f4aec073c221</data>
</edge>
<edge source="Varian Associates" target="Stanford Industrial Park">
  <data key="d5">["TENANT_OF"]</data>
  <data key="d6">Varian Associates was the first tenant of the Stanford Industrial Park.</data>
  <data key="d7">[{"text": "In 1953, Varian Associates relocated to Palo Alto to become the first tenant of the new Stanford Industrial Park.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221", "type": "TENANT_OF"}]</data>
