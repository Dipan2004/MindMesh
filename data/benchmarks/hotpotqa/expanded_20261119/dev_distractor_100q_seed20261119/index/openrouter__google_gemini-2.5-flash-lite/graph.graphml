  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A mosque built in the 11th century in Old City, Baku, also known as Siniggala Mosque.", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d2">[{"text": "Muhammad Mosque or Siniggala Mosque is the mosque built in the 11th century in Old City, Baku.", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d3">["hp_ffb3421ab06921a6"]</data>
  <data key="d4">False</data>
</node>
<node id="Siniggala Mosque">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An alternative name for Muhammad Mosque, derived from the name of its minaret, Siniggala.", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d2">[{"text": "Muhammad Mosque or Siniggala Mosque is the mosque built in the 11th century in Old City, Baku.", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d3">["hp_ffb3421ab06921a6"]</data>
  <data key="d4">False</data>
</node>
<node id="Old City, Baku">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The historical area in Baku where the Muhammad Mosque was built.", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d2">[{"text": "Muhammad Mosque or Siniggala Mosque is the mosque built in the 11th century in Old City, Baku.", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d3">["hp_ffb3421ab06921a6"]</data>
  <data key="d4">False</data>
</node>
<node id="Siniggala">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The name of the minaret of Muhammad Mosque, meaning 'damaged tower'.", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d2">[{"text": "The mosque is also known as Siniggala, for the name of its minaret – Siniggala (“damaged tower”).", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d3">["hp_ffb3421ab06921a6"]</data>
  <data key="d4">False</data>
</node>
<node id="Admiral Matyushkin">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The leader of the Russian Army's squadron that approached Baku in 1723.", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d2">[{"text": "The mosque acquired its second name in 1723, when military squadron of Russian Army, consisting of 15 warships and led by Admiral Matyushkin, approached the city from seaside and demanded its surrender during the Russo-Persian War (1722-1723).", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d3">["hp_ffb3421ab06921a6"]</data>
  <data key="d4">False</data>
</node>
<node id="Russo-Persian War">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A war that took place between 1722 and 1723, during which Baku was attacked by the Russian Army.", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d2">[{"text": "The mosque acquired its second name in 1723, when military squadron of Russian Army, consisting of 15 warships and led by Admiral Matyushkin, approached the city from seaside and demanded its surrender during the Russo-Persian War (1722-1723).", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d3">["hp_ffb3421ab06921a6"]</data>
  <data key="d4">False</data>
</node>
<node id="Russian warships">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Naval vessels belonging to the Russian Army that bombarded Baku in 1723.", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d2">[{"text": "Russian warships began to bomb the city after the refusal to surrender.", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d3">["hp_ffb3421ab06921a6"]</data>
  <data key="d4">False</data>
</node>
<node id="Bengalized">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A term originating from Cincinnati Bengals football fans and/or players, usually referring to a player or fan who develops hostility or frustration with the team due to poor performance and futility.", "chunk_id": "e487f13bc27a273e", "doc_id": "hp_ffc6a1fc4012397a"}]</data>
  <data key="d2">[{"text": "Bengalized is a term with origins among Cincinnati Bengals football fans and/or players.", "chunk_id": "e487f13bc27a273e", "doc_id": "hp_ffc6a1fc4012397a"}]</data>
  <data key="d3">["hp_ffc6a1fc4012397a"]</data>
  <data key="d4">False</data>
</node>
<node id="Cincinnati Bengals">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A professional American football team based in Cincinnati.", "chunk_id": "e487f13bc27a273e", "doc_id": "hp_ffc6a1fc4012397a"}]</data>
  <data key="d2">[{"text": "Bengalized is a term with origins among Cincinnati Bengals football fans and/or players.", "chunk_id": "e487f13bc27a273e", "doc_id": "hp_ffc6a1fc4012397a"}]</data>
  <data key="d3">["hp_ffc6a1fc4012397a"]</data>
  <data key="d4">False</data>
</node>
<node id="coaching staff">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The group of individuals responsible for training and directing a sports team.", "chunk_id": "e487f13bc27a273e", "doc_id": "hp_ffc6a1fc4012397a"}]</data>
  <data key="d2">[{"text": "It usually refers to a Cincinnati Bengals player who, after multiple seasons of poor team performance, develops hostility with the coaching staff or ownership operation, and cultivates pessimism about remaining with the team.", "chunk_id": "e487f13bc27a273e", "doc_id": "hp_ffc6a1fc4012397a"}]</data>
  <data key="d3">["hp_ffc6a1fc4012397a"]</data>
  <data key="d4">False</data>
</node>
<node id="ownership operation">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The management and operational structure of a team's ownership.", "chunk_id": "e487f13bc27a273e", "doc_id": "hp_ffc6a1fc4012397a"}]</data>
  <data key="d2">[{"text": "It usually refers to a Cincinnati Bengals player who, after multiple seasons of poor team performance, develops hostility with the coaching staff or ownership operation, and cultivates pessimism about remaining with the team.", "chunk_id": "e487f13bc27a273e", "doc_id": "hp_ffc6a1fc4012397a"}]</data>
  <data key="d3">["hp_ffc6a1fc4012397a"]</data>
  <data key="d4">False</data>
</node>
