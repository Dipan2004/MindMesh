  <data key="d7">[{"text": "The album debuted at No. 5 on the \"Billboard\" 200, and was certified gold by the RIAA on May 26, 2010, with shipments exceeding 500,000 copies and has sold 1 million copies worldwide.", "chunk_id": "a02521ae2928a8dd", "doc_id": "hp_7e9f73906e63aaa8", "type": "CERTIFIED_BY"}]</data>
