<node id="Skegness">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Skegness is a coastal town and civil parish in the East Lindsey district of Lincolnshire, England.", "chunk_id": "7547e33be5d5dab0", "doc_id": "hp_334151f118143081"}]</data>
  <data key="d2">[{"text": "It lies at the south of, and is conjoined to, Skegness , and comprises the less than half-mile long residential road, Seacroft Esplanade, and a golf course at its south.", "chunk_id": "7547e33be5d5dab0", "doc_id": "hp_334151f118143081"}]</data>
  <data key="d3">["hp_334151f118143081"]</data>
  <data key="d4">False</data>
</node>
