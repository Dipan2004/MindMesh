<edge source="Earl Warren" target="UC Berkeley School of Law">
  <data key="d5">["ALUMNUS_OF"]</data>
  <data key="d6">Earl Warren is an alumnus of UC Berkeley School of Law.</data>
  <data key="d7">[{"text": "The law school has produced leaders in law, government, and society, including Chief Justice of the United States Earl Warren, Secretary of State of the United States Dean Rusk, Attorney General of the United States Edwin Meese, United States Secretary of the Treasury and Chairman of the Federal Reserve G. William Miller, Solicitor General of the United States Theodore Olson, and lead litigator of the \"Korematsu v. United States\" civil rights case, Dale Minami.", "chunk_id": "0ba5a45b986c419a", "doc_id": "hp_5dddd5f952802e7e", "type": "ALUMNUS_OF"}]</data>
  <data key="d8">hp_5dddd5f952802e7e</data>
</edge>
<edge source="Dean Rusk" target="UC Berkeley School of Law">
  <data key="d5">["ALUMNUS_OF"]</data>
  <data key="d6">Dean Rusk is an alumnus of UC Berkeley School of Law.</data>
  <data key="d7">[{"text": "The law school has produced leaders in law, government, and society, including Chief Justice of the United States Earl Warren, Secretary of State of the United States Dean Rusk, Attorney General of the United States Edwin Meese, United States Secretary of the Treasury and Chairman of the Federal Reserve G. William Miller, Solicitor General of the United States Theodore Olson, and lead litigator of the \"Korematsu v. United States\" civil rights case, Dale Minami.", "chunk_id": "0ba5a45b986c419a", "doc_id": "hp_5dddd5f952802e7e", "type": "ALUMNUS_OF"}]</data>
  <data key="d8">hp_5dddd5f952802e7e</data>
</edge>
