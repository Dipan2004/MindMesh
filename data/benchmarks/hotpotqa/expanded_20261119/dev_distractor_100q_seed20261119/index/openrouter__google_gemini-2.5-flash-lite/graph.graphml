</node>
<node id="The Cinematic Orchestra">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Cinematic Orchestra is a British nu jazz and electronic music group.", "chunk_id": "596bf9fd0feb5196", "doc_id": "hp_8dde32505087a9ed"}, {"text": "The Cinematic Orchestra is a group of which Larry D. Brown is a member.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}, {"text": "A British nu-jazz group.", "chunk_id": "a3f3558032a172fb", "doc_id": "hp_d7e95e82b9681f40"}]</data>
  <data key="d2">[{"text": "The Cinematic Orchestra is a British nu jazz and electronic music group, created in 1999 by Jason Swinscoe.", "chunk_id": "596bf9fd0feb5196", "doc_id": "hp_8dde32505087a9ed"}, {"text": "The album was produced by and features guitarist Larry D. Brown, who records under the Grey Reverend moniker and is a member of The Cinematic Orchestra.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}, {"text": "All Things To All Men is a song featured on the album Every Day by British nu-jazz group The Cinematic Orchestra.", "chunk_id": "a3f3558032a172fb", "doc_id": "hp_d7e95e82b9681f40"}]</data>
  <data key="d3">["hp_8dde32505087a9ed", "hp_a4ea94be7751c86c", "hp_d7e95e82b9681f40"]</data>
  <data key="d4">False</data>
</node>
<node id="Jason Swinscoe">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Jason Swinscoe is the creator of The Cinematic Orchestra.", "chunk_id": "596bf9fd0feb5196", "doc_id": "hp_8dde32505087a9ed"}]</data>
  <data key="d2">[{"text": "The Cinematic Orchestra is a British nu jazz and electronic music group, created in 1999 by Jason Swinscoe.", "chunk_id": "596bf9fd0feb5196", "doc_id": "hp_8dde32505087a9ed"}]</data>
  <data key="d3">["hp_8dde32505087a9ed"]</data>
  <data key="d4">False</data>
</node>
<node id="PC (Patrick Carpenter)">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "PC (Patrick Carpenter) is a member of The Cinematic Orchestra, playing turntables, and is a former DJ Food member.", "chunk_id": "596bf9fd0feb5196", "doc_id": "hp_8dde32505087a9ed"}]</data>
  <data key="d2">[{"text": "In addition to Swinscoe, the band includes former DJ Food member PC (Patrick Carpenter) on turntables, Luke Flowers (drums), Tom Chant (saxophone), Nick Ramm (piano), Stuart McCallum (guitar) and Phil France (double bass).", "chunk_id": "596bf9fd0feb5196", "doc_id": "hp_8dde32505087a9ed"}]</data>
  <data key="d3">["hp_8dde32505087a9ed"]</data>
  <data key="d4">False</data>
</node>
