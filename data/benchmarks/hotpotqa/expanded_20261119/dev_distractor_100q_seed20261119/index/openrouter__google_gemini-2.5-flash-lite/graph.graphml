  <data key="d1">[{"text": "A real-life FBI agent that the episode \"Donnie Fatso\" is a reference to.", "chunk_id": "e04e5b86f01e2f28", "doc_id": "hp_79034157698c4480"}, {"text": "An alias used by Joseph Dominick Pistone.", "chunk_id": "e73f7ce666aa44ac", "doc_id": "hp_e188311f102838e1"}]</data>
  <data key="d2">[{"text": "This episode is a reference to \"Goodfellas\" as well as real-life FBI agent Donnie Brasco.", "chunk_id": "e04e5b86f01e2f28", "doc_id": "hp_79034157698c4480"}, {"text": "Joseph Dominick \"Joe\" Pistone, alias Donnie Brasco, (born September 17, 1939), is a former FBI agent who worked undercover for six years infiltrating the Bonanno crime family and to a lesser extent the Colombo crime family, two of the Five Families of the Mafia in New York City.", "chunk_id": "e73f7ce666aa44ac", "doc_id": "hp_e188311f102838e1"}]</data>
