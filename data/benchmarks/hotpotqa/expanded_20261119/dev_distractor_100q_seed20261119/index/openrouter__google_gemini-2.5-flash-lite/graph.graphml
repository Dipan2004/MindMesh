<edge source="Cincinnati Bengals" target="coaching staff">
  <data key="d5">["HAS_RELATIONSHIP_WITH"]</data>
  <data key="d6">A Cincinnati Bengals player may develop hostility with the coaching staff.</data>
  <data key="d7">[{"text": "It usually refers to a Cincinnati Bengals player who, after multiple seasons of poor team performance, develops hostility with the coaching staff or ownership operation, and cultivates pessimism about remaining with the team.", "chunk_id": "e487f13bc27a273e", "doc_id": "hp_ffc6a1fc4012397a", "type": "HAS_RELATIONSHIP_WITH"}]</data>
  <data key="d8">hp_ffc6a1fc4012397a</data>
