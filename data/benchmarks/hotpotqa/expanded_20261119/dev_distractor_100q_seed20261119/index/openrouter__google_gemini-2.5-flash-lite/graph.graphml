<node id="de Sitter–Schwarzschild metric">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A solution in general relativity that describes a black hole in a causal patch of de Sitter space.", "chunk_id": "34ff5929268b9929", "doc_id": "hp_6f7e07fa996d26c4"}]</data>
  <data key="d2">[{"text": "In general relativity, the de Sitter–Schwarzschild solution describes a black hole in a causal patch of de Sitter space.", "chunk_id": "34ff5929268b9929", "doc_id": "hp_6f7e07fa996d26c4"}]</data>
  <data key="d3">["hp_6f7e07fa996d26c4"]</data>
  <data key="d4">False</data>
</node>
<node id="general relativity">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A theory of gravitation that describes gravity not as a force, but as a curvature of spacetime caused by mass and energy.", "chunk_id": "34ff5929268b9929", "doc_id": "hp_6f7e07fa996d26c4"}]</data>
  <data key="d2">[{"text": "In general relativity, the de Sitter–Schwarzschild solution describes a black hole in a causal patch of de Sitter space.", "chunk_id": "34ff5929268b9929", "doc_id": "hp_6f7e07fa996d26c4"}]</data>
  <data key="d3">["hp_6f7e07fa996d26c4"]</data>
  <data key="d4">False</data>
</node>
<node id="de Sitter space">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A maximally symmetric solution to Einstein's field equations in the absence of a cosmological constant.", "chunk_id": "34ff5929268b9929", "doc_id": "hp_6f7e07fa996d26c4"}]</data>
  <data key="d2">[{"text": "In general relativity, the de Sitter–Schwarzschild solution describes a black hole in a causal patch of de Sitter space.", "chunk_id": "34ff5929268b9929", "doc_id": "hp_6f7e07fa996d26c4"}]</data>
  <data key="d3">["hp_6f7e07fa996d26c4"]</data>
  <data key="d4">False</data>
</node>
<node id="Nariai spacetime">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The largest possible de Sitter black hole, which has no singularities and where cosmological and black hole horizons have the same area.", "chunk_id": "34ff5929268b9929", "doc_id": "hp_6f7e07fa996d26c4"}]</data>
  <data key="d2">[{"text": "Unlike a flat-space black hole, there is a largest possible de Sitter black hole, which is the Nariai spacetime.", "chunk_id": "34ff5929268b9929", "doc_id": "hp_6f7e07fa996d26c4"}]</data>
  <data key="d3">["hp_6f7e07fa996d26c4"]</data>
  <data key="d4">False</data>
</node>
