  <data key="d1">[{"text": "Cheshire is a location where Cheadle Hulme is situated.", "chunk_id": "8cdd6a1597b3e1ae", "doc_id": "hp_3dd05a1803bc17b2"}, {"text": "Cheshire is a county in England.", "chunk_id": "77d9bd7c0fae6eb4", "doc_id": "hp_70aed1e36bbd2603"}, {"text": "Cheshire is a county in northwest England.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d2">[{"text": "Helen Atkinson-Wood (born 14 March 1955) is an English actress and comedian born in Cheadle Hulme, Cheshire.", "chunk_id": "8cdd6a1597b3e1ae", "doc_id": "hp_3dd05a1803bc17b2"}, {"text": "Danes Moss Nature Reserve is a 13.4 ha nature reserve south of Macclesfield, Cheshire, England.", "chunk_id": "77d9bd7c0fae6eb4", "doc_id": "hp_70aed1e36bbd2603"}, {"text": "The Very Reverend Godwin Birchenough (27 October 1880, Macclesfield, Cheshire – 3 March, 1953) was the only son of Walter Edwin Birchenough and was the grandson of John Birchenough, a prominent Macclesfield silk manufacturer.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d3">["hp_3dd05a1803bc17b2", "hp_70aed1e36bbd2603", "hp_b4ae5293eb8657fc"]</data>
  <data key="d4">False</data>
</node>
<node id="Songs of David Byrne and Brian Eno Tour">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A 2008–2009 promotional concert tour of music co-written by David Byrne and Brian Eno with performances by Byrne.", "chunk_id": "081d5098b0d99266", "doc_id": "hp_3dfebde99dcc4f0d"}, {"text": "A tour conducted by David Byrne in 2008–2009.", "chunk_id": "df7ef40b10735576", "doc_id": "hp_53b8f4d54167f70d"}]</data>
  <data key="d2">[{"text": "The Songs of David Byrne and Brian Eno Tour is a 2008–2009 promotional concert tour of music co-written by David Byrne and Brian Eno with performances by Byrne.", "chunk_id": "081d5098b0d99266", "doc_id": "hp_3dfebde99dcc4f0d"}, {"text": "Ride, Rise, Roar is a documentary film chronicling the Songs of David Byrne and Brian Eno Tour conducted by David Byrne in 2008–2009.", "chunk_id": "df7ef40b10735576", "doc_id": "hp_53b8f4d54167f70d"}]</data>
