<node id="Museum of the City of New York">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Museum of the City of New York is a museum where Stokely Webster's paintings can be found.", "chunk_id": "1207dedf3633b579", "doc_id": "hp_e2ee24b441181783"}]</data>
  <data key="d2">[{"text": "His paintings can be found in the permanent collections of many museums, including the Metropolitan Museum of Art in New York, the National Museum of American Art, the Smithsonian Institution, the White House, Gracie Mansion in New York, the Senate Office Building, and the Museum of the City of New York.", "chunk_id": "1207dedf3633b579", "doc_id": "hp_e2ee24b441181783"}]</data>
  <data key="d3">["hp_e2ee24b441181783"]</data>
  <data key="d4">False</data>
</node>
<node id="impressionist painter">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Impressionist painter is an artistic style and profession.", "chunk_id": "1207dedf3633b579", "doc_id": "hp_e2ee24b441181783"}]</data>
  <data key="d2">[{"text": "Stokely Webster (1912 – 2001) was best known as an American impressionist painter who studied in Paris.", "chunk_id": "1207dedf3633b579", "doc_id": "hp_e2ee24b441181783"}]</data>
  <data key="d3">["hp_e2ee24b441181783"]</data>
  <data key="d4">False</data>
</node>
<node id="Hsiao Kang">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An alienated buxiban student featured in one of the stories of 'Rebels of the Neon God'.", "chunk_id": "197489edd7e615b2", "doc_id": "hp_e2eedc11b3a4a9ee"}]</data>
  <data key="d2">[{"text": "One details alienated buxiban student Hsiao Kang (Lee Kang-sheng) and his troubled interactions with his family.", "chunk_id": "197489edd7e615b2", "doc_id": "hp_e2eedc11b3a4a9ee"}]</data>
  <data key="d3">["hp_e2eedc11b3a4a9ee"]</data>
  <data key="d4">False</data>
</node>
