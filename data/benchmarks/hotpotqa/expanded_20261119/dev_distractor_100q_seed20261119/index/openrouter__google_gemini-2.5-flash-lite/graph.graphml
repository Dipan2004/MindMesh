  <data key="d7">[{"text": "It was released as the third single from the album on December 16, 2012, and was written by Brandon Flowers and Fran Healy.", "chunk_id": "ea618fdd901514b3", "doc_id": "hp_f6f4e0beb9d8d251", "type": "WRITTEN_BY"}]</data>
