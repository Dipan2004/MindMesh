<node id="film animation">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A form of animation that has seen pioneers from Czech animators.", "chunk_id": "39592b16dc8ece21", "doc_id": "hp_873b85c0ff464a88"}]</data>
  <data key="d2">[{"text": "Czech animators are considered pioneers in film animation.", "chunk_id": "39592b16dc8ece21", "doc_id": "hp_873b85c0ff464a88"}]</data>
