<node id="M9 highway (Russia)">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The M9 highway is a 610 km-long trunk road in Russia.", "chunk_id": "2d8fd36c09df60bf", "doc_id": "hp_360b3afe94cb5e9d"}]</data>
  <data key="d2">[{"text": "The Russian route M9, also known as the \"Baltic Highway\", is a 610 km-long trunk road that leads from Moscow through Volokolamsk to Russia's border with Latvia.", "chunk_id": "2d8fd36c09df60bf", "doc_id": "hp_360b3afe94cb5e9d"}]</data>
  <data key="d3">["hp_360b3afe94cb5e9d"]</data>
  <data key="d4">False</data>
</node>
<node id="Baltic Highway">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Baltic Highway is another name for the Russian route M9.", "chunk_id": "2d8fd36c09df60bf", "doc_id": "hp_360b3afe94cb5e9d"}]</data>
  <data key="d2">[{"text": "The Russian route M9, also known as the \"Baltic Highway\", is a 610 km-long trunk road that leads from Moscow through Volokolamsk to Russia's border with Latvia.", "chunk_id": "2d8fd36c09df60bf", "doc_id": "hp_360b3afe94cb5e9d"}]</data>
  <data key="d3">["hp_360b3afe94cb5e9d"]</data>
  <data key="d4">False</data>
</node>
<node id="Volokolamsk">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Volokolamsk is a town in Russia that the M9 highway passes through.", "chunk_id": "2d8fd36c09df60bf", "doc_id": "hp_360b3afe94cb5e9d"}]</data>
  <data key="d2">[{"text": "The Russian route M9, also known as the \"Baltic Highway\", is a 610 km-long trunk road that leads from Moscow through Volokolamsk to Russia's border with Latvia.", "chunk_id": "2d8fd36c09df60bf", "doc_id": "hp_360b3afe94cb5e9d"}]</data>
  <data key="d3">["hp_360b3afe94cb5e9d"]</data>
  <data key="d4">False</data>
</node>
<node id="Latvia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Latvia is a country that the M9 highway borders.", "chunk_id": "2d8fd36c09df60bf", "doc_id": "hp_360b3afe94cb5e9d"}, {"text": "Latvia is a country that Larisa Savchenko-Neiland represented.", "chunk_id": "a082985ce6c40064", "doc_id": "hp_fb47f9f89cb7cf5e"}]</data>
  <data key="d2">[{"text": "The Russian route M9, also known as the \"Baltic Highway\", is a 610 km-long trunk road that leads from Moscow through Volokolamsk to Russia's border with Latvia.", "chunk_id": "2d8fd36c09df60bf", "doc_id": "hp_360b3afe94cb5e9d"}, {"text": "Larisa Savchenko-Neiland (née Savchenko; born 21 July 1966) is a professional tennis player who represented the Soviet Union and Latvia.", "chunk_id": "a082985ce6c40064", "doc_id": "hp_fb47f9f89cb7cf5e"}]</data>
  <data key="d3">["hp_360b3afe94cb5e9d", "hp_fb47f9f89cb7cf5e"]</data>
  <data key="d4">False</data>
</node>
<node id="Krasnogorsk">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Krasnogorsk is a town in Russia that the M9 highway runs north of Moscow across.", "chunk_id": "2d8fd36c09df60bf", "doc_id": "hp_360b3afe94cb5e9d"}]</data>
  <data key="d2">[{"text": "The road runs north of Moscow across the towns of Krasnogorsk, Istra, Volokolamsk, Zubtsov, Rzhev, Velikiye Luki, and Sebezh, ending up at the state border.", "chunk_id": "2d8fd36c09df60bf", "doc_id": "hp_360b3afe94cb5e9d"}]</data>
  <data key="d3">["hp_360b3afe94cb5e9d"]</data>
