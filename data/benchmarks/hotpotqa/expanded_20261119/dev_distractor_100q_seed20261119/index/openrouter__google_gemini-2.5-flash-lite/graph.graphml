  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The distributor of the film \"Honey, We Shrunk Ourselves\".", "chunk_id": "dc5757b648896eba", "doc_id": "hp_a279428a0dd44903"}]</data>
  <data key="d2">[{"text": "The directorial debut of cinematographer Dean Cundey and released through Walt Disney Home Video, it tells the story of inventor Wayne Szalinski as he accidentally shrinks his wife, brother, sister-in-law, and himself with his electromagnetic shrink ray.", "chunk_id": "dc5757b648896eba", "doc_id": "hp_a279428a0dd44903"}]</data>
  <data key="d3">["hp_a279428a0dd44903"]</data>
  <data key="d4">False</data>
</node>
<node id="Wayne Szalinski">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An inventor who accidentally shrinks his family and himself with his electromagnetic shrink ray.", "chunk_id": "dc5757b648896eba", "doc_id": "hp_a279428a0dd44903"}]</data>
  <data key="d2">[{"text": "The directorial debut of cinematographer Dean Cundey and released through Walt Disney Home Video, it tells the story of inventor Wayne Szalinski as he accidentally shrinks his wife, brother, sister-in-law, and himself with his electromagnetic shrink ray.", "chunk_id": "dc5757b648896eba", "doc_id": "hp_a279428a0dd44903"}]</data>
  <data key="d3">["hp_a279428a0dd44903"]</data>
  <data key="d4">False</data>
</node>
<node id="electromagnetic shrink ray">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A device invented by Wayne Szalinski that can shrink people and objects.", "chunk_id": "dc5757b648896eba", "doc_id": "hp_a279428a0dd44903"}]</data>
  <data key="d2">[{"text": "The directorial debut of cinematographer Dean Cundey and released through Walt Disney Home Video, it tells the story of inventor Wayne Szalinski as he accidentally shrinks his wife, brother, sister-in-law, and himself with his electromagnetic shrink ray.", "chunk_id": "dc5757b648896eba", "doc_id": "hp_a279428a0dd44903"}]</data>
  <data key="d3">["hp_a279428a0dd44903"]</data>
  <data key="d4">False</data>
</node>
<node id="Gibraltar Nature Reserve">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A protected nature reserve in Gibraltar that covers over 40% of the country's land area.", "chunk_id": "b2cecb19f962314a", "doc_id": "hp_a2873cfc53097a81"}]</data>
  <data key="d2">[{"text": "The Gibraltar Nature Reserve (formerly the Upper Rock Nature Reserve) is a protected nature reserve in the British Overseas Territory of Gibraltar that covers over 40% of the country's land area.", "chunk_id": "b2cecb19f962314a", "doc_id": "hp_a2873cfc53097a81"}]</data>
  <data key="d3">["hp_a2873cfc53097a81"]</data>
  <data key="d4">False</data>
</node>
<node id="Upper Rock Nature Reserve">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The former name of the Gibraltar Nature Reserve.", "chunk_id": "b2cecb19f962314a", "doc_id": "hp_a2873cfc53097a81"}]</data>
  <data key="d2">[{"text": "The Gibraltar Nature Reserve (formerly the Upper Rock Nature Reserve) is a protected nature reserve in the British Overseas Territory of Gibraltar that covers over 40% of the country's land area.", "chunk_id": "b2cecb19f962314a", "doc_id": "hp_a2873cfc53097a81"}]</data>
  <data key="d3">["hp_a2873cfc53097a81"]</data>
  <data key="d4">False</data>
</node>
<node id="British Overseas Territory of Gibraltar">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A British Overseas Territory where the Gibraltar Nature Reserve is located.", "chunk_id": "b2cecb19f962314a", "doc_id": "hp_a2873cfc53097a81"}]</data>
  <data key="d2">[{"text": "The Gibraltar Nature Reserve (formerly the Upper Rock Nature Reserve) is a protected nature reserve in the British Overseas Territory of Gibraltar that covers over 40% of the country's land area.", "chunk_id": "b2cecb19f962314a", "doc_id": "hp_a2873cfc53097a81"}]</data>
  <data key="d3">["hp_a2873cfc53097a81"]</data>
  <data key="d4">False</data>
</node>
<node id="International Union for Conservation of Nature">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An organization that established the Upper Rock Nature Reserve under its category Ia.", "chunk_id": "b2cecb19f962314a", "doc_id": "hp_a2873cfc53097a81"}]</data>
  <data key="d2">[{"text": "It was established as the Upper Rock Nature Reserve in 1993 under the International Union for Conservation of Nature's category Ia (strict nature reserve) and was last extended in 2013.", "chunk_id": "b2cecb19f962314a", "doc_id": "hp_a2873cfc53097a81"}]</data>
  <data key="d3">["hp_a2873cfc53097a81"]</data>
  <data key="d4">False</data>
</node>
<node id="Barbary macaques">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A semi-wild population found in the Gibraltar Nature Reserve.", "chunk_id": "b2cecb19f962314a", "doc_id": "hp_a2873cfc53097a81"}]</data>
  <data key="d2">[{"text": "It is known for its semi-wild population of Barbary macaques, and is an important resting point for migrating birds.", "chunk_id": "b2cecb19f962314a", "doc_id": "hp_a2873cfc53097a81"}]</data>
  <data key="d3">["hp_a2873cfc53097a81"]</data>
  <data key="d4">False</data>
</node>
<node id="Boogie Woogie">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Boogie Woogie was an Indian dance competition television series.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}]</data>
  <data key="d2">[{"text": "Boogie Woogie was an Indian dance competition television series created and directed by Naved Jaffrey and Ravi Behl for Sony Entertainment Television and Sony Entertainment Television Asia.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}]</data>
  <data key="d3">["hp_a2a8fb62705d96e4"]</data>
  <data key="d4">False</data>
</node>
<node id="Naved Jaffrey">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Naved Jaffrey was the creator, director, and producer of the TV series Boogie Woogie.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}]</data>
  <data key="d2">[{"text": "Boogie Woogie was an Indian dance competition television series created and directed by Naved Jaffrey and Ravi Behl for Sony Entertainment Television and Sony Entertainment Television Asia.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}]</data>
  <data key="d3">["hp_a2a8fb62705d96e4"]</data>
  <data key="d4">False</data>
</node>
<node id="Ravi Behl">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Ravi Behl was a co-director and co-host of the TV series Boogie Woogie.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}, {"text": "Ravi Behl was a creator and director of the Boogie Woogie Kids Championship and a permanent judge on the show.", "chunk_id": "0ed37f3f70846148", "doc_id": "hp_fa98fe724fcd50b7"}]</data>
  <data key="d2">[{"text": "Boogie Woogie was an Indian dance competition television series created and directed by Naved Jaffrey and Ravi Behl for Sony Entertainment Television and Sony Entertainment Television Asia.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}, {"text": "Boogie Woogie Kids Championship was an Indian dance competition television series created and directed by Javed Jaffrey and Ravi Behl, owners of R&amp;N TV Productions, for Sony Entertainment Television and Sony Entertainment Television Asia.", "chunk_id": "0ed37f3f70846148", "doc_id": "hp_fa98fe724fcd50b7"}]</data>
  <data key="d3">["hp_a2a8fb62705d96e4", "hp_fa98fe724fcd50b7"]</data>
  <data key="d4">False</data>
</node>
<node id="Sony Entertainment Television">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Sony Entertainment Television was one of the networks for which the TV series Boogie Woogie was created.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}, {"text": "A television channel that airs 'The Kapil Sharma Show'.", "chunk_id": "5d9df2b9303ace0a", "doc_id": "hp_c9dd7579f6f3529c"}, {"text": "Sony Entertainment Television was the network for which the Boogie Woogie Kids Championship was created.", "chunk_id": "0ed37f3f70846148", "doc_id": "hp_fa98fe724fcd50b7"}]</data>
  <data key="d2">[{"text": "Boogie Woogie was an Indian dance competition television series created and directed by Naved Jaffrey and Ravi Behl for Sony Entertainment Television and Sony Entertainment Television Asia.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}, {"text": "Currently, he is hosting another comedy show on Sony Entertainment Television named \"The Kapil Sharma Show\".", "chunk_id": "5d9df2b9303ace0a", "doc_id": "hp_c9dd7579f6f3529c"}, {"text": "Boogie Woogie Kids Championship was an Indian dance competition television series created and directed by Javed Jaffrey and Ravi Behl, owners of R&amp;N TV Productions, for Sony Entertainment Television and Sony Entertainment Television Asia.", "chunk_id": "0ed37f3f70846148", "doc_id": "hp_fa98fe724fcd50b7"}]</data>
  <data key="d3">["hp_a2a8fb62705d96e4", "hp_c9dd7579f6f3529c", "hp_fa98fe724fcd50b7"]</data>
  <data key="d4">False</data>
</node>
<node id="Sony Entertainment Television Asia">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Sony Entertainment Television Asia was one of the networks for which the TV series Boogie Woogie was created.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}, {"text": "Sony Entertainment Television Asia was the network for which the Boogie Woogie Kids Championship was created.", "chunk_id": "0ed37f3f70846148", "doc_id": "hp_fa98fe724fcd50b7"}]</data>
  <data key="d2">[{"text": "Boogie Woogie was an Indian dance competition television series created and directed by Naved Jaffrey and Ravi Behl for Sony Entertainment Television and Sony Entertainment Television Asia.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}, {"text": "Boogie Woogie Kids Championship was an Indian dance competition television series created and directed by Javed Jaffrey and Ravi Behl, owners of R&amp;N TV Productions, for Sony Entertainment Television and Sony Entertainment Television Asia.", "chunk_id": "0ed37f3f70846148", "doc_id": "hp_fa98fe724fcd50b7"}]</data>
  <data key="d3">["hp_a2a8fb62705d96e4", "hp_fa98fe724fcd50b7"]</data>
  <data key="d4">False</data>
</node>
<node id="Javed Jaffrey">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Javed Jaffrey was the permanent judge of the TV series Boogie Woogie.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}, {"text": "Javed Jaffrey was a creator and director of the Boogie Woogie Kids Championship and a permanent judge on the show.", "chunk_id": "0ed37f3f70846148", "doc_id": "hp_fa98fe724fcd50b7"}]</data>
  <data key="d2">[{"text": "Debuting in 1996, the show was judged by Indian film actor and Television host Javed Jaffrey who was the permanent judge, while his brother Naved, also the director and producer of the show, co hosted the show along with film actor Ravi Behl.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}, {"text": "Boogie Woogie Kids Championship was an Indian dance competition television series created and directed by Javed Jaffrey and Ravi Behl, owners of R&amp;N TV Productions, for Sony Entertainment Television and Sony Entertainment Television Asia.", "chunk_id": "0ed37f3f70846148", "doc_id": "hp_fa98fe724fcd50b7"}]</data>
  <data key="d3">["hp_a2a8fb62705d96e4", "hp_fa98fe724fcd50b7"]</data>
  <data key="d4">False</data>
</node>
<node id="Mehta Industrial Estate">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Mehta Industrial Estate was one of the locations where the early episodes of Boogie Woogie were shot.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}]</data>
  <data key="d2">[{"text": "The early episodes were shot in Mehta Industrial Estate in Andheri, Mumbai and later, was also shot at other film studios in Mumbai including Natraj, Filmalaya, Filmistaan, Famous, Film City among others.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}]</data>
  <data key="d3">["hp_a2a8fb62705d96e4"]</data>
  <data key="d4">False</data>
</node>
<node id="Andheri">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Andheri is a location in Mumbai where Mehta Industrial Estate is situated.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}]</data>
  <data key="d2">[{"text": "The early episodes were shot in Mehta Industrial Estate in Andheri, Mumbai and later, was also shot at other film studios in Mumbai including Natraj, Filmalaya, Filmistaan, Famous, Film City among others.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}]</data>
  <data key="d3">["hp_a2a8fb62705d96e4"]</data>
  <data key="d4">False</data>
