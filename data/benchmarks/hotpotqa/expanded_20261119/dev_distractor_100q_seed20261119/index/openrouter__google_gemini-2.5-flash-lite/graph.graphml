  <data key="d5">["GRADUATED_FROM"]</data>
  <data key="d6">Takanori Arisawa graduated from Senzoku Gakuen College.</data>
  <data key="d7">[{"text": "After graduating from Senzoku Gakuen College, Arisawa started his career in 1980 by composing \"Shinjuku Transfer\".", "chunk_id": "a288b38bfb013c0a", "doc_id": "hp_be8748f7d316f7c3", "type": "GRADUATED_FROM"}]</data>
