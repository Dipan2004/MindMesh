  <data key="d2">[{"text": "Pterostyrax hispidus, the epaulette tree or fragrant epaulette tree, is a species of flowering plant in the family Styracaceae, native to China and Japan.", "chunk_id": "5a4b1080849ca551", "doc_id": "hp_10ed6dd74595a5bc"}]</data>
