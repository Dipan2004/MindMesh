<node id="Second Amendment">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A part of the US Constitution that Stephen Halbrook has written extensively about.", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d2">[{"text": "He has written extensively about the original meanings of the Second Amendment and the Fourteenth Amendment (the latter as applied to Second Amendment rights).", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
