<node id="Byron Kurt Lichtenberg">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Byron Kurt Lichtenberg is an American engineer and fighter pilot who flew aboard two NASA Space Shuttle missions as a Payload Specialist.", "chunk_id": "986fec5d5c4ec7fd", "doc_id": "hp_ab0e95c94eff4211"}]</data>
  <data key="d2">[{"text": "Byron Kurt Lichtenberg, Sc. D. (born February 19, 1948) is an American engineer and fighter pilot who flew aboard two NASA Space Shuttle missions as a Payload Specialist.", "chunk_id": "986fec5d5c4ec7fd", "doc_id": "hp_ab0e95c94eff4211"}]</data>
  <data key="d3">["hp_ab0e95c94eff4211"]</data>
  <data key="d4">False</data>
</node>
<node id="Ulf Merbold">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Ulf Merbold became the first Payload Specialist to fly on the shuttle in 1983 along with Byron K. Lichtenberg.", "chunk_id": "986fec5d5c4ec7fd", "doc_id": "hp_ab0e95c94eff4211"}, {"text": "The first West German citizen and second German native to have flown in space.", "chunk_id": "1dda59241bb9cd52", "doc_id": "hp_cc1f6a95f8e649b8"}]</data>
  <data key="d2">[{"text": "In 1983, he and Ulf Merbold became the first Payload Specialists to fly on the shuttle.", "chunk_id": "986fec5d5c4ec7fd", "doc_id": "hp_ab0e95c94eff4211"}, {"text": "Dr. Ulf Dietrich Merbold (born June 20, 1941) is the first West German citizen and second German native (after Sigmund Jähn) to have flown in space.", "chunk_id": "1dda59241bb9cd52", "doc_id": "hp_cc1f6a95f8e649b8"}]</data>
  <data key="d3">["hp_ab0e95c94eff4211", "hp_cc1f6a95f8e649b8"]</data>
  <data key="d4">False</data>
</node>
<node id="Robert Oberst">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Robert Oberst is an American professional strongman.", "chunk_id": "fd867132c1c55e97", "doc_id": "hp_ab10a66f84257538"}]</data>
  <data key="d2">[{"text": "Robert Oberst (born December 20, 1984) is an American professional strongman who was awarded his \"Pro Card\" at the 2012 Dallas Europa Amateur Strongman Competition.", "chunk_id": "fd867132c1c55e97", "doc_id": "hp_ab10a66f84257538"}]</data>
  <data key="d3">["hp_ab10a66f84257538"]</data>
  <data key="d4">False</data>
</node>
<node id="2012 Dallas Europa Amateur Strongman Competition">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 2012 Dallas Europa Amateur Strongman Competition is an event where Robert Oberst was awarded his \"Pro Card\".", "chunk_id": "fd867132c1c55e97", "doc_id": "hp_ab10a66f84257538"}]</data>
  <data key="d2">[{"text": "Robert Oberst (born December 20, 1984) is an American professional strongman who was awarded his \"Pro Card\" at the 2012 Dallas Europa Amateur Strongman Competition.", "chunk_id": "fd867132c1c55e97", "doc_id": "hp_ab10a66f84257538"}]</data>
  <data key="d3">["hp_ab10a66f84257538"]</data>
  <data key="d4">False</data>
</node>
<node id="2015 World's Strongest Man">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 2015 World's Strongest Man is a competition that Robert Oberst competed in.", "chunk_id": "fd867132c1c55e97", "doc_id": "hp_ab10a66f84257538"}]</data>
  <data key="d2">[{"text": "He is a yearly competitor of the World's Strongest Man including the 2013 World's Strongest Man, 2014 World's Strongest Man, 2015 World's Strongest Man and the 2016 World's Strongest Man competitions.", "chunk_id": "fd867132c1c55e97", "doc_id": "hp_ab10a66f84257538"}]</data>
  <data key="d3">["hp_ab10a66f84257538"]</data>
  <data key="d4">False</data>
</node>
<node id="2016 World's Strongest Man">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 2016 World's Strongest Man is a competition that Robert Oberst competed in.", "chunk_id": "fd867132c1c55e97", "doc_id": "hp_ab10a66f84257538"}]</data>
  <data key="d2">[{"text": "He is a yearly competitor of the World's Strongest Man including the 2013 World's Strongest Man, 2014 World's Strongest Man, 2015 World's Strongest Man and the 2016 World's Strongest Man competitions.", "chunk_id": "fd867132c1c55e97", "doc_id": "hp_ab10a66f84257538"}]</data>
  <data key="d3">["hp_ab10a66f84257538"]</data>
  <data key="d4">False</data>
</node>
<node id="This Is It (Michael Jackson song)">
  <data key="d0">SONG</data>
  <data key="d1">[{"text": "A song co-written by Michael Jackson and Paul Anka.", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d2">[{"text": "\"This Is It\" is a song co-written by American pop star and musician Michael Jackson and Canadian singer-songwriter Paul Anka.", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d3">["hp_aba1d192473010be"]</data>
  <data key="d4">False</data>
</node>
<node id="Paul Anka">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A Canadian singer-songwriter.", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d2">[{"text": "\"This Is It\" is a song co-written by American pop star and musician Michael Jackson and Canadian singer-songwriter Paul Anka.", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d3">["hp_aba1d192473010be"]</data>
  <data key="d4">False</data>
</node>
<node id="This Is It (album)">
  <data key="d0">ALBUM</data>
  <data key="d1">[{"text": "An album released in 2009 that accompanies the concert documentary \"Michael Jackson's This Is It\".", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d2">[{"text": "The song was recorded by the former and featured as a track on the album, \"This Is It\" (2009), which accompanies the 2009 concert documentary \"Michael Jackson's This Is It\".", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d3">["hp_aba1d192473010be"]</data>
  <data key="d4">False</data>
</node>
<node id="Sony Music Entertainment">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A company that referred to the song as a \"new single\" during its promotion.", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d2">[{"text": "Although Sony Music Entertainment referred to the song as a \"new single\" during its promotion, it was later confirmed that the song would only be sent for airplay, and not be available to buy as a single release.", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d3">["hp_aba1d192473010be"]</data>
  <data key="d4">False</data>
</node>
<node id="Walk a Fine Line (album)">
  <data key="d0">ALBUM</data>
  <data key="d1">[{"text": "An album by Paul Anka.", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d2">[{"text": "According to Anka, the song was recorded in 1983 and intended to be a duet between him and Jackson on Anka's \"Walk a Fine Line\" album under the title \"I Never Heard\", but these plans fell through.", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d3">["hp_aba1d192473010be"]</data>
  <data key="d4">False</data>
</node>
<node id="I Never Heard">
  <data key="d0">SONG</data>
  <data key="d1">[{"text": "The original title of the song \"This Is It\" when it was intended to be a duet between Paul Anka and Michael Jackson.", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d2">[{"text": "According to Anka, the song was recorded in 1983 and intended to be a duet between him and Jackson on Anka's \"Walk a Fine Line\" album under the title \"I Never Heard\", but these plans fell through.", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d3">["hp_aba1d192473010be"]</data>
  <data key="d4">False</data>
</node>
<node id="Sa-Fire">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An artist who recorded the track \"This Is It\" for her album.", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d2">[{"text": "Thereafter, Sa-Fire recorded the track for her album, \"I Wasn't Born Yesterday\" (1991).", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d3">["hp_aba1d192473010be"]</data>
  <data key="d4">False</data>
</node>
<node id="I Wasn't Born Yesterday (album)">
  <data key="d0">ALBUM</data>
  <data key="d1">[{"text": "An album by Sa-Fire released in 1991.", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d2">[{"text": "Thereafter, Sa-Fire recorded the track for her album, \"I Wasn't Born Yesterday\" (1991).", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d3">["hp_aba1d192473010be"]</data>
  <data key="d4">False</data>
</node>
<node id="Duets (album)">
  <data key="d0">ALBUM</data>
  <data key="d1">[{"text": "A 2013 album by Paul Anka that featured a duet version of the song \"This Is It\".", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d2">[{"text": "The duet version of the song was featured in Anka's 2013 \"Duets\" album.", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d3">["hp_aba1d192473010be"]</data>
  <data key="d4">False</data>
</node>
<node id="Jackson's estate">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The estate of Michael Jackson, which agreed to give Paul Anka 50% of the song's publishing rights.", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d2">[{"text": "The estate then agreed to give Anka 50% of the song's publishing rights.", "chunk_id": "8fc2541873625ab9", "doc_id": "hp_aba1d192473010be"}]</data>
  <data key="d3">["hp_aba1d192473010be"]</data>
  <data key="d4">False</data>
</node>
<node id="Sonatas and Interludes">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A collection of twenty pieces for prepared piano by John Cage.", "chunk_id": "46e2753873dd1884", "doc_id": "hp_abe4b15111caba47"}, {"text": "John Cage's most highly acclaimed work for prepared piano.", "chunk_id": "b7f8e7da447a5f1c", "doc_id": "hp_e9f272e0c789745f"}]</data>
  <data key="d2">[{"text": "Sonatas and Interludes is a collection of twenty pieces for prepared piano by American avant-garde composer John Cage (1912–1992).", "chunk_id": "46e2753873dd1884", "doc_id": "hp_abe4b15111caba47"}, {"text": "In the liner notes for the very first recording of his most highly acclaimed work for prepared piano, \"Sonatas and Interludes\", Cage wrote: \"Composing for the prepared piano is not a criticism of the instrument.", "chunk_id": "b7f8e7da447a5f1c", "doc_id": "hp_e9f272e0c789745f"}]</data>
  <data key="d3">["hp_abe4b15111caba47", "hp_e9f272e0c789745f"]</data>
  <data key="d4">False</data>
</node>
<node id="Indian philosophy">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Philosophical traditions originating in the Indian subcontinent.", "chunk_id": "46e2753873dd1884", "doc_id": "hp_abe4b15111caba47"}]</data>
  <data key="d2">[{"text": "It was composed in 1946–48, shortly after Cage's introduction to Indian philosophy and the teachings of art historian Ananda K. Coomaraswamy, both of which became major influences on the composer's later work.", "chunk_id": "46e2753873dd1884", "doc_id": "hp_abe4b15111caba47"}]</data>
  <data key="d3">["hp_abe4b15111caba47"]</data>
  <data key="d4">False</data>
</node>
<node id="Ananda K. Coomaraswamy">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An art historian.", "chunk_id": "46e2753873dd1884", "doc_id": "hp_abe4b15111caba47"}]</data>
  <data key="d2">[{"text": "It was composed in 1946–48, shortly after Cage's introduction to Indian philosophy and the teachings of art historian Ananda K. Coomaraswamy, both of which became major influences on the composer's later work.", "chunk_id": "46e2753873dd1884", "doc_id": "hp_abe4b15111caba47"}]</data>
  <data key="d3">["hp_abe4b15111caba47"]</data>
  <data key="d4">False</data>
</node>
