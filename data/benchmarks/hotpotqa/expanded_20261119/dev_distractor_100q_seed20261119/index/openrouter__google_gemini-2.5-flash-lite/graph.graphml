  <data key="d2">[{"text": "The show was choreographed by Glenn Douglas Packard &amp; Brian Thomas, they were nominated for a Emmy Award for Outstanding Choreography.", "chunk_id": "27c840a9f2ae6d8f", "doc_id": "hp_e324150cd91f309d"}]</data>
