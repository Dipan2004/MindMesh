<node id="England">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The country where Coventry is located.", "chunk_id": "41d562b159afe9d1", "doc_id": "hp_025c1875e6de72c3"}, {"text": "A country where Monty Banks achieved success.", "chunk_id": "1e569c2aa40d90c4", "doc_id": "hp_15caf36624649b1e"}, {"text": "England is a country that is part of the United Kingdom.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}, {"text": "England is a country that signed a treaty regarding the French troops.", "chunk_id": "fed038ae0c566b69", "doc_id": "hp_26004159736d7249"}, {"text": "England is a country that is part of the United Kingdom.", "chunk_id": "7547e33be5d5dab0", "doc_id": "hp_334151f118143081"}, {"text": "England is a country where Norwich is located.", "chunk_id": "379e79f8fef657ef", "doc_id": "hp_33fd17055c06917a"}, {"text": "A country from which students of the Conservatory originated.", "chunk_id": "8866c9256d91177d", "doc_id": "hp_530d45fd86f01aa0"}, {"text": "England is a country that is part of the United Kingdom.", "chunk_id": "77d9bd7c0fae6eb4", "doc_id": "hp_70aed1e36bbd2603"}, {"text": "England is a country that is part of the United Kingdom.", "chunk_id": "11a5bbb4b1c95f73", "doc_id": "hp_7986a45cdf0624b2"}, {"text": "The country where the society was founded and its headquarters is currently located.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}, {"text": "England is a country that is part of the United Kingdom.", "chunk_id": "7ad43fdb3c803322", "doc_id": "hp_a76877312504b02e"}, {"text": "England is a country that is part of the United Kingdom.", "chunk_id": "a46d15f8c3fc12ac", "doc_id": "hp_c098515d47bb4e6e"}, {"text": "England is a country where Gibraltar Point national nature reserve is located.", "chunk_id": "a241395280ad7f2b", "doc_id": "hp_d424c14b2a283420"}, {"text": "A country where Lincoln and its High Street are located.", "chunk_id": "efe0b69c1de30aee", "doc_id": "hp_e27bc9001091b8b8"}, {"text": "England is a country.", "chunk_id": "71ca2b70887b01d6", "doc_id": "hp_e61b677c687681e5"}, {"text": "England is a country that is part of the United Kingdom.", "chunk_id": "ff4792dbca147fed", "doc_id": "hp_fd1eb5f63c8bb581"}]</data>
  <data key="d2">[{"text": "The final round of qualification – the Grand Prix Challenge – took place on 18 September 2009, in Coventry, England.", "chunk_id": "41d562b159afe9d1", "doc_id": "hp_025c1875e6de72c3"}, {"text": "Monty Banks Montague (15 July 1897 [registered on 18 July 1897] – 7 January 1950 born Mario Bianchi) was an Italian comedian and film director who achieved success in the United States and in England.", "chunk_id": "1e569c2aa40d90c4", "doc_id": "hp_15caf36624649b1e"}, {"text": "The Bishop's House in Birmingham, England was designed by Augustus Pugin as the residence of Thomas Walsh, the first Roman Catholic Bishop of Birmingham.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}, {"text": "The town was not taken by force and the French troops finally left peacefully under the terms of a treaty signed by Scotland, England and France.", "chunk_id": "fed038ae0c566b69", "doc_id": "hp_26004159736d7249"}, {"text": "Seacroft is a linear settlement in the East Lindsey district of Lincolnshire, England.", "chunk_id": "7547e33be5d5dab0", "doc_id": "hp_334151f118143081"}, {"text": "Notre Dame High School is a Roman Catholic secondary school and sixth form with academy status located in Norwich, England.", "chunk_id": "379e79f8fef657ef", "doc_id": "hp_33fd17055c06917a"}, {"text": "In the 1890s about 25% of the students were from other countries: 46 were from England and 23 from America.", "chunk_id": "8866c9256d91177d", "doc_id": "hp_530d45fd86f01aa0"}, {"text": "Danes Moss Nature Reserve is a 13.4 ha nature reserve south of Macclesfield, Cheshire, England.", "chunk_id": "77d9bd7c0fae6eb4", "doc_id": "hp_70aed1e36bbd2603"}, {"text": "St Philip's was built in the early 18th century in the Baroque style by Thomas Archer and is located on Colmore Row, Birmingham, England.", "chunk_id": "11a5bbb4b1c95f73", "doc_id": "hp_7986a45cdf0624b2"}, {"text": "It was founded in London, England in 1853 as The Photographic Society of London with the objective of promoting the art and science of photography, and in 1854 received Royal patronage from Queen Victoria and Prince Albert.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}, {"text": "High Street is one of the main thoroughfares and shopping areas in the city centre of Sheffield in South Yorkshire, England, located at the approximate grid reference of [ SK356874] .", "chunk_id": "7ad43fdb3c803322", "doc_id": "hp_a76877312504b02e"}, {"text": "Chelmsford Cathedral in the city of Chelmsford, Essex, England, is dedicated to St Mary the Virgin, St Peter and St Cedd.", "chunk_id": "a46d15f8c3fc12ac", "doc_id": "hp_c098515d47bb4e6e"}, {"text": "Gibraltar Point national nature reserve is an area of approximately 4.3 km2 in Lincolnshire, England.", "chunk_id": "a241395280ad7f2b", "doc_id": "hp_d424c14b2a283420"}, {"text": "The High Street of Lincoln, England, (road number B1262) is a long shopping high street.", "chunk_id": "efe0b69c1de30aee", "doc_id": "hp_e27bc9001091b8b8"}, {"text": "Darland's Lake Nature Reserve is a nature reserve south of Totteridge Village in Barnet, England.", "chunk_id": "71ca2b70887b01d6", "doc_id": "hp_e61b677c687681e5"}, {"text": "St Chad's College is a recognised (independent) college of Durham University in England, founded in 1904 as an Anglican hall for the training of Church of England clergy.", "chunk_id": "ff4792dbca147fed", "doc_id": "hp_fd1eb5f63c8bb581"}]</data>
  <data key="d3">["hp_025c1875e6de72c3", "hp_15caf36624649b1e", "hp_1c06089a0ef41f46", "hp_26004159736d7249", "hp_334151f118143081", "hp_33fd17055c06917a", "hp_530d45fd86f01aa0", "hp_70aed1e36bbd2603", "hp_7986a45cdf0624b2", "hp_a4dd7ae51691935c", "hp_a76877312504b02e", "hp_c098515d47bb4e6e", "hp_d424c14b2a283420", "hp_e27bc9001091b8b8", "hp_e61b677c687681e5", "hp_fd1eb5f63c8bb581"]</data>
  <data key="d4">False</data>
</node>
<node id="Magnus Zetterström">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The winner of the Grand Prix Challenge.", "chunk_id": "41d562b159afe9d1", "doc_id": "hp_025c1875e6de72c3"}]</data>
  <data key="d2">[{"text": "The Grand Prix Challenge was won by Magnus Zetterström who finished ahead of Chris Holder and former Grand Prix rider Jarosław Hampel.", "chunk_id": "41d562b159afe9d1", "doc_id": "hp_025c1875e6de72c3"}]</data>
  <data key="d3">["hp_025c1875e6de72c3"]</data>
  <data key="d4">False</data>
</node>
<node id="Chris Holder">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A rider who competed in the Grand Prix Challenge.", "chunk_id": "41d562b159afe9d1", "doc_id": "hp_025c1875e6de72c3"}]</data>
  <data key="d2">[{"text": "The Grand Prix Challenge was won by Magnus Zetterström who finished ahead of Chris Holder and former Grand Prix rider Jarosław Hampel.", "chunk_id": "41d562b159afe9d1", "doc_id": "hp_025c1875e6de72c3"}]</data>
  <data key="d3">["hp_025c1875e6de72c3"]</data>
