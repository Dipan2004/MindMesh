  <data key="d2">[{"text": "The May Department Stores Company was an American department store holding company, formerly headquartered in downtown St. Louis, Missouri.", "chunk_id": "7eaecb7c8ff690f9", "doc_id": "hp_537a416acef9e8ad"}]</data>
