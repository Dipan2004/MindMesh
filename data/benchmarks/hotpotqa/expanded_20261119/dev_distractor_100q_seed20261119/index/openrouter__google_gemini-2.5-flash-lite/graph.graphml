  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Bassist for Mötley Crüe.", "chunk_id": "624e18b05fcc8d7f", "doc_id": "hp_1b0a2bc66f05d3d7"}, {"text": "Bassist who co-wrote the lyrics and music for 'Hooligan's Holiday'.", "chunk_id": "c9bbbe3c308c2b93", "doc_id": "hp_b1506249f268430c"}, {"text": "Nikki Sixx was a previous member of the band Brides of Destruction, playing bass.", "chunk_id": "d7b89ee6722d4043", "doc_id": "hp_dfded5f3a8af70af"}]</data>
  <data key="d2">[{"text": "The lyrics were written by vocalist/guitarist John Corabi and bassist Nikki Sixx, while the music was written by Corabi, Sixx, drummer Tommy Lee and guitarist Mick Mars.", "chunk_id": "624e18b05fcc8d7f", "doc_id": "hp_1b0a2bc66f05d3d7"}, {"text": "The lyrics to the song were written by vocalist/rhythm guitarist John Corabi and bassist Nikki Sixx, while the music was written by Corabi, Sixx, drummer Tommy Lee and guitarist Mick Mars.", "chunk_id": "c9bbbe3c308c2b93", "doc_id": "hp_b1506249f268430c"}, {"text": "Previous members of the band were Nikki Sixx (bass), Kris Kohls (drums), Adam Hamilton (keyboard), John Corabi (rhythm guitar), Scott Sorry (bass) and Ginger (rhythm guitar).", "chunk_id": "d7b89ee6722d4043", "doc_id": "hp_dfded5f3a8af70af"}]</data>
  <data key="d3">["hp_1b0a2bc66f05d3d7", "hp_b1506249f268430c", "hp_dfded5f3a8af70af"]</data>
  <data key="d4">False</data>
</node>
