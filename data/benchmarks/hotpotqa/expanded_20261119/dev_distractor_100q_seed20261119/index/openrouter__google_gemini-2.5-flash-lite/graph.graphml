<edge source="crane" target="Kiehnmoor">
  <data key="d5">["FOUND_IN"]</data>
  <data key="d6">The crane is a rare bird that has settled in the Kiehnmoor.</data>
  <data key="d7">[{"text": "Rare birds have settled here including the crane and the black stork.", "chunk_id": "582723cb6f560140", "doc_id": "hp_5fffbcc1125c9880", "type": "FOUND_IN"}]</data>
  <data key="d8">hp_5fffbcc1125c9880</data>
