  <data key="d2">[{"text": "Lopen Karma Phuntsho (born 1968?) was born in Ura gewog in the Bumthang district of central Bhutan.", "chunk_id": "a871fb84038a99a1", "doc_id": "hp_e30d91b396b0e3e8"}]</data>
  <data key="d3">["hp_e30d91b396b0e3e8"]</data>
