<node id="trench warfare">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A type of warfare characterized by dug-in defensive lines, which caused a tactical stalemate during World War I.", "chunk_id": "b344f42adf99d038", "doc_id": "hp_831bc66834df032a"}]</data>
  <data key="d2">[{"text": "Over nine million combatants and seven million civilians died as a result of the war (including the victims of a number of genocides), a casualty rate exacerbated by the belligerents' technological and industrial sophistication, and the tactical stalemate caused by gruelling trench warfare.", "chunk_id": "b344f42adf99d038", "doc_id": "hp_831bc66834df032a"}]</data>
  <data key="d3">["hp_831bc66834df032a"]</data>
  <data key="d4">False</data>
</node>
