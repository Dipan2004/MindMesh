<node id="Sugar Ray">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A band that released a self-titled fourth studio album.", "chunk_id": "2b0c2ab47deb6703", "doc_id": "hp_0af4358e100679ad"}, {"text": "An American rock band.", "chunk_id": "c2fab40cef72276e", "doc_id": "hp_1826a58de10298d3"}, {"text": "An American rock band.", "chunk_id": "8bcb056d4d4cad5f", "doc_id": "hp_3b83bf76ed88c6b4"}, {"text": "A rock band that released the song \"Someday\".", "chunk_id": "d2de0918bf1b22b8", "doc_id": "hp_482e2d8f73f605ee"}, {"text": "Sugar Ray is an American rock band.", "chunk_id": "8cd652904b229d0e", "doc_id": "hp_4ed856daf788c853"}, {"text": "An American rock band formed in 1986.", "chunk_id": "ca10670f4e9a955b", "doc_id": "hp_5682f3a022ba8ac2"}, {"text": "An American rock band.", "chunk_id": "a83c783458cb120f", "doc_id": "hp_767039256bd5743c"}, {"text": "An American rock band.", "chunk_id": "349853336eca2d3b", "doc_id": "hp_83c086e4312cda99"}, {"text": "An American rock band.", "chunk_id": "ea9f0bb2bf44b926", "doc_id": "hp_f61e6f2275345f39"}, {"text": "The self-titled fourth album by the American rock band Sugar Ray.", "chunk_id": "ea9f0bb2bf44b926", "doc_id": "hp_f61e6f2275345f39"}]</data>
  <data key="d2">[{"text": "Sugar Ray is the self-titled fourth studio album by the band Sugar Ray.", "chunk_id": "2b0c2ab47deb6703", "doc_id": "hp_0af4358e100679ad"}, {"text": "\"Falls Apart\" is a song by American rock band Sugar Ray from their album \"\".", "chunk_id": "c2fab40cef72276e", "doc_id": "hp_1826a58de10298d3"}, {"text": "\"Fly\" is a song by American rock band Sugar Ray.", "chunk_id": "8bcb056d4d4cad5f", "doc_id": "hp_3b83bf76ed88c6b4"}, {"text": "\"Someday\"(1999) is a single from the rock band Sugar Ray from their third album \"\".", "chunk_id": "d2de0918bf1b22b8", "doc_id": "hp_482e2d8f73f605ee"}, {"text": "Floored is the second studio album by American rock band Sugar Ray, released on June 24, 1997.", "chunk_id": "8cd652904b229d0e", "doc_id": "hp_4ed856daf788c853"}, {"text": "Sugar Ray is an American rock band formed in 1986.", "chunk_id": "ca10670f4e9a955b", "doc_id": "hp_5682f3a022ba8ac2"}, {"text": "14:59 is the third studio album by American rock band Sugar Ray, released on January 12, 1999.", "chunk_id": "a83c783458cb120f", "doc_id": "hp_767039256bd5743c"}, {"text": "Lemonade and Brownies is the debut studio album by the American rock band Sugar Ray.", "chunk_id": "349853336eca2d3b", "doc_id": "hp_83c086e4312cda99"}, {"text": "\"When It's Over\" is a song by American rock band Sugar Ray and it was released in May 2001 as the lead single from their self-titled fourth album \"Sugar Ray\".", "chunk_id": "ea9f0bb2bf44b926", "doc_id": "hp_f61e6f2275345f39"}, {"text": "\"When It's Over\" is a song by American rock band Sugar Ray and it was released in May 2001 as the lead single from their self-titled fourth album \"Sugar Ray\".", "chunk_id": "ea9f0bb2bf44b926", "doc_id": "hp_f61e6f2275345f39"}]</data>
  <data key="d3">["hp_0af4358e100679ad", "hp_1826a58de10298d3", "hp_3b83bf76ed88c6b4", "hp_482e2d8f73f605ee", "hp_4ed856daf788c853", "hp_5682f3a022ba8ac2", "hp_767039256bd5743c", "hp_83c086e4312cda99", "hp_f61e6f2275345f39"]</data>
  <data key="d4">False</data>
</node>
<node id="June 12, 2001">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The release date of the album Sugar Ray.", "chunk_id": "2b0c2ab47deb6703", "doc_id": "hp_0af4358e100679ad"}]</data>
  <data key="d2">[{"text": "The album was released on June 12, 2001, and debuted at number 6 on the \"Billboard\" 200 chart,&lt;ref name=\"sugar ray/billboard\"&gt; &lt;/ref&gt; and eventually went gold.", "chunk_id": "2b0c2ab47deb6703", "doc_id": "hp_0af4358e100679ad"}]</data>
  <data key="d3">["hp_0af4358e100679ad"]</data>
  <data key="d4">False</data>
</node>
<node id="Billboard 200">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A music chart that the album Sugar Ray debuted on.", "chunk_id": "2b0c2ab47deb6703", "doc_id": "hp_0af4358e100679ad"}, {"text": "A music chart that ranks the popularity of songs and albums in the United States.", "chunk_id": "a83c783458cb120f", "doc_id": "hp_767039256bd5743c"}, {"text": "A music chart that the album Black Gives Way to Blue debuted at No. 5 on.", "chunk_id": "a02521ae2928a8dd", "doc_id": "hp_7e9f73906e63aaa8"}]</data>
  <data key="d2">[{"text": "The album was released on June 12, 2001, and debuted at number 6 on the \"Billboard\" 200 chart,&lt;ref name=\"sugar ray/billboard\"&gt; &lt;/ref&gt; and eventually went gold.", "chunk_id": "2b0c2ab47deb6703", "doc_id": "hp_0af4358e100679ad"}, {"text": "It entered the top 20 on the \"Billboard\" 200, peaking at number 17&lt;ref name=\"1459/billboard\"&gt; &lt;/ref&gt; and certified triple-platinum by the RIAA.", "chunk_id": "a83c783458cb120f", "doc_id": "hp_767039256bd5743c"}, {"text": "The album debuted at No. 5 on the \"Billboard\" 200, and was certified gold by the RIAA on May 26, 2010, with shipments exceeding 500,000 copies and has sold 1 million copies worldwide.", "chunk_id": "a02521ae2928a8dd", "doc_id": "hp_7e9f73906e63aaa8"}]</data>
  <data key="d3">["hp_0af4358e100679ad", "hp_767039256bd5743c", "hp_7e9f73906e63aaa8"]</data>
  <data key="d4">False</data>
</node>
<node id="When It's Over">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The first single from the album Sugar Ray.", "chunk_id": "2b0c2ab47deb6703", "doc_id": "hp_0af4358e100679ad"}, {"text": "A hit song by Sugar Ray from their self-titled album.", "chunk_id": "ca10670f4e9a955b", "doc_id": "hp_5682f3a022ba8ac2"}, {"text": "A song by the American rock band Sugar Ray.", "chunk_id": "ea9f0bb2bf44b926", "doc_id": "hp_f61e6f2275345f39"}]</data>
  <data key="d2">[{"text": "The album's first single, \"When It's Over\", performed well on pop and rock charts as well.", "chunk_id": "2b0c2ab47deb6703", "doc_id": "hp_0af4358e100679ad"}, {"text": "Subsequent albums shared this style, and the band landed a number of hits with \"Every Morning\" and \"Someday\" from \"\" and \"When It's Over\" from their self-titled album.", "chunk_id": "ca10670f4e9a955b", "doc_id": "hp_5682f3a022ba8ac2"}, {"text": "\"When It's Over\" is a song by American rock band Sugar Ray and it was released in May 2001 as the lead single from their self-titled fourth album \"Sugar Ray\".", "chunk_id": "ea9f0bb2bf44b926", "doc_id": "hp_f61e6f2275345f39"}]</data>
  <data key="d3">["hp_0af4358e100679ad", "hp_5682f3a022ba8ac2", "hp_f61e6f2275345f39"]</data>
  <data key="d4">False</data>
</node>
