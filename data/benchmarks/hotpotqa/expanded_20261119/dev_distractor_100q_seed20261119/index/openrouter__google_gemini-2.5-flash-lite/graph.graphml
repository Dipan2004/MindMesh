  <data key="d2">[{"text": "She is the daughter of professional wrestler Gran Hamada, the sister of wrestler Ayako Hamada and the sister-in-law of Tiger Mask IV.", "chunk_id": "beab562ef9fe8887", "doc_id": "hp_e53c480ef8a45aab"}]</data>
