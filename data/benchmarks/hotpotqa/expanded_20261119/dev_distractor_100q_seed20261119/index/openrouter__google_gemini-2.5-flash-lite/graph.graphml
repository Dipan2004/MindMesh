  <data key="d2">[{"text": "Plant City Airport (ICAO: KPCM, FAA LID: PCM) is a public-use airport located two nautical miles (4 km) southwest of the central business district of Plant City in Hillsborough County, Florida, United States.", "chunk_id": "47b19fbaa70c2777", "doc_id": "hp_357ddba773097c91"}]</data>
