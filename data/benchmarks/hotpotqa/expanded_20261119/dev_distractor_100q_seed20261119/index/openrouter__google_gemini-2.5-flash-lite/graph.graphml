<node id="Sino-Tibetan languages">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A family of more than 400 languages spoken in East Asia, Southeast Asia and South Asia.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d2">[{"text": "The Sino-Tibetan languages, in a few sources also known as Tibeto-Burman or Trans-Himalayan, are a family of more than 400 languages spoken in East Asia, Southeast Asia and South Asia.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d3">["hp_b4175e524ae4a823"]</data>
  <data key="d4">False</data>
</node>
<node id="Tibeto-Burman">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "An alternative name for the Sino-Tibetan languages.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d2">[{"text": "The Sino-Tibetan languages, in a few sources also known as Tibeto-Burman or Trans-Himalayan, are a family of more than 400 languages spoken in East Asia, Southeast Asia and South Asia.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d3">["hp_b4175e524ae4a823"]</data>
  <data key="d4">False</data>
</node>
<node id="Trans-Himalayan">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "An alternative name for the Sino-Tibetan languages.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d2">[{"text": "The Sino-Tibetan languages, in a few sources also known as Tibeto-Burman or Trans-Himalayan, are a family of more than 400 languages spoken in East Asia, Southeast Asia and South Asia.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d3">["hp_b4175e524ae4a823"]</data>
  <data key="d4">False</data>
</node>
<node id="Indo-European">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A language family that is larger than Sino-Tibetan in terms of native speakers.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d2">[{"text": "The family is second only to Indo-European in terms of the number of native speakers.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d3">["hp_b4175e524ae4a823"]</data>
  <data key="d4">False</data>
</node>
<node id="Chinese">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A variety of Sino-Tibetan languages with the most native speakers.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d2">[{"text": "The Sino-Tibetan languages with the most native speakers are the varieties of Chinese (1.3 billion speakers, the most of any language on Earth if counted as a single language), Burmese (33 million), and the Tibetic languages (8 million); but many Sino-Tibetan languages are spoken by small communities in remote mountain areas and as such are poorly documented.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d3">["hp_b4175e524ae4a823"]</data>
  <data key="d4">False</data>
</node>
<node id="Burmese">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A Sino-Tibetan language with 33 million native speakers.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d2">[{"text": "The Sino-Tibetan languages with the most native speakers are the varieties of Chinese (1.3 billion speakers, the most of any language on Earth if counted as a single language), Burmese (33 million), and the Tibetic languages (8 million); but many Sino-Tibetan languages are spoken by small communities in remote mountain areas and as such are poorly documented.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d3">["hp_b4175e524ae4a823"]</data>
  <data key="d4">False</data>
</node>
<node id="Tibetic languages">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A group of Sino-Tibetan languages with 8 million native speakers.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d2">[{"text": "The Sino-Tibetan languages with the most native speakers are the varieties of Chinese (1.3 billion speakers, the most of any language on Earth if counted as a single language), Burmese (33 million), and the Tibetic languages (8 million); but many Sino-Tibetan languages are spoken by small communities in remote mountain areas and as such are poorly documented.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}]</data>
  <data key="d3">["hp_b4175e524ae4a823"]</data>
  <data key="d4">False</data>
</node>
