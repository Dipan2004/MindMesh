  <data key="d6">HMS "Havelock" defended Convoy TM 1.</data>
  <data key="d7">[{"text": "The convoy was defended by the destroyer HMS \"Havelock\", and three Flower class corvettes, HMS \"Godetia\" , HMS \"Pimpernel\" and HMS \"Saxifrage\".", "chunk_id": "c88e8c3532f53397", "doc_id": "hp_1ac7b848b0417759", "type": "DEFENDED"}]</data>
