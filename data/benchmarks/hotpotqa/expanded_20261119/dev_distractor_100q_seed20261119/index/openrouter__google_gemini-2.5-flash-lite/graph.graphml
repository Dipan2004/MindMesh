<node id="Nation and Destiny">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A 62-part North Korean film series released between 1992 and 2002.", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882"}]</data>
  <data key="d2">[{"text": "Nation and Destiny (Chosŏn'gŭl: 민족과 운명 ; MR: \"Minjokgwa ummyeong \" ) is a 62-part North Korean film series released between 1992 and 2002.", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882"}]</data>
  <data key="d3">["hp_d64aea307fb47882"]</data>
  <data key="d4">False</data>
</node>
<node id="Korean people">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The people of Korea, who are depicted in the film series as living a glorious life in the bosom of the Great Leader and socialist fatherland.", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882"}]</data>
  <data key="d2">[{"text": "It aims to show that the Korean people \"can live a glorious life only in the bosom of the Great Leader and socialist fatherland\".", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882"}]</data>
  <data key="d3">["hp_d64aea307fb47882"]</data>
  <data key="d4">False</data>
</node>
<node id="Great Leader">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A title referring to a supreme leader, likely Kim Jong-Il in this context, under whom the Korean people can live a glorious life.", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882"}]</data>
  <data key="d2">[{"text": "It aims to show that the Korean people \"can live a glorious life only in the bosom of the Great Leader and socialist fatherland\".", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882"}]</data>
  <data key="d3">["hp_d64aea307fb47882"]</data>
  <data key="d4">False</data>
</node>
<node id="socialist fatherland">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A nation or homeland that adheres to socialist principles, where the Korean people can live a glorious life.", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882"}]</data>
  <data key="d2">[{"text": "It aims to show that the Korean people \"can live a glorious life only in the bosom of the Great Leader and socialist fatherland\".", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882"}]</data>
  <data key="d3">["hp_d64aea307fb47882"]</data>
  <data key="d4">False</data>
</node>
<node id="North Korean media">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The media outlets of North Korea, which heavily promoted and eulogized the film series.", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882"}]</data>
  <data key="d2">[{"text": "Initially, the most senior writers, directors and actors were involved in the project and it was heavily promoted and eulogized by the North Korean media.", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882"}]</data>
  <data key="d3">["hp_d64aea307fb47882"]</data>
  <data key="d4">False</data>
</node>
<node id="You Keep Me Hangin' On">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A 1966 song written and composed by Holland–Dozier–Holland.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c"}]</data>
  <data key="d2">[{"text": "\"You Keep Me Hangin' On\" is a 1966 song written and composed by Holland–Dozier–Holland.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c"}]</data>
  <data key="d3">["hp_d679581e3707876c"]</data>
  <data key="d4">False</data>
</node>
<node id="Holland–Dozier–Holland">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The songwriters who wrote and composed the song \"You Keep Me Hangin' On\".", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c"}]</data>
  <data key="d2">[{"text": "\"You Keep Me Hangin' On\" is a 1966 song written and composed by Holland–Dozier–Holland.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c"}]</data>
  <data key="d3">["hp_d679581e3707876c"]</data>
  <data key="d4">False</data>
</node>
<node id="The Supremes">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An American Motown group that had a number one hit with the song \"You Keep Me Hangin' On\" in 1966.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c"}]</data>
  <data key="d2">[{"text": "It first became a popular \"Billboard\" Hot 100 number one hit for the American Motown group The Supremes in late 1966.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c"}]</data>
  <data key="d3">["hp_d679581e3707876c"]</data>
  <data key="d4">False</data>
</node>
<node id="Vanilla Fudge">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A rock band that covered the song \"You Keep Me Hangin' On\" a year after its original release.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c"}]</data>
  <data key="d2">[{"text": "The rock band Vanilla Fudge covered the song a year later and had a top ten hit with their version.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c"}]</data>
  <data key="d3">["hp_d679581e3707876c"]</data>
  <data key="d4">False</data>
</node>
<node id="Kim Wilde">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A British pop singer who covered \"You Keep Me Hangin' On\" in 1986.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c"}]</data>
  <data key="d2">[{"text": "British pop singer Kim Wilde covered \"You Keep Me Hangin' On\" in 1986, bumping it back to number one on the \"Billboard\" Hot 100 in June 1987.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c"}]</data>
  <data key="d3">["hp_d679581e3707876c"]</data>
  <data key="d4">False</data>
</node>
<node id="Reba McEntire">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A country music singer whose version of \"You Keep Me Hangin' On\" reached number 2 on the US \"Billboard\" Hot Dance Club Play chart in 1996.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c"}]</data>
  <data key="d2">[{"text": "In 1996, country music singer Reba McEntire's version reached number 2 on the US \"Billboard\" Hot Dance Club Play chart.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c"}]</data>
  <data key="d3">["hp_d679581e3707876c"]</data>
  <data key="d4">False</data>
</node>
<node id="Billboard Hot Dance Club Play">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A music chart that ranks songs based on popularity in dance clubs.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c"}]</data>
  <data key="d2">[{"text": "In 1996, country music singer Reba McEntire's version reached number 2 on the US \"Billboard\" Hot Dance Club Play chart.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c"}]</data>
  <data key="d3">["hp_d679581e3707876c"]</data>
  <data key="d4">False</data>
</node>
