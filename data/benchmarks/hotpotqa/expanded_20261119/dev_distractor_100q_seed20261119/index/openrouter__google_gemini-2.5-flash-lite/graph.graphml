</node>
<node id="British dominions">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Territories formerly part of the British Empire.", "chunk_id": "539ff347cbaa67c2", "doc_id": "hp_4ff036de49247657"}]</data>
  <data key="d2">[{"text": "It has been open in the past to riders from British dominions and was dominated in its early years by riders from New Zealand such as Barry Briggs and Ivan Mauger this was due to the fact that the British Final formed part of the World Individual Speedway championship qualifying rounds.", "chunk_id": "539ff347cbaa67c2", "doc_id": "hp_4ff036de49247657"}]</data>
  <data key="d3">["hp_4ff036de49247657"]</data>
