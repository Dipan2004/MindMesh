<edge source="Tikkun" target="Berkeley, California">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">"Tikkun" magazine is based in Berkeley, California.</data>
  <data key="d7">[{"text": "Michael Lerner (born 1943) is an American political activist, the editor of \"Tikkun\", a progressive Jewish interfaith magazine based in Berkeley, California, and the rabbi of Beyt Tikkun Synagogue in Berkeley.", "chunk_id": "b15598f798e631b6", "doc_id": "hp_ebb527a8921b04b5", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_ebb527a8921b04b5</data>
</edge>
<edge source="Tikkun" target="United States">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">Tikkun magazine is published in the United States.</data>
  <data key="d7">[{"text": "Tikkun is a quarterly interfaith Jewish left-progressive magazine, published in the United States, that analyzes American and Israeli culture, politics, religion, and history in the English language.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_f15a13a6272383b1</data>
</edge>
<edge source="Tikkun" target="Michael Lerner">
  <data key="d5">["FOUNDED_BY"]</data>
  <data key="d6">Michael Lerner founded Tikkun magazine.</data>
  <data key="d7">[{"text": "The magazine was founded in 1986 by Michael Lerner and his then-wife Nan Fink Gefen.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1", "type": "FOUNDED_BY"}]</data>
  <data key="d8">hp_f15a13a6272383b1</data>
</edge>
<edge source="Tikkun" target="Nan Fink Gefen">
  <data key="d5">["FOUNDED_BY"]</data>
  <data key="d6">Nan Fink Gefen co-founded Tikkun magazine.</data>
  <data key="d7">[{"text": "The magazine was founded in 1986 by Michael Lerner and his then-wife Nan Fink Gefen.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1", "type": "FOUNDED_BY"}]</data>
  <data key="d8">hp_f15a13a6272383b1</data>
</edge>
<edge source="Tikkun" target="Duke University Press">
  <data key="d5">["PUBLISHED_BY"]</data>
  <data key="d6">Duke University Press publishes Tikkun magazine.</data>
  <data key="d7">[{"text": "Since 2012, its publisher is Duke University Press.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1", "type": "PUBLISHED_BY"}]</data>
  <data key="d8">hp_f15a13a6272383b1</data>
</edge>
<edge source="Tikkun" target="Utne Reader">
  <data key="d5">["AWARDED_BY"]</data>
  <data key="d6">Tikkun magazine was awarded by Utne Reader.</data>
  <data key="d7">[{"text": "In 2006 and 2011, the magazine was awarded the \"Independent Press Award for Best Spiritual Coverage\" by \"Utne Reader\" for its analysis of the inability of many progressives to understand people's yearning for faith, and the American fundamentalists' political influence on the international conflict among religious zealots.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1", "type": "AWARDED_BY"}]</data>
  <data key="d8">hp_f15a13a6272383b1</data>
</edge>
