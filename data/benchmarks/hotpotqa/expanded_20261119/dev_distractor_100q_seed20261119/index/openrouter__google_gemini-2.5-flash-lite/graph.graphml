  <data key="d6">Michael Jackson is associated with the album "Michael Jackson's This Is It".</data>
  <data key="d7">[{"text": "Michael Jackson's This Is It (album)", "chunk_id": "f1142eb95496f6b8", "doc_id": "hp_19aa948e90d5a7f6", "type": "OWNED_BY"}, {"text": "Released by MJJ Music on October 26, 2009, \"This Is It\" features previously released music, as well as six previously unreleased recordings by Michael Jackson.", "chunk_id": "f1142eb95496f6b8", "doc_id": "hp_19aa948e90d5a7f6", "type": "PERFORMED_ON"}]</data>
  <data key="d8">hp_19aa948e90d5a7f6</data>
