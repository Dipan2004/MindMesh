</node>
<node id="Westwood Historical Society">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An organization that has restored the Fisher School (District #9 School).", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d2">[{"text": "Prominent in the district is the First Baptist Church, which was built near its present location in 1809 using timbers from an earlier 1731 meeting house, and the 1845 Greek Revival District #9 School, also known as the Fisher School, which has been restored by the Westwood Historical Society.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
