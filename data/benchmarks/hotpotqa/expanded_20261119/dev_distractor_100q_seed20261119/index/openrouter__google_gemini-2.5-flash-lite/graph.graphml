  <data key="d6">Michael Jackson is associated with the album "This Is It".</data>
  <data key="d7">[{"text": "Michael Jackson's This Is It (or simply This Is It) is a posthumous two-disc soundtrack album by American singer Michael Jackson.", "chunk_id": "f1142eb95496f6b8", "doc_id": "hp_19aa948e90d5a7f6", "type": "OWNED_BY"}]</data>
  <data key="d8">hp_19aa948e90d5a7f6</data>
