<edge source="Fly" target="Sugar Ray">
  <data key="d5">["PERFORMED_BY"]</data>
  <data key="d6">The song "Fly" was performed by the band Sugar Ray.</data>
  <data key="d7">[{"text": "\"Fly\" is a song by American rock band Sugar Ray.", "chunk_id": "8bcb056d4d4cad5f", "doc_id": "hp_3b83bf76ed88c6b4", "type": "PERFORMED_BY"}]</data>
  <data key="d8">hp_3b83bf76ed88c6b4</data>
