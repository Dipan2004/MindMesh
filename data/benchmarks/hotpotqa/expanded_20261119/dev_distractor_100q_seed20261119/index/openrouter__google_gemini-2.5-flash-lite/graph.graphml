  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A musical group associated with the arrangement of the song \"Beautiful Brown Eyes\".", "chunk_id": "f73ede2e8ae064dc", "doc_id": "hp_7000ff84f5efb48f"}]</data>
  <data key="d2">[{"text": "\"Beautiful Brown Eyes\" is a traditional country song arranged by Fiddlin' Arthur Smith &amp; Alton Delmore of The Delmore Brothers in 1951.", "chunk_id": "f73ede2e8ae064dc", "doc_id": "hp_7000ff84f5efb48f"}]</data>
  <data key="d3">["hp_7000ff84f5efb48f"]</data>
  <data key="d4">False</data>
</node>
<node id="Penrose process">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The Penrose process is a process theorised by Roger Penrose wherein energy can be extracted from a rotating black hole.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "The Penrose process (also called Penrose mechanism) is a process theorised by Roger Penrose wherein energy can be extracted from a rotating black hole.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="Penrose mechanism">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The Penrose mechanism is another name for the Penrose process, which is a process theorised by Roger Penrose wherein energy can be extracted from a rotating black hole.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "The Penrose process (also called Penrose mechanism) is a process theorised by Roger Penrose wherein energy can be extracted from a rotating black hole.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="Roger Penrose">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Roger Penrose is the person who theorised the Penrose process.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "The Penrose process (also called Penrose mechanism) is a process theorised by Roger Penrose wherein energy can be extracted from a rotating black hole.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="event horizon">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The event horizon is the boundary around a black hole beyond which nothing can escape.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}, {"text": "The boundary in spacetime beyond which events cannot affect an outside observer.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3"}, {"text": "The boundary around a black hole beyond which nothing can escape.", "chunk_id": "e1493fe4a7e31d6c", "doc_id": "hp_e09ae53df97c48d0"}]</data>
  <data key="d2">[{"text": "That extraction is made possible because the rotational energy of the black hole is located not inside the event horizon of the black hole, but on the outside of it in a region of the Kerr spacetime called the ergosphere, a region in which a particle is necessarily propelled in locomotive concurrence with the rotating spacetime.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}, {"text": "It models a black hole as a thin, classically radiating surface (or membrane) at or vanishingly close to the black hole's event horizon.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3"}, {"text": "The ergosphere touches the event horizon at the poles of a rotating black hole and extends to a greater radius at the equator.", "chunk_id": "e1493fe4a7e31d6c", "doc_id": "hp_e09ae53df97c48d0"}]</data>
  <data key="d3">["hp_704af24e111af685", "hp_b71363459a2e11a3", "hp_e09ae53df97c48d0"]</data>
  <data key="d4">False</data>
</node>
<node id="Kerr spacetime">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Kerr spacetime is a region associated with a rotating black hole where the ergosphere is located.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "That extraction is made possible because the rotational energy of the black hole is located not inside the event horizon of the black hole, but on the outside of it in a region of the Kerr spacetime called the ergosphere, a region in which a particle is necessarily propelled in locomotive concurrence with the rotating spacetime.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="ergosphere">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The ergosphere is a region within the Kerr spacetime, outside the event horizon of a rotating black hole, where particles are necessarily propelled in concurrence with the rotating spacetime.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}, {"text": "A region located outside a rotating black hole's outer event horizon.", "chunk_id": "e1493fe4a7e31d6c", "doc_id": "hp_e09ae53df97c48d0"}]</data>
  <data key="d2">[{"text": "That extraction is made possible because the rotational energy of the black hole is located not inside the event horizon of the black hole, but on the outside of it in a region of the Kerr spacetime called the ergosphere, a region in which a particle is necessarily propelled in locomotive concurrence with the rotating spacetime.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}, {"text": "The ergosphere is a region located outside a rotating black hole's outer event horizon.", "chunk_id": "e1493fe4a7e31d6c", "doc_id": "hp_e09ae53df97c48d0"}]</data>
  <data key="d3">["hp_704af24e111af685", "hp_e09ae53df97c48d0"]</data>
  <data key="d4">False</data>
</node>
<node id="rotating spacetime">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Rotating spacetime refers to the spacetime of a rotating black hole, which drags objects within the ergosphere.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "All objects in the ergosphere become dragged by a rotating spacetime.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="lump of matter">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A lump of matter is an object that enters the ergosphere of a black hole and is split into two parts during the Penrose process.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "In the process, a lump of matter enters into the ergosphere of the black hole, and once it enters the ergosphere, it is forcibly split into two parts.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="two parts">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The lump of matter is split into two parts within the ergosphere, one of which escapes and the other falls into the black hole.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "In the process, a lump of matter enters into the ergosphere of the black hole, and once it enters the ergosphere, it is forcibly split into two parts.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="explosive or rocket">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "An explosive or rocket can be used to separate the two parts of the lump of matter after it enters the ergosphere.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "For example, the matter might be made of two parts that separate by firing an explosive or rocket which pushes its halves apart.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="momentum">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Momentum is a conserved quantity in the Penrose process, referring to the quantity of motion of the two separated pieces of matter.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "The momentum of the two pieces of matter when they separate can be arranged so that one piece escapes from the black hole (it \"escapes to infinity\"), whilst the other falls past the event horizon into the black hole.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="escaping piece of matter">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The escaping piece of matter is one of the two parts that results from the splitting of the original lump of matter, and it can be made to have greater mass-energy than the original piece.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "With careful arrangement, the escaping piece of matter can be made to have greater mass-energy than the original piece of matter, and the infalling piece has negative mass-energy.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="original piece of matter">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The original piece of matter is the lump of matter that initially enters the ergosphere and is split into two parts.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "With careful arrangement, the escaping piece of matter can be made to have greater mass-energy than the original piece of matter, and the infalling piece has negative mass-energy.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="infalling piece">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The infalling piece is one of the two parts that results from the splitting of the original lump of matter, and it has negative mass-energy.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "With careful arrangement, the escaping piece of matter can be made to have greater mass-energy than the original piece of matter, and the infalling piece has negative mass-energy.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="negative mass-energy">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Negative mass-energy is a property possessed by the infalling piece of matter in the Penrose process.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "With careful arrangement, the escaping piece of matter can be made to have greater mass-energy than the original piece of matter, and the infalling piece has negative mass-energy.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="angular momentum">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Angular momentum is a property of the black hole that decreases slightly as a result of the Penrose process, corresponding to energy transference.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "In summary, the process results in a slight decrease in the angular momentum of the black hole, which corresponds to a transference of energy to the matter.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="energy">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Energy is extracted from a rotating black hole via the Penrose process, with the difference being provided by the black hole itself.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d2">[{"text": "In summary, the process results in a slight decrease in the angular momentum of the black hole, which corresponds to a transference of energy to the matter.", "chunk_id": "23b2ee36b2a2b6a0", "doc_id": "hp_704af24e111af685"}]</data>
  <data key="d3">["hp_704af24e111af685"]</data>
  <data key="d4">False</data>
</node>
<node id="Camel">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A camel is an even-toed ungulate in the genus Camelus, bearing distinctive fatty deposits known as \"humps\" on its back.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d2">[{"text": "A camel is an even-toed ungulate in the genus Camelus, bearing distinctive fatty deposits known as \"humps\" on its back.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d3">["hp_706e5d69c6cb6d2b"]</data>
  <data key="d4">False</data>
</node>
<node id="Camelus">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Camelus is the genus to which camels belong.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d2">[{"text": "A camel is an even-toed ungulate in the genus Camelus, bearing distinctive fatty deposits known as \"humps\" on its back.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d3">["hp_706e5d69c6cb6d2b"]</data>
  <data key="d4">False</data>
</node>
<node id="dromedary">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The dromedary is a species of camel with one hump, inhabiting the Middle East and the Horn of Africa.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d2">[{"text": "The three surviving species of camel are the dromedary, or one-humped camel (\"C. dromedarius\"), which inhabits the Middle East and the Horn of Africa; the Bactrian, or two-humped camel (\"C. bactrianus\"), which inhabits Central Asia; and the critically endangered wild Bactrian camel (\"C. ferus\") that has limited populations in remote areas of northwest China and Mongolia.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d3">["hp_706e5d69c6cb6d2b"]</data>
  <data key="d4">False</data>
</node>
<node id="C. dromedarius">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "C. dromedarius is the scientific name for the dromedary, a one-humped camel.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d2">[{"text": "The three surviving species of camel are the dromedary, or one-humped camel (\"C. dromedarius\"), which inhabits the Middle East and the Horn of Africa; the Bactrian, or two-humped camel (\"C. bactrianus\"), which inhabits Central Asia; and the critically endangered wild Bactrian camel (\"C. ferus\") that has limited populations in remote areas of northwest China and Mongolia.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d3">["hp_706e5d69c6cb6d2b"]</data>
  <data key="d4">False</data>
</node>
<node id="Middle East">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Middle East is a region inhabited by the dromedary camel.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d2">[{"text": "The three surviving species of camel are the dromedary, or one-humped camel (\"C. dromedarius\"), which inhabits the Middle East and the Horn of Africa; the Bactrian, or two-humped camel (\"C. bactrianus\"), which inhabits Central Asia; and the critically endangered wild Bactrian camel (\"C. ferus\") that has limited populations in remote areas of northwest China and Mongolia.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d3">["hp_706e5d69c6cb6d2b"]</data>
  <data key="d4">False</data>
</node>
<node id="Horn of Africa">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Horn of Africa is a region inhabited by the dromedary camel.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d2">[{"text": "The three surviving species of camel are the dromedary, or one-humped camel (\"C. dromedarius\"), which inhabits the Middle East and the Horn of Africa; the Bactrian, or two-humped camel (\"C. bactrianus\"), which inhabits Central Asia; and the critically endangered wild Bactrian camel (\"C. ferus\") that has limited populations in remote areas of northwest China and Mongolia.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d3">["hp_706e5d69c6cb6d2b"]</data>
  <data key="d4">False</data>
</node>
<node id="Bactrian">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Bactrian is a species of camel with two humps, inhabiting Central Asia.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d2">[{"text": "The three surviving species of camel are the dromedary, or one-humped camel (\"C. dromedarius\"), which inhabits the Middle East and the Horn of Africa; the Bactrian, or two-humped camel (\"C. bactrianus\"), which inhabits Central Asia; and the critically endangered wild Bactrian camel (\"C. ferus\") that has limited populations in remote areas of northwest China and Mongolia.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d3">["hp_706e5d69c6cb6d2b"]</data>
  <data key="d4">False</data>
</node>
<node id="C. bactrianus">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "C. bactrianus is the scientific name for the Bactrian camel, a two-humped camel.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d2">[{"text": "The three surviving species of camel are the dromedary, or one-humped camel (\"C. dromedarius\"), which inhabits the Middle East and the Horn of Africa; the Bactrian, or two-humped camel (\"C. bactrianus\"), which inhabits Central Asia; and the critically endangered wild Bactrian camel (\"C. ferus\") that has limited populations in remote areas of northwest China and Mongolia.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d3">["hp_706e5d69c6cb6d2b"]</data>
  <data key="d4">False</data>
</node>
<node id="Central Asia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Central Asia is a region inhabited by the Bactrian camel.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d2">[{"text": "The three surviving species of camel are the dromedary, or one-humped camel (\"C. dromedarius\"), which inhabits the Middle East and the Horn of Africa; the Bactrian, or two-humped camel (\"C. bactrianus\"), which inhabits Central Asia; and the critically endangered wild Bactrian camel (\"C. ferus\") that has limited populations in remote areas of northwest China and Mongolia.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d3">["hp_706e5d69c6cb6d2b"]</data>
  <data key="d4">False</data>
</node>
<node id="C. ferus">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "C. ferus is the scientific name for the critically endangered wild Bactrian camel.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d2">[{"text": "The three surviving species of camel are the dromedary, or one-humped camel (\"C. dromedarius\"), which inhabits the Middle East and the Horn of Africa; the Bactrian, or two-humped camel (\"C. bactrianus\"), which inhabits Central Asia; and the critically endangered wild Bactrian camel (\"C. ferus\") that has limited populations in remote areas of northwest China and Mongolia.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d3">["hp_706e5d69c6cb6d2b"]</data>
  <data key="d4">False</data>
</node>
<node id="northwest China">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Northwest China is an area with limited populations of the wild Bactrian camel.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d2">[{"text": "The three surviving species of camel are the dromedary, or one-humped camel (\"C. dromedarius\"), which inhabits the Middle East and the Horn of Africa; the Bactrian, or two-humped camel (\"C. bactrianus\"), which inhabits Central Asia; and the critically endangered wild Bactrian camel (\"C. ferus\") that has limited populations in remote areas of northwest China and Mongolia.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d3">["hp_706e5d69c6cb6d2b"]</data>
  <data key="d4">False</data>
</node>
<node id="Bactria">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Bactria is a historical region in Central Asia from which Bactrian camels take their name.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d2">[{"text": "Bactrian camels take their name from the historical Bactria region of Central Asia (Yam &amp; Khomeiri, 2015).", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b"}]</data>
  <data key="d3">["hp_706e5d69c6cb6d2b"]</data>
  <data key="d4">False</data>
</node>
<node id="Library technician">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A library technician is a skilled library and information professional trained to perform the day-to-day functions of a library.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "A library technician or library assistant is a skilled library and information professional trained to perform the day-to-day functions of a library, and assists librarians in the acquisition, preparation, and organization of information.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="Library assistant">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A library assistant is a skilled library and information professional trained to perform the day-to-day functions of a library.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "A library technician or library assistant is a skilled library and information professional trained to perform the day-to-day functions of a library, and assists librarians in the acquisition, preparation, and organization of information.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="Librarians">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Librarians are professionals who assist library technicians in the acquisition, preparation, and organization of information.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "A library technician or library assistant is a skilled library and information professional trained to perform the day-to-day functions of a library, and assists librarians in the acquisition, preparation, and organization of information.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="Library patrons">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Library patrons are individuals who seek information from libraries.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "They also assist library patrons in finding information.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="Computerized information storage and retrieval systems">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "These systems are used for storing and retrieving information in a computerized manner.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "The widespread use of computerized information storage and retrieval systems has resulted in library technicians assisting in the handling of technical services (such as cataloguing) that were once performed exclusively by librarians.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="Technical services">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Technical services in a library context refer to tasks such as cataloguing.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "The widespread use of computerized information storage and retrieval systems has resulted in library technicians assisting in the handling of technical services (such as cataloguing) that were once performed exclusively by librarians.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="Cataloguing">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Cataloguing is a technical service performed in libraries for organizing information.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "The widespread use of computerized information storage and retrieval systems has resulted in library technicians assisting in the handling of technical services (such as cataloguing) that were once performed exclusively by librarians.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="Small village libraries">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "These are libraries located in small villages, often staffed by a library technician.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "Especially in small village libraries, a library technician may be the only person (or one of only a few) staffing the library.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="Larger libraries">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "These are libraries that are not small and may have multiple departments and staff.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "In larger libraries, they may help run certain departments and supervise library clerks, aides, and volunteers.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="Library clerks">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Library clerks are staff members who may be supervised by library technicians in larger libraries.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "In larger libraries, they may help run certain departments and supervise library clerks, aides, and volunteers.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="Aides">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Aides are individuals who may be supervised by library technicians in larger libraries.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "In larger libraries, they may help run certain departments and supervise library clerks, aides, and volunteers.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="Volunteers">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Volunteers are individuals who may be supervised by library technicians in larger libraries.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "In larger libraries, they may help run certain departments and supervise library clerks, aides, and volunteers.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="New technologies">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "These are advancements that libraries are increasingly using, expanding the role of library technicians.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "Because libraries are increasingly using new technologies (such as automated databases, CD-ROM, the Internet, and virtual libraries), the role of the library technician is expanding and evolving accordingly.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="Automated databases">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Databases that are automated, used by libraries and impacting the role of library technicians.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "Because libraries are increasingly using new technologies (such as automated databases, CD-ROM, the Internet, and virtual libraries), the role of the library technician is expanding and evolving accordingly.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="CD-ROM">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A storage medium used by libraries, impacting the role of library technicians.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "Because libraries are increasingly using new technologies (such as automated databases, CD-ROM, the Internet, and virtual libraries), the role of the library technician is expanding and evolving accordingly.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="The Internet">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A global network used by libraries, impacting the role of library technicians.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "Because libraries are increasingly using new technologies (such as automated databases, CD-ROM, the Internet, and virtual libraries), the role of the library technician is expanding and evolving accordingly.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="Virtual libraries">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Libraries that exist in a virtual or digital space, used by libraries and impacting the role of library technicians.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d2">[{"text": "Because libraries are increasingly using new technologies (such as automated databases, CD-ROM, the Internet, and virtual libraries), the role of the library technician is expanding and evolving accordingly.", "chunk_id": "2f47939c7061409f", "doc_id": "hp_708a5f62a130daf5"}]</data>
  <data key="d3">["hp_708a5f62a130daf5"]</data>
  <data key="d4">False</data>
</node>
<node id="Danes Moss Nature Reserve">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Danes Moss Nature Reserve is a nature reserve located south of Macclesfield, Cheshire, England.", "chunk_id": "77d9bd7c0fae6eb4", "doc_id": "hp_70aed1e36bbd2603"}]</data>
  <data key="d2">[{"text": "Danes Moss Nature Reserve is a 13.4 ha nature reserve south of Macclesfield, Cheshire, England.", "chunk_id": "77d9bd7c0fae6eb4", "doc_id": "hp_70aed1e36bbd2603"}]</data>
  <data key="d3">["hp_70aed1e36bbd2603"]</data>
  <data key="d4">False</data>
</node>
<node id="Macclesfield">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Macclesfield is a town in Cheshire, England.", "chunk_id": "77d9bd7c0fae6eb4", "doc_id": "hp_70aed1e36bbd2603"}, {"text": "Macclesfield is a town in Cheshire, England.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d2">[{"text": "Danes Moss Nature Reserve is a 13.4 ha nature reserve south of Macclesfield, Cheshire, England.", "chunk_id": "77d9bd7c0fae6eb4", "doc_id": "hp_70aed1e36bbd2603"}, {"text": "The Very Reverend Godwin Birchenough (27 October 1880, Macclesfield, Cheshire – 3 March, 1953) was the only son of Walter Edwin Birchenough and was the grandson of John Birchenough, a prominent Macclesfield silk manufacturer.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d3">["hp_70aed1e36bbd2603", "hp_b4ae5293eb8657fc"]</data>
  <data key="d4">False</data>
</node>
<node id="Site of Special Scientific Interest">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A Site of Special Scientific Interest is a conservation designation in the United Kingdom.", "chunk_id": "77d9bd7c0fae6eb4", "doc_id": "hp_70aed1e36bbd2603"}]</data>
  <data key="d2">[{"text": "A Site of Special Scientific Interest, it is managed by the Cheshire Wildlife Trust.", "chunk_id": "77d9bd7c0fae6eb4", "doc_id": "hp_70aed1e36bbd2603"}]</data>
  <data key="d3">["hp_70aed1e36bbd2603"]</data>
  <data key="d4">False</data>
</node>
<node id="Cheshire Wildlife Trust">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Cheshire Wildlife Trust is an organization that manages the Danes Moss Nature Reserve.", "chunk_id": "77d9bd7c0fae6eb4", "doc_id": "hp_70aed1e36bbd2603"}]</data>
  <data key="d2">[{"text": "A Site of Special Scientific Interest, it is managed by the Cheshire Wildlife Trust.", "chunk_id": "77d9bd7c0fae6eb4", "doc_id": "hp_70aed1e36bbd2603"}]</data>
  <data key="d3">["hp_70aed1e36bbd2603"]</data>
  <data key="d4">False</data>
</node>
<node id="Arizona">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Arizona is a state where Robinsons-May operated.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}, {"text": "A state in the Pacific Coast region that was part of Standard Oil of Iowa's marketing area.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}, {"text": "A state in the United States.", "chunk_id": "cfcc8f8ff86d83c3", "doc_id": "hp_dbf42d0cc7b618be"}]</data>
  <data key="d2">[{"text": "Robinsons-May was a chain of department stores operating in Southern California, Arizona and Las Vegas, Nevada, previously with headquarters in North Hollywood, California.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}, {"text": "Standard Oil Company of Iowa was created in 1885 as a subsidiary of the Standard Oil Trust to handle marketing along the Pacific Coast states of Idaho, Oregon, Washington, California, and Arizona.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}, {"text": "Stenocereus (Gk. stenos, narrow, L. cereus, candle) is a genus of columnar or tree-like cacti from the Baja California Peninsula and other parts of Mexico, Arizona in the United States, Colombia, Costa Rica, Guatemala, Venezuela and the ABC islands of the Dutch Caribbean.", "chunk_id": "cfcc8f8ff86d83c3", "doc_id": "hp_dbf42d0cc7b618be"}]</data>
  <data key="d3">["hp_70e1b920ca70d1e9", "hp_777b99a15f2523b1", "hp_dbf42d0cc7b618be"]</data>
  <data key="d4">False</data>
</node>
<node id="Las Vegas">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Las Vegas is a city in Nevada where Robinsons-May operated.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d2">[{"text": "Robinsons-May was a chain of department stores operating in Southern California, Arizona and Las Vegas, Nevada, previously with headquarters in North Hollywood, California.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d3">["hp_70e1b920ca70d1e9"]</data>
  <data key="d4">False</data>
</node>
<node id="Federated">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Federated acquired The May Department Stores Company.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d2">[{"text": "It was a subsidiary of The May Department Stores Company, having been acquired with Federated's takeover of The May Department Stores Company on August 30, 2005.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d3">["hp_70e1b920ca70d1e9"]</data>
  <data key="d4">False</data>
</node>
<node id="August 30, 2005">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The date when Federated took over The May Department Stores Company.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d2">[{"text": "It was a subsidiary of The May Department Stores Company, having been acquired with Federated's takeover of The May Department Stores Company on August 30, 2005.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d3">["hp_70e1b920ca70d1e9"]</data>
  <data key="d4">False</data>
</node>
<node id="1952 Individual Speedway World Championship">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 1952 Individual Speedway World Championship was an event where Jack Young won his second straight World Championship.", "chunk_id": "3f37f1d57cb3f639", "doc_id": "hp_71501f4cf0223b43"}]</data>
  <data key="d2">[{"text": "1952 Individual Speedway World Championship", "chunk_id": "3f37f1d57cb3f639", "doc_id": "hp_71501f4cf0223b43"}]</data>
  <data key="d3">["hp_71501f4cf0223b43"]</data>
  <data key="d4">False</data>
</node>
<node id="Jack Young">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An Australian rider who became the first ever dual winner of the Individual Speedway World Championship, winning two in a row.", "chunk_id": "3f37f1d57cb3f639", "doc_id": "hp_71501f4cf0223b43"}, {"text": "A motorcycle speedway rider who won the Speedway World Championship in 1951 and 1952.", "chunk_id": "c6546edc8fa1b181", "doc_id": "hp_ea9deb27c486c338"}]</data>
  <data key="d2">[{"text": "Australian rider Jack Young became the first ever dual winner (and the first to win two in a row) when he won his second straight World Championship after scoring 14 points.", "chunk_id": "3f37f1d57cb3f639", "doc_id": "hp_71501f4cf0223b43"}, {"text": "Jack Ellis Young (31 January 1925 in Adelaide, South Australia – 28 August 1987 in Adelaide) was a Motorcycle speedway rider who won the Speedway World Championship in 1951 and 1952.", "chunk_id": "c6546edc8fa1b181", "doc_id": "hp_ea9deb27c486c338"}]</data>
  <data key="d3">["hp_71501f4cf0223b43", "hp_ea9deb27c486c338"]</data>
  <data key="d4">False</data>
</node>
<node id="Freddie Williams">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A Welshman who finished second in the 1952 Individual Speedway World Championship.", "chunk_id": "3f37f1d57cb3f639", "doc_id": "hp_71501f4cf0223b43"}]</data>
  <data key="d2">[{"text": "Second was Welshman Freddie Williams on 13 points, with Britain's Bob Oakley third on 12 points.", "chunk_id": "3f37f1d57cb3f639", "doc_id": "hp_71501f4cf0223b43"}]</data>
  <data key="d3">["hp_71501f4cf0223b43"]</data>
  <data key="d4">False</data>
</node>
<node id="Bob Oakley">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A British rider who finished third in the 1952 Individual Speedway World Championship.", "chunk_id": "3f37f1d57cb3f639", "doc_id": "hp_71501f4cf0223b43"}]</data>
  <data key="d2">[{"text": "Second was Welshman Freddie Williams on 13 points, with Britain's Bob Oakley third on 12 points.", "chunk_id": "3f37f1d57cb3f639", "doc_id": "hp_71501f4cf0223b43"}]</data>
  <data key="d3">["hp_71501f4cf0223b43"]</data>
  <data key="d4">False</data>
</node>
<node id="Wales">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The country of origin for the rider Freddie Williams.", "chunk_id": "3f37f1d57cb3f639", "doc_id": "hp_71501f4cf0223b43"}]</data>
  <data key="d2">[{"text": "Second was Welshman Freddie Williams on 13 points, with Britain's Bob Oakley third on 12 points.", "chunk_id": "3f37f1d57cb3f639", "doc_id": "hp_71501f4cf0223b43"}]</data>
  <data key="d3">["hp_71501f4cf0223b43"]</data>
