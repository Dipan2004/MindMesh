<node id="Carnatic music">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A genre of music that originated in South India.", "chunk_id": "0f45fd72ea12d7a5", "doc_id": "hp_4a19ddee33b69a6c"}, {"text": "Carnatic music is a system of music commonly associated with South India.", "chunk_id": "d2bfeca63abb17df", "doc_id": "hp_d7ee1e4a5af66927"}]</data>
  <data key="d2">[{"text": "He was awarded the Rajyotsava Prashasti, the highhest civilian honour of the state of Karnataka, for his contribution towards Carnatic music.", "chunk_id": "0f45fd72ea12d7a5", "doc_id": "hp_4a19ddee33b69a6c"}, {"text": "Sikkil C. Gurucharan (born on 21 June 1982) is among the foremost young performing musicians of Carnatic music in India today.", "chunk_id": "d2bfeca63abb17df", "doc_id": "hp_d7ee1e4a5af66927"}]</data>
  <data key="d3">["hp_4a19ddee33b69a6c", "hp_d7ee1e4a5af66927"]</data>
  <data key="d4">False</data>
</node>
