<node id="Andy Kaufman">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A guest star on The Fantastic Miss Piggy Show.", "chunk_id": "9fddbf6c969855ac", "doc_id": "hp_6926160a248b43c3"}, {"text": "Andy Kaufman was a performance artist who created the character Tony Clifton.", "chunk_id": "c6f60784815bbba5", "doc_id": "hp_89119e061210f745"}, {"text": "A comedian and performance artist known for his unconventional personas.", "chunk_id": "a57b9509e1d93532", "doc_id": "hp_bb2da19e6d96b8c5"}, {"text": "An American comedian, actor, writer, performance artist, and professional wrestler.", "chunk_id": "a8189041218c65c9", "doc_id": "hp_df54057a167e76d7"}]</data>
  <data key="d2">[{"text": "It guest starred John Ritter, George Hamilton, and Andy Kaufman (as \"Tony Clifton\")", "chunk_id": "9fddbf6c969855ac", "doc_id": "hp_6926160a248b43c3"}, {"text": "Tony Clifton is a character created by late performance artist Andy Kaufman, who also portrayed him in the late 1970s.", "chunk_id": "c6f60784815bbba5", "doc_id": "hp_89119e061210f745"}, {"text": "In this regard, UFO Phil may be an example of Poe's law and has been compared to Andy Kaufman's persona Tony Clifton.", "chunk_id": "a57b9509e1d93532", "doc_id": "hp_bb2da19e6d96b8c5"}, {"text": "Andrew G. Kaufman (January 17, 1949 – May 16, 1984) was an American comedian, actor, writer, performance artist and professional wrestler.", "chunk_id": "a8189041218c65c9", "doc_id": "hp_df54057a167e76d7"}]</data>
  <data key="d3">["hp_6926160a248b43c3", "hp_89119e061210f745", "hp_bb2da19e6d96b8c5", "hp_df54057a167e76d7"]</data>
  <data key="d4">False</data>
</node>
