  <data key="d2">[{"text": "Government House was once a Quaker Plantation, until it was purchased by the Imperial Government, when it acted as a replacement to The Bagatelle Great House in the Parish of St. Thomas.", "chunk_id": "f15b4d073be58d53", "doc_id": "hp_ebe7b6e221d5e13c"}]</data>
