  <data key="d7">[{"text": "Wing Ki Lai or Emma Lai (born March 14, 1988) is a Hong Kong cricketer who plays for Hong Kong women's national cricket team.", "chunk_id": "841c093ae5da39c9", "doc_id": "hp_654d8d6bcb6a93e2", "type": "NATIONALITY"}, {"text": "Just over a year after her first cricket lesson, she travelled to Kuwait as part of the Hong Kong squad, and a year later, she played in her first game for Hong Kong against Thailand.", "chunk_id": "841c093ae5da39c9", "doc_id": "hp_654d8d6bcb6a93e2", "type": "PART_OF_SQUAD_FOR"}]</data>
