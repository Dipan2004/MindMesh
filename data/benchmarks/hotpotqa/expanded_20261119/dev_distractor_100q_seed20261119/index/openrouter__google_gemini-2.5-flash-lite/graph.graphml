  <data key="d2">[{"text": "French and Saunders is a British sketch comedy television series written by and starring comic duo Dawn French and Jennifer Saunders.", "chunk_id": "0cba2f1e48972df0", "doc_id": "hp_a43a1b7d6bf4ac88"}, {"text": "She is best known for starring in and writing for the comedy sketch show \"French and Saunders\" with comedy partner Jennifer Saunders and for playing the lead role as Geraldine Granger in the sitcom \"The Vicar of Dibley\".", "chunk_id": "8f5e1ed518366291", "doc_id": "hp_b150127ee448fafd"}]</data>
