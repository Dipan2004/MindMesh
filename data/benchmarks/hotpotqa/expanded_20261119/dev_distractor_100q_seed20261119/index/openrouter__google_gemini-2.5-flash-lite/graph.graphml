<node id="Middle Ages">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A historical period in Europe.", "chunk_id": "bc64bf079d554c77", "doc_id": "hp_4e550c7b3015ae79"}, {"text": "The Middle Ages was a period in European history.", "chunk_id": "80b52c81ca855fef", "doc_id": "hp_c12a13b85cfa0362"}]</data>
  <data key="d2">[{"text": "The song \"Burning Times\" concerns the persecution of women accused of witchcraft in the Middle Ages and early modern periods.", "chunk_id": "bc64bf079d554c77", "doc_id": "hp_4e550c7b3015ae79"}, {"text": "Cameline ( ) was a fabric material used in the Middle Ages for cloth.", "chunk_id": "80b52c81ca855fef", "doc_id": "hp_c12a13b85cfa0362"}]</data>
  <data key="d3">["hp_4e550c7b3015ae79", "hp_c12a13b85cfa0362"]</data>
