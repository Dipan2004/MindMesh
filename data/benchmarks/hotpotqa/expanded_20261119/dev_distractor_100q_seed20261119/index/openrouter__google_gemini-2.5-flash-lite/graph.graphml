<node id="Baikal Nature Reserve">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A nature reserve located on the southeast shore of Lake Baikal, in southern Buryatia, Russia.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d2">[{"text": "The Baikal Nature Reserve ( ; Russian: Байка́льский запове́дник , \"Baikalski Zapovednik\") is a nature reserve on the southeast shore of Lake Baikal, in southern Buryatia, Russia.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d3">["hp_acf14927bc123f83"]</data>
  <data key="d4">False</data>
</node>
<node id="Lake Baikal">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A large freshwater lake in southern Siberia, Russia, known for its unique ecosystem.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d2">[{"text": "The Baikal Nature Reserve ( ; Russian: Байка́льский запове́дник , \"Baikalski Zapovednik\") is a nature reserve on the southeast shore of Lake Baikal, in southern Buryatia, Russia.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d3">["hp_acf14927bc123f83"]</data>
  <data key="d4">False</data>
</node>
<node id="Buryatia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A federal subject of Russia, located in Siberia.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d2">[{"text": "The Baikal Nature Reserve ( ; Russian: Байка́льский запове́дник , \"Baikalski Zapovednik\") is a nature reserve on the southeast shore of Lake Baikal, in southern Buryatia, Russia.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d3">["hp_acf14927bc123f83"]</data>
  <data key="d4">False</data>
</node>
<node id="Baikal Zapovednik">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "An alternative name for the Baikal Nature Reserve.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d2">[{"text": "Also called Baikal Zapovednik, it was established in 1969 for preserving the nature along the lake and the neighboring central part of the Chamar-Daban Range.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d3">["hp_acf14927bc123f83"]</data>
  <data key="d4">False</data>
</node>
<node id="Chamar-Daban Range">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A mountain range located in southern Siberia, Russia.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d2">[{"text": "Also called Baikal Zapovednik, it was established in 1969 for preserving the nature along the lake and the neighboring central part of the Chamar-Daban Range.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d3">["hp_acf14927bc123f83"]</data>
  <data key="d4">False</data>
</node>
<node id="World Network of Biosphere Reserves">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A global network of protected areas recognized by UNESCO for their contributions to conservation and sustainable development.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d2">[{"text": "The Baikal Nature Reserve is part of the World Network of Biosphere Reserves (also see \"List of biosphere reserves in the Russian Federation\").", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d3">["hp_acf14927bc123f83"]</data>
  <data key="d4">False</data>
</node>
<node id="Lake Baikal World Heritage Site">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A UNESCO World Heritage Site encompassing Lake Baikal and its surrounding natural environment.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d2">[{"text": "The reserve is also a part of the Lake Baikal World Heritage Site.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d3">["hp_acf14927bc123f83"]</data>
  <data key="d4">False</data>
</node>
<node id="Kabansky Nature Zakaznik">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A nature reserve located across from the Baikal Nature Reserve.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d2">[{"text": "The Kabansky Nature Zakaznik, across , was transferred under the jurisdiction of the Baikal Nature Reserve in 1985.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d3">["hp_acf14927bc123f83"]</data>
  <data key="d4">False</data>
</node>
<node id="Executive Order 9066">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An executive order that mandated the internment of Japanese Americans during World War II.", "chunk_id": "c923a57087201126", "doc_id": "hp_ad41e3555a82bb26"}]</data>
  <data key="d2">[{"text": "Korematsu v. United States, 323 U.S. 214 (1944), was a landmark United States Supreme Court case concerning the constitutionality of Executive Order 9066, which ordered Japanese Americans into internment camps during World War II regardless of citizenship.", "chunk_id": "c923a57087201126", "doc_id": "hp_ad41e3555a82bb26"}]</data>
  <data key="d3">["hp_ad41e3555a82bb26"]</data>
  <data key="d4">False</data>
</node>
<node id="Japanese Americans">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A group of people of Japanese descent residing in the United States who were subjected to internment.", "chunk_id": "c923a57087201126", "doc_id": "hp_ad41e3555a82bb26"}, {"text": "Citizens of the United States of Japanese ancestry.", "chunk_id": "615cdfa10474d8b6", "doc_id": "hp_c36e9406d9e10267"}]</data>
  <data key="d2">[{"text": "Korematsu v. United States, 323 U.S. 214 (1944), was a landmark United States Supreme Court case concerning the constitutionality of Executive Order 9066, which ordered Japanese Americans into internment camps during World War II regardless of citizenship.", "chunk_id": "c923a57087201126", "doc_id": "hp_ad41e3555a82bb26"}, {"text": "Although the Court did not touch on the constitutionality of the exclusion of people of Japanese ancestry from the West Coast—which they had found not to violate citizen rights in their \"Korematsu v. United States\" decision on the same date—the Endo ruling nonetheless led to the reopening of the West Coast to Japanese Americans after their incarceration in camps across the U.S. interior during World War II.", "chunk_id": "615cdfa10474d8b6", "doc_id": "hp_c36e9406d9e10267"}]</data>
  <data key="d3">["hp_ad41e3555a82bb26", "hp_c36e9406d9e10267"]</data>
  <data key="d4">False</data>
</node>
