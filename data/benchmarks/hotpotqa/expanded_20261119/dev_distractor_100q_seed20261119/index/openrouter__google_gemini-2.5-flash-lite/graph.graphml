  <data key="d2">[{"text": "The Roman Catholic Diocese of East Anglia, Norfolk County Council, and the Department for Education all support Notre Dame High School.", "chunk_id": "379e79f8fef657ef", "doc_id": "hp_33fd17055c06917a"}]</data>
