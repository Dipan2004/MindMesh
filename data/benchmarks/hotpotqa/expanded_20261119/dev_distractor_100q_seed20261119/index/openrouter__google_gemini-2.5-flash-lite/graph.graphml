  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "West Germany is a location where the championship was held for the second time.", "chunk_id": "2c62b8e41effed53", "doc_id": "hp_e15a8d4e4eeaa41c"}]</data>
