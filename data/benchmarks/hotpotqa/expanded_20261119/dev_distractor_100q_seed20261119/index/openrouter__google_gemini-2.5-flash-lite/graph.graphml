<node id="National Route 9">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "National Route 9 is a road located in Argentina.", "chunk_id": "1169ed720e69619f", "doc_id": "hp_20739c2399543481"}, {"text": "A national route in Argentina.", "chunk_id": "eee0658a37ea7481", "doc_id": "hp_5d6ed7a42a524dc4"}]</data>
  <data key="d2">[{"text": "It is located 32 km from the provincial capital city of Santiago del Estero (capital), south along National Route 9.", "chunk_id": "1169ed720e69619f", "doc_id": "hp_20739c2399543481"}, {"text": "It lies on the Dulce River and on National Route 9, at a distance of 1,042 km north-northwest from Buenos Aires.", "chunk_id": "eee0658a37ea7481", "doc_id": "hp_5d6ed7a42a524dc4"}]</data>
  <data key="d3">["hp_20739c2399543481", "hp_5d6ed7a42a524dc4"]</data>
  <data key="d4">False</data>
</node>
<node id="California Birth Index">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A database compiled by the California Office of Health Information and Research containing birth records.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d2">[{"text": "The California Birth Index (CABI) is a database compiled by the California Office of Health Information and Research.", "chunk_id": "de14dac6ee26309b", "doc_id": "hp_20acafffd5f50194"}]</data>
  <data key="d3">["hp_20acafffd5f50194"]</data>
  <data key="d4">False</data>
</node>
