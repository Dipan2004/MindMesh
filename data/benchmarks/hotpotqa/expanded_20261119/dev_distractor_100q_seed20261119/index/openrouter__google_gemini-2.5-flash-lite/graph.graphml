  <data key="d5">["NATIVE_TO"]</data>
  <data key="d6">Leucophyllum is native to the southwestern United States.</data>
  <data key="d7">[{"text": "Leucophyllum (barometer bush or barometerbush) is a genus of evergreen shrubs in the figwort family, Scrophulariaceae, native to the southwestern United States and Mexico.", "chunk_id": "d3f92c958cb5561c", "doc_id": "hp_51931a701df55281", "type": "NATIVE_TO"}]</data>
  <data key="d8">hp_51931a701df55281</data>
</edge>
<edge source="Leucophyllum" target="Mexico">
  <data key="d5">["NATIVE_TO"]</data>
  <data key="d6">Leucophyllum is native to Mexico.</data>
  <data key="d7">[{"text": "Leucophyllum (barometer bush or barometerbush) is a genus of evergreen shrubs in the figwort family, Scrophulariaceae, native to the southwestern United States and Mexico.", "chunk_id": "d3f92c958cb5561c", "doc_id": "hp_51931a701df55281", "type": "NATIVE_TO"}]</data>
  <data key="d8">hp_51931a701df55281</data>
</edge>
<edge source="Leucophyllum" target="Myoporaceae">
  <data key="d5">["PLACED_IN"]</data>
  <data key="d6">Leucophyllum is sometimes placed in the family Myoporaceae.</data>
  <data key="d7">[{"text": "It is sometimes placed in the family Myoporaceae.", "chunk_id": "d3f92c958cb5561c", "doc_id": "hp_51931a701df55281", "type": "PLACED_IN"}]</data>
