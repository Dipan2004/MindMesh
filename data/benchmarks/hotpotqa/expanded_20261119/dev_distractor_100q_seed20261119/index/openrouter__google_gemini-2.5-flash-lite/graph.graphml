  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Stepin Fetchit was associated with the film 'Hearts in Dixie'.", "chunk_id": "0e4827edb0f6cbcd", "doc_id": "hp_1302f518109754f9"}]</data>
  <data key="d2">[{"text": "His movies include \"Hearts in Dixie\" (1929) with Stepin Fetchit, \"The Woman Accused\" (1933) with Cary Grant, and \"The Texans\" with Joan Bennett, Randolph Scott and Walter Brennan.", "chunk_id": "0e4827edb0f6cbcd", "doc_id": "hp_1302f518109754f9"}]</data>
  <data key="d3">["hp_1302f518109754f9"]</data>
  <data key="d4">False</data>
</node>
