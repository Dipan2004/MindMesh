  <data key="d2">[{"text": "He will be remembered by football fans as one of the finest Albanian footballers of the 1980s, skillful with the ball, but also distinguished as an extraordinary assist man, and a strong shooter.", "chunk_id": "0408279beae01682", "doc_id": "hp_0e7eba96d0606c19"}]</data>
