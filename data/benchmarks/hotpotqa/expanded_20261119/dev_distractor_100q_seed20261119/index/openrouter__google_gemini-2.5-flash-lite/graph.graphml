<node id="United Arab Emirates">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The United Arab Emirates is a country where Dubai is located and where Mohammed bin Rashid Al Maktoum serves as Prime Minister and Vice President.", "chunk_id": "a0eaa1f65d7ed5d5", "doc_id": "hp_b2592bcfce5865bb"}]</data>
  <data key="d2">[{"text": "Dr. Nisar Ahmad Wani, a reproductive biologist and head of the research team at the Camel Reproduction Center in Dubai, United Arab Emirates, announced on April 14, 2009, that the cloned camel was born after an \"uncomplicated\" gestation of 378 days.", "chunk_id": "a0eaa1f65d7ed5d5", "doc_id": "hp_b2592bcfce5865bb"}]</data>
  <data key="d3">["hp_b2592bcfce5865bb"]</data>
  <data key="d4">False</data>
</node>
<node id="Mohammed bin Rashid Al Maktoum">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Mohammed bin Rashid Al Maktoum is the Prime Minister and Vice President of the United Arab Emirates, and the emir of Dubai, who provided endorsement and financial support for the cloning project.", "chunk_id": "a0eaa1f65d7ed5d5", "doc_id": "hp_b2592bcfce5865bb"}]</data>
  <data key="d2">[{"text": "The cloning project had the personal endorsement and financial support of Mohammed bin Rashid Al Maktoum, the Prime Minister, Vice President of the United Arab Emirates, and the emir of Dubai.", "chunk_id": "a0eaa1f65d7ed5d5", "doc_id": "hp_b2592bcfce5865bb"}]</data>
  <data key="d3">["hp_b2592bcfce5865bb"]</data>
  <data key="d4">False</data>
</node>
