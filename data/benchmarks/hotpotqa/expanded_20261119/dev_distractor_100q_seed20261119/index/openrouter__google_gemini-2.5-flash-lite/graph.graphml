  <data key="d1">[{"text": "Zaj was an experimental music and performance art group.", "chunk_id": "b647f648f08782f6", "doc_id": "hp_205b52451626bfb6"}]</data>
  <data key="d2">[{"text": "Zaj was an experimental music and performance art group formed in 1959 in Milan, Italy by composers and intermedia artists Walter Marchetti and Juan Hidalgo with the support of the American composer John Cage.", "chunk_id": "b647f648f08782f6", "doc_id": "hp_205b52451626bfb6"}]</data>
