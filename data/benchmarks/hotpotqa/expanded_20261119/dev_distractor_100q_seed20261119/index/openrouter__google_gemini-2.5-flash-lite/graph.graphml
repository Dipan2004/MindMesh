<node id="Dougie Payne">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Dougie Payne is a member of the band Travis, playing bass guitar and backing vocals.", "chunk_id": "8043cae2ef7b7fae", "doc_id": "hp_5e36dcc4c1a872ca"}, {"text": "A writer of the song \"Where You Stand\".", "chunk_id": "f4459cecee69896e", "doc_id": "hp_ede5d2c03eeb3cf1"}]</data>
  <data key="d2">[{"text": "Travis is an alternative rock band from Glasgow, Scotland, comprising Fran Healy (lead vocals, guitar, piano, banjo), Dougie Payne (bass guitar, backing vocals), Andy Dunlop (lead guitar, banjo, keyboards, backing vocals) and Neil Primrose (drums, percussion).", "chunk_id": "8043cae2ef7b7fae", "doc_id": "hp_5e36dcc4c1a872ca"}, {"text": "\"Where You Stand\" is a song by alternative rock band Travis, written by Dougie Payne, Holly Partridge and Fran Healy.", "chunk_id": "f4459cecee69896e", "doc_id": "hp_ede5d2c03eeb3cf1"}]</data>
  <data key="d3">["hp_5e36dcc4c1a872ca", "hp_ede5d2c03eeb3cf1"]</data>
  <data key="d4">False</data>
</node>
