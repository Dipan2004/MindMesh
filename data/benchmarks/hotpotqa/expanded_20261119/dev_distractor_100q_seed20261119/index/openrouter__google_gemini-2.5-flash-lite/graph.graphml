  <data key="d1">[{"text": "An integrated public transport system that includes zones for bus services.", "chunk_id": "338a75991da8943e", "doc_id": "hp_3e042ad47b60933e"}, {"text": "An integrated public transport system operated by TransLink.", "chunk_id": "3a90b2ec007df76c", "doc_id": "hp_4585e3987830685a"}, {"text": "An integrated public transport system operated by TransLink.", "chunk_id": "ba730c4e66833a5a", "doc_id": "hp_5e729b3de393ded8"}, {"text": "The TransLink integrated public transport system is a public transport system that includes Zone 2.", "chunk_id": "d45b60b7abaeaa6a", "doc_id": "hp_85a0b49c6ecc4877"}, {"text": "An integrated public transport system operated by TransLink.", "chunk_id": "6257f1836522b4a7", "doc_id": "hp_888262fe7c1aaa67"}, {"text": "The TransLink integrated public transport system is a public transport system operated by TransLink.", "chunk_id": "fbf61adc749de348", "doc_id": "hp_c5ef67346cb356c5"}, {"text": "An integrated public transport system operated by TransLink.", "chunk_id": "e46c2a621963ae57", "doc_id": "hp_d9c16ac1a14c473e"}, {"text": "An integrated public transport system operated by TransLink.", "chunk_id": "73348332beb37e73", "doc_id": "hp_f5380a35f3a97562"}]</data>
  <data key="d2">[{"text": "It is in a transition precinct between Zone 2 and Zone 3 of the TransLink integrated public transport system.", "chunk_id": "338a75991da8943e", "doc_id": "hp_3e042ad47b60933e"}, {"text": "It is in Zone 2 of the TransLink integrated public transport system.", "chunk_id": "3a90b2ec007df76c", "doc_id": "hp_4585e3987830685a"}, {"text": "It is in a transition precinct between Zone 3 and Zone 4 of the TransLink integrated public transport system.", "chunk_id": "ba730c4e66833a5a", "doc_id": "hp_5e729b3de393ded8"}, {"text": "It is in Zone 2 of the TransLink integrated public transport system.", "chunk_id": "d45b60b7abaeaa6a", "doc_id": "hp_85a0b49c6ecc4877"}, {"text": "It is in a transition precinct between Zone 5 and Zone 6 of the TransLink integrated public transport system.", "chunk_id": "6257f1836522b4a7", "doc_id": "hp_888262fe7c1aaa67"}, {"text": "It is in Zone 4 of the TransLink integrated public transport system.", "chunk_id": "fbf61adc749de348", "doc_id": "hp_c5ef67346cb356c5"}, {"text": "It is in a transition precinct between Zone 6 and Zone 7 of the TransLink integrated public transport system.", "chunk_id": "e46c2a621963ae57", "doc_id": "hp_d9c16ac1a14c473e"}, {"text": "It is in Zone 5 of the TransLink integrated public transport system.", "chunk_id": "73348332beb37e73", "doc_id": "hp_f5380a35f3a97562"}]</data>
