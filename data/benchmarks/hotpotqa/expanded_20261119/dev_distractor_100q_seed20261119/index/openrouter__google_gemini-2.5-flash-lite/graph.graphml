<node id="BBC1">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The channel on which the documentary series 'The Day the Universe Changed' was originally broadcast.", "chunk_id": "641da45da986e5ce", "doc_id": "hp_58b33fe59f58c1ed"}]</data>
  <data key="d2">[{"text": "The Day the Universe Changed: A Personal View by James Burke is a British documentary television series written and presented by science historian James Burke, originally broadcast on BBC1 from 19 March until 21 May 1985 by the BBC.", "chunk_id": "641da45da986e5ce", "doc_id": "hp_58b33fe59f58c1ed"}]</data>
