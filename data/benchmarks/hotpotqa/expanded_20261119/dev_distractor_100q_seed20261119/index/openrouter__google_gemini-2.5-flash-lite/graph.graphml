<node id="Rockmond Dunbar">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Rockmond Dunbar is an American actor known for his roles in various television series.", "chunk_id": "e6ead40e0035e3ad", "doc_id": "hp_5f887a880d175cfb"}]</data>
  <data key="d2">[{"text": "Rockmond Dunbar (born January 11, 1973 in Berkeley, California) is an American actor.", "chunk_id": "e6ead40e0035e3ad", "doc_id": "hp_5f887a880d175cfb"}]</data>
  <data key="d3">["hp_5f887a880d175cfb"]</data>
  <data key="d4">False</data>
</node>
<node id="Berkeley, California">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Berkeley, California is the birthplace of Rockmond Dunbar.", "chunk_id": "e6ead40e0035e3ad", "doc_id": "hp_5f887a880d175cfb"}, {"text": "A city in California where the band performed the song.", "chunk_id": "4a33b3fb6c1ee1fa", "doc_id": "hp_7804b34667739a36"}, {"text": "Berkeley, California is a location where \"Tikkun\" magazine is based and Beyt Tikkun Synagogue is located.", "chunk_id": "b15598f798e631b6", "doc_id": "hp_ebb527a8921b04b5"}]</data>
  <data key="d2">[{"text": "Rockmond Dunbar (born January 11, 1973 in Berkeley, California) is an American actor.", "chunk_id": "e6ead40e0035e3ad", "doc_id": "hp_5f887a880d175cfb"}, {"text": "After the band performed the song in Berkeley, California on 12 June 2011, the studio version premiered on Florence and the Machine's official website.", "chunk_id": "4a33b3fb6c1ee1fa", "doc_id": "hp_7804b34667739a36"}, {"text": "Michael Lerner (born 1943) is an American political activist, the editor of \"Tikkun\", a progressive Jewish interfaith magazine based in Berkeley, California, and the rabbi of Beyt Tikkun Synagogue in Berkeley.", "chunk_id": "b15598f798e631b6", "doc_id": "hp_ebb527a8921b04b5"}]</data>
  <data key="d3">["hp_5f887a880d175cfb", "hp_7804b34667739a36", "hp_ebb527a8921b04b5"]</data>
  <data key="d4">False</data>
</node>
<node id="Earth 2">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Earth 2 is an NBC series in which Rockmond Dunbar played the role of Baines.", "chunk_id": "e6ead40e0035e3ad", "doc_id": "hp_5f887a880d175cfb"}]</data>
  <data key="d2">[{"text": "He is best known for his roles as Baines on the NBC series \"Earth 2\", Kenny Chadway on Showtime's \"Soul Food\", and Benjamin Miles \"C-Note\" Franklin on the FOX crime drama \"Prison Break\".", "chunk_id": "e6ead40e0035e3ad", "doc_id": "hp_5f887a880d175cfb"}]</data>
  <data key="d3">["hp_5f887a880d175cfb"]</data>
  <data key="d4">False</data>
</node>
