  <data key="d2">[{"text": "It came after a hiatus in which the members released solo projects, including vocalist/lyricist Koshi Inaba's \"Singing Bird\" and guitarist/composer Tak Matsumoto's \"New Horizon\".", "chunk_id": "2b3a5af8f817eb3b", "doc_id": "hp_097f6b9639cd1b8c"}, {"text": "Singing Bird is the fifth solo studio album by Japanese singer Koshi Inaba, of B'z fame.", "chunk_id": "ca46c02b980db182", "doc_id": "hp_e2dc91ec138a82f9"}]</data>
