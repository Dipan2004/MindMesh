<node id="The Boxer">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The debut solo album by Kele Okereke.", "chunk_id": "bb2b762aba15f55a", "doc_id": "hp_24b106283a2f2b9f"}, {"text": "The Boxer is a 2010 solo album.", "chunk_id": "145e5d0c1408e198", "doc_id": "hp_e5470b4e6fa8bc35"}]</data>
  <data key="d2">[{"text": "The Boxer is the debut solo album by Kele Okereke, the lead singer of British indie rock band Bloc Party.", "chunk_id": "bb2b762aba15f55a", "doc_id": "hp_24b106283a2f2b9f"}, {"text": "The Hunter is the first EP (and follow up to the 2010 solo album \"The Boxer\") by Kele Okereke (under the professional name Kele), lead singer and rhythm guitarist of the British rock band Bloc Party.", "chunk_id": "145e5d0c1408e198", "doc_id": "hp_e5470b4e6fa8bc35"}]</data>
  <data key="d3">["hp_24b106283a2f2b9f", "hp_e5470b4e6fa8bc35"]</data>
