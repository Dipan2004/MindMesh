  <data key="d5">["PART_OF"]</data>
  <data key="d6">Byron K. Lichtenberg and Ulf Merbold became the first Payload Specialists to fly on the shuttle in 1983.</data>
  <data key="d7">[{"text": "In 1983, he and Ulf Merbold became the first Payload Specialists to fly on the shuttle.", "chunk_id": "986fec5d5c4ec7fd", "doc_id": "hp_ab0e95c94eff4211", "type": "PART_OF"}]</data>
  <data key="d8">hp_ab0e95c94eff4211</data>
