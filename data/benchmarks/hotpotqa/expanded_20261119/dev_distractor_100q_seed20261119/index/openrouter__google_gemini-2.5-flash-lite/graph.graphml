  <data key="d1">[{"text": "An Australian film director, screenwriter, and producer.", "chunk_id": "6e2520e76c300111", "doc_id": "hp_2f6efd859dd967a9"}]</data>
  <data key="d2">[{"text": "Mark Anthony \"Baz\" Luhrmann ( ; born 17 September 1962) is an Australian film director, screenwriter and producer best known for \"Red Curtain Trilogy\", comprising his romantic comedy film \"Strictly Ballroom\" (1992), the romantic drama \"Romeo + Juliet\" (1996), and the pastiche-jukebox musical \"Moulin Rouge!\" (2001).", "chunk_id": "6e2520e76c300111", "doc_id": "hp_2f6efd859dd967a9"}]</data>
