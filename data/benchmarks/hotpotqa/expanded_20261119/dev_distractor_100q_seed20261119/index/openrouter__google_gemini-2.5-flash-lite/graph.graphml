  <data key="d5">["WRITTEN_BY"]</data>
  <data key="d6">"On the Black Hill" was written by Charles Bruce Chatwin.</data>
  <data key="d7">[{"text": "He won the James Tait Black Memorial Prize for his novel \"On the Black Hill\" (1982) and his novel \"Utz\" (1988) was shortlisted for the Man Booker Prize.", "chunk_id": "b14a713a662d5851", "doc_id": "hp_43f0ffd390903b19", "type": "WRITTEN_BY"}]</data>
  <data key="d8">hp_43f0ffd390903b19</data>
</edge>
