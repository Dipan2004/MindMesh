<edge source="Scombroid food poisoning" target="foodborne illness">
  <data key="d5">["IS_A"]</data>
  <data key="d6">Scombroid food poisoning is a type of foodborne illness.</data>
  <data key="d7">[{"text": "Scombroid food poisoning is a foodborne illness that results from eating spoiled (decayed) fish.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f", "type": "IS_A"}]</data>
  <data key="d8">hp_837937fae6ec3e6f</data>
</edge>
<edge source="Scombroid food poisoning" target="fish">
  <data key="d5">["RESULTS_FROM"]</data>
  <data key="d6">Scombroid food poisoning results from eating spoiled (decayed) fish.</data>
  <data key="d7">[{"text": "Scombroid food poisoning is a foodborne illness that results from eating spoiled (decayed) fish.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f", "type": "RESULTS_FROM"}]</data>
