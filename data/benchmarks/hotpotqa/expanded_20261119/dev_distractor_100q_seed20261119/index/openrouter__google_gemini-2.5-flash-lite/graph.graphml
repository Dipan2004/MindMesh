  <data key="d2">[{"text": "Founded in 1960, it mainly serves the cities of Whittier, Pico Rivera, Santa Fe Springs, El Monte, and South El Monte.", "chunk_id": "75ff884d3fae85e2", "doc_id": "hp_46658770e8628bf3"}]</data>
