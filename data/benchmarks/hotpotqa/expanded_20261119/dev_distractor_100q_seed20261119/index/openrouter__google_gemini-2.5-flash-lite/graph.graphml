  <data key="d2">[{"text": "High Street is one of the main thoroughfares and shopping areas in the city centre of Sheffield in South Yorkshire, England, located at the approximate grid reference of [ SK356874] .", "chunk_id": "7ad43fdb3c803322", "doc_id": "hp_a76877312504b02e"}]</data>
  <data key="d3">["hp_a76877312504b02e"]</data>
  <data key="d4">False</data>
