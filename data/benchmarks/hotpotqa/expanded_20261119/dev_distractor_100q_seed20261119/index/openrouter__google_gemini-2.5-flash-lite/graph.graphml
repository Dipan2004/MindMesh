  <data key="d6">The album 14:59 charted on the Billboard 200.</data>
  <data key="d7">[{"text": "It entered the top 20 on the \"Billboard\" 200, peaking at number 17&lt;ref name=\"1459/billboard\"&gt; &lt;/ref&gt; and certified triple-platinum by the RIAA.", "chunk_id": "a83c783458cb120f", "doc_id": "hp_767039256bd5743c", "type": "CHARTED_ON"}]</data>
