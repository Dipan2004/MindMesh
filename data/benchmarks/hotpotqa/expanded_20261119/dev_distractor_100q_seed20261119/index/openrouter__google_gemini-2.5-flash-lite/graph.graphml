</node>
<node id="Hafþór Júlíus Björnsson">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A competitor who holds 3 titles in Europe's Strongest Man.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}, {"text": "An athlete from Iceland who placed third in the 2013 World's Strongest Man competition.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "An athlete from Iceland who finished in second place in the 2014 World's Strongest Man competition.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d2">[{"text": "Zydrunas Savickas, Geoff Capes, Riku Kiri and Hafþór Júlíus Björnsson each hold 3 titles.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}, {"text": "Zydrunas Savickas from Lithuania was second after finishing 1st the year before, and Hafþór Júlíus Björnsson from Iceland was third for the second year in a row.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "Hafþór Júlíus Björnsson from Iceland finished in second place, and Brian Shaw from the United States came in third.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d3">["hp_3957e4fb7391cc33", "hp_45c17b9e08342c16", "hp_5d64f24bd8d85ba4"]</data>
  <data key="d4">False</data>
</node>
<node id="Giants Live">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A season of annual grand prix events that includes the Europe's Strongest Man contest as of 2010.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}]</data>
  <data key="d2">[{"text": "As of 2010, the Europe's Strongest Man contest has become a part of the Giants Live season of annual grand prix events.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}]</data>
