  <data key="d2">[{"text": "Fisher School–High Street Historic District is a historic district at 748-850; 751-823 High Street in Westwood, Massachusetts.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d3">["hp_cdf4d14bbc02d78d"]</data>
  <data key="d4">False</data>
</node>
<node id="Massachusetts Route 109">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A state route that High Street is part of.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d2">[{"text": "It includes a relatively short stretch of High Street (Massachusetts Route 109) south of Westwood's commercial heart, extending from just south of its junction with Hartford Street to the cemetery at High and Nahatan Streets.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d3">["hp_cdf4d14bbc02d78d"]</data>
  <data key="d4">False</data>
</node>
<node id="Hartford Street">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A street in Westwood, Massachusetts, mentioned in relation to the Fisher School–High Street Historic District.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d2">[{"text": "It includes a relatively short stretch of High Street (Massachusetts Route 109) south of Westwood's commercial heart, extending from just south of its junction with Hartford Street to the cemetery at High and Nahatan Streets.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d3">["hp_cdf4d14bbc02d78d"]</data>
  <data key="d4">False</data>
</node>
<node id="Nahatan Streets">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A street in Westwood, Massachusetts, mentioned in relation to the Fisher School–High Street Historic District.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d2">[{"text": "It includes a relatively short stretch of High Street (Massachusetts Route 109) south of Westwood's commercial heart, extending from just south of its junction with Hartford Street to the cemetery at High and Nahatan Streets.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d3">["hp_cdf4d14bbc02d78d"]</data>
  <data key="d4">False</data>
</node>
<node id="Federal houses">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A style of house from the early 19th century found in the Fisher School–High Street Historic District.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d2">[{"text": "It is distinguished by its concentration of Federal and Greek Revival houses from the early 19th century.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d3">["hp_cdf4d14bbc02d78d"]</data>
  <data key="d4">False</data>
</node>
<node id="Greek Revival houses">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A style of house from the early 19th century found in the Fisher School–High Street Historic District.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d2">[{"text": "It is distinguished by its concentration of Federal and Greek Revival houses from the early 19th century.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d3">["hp_cdf4d14bbc02d78d"]</data>
  <data key="d4">False</data>
</node>
<node id="First Baptist Church">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A church built in 1809 using timbers from an earlier meeting house, located in the Fisher School–High Street Historic District.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d2">[{"text": "Prominent in the district is the First Baptist Church, which was built near its present location in 1809 using timbers from an earlier 1731 meeting house, and the 1845 Greek Revival District #9 School, also known as the Fisher School, which has been restored by the Westwood Historical Society.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d3">["hp_cdf4d14bbc02d78d"]</data>
  <data key="d4">False</data>
</node>
<node id="meeting house">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An earlier structure from 1731, whose timbers were used to build the First Baptist Church.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d2">[{"text": "Prominent in the district is the First Baptist Church, which was built near its present location in 1809 using timbers from an earlier 1731 meeting house, and the 1845 Greek Revival District #9 School, also known as the Fisher School, which has been restored by the Westwood Historical Society.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d3">["hp_cdf4d14bbc02d78d"]</data>
  <data key="d4">False</data>
</node>
<node id="District #9 School">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Greek Revival school built in 1845, also known as the Fisher School, located in the Fisher School–High Street Historic District.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d2">[{"text": "Prominent in the district is the First Baptist Church, which was built near its present location in 1809 using timbers from an earlier 1731 meeting house, and the 1845 Greek Revival District #9 School, also known as the Fisher School, which has been restored by the Westwood Historical Society.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d3">["hp_cdf4d14bbc02d78d"]</data>
  <data key="d4">False</data>
</node>
<node id="Fisher School">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Another name for the District #9 School, a Greek Revival school built in 1845.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
  <data key="d2">[{"text": "Prominent in the district is the First Baptist Church, which was built near its present location in 1809 using timbers from an earlier 1731 meeting house, and the 1845 Greek Revival District #9 School, also known as the Fisher School, which has been restored by the Westwood Historical Society.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
