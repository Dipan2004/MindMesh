<node id="Church Street">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Church Street is a street that forms a Y-junction with High Street near Sheffield Cathedral.", "chunk_id": "7ad43fdb3c803322", "doc_id": "hp_a76877312504b02e"}, {"text": "Church Streets is a street located in Middletown, between which and Washington Streets was a prestigious residential area.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d2">[{"text": "High Street starts at the Commercial Street, Fitzalan Square and Haymarket junction and runs for approximately 400 metres west to conclude near the Sheffield Cathedral where it forms a Y-junction with Fargate and Church Street.", "chunk_id": "7ad43fdb3c803322", "doc_id": "hp_a76877312504b02e"}, {"text": "High Street between Church and Washington Streets was the most prestigious residential area in Middletown during the 19th century.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d3">["hp_a76877312504b02e", "hp_a8f5a77458dad7ce"]</data>
