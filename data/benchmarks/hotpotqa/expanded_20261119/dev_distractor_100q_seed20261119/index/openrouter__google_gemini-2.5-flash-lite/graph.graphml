  <data key="d6">Standard Oil Company of Iowa is the original company that is now Chevron Corporation.</data>
  <data key="d7">[{"text": "Standard Oil Company of Iowa is thus the original company that is now Chevron.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1", "type": "ORIGINAL_COMPANY_OF"}]</data>
