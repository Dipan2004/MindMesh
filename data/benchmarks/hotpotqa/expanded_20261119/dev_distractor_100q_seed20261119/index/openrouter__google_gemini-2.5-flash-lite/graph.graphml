<node id="Buddhism">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A religion for which Mount Jizu is a holy mountain.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d2">[{"text": "Mount Jizu is a famed holy mountain in Buddhism.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d3">["hp_b7298b1cd3170cc8"]</data>
  <data key="d4">False</data>
</node>
<node id="Tianzhu Peak">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The main peak of Mount Jizu, rising 3,240 metres above sea level.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d2">[{"text": "Its main peak, Tianzhu Peak, rises some 3,240 metres above sea level.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d3">["hp_b7298b1cd3170cc8"]</data>
  <data key="d4">False</data>
</node>
<node id="Mount Cock's Foot">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A common name for Mount Jizu, derived from its appearance.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d2">[{"text": "With three mountain ranges to the front and one range to the rear, it appears like a cock's foot, hence its common name Mount Cock's Foot or Mt. Cock's Claw.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d3">["hp_b7298b1cd3170cc8"]</data>
  <data key="d4">False</data>
</node>
<node id="Mt. Cock's Claw">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Another common name for Mount Jizu, derived from its appearance.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d2">[{"text": "With three mountain ranges to the front and one range to the rear, it appears like a cock's foot, hence its common name Mount Cock's Foot or Mt. Cock's Claw.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d3">["hp_b7298b1cd3170cc8"]</data>
  <data key="d4">False</data>
</node>
