<edge source="Florence and the Machine" target="Berkeley, California">
  <data key="d5">["PERFORMED_IN"]</data>
  <data key="d6">Florence and the Machine performed the song in Berkeley, California.</data>
  <data key="d7">[{"text": "After the band performed the song in Berkeley, California on 12 June 2011, the studio version premiered on Florence and the Machine's official website.", "chunk_id": "4a33b3fb6c1ee1fa", "doc_id": "hp_7804b34667739a36", "type": "PERFORMED_IN"}]</data>
