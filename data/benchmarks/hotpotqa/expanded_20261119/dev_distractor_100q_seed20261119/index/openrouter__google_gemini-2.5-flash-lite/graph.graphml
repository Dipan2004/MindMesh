<node id="Catan">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A multiplayer board game designed by Klaus Teuber.", "chunk_id": "492ee6567ec9e1c7", "doc_id": "hp_27d7c27c384bbb29"}, {"text": "A series of games that includes The Rivals for Catan.", "chunk_id": "155359f8ca0aea2f", "doc_id": "hp_5f6bdf06a278e8d8"}, {"text": "A series of games that includes the Catan Card Game.", "chunk_id": "dbfe350afe445342", "doc_id": "hp_a2aabfc161961b2c"}, {"text": "A place that can be defended against a common foe using knights.", "chunk_id": "42769d289195cfc3", "doc_id": "hp_c20f6b270e53f1ff"}]</data>
  <data key="d2">[{"text": "The Settlers of Catan, sometimes shortened to Catan or Settlers, is a multiplayer board game designed by Klaus Teuber and first published in 1995 in Germany by Franckh-Kosmos Verlag (Kosmos) as Die Siedler von Catan.", "chunk_id": "492ee6567ec9e1c7", "doc_id": "hp_27d7c27c384bbb29"}, {"text": "It is a member of the \"Catan\" series of games, and is published by Kosmos in German and Mayfair Games in English.", "chunk_id": "155359f8ca0aea2f", "doc_id": "hp_5f6bdf06a278e8d8"}, {"text": "It is a member of the \"Catan\" series of games, and is published by Kosmos in German, and Mayfair Games in English.", "chunk_id": "dbfe350afe445342", "doc_id": "hp_a2aabfc161961b2c"}, {"text": "It contains features taken from \"The Settlers of Catan\", with emphasis on city development and the use of knights, which are used as a method of attacking other players as well as helping opponents defend Catan against a common foe.", "chunk_id": "42769d289195cfc3", "doc_id": "hp_c20f6b270e53f1ff"}]</data>
  <data key="d3">["hp_27d7c27c384bbb29", "hp_5f6bdf06a278e8d8", "hp_a2aabfc161961b2c", "hp_c20f6b270e53f1ff"]</data>
  <data key="d4">False</data>
</node>
