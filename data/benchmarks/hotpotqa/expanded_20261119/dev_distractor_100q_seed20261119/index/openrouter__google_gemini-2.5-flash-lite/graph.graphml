<node id="Suddenlink Communications">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Suddenlink Communications is an American telecommunications subsidiary of Altice USA.", "chunk_id": "830f5fe0561239db", "doc_id": "hp_a5b89b682cc56c9c"}]</data>
  <data key="d2">[{"text": "Suddenlink Communications is an American telecommunications subsidiary of Altice USA which specializes in cable television, high-speed internet, broadband phone, home security and advertising.", "chunk_id": "830f5fe0561239db", "doc_id": "hp_a5b89b682cc56c9c"}]</data>
  <data key="d3">["hp_a5b89b682cc56c9c"]</data>
  <data key="d4">False</data>
</node>
<node id="Altice USA">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Altice USA is the parent company of Suddenlink Communications and was formed after acquiring Cablevision Systems Corporation.", "chunk_id": "830f5fe0561239db", "doc_id": "hp_a5b89b682cc56c9c"}]</data>
  <data key="d2">[{"text": "Suddenlink Communications is an American telecommunications subsidiary of Altice USA which specializes in cable television, high-speed internet, broadband phone, home security and advertising.", "chunk_id": "830f5fe0561239db", "doc_id": "hp_a5b89b682cc56c9c"}]</data>
  <data key="d3">["hp_a5b89b682cc56c9c"]</data>
  <data key="d4">False</data>
</node>
<node id="Cablevision Systems Corporation">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Cablevision Systems Corporation, also known as Cablevision, was acquired by Altice and combined with Suddenlink.", "chunk_id": "830f5fe0561239db", "doc_id": "hp_a5b89b682cc56c9c"}]</data>
  <data key="d2">[{"text": "After Altice acquired Cablevision Systems Corporation (Cablevision) on November 30, 2016 Suddenlink was combined with Cablevision to become Altice's American division known as Altice USA.", "chunk_id": "830f5fe0561239db", "doc_id": "hp_a5b89b682cc56c9c"}]</data>
  <data key="d3">["hp_a5b89b682cc56c9c"]</data>
  <data key="d4">False</data>
</node>
<node id="Cablevision">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Cablevision is an alternative name for Cablevision Systems Corporation.", "chunk_id": "830f5fe0561239db", "doc_id": "hp_a5b89b682cc56c9c"}]</data>
  <data key="d2">[{"text": "After Altice acquired Cablevision Systems Corporation (Cablevision) on November 30, 2016 Suddenlink was combined with Cablevision to become Altice's American division known as Altice USA.", "chunk_id": "830f5fe0561239db", "doc_id": "hp_a5b89b682cc56c9c"}]</data>
  <data key="d3">["hp_a5b89b682cc56c9c"]</data>
  <data key="d4">False</data>
</node>
<node id="Optimum">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Optimum is the service brand name used by Cablevision for its products.", "chunk_id": "830f5fe0561239db", "doc_id": "hp_a5b89b682cc56c9c"}]</data>
  <data key="d2">[{"text": "Together with Optimum, the service brand name used by Cablevision for its products, Altice USA became the United States' fourth largest cable operator with 4.6 million subscribers and the sixth largest pay tv service provider with 3.50 million subscribers.", "chunk_id": "830f5fe0561239db", "doc_id": "hp_a5b89b682cc56c9c"}]</data>
  <data key="d3">["hp_a5b89b682cc56c9c"]</data>
  <data key="d4">False</data>
</node>
<node id="Bokuzen Hidari">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Bokuzen Hidari was a Japanese actor and comedian.", "chunk_id": "bd018a45665dcb2e", "doc_id": "hp_a6decab6ae6a1912"}]</data>
  <data key="d2">[{"text": "Bokuzen Hidari (左 卜全 , Hidari Bokuzen , 20 February 1894 - 26 May 1971) was a Japanese actor and comedian born in Kotesashi Village (now part of Tokorozawa), Iruma District, Saitama Prefecture, Japan.", "chunk_id": "bd018a45665dcb2e", "doc_id": "hp_a6decab6ae6a1912"}]</data>
