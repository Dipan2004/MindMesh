  <data key="d5">["RISES_ABOVE"]</data>
  <data key="d6">The Farset river rises above Legoniel.</data>
  <data key="d7">[{"text": "The Farset rises above Legoniel, flowed past the medieval parish church at Shankill, through Millfield and under High Street, giving that street a curving appearance, entering the Lagan to the east of the Albert Clock and High Street.", "chunk_id": "ffad64e807ea3b1b", "doc_id": "hp_cc911f866aa0efaa", "type": "RISES_ABOVE"}]</data>
  <data key="d8">hp_cc911f866aa0efaa</data>
