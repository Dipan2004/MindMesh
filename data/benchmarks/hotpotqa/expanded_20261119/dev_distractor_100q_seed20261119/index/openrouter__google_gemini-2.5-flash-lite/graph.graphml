<node id="Neil">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A nickname for Donald Neil Kerley.", "chunk_id": "442043eeaf880949", "doc_id": "hp_fe3fc60bc7758add"}]</data>
  <data key="d2">[{"text": "Known to his mates as either Neil or Knuckles and to South Australian football fans as King Kerley or simply \"Kerls\", he is best known for taking three clubs to four South Australian National Football League (SANFL) premierships over three decades as both a player and coach and for playing 32 state games for South Australia.", "chunk_id": "442043eeaf880949", "doc_id": "hp_fe3fc60bc7758add"}]</data>
  <data key="d3">["hp_fe3fc60bc7758add"]</data>
