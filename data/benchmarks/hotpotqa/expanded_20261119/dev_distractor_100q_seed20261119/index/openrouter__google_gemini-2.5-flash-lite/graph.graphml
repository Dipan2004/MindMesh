  <data key="d7">[{"text": "The film, about an ordinary young couple named Kosuke and Mao, is based on a novel by Osamu Koshigaya of the same name that ranked first among novels which Japanese girls wanted boys to read in the year 2011, and has sold more than one million copies in Japan.", "chunk_id": "fd13834eff44cf9c", "doc_id": "hp_b39f0237511ae07e", "type": "BASED_ON"}]</data>
