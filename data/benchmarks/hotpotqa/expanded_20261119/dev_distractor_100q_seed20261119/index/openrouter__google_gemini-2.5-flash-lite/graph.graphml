  <data key="d5">["PARTICIPATED_IN"]</data>
  <data key="d6">The German 1st Army was involved in the operations on the Ancre.</data>
  <data key="d7">[{"text": "Operations on the Ancre took place from 11 January – 13 March 1917, between the British Fifth Army and the German 1st Army, on the Somme front during the First World War.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad", "type": "PARTICIPATED_IN"}]</data>
  <data key="d8">hp_d6e57e7111053cad</data>
</edge>
