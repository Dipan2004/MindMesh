  <data key="d2">[{"text": "Frontwoman Florence Welch experimented with and honed the album's sound with bandmate Isabella Summers, while also collaborating with five record producers including James Ford, Paul Epworth, Steve Mackey.", "chunk_id": "2055480b7468cc45", "doc_id": "hp_4dcfe55bb1e0d25f"}]</data>
