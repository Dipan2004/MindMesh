<node id="Tikkun">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A tikkun or tiqqun is a book used by Jews to prepare for reading or writing a Torah scroll.", "chunk_id": "3853c8ec18df06f6", "doc_id": "hp_3a31e87c9b9c8fd2"}, {"text": "Tikkun is a magazine where Karp's paintings appeared.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}, {"text": "\"Tikkun\" is a progressive Jewish interfaith magazine.", "chunk_id": "b15598f798e631b6", "doc_id": "hp_ebb527a8921b04b5"}, {"text": "Tikkun is a quarterly interfaith Jewish left-progressive magazine.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1"}]</data>
  <data key="d2">[{"text": "A tikkun or tiqqun (Hebrew: תיקון‎ ) is a book used by Jews to prepare for reading or writing a Torah scroll.", "chunk_id": "3853c8ec18df06f6", "doc_id": "hp_3a31e87c9b9c8fd2"}, {"text": "Paintings of Karp's appeared in the November/December 2008 issue of \"Tikkun\" magazine and by the \"Tikkun\" editor's August 2009 online blog and in the spring 2012 issue of \"On the Issues\" Magazine.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}, {"text": "Michael Lerner (born 1943) is an American political activist, the editor of \"Tikkun\", a progressive Jewish interfaith magazine based in Berkeley, California, and the rabbi of Beyt Tikkun Synagogue in Berkeley.", "chunk_id": "b15598f798e631b6", "doc_id": "hp_ebb527a8921b04b5"}, {"text": "Tikkun is a quarterly interfaith Jewish left-progressive magazine, published in the United States, that analyzes American and Israeli culture, politics, religion, and history in the English language.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1"}]</data>
  <data key="d3">["hp_3a31e87c9b9c8fd2", "hp_65a971e7a10d79c8", "hp_ebb527a8921b04b5", "hp_f15a13a6272383b1"]</data>
  <data key="d4">False</data>
</node>
