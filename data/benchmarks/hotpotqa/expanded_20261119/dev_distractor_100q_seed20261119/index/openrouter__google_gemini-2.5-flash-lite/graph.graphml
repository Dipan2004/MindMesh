<node id="Hell Gate channel">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Hell Gate channel is a strait in the East River, separating the boroughs of Manhattan and Queens.", "chunk_id": "3d263a06d589ae09", "doc_id": "hp_4c7c0e0e98b5650e"}]</data>
  <data key="d2">[{"text": "The mansion overlooks Hell Gate channel in the East River.", "chunk_id": "3d263a06d589ae09", "doc_id": "hp_4c7c0e0e98b5650e"}]</data>
