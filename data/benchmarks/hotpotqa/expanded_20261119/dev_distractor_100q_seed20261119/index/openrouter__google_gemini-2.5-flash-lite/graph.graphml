  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "St Mary the Virgin is one of the dedications of Chelmsford Cathedral.", "chunk_id": "a46d15f8c3fc12ac", "doc_id": "hp_c098515d47bb4e6e"}]</data>
  <data key="d2">[{"text": "Chelmsford Cathedral in the city of Chelmsford, Essex, England, is dedicated to St Mary the Virgin, St Peter and St Cedd.", "chunk_id": "a46d15f8c3fc12ac", "doc_id": "hp_c098515d47bb4e6e"}]</data>
  <data key="d3">["hp_c098515d47bb4e6e"]</data>
  <data key="d4">False</data>
