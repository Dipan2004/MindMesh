<node id="American University">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "American University is a college in Washington, D.C. that Yannis Pappas attended.", "chunk_id": "6c9e11b0297de1c6", "doc_id": "hp_5788c911b27e82a4"}, {"text": "American University is an institution where Gary Williams served as head coach.", "chunk_id": "777d709f2b113bd2", "doc_id": "hp_a8de6e8688186343"}]</data>
  <data key="d2">[{"text": "Yannis attended college at the American University in Washington, D.C. where he studied American Studies and History.", "chunk_id": "6c9e11b0297de1c6", "doc_id": "hp_5788c911b27e82a4"}, {"text": "He served as the head coach at the University of Maryland, Ohio State University, Boston College, and American University.", "chunk_id": "777d709f2b113bd2", "doc_id": "hp_a8de6e8688186343"}]</data>
  <data key="d3">["hp_5788c911b27e82a4", "hp_a8de6e8688186343"]</data>
