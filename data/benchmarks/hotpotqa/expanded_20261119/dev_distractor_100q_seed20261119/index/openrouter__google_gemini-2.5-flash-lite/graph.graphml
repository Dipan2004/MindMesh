<node id="Prime Minister of Kenya">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The Prime Minister of Kenya was the head of government of Kenya.", "chunk_id": "91f35c37b306bce4", "doc_id": "hp_96146a01a8e436ac"}]</data>
  <data key="d2">[{"text": "It was the residence of the Prime Minister of Kenya from independence until Kenya (12 Dec 1963) transformed into a republic (12 Dec 1964).", "chunk_id": "91f35c37b306bce4", "doc_id": "hp_96146a01a8e436ac"}]</data>
