<node id="BBC">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A British broadcasting company that produced a similar series.", "chunk_id": "f7949c0c0e713fa5", "doc_id": "hp_0fa7f8efa8e13f38"}, {"text": "The British Broadcasting Corporation, a public service broadcaster.", "chunk_id": "f54971948ab8acd8", "doc_id": "hp_327a998a822bc9e6"}, {"text": "The broadcaster of the documentary television series 'The Day the Universe Changed'.", "chunk_id": "641da45da986e5ce", "doc_id": "hp_58b33fe59f58c1ed"}, {"text": "A media organization that played a large part in promoting Florence and the Machine.", "chunk_id": "a0e37e5744f28418", "doc_id": "hp_6d4a91fc9052bf4e"}]</data>
  <data key="d2">[{"text": "Freaky Eaters is an American documentary television series based on the BBC series of the same name that aired on TLC.", "chunk_id": "f7949c0c0e713fa5", "doc_id": "hp_0fa7f8efa8e13f38"}, {"text": "Absolutely Fabulous, also known as Ab Fab, is a BBC television sitcom created by, written by and starring Jennifer Saunders.", "chunk_id": "f54971948ab8acd8", "doc_id": "hp_327a998a822bc9e6"}, {"text": "The Day the Universe Changed: A Personal View by James Burke is a British documentary television series written and presented by science historian James Burke, originally broadcast on BBC1 from 19 March until 21 May 1985 by the BBC.", "chunk_id": "641da45da986e5ce", "doc_id": "hp_58b33fe59f58c1ed"}, {"text": "The band's music received praise across the media, especially from the BBC, which played a large part in their rise to prominence by promoting Florence and the Machine as part of \"BBC Introducing\".", "chunk_id": "a0e37e5744f28418", "doc_id": "hp_6d4a91fc9052bf4e"}]</data>
  <data key="d3">["hp_0fa7f8efa8e13f38", "hp_327a998a822bc9e6", "hp_58b33fe59f58c1ed", "hp_6d4a91fc9052bf4e"]</data>
  <data key="d4">False</data>
</node>
