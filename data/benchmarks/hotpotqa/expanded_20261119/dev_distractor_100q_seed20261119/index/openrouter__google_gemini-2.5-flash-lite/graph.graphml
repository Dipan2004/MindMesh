  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The American Expeditionary Forces (AEF) was a unit of the United States Army in World War I.", "chunk_id": "3e06e403a963f53b", "doc_id": "hp_ec775ce2037fd502"}]</data>
  <data key="d2">[{"text": "His most famous post was when he served as the commander of the American Expeditionary Force (AEF) on the Western Front in World War I, 1917–18.", "chunk_id": "3e06e403a963f53b", "doc_id": "hp_ec775ce2037fd502"}]</data>
