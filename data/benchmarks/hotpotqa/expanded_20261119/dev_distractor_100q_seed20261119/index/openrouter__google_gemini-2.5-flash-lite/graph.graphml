<edge source="Thomas Welton Stanford" target="Stanford University">
  <data key="d5">["PHILANTHROPIST_TOWARD"]</data>
  <data key="d6">Thomas Welton Stanford was a philanthropist toward Stanford University.</data>
  <data key="d7">[{"text": "Thomas Welton Stanford (1832 - 1918), also known as Welton Stanford, was an American-born Australian businessman, spiritualist and philanthropist, most notably toward Stanford University, which was founded by his older brother Leland Stanford.", "chunk_id": "232d1486ef3116d2", "doc_id": "hp_69dbe4380588b108", "type": "PHILANTHROPIST_TOWARD"}]</data>
