<edge source="Alvin Rakoff" target="Sam Saturday">
  <data key="d5">["CREATED_BY"]</data>
  <data key="d6">Alvin Rakoff created the television series Sam Saturday.</data>
  <data key="d7">[{"text": "The series was created by writer and director Alvin Rakoff, and was produced by the production company of executive producer Verity Lambert.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498", "type": "CREATED_BY"}]</data>
