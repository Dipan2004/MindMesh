<node id="Notre Dame High School">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Notre Dame High School is a Roman Catholic secondary school and sixth form with academy status.", "chunk_id": "379e79f8fef657ef", "doc_id": "hp_33fd17055c06917a"}, {"text": "A high school attended by Tyler Asemota.", "chunk_id": "21c5f5a9893cff0d", "doc_id": "hp_449285fab9db13ba"}, {"text": "A comprehensive state school for girls located on Observatory Road in Glasgow, Scotland.", "chunk_id": "e7083278f65fe2f0", "doc_id": "hp_4b9fa482e8ceec5a"}, {"text": "Notre Dame High School was an all-boys high school in Biloxi.", "chunk_id": "5a5115962ecded96", "doc_id": "hp_58c669219cc725e7"}, {"text": "Notre Dame High School is an all female second cycle institution.", "chunk_id": "eed6c2be6086f74b", "doc_id": "hp_a6b84c955b0481e0"}, {"text": "A private, all-female, Catholic, college preparatory high school.", "chunk_id": "62dbcbf4d4fa43a6", "doc_id": "hp_fc280682a135c497"}]</data>
  <data key="d2">[{"text": "Notre Dame High School is a Roman Catholic secondary school and sixth form with academy status located in Norwich, England.", "chunk_id": "379e79f8fef657ef", "doc_id": "hp_33fd17055c06917a"}, {"text": "Asemota currently attends Notre Dame High School and has been a student there for all four years.", "chunk_id": "21c5f5a9893cff0d", "doc_id": "hp_449285fab9db13ba"}, {"text": "Notre Dame High School is a comprehensive state school for girls located on Observatory Road in Glasgow, Scotland, and founded in 1897.", "chunk_id": "e7083278f65fe2f0", "doc_id": "hp_4b9fa482e8ceec5a"}, {"text": "It was the merger of two of Biloxi's most iconic high schools, Sacred Heart High School and Notre Dame High School.", "chunk_id": "5a5115962ecded96", "doc_id": "hp_58c669219cc725e7"}, {"text": "Notre Dame High School is an all female second cycle institution in Fiapre in the Brong-Ahafo Region of Ghana.", "chunk_id": "eed6c2be6086f74b", "doc_id": "hp_a6b84c955b0481e0"}, {"text": "Notre Dame High School, Belmont is a private, All-Female, Catholic, college preparatory high school located in the San Mateo County suburb of Belmont, California.", "chunk_id": "62dbcbf4d4fa43a6", "doc_id": "hp_fc280682a135c497"}]</data>
  <data key="d3">["hp_33fd17055c06917a", "hp_449285fab9db13ba", "hp_4b9fa482e8ceec5a", "hp_58c669219cc725e7", "hp_a6b84c955b0481e0", "hp_fc280682a135c497"]</data>
  <data key="d4">False</data>
</node>
