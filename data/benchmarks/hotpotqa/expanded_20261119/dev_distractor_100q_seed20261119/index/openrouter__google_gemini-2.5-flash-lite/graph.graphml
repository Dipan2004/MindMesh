  <data key="d7">[{"text": "\"When It's Over\" is a song by American rock band Sugar Ray and it was released in May 2001 as the lead single from their self-titled fourth album \"Sugar Ray\".", "chunk_id": "ea9f0bb2bf44b926", "doc_id": "hp_f61e6f2275345f39", "type": "PERFORMED_BY"}, {"text": "\"When It's Over\" is a song by American rock band Sugar Ray and it was released in May 2001 as the lead single from their self-titled fourth album \"Sugar Ray\".", "chunk_id": "ea9f0bb2bf44b926", "doc_id": "hp_f61e6f2275345f39", "type": "LEAD_SINGLE_FROM"}]</data>
