<node id="Twin Rivers Unit (TRU)">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Twin Rivers Unit (TRU) is the current name for the Twin Rivers Corrections Center.", "chunk_id": "d24d4e77587afaf2", "doc_id": "hp_34a0774a7cc42661"}]</data>
  <data key="d2">[{"text": "It is now referred to as Twin Rivers Unit (TRU).", "chunk_id": "d24d4e77587afaf2", "doc_id": "hp_34a0774a7cc42661"}]</data>
  <data key="d3">["hp_34a0774a7cc42661"]</data>
  <data key="d4">False</data>
</node>
<node id="General Educational Development (GED) certificate">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A General Educational Development (GED) certificate is an educational program that inmates may earn.", "chunk_id": "d24d4e77587afaf2", "doc_id": "hp_34a0774a7cc42661"}]</data>
  <data key="d2">[{"text": "Such programs may include earning a General Educational Development (GED) certificate, or sexual offender or chemical dependency treatment.", "chunk_id": "d24d4e77587afaf2", "doc_id": "hp_34a0774a7cc42661"}]</data>
  <data key="d3">["hp_34a0774a7cc42661"]</data>
  <data key="d4">False</data>
</node>
<node id="sexual offender treatment">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Sexual offender treatment is a program that inmates may participate in.", "chunk_id": "d24d4e77587afaf2", "doc_id": "hp_34a0774a7cc42661"}]</data>
  <data key="d2">[{"text": "Such programs may include earning a General Educational Development (GED) certificate, or sexual offender or chemical dependency treatment.", "chunk_id": "d24d4e77587afaf2", "doc_id": "hp_34a0774a7cc42661"}]</data>
  <data key="d3">["hp_34a0774a7cc42661"]</data>
  <data key="d4">False</data>
</node>
<node id="chemical dependency treatment">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Chemical dependency treatment is a program that inmates may participate in.", "chunk_id": "d24d4e77587afaf2", "doc_id": "hp_34a0774a7cc42661"}]</data>
  <data key="d2">[{"text": "Such programs may include earning a General Educational Development (GED) certificate, or sexual offender or chemical dependency treatment.", "chunk_id": "d24d4e77587afaf2", "doc_id": "hp_34a0774a7cc42661"}]</data>
  <data key="d3">["hp_34a0774a7cc42661"]</data>
  <data key="d4">False</data>
</node>
<node id="Class III industries">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Class III industries are types of work that inmates can do, such as janitorial, clerical, or kitchen work.", "chunk_id": "d24d4e77587afaf2", "doc_id": "hp_34a0774a7cc42661"}]</data>
  <data key="d2">[{"text": "Class III industries include janitorial, clerical or kitchen work, for example.", "chunk_id": "d24d4e77587afaf2", "doc_id": "hp_34a0774a7cc42661"}]</data>
  <data key="d3">["hp_34a0774a7cc42661"]</data>
  <data key="d4">False</data>
</node>
<node id="Occidental Hotel">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Occidental Hotel was a hotel that opened in San Francisco, California in 1861.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}]</data>
  <data key="d2">[{"text": "The Occidental Hotel opened in 1861 in San Francisco, California.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}]</data>
  <data key="d3">["hp_350233375cc7c884"]</data>
  <data key="d4">False</data>
</node>
<node id="San Francisco earthquake and subsequent fire of 1906">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A significant natural disaster that destroyed the Occidental Hotel.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}]</data>
  <data key="d2">[{"text": "It was destroyed in the San Francisco earthquake and subsequent fire of 1906.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}]</data>
  <data key="d3">["hp_350233375cc7c884"]</data>
  <data key="d4">False</data>
</node>
<node id="Occidental">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A name used for multiple hotels in the United States.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}]</data>
  <data key="d2">[{"text": "It was one of the many hotels named Occidental in the United States, and it was among the few luxury hotels in San Francisco that catered to wealthy travelers.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}]</data>
  <data key="d3">["hp_350233375cc7c884"]</data>
  <data key="d4">False</data>
</node>
<node id="California Gold Rush">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A historical period that coincided with the operation of the Occidental Hotel.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}]</data>
  <data key="d2">[{"text": "Operating in the years that roughly coincided with the end of the California Gold Rush and the beginning of silver mining in Nevada, the Occidental Hotel was among the new, grand hotels in San Francisco.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}]</data>
  <data key="d3">["hp_350233375cc7c884"]</data>
  <data key="d4">False</data>
</node>
<node id="silver mining in Nevada">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An economic activity that began in Nevada and coincided with the operation of the Occidental Hotel.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}]</data>
  <data key="d2">[{"text": "Operating in the years that roughly coincided with the end of the California Gold Rush and the beginning of silver mining in Nevada, the Occidental Hotel was among the new, grand hotels in San Francisco.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}]</data>
  <data key="d3">["hp_350233375cc7c884"]</data>
  <data key="d4">False</data>
</node>
<node id="Nevada">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A state where silver mining began.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}, {"text": "A state where May Company California operated department stores.", "chunk_id": "a4a90e9e8bea2ac1", "doc_id": "hp_5c13848c5f73cf0b"}, {"text": "Nevada is a US state where Gigafactory 1 is located.", "chunk_id": "51ed4dfb52cf2e60", "doc_id": "hp_5df9f2d47c876b64"}, {"text": "A state in the Western United States.", "chunk_id": "53d19b7b5423b1f7", "doc_id": "hp_63a714bc28813989"}, {"text": "Nevada is a state where Robinsons-May operated.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d2">[{"text": "Operating in the years that roughly coincided with the end of the California Gold Rush and the beginning of silver mining in Nevada, the Occidental Hotel was among the new, grand hotels in San Francisco.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}, {"text": "May Company California was a chain of department stores operating in Southern California and Nevada, with headquarters in North Hollywood, California.", "chunk_id": "a4a90e9e8bea2ac1", "doc_id": "hp_5c13848c5f73cf0b"}, {"text": "The Tesla Gigafactory 1 is an operational lithium-ion battery factory under construction, primarily for Tesla Inc., at the Tahoe Reno Industrial Center (TRIC) in Storey County (near the Community of Clark, Nevada, US).", "chunk_id": "51ed4dfb52cf2e60", "doc_id": "hp_5df9f2d47c876b64"}, {"text": "The Tahoe Reno Industrial Center (TRI Center, or TRIC) is a privately owned 107,000 acre industrial park, located at Interstate 80 next to Clark, Storey County, Nevada.", "chunk_id": "53d19b7b5423b1f7", "doc_id": "hp_63a714bc28813989"}, {"text": "Robinsons-May was a chain of department stores operating in Southern California, Arizona and Las Vegas, Nevada, previously with headquarters in North Hollywood, California.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d3">["hp_350233375cc7c884", "hp_5c13848c5f73cf0b", "hp_5df9f2d47c876b64", "hp_63a714bc28813989", "hp_70e1b920ca70d1e9"]</data>
  <data key="d4">False</data>
</node>
<node id="Lick House">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A hotel in San Francisco that was part of the exclusive hotel market.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}]</data>
  <data key="d2">[{"text": "In the exclusive hotel market, along with the Occidental were the Lick House, the Russ House, the Cosmopolitan, the Grand, the Palace, and the Baldwin.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}]</data>
  <data key="d3">["hp_350233375cc7c884"]</data>
  <data key="d4">False</data>
</node>
