<node id="India">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A country in South Asia, mentioned as the origin of Anil Srinivasan and a location for music education.", "chunk_id": "054fd83d35ee6361", "doc_id": "hp_39d1d2299826213a"}, {"text": "India is a country located on the border with Nepal, where Gimmigela Chuli is situated.", "chunk_id": "739d8f7ea6dfb06f", "doc_id": "hp_3fe42c6ffa4f5604"}, {"text": "India is a country in South Asia.", "chunk_id": "558ffc5b34f36add", "doc_id": "hp_491d2527c689b954"}, {"text": "India is a country in South Asia.", "chunk_id": "578db93c2087665a", "doc_id": "hp_65e5dd7a12e038cc"}, {"text": "India is a country in South Asia.", "chunk_id": "1dc246b063ed2b56", "doc_id": "hp_990cb25e632f49e0"}, {"text": "India is a country in South Asia.", "chunk_id": "d2bfeca63abb17df", "doc_id": "hp_d7ee1e4a5af66927"}]</data>
  <data key="d2">[{"text": "Anil Srinivasan (born June 3, 1977) is a classical pianist from India.", "chunk_id": "054fd83d35ee6361", "doc_id": "hp_39d1d2299826213a"}, {"text": "Gimmigela Chuli, or The Twins, is a mountain in the Himalayas, located on the border between Taplejung, Mechi, Nepal and Sikkim, India.", "chunk_id": "739d8f7ea6dfb06f", "doc_id": "hp_3fe42c6ffa4f5604"}, {"text": "It lies on the border between Nepal and India.", "chunk_id": "558ffc5b34f36add", "doc_id": "hp_491d2527c689b954"}, {"text": "Dregea volubilis is a species of plant in the Apocynaceae family that is native to India.", "chunk_id": "578db93c2087665a", "doc_id": "hp_65e5dd7a12e038cc"}, {"text": "Neyveli Santhanagopalan (born 1963) is an Indian Carnatic vocalist.", "chunk_id": "1dc246b063ed2b56", "doc_id": "hp_990cb25e632f49e0"}, {"text": "Sikkil C. Gurucharan (born on 21 June 1982) is among the foremost young performing musicians of Carnatic music in India today.", "chunk_id": "d2bfeca63abb17df", "doc_id": "hp_d7ee1e4a5af66927"}]</data>
  <data key="d3">["hp_39d1d2299826213a", "hp_3fe42c6ffa4f5604", "hp_491d2527c689b954", "hp_65e5dd7a12e038cc", "hp_990cb25e632f49e0", "hp_d7ee1e4a5af66927"]</data>
  <data key="d4">False</data>
</node>
<node id="Chennai">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The city in India where Anil Srinivasan was born.", "chunk_id": "054fd83d35ee6361", "doc_id": "hp_39d1d2299826213a"}, {"text": "Chennai is a city where Gayathri Venkataraghavan lives.", "chunk_id": "8b6a7287fdd98325", "doc_id": "hp_6a866249e65a5806"}]</data>
  <data key="d2">[{"text": "Born in Chennai, India and educated at the University of Southern California and at Columbia University, New York, he is well known for his collaborative work with Carnatic vocalist Sikkil Gurucharan.", "chunk_id": "054fd83d35ee6361", "doc_id": "hp_39d1d2299826213a"}, {"text": "She lives in Chennai.", "chunk_id": "8b6a7287fdd98325", "doc_id": "hp_6a866249e65a5806"}]</data>
  <data key="d3">["hp_39d1d2299826213a", "hp_6a866249e65a5806"]</data>
  <data key="d4">False</data>
</node>
