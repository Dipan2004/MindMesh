  <data key="d2">[{"text": "Their eldest son, Miles, succeeded his mother in the barony of Beaumont in 1971 and his father in the barony of Howard of Glossop in 1972.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981"}]</data>
