  <data key="d2">[{"text": "Leung Po Shan (Anthony, Chinese: 梁寶山) is a Hong Kong artist specialized in installation and performance art.", "chunk_id": "897f999db778cfd7", "doc_id": "hp_0072f61fd930d308"}]</data>
