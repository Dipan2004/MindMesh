<node id="Thomas Welton Stanford">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An American-born Australian businessman, spiritualist, and philanthropist.", "chunk_id": "232d1486ef3116d2", "doc_id": "hp_69dbe4380588b108"}]</data>
  <data key="d2">[{"text": "Thomas Welton Stanford (1832 - 1918), also known as Welton Stanford, was an American-born Australian businessman, spiritualist and philanthropist, most notably toward Stanford University, which was founded by his older brother Leland Stanford.", "chunk_id": "232d1486ef3116d2", "doc_id": "hp_69dbe4380588b108"}]</data>
  <data key="d3">["hp_69dbe4380588b108"]</data>
  <data key="d4">False</data>
</node>
<node id="Welton Stanford">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An alternative name for Thomas Welton Stanford.", "chunk_id": "232d1486ef3116d2", "doc_id": "hp_69dbe4380588b108"}]</data>
  <data key="d2">[{"text": "Thomas Welton Stanford (1832 - 1918), also known as Welton Stanford, was an American-born Australian businessman, spiritualist and philanthropist, most notably toward Stanford University, which was founded by his older brother Leland Stanford.", "chunk_id": "232d1486ef3116d2", "doc_id": "hp_69dbe4380588b108"}]</data>
  <data key="d3">["hp_69dbe4380588b108"]</data>
  <data key="d4">False</data>
</node>
<node id="Leland Stanford">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The older brother of Thomas Welton Stanford and founder of Stanford University.", "chunk_id": "232d1486ef3116d2", "doc_id": "hp_69dbe4380588b108"}]</data>
  <data key="d2">[{"text": "Thomas Welton Stanford (1832 - 1918), also known as Welton Stanford, was an American-born Australian businessman, spiritualist and philanthropist, most notably toward Stanford University, which was founded by his older brother Leland Stanford.", "chunk_id": "232d1486ef3116d2", "doc_id": "hp_69dbe4380588b108"}]</data>
  <data key="d3">["hp_69dbe4380588b108"]</data>
  <data key="d4">False</data>
</node>
<node id="Melbourne">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city in Australia where Thomas Welton Stanford served as honorary American vice consul-general.", "chunk_id": "232d1486ef3116d2", "doc_id": "hp_69dbe4380588b108"}]</data>
  <data key="d2">[{"text": "Although living most of his adult life in Australia, he kept his American citizenship and served intermittently as honorary American vice consul-general in Melbourne.", "chunk_id": "232d1486ef3116d2", "doc_id": "hp_69dbe4380588b108"}]</data>
  <data key="d3">["hp_69dbe4380588b108"]</data>
  <data key="d4">False</data>
</node>
<node id="Echinacea">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Echinacea is a genus of herbaceous flowering plants in the daisy family.", "chunk_id": "940bcdf581a12ef8", "doc_id": "hp_69fd7358b20b9865"}]</data>
  <data key="d2">[{"text": "Echinacea is a genus, or group of herbaceous flowering plants in the daisy family.", "chunk_id": "940bcdf581a12ef8", "doc_id": "hp_69fd7358b20b9865"}]</data>
  <data key="d3">["hp_69fd7358b20b9865"]</data>
  <data key="d4">False</data>
</node>
<node id="purple coneflowers">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Purple coneflowers are the common name for the nine species within the Echinacea genus.", "chunk_id": "940bcdf581a12ef8", "doc_id": "hp_69fd7358b20b9865"}]</data>
  <data key="d2">[{"text": "The \"Echinacea\" genus has nine species, which are commonly called purple coneflowers.", "chunk_id": "940bcdf581a12ef8", "doc_id": "hp_69fd7358b20b9865"}]</data>
  <data key="d3">["hp_69fd7358b20b9865"]</data>
  <data key="d4">False</data>
</node>
<node id="Echinacea purpurea">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Echinacea purpurea is a species of Echinacea used in folk medicine.", "chunk_id": "940bcdf581a12ef8", "doc_id": "hp_69fd7358b20b9865"}]</data>
  <data key="d2">[{"text": "\"Echinacea purpurea\" is used in folk medicine.", "chunk_id": "940bcdf581a12ef8", "doc_id": "hp_69fd7358b20b9865"}]</data>
  <data key="d3">["hp_69fd7358b20b9865"]</data>
  <data key="d4">False</data>
</node>
<node id="E. tennesseensis">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "E. tennesseensis is an endangered species of Echinacea listed in the United States.", "chunk_id": "940bcdf581a12ef8", "doc_id": "hp_69fd7358b20b9865"}]</data>
  <data key="d2">[{"text": "Two of the species, \"E. tennesseensis\" and \"E. laevigata\", are listed in the United States as endangered species.", "chunk_id": "940bcdf581a12ef8", "doc_id": "hp_69fd7358b20b9865"}]</data>
  <data key="d3">["hp_69fd7358b20b9865"]</data>
  <data key="d4">False</data>
</node>
<node id="E. laevigata">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "E. laevigata is an endangered species of Echinacea listed in the United States.", "chunk_id": "940bcdf581a12ef8", "doc_id": "hp_69fd7358b20b9865"}]</data>
  <data key="d2">[{"text": "Two of the species, \"E. tennesseensis\" and \"E. laevigata\", are listed in the United States as endangered species.", "chunk_id": "940bcdf581a12ef8", "doc_id": "hp_69fd7358b20b9865"}]</data>
  <data key="d3">["hp_69fd7358b20b9865"]</data>
  <data key="d4">False</data>
</node>
