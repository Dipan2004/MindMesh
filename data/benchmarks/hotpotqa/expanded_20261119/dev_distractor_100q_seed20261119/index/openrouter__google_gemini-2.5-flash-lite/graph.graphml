<node id="1915 Allan Cup">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 1915 Allan Cup was the Canadian national senior ice hockey championship for the 1914-15 season.", "chunk_id": "727d9f658d48842e", "doc_id": "hp_a459053e0ba1eb53"}]</data>
  <data key="d2">[{"text": "The 1915 Allan Cup was the Canadian national senior ice hockey championship for the 1914-15 season.", "chunk_id": "727d9f658d48842e", "doc_id": "hp_a459053e0ba1eb53"}]</data>
  <data key="d3">["hp_a459053e0ba1eb53"]</data>
  <data key="d4">False</data>
</node>
<node id="Melville Millionaires">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Melville Millionaires were a team that held the title of the 1915 Allan Cup.", "chunk_id": "727d9f658d48842e", "doc_id": "hp_a459053e0ba1eb53"}]</data>
  <data key="d2">[{"text": "The title was first held by the Melville Millionaires as champions of their league and two challenge wins.", "chunk_id": "727d9f658d48842e", "doc_id": "hp_a459053e0ba1eb53"}]</data>
  <data key="d3">["hp_a459053e0ba1eb53"]</data>
  <data key="d4">False</data>
</node>
<node id="Winnipeg Monarchs">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Winnipeg Monarchs were a team that won the final Allan Cup challenge against the Melville Millionaires.", "chunk_id": "727d9f658d48842e", "doc_id": "hp_a459053e0ba1eb53"}]</data>
  <data key="d2">[{"text": "The Millionaires then lost the final Allan Cup challenge to the Winnipeg Monarchs.", "chunk_id": "727d9f658d48842e", "doc_id": "hp_a459053e0ba1eb53"}]</data>
  <data key="d3">["hp_a459053e0ba1eb53"]</data>
  <data key="d4">False</data>
</node>
