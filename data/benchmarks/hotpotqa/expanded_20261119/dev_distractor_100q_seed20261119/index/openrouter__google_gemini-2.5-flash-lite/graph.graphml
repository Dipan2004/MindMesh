  <data key="d2">[{"text": "It was released as the first single from their 1990 album \"Detonator\".", "chunk_id": "66ad2e860f938fc7", "doc_id": "hp_58add9e266f469f0"}, {"text": "\"Shame Shame Shame\" is a single by American heavy metal band Ratt, released on their album \"Detonator\".", "chunk_id": "6320f732c14ef885", "doc_id": "hp_95b0346082b5ad8e"}]</data>
  <data key="d3">["hp_58add9e266f469f0", "hp_95b0346082b5ad8e"]</data>
  <data key="d4">False</data>
</node>
<node id="Desmond Child">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Songwriter and co-writer of the song 'Lovin' You's a Dirty Job'.", "chunk_id": "66ad2e860f938fc7", "doc_id": "hp_58add9e266f469f0"}, {"text": "A famed songwriter who co-wrote the song \"Shame Shame Shame\".", "chunk_id": "6320f732c14ef885", "doc_id": "hp_95b0346082b5ad8e"}]</data>
  <data key="d2">[{"text": "The song was co-written by Ratt bassist Juan Croucier, guitarist Warren DeMartini, lead singer Stephen Pearcy and songwriter Desmond Child.", "chunk_id": "66ad2e860f938fc7", "doc_id": "hp_58add9e266f469f0"}, {"text": "The song was co-written by famed songwriter Desmond Child, Ratt guitarist Warren DeMartini and lead singer Stephen Pearcy.", "chunk_id": "6320f732c14ef885", "doc_id": "hp_95b0346082b5ad8e"}]</data>
  <data key="d3">["hp_58add9e266f469f0", "hp_95b0346082b5ad8e"]</data>
  <data key="d4">False</data>
</node>
