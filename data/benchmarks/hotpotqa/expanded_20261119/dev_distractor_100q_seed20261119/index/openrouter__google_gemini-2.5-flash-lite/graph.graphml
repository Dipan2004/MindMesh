  <data key="d2">[{"text": "Zélia Gattai Amado de Faria (July 2, 1916 – May 17, 2008) was a Brazilian photographer, memoirist, novelist and author of children's literature, as well as a member of the Brazilian Academy of Letters.", "chunk_id": "004b3a821c0eea89", "doc_id": "hp_7793b1230ca9d0c3"}]</data>
