  <data key="d7">[{"text": "It includes the hit song \"Fly\", and another moderately successful single, \"RPM\".", "chunk_id": "8cd652904b229d0e", "doc_id": "hp_4ed856daf788c853", "type": "INCLUDES"}, {"text": "Two versions of \"Fly\" are found on the album, one of them featuring reggae artist Super Cat.", "chunk_id": "8cd652904b229d0e", "doc_id": "hp_4ed856daf788c853", "type": "INCLUDES"}]</data>
