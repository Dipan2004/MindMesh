<node id="Dehong Prefecture">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A prefecture located in Yunnan, China.", "chunk_id": "f6e0ca7c3e63f550", "doc_id": "hp_0e1b00a3eeabb9ce"}, {"text": "Dehong Prefecture is a prefecture in Yunnan province, People's Republic of China.", "chunk_id": "105244edf12919e4", "doc_id": "hp_4584bae78bfb29b3"}, {"text": "A prefecture in Yunnan, China, which includes Ruili City.", "chunk_id": "0cb99287d9c2da80", "doc_id": "hp_81f5a8696daf3dee"}]</data>
  <data key="d2">[{"text": "Wanding Border Economic Cooperation Zone (WTBECZ) is a Chinese State Council-approved Industrial Park based in Wanding Town, Ruili City, Dehong Prefecture, Yunnan, China, founded in 1992 and was established to promote trade between China and Myanmar.", "chunk_id": "f6e0ca7c3e63f550", "doc_id": "hp_0e1b00a3eeabb9ce"}, {"text": "Ruili (; Burmese: ရွှေလီ ; Thai: เมืองมาว ) is a county-level city of Dehong Prefecture, in the west of Yunnan province, People's Republic of China.", "chunk_id": "105244edf12919e4", "doc_id": "hp_4584bae78bfb29b3"}, {"text": "Ruili Border Economic Cooperation Zone (RLBECZ) is a Chinese State Council-approved Industrial Park based in Ruili City, Dehong Prefecture, Yunnan, China, founded in 1992 and was established to promote trade between China and Myanmar.", "chunk_id": "0cb99287d9c2da80", "doc_id": "hp_81f5a8696daf3dee"}]</data>
  <data key="d3">["hp_0e1b00a3eeabb9ce", "hp_4584bae78bfb29b3", "hp_81f5a8696daf3dee"]</data>
