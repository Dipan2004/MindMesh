  <data key="d7">[{"text": "He was born as the third child of Tothchukpo House to his mother who is a scion of Gaden Lam family which traces its origin to Phajo Drukgom Zhigpo, the priest who brought Drukpa Kagyu tradition of Tibetan Buddhism to western Bhutan.", "chunk_id": "a871fb84038a99a1", "doc_id": "hp_e30d91b396b0e3e8", "type": "ORIGINATES_FROM"}]</data>
