<node id="The Rockfords">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Rockfords were an American rock band.", "chunk_id": "e75c71d95fdb03f2", "doc_id": "hp_05e3ff9fbf16bf9f"}, {"text": "The Rockfords is a rock band formed by members of Goodness and Pearl Jam.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
  <data key="d2">[{"text": "The Rockfords were an American rock band formed in Seattle, Washington, in 1999 by Carrie Akre, Chris Friel, and Danny Newcomb of Goodness, Mike McCready of Pearl Jam, and Rick Friel of Jodie Watts.", "chunk_id": "e75c71d95fdb03f2", "doc_id": "hp_05e3ff9fbf16bf9f"}, {"text": "Akre, Friel, and Newcomb later joined Mike McCready of Pearl Jam and Rick Friel to form the rock band The Rockfords.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
  <data key="d3">["hp_05e3ff9fbf16bf9f", "hp_cf04d33334830067"]</data>
  <data key="d4">False</data>
</node>
<node id="Seattle">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Seattle is a location where The Rockfords were formed.", "chunk_id": "e75c71d95fdb03f2", "doc_id": "hp_05e3ff9fbf16bf9f"}, {"text": "Seattle is a location associated with underground bands.", "chunk_id": "0d888cee944dc2cb", "doc_id": "hp_2afa90f7ec34b459"}, {"text": "A city in Washington where Seattle Sounders FC 2 is based.", "chunk_id": "0383bd36f57d412b", "doc_id": "hp_c9681d41f79300d2"}, {"text": "Seattle is a location in Washington where the band Goodness was from.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}, {"text": "Seattle is the birthplace of Mark O'Connor.", "chunk_id": "83ff2598ffe55600", "doc_id": "hp_f2e2e7c2a56a9856"}]</data>
  <data key="d2">[{"text": "The Rockfords were an American rock band formed in Seattle, Washington, in 1999 by Carrie Akre, Chris Friel, and Danny Newcomb of Goodness, Mike McCready of Pearl Jam, and Rick Friel of Jodie Watts.", "chunk_id": "e75c71d95fdb03f2", "doc_id": "hp_05e3ff9fbf16bf9f"}, {"text": "Carrie Akre (born September 24, 1966) is an American musician best known for her work with Seattle underground bands Hammerbox and Goodness.", "chunk_id": "0d888cee944dc2cb", "doc_id": "hp_2afa90f7ec34b459"}, {"text": "Seattle Sounders FC 2 (nicknamed S2) is an American soccer club based in Seattle, Washington that competes in the United Soccer League, the third tier of the United States Soccer Pyramid, as the reserve team of Seattle Sounders FC.", "chunk_id": "0383bd36f57d412b", "doc_id": "hp_c9681d41f79300d2"}, {"text": "Goodness was an American rock band from Seattle, Washington, led by Carrie Akre, formerly of Hammerbox and now primarily a solo artist.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}, {"text": "Mark O'Connor (born August 5, 1961, Seattle) is an American bluegrass, jazz and country violinist, fiddler, composer and music teacher.", "chunk_id": "83ff2598ffe55600", "doc_id": "hp_f2e2e7c2a56a9856"}]</data>
  <data key="d3">["hp_05e3ff9fbf16bf9f", "hp_2afa90f7ec34b459", "hp_c9681d41f79300d2", "hp_cf04d33334830067", "hp_f2e2e7c2a56a9856"]</data>
  <data key="d4">False</data>
</node>
<node id="Washington">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Washington is a location where The Rockfords were formed.", "chunk_id": "e75c71d95fdb03f2", "doc_id": "hp_05e3ff9fbf16bf9f"}, {"text": "Washington is a state in the western United States where Chorizanthe watsonii is native.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}, {"text": "A state in the Pacific Coast region that was part of Standard Oil of Iowa's marketing area.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}, {"text": "A state in the United States where Seattle is located.", "chunk_id": "0383bd36f57d412b", "doc_id": "hp_c9681d41f79300d2"}, {"text": "Washington is a state where Seattle is located.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
  <data key="d2">[{"text": "The Rockfords were an American rock band formed in Seattle, Washington, in 1999 by Carrie Akre, Chris Friel, and Danny Newcomb of Goodness, Mike McCready of Pearl Jam, and Rick Friel of Jodie Watts.", "chunk_id": "e75c71d95fdb03f2", "doc_id": "hp_05e3ff9fbf16bf9f"}, {"text": "It is native to the western United States from Washington to the Mojave Desert.", "chunk_id": "9c69666274cd8ce7", "doc_id": "hp_42ea38daa77f53b1"}, {"text": "Standard Oil Company of Iowa was created in 1885 as a subsidiary of the Standard Oil Trust to handle marketing along the Pacific Coast states of Idaho, Oregon, Washington, California, and Arizona.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}, {"text": "Seattle Sounders FC 2 (nicknamed S2) is an American soccer club based in Seattle, Washington that competes in the United Soccer League, the third tier of the United States Soccer Pyramid, as the reserve team of Seattle Sounders FC.", "chunk_id": "0383bd36f57d412b", "doc_id": "hp_c9681d41f79300d2"}, {"text": "Goodness was an American rock band from Seattle, Washington, led by Carrie Akre, formerly of Hammerbox and now primarily a solo artist.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
  <data key="d3">["hp_05e3ff9fbf16bf9f", "hp_42ea38daa77f53b1", "hp_777b99a15f2523b1", "hp_c9681d41f79300d2", "hp_cf04d33334830067"]</data>
  <data key="d4">False</data>
</node>
<node id="Carrie Akre">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Carrie Akre was a member of the band The Rockfords.", "chunk_id": "e75c71d95fdb03f2", "doc_id": "hp_05e3ff9fbf16bf9f"}, {"text": "Carrie Akre is an American musician.", "chunk_id": "0d888cee944dc2cb", "doc_id": "hp_2afa90f7ec34b459"}, {"text": "Carrie Akre is an American artist who released the debut solo studio album \"Home\".", "chunk_id": "605e16b648692dcc", "doc_id": "hp_3c2e01e472de9860"}, {"text": "Carrie Akre is an American artist who released the album Invitation.", "chunk_id": "b18abfa9fd7927c5", "doc_id": "hp_690e5c7c5fa7319e"}, {"text": "Carrie Akre is an American artist.", "chunk_id": "cc9810d79e9cd34d", "doc_id": "hp_79210cfd3b874967"}, {"text": "Carrie Akre was the lead singer of the American rock band Goodness.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
  <data key="d2">[{"text": "The Rockfords were an American rock band formed in Seattle, Washington, in 1999 by Carrie Akre, Chris Friel, and Danny Newcomb of Goodness, Mike McCready of Pearl Jam, and Rick Friel of Jodie Watts.", "chunk_id": "e75c71d95fdb03f2", "doc_id": "hp_05e3ff9fbf16bf9f"}, {"text": "Carrie Akre (born September 24, 1966) is an American musician best known for her work with Seattle underground bands Hammerbox and Goodness.", "chunk_id": "0d888cee944dc2cb", "doc_id": "hp_2afa90f7ec34b459"}, {"text": "Home is the debut solo studio album by the American artist Carrie Akre.", "chunk_id": "605e16b648692dcc", "doc_id": "hp_3c2e01e472de9860"}, {"text": "Invitation is the second solo studio album by the American artist Carrie Akre.", "chunk_id": "b18abfa9fd7927c5", "doc_id": "hp_690e5c7c5fa7319e"}, {"text": "...Last the Evening is the third solo studio album by the American artist Carrie Akre.", "chunk_id": "cc9810d79e9cd34d", "doc_id": "hp_79210cfd3b874967"}, {"text": "Goodness was an American rock band from Seattle, Washington, led by Carrie Akre, formerly of Hammerbox and now primarily a solo artist.", "chunk_id": "22072efff7c6e070", "doc_id": "hp_cf04d33334830067"}]</data>
  <data key="d3">["hp_05e3ff9fbf16bf9f", "hp_2afa90f7ec34b459", "hp_3c2e01e472de9860", "hp_690e5c7c5fa7319e", "hp_79210cfd3b874967", "hp_cf04d33334830067"]</data>
  <data key="d4">False</data>
</node>
