  <data key="d5">["NATIVE_TO"]</data>
  <data key="d6">Pachypodium is native to Africa.</data>
  <data key="d7">[{"text": "Pachypodium is a genus of succulent spine-bearing trees and shrubs, native to Madagascar and Africa.", "chunk_id": "c65de02bc9af4260", "doc_id": "hp_a9669326c71f5122", "type": "NATIVE_TO"}]</data>
