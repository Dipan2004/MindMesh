  <data key="d1">[{"text": "Korean History is a field in which Yi Sun-sin became a legendary figure.", "chunk_id": "bf39df43067a80b1", "doc_id": "hp_3a9829e8fd3b32c6"}]</data>
  <data key="d2">[{"text": "These campaigns made Yi a legendary figure in Korean History.", "chunk_id": "bf39df43067a80b1", "doc_id": "hp_3a9829e8fd3b32c6"}]</data>
