  <data key="d7">[{"text": "It was a subsidiary of The May Department Stores Company, having been acquired with Federated's takeover of The May Department Stores Company on August 30, 2005.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9", "type": "ACQUISITION_DATE"}]</data>
  <data key="d8">hp_70e1b920ca70d1e9</data>
</edge>
