  <data key="d2">[{"text": "Dime novels are the antecedent of today's mass-market paperbacks, comic books, television shows and movies based on dime-novel genres.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d3">["hp_e364a8973c287ebf"]</data>
