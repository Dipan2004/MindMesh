<node id="Rum Sodomy &amp; the Lash">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The second album by The Pogues, which featured the single \"A Pair of Brown Eyes\".", "chunk_id": "b52105e0cc7ef21b", "doc_id": "hp_da38acdde66d2037"}]</data>
  <data key="d2">[{"text": "It featured on the band's second album, \"Rum Sodomy &amp; the Lash\", and was composed by Pogues front man Shane MacGowan, on the melody of \"Wild Mountain Thyme\", also known as \"Will Ye Go Lassie Go,\" a song by Francis McPeake in a traditional Irish folk style.", "chunk_id": "b52105e0cc7ef21b", "doc_id": "hp_da38acdde66d2037"}]</data>
  <data key="d3">["hp_da38acdde66d2037"]</data>
  <data key="d4">False</data>
</node>
<node id="Shane MacGowan">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The front man of The Pogues who composed \"A Pair of Brown Eyes\".", "chunk_id": "b52105e0cc7ef21b", "doc_id": "hp_da38acdde66d2037"}]</data>
  <data key="d2">[{"text": "It featured on the band's second album, \"Rum Sodomy &amp; the Lash\", and was composed by Pogues front man Shane MacGowan, on the melody of \"Wild Mountain Thyme\", also known as \"Will Ye Go Lassie Go,\" a song by Francis McPeake in a traditional Irish folk style.", "chunk_id": "b52105e0cc7ef21b", "doc_id": "hp_da38acdde66d2037"}]</data>
  <data key="d3">["hp_da38acdde66d2037"]</data>
  <data key="d4">False</data>
</node>
<node id="Will Ye Go Lassie Go">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Another name for the melody \"Wild Mountain Thyme\".", "chunk_id": "b52105e0cc7ef21b", "doc_id": "hp_da38acdde66d2037"}, {"text": "An alternative title for the Scottish folk song \"Wild Mountain Thyme\".", "chunk_id": "1fcb72fd1832f8a4", "doc_id": "hp_7778e88209c46514"}]</data>
  <data key="d2">[{"text": "It featured on the band's second album, \"Rum Sodomy &amp; the Lash\", and was composed by Pogues front man Shane MacGowan, on the melody of \"Wild Mountain Thyme\", also known as \"Will Ye Go Lassie Go,\" a song by Francis McPeake in a traditional Irish folk style.", "chunk_id": "b52105e0cc7ef21b", "doc_id": "hp_da38acdde66d2037"}, {"text": "\"Wild Mountain Thyme\" (also known as \"Purple Heather\" and \"Will Ye Go, Lassie, Go?\") is a Scottish folk song that was collected by Francis McPeake 1st, who wrote the song himself for his wife.", "chunk_id": "1fcb72fd1832f8a4", "doc_id": "hp_7778e88209c46514"}]</data>
  <data key="d3">["hp_7778e88209c46514", "hp_da38acdde66d2037"]</data>
  <data key="d4">False</data>
</node>
