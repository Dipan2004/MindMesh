  <data key="d7">[{"text": "That year \"Wrong Road Again\" reached the sixth position on the country songs chart, launching several major country hits including \"I'll Do It All Over Again\", and her first number one hit \"I'll Get Over You\".", "chunk_id": "79f2e927bc5b3f09", "doc_id": "hp_3b9acbbdcc47f797", "type": "CHARTED_ON"}]</data>
  <data key="d8">hp_3b9acbbdcc47f797</data>
</edge>
