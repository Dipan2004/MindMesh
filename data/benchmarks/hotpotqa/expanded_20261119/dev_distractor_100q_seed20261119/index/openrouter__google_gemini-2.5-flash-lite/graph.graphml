  <data key="d5">["BASED_ON"]</data>
  <data key="d6">"The Braes of Balquhither" may have been based on the traditional song "The Braes o' Bowhether".</data>
  <data key="d7">[{"text": "and \"The Braes of Balquhither\" may have been based on the traditional song \"The Braes o' Bowhether\".", "chunk_id": "1fcb72fd1832f8a4", "doc_id": "hp_7778e88209c46514", "type": "BASED_ON"}]</data>
