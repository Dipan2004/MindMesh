  <data key="d6">The Occidental Hotel operated during the end of the California Gold Rush.</data>
  <data key="d7">[{"text": "Operating in the years that roughly coincided with the end of the California Gold Rush and the beginning of silver mining in Nevada, the Occidental Hotel was among the new, grand hotels in San Francisco.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884", "type": "OPERATED_DURING"}]</data>
