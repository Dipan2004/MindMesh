  <data key="d6">Queen Victoria provided Royal patronage to the society.</data>
  <data key="d7">[{"text": "It was founded in London, England in 1853 as The Photographic Society of London with the objective of promoting the art and science of photography, and in 1854 received Royal patronage from Queen Victoria and Prince Albert.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c", "type": "GRANTED_PATRONAGE_TO"}]</data>
  <data key="d8">hp_a4dd7ae51691935c</data>
</edge>
<edge source="Prince Albert" target="The Photographic Society of London">
  <data key="d5">["GRANTED_PATRONAGE_TO"]</data>
  <data key="d6">Prince Albert provided Royal patronage to the society.</data>
  <data key="d7">[{"text": "It was founded in London, England in 1853 as The Photographic Society of London with the objective of promoting the art and science of photography, and in 1854 received Royal patronage from Queen Victoria and Prince Albert.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c", "type": "GRANTED_PATRONAGE_TO"}]</data>
  <data key="d8">hp_a4dd7ae51691935c</data>
</edge>
<edge source="Photographic Society of Great Britain" target="The Royal Photographic Society of Great Britain">
  <data key="d5">["RENAMED_TO"]</data>
  <data key="d6">The society was renamed from Photographic Society of Great Britain to The Royal Photographic Society of Great Britain.</data>
  <data key="d7">[{"text": "In 1874 it was renamed the Photographic Society of Great Britain, and from 1894 it became known as The Royal Photographic Society of Great Britain.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c", "type": "RENAMED_TO"}]</data>
  <data key="d8">hp_a4dd7ae51691935c</data>
</edge>
<edge source="The Royal Photographic Society of Great Britain" target="1962">
  <data key="d5">["REGISTERED_AS_CHARITY_SINCE"]</data>
  <data key="d6">The society has been a registered charity since 1962.</data>
  <data key="d7">[{"text": "A registered charity since 1962, in July 2004, The Royal Photographic Society of Great Britain was granted a Royal charter recognising its eminence in the field of photography as a learned society.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c", "type": "REGISTERED_AS_CHARITY_SINCE"}]</data>
  <data key="d8">hp_a4dd7ae51691935c</data>
</edge>
<edge source="The Royal Photographic Society of Great Britain" target="Royal charter">
  <data key="d5">["GRANTED"]</data>
  <data key="d6">The society was granted a Royal charter in July 2004.</data>
  <data key="d7">[{"text": "A registered charity since 1962, in July 2004, The Royal Photographic Society of Great Britain was granted a Royal charter recognising its eminence in the field of photography as a learned society.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c", "type": "GRANTED"}]</data>
  <data key="d8">hp_a4dd7ae51691935c</data>
</edge>
