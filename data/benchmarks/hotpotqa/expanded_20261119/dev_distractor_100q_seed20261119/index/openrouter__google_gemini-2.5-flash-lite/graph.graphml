<node id="18 Months">
  <data key="d0">ALBUM</data>
  <data key="d1">[{"text": "18 Months is the third studio album by Calvin Harris, released in 2012.", "chunk_id": "95980d0e5191cb2e", "doc_id": "hp_15126f7df8c067b8"}]</data>
  <data key="d2">[{"text": "\"Sweet Nothing\" is a song by Scottish recording artist and record producer Calvin Harris from his third studio album, \"18 Months\" (2012).", "chunk_id": "95980d0e5191cb2e", "doc_id": "hp_15126f7df8c067b8"}]</data>
  <data key="d3">["hp_15126f7df8c067b8"]</data>
  <data key="d4">False</data>
</node>
<node id="Spectrum">
  <data key="d0">SONG</data>
  <data key="d1">[{"text": "Spectrum is a single by Florence and the Machine that Calvin Harris remixed.", "chunk_id": "95980d0e5191cb2e", "doc_id": "hp_15126f7df8c067b8"}]</data>
  <data key="d2">[{"text": "Harris previously worked with the band in a remix of their single, \"Spectrum\" (2012).", "chunk_id": "95980d0e5191cb2e", "doc_id": "hp_15126f7df8c067b8"}]</data>
  <data key="d3">["hp_15126f7df8c067b8"]</data>
  <data key="d4">False</data>
</node>
<node id="The Chris Moyles Show">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Chris Moyles Show is a show on BBC Radio 1 where the track \"Sweet Nothing\" premiered.", "chunk_id": "95980d0e5191cb2e", "doc_id": "hp_15126f7df8c067b8"}]</data>
  <data key="d2">[{"text": "The track premiered on \"The Chris Moyles Show\" on BBC Radio 1 on 28 August 2012 and was later released as the fifth single from the album on 12 October 2012.", "chunk_id": "95980d0e5191cb2e", "doc_id": "hp_15126f7df8c067b8"}]</data>
  <data key="d3">["hp_15126f7df8c067b8"]</data>
  <data key="d4">False</data>
</node>
<node id="BBC Radio 1">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "BBC Radio 1 is a radio station where \"The Chris Moyles Show\" airs.", "chunk_id": "95980d0e5191cb2e", "doc_id": "hp_15126f7df8c067b8"}, {"text": "BBC Radio 1 is a radio station whose DJ, Steve Lamacq, was given a demo by Bloc Party.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
  <data key="d2">[{"text": "The track premiered on \"The Chris Moyles Show\" on BBC Radio 1 on 28 August 2012 and was later released as the fifth single from the album on 12 October 2012.", "chunk_id": "95980d0e5191cb2e", "doc_id": "hp_15126f7df8c067b8"}, {"text": "Bloc Party got their break by giving BBC Radio 1 DJ Steve Lamacq and Franz Ferdinand's lead singer, Alex Kapranos, a copy of their demo \"She's Hearing Voices\".", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
  <data key="d3">["hp_15126f7df8c067b8", "hp_69c70a8b17b9692e"]</data>
  <data key="d4">False</data>
</node>
<node id="Mandakini">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An actress who starred in the film Ram Teri Ganga Maili.", "chunk_id": "9587b01bee29deed", "doc_id": "hp_153a2c475bfeef6e"}]</data>
  <data key="d2">[{"text": "The movie stars Mandakini and Rajiv Kapoor, son of Raj Kapoor.", "chunk_id": "9587b01bee29deed", "doc_id": "hp_153a2c475bfeef6e"}]</data>
  <data key="d3">["hp_153a2c475bfeef6e"]</data>
  <data key="d4">False</data>
</node>
<node id="Pakeezah">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A film with a storyline somewhat similar to Ram Teri Ganga Maili.", "chunk_id": "9587b01bee29deed", "doc_id": "hp_153a2c475bfeef6e"}]</data>
  <data key="d2">[{"text": "The storyline of the film is somewhat similar to \"Pakeezah\".", "chunk_id": "9587b01bee29deed", "doc_id": "hp_153a2c475bfeef6e"}]</data>
  <data key="d3">["hp_153a2c475bfeef6e"]</data>
  <data key="d4">False</data>
</node>
<node id="Indian Censor Board">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A conservative board that did not allow bold scenes of breastfeeding and bathing in a transparent saree at that point in time.", "chunk_id": "9587b01bee29deed", "doc_id": "hp_153a2c475bfeef6e"}]</data>
  <data key="d2">[{"text": "The film became very controversial because of Mandakini's bold scenes of breastfeeding and bathing in a transparent saree, which wasn't something the conservative Indian Censor Board allowed at that point in time.", "chunk_id": "9587b01bee29deed", "doc_id": "hp_153a2c475bfeef6e"}]</data>
  <data key="d3">["hp_153a2c475bfeef6e"]</data>
  <data key="d4">False</data>
</node>
<node id="Ravindra Jain">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The music director who received a Filmfare Award for the film Ram Teri Ganga Maili.", "chunk_id": "9587b01bee29deed", "doc_id": "hp_153a2c475bfeef6e"}]</data>
  <data key="d2">[{"text": "The music director Ravindra Jain received a Filmfare Award for this film.", "chunk_id": "9587b01bee29deed", "doc_id": "hp_153a2c475bfeef6e"}]</data>
  <data key="d3">["hp_153a2c475bfeef6e"]</data>
  <data key="d4">False</data>
</node>
<node id="Monty Banks">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An Italian comedian and film director who achieved success in the United States and in England.", "chunk_id": "1e569c2aa40d90c4", "doc_id": "hp_15caf36624649b1e"}, {"text": "Monty Banks is the director of the film The Black Hand Gang.", "chunk_id": "2d3317f023ec45c6", "doc_id": "hp_49692353aeba2984"}, {"text": "The director of the 1935 film 'No Limit'.", "chunk_id": "9243d3da01ac4911", "doc_id": "hp_4fd72be01c14fbaf"}, {"text": "The director of the 1936 British musical comedy film 'Queen of Hearts'.", "chunk_id": "10a246716de6279a", "doc_id": "hp_692aa00acd5001ce"}, {"text": "Monty Banks was the director of the film The Church Mouse.", "chunk_id": "9a7b28296d1097a8", "doc_id": "hp_968c14d484f727b7"}, {"text": "The director of the film Keep Your Seats, Please.", "chunk_id": "fb573f40a01941a2", "doc_id": "hp_e86e098764e42f6e"}, {"text": "Monty Banks was a director and star of the 1930 British comedy film, The Compulsory Husband.", "chunk_id": "486db429bc06b06e", "doc_id": "hp_f907bfe998479d0e"}]</data>
  <data key="d2">[{"text": "Monty Banks Montague (Monty) Banks (15 July 1897 [registered on 18 July 1897] – 7 January 1950 born Mario Bianchi) was an Italian comedian and film director who achieved success in the United States and in England.", "chunk_id": "1e569c2aa40d90c4", "doc_id": "hp_15caf36624649b1e"}, {"text": "The Black Hand Gang is a 1930 British comedy film directed by Monty Banks and starring Wee Georgie Wood, Viola Compton and Alfred Wood.", "chunk_id": "2d3317f023ec45c6", "doc_id": "hp_49692353aeba2984"}, {"text": "The film, which was directed by Monty Banks, was made on location at the TT motorcycle race on the Isle of Man.", "chunk_id": "9243d3da01ac4911", "doc_id": "hp_4fd72be01c14fbaf"}, {"text": "Queen of Hearts is a 1936 British musical comedy film directed by Monty Banks and starring Gracie Fields, John Loder and Enid Stamp-Taylor.", "chunk_id": "10a246716de6279a", "doc_id": "hp_692aa00acd5001ce"}, {"text": "The Church Mouse is a 1934 British comedy film directed by Monty Banks and starring Laura La Plante, Ian Hunter and Edward Chapman.", "chunk_id": "9a7b28296d1097a8", "doc_id": "hp_968c14d484f727b7"}, {"text": "Keep Your Seats, Please is a 1936 British comedy film directed by Monty Banks and starring George Formby, Florence Desmond and Alastair Sim.", "chunk_id": "fb573f40a01941a2", "doc_id": "hp_e86e098764e42f6e"}, {"text": "The Compulsory Husband is a 1930 British comedy film directed by Monty Banks and Harry Lachman and starring Banks, Lillian Manton and Clifford Heatherley.", "chunk_id": "486db429bc06b06e", "doc_id": "hp_f907bfe998479d0e"}]</data>
  <data key="d3">["hp_15caf36624649b1e", "hp_49692353aeba2984", "hp_4fd72be01c14fbaf", "hp_692aa00acd5001ce", "hp_968c14d484f727b7", "hp_e86e098764e42f6e", "hp_f907bfe998479d0e"]</data>
  <data key="d4">False</data>
</node>
