<edge source="M9 highway (Russia)" target="Moscow">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">The M9 highway leads from Moscow.</data>
  <data key="d7">[{"text": "The Russian route M9, also known as the \"Baltic Highway\", is a 610 km-long trunk road that leads from Moscow through Volokolamsk to Russia's border with Latvia.", "chunk_id": "2d8fd36c09df60bf", "doc_id": "hp_360b3afe94cb5e9d", "type": "LOCATED_IN"}]</data>
