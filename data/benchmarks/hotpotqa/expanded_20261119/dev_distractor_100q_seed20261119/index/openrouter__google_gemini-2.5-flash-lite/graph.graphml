  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">The operations on the Ancre occurred on the Somme front.</data>
  <data key="d7">[{"text": "Operations on the Ancre took place from 11 January – 13 March 1917, between the British Fifth Army and the German 1st Army, on the Somme front during the First World War.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad", "type": "LOCATED_IN"}]</data>
