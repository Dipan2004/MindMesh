<node id="Duston">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location where Richard William Herrick held curacies.", "chunk_id": "2d54d3fa9439ab8e", "doc_id": "hp_e808a689dfcac703"}]</data>
  <data key="d2">[{"text": "he held curacies at Duston and Portsea, Portsmouth before being appointed Vicar of St Michael’s, Northampton in 1947, a post he held for a decade.", "chunk_id": "2d54d3fa9439ab8e", "doc_id": "hp_e808a689dfcac703"}]</data>
