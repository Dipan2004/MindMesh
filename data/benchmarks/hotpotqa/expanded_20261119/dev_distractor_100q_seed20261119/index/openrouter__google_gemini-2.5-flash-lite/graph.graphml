  <data key="d2">[{"text": "The first single from \"The Boxer\" was \"Tenderoni\", released on 14 June, and the second, \"Everything You Wanted\", on 16 August.", "chunk_id": "bb2b762aba15f55a", "doc_id": "hp_24b106283a2f2b9f"}]</data>
