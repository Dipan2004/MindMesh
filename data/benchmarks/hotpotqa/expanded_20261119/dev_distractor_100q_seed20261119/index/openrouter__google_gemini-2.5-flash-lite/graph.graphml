  <data key="d6">Robert Oberst is a yearly competitor of the World's Strongest Man.</data>
  <data key="d7">[{"text": "He is a yearly competitor of the World's Strongest Man including the 2013 World's Strongest Man, 2014 World's Strongest Man, 2015 World's Strongest Man and the 2016 World's Strongest Man competitions.", "chunk_id": "fd867132c1c55e97", "doc_id": "hp_ab10a66f84257538", "type": "COMPETED_IN"}]</data>
