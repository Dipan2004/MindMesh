<node id="Slobodan Živojinović">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A retired Serbian tennis player.", "chunk_id": "490dadce2e52df18", "doc_id": "hp_2f7e3f7e6c207aff"}, {"text": "Slobodan Živojinović was a participant in the 1991 Donnay Indoor Championships – Doubles.", "chunk_id": "72b8f48b7ecf936b", "doc_id": "hp_335fb09af115eccf"}, {"text": "Slobodan Živojinović is a Serbian tennis player who previously held the World No. 1 ranking in doubles.", "chunk_id": "d03416aefc62fa72", "doc_id": "hp_75e8629db66341ba"}, {"text": "A tennis player who lost to Daniel C. Goldie at Wimbledon in 1989.", "chunk_id": "f3bc6bdeb3b7f477", "doc_id": "hp_ce1cd3eb59940b9f"}]</data>
  <data key="d2">[{"text": "Slobodan \"Boba\" Živojinović (, ] ; born on July 23, 1963) is a retired Serbian tennis player who competed for SFR Yugoslavia.", "chunk_id": "490dadce2e52df18", "doc_id": "hp_2f7e3f7e6c207aff"}, {"text": "Emilio Sánchez and Slobodan Živojinović were the defending champions, but Sánchez did not participate this year.", "chunk_id": "72b8f48b7ecf936b", "doc_id": "hp_335fb09af115eccf"}, {"text": "He is the second tennis doubles player from Serbia to hold the World No. 1, after Slobodan Živojinović.", "chunk_id": "d03416aefc62fa72", "doc_id": "hp_75e8629db66341ba"}, {"text": "The right-hander reached the quarterfinals of Wimbledon in 1989 where he beat Kelly Evernden, Jimmy Connors, Wally Masur and Slobodan Živojinović before losing to Ivan Lendl.", "chunk_id": "f3bc6bdeb3b7f477", "doc_id": "hp_ce1cd3eb59940b9f"}]</data>
  <data key="d3">["hp_2f7e3f7e6c207aff", "hp_335fb09af115eccf", "hp_75e8629db66341ba", "hp_ce1cd3eb59940b9f"]</data>
  <data key="d4">False</data>
</node>
<node id="Nenad Zimonjić">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A Serbian tennis player who, together with Slobodan Živojinović, is the only tennis player from Serbia to be the World No. 1 in doubles.", "chunk_id": "490dadce2e52df18", "doc_id": "hp_2f7e3f7e6c207aff"}, {"text": "Nenad Zimonjić is a Serbian professional tennis player.", "chunk_id": "d03416aefc62fa72", "doc_id": "hp_75e8629db66341ba"}]</data>
  <data key="d2">[{"text": "Together with Nenad Zimonjić he is the only tennis player from Serbia to be the World No. 1 in doubles.", "chunk_id": "490dadce2e52df18", "doc_id": "hp_2f7e3f7e6c207aff"}, {"text": "Nenad Zimonjić (Serbian Cyrillic: , ] ; born June 4, 1976) is a Serbian professional tennis player who was ranked World No. 1 in 2008 in doubles.", "chunk_id": "d03416aefc62fa72", "doc_id": "hp_75e8629db66341ba"}]</data>
  <data key="d3">["hp_2f7e3f7e6c207aff", "hp_75e8629db66341ba"]</data>
  <data key="d4">False</data>
</node>
<node id="SFR Yugoslavia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The country for which Slobodan Živojinović competed.", "chunk_id": "490dadce2e52df18", "doc_id": "hp_2f7e3f7e6c207aff"}]</data>
  <data key="d2">[{"text": "Slobodan \"Boba\" Živojinović (, ] ; born on July 23, 1963) is a retired Serbian tennis player who competed for SFR Yugoslavia.", "chunk_id": "490dadce2e52df18", "doc_id": "hp_2f7e3f7e6c207aff"}]</data>
  <data key="d3">["hp_2f7e3f7e6c207aff"]</data>
  <data key="d4">False</data>
</node>
<node id="World No. 1 in doubles">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The highest ranking in doubles tennis.", "chunk_id": "490dadce2e52df18", "doc_id": "hp_2f7e3f7e6c207aff"}]</data>
  <data key="d2">[{"text": "Together with Nenad Zimonjić he is the only tennis player from Serbia to be the World No. 1 in doubles.", "chunk_id": "490dadce2e52df18", "doc_id": "hp_2f7e3f7e6c207aff"}]</data>
  <data key="d3">["hp_2f7e3f7e6c207aff"]</data>
  <data key="d4">False</data>
</node>
<node id="1985 Australian Open">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A tennis tournament where Slobodan Živojinović reached the semi-finals.", "chunk_id": "490dadce2e52df18", "doc_id": "hp_2f7e3f7e6c207aff"}]</data>
  <data key="d2">[{"text": "As a singles player, he reached the semi-finals of the 1985 Australian Open and the 1986 Wimbledon Championships, achieving a career-high ranking of World No. 19.", "chunk_id": "490dadce2e52df18", "doc_id": "hp_2f7e3f7e6c207aff"}]</data>
  <data key="d3">["hp_2f7e3f7e6c207aff"]</data>
  <data key="d4">False</data>
</node>
