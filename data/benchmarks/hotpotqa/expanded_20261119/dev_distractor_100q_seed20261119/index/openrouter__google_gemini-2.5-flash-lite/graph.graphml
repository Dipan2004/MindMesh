  <data key="d2">[{"text": "The final champion was Marco Fu.", "chunk_id": "9719756e39f01e98", "doc_id": "hp_b2a5885a3a67beea"}, {"text": "Marco Fu Ka-chun, MH, JP (, born 8 January 1978 in Hong Kong) is a professional snooker player from Hong Kong.", "chunk_id": "40bdefa8eb4df2fe", "doc_id": "hp_d05fd69dc2a1479f"}]</data>
