  <data key="d2">[{"text": "The Seminole Casino Immokalee is a Class III tribal gaming casino in the town of Immokalee, Florida, United States, 35 miles from Naples.", "chunk_id": "df2d0d5f172fe969", "doc_id": "hp_1345505e9a844632"}, {"text": "Machen had been the president of the University of Utah in Salt Lake City, Utah and the University of Florida in Gainesville, Florida.", "chunk_id": "af74dae8d5aba822", "doc_id": "hp_278033422b0dac1b"}, {"text": "Plant City Airport (ICAO: KPCM, FAA LID: PCM) is a public-use airport located two nautical miles (4 km) southwest of the central business district of Plant City in Hillsborough County, Florida, United States.", "chunk_id": "47b19fbaa70c2777", "doc_id": "hp_357ddba773097c91"}, {"text": "Superior Bank had 73 branch locations including 38 in Alabama and 22 in Florida.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d3">["hp_1345505e9a844632", "hp_278033422b0dac1b", "hp_357ddba773097c91", "hp_c26329b4dd98f983"]</data>
