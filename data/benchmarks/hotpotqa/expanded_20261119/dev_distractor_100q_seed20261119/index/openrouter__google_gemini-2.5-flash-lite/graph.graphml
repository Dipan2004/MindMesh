  <data key="d2">[{"text": "This plant grows in following states of Brazil: Bahia, Ceará Minas Gerais Rio de Janeiro, São Paulo, Paraná and Santa Catarina, and it is usually visited by the hummingbirds.", "chunk_id": "954299a74c533cc7", "doc_id": "hp_e7f8a5633759d23e"}]</data>
