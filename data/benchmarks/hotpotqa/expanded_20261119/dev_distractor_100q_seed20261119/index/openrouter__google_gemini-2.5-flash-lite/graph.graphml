<edge source="Hong Kong" target="Chinese rule">
  <data key="d5">["PART_OF"]</data>
  <data key="d6">Hong Kong was handed back to Chinese rule.</data>
  <data key="d7">[{"text": "Immediately after the handover of Hong Kong back to Chinese rule, Hong Kong's Legislative Council passed an amendment to the Basic Law that would restrict immigration to children born outside of Hong Kong that were born to Hong Kong residents.", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1", "type": "PART_OF"}]</data>
  <data key="d8">hp_0e063f0231106ec1</data>
</edge>
