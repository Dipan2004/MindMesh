<node id="book club">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A group formed to discuss the novels of Jane Austen.", "chunk_id": "960736ea8d07a2ff", "doc_id": "hp_dcfcbf551d8f7cb7"}]</data>
  <data key="d2">[{"text": "As they delve into Austen's literature, the club members find themselves dealing with life experiences that parallel the themes of the books they are reading.", "chunk_id": "960736ea8d07a2ff", "doc_id": "hp_dcfcbf551d8f7cb7"}]</data>
  <data key="d3">["hp_dcfcbf551d8f7cb7"]</data>
