<edge source="vessel elements" target="Gnetophyta">
  <data key="d5">["PRESENT_IN"]</data>
  <data key="d6">Vessel elements are present in gnetophytes.</data>
  <data key="d7">[{"text": "The primary difference between gnetophytes and other gymnosperms is the presence of vessel elements, a system of conduits that transport water within the plant, similar to those found in flowering plants.", "chunk_id": "e8e7eb907eb94958", "doc_id": "hp_3ea3f73701bd3b33", "type": "PRESENT_IN"}]</data>
  <data key="d8">hp_3ea3f73701bd3b33</data>
</edge>
