<node id="sister">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Crystal Gayle's sister who encouraged her musical development.", "chunk_id": "79f2e927bc5b3f09", "doc_id": "hp_3b9acbbdcc47f797"}]</data>
  <data key="d2">[{"text": "Encouraged by her sister to develop her own musical style, Gayle signed with United Artists Records where she began recording country pop material.", "chunk_id": "79f2e927bc5b3f09", "doc_id": "hp_3b9acbbdcc47f797"}]</data>
