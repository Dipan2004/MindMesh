<node id="Spanish Bulldog">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Spanish Bulldog is a breed from which the Villano de las Encartaciones derived.", "chunk_id": "25108324a3783908", "doc_id": "hp_cb38c3abf7bd85ae"}]</data>
  <data key="d2">[{"text": "The Villano derived from the Spanish Bulldog, of which it represents a lighter, faster and more agile version.", "chunk_id": "25108324a3783908", "doc_id": "hp_cb38c3abf7bd85ae"}]</data>
  <data key="d3">["hp_cb38c3abf7bd85ae"]</data>
  <data key="d4">False</data>
</node>
<node id="Monchina cattle">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Monchina cattle are a type of cattle raised in a feral state in northern Spain.", "chunk_id": "25108324a3783908", "doc_id": "hp_cb38c3abf7bd85ae"}]</data>
  <data key="d2">[{"text": "The dog is used to catch Monchina cattle, which are raised in a feral state in northern Spain.", "chunk_id": "25108324a3783908", "doc_id": "hp_cb38c3abf7bd85ae"}]</data>
  <data key="d3">["hp_cb38c3abf7bd85ae"]</data>
  <data key="d4">False</data>
</node>
<node id="Emerald ash borer">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A green buprestid or jewel beetle native to northeastern Asia that feeds on ash species.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}]</data>
  <data key="d2">[{"text": "Agrilus planipennis, commonly known as the emerald ash borer, is a green buprestid or jewel beetle native to northeastern Asia that feeds on ash species.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}]</data>
  <data key="d3">["hp_cc129f1449a3ee73"]</data>
  <data key="d4">False</data>
</node>
<node id="Agrilus planipennis">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The scientific name for the emerald ash borer, a green buprestid or jewel beetle native to northeastern Asia.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}]</data>
  <data key="d2">[{"text": "Agrilus planipennis, commonly known as the emerald ash borer, is a green buprestid or jewel beetle native to northeastern Asia that feeds on ash species.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}]</data>
  <data key="d3">["hp_cc129f1449a3ee73"]</data>
  <data key="d4">False</data>
</node>
<node id="northeastern Asia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The native geographic region of the emerald ash borer.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}]</data>
  <data key="d2">[{"text": "Agrilus planipennis, commonly known as the emerald ash borer, is a green buprestid or jewel beetle native to northeastern Asia that feeds on ash species.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}]</data>
  <data key="d3">["hp_cc129f1449a3ee73"]</data>
  <data key="d4">False</data>
</node>
<node id="ash species">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The type of trees that the emerald ash borer feeds on.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}]</data>
  <data key="d2">[{"text": "Agrilus planipennis, commonly known as the emerald ash borer, is a green buprestid or jewel beetle native to northeastern Asia that feeds on ash species.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}]</data>
  <data key="d3">["hp_cc129f1449a3ee73"]</data>
  <data key="d4">False</data>
</node>
<node id="ash trees">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Trees on which emerald ash borers lay eggs and whose bark larvae feed under.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}]</data>
  <data key="d2">[{"text": "Females lay eggs in bark crevices on ash trees, and larvae feed underneath the bark of ash trees to emerge as adults in one to two years.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}]</data>
  <data key="d3">["hp_cc129f1449a3ee73"]</data>
  <data key="d4">False</data>
</node>
<node id="northwest Europe">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A region where the emerald ash borer is an invasive and destructive species.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}]</data>
  <data key="d2">[{"text": "Outside its native range, it is an invasive species and is highly destructive to ash trees native to northwest Europe and North America.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}]</data>
  <data key="d3">["hp_cc129f1449a3ee73"]</data>
  <data key="d4">False</data>
</node>
<node id="Local governments in North America">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Entities attempting to control the spread of the emerald ash borer in North America.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}]</data>
  <data key="d2">[{"text": "Local governments in North America are attempting to control it by monitoring its spread, diversifying tree species, insecticides, and biological control.", "chunk_id": "18ee4a00e65dd0d7", "doc_id": "hp_cc129f1449a3ee73"}]</data>
  <data key="d3">["hp_cc129f1449a3ee73"]</data>
  <data key="d4">False</data>
</node>
<node id="Sigmund Jähn">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The first German native to have flown in space.", "chunk_id": "1dda59241bb9cd52", "doc_id": "hp_cc1f6a95f8e649b8"}]</data>
  <data key="d2">[{"text": "Dr. Ulf Dietrich Merbold (born June 20, 1941) is the first West German citizen and second German native (after Sigmund Jähn) to have flown in space.", "chunk_id": "1dda59241bb9cd52", "doc_id": "hp_cc1f6a95f8e649b8"}]</data>
  <data key="d3">["hp_cc1f6a95f8e649b8"]</data>
  <data key="d4">False</data>
</node>
<node id="European Space Agency Astronaut Corps">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A group of astronauts belonging to the European Space Agency.", "chunk_id": "1dda59241bb9cd52", "doc_id": "hp_cc1f6a95f8e649b8"}]</data>
  <data key="d2">[{"text": "He is also the first member of the European Space Agency Astronaut Corps to participate in a spaceflight mission and the first non-US citizen to reach orbit in a US spacecraft.", "chunk_id": "1dda59241bb9cd52", "doc_id": "hp_cc1f6a95f8e649b8"}]</data>
  <data key="d3">["hp_cc1f6a95f8e649b8"]</data>
  <data key="d4">False</data>
</node>
<node id="Byron Lichtenberg">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A Payload Specialist who flew on the shuttle in 1983.", "chunk_id": "1dda59241bb9cd52", "doc_id": "hp_cc1f6a95f8e649b8"}]</data>
  <data key="d2">[{"text": "In 1983, he and Byron Lichtenberg became the first Payload Specialists to fly on the shuttle.", "chunk_id": "1dda59241bb9cd52", "doc_id": "hp_cc1f6a95f8e649b8"}]</data>
  <data key="d3">["hp_cc1f6a95f8e649b8"]</data>
  <data key="d4">False</data>
</node>
