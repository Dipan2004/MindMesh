<node id="Hillsborough County Aviation Authority">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The public owner and operator of Plant City Airport and Tampa International Airport.", "chunk_id": "47b19fbaa70c2777", "doc_id": "hp_357ddba773097c91"}]</data>
  <data key="d2">[{"text": "The airport is publicly owned by the Hillsborough County Aviation Authority, which also operates Tampa International Airport.", "chunk_id": "47b19fbaa70c2777", "doc_id": "hp_357ddba773097c91"}]</data>
