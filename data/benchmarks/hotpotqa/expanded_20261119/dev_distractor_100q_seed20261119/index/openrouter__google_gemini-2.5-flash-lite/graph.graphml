<node id="podenco">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Spanish word for \"hound\".", "chunk_id": "f80e060f5f51afc7", "doc_id": "hp_a7eae4981b3aeb7c"}, {"text": "Podencos are the Spanish name for a kind of breeds.", "chunk_id": "4fb94dbd625515c2", "doc_id": "hp_0a96d1fd16b1ff98"}]</data>
  <data key="d2">[{"text": "The word \"podenco\" is Spanish for \"hound\".", "chunk_id": "f80e060f5f51afc7", "doc_id": "hp_a7eae4981b3aeb7c"}, {"text": "In Spanish, this kind of breeds are called \"podencos\" and in Portuguese, \"podengos\".", "chunk_id": "4fb94dbd625515c2", "doc_id": "hp_0a96d1fd16b1ff98"}]</data>
  <data key="d3">["hp_0a96d1fd16b1ff98", "hp_a7eae4981b3aeb7c"]</data>
  <data key="d4">False</data>
</node>
<node id="hound">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A type of dog bred for hunting.", "chunk_id": "f80e060f5f51afc7", "doc_id": "hp_a7eae4981b3aeb7c"}, {"text": "Hounds are a type of dog that rely on one sense.", "chunk_id": "4fb94dbd625515c2", "doc_id": "hp_0a96d1fd16b1ff98"}]</data>
  <data key="d2">[{"text": "The word \"podenco\" is Spanish for \"hound\".", "chunk_id": "f80e060f5f51afc7", "doc_id": "hp_a7eae4981b3aeb7c"}, {"text": "Unlike hounds or sighthounds which rely on just one sense, warren hounds tend to work with three senses: smell, sight and hearing.", "chunk_id": "4fb94dbd625515c2", "doc_id": "hp_0a96d1fd16b1ff98"}]</data>
  <data key="d3">["hp_0a96d1fd16b1ff98", "hp_a7eae4981b3aeb7c"]</data>
  <data key="d4">False</data>
</node>
<node id="Canarian">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Relating to or characteristic of the Canary Islands or its inhabitants.", "chunk_id": "f80e060f5f51afc7", "doc_id": "hp_a7eae4981b3aeb7c"}]</data>
  <data key="d2">[{"text": "\"Canario\" means \"Canarian\" or \"of the Canaries\".", "chunk_id": "f80e060f5f51afc7", "doc_id": "hp_a7eae4981b3aeb7c"}]</data>
  <data key="d3">["hp_a7eae4981b3aeb7c"]</data>
  <data key="d4">False</data>
</node>
