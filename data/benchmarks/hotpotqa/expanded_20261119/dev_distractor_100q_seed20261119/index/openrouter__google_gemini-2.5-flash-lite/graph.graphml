<node id="Kangchenjunga">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Kangchenjunga is the third highest peak on Earth, located approximately 4.2 km SSW from Gimmigela Chuli.", "chunk_id": "739d8f7ea6dfb06f", "doc_id": "hp_3fe42c6ffa4f5604"}]</data>
  <data key="d2">[{"text": "It has an elevation of 7350 m above sea level and is situated approximately 4.2 km NNE from Kangchenjunga, the third highest peak on Earth.", "chunk_id": "739d8f7ea6dfb06f", "doc_id": "hp_3fe42c6ffa4f5604"}]</data>
