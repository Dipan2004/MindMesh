<node id="Dan Baca">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The person whose photo appeared on an internet message board, later revealed to be part of a hoax he set up.", "chunk_id": "95ce3af60d609d99", "doc_id": "hp_c1d373fc7a1fc058"}]</data>
  <data key="d2">[{"text": "The photo was of Dan Baca, and it was later revealed to be an elaborate hoax, set up by Baca himself.", "chunk_id": "95ce3af60d609d99", "doc_id": "hp_c1d373fc7a1fc058"}]</data>
  <data key="d3">["hp_c1d373fc7a1fc058"]</data>
