  <data key="d1">[{"text": "Public art originating from Korea, with the statue of Admiral Yi Sun-sin being considered an important instance.", "chunk_id": "14151d0231146059", "doc_id": "hp_dd641696f4729ecc"}]</data>
  <data key="d2">[{"text": "It is considered one of Seoul's major landmarks and has been called \"one of the most important instances of Korean public art\".", "chunk_id": "14151d0231146059", "doc_id": "hp_dd641696f4729ecc"}]</data>
