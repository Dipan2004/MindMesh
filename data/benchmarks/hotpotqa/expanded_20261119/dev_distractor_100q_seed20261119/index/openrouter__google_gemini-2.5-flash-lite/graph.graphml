  <data key="d5">["WROTE"]</data>
  <data key="d6">Holland–Dozier–Holland wrote and composed the song "You Keep Me Hangin' On".</data>
  <data key="d7">[{"text": "\"You Keep Me Hangin' On\" is a 1966 song written and composed by Holland–Dozier–Holland.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c", "type": "WROTE"}]</data>
  <data key="d8">hp_d679581e3707876c</data>
</edge>
<edge source="The Supremes" target="You Keep Me Hangin' On">
  <data key="d5">["RECORDED"]</data>
  <data key="d6">The Supremes recorded a popular version of the song "You Keep Me Hangin' On" in 1966.</data>
  <data key="d7">[{"text": "It first became a popular \"Billboard\" Hot 100 number one hit for the American Motown group The Supremes in late 1966.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c", "type": "RECORDED"}]</data>
  <data key="d8">hp_d679581e3707876c</data>
</edge>
<edge source="The Supremes" target="Billboard Hot 100">
  <data key="d5">["CHARTED_ON"]</data>
  <data key="d6">The Supremes' version of "You Keep Me Hangin' On" reached number one on the Billboard Hot 100.</data>
  <data key="d7">[{"text": "It first became a popular \"Billboard\" Hot 100 number one hit for the American Motown group The Supremes in late 1966.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c", "type": "CHARTED_ON"}]</data>
  <data key="d8">hp_d679581e3707876c</data>
</edge>
<edge source="Vanilla Fudge" target="You Keep Me Hangin' On">
  <data key="d5">["COVERED"]</data>
  <data key="d6">Vanilla Fudge covered the song "You Keep Me Hangin' On".</data>
  <data key="d7">[{"text": "The rock band Vanilla Fudge covered the song a year later and had a top ten hit with their version.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c", "type": "COVERED"}]</data>
  <data key="d8">hp_d679581e3707876c</data>
</edge>
<edge source="Kim Wilde" target="You Keep Me Hangin' On">
  <data key="d5">["COVERED"]</data>
  <data key="d6">Kim Wilde covered the song "You Keep Me Hangin' On" in 1986.</data>
  <data key="d7">[{"text": "British pop singer Kim Wilde covered \"You Keep Me Hangin' On\" in 1986, bumping it back to number one on the \"Billboard\" Hot 100 in June 1987.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c", "type": "COVERED"}]</data>
  <data key="d8">hp_d679581e3707876c</data>
</edge>
