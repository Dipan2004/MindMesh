  <data key="d7">[{"text": "\"Check My Brain\" is a song by the American rock band Alice in Chains, featured on their fourth studio album \"Black Gives Way to Blue\" (2009).", "chunk_id": "0ab7d428406248fd", "doc_id": "hp_62d25a1f81638a35", "type": "RELEASED_BY"}, {"text": "Staub also mixed Alice in Chains' fourth studio album, \"Black Gives Way to Blue\".", "chunk_id": "c77d6dbc2b68e499", "doc_id": "hp_78545ba127712d38", "type": "PART_OF"}]</data>
