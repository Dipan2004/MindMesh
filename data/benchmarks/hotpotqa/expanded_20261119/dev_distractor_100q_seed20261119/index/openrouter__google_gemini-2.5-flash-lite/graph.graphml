</node>
<node id="Nadine Epstein">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The editor and executive publisher of Moment magazine since 2004.", "chunk_id": "7156f0efb6184faa", "doc_id": "hp_02c3149273f48869"}]</data>
  <data key="d2">[{"text": "In 2004, Nadine Epstein took over as editor and executive publisher of \"Moment.\"", "chunk_id": "7156f0efb6184faa", "doc_id": "hp_02c3149273f48869"}]</data>
  <data key="d3">["hp_02c3149273f48869"]</data>
  <data key="d4">False</data>
</node>
<node id="M1 highway (Russia)">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The M1 highway in Russia, also known as the \"Belarus Highway\" or road to Minsk, is a major trunk road connecting Moscow to the Belarusian border.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}]</data>
  <data key="d2">[{"text": "The Russian route M1 (also known as the \"Belarus Highway\", road to Minsk) is a major trunk road that runs from Moscow through Smolensk before reaching the border with Belarus.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}]</data>
  <data key="d3">["hp_03076e3832c431da"]</data>
  <data key="d4">False</data>
</node>
<node id="Belarus Highway">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An alternative name for the M1 highway in Russia, indicating its route towards Belarus.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}]</data>
  <data key="d2">[{"text": "The Russian route M1 (also known as the \"Belarus Highway\", road to Minsk) is a major trunk road that runs from Moscow through Smolensk before reaching the border with Belarus.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}]</data>
  <data key="d3">["hp_03076e3832c431da"]</data>
  <data key="d4">False</data>
</node>
<node id="road to Minsk">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An alternative name for the M1 highway in Russia, highlighting its destination.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}]</data>
  <data key="d2">[{"text": "The Russian route M1 (also known as the \"Belarus Highway\", road to Minsk) is a major trunk road that runs from Moscow through Smolensk before reaching the border with Belarus.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}]</data>
  <data key="d3">["hp_03076e3832c431da"]</data>
  <data key="d4">False</data>
</node>
<node id="Moscow">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The capital city of Russia, serving as the starting point of the M1 highway.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}, {"text": "A city in Russia, serving as a starting point for the M7 highway.", "chunk_id": "70054dbfb5decd76", "doc_id": "hp_161706e9647362c5"}, {"text": "The place where África de las Heras died.", "chunk_id": "9c96657c56b59858", "doc_id": "hp_16186a29c9da8f74"}, {"text": "Moscow is a city in Russia from which the M9 highway originates.", "chunk_id": "2d8fd36c09df60bf", "doc_id": "hp_360b3afe94cb5e9d"}, {"text": "The M2 highway connects to this city.", "chunk_id": "697dec343c6a0907", "doc_id": "hp_6c6156e6e2dae378"}, {"text": "Moscow is a city linked by the M6 highway to the Caspian Sea.", "chunk_id": "52585d7d35bf885c", "doc_id": "hp_72463d3d08feec19"}]</data>
  <data key="d2">[{"text": "The Russian route M1 (also known as the \"Belarus Highway\", road to Minsk) is a major trunk road that runs from Moscow through Smolensk before reaching the border with Belarus.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}, {"text": "The Russian Route M7 (also known as the \"Volga Highway\") is a major trunk road running from Moscow through Vladimir and Nizhny Novgorod to Kazan in Tatarstan and Ufa in Bashkortostan.", "chunk_id": "70054dbfb5decd76", "doc_id": "hp_161706e9647362c5"}, {"text": "África de las Heras Gavilán (Ceuta, 26 April 1909 – Moscow, 8 March 1988) was a Spanish Communist, naturalized Soviet citizen, and KGB Spy who went by the code name \"Patria\", but also used the names \"María Luisa de las Heras de Darbat\",\"María de la Sierra\",\"Patricia\", \"Ivonne\", \"María de las Heras\", \"Znoi\" and \"María Pavlovna\".", "chunk_id": "9c96657c56b59858", "doc_id": "hp_16186a29c9da8f74"}, {"text": "The Russian route M9, also known as the \"Baltic Highway\", is a 610 km-long trunk road that leads from Moscow through Volokolamsk to Russia's border with Latvia.", "chunk_id": "2d8fd36c09df60bf", "doc_id": "hp_360b3afe94cb5e9d"}, {"text": "The Russian route M2 (also known as the \"Crimea Highway\", (\"автодорога \"Крым\"\" )) is a major trunk road that connects Moscow to the Crimea.", "chunk_id": "697dec343c6a0907", "doc_id": "hp_6c6156e6e2dae378"}, {"text": "The Russian route M6 (or Р22, also known as the \"Caspian Highway\") is a major trunk road that links Moscow to the Caspian Sea.", "chunk_id": "52585d7d35bf885c", "doc_id": "hp_72463d3d08feec19"}]</data>
  <data key="d3">["hp_03076e3832c431da", "hp_161706e9647362c5", "hp_16186a29c9da8f74", "hp_360b3afe94cb5e9d", "hp_6c6156e6e2dae378", "hp_72463d3d08feec19"]</data>
  <data key="d4">False</data>
</node>
<node id="Smolensk">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city in Russia through which the M1 highway passes.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}]</data>
  <data key="d2">[{"text": "The Russian route M1 (also known as the \"Belarus Highway\", road to Minsk) is a major trunk road that runs from Moscow through Smolensk before reaching the border with Belarus.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}]</data>
  <data key="d3">["hp_03076e3832c431da"]</data>
  <data key="d4">False</data>
</node>
<node id="Belarus">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A country that the M1 highway reaches after crossing the border from Russia.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}, {"text": "A country whose border is reached by the R23 highway.", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d2">[{"text": "The Russian route M1 (also known as the \"Belarus Highway\", road to Minsk) is a major trunk road that runs from Moscow through Smolensk before reaching the border with Belarus.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}, {"text": "Russian route R23 or Pskov Highway Russian: Федера́льная автомоби́льная доро́га Р23 «Псков» is a Russian federal motorway that runs from St.Petersburg through Pskov until the border with Belarus.", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d3">["hp_03076e3832c431da", "hp_11fde9e76326875f"]</data>
  <data key="d4">False</data>
</node>
<node id="Odintsovo">
  <data key="d0">LOCATION</data>
