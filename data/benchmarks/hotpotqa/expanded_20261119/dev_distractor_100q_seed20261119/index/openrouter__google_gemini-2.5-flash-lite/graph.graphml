<node id="Premier League">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Premier League is a football league in which Swansea City competes.", "chunk_id": "da118e1ea3b59d0c", "doc_id": "hp_2eceaa9edae8d1f2"}]</data>
  <data key="d2">[{"text": "Claude Makélélé Sinda (] ; born 18 February 1973) is a French former footballer and current assistant coach at Premier League club Swansea City.", "chunk_id": "da118e1ea3b59d0c", "doc_id": "hp_2eceaa9edae8d1f2"}]</data>
