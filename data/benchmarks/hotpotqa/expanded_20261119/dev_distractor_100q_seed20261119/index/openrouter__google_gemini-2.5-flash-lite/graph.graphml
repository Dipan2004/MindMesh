<edge source="Mirosław Dreszer" target="Polish U-18 national team">
  <data key="d5">["PLAYED_FOR"]</data>
  <data key="d6">Mirosław Dreszer started as the goalkeeper for the Polish U-18 national team in 1984.</data>
  <data key="d7">[{"text": "In 1984, he started as the goalkeeper for the Polish U-18 national team, which finished in third place in the European Championship.", "chunk_id": "2463a2e6b54ba2b9", "doc_id": "hp_3d488dbab399d265", "type": "PLAYED_FOR"}]</data>
  <data key="d8">hp_3d488dbab399d265</data>
</edge>
