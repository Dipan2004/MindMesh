  <data key="d2">[{"text": "Age of Secrets: The Conspiracy that Toppled Richard Nixon and the Hidden Death of Howard Hughes is a conspiracy theory-oriented biography of Howard Hughes personal advisor John H. Meier.", "chunk_id": "922d12307dca0bd3", "doc_id": "hp_d491b739e827ef2c"}]</data>
