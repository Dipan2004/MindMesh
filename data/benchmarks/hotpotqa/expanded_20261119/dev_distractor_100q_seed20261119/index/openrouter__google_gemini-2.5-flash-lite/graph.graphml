  <data key="d2">[{"text": "She quit acting after her marriage and currently lives in Mumbai with her husband Fazal and goes by the name Salma Manekia.", "chunk_id": "1621f78ea00aa2b4", "doc_id": "hp_140ab3de808ede2a"}]</data>
  <data key="d3">["hp_140ab3de808ede2a"]</data>
  <data key="d4">False</data>
</node>
