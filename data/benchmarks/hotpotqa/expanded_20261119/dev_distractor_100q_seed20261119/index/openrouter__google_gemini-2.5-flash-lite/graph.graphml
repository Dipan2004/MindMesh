<node id="Central Avenue Historic District">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A historic district located in Dayton, Ohio, composed of houses dating primarily from the turn of the 20th century.", "chunk_id": "967deaf2512420da", "doc_id": "hp_6f092134262031b8"}]</data>
  <data key="d2">[{"text": "The Central Avenue Historic District is a small segment of the larger Grafton Hill neighborhood of Dayton, Ohio, United States.", "chunk_id": "967deaf2512420da", "doc_id": "hp_6f092134262031b8"}]</data>
  <data key="d3">["hp_6f092134262031b8"]</data>
  <data key="d4">False</data>
</node>
<node id="Grafton Hill">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A neighborhood in Dayton, Ohio, which contains the Central Avenue Historic District.", "chunk_id": "967deaf2512420da", "doc_id": "hp_6f092134262031b8"}]</data>
  <data key="d2">[{"text": "The Central Avenue Historic District is a small segment of the larger Grafton Hill neighborhood of Dayton, Ohio, United States.", "chunk_id": "967deaf2512420da", "doc_id": "hp_6f092134262031b8"}]</data>
  <data key="d3">["hp_6f092134262031b8"]</data>
  <data key="d4">False</data>
</node>
<node id="Dayton View">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A neighborhood in Dayton, Ohio, adjacent to Grafton Hill.", "chunk_id": "967deaf2512420da", "doc_id": "hp_6f092134262031b8"}]</data>
  <data key="d2">[{"text": "Composed of just two blocks near the border between Grafton Hill and Dayton View, the historic district comprises a cohesive collection of houses dating primarily from the turn of the 20th century, and it has been named a historic site.", "chunk_id": "967deaf2512420da", "doc_id": "hp_6f092134262031b8"}]</data>
  <data key="d3">["hp_6f092134262031b8"]</data>
  <data key="d4">False</data>
</node>
