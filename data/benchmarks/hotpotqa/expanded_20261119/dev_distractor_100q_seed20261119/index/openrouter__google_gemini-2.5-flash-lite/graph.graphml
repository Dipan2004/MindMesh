<edge source="14:59" target="15 minutes of fame">
  <data key="d5">["REFERENCE"]</data>
  <data key="d6">The album title 14:59 is a reference to the concept of "15 minutes of fame".</data>
  <data key="d7">[{"text": "The album's title is a self-deprecating reference to the \"15 minutes of fame\" critics claimed the band was riding on.", "chunk_id": "a83c783458cb120f", "doc_id": "hp_767039256bd5743c", "type": "REFERENCE"}]</data>
  <data key="d8">hp_767039256bd5743c</data>
