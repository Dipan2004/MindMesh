  <data key="d5">["RECEIVED_AWARD_AT"]</data>
  <data key="d6">Florence and the Machine received an award at the 2009 Brit Awards.</data>
  <data key="d7">[{"text": "At the 2009 Brit Awards they received the Brit Awards \"Critics' Choice\" award.", "chunk_id": "a0e37e5744f28418", "doc_id": "hp_6d4a91fc9052bf4e", "type": "RECEIVED_AWARD_AT"}]</data>
