<edge source="Istanbul Şehir University" target="academic year of 2010-11">
  <data key="d5">["STARTED_EDUCATION_IN"]</data>
  <data key="d6">Istanbul Şehir University started its education in the academic year of 2010-11.</data>
  <data key="d7">[{"text": "The university started its education in the academic year of 2010-11 at its campus in Altunizade, Üsküdar, following a ceremony held on October 5, 2010 that was attended by then State President Abdullah Gül, Prime Minister Recep Tayyip Erdoğan and Minister of Foreign Affairs Ahmet Davutoğlu.", "chunk_id": "c4ae848456d08dbd", "doc_id": "hp_0470400943ee62eb", "type": "STARTED_EDUCATION_IN"}]</data>
