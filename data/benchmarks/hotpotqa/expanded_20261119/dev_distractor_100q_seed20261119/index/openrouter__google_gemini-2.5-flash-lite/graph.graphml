<node id="hunting dog">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A dog used for hunting.", "chunk_id": "f80e060f5f51afc7", "doc_id": "hp_a7eae4981b3aeb7c"}]</data>
  <data key="d2">[{"text": "The Podenco Canario is still used in the Canary Islands today in packs as a hunting dog, primarily used for rabbit hunting.", "chunk_id": "f80e060f5f51afc7", "doc_id": "hp_a7eae4981b3aeb7c"}]</data>
