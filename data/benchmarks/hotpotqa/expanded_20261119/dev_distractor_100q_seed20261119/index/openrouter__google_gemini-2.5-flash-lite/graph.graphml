<node id="Monterrey">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The birthplace of Fernando Fernández.", "chunk_id": "f22987b0a2a07a86", "doc_id": "hp_0a82eabb231d743f"}]</data>
  <data key="d2">[{"text": "He was born on November 9, 1916, in Monterrey, Mexico, and died in Mexico City, Mexico, on November 24, 1999.", "chunk_id": "f22987b0a2a07a86", "doc_id": "hp_0a82eabb231d743f"}]</data>
