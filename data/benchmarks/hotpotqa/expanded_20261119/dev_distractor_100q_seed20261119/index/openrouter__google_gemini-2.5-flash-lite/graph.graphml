<edge source="Richard Hammond's Engineering Connections" target="National Geographic Channel">
  <data key="d5">["BROADCAST_ON", "PREMIERED_ON", "PREMIERED_ON"]</data>
  <data key="d6">The documentary series 'Richard Hammond's Engineering Connections' was originally broadcast on the National Geographic Channel.</data>
  <data key="d7">[{"text": "Richard Hammond's Engineering Connections is a documentary series originally broadcast on the National Geographic Channel, and later on BBC2.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d", "type": "BROADCAST_ON"}, {"text": "The first series premièred on 8 September 2008, on National Geographic, and on 1 March 2010, on BBC2.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d", "type": "PREMIERED_ON"}, {"text": "The second series premièred on 7 September 2009, on National Geographic, and on 8 May 2010, on BBC2.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d", "type": "PREMIERED_ON"}]</data>
  <data key="d8">hp_8429039f0ec9c01d</data>
</edge>
<edge source="Richard Hammond's Engineering Connections" target="BBC2">
  <data key="d5">["BROADCAST_ON", "PREMIERED_ON", "PREMIERED_ON", "PREMIERED_ON"]</data>
  <data key="d6">The documentary series 'Richard Hammond's Engineering Connections' was later broadcast on BBC2.</data>
  <data key="d7">[{"text": "Richard Hammond's Engineering Connections is a documentary series originally broadcast on the National Geographic Channel, and later on BBC2.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d", "type": "BROADCAST_ON"}, {"text": "The first series premièred on 8 September 2008, on National Geographic, and on 1 March 2010, on BBC2.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d", "type": "PREMIERED_ON"}, {"text": "The second series premièred on 7 September 2009, on National Geographic, and on 8 May 2010, on BBC2.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d", "type": "PREMIERED_ON"}, {"text": "The third series premièred on 8 May 2011, on BBC2 and contained six episodes.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d", "type": "PREMIERED_ON"}]</data>
  <data key="d8">hp_8429039f0ec9c01d</data>
</edge>
