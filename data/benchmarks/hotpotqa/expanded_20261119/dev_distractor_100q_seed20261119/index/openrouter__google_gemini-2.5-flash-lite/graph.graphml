  <data key="d2">[{"text": "The Rivals for Catan (German: \"Die Fürsten von Catan\" ) is an updated revision of the \"Catan Card Game\", a card game adaptation of \"The Settlers of Catan\".", "chunk_id": "155359f8ca0aea2f", "doc_id": "hp_5f6bdf06a278e8d8"}]</data>
