  <data key="d7">[{"text": "Robert A. James (died 1983) was an American businessman, the founder of Raymond James Financial, an S&amp;P 500-listed financial services company.", "chunk_id": "44c0c5d2ca4184c5", "doc_id": "hp_14d468e130d3ae29", "type": "FOUNDED_BY"}, {"text": "Thomas James (born 1942/43) is an American billionaire businessman, the chairman of Raymond James Financial, founded by his father Robert James, for 30 years.", "chunk_id": "b6874d56d2fdd648", "doc_id": "hp_18fbcd7469354b78", "type": "FOUNDED_BY"}]</data>
  <data key="d8">hp_14d468e130d3ae29</data>
