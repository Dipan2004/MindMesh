  <data key="d7">[{"text": "It describes the battles to develop cacao plantations in the forests of the Bahia state of Brazil.", "chunk_id": "5b9d731909fa866e", "doc_id": "hp_3182b9b6096ed733", "type": "DESCRIBES"}]</data>
