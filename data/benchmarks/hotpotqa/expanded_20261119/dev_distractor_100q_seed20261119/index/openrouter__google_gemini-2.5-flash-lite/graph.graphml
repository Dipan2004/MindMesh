  <data key="d1">[{"text": "A song by Fleetwood Mac.", "chunk_id": "9ed3e6f68a811c70", "doc_id": "hp_6ba5d00f572e646d"}, {"text": "A South Korean male duo.", "chunk_id": "a3f010c3ed689994", "doc_id": "hp_d09611b7de0b46ad"}, {"text": "The first album released by the band Brown Eyes.", "chunk_id": "a3f010c3ed689994", "doc_id": "hp_d09611b7de0b46ad"}]</data>
  <data key="d2">[{"text": "\"Brown Eyes\" is a song by Fleetwood Mac from the 1979 double LP \"Tusk\".", "chunk_id": "9ed3e6f68a811c70", "doc_id": "hp_6ba5d00f572e646d"}, {"text": "Brown Eyes (Korean: 브라운아이즈) is a South Korean male duo consisting of members, Yoon Gun and Naul.", "chunk_id": "a3f010c3ed689994", "doc_id": "hp_d09611b7de0b46ad"}, {"text": "Brown Eyes released their first album, \"Brown Eyes\" on June 7, 2001.", "chunk_id": "a3f010c3ed689994", "doc_id": "hp_d09611b7de0b46ad"}]</data>
