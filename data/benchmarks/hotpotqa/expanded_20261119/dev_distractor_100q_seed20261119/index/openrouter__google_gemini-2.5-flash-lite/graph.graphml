<node id="Julius Akosah">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A Cameroonian-Hongkonger professional association football player who plays as a striker.", "chunk_id": "45f30e37c1e59bea", "doc_id": "hp_1cf743b0ec89744f"}]</data>
  <data key="d2">[{"text": "Julius Pongla Akosah ( \"Akosah\", born (1982--)16 1982 ) is a Cameroonian-Hongkonger professional association football player, his position is striker.", "chunk_id": "45f30e37c1e59bea", "doc_id": "hp_1cf743b0ec89744f"}]</data>
  <data key="d3">["hp_1cf743b0ec89744f"]</data>
  <data key="d4">False</data>
</node>
<node id="Cameroon">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A country for which Julius Akosah was called to play.", "chunk_id": "45f30e37c1e59bea", "doc_id": "hp_1cf743b0ec89744f"}, {"text": "Cameroon is the country of origin for Wilfred Bamnjo.", "chunk_id": "7c7e004f8d4bc49c", "doc_id": "hp_6dd6203cbe711a5e"}]</data>
  <data key="d2">[{"text": "He was called for Cameroon but he is eligible to play for Hong Kong in international tournaments.", "chunk_id": "45f30e37c1e59bea", "doc_id": "hp_1cf743b0ec89744f"}, {"text": "Wilfred Bamnjo (born 27 March 1980 in Cameroon) is a Cameroonian football player who currently plays for Hong Kong First Division League club Happy Valley.", "chunk_id": "7c7e004f8d4bc49c", "doc_id": "hp_6dd6203cbe711a5e"}]</data>
  <data key="d3">["hp_1cf743b0ec89744f", "hp_6dd6203cbe711a5e"]</data>
  <data key="d4">False</data>
</node>
<node id="Agumon">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A nickname commonly used by Hong Kong football fans for Julius Akosah.", "chunk_id": "45f30e37c1e59bea", "doc_id": "hp_1cf743b0ec89744f"}]</data>
  <data key="d2">[{"text": "Hong Kong football fans commonly use Agumon as a nickname for him because of his transcriptional name.", "chunk_id": "45f30e37c1e59bea", "doc_id": "hp_1cf743b0ec89744f"}]</data>
  <data key="d3">["hp_1cf743b0ec89744f"]</data>
  <data key="d4">False</data>
</node>
<node id="Happy Valley">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A Hong Kong First Division club for which Julius Akosah is currently playing.", "chunk_id": "45f30e37c1e59bea", "doc_id": "hp_1cf743b0ec89744f"}, {"text": "Happy Valley is a Hong Kong First Division League club for which Wilfred Bamnjo currently plays.", "chunk_id": "7c7e004f8d4bc49c", "doc_id": "hp_6dd6203cbe711a5e"}, {"text": "The champion team of the 2005-06 Hong Kong First Division League.", "chunk_id": "0fb0a4062ab720d1", "doc_id": "hp_a2558257c20dfe87"}]</data>
  <data key="d2">[{"text": "He is currently playing for Hong Kong First Division club Happy Valley.", "chunk_id": "45f30e37c1e59bea", "doc_id": "hp_1cf743b0ec89744f"}, {"text": "Wilfred Bamnjo (born 27 March 1980 in Cameroon) is a Cameroonian football player who currently plays for Hong Kong First Division League club Happy Valley.", "chunk_id": "7c7e004f8d4bc49c", "doc_id": "hp_6dd6203cbe711a5e"}, {"text": "The final champion is Happy Valley, which is their 6th champion.", "chunk_id": "0fb0a4062ab720d1", "doc_id": "hp_a2558257c20dfe87"}]</data>
  <data key="d3">["hp_1cf743b0ec89744f", "hp_6dd6203cbe711a5e", "hp_a2558257c20dfe87"]</data>
  <data key="d4">False</data>
</node>
<node id="Sports Illustrated">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Sports Illustrated is an American sports media franchise.", "chunk_id": "3f69a638a2ff7786", "doc_id": "hp_1d84cd22e22a1416"}, {"text": "A sports magazine that featured Phil Edwards on its cover.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
  <data key="d2">[{"text": "Sports Illustrated is an American sports media franchise owned by Time Inc.", "chunk_id": "3f69a638a2ff7786", "doc_id": "hp_1d84cd22e22a1416"}, {"text": "He was the subject of a cover story, and his photo appeared on the cover of Sports Illustrated in 1966.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
  <data key="d3">["hp_1d84cd22e22a1416", "hp_d425f0e62b7587a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Time Inc.">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Time Inc. is the owner of the Sports Illustrated media franchise.", "chunk_id": "3f69a638a2ff7786", "doc_id": "hp_1d84cd22e22a1416"}]</data>
  <data key="d2">[{"text": "Sports Illustrated is an American sports media franchise owned by Time Inc.", "chunk_id": "3f69a638a2ff7786", "doc_id": "hp_1d84cd22e22a1416"}]</data>
  <data key="d3">["hp_1d84cd22e22a1416"]</data>
  <data key="d4">False</data>
</node>
<node id="magazine">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The self-titled magazine of Sports Illustrated has over 3 million subscribers.", "chunk_id": "3f69a638a2ff7786", "doc_id": "hp_1d84cd22e22a1416"}, {"text": "A publication containing articles and illustrations or other items of interest, often on a particular subject.", "chunk_id": "e3034f5ee568e837", "doc_id": "hp_d20dd81b0b3d11dc"}]</data>
  <data key="d2">[{"text": "Its self-titled magazine has over 3 million subscribers and is read by 23 million people each week, including over 18 million men.", "chunk_id": "3f69a638a2ff7786", "doc_id": "hp_1d84cd22e22a1416"}, {"text": "Dwell is a design and technology brand.", "chunk_id": "e3034f5ee568e837", "doc_id": "hp_d20dd81b0b3d11dc"}]</data>
  <data key="d3">["hp_1d84cd22e22a1416", "hp_d20dd81b0b3d11dc"]</data>
  <data key="d4">False</data>
</node>
<node id="National Magazine Award for General Excellence">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The National Magazine Award for General Excellence is an award that Sports Illustrated's magazine won twice.", "chunk_id": "3f69a638a2ff7786", "doc_id": "hp_1d84cd22e22a1416"}]</data>
  <data key="d2">[{"text": "It was the first magazine with circulation over one million to win the National Magazine Award for General Excellence twice.", "chunk_id": "3f69a638a2ff7786", "doc_id": "hp_1d84cd22e22a1416"}]</data>
  <data key="d3">["hp_1d84cd22e22a1416"]</data>
  <data key="d4">False</data>
</node>
<node id="swimsuit issue">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The swimsuit issue of Sports Illustrated has been published since 1964 and generates its own television shows, videos and calendars.", "chunk_id": "3f69a638a2ff7786", "doc_id": "hp_1d84cd22e22a1416"}]</data>
  <data key="d2">[{"text": "Its swimsuit issue, which has been published since 1964, is now an annual publishing event that generates its own television shows, videos and calendars.", "chunk_id": "3f69a638a2ff7786", "doc_id": "hp_1d84cd22e22a1416"}]</data>
  <data key="d3">["hp_1d84cd22e22a1416"]</data>
  <data key="d4">False</data>
</node>
<node id="Hippophae">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Hippophae is a genus of sea buckthorns.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d2">[{"text": "Hippophae is a genus of sea buckthorns, deciduous shrubs in the family Elaeagnaceae.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d3">["hp_1dd36dcaeea5be41"]</data>
  <data key="d4">False</data>
</node>
<node id="sea buckthorn">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Sea buckthorn is a common name for plants in the genus Hippophae.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}, {"text": "Sea buckthorns are deciduous shrubs in the family Elaeagnaceae.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d2">[{"text": "The name sea buckthorn may be hyphenated to avoid confusion with the buckthorns (\"Rhamnus\", family Rhamnaceae).", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}, {"text": "Hippophae is a genus of sea buckthorns, deciduous shrubs in the family Elaeagnaceae.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d3">["hp_1dd36dcaeea5be41"]</data>
  <data key="d4">False</data>
</node>
<node id="buckthorns">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Buckthorns are plants in the genus Rhamnus, belonging to the family Rhamnaceae.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d2">[{"text": "The name sea buckthorn may be hyphenated to avoid confusion with the buckthorns (\"Rhamnus\", family Rhamnaceae).", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d3">["hp_1dd36dcaeea5be41"]</data>
  <data key="d4">False</data>
</node>
<node id="Rhamnus">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Rhamnus is a genus of plants in the family Rhamnaceae.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d2">[{"text": "The name sea buckthorn may be hyphenated to avoid confusion with the buckthorns (\"Rhamnus\", family Rhamnaceae).", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d3">["hp_1dd36dcaeea5be41"]</data>
  <data key="d4">False</data>
</node>
<node id="Rhamnaceae">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Rhamnaceae is a family of plants that includes the genus Rhamnus.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}, {"text": "Rhamnaceae is a family of plants.", "chunk_id": "6b62f66ee7182ec5", "doc_id": "hp_2ca4198c5242553c"}, {"text": "Rhamnaceae is the buckthorn family, which includes the species Ceanothus leucodermis.", "chunk_id": "c9bcac595ad54970", "doc_id": "hp_c2054f4e8704c0e5"}]</data>
  <data key="d2">[{"text": "The name sea buckthorn may be hyphenated to avoid confusion with the buckthorns (\"Rhamnus\", family Rhamnaceae).", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}, {"text": "Phylica is a genus of plants in the family Rhamnaceae.", "chunk_id": "6b62f66ee7182ec5", "doc_id": "hp_2ca4198c5242553c"}, {"text": "Ceanothus leucodermis, with the common name chaparral whitethorn or chaparral white thorn, is a species of shrub in the buckthorn family Rhamnaceae.", "chunk_id": "c9bcac595ad54970", "doc_id": "hp_c2054f4e8704c0e5"}]</data>
  <data key="d3">["hp_1dd36dcaeea5be41", "hp_2ca4198c5242553c", "hp_c2054f4e8704c0e5"]</data>
  <data key="d4">False</data>
</node>
<node id="sandthorn">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Sandthorn is an alternative name for plants in the genus Hippophae.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d2">[{"text": "It is also referred to as sandthorn, sallowthorn, or seaberry.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d3">["hp_1dd36dcaeea5be41"]</data>
  <data key="d4">False</data>
</node>
<node id="sallowthorn">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Sallowthorn is an alternative name for plants in the genus Hippophae.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d2">[{"text": "It is also referred to as sandthorn, sallowthorn, or seaberry.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d3">["hp_1dd36dcaeea5be41"]</data>
  <data key="d4">False</data>
</node>
<node id="seaberry">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Seaberry is an alternative name for plants in the genus Hippophae.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d2">[{"text": "It is also referred to as sandthorn, sallowthorn, or seaberry.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d3">["hp_1dd36dcaeea5be41"]</data>
  <data key="d4">False</data>
</node>
<node id="Battle of Jeokjinpo">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A battle that occurred on 8 May 1592.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}]</data>
  <data key="d2">[{"text": "Battle of Jeokjinpo was fought on 8 May 1592.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}]</data>
  <data key="d3">["hp_1de0ceb21cf100b1"]</data>
  <data key="d4">False</data>
</node>
<node id="8 May 1592">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The date on which the Battle of Jeokjinpo was fought.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}]</data>
  <data key="d2">[{"text": "Battle of Jeokjinpo was fought on 8 May 1592.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}]</data>
  <data key="d3">["hp_1de0ceb21cf100b1"]</data>
  <data key="d4">False</data>
</node>
<node id="Battle of Happo">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A previous battle that preceded the Battle of Jeokjinpo.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}, {"text": "The Battle of Happo was a naval engagement that occurred on May 7, 1592.", "chunk_id": "bf39df43067a80b1", "doc_id": "hp_3a9829e8fd3b32c6"}]</data>
  <data key="d2">[{"text": "After the Battle of Happo, further reports of an additional 13 Japanese ships prevented Yi Sun-sin and his fleet from resting long on the morning of May 8.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}, {"text": "The Battle of Happo was a naval engagement on May 7, 1592, one of the three Joseon naval campaigns of 1592 conducted by Korean admiral Yi Sun-sin during Japanese invasions of Korea (1592-1598) against the Japanese forces of Toyotomi Hideyoshi.", "chunk_id": "bf39df43067a80b1", "doc_id": "hp_3a9829e8fd3b32c6"}]</data>
  <data key="d3">["hp_1de0ceb21cf100b1", "hp_3a9829e8fd3b32c6"]</data>
  <data key="d4">False</data>
</node>
<node id="Yi Sun-sin">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An admiral who led the Korean fleet during the Battle of Jeokjinpo.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}, {"text": "A Korean admiral who conducted naval campaigns during the Japanese invasions of Korea.", "chunk_id": "68610c0d374404f2", "doc_id": "hp_3358c15c20048369"}, {"text": "Yi Sun-sin was a Korean admiral who conducted the Joseon naval campaigns of 1592.", "chunk_id": "bf39df43067a80b1", "doc_id": "hp_3a9829e8fd3b32c6"}, {"text": "A Korean admiral who commanded forces in the Battle of Hansan Island.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}, {"text": "Yi Sun-sin was a Korean admiral who served during the Joseon Dynasty.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}, {"text": "The historical figure on whom the television series 'Immortal Admiral Yi Sun-sin' is based.", "chunk_id": "c7de5b4d4d75a945", "doc_id": "hp_98a7f8e12fb63c7b"}, {"text": "A Korean naval commander who lived during the Joseon Dynasty and authored the Nanjung Ilgi.", "chunk_id": "99c215cb87242ef5", "doc_id": "hp_d01934819d3bc4ad"}]</data>
  <data key="d2">[{"text": "After the Battle of Happo, further reports of an additional 13 Japanese ships prevented Yi Sun-sin and his fleet from resting long on the morning of May 8.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}, {"text": "The Joseon naval campaigns of 1592 was naval campaigns conducted by Korean admiral Yi Sun-sin during Japanese invasions of Korea (1592-1598) against the Japanese forces of Toyotomi Hideyoshi.", "chunk_id": "68610c0d374404f2", "doc_id": "hp_3358c15c20048369"}, {"text": "The Battle of Happo was a naval engagement on May 7, 1592, one of the three Joseon naval campaigns of 1592 conducted by Korean admiral Yi Sun-sin during Japanese invasions of Korea (1592-1598) against the Japanese forces of Toyotomi Hideyoshi.", "chunk_id": "bf39df43067a80b1", "doc_id": "hp_3a9829e8fd3b32c6"}, {"text": "Korean admiral Yi Sun-sin destroyed at least 47 Japanese ships, captured 12.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}, {"text": "Won led many successful campaigns with Yi Il and Yi Sun-sin against the Jurchens.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92"}, {"text": "Immortal Admiral Yi Sun-sin (; lit. \"The Immortal Yi Sun-sin\") is a South Korean television series based on the life of Yi Sun-sin, starring Kim Myung-min in the title role.", "chunk_id": "c7de5b4d4d75a945", "doc_id": "hp_98a7f8e12fb63c7b"}, {"text": "Nanjung Ilgi or War Diary of Yi Sun-sin is the personal diary of Admiral Yi Sun-sin (Hangul: 이순신, Hanja: 李舜臣), a Korean naval commander who lived during the Joseon Dynasty.", "chunk_id": "99c215cb87242ef5", "doc_id": "hp_d01934819d3bc4ad"}]</data>
  <data key="d3">["hp_1de0ceb21cf100b1", "hp_3358c15c20048369", "hp_3a9829e8fd3b32c6", "hp_4e9436b9b6a97ad9", "hp_75d8594536b8ad92", "hp_98a7f8e12fb63c7b", "hp_d01934819d3bc4ad"]</data>
  <data key="d4">False</data>
</node>
<node id="Japanese ships">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Vessels belonging to the Japanese forces that were encountered and sunk during the Battle of Jeokjinpo.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}, {"text": "Naval vessels belonging to Japan that were involved in the Battle of Hansan Island.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d2">[{"text": "After the Battle of Happo, further reports of an additional 13 Japanese ships prevented Yi Sun-sin and his fleet from resting long on the morning of May 8.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}, {"text": "Korean admiral Yi Sun-sin destroyed at least 47 Japanese ships, captured 12.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d3">["hp_1de0ceb21cf100b1", "hp_4e9436b9b6a97ad9"]</data>
  <data key="d4">False</data>
</node>
<node id="Jinhae">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location in the direction of which the Japanese ships fled.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}]</data>
  <data key="d2">[{"text": "The Korean forces caught up with the Japanese ships at Jeokjinpo, but the Japanese officers and crew abandoned their ships and fled into the mountains before the Koreans could fire upon them.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}]</data>
  <data key="d3">["hp_1de0ceb21cf100b1"]</data>
  <data key="d4">False</data>
</node>
<node id="Korean forces">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The military forces of Korea that participated in the Battle of Jeokjinpo.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}]</data>
  <data key="d2">[{"text": "The Korean forces caught up with the Japanese ships at Jeokjinpo, but the Japanese officers and crew abandoned their ships and fled into the mountains before the Koreans could fire upon them.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}]</data>
  <data key="d3">["hp_1de0ceb21cf100b1"]</data>
  <data key="d4">False</data>
</node>
<node id="Japanese officers and crew">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The personnel aboard the Japanese ships who abandoned them during the Battle of Jeokjinpo.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}]</data>
  <data key="d2">[{"text": "The Korean forces caught up with the Japanese ships at Jeokjinpo, but the Japanese officers and crew abandoned their ships and fled into the mountains before the Koreans could fire upon them.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}]</data>
  <data key="d3">["hp_1de0ceb21cf100b1"]</data>
  <data key="d4">False</data>
</node>
<node id="Japanese warships">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Warships belonging to the Japanese that were sunk by the Korean forces.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}]</data>
  <data key="d2">[{"text": "The Koreans easily sunk the 13 abandoned Japanese warships.", "chunk_id": "97d42ce68ff1435a", "doc_id": "hp_1de0ceb21cf100b1"}]</data>
  <data key="d3">["hp_1de0ceb21cf100b1"]</data>
  <data key="d4">False</data>
</node>
<node id="Electroconvulsive therapy">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A psychiatric treatment in which seizures are electrically induced in patients to provide relief from mental disorders.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d2">[{"text": "Electroconvulsive therapy (ECT), formerly known as electroshock therapy, and often referred to as shock treatment, is a psychiatric treatment in which seizures are electrically induced in patients to provide relief from mental disorders.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d3">["hp_1dfa7f266b4cbbfd"]</data>
  <data key="d4">False</data>
</node>
<node id="electroshock therapy">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "An older name for electroconvulsive therapy.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d2">[{"text": "Electroconvulsive therapy (ECT), formerly known as electroshock therapy, and often referred to as shock treatment, is a psychiatric treatment in which seizures are electrically induced in patients to provide relief from mental disorders.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d3">["hp_1dfa7f266b4cbbfd"]</data>
  <data key="d4">False</data>
</node>
<node id="shock treatment">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A term used to refer to electroconvulsive therapy.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d2">[{"text": "Electroconvulsive therapy (ECT), formerly known as electroshock therapy, and often referred to as shock treatment, is a psychiatric treatment in which seizures are electrically induced in patients to provide relief from mental disorders.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d3">["hp_1dfa7f266b4cbbfd"]</data>
  <data key="d4">False</data>
</node>
<node id="mental disorders">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Conditions affecting a person's thinking, feeling, or mood.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d2">[{"text": "Electroconvulsive therapy (ECT), formerly known as electroshock therapy, and often referred to as shock treatment, is a psychiatric treatment in which seizures are electrically induced in patients to provide relief from mental disorders.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d3">["hp_1dfa7f266b4cbbfd"]</data>
  <data key="d4">False</data>
</node>
<node id="major depressive disorder">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A mood disorder characterized by persistent sadness and loss of interest.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d2">[{"text": "ECT is often used with informed consent as a last line of intervention for major depressive disorder, mania, and catatonia.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d3">["hp_1dfa7f266b4cbbfd"]</data>
  <data key="d4">False</data>
</node>
<node id="mania">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A mood disorder characterized by elevated mood, energy, and activity.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d2">[{"text": "ECT is often used with informed consent as a last line of intervention for major depressive disorder, mania, and catatonia.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d3">["hp_1dfa7f266b4cbbfd"]</data>
  <data key="d4">False</data>
</node>
<node id="catatonia">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A state of abnormal motor behavior that can manifest as immobility or excessive activity.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d2">[{"text": "ECT is often used with informed consent as a last line of intervention for major depressive disorder, mania, and catatonia.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d3">["hp_1dfa7f266b4cbbfd"]</data>
  <data key="d4">False</data>
</node>
<node id="United States Food and Drug Administration">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A federal agency responsible for protecting public health by ensuring the safety, efficacy, and security of human and veterinary drugs, biological products, medical devices, food, and cosmetics.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d2">[{"text": "ECT machines have been placed in the Class III category (high risk) by the United States Food and Drug Administration (FDA) since 1976.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d3">["hp_1dfa7f266b4cbbfd"]</data>
  <data key="d4">False</data>
</node>
<node id="FDA">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The United States Food and Drug Administration, responsible for regulating food and drugs.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d2">[{"text": "ECT machines have been placed in the Class III category (high risk) by the United States Food and Drug Administration (FDA) since 1976.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd"}]</data>
  <data key="d3">["hp_1dfa7f266b4cbbfd"]</data>
  <data key="d4">False</data>
</node>
