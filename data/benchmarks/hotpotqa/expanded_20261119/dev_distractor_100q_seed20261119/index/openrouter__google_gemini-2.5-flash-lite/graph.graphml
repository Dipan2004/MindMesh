<node id="World Ice Hockey Championships">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "An international ice hockey competition.", "chunk_id": "8c9123487c66f805", "doc_id": "hp_f23b02c7bab7a782"}]</data>
  <data key="d2">[{"text": "The Smoke Eaters won their first Allan Cup in 1938; they won the 1939 World Ice Hockey Championships and the 1961 World Ice Hockey Championships; and they won another Allan Cup in 1962.", "chunk_id": "8c9123487c66f805", "doc_id": "hp_f23b02c7bab7a782"}]</data>
