<edge source="Hong Kong 08" target="Second Division">
  <data key="d5">["SHOULD_RELEGATE_TO"]</data>
  <data key="d6">Hong Kong 08 was supposed to be relegated to the Second Division.</data>
  <data key="d7">[{"text": "According to the rule, the bottom 2 teams, Hong Kong 08 and South China, should relegate to the Second Division.", "chunk_id": "0fb0a4062ab720d1", "doc_id": "hp_a2558257c20dfe87", "type": "SHOULD_RELEGATE_TO"}]</data>
