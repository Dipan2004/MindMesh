  <data key="d7">[{"text": "Gayle's debut single was 1970's \"I've Cried (The Blue Right Out of My Eyes)\" via Decca Records, which reached the top-forty of the \"Billboard\" Hot Country Singles chart.", "chunk_id": "79f2e927bc5b3f09", "doc_id": "hp_3b9acbbdcc47f797", "type": "DEBUT_SINGLE"}]</data>
