  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Salvia officinalis is a widely produced herb used in cooking, also known as common sage.", "chunk_id": "5634c2e12f5049d1", "doc_id": "hp_ea708a0e606fa04d"}]</data>
  <data key="d2">[{"text": "It includes the widely produced herb used in cooking, \"Salvia officinalis\" (common sage, or just \"sage\").", "chunk_id": "5634c2e12f5049d1", "doc_id": "hp_ea708a0e606fa04d"}]</data>
  <data key="d3">["hp_ea708a0e606fa04d"]</data>
  <data key="d4">False</data>
</node>
<node id="Adelaide">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The city in South Australia where Jack Young was born and died.", "chunk_id": "c6546edc8fa1b181", "doc_id": "hp_ea9deb27c486c338"}]</data>
  <data key="d2">[{"text": "Jack Ellis Young (31 January 1925 in Adelaide, South Australia – 28 August 1987 in Adelaide) was a Motorcycle speedway rider who won the Speedway World Championship in 1951 and 1952.", "chunk_id": "c6546edc8fa1b181", "doc_id": "hp_ea9deb27c486c338"}]</data>
  <data key="d3">["hp_ea9deb27c486c338"]</data>
