<edge source="Naved Jaffrey" target="Boogie Woogie">
  <data key="d5">["CREATED_BY", "DIRECTED_BY", "PRODUCED_BY", "HOSTED_BY"]</data>
  <data key="d6">Naved Jaffrey created the TV series Boogie Woogie.</data>
  <data key="d7">[{"text": "Boogie Woogie was an Indian dance competition television series created and directed by Naved Jaffrey and Ravi Behl for Sony Entertainment Television and Sony Entertainment Television Asia.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4", "type": "CREATED_BY"}, {"text": "Boogie Woogie was an Indian dance competition television series created and directed by Naved Jaffrey and Ravi Behl for Sony Entertainment Television and Sony Entertainment Television Asia.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4", "type": "DIRECTED_BY"}, {"text": "Debuting in 1996, the show was judged by Indian film actor and Television host Javed Jaffrey who was the permanent judge, while his brother Naved, also the director and producer of the show, co hosted the show along with film actor Ravi Behl.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4", "type": "PRODUCED_BY"}, {"text": "Debuting in 1996, the show was judged by Indian film actor and Television host Javed Jaffrey who was the permanent judge, while his brother Naved, also the director and producer of the show, co hosted the show along with film actor Ravi Behl.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4", "type": "HOSTED_BY"}]</data>
  <data key="d8">hp_a2a8fb62705d96e4</data>
</edge>
<edge source="Ravi Behl" target="Boogie Woogie">
  <data key="d5">["CREATED_BY", "DIRECTED_BY", "HOSTED_BY"]</data>
  <data key="d6">Ravi Behl co-created the TV series Boogie Woogie.</data>
  <data key="d7">[{"text": "Boogie Woogie was an Indian dance competition television series created and directed by Naved Jaffrey and Ravi Behl for Sony Entertainment Television and Sony Entertainment Television Asia.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4", "type": "CREATED_BY"}, {"text": "Boogie Woogie was an Indian dance competition television series created and directed by Naved Jaffrey and Ravi Behl for Sony Entertainment Television and Sony Entertainment Television Asia.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4", "type": "DIRECTED_BY"}, {"text": "Debuting in 1996, the show was judged by Indian film actor and Television host Javed Jaffrey who was the permanent judge, while his brother Naved, also the director and producer of the show, co hosted the show along with film actor Ravi Behl.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4", "type": "HOSTED_BY"}]</data>
  <data key="d8">hp_a2a8fb62705d96e4</data>
</edge>
