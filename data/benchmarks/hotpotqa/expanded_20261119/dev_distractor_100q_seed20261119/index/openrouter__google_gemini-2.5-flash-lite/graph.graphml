<node id="Nixon v. General Services Administration">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A landmark court case concerning the principle of presidential privilege and whether the public is allowed to view a President’s confidential documents.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "Nixon v. General Services Administration, 433 U.S 425 (1977), is a landmark court case concerning the principle of presidential privilege and whether the public is allowed to view a President’s “confidential documents”.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="presidential privilege">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A principle concerning the rights of a president to keep certain communications and documents confidential.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "Nixon v. General Services Administration, 433 U.S 425 (1977), is a landmark court case concerning the principle of presidential privilege and whether the public is allowed to view a President’s “confidential documents”.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="President">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The head of state or head of government of a republic.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "Nixon v. General Services Administration, 433 U.S 425 (1977), is a landmark court case concerning the principle of presidential privilege and whether the public is allowed to view a President’s “confidential documents”.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="confidential documents">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Documents that are intended to be kept secret or private.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "Nixon v. General Services Administration, 433 U.S 425 (1977), is a landmark court case concerning the principle of presidential privilege and whether the public is allowed to view a President’s “confidential documents”.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="Presidential Recordings and Materials Preservation Act">
  <data key="d0">LAW</data>
  <data key="d1">[{"text": "An act that ordered the Administrator of General Services to obtain President Richard Nixon’s presidential papers and tape recordings.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "The Presidential Recordings and Materials Preservation Act, signed into law by President Gerald Ford in 1974, ordered that the Administrator of General Services obtain President Richard Nixon’s presidential papers and tape recordings.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="President Gerald Ford">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The President who signed the Presidential Recordings and Materials Preservation Act into law in 1974.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "The Presidential Recordings and Materials Preservation Act, signed into law by President Gerald Ford in 1974, ordered that the Administrator of General Services obtain President Richard Nixon’s presidential papers and tape recordings.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="Administrator of General Services">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The official responsible for obtaining President Richard Nixon’s presidential papers and tape recordings under the Presidential Recordings and Materials Preservation Act.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "The Presidential Recordings and Materials Preservation Act, signed into law by President Gerald Ford in 1974, ordered that the Administrator of General Services obtain President Richard Nixon’s presidential papers and tape recordings.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="presidential papers">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Documents and records belonging to a president.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "The Presidential Recordings and Materials Preservation Act, signed into law by President Gerald Ford in 1974, ordered that the Administrator of General Services obtain President Richard Nixon’s presidential papers and tape recordings.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="tape recordings">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Audio recordings made by a president.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "The Presidential Recordings and Materials Preservation Act, signed into law by President Gerald Ford in 1974, ordered that the Administrator of General Services obtain President Richard Nixon’s presidential papers and tape recordings.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="government archivists">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Officials responsible for seizing and preserving historical government materials.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "In addition, the Act further ordered that government archivists seize these materials.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="historic">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Of great importance or significance in past history.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "These archivists would preserve the material deemed historic and return to former President Nixon the materials deemed as private.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="former President Nixon">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The former president who would have private materials returned to him.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "These archivists would preserve the material deemed historic and return to former President Nixon the materials deemed as private.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="private">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Belonging to or concerning an individual person rather than a company or organization.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "These archivists would preserve the material deemed historic and return to former President Nixon the materials deemed as private.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="judicial hearings and proceedings">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "Formal meetings or discussions held in a court of law.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "Furthermore, this Act stated that material that was preserved could be used in judicial hearings and proceedings.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="federal district court">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A court within the federal judiciary system of the United States.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "Immediately after this Act was enacted, Richard Nixon filed a lawsuit in a federal district court claiming that the Act violated the principle of separation of powers, the principle of presidential privilege, Nixon’s personal privacy, his First Amendment right of association, and further asserted that it amounted to a constitutionally prohibited Bill of Attainder.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="separation of powers">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A doctrine of constitutional law under which the three branches of government (executive, legislative, and judicial) are kept separate.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "Immediately after this Act was enacted, Richard Nixon filed a lawsuit in a federal district court claiming that the Act violated the principle of separation of powers, the principle of presidential privilege, Nixon’s personal privacy, his First Amendment right of association, and further asserted that it amounted to a constitutionally prohibited Bill of Attainder.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="Nixon’s personal privacy">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The right of Richard Nixon to keep his personal affairs and information from public disclosure.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "Immediately after this Act was enacted, Richard Nixon filed a lawsuit in a federal district court claiming that the Act violated the principle of separation of powers, the principle of presidential privilege, Nixon’s personal privacy, his First Amendment right of association, and further asserted that it amounted to a constitutionally prohibited Bill of Attainder.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="First Amendment right of association">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The constitutional right to associate with others for expressive, economic, political or other lawful purposes.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "Immediately after this Act was enacted, Richard Nixon filed a lawsuit in a federal district court claiming that the Act violated the principle of separation of powers, the principle of presidential privilege, Nixon’s personal privacy, his First Amendment right of association, and further asserted that it amounted to a constitutionally prohibited Bill of Attainder.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="Bill of Attainder">
  <data key="d0">LAW</data>
  <data key="d1">[{"text": "A legislative act that singles out individuals or groups to have their rights taken away without a trial.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "Immediately after this Act was enacted, Richard Nixon filed a lawsuit in a federal district court claiming that the Act violated the principle of separation of powers, the principle of presidential privilege, Nixon’s personal privacy, his First Amendment right of association, and further asserted that it amounted to a constitutionally prohibited Bill of Attainder.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="Catan Dice Game">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A German-style board game developed by Klaus Teuber and published in 2007.", "chunk_id": "d146a6f0cb5047a2", "doc_id": "hp_ba7adfcb35f11075"}]</data>
  <data key="d2">[{"text": "Catan Dice Game is a German-style board game, developed by Klaus Teuber and published in 2007 by Catan GmbH and its licensors, Kosmos in Germany and Mayfair Games in English-speaking countries.", "chunk_id": "d146a6f0cb5047a2", "doc_id": "hp_ba7adfcb35f11075"}]</data>
  <data key="d3">["hp_ba7adfcb35f11075"]</data>
  <data key="d4">False</data>
</node>
