  <data key="d5">["PARTICIPATED_IN"]</data>
  <data key="d6">Pam Teeguarden played in the US Open.</data>
  <data key="d7">[{"text": "Teeguarden was voted the \"Most Watchable Player\" based on play and appearance by a group of Madison Avenue advertising executives or \"Mad Men\" while playing at the US Open.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a", "type": "PARTICIPATED_IN"}]</data>
