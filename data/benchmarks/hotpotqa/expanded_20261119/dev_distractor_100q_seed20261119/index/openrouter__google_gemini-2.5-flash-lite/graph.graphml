  <data key="d7">[{"text": "Istanbul Şehir University (Turkish: \"İstanbul Şehir Üniversitesi\" , literally City University of Istanbul) is a private, non-profit university located in Istanbul, Turkey.", "chunk_id": "c4ae848456d08dbd", "doc_id": "hp_0470400943ee62eb", "type": "LOCATED_IN"}]</data>
