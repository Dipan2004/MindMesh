  <data key="d2">[{"text": "It was created by Jim Barnes in 1970, named after a daily newspaper column he wrote for an Iowa morning newspaper, and published by Avalon Hill in 1978, and new player cards were made for each new season until 1992.", "chunk_id": "22da4e536a889168", "doc_id": "hp_9807d2b35cb4cca7"}]</data>
  <data key="d3">["hp_9807d2b35cb4cca7"]</data>
  <data key="d4">False</data>
</node>
