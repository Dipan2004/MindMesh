</node>
<node id="Clifford Odets">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The writer of the 1950 play 'The Country Girl'.", "chunk_id": "0429f47598da120a", "doc_id": "hp_a4ca7ebec626db42"}]</data>
  <data key="d2">[{"text": "Adapted by George Seaton from Clifford Odets' 1950 play of the same name, the film is about an alcoholic has-been actor struggling with the one last chance he's been given to resurrect his career.", "chunk_id": "0429f47598da120a", "doc_id": "hp_a4ca7ebec626db42"}]</data>
  <data key="d3">["hp_a4ca7ebec626db42"]</data>
  <data key="d4">False</data>
</node>
<node id="The Country Girl (play)">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A 1950 play by Clifford Odets.", "chunk_id": "0429f47598da120a", "doc_id": "hp_a4ca7ebec626db42"}]</data>
  <data key="d2">[{"text": "Adapted by George Seaton from Clifford Odets' 1950 play of the same name, the film is about an alcoholic has-been actor struggling with the one last chance he's been given to resurrect his career.", "chunk_id": "0429f47598da120a", "doc_id": "hp_a4ca7ebec626db42"}]</data>
  <data key="d3">["hp_a4ca7ebec626db42"]</data>
  <data key="d4">False</data>
</node>
<node id="Academy Award for Best Writing, Adapted Screenplay">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An award won by George Seaton for his work on 'The Country Girl'.", "chunk_id": "0429f47598da120a", "doc_id": "hp_a4ca7ebec626db42"}]</data>
  <data key="d2">[{"text": "Seaton won the Academy Award for Best Writing, Adapted Screenplay.", "chunk_id": "0429f47598da120a", "doc_id": "hp_a4ca7ebec626db42"}]</data>
  <data key="d3">["hp_a4ca7ebec626db42"]</data>
  <data key="d4">False</data>
</node>
<node id="Cannes Film Festival">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A film festival where 'The Country Girl' was entered in 1955.", "chunk_id": "0429f47598da120a", "doc_id": "hp_a4ca7ebec626db42"}, {"text": "The Cannes Film Festival is an event where the film \"Maria Candelaria\" won the Palme d'Or award.", "chunk_id": "e2bd3c61103e4d8b", "doc_id": "hp_e6718a97d51ea825"}]</data>
  <data key="d2">[{"text": "It was entered in the 1955 Cannes Film Festival.", "chunk_id": "0429f47598da120a", "doc_id": "hp_a4ca7ebec626db42"}, {"text": "He is best known for his work as director of the film \"Maria Candelaria\" (1944), which won the Palme d'Or award at the 1946 Cannes Film Festival.", "chunk_id": "e2bd3c61103e4d8b", "doc_id": "hp_e6718a97d51ea825"}]</data>
  <data key="d3">["hp_a4ca7ebec626db42", "hp_e6718a97d51ea825"]</data>
  <data key="d4">False</data>
</node>
<node id="Royal Photographic Society">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "One of the world's oldest photographic societies.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d2">[{"text": "The Royal Photographic Society of Great Britain, commonly known as the Royal Photographic Society (RPS), is one of the world's oldest photographic societies.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c"]</data>
  <data key="d4">False</data>
</node>
<node id="Royal Photographic Society of Great Britain">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The full name of the Royal Photographic Society.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d2">[{"text": "The Royal Photographic Society of Great Britain, commonly known as the Royal Photographic Society (RPS), is one of the world's oldest photographic societies.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c"]</data>
  <data key="d4">False</data>
</node>
<node id="RPS">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The common abbreviation for the Royal Photographic Society.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d2">[{"text": "The Royal Photographic Society of Great Britain, commonly known as the Royal Photographic Society (RPS), is one of the world's oldest photographic societies.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c"]</data>
  <data key="d4">False</data>
</node>
<node id="The Photographic Society of London">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The original name of the Royal Photographic Society when it was founded.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d2">[{"text": "It was founded in London, England in 1853 as The Photographic Society of London with the objective of promoting the art and science of photography, and in 1854 received Royal patronage from Queen Victoria and Prince Albert.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c"]</data>
  <data key="d4">False</data>
</node>
<node id="Queen Victoria">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A royal figure who provided patronage to the society.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d2">[{"text": "It was founded in London, England in 1853 as The Photographic Society of London with the objective of promoting the art and science of photography, and in 1854 received Royal patronage from Queen Victoria and Prince Albert.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c"]</data>
  <data key="d4">False</data>
</node>
<node id="Prince Albert">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A royal figure who provided patronage to the society.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d2">[{"text": "It was founded in London, England in 1853 as The Photographic Society of London with the objective of promoting the art and science of photography, and in 1854 received Royal patronage from Queen Victoria and Prince Albert.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c"]</data>
  <data key="d4">False</data>
</node>
<node id="Photographic Society of Great Britain">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The name of the society in 1874.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d2">[{"text": "In 1874 it was renamed the Photographic Society of Great Britain, and from 1894 it became known as The Royal Photographic Society of Great Britain.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c"]</data>
  <data key="d4">False</data>
</node>
<node id="The Royal Photographic Society of Great Britain">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The name of the society from 1894 onwards.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d2">[{"text": "In 1874 it was renamed the Photographic Society of Great Britain, and from 1894 it became known as The Royal Photographic Society of Great Britain.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c"]</data>
  <data key="d4">False</data>
</node>
<node id="1962">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The year the society became a registered charity.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d2">[{"text": "A registered charity since 1962, in July 2004, The Royal Photographic Society of Great Britain was granted a Royal charter recognising its eminence in the field of photography as a learned society.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c"]</data>
  <data key="d4">False</data>
</node>
<node id="July 2004">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The month and year the society was granted a Royal charter.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d2">[{"text": "A registered charity since 1962, in July 2004, The Royal Photographic Society of Great Britain was granted a Royal charter recognising its eminence in the field of photography as a learned society.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c"]</data>
  <data key="d4">False</data>
</node>
<node id="Royal charter">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A recognition granted to the society for its eminence in photography.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d2">[{"text": "A registered charity since 1962, in July 2004, The Royal Photographic Society of Great Britain was granted a Royal charter recognising its eminence in the field of photography as a learned society.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c"]</data>
  <data key="d4">False</data>
</node>
<node id="learned society">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A status recognized by the Royal charter granted to the society.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d2">[{"text": "A registered charity since 1962, in July 2004, The Royal Photographic Society of Great Britain was granted a Royal charter recognising its eminence in the field of photography as a learned society.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c"]</data>
  <data key="d4">False</data>
</node>
<node id="Bath">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The city where the society moved to in 1979 and where its headquarters are currently located.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d2">[{"text": "It moved to Bath in 1979, and since 2004 its headquarters has been at Fenton House in Bath, England.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c"]</data>
  <data key="d4">False</data>
</node>
<node id="1979">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The year the society moved to Bath.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d2">[{"text": "It moved to Bath in 1979, and since 2004 its headquarters has been at Fenton House in Bath, England.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c"]</data>
  <data key="d4">False</data>
</node>
<node id="2004">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The year the society's headquarters moved to Fenton House.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}, {"text": "2004 is the year of Shifty Shellshock's album Happy Love Sick.", "chunk_id": "0e3a5e1368eb79fe", "doc_id": "hp_c1e92b892fa0c36f"}]</data>
  <data key="d2">[{"text": "It moved to Bath in 1979, and since 2004 its headquarters has been at Fenton House in Bath, England.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}, {"text": "It was later included on Shifty Shellshock's 2004 album \"Happy Love Sick\", and Oakenfold's 2007 album \"Greatest Hits &amp; Remixes, Vol. 1\".", "chunk_id": "0e3a5e1368eb79fe", "doc_id": "hp_c1e92b892fa0c36f"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c", "hp_c1e92b892fa0c36f"]</data>
  <data key="d4">False</data>
</node>
<node id="Fenton House">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The current headquarters of the Royal Photographic Society.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d2">[{"text": "It moved to Bath in 1979, and since 2004 its headquarters has been at Fenton House in Bath, England.", "chunk_id": "33a9a750a0cbc7b4", "doc_id": "hp_a4dd7ae51691935c"}]</data>
  <data key="d3">["hp_a4dd7ae51691935c"]</data>
  <data key="d4">False</data>
</node>
<node id="Cynthia G. Mason">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Cynthia G. Mason is a songwriter based in Philadelphia, Pennsylvania.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d2">[{"text": "Cynthia G. Mason is a songwriter based in Philadelphia, Pennsylvania.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d3">["hp_a4ea94be7751c86c"]</data>
  <data key="d4">False</data>
</node>
<node id="Spiderwoman">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Spiderwoman is the label on which Cynthia G. Mason self-released albums.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d2">[{"text": "She self-released albums (as cassettes) on her own label, Spiderwoman.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d3">["hp_a4ea94be7751c86c"]</data>
  <data key="d4">False</data>
</node>
<node id="Philadelphia City Paper">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Philadelphia City Paper is a publication that featured Cynthia G. Mason on its cover.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d2">[{"text": "She was featured on the cover of the \"Philadelphia City Paper\" and her version of Richard Buckner's \"Surprise, AZ\" was included on a compilation of covers produced by \"The Believer\" magazine.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d3">["hp_a4ea94be7751c86c"]</data>
  <data key="d4">False</data>
</node>
<node id="Richard Buckner">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Richard Buckner is an artist whose song \"Surprise, AZ\" was covered by Cynthia G. Mason.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d2">[{"text": "She was featured on the cover of the \"Philadelphia City Paper\" and her version of Richard Buckner's \"Surprise, AZ\" was included on a compilation of covers produced by \"The Believer\" magazine.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d3">["hp_a4ea94be7751c86c"]</data>
  <data key="d4">False</data>
</node>
<node id="Surprise, AZ">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "\"Surprise, AZ\" is a song by Richard Buckner that Cynthia G. Mason covered.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d2">[{"text": "She was featured on the cover of the \"Philadelphia City Paper\" and her version of Richard Buckner's \"Surprise, AZ\" was included on a compilation of covers produced by \"The Believer\" magazine.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d3">["hp_a4ea94be7751c86c"]</data>
  <data key="d4">False</data>
</node>
<node id="The Believer">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Believer is a magazine that produced a compilation of covers featuring Cynthia G. Mason's version of \"Surprise, AZ\".", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d2">[{"text": "She was featured on the cover of the \"Philadelphia City Paper\" and her version of Richard Buckner's \"Surprise, AZ\" was included on a compilation of covers produced by \"The Believer\" magazine.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d3">["hp_a4ea94be7751c86c"]</data>
  <data key="d4">False</data>
</node>
<node id="Quitter's Claim">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "\"Quitter's Claim\" is the first nationally distributed album by Cynthia G. Mason, released in January 2007.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d2">[{"text": "In January 2007, she released her first nationally distributed album, \"Quitter's Claim\", on the High Two label.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d3">["hp_a4ea94be7751c86c"]</data>
  <data key="d4">False</data>
</node>
<node id="High Two">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "High Two is the label on which Cynthia G. Mason's album \"Quitter's Claim\" was released.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d2">[{"text": "In January 2007, she released her first nationally distributed album, \"Quitter's Claim\", on the High Two label.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d3">["hp_a4ea94be7751c86c"]</data>
  <data key="d4">False</data>
</node>
<node id="Larry D. Brown">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Larry D. Brown produced and features on Cynthia G. Mason's album \"Quitter's Claim\", and records under the moniker Grey Reverend.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d2">[{"text": "The album was produced by and features guitarist Larry D. Brown, who records under the Grey Reverend moniker and is a member of The Cinematic Orchestra.", "chunk_id": "a971825b7f1c72e3", "doc_id": "hp_a4ea94be7751c86c"}]</data>
  <data key="d3">["hp_a4ea94be7751c86c"]</data>
