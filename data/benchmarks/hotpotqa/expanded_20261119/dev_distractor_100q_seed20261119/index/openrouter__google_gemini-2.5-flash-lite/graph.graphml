</edge>
<edge source="Home" target="Up from Below">
  <data key="d5">["PART_OF", "SINGLE_FROM"]</data>
  <data key="d6">The song "Home" is a single from the album "Up from Below".</data>
  <data key="d7">[{"text": "It was released in January 2010 as the second single from the album, \"Up from Below\".", "chunk_id": "502d1ec5b75a536d", "doc_id": "hp_d99c63a0b04e6061", "type": "PART_OF"}, {"text": "Their first studio album, \"Up from Below\", was released on July 7, 2009 on Community Records and featured the popular single \"Home\".", "chunk_id": "508eaa5477ac7bce", "doc_id": "hp_f98356ff88ddd6a3", "type": "SINGLE_FROM"}]</data>
  <data key="d8">hp_d99c63a0b04e6061</data>
</edge>
<edge source="Home" target="Triple J">
  <data key="d5">["RANKED_BY"]</data>
  <data key="d6">The song "Home" was ranked by the radio station Triple J.</data>
  <data key="d7">[{"text": "The song came in at number 73 on Australian radio station Triple J's 100 hottest songs of the past 20 years.", "chunk_id": "502d1ec5b75a536d", "doc_id": "hp_d99c63a0b04e6061", "type": "RANKED_BY"}]</data>
  <data key="d8">hp_d99c63a0b04e6061</data>
</edge>
