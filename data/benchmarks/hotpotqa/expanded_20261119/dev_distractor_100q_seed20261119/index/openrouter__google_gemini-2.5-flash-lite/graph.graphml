</node>
<node id="John Ehrlichman">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "John Ehrlichman was an operator of Nixon's presidential campaign.", "chunk_id": "7a98a826c469ba66", "doc_id": "hp_866e1a0ee1799d1f"}]</data>
  <data key="d2">[{"text": "Before H. R. Haldeman and John Ehrlichman became the operators of Nixon's presidential campaign, Woods was Nixon's gatekeeper.", "chunk_id": "7a98a826c469ba66", "doc_id": "hp_866e1a0ee1799d1f"}]</data>
  <data key="d3">["hp_866e1a0ee1799d1f"]</data>
  <data key="d4">False</data>
</node>
<node id="Le baiser de la fée">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A ballet in one act and four scenes composed by Igor Stravinsky.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}]</data>
  <data key="d2">[{"text": "Le baiser de la fée (\"The Fairy's Kiss\") is a ballet in one act and four scenes composed by Igor Stravinsky in 1928 and revised in 1950 for George Balanchine and the New York City Ballet.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}]</data>
  <data key="d3">["hp_869cb734bf497707"]</data>
  <data key="d4">False</data>
</node>
<node id="Igor Stravinsky">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The composer of the ballet 'Le baiser de la fée'.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}, {"text": "Igor Stravinsky composed the ballet Apollo between 1927 and 1928.", "chunk_id": "7d4e3a512ec3ac2c", "doc_id": "hp_9db3a175e11b24ac"}]</data>
  <data key="d2">[{"text": "Le baiser de la fée (\"The Fairy's Kiss\") is a ballet in one act and four scenes composed by Igor Stravinsky in 1928 and revised in 1950 for George Balanchine and the New York City Ballet.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}, {"text": "Apollo (originally Apollon musagète and variously known as \"Apollo musagetes\", \"Apolo Musageta\", and \"Apollo, Leader of the Muses\") is a ballet in two tableaux composed between 1927 and 1928 by Igor Stravinsky.", "chunk_id": "7d4e3a512ec3ac2c", "doc_id": "hp_9db3a175e11b24ac"}]</data>
  <data key="d3">["hp_869cb734bf497707", "hp_9db3a175e11b24ac"]</data>
  <data key="d4">False</data>
</node>
<node id="Hans Christian Andersen">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The author of the short story 'Isjomfruen' which inspired 'Le baiser de la fée'.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}]</data>
  <data key="d2">[{"text": "Based on Hans Christian Andersen's short story \"Isjomfruen\" (English: The Ice-Maiden), the work is an homage to Pyotr Ilyich Tchaikovsky, for the 35th anniversary of the composer's death.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}]</data>
  <data key="d3">["hp_869cb734bf497707"]</data>
  <data key="d4">False</data>
</node>
<node id="Isjomfruen">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A short story by Hans Christian Andersen, which inspired 'Le baiser de la fée'.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}]</data>
  <data key="d2">[{"text": "Based on Hans Christian Andersen's short story \"Isjomfruen\" (English: The Ice-Maiden), the work is an homage to Pyotr Ilyich Tchaikovsky, for the 35th anniversary of the composer's death.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}]</data>
  <data key="d3">["hp_869cb734bf497707"]</data>
  <data key="d4">False</data>
</node>
<node id="The Ice-Maiden">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The English translation of Hans Christian Andersen's short story 'Isjomfruen'.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}]</data>
  <data key="d2">[{"text": "Based on Hans Christian Andersen's short story \"Isjomfruen\" (English: The Ice-Maiden), the work is an homage to Pyotr Ilyich Tchaikovsky, for the 35th anniversary of the composer's death.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}]</data>
  <data key="d3">["hp_869cb734bf497707"]</data>
  <data key="d4">False</data>
</node>
<node id="Pyotr Ilyich Tchaikovsky">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A composer to whom 'Le baiser de la fée' is an homage.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}]</data>
  <data key="d2">[{"text": "Based on Hans Christian Andersen's short story \"Isjomfruen\" (English: The Ice-Maiden), the work is an homage to Pyotr Ilyich Tchaikovsky, for the 35th anniversary of the composer's death.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}]</data>
  <data key="d3">["hp_869cb734bf497707"]</data>
  <data key="d4">False</data>
</node>
<node id="Ida Rubinstein">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The commissioner of the ballet 'Le baiser de la fée' in 1927.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}]</data>
  <data key="d2">[{"text": "A commission by Ida Rubinstein from 1927, the ballet was choreographed by Bronislava Nijinska and premiered in Paris on 27 November 1928.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}]</data>
  <data key="d3">["hp_869cb734bf497707"]</data>
  <data key="d4">False</data>
</node>
<node id="Bronislava Nijinska">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The choreographer of the ballet 'Le baiser de la fée'.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}]</data>
  <data key="d2">[{"text": "A commission by Ida Rubinstein from 1927, the ballet was choreographed by Bronislava Nijinska and premiered in Paris on 27 November 1928.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}]</data>
  <data key="d3">["hp_869cb734bf497707"]</data>
  <data key="d4">False</data>
</node>
<node id="Paris">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The city where the ballet 'Le baiser de la fée' premiered.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}, {"text": "Paris is the city where Boulevard Solitude is relocated after the Second World War.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}, {"text": "Paris is a location where Stokely Webster studied.", "chunk_id": "1207dedf3633b579", "doc_id": "hp_e2ee24b441181783"}]</data>
  <data key="d2">[{"text": "A commission by Ida Rubinstein from 1927, the ballet was choreographed by Bronislava Nijinska and premiered in Paris on 27 November 1928.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}, {"text": "The piece is a reworking of the Manon Lescaut story, already adapted operatically by Auber, Massenet and Puccini, and here relocated to Paris after the Second World War where, as is noted in Grove, the focus of the story moves away from Manon and towards Armand des Grieux.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1"}, {"text": "Stokely Webster (1912 – 2001) was best known as an American impressionist painter who studied in Paris.", "chunk_id": "1207dedf3633b579", "doc_id": "hp_e2ee24b441181783"}]</data>
  <data key="d3">["hp_869cb734bf497707", "hp_ce10cea1030952d1", "hp_e2ee24b441181783"]</data>
  <data key="d4">False</data>
</node>
