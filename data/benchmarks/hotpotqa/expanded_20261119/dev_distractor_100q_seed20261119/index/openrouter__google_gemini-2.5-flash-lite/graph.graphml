<node id="1920s">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The decade when Czech animation began.", "chunk_id": "39592b16dc8ece21", "doc_id": "hp_873b85c0ff464a88"}]</data>
  <data key="d2">[{"text": "It began in 1920s and its \"Golden Era\" dates between 1950s and 1980s.", "chunk_id": "39592b16dc8ece21", "doc_id": "hp_873b85c0ff464a88"}]</data>
  <data key="d3">["hp_873b85c0ff464a88"]</data>
  <data key="d4">False</data>
</node>
<node id="Golden Era">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The period between the 1950s and 1980s considered a peak for Czech animation.", "chunk_id": "39592b16dc8ece21", "doc_id": "hp_873b85c0ff464a88"}]</data>
  <data key="d2">[{"text": "It began in 1920s and its \"Golden Era\" dates between 1950s and 1980s.", "chunk_id": "39592b16dc8ece21", "doc_id": "hp_873b85c0ff464a88"}]</data>
  <data key="d3">["hp_873b85c0ff464a88"]</data>
  <data key="d4">False</data>
</node>
<node id="1950s">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The start of the Golden Era for Czech animation.", "chunk_id": "39592b16dc8ece21", "doc_id": "hp_873b85c0ff464a88"}]</data>
  <data key="d2">[{"text": "It began in 1920s and its \"Golden Era\" dates between 1950s and 1980s.", "chunk_id": "39592b16dc8ece21", "doc_id": "hp_873b85c0ff464a88"}]</data>
  <data key="d3">["hp_873b85c0ff464a88"]</data>
  <data key="d4">False</data>
</node>
<node id="1980s">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The end of the Golden Era for Czech animation.", "chunk_id": "39592b16dc8ece21", "doc_id": "hp_873b85c0ff464a88"}, {"text": "The 1980s was a decade when the Huffman Historic District was named a historic site.", "chunk_id": "bbb6119acb937cda", "doc_id": "hp_c38e964da8a4abbb"}]</data>
  <data key="d2">[{"text": "It began in 1920s and its \"Golden Era\" dates between 1950s and 1980s.", "chunk_id": "39592b16dc8ece21", "doc_id": "hp_873b85c0ff464a88"}, {"text": "After seeing very few changes throughout the twentieth century, it was named a historic site in the 1980s.", "chunk_id": "bbb6119acb937cda", "doc_id": "hp_c38e964da8a4abbb"}]</data>
  <data key="d3">["hp_873b85c0ff464a88", "hp_c38e964da8a4abbb"]</data>
  <data key="d4">False</data>
</node>
