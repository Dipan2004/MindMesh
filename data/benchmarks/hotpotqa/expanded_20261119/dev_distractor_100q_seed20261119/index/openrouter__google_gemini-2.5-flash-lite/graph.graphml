  <data key="d5">["HAS_HIT_SONG"]</data>
  <data key="d6">The album "After the Rain" featured the hit song "(Can't Live Without Your) Love and Affection".</data>
  <data key="d7">[{"text": "The band achieved success during the early 1990s with their double platinum debut album \"After the Rain\", which featured the number-one hit \"(Can't Live Without Your) Love and Affection\".", "chunk_id": "692762cf78f5a878", "doc_id": "hp_52a5e192172e1781", "type": "HAS_HIT_SONG"}]</data>
