  <data key="d2">[{"text": "\"The Cadet\" has been independently run by the VMI Corps of Cadets since its first issue, and continues to be done so to this day.", "chunk_id": "ef24deb7580a2b51", "doc_id": "hp_d44bdbb955a3799c"}]</data>
