  <data key="d2">[{"text": "Edward William Fitzalan-Howard, 18th Duke of Norfolk, (born 2 December 1956), styled Earl of Arundel between 1975 and 2002, is a British peer, Earl Marshal and son of Miles Fitzalan-Howard, 17th Duke of Norfolk.", "chunk_id": "6517718c3566223d", "doc_id": "hp_87afae3cf599b7ed"}]</data>
