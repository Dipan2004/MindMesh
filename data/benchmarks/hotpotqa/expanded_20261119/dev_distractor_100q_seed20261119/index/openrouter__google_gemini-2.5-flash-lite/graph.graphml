<node id="Appalachian Mountains">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Appalachian Mountains are a mountain range in eastern North America where Liriodendron tulipifera can grow to significant heights in virgin cove forests.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}]</data>
  <data key="d2">[{"text": "It can grow to more than 50 m in virgin cove forests of the Appalachian Mountains, often with no limbs until it reaches 25 – in height, making it a very valuable timber tree.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}]</data>
  <data key="d3">["hp_2c1beb2f73cca8d4"]</data>
  <data key="d4">False</data>
</node>
<node id="Indiana">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Indiana is a state in the USA for which the tulip tree is the state tree.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}, {"text": "A state in the United States where Indianapolis is located.", "chunk_id": "0c32c75514abc0dc", "doc_id": "hp_53c0688141ca0284"}]</data>
  <data key="d2">[{"text": "The tulip tree is the state tree of Indiana, Kentucky, and Tennessee.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}, {"text": "The North Irvington Gardens Historic District is a neighborhood and national historic district in Indianapolis, Indiana.", "chunk_id": "0c32c75514abc0dc", "doc_id": "hp_53c0688141ca0284"}]</data>
  <data key="d3">["hp_2c1beb2f73cca8d4", "hp_53c0688141ca0284"]</data>
  <data key="d4">False</data>
</node>
<node id="Kentucky">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Kentucky is a state in the USA for which the tulip tree is the state tree.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}]</data>
  <data key="d2">[{"text": "The tulip tree is the state tree of Indiana, Kentucky, and Tennessee.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}]</data>
  <data key="d3">["hp_2c1beb2f73cca8d4"]</data>
