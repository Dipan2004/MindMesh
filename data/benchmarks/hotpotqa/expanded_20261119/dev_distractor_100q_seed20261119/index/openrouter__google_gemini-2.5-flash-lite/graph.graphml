  <data key="d7">[{"text": "The piece is a reworking of the Manon Lescaut story, already adapted operatically by Auber, Massenet and Puccini, and here relocated to Paris after the Second World War where, as is noted in Grove, the focus of the story moves away from Manon and towards Armand des Grieux.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1", "type": "ADAPTED_OPERATICALLY"}]</data>
