<node id="Jose Gonzales LP &quot;Veneer&quot;">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Jose Gonzales LP \"Veneer\" is an album by José González that was certified Platinum.", "chunk_id": "1c1d19351df2d318", "doc_id": "hp_28fb4ee88cd9de85"}]</data>
  <data key="d2">[{"text": "Jose Gonzales LP \"Veneer\" was certified Platinum in 2006 and Charlene Soraia's \"Wherever you will go\" certified gold in 2012 with sales in excess of 500,000.", "chunk_id": "1c1d19351df2d318", "doc_id": "hp_28fb4ee88cd9de85"}]</data>
  <data key="d3">["hp_28fb4ee88cd9de85"]</data>
