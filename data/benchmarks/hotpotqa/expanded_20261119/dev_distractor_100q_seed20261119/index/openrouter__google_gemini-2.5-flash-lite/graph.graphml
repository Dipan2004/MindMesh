<edge source="Saint Petersburg Conservatory" target="Petrograd Conservatory">
  <data key="d5">["REORGANIZED_INTO"]</data>
  <data key="d6">The Saint Petersburg Conservatory was reorganized into the Petrograd Conservatory.</data>
  <data key="d7">[{"text": "He served as director of the Saint Petersburg Conservatory between 1905 and 1928 and was instrumental in the reorganization of the institute into the Petrograd Conservatory, then the Leningrad Conservatory, following the Bolshevik Revolution.", "chunk_id": "e64b24cbe66d981f", "doc_id": "hp_7cda087f9f474c1b", "type": "REORGANIZED_INTO"}]</data>
