  <data key="d2">[{"text": "The Column of the Goths (Turkish: \"Gotlar Sütunu\" ) is Roman victory column dating to the third or fourth century A.D.", "chunk_id": "dffd0908b3e87179", "doc_id": "hp_c9f9cf36b314fa0a"}]</data>
