  <data key="d5">["LOCATED_IN", "LOCATED_IN"]</data>
  <data key="d6">Superior Bancorp had its corporate headquarters in Birmingham.</data>
  <data key="d7">[{"text": "The company was publicly held and had its corporate headquarters in Birmingham, Alabama.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983", "type": "LOCATED_IN"}, {"text": "The company's corporate headquarters were located in the historic John A. Hand Building on 20th Street North in downtown Birmingham, which is named after former AmSouth Bancorporation president John A. Hand.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_c26329b4dd98f983</data>
</edge>
