<node id="Yellow Sea">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Yellow Sea is a marginal sea of the Western Pacific Ocean, bordering Dongtai.", "chunk_id": "551f221f922de162", "doc_id": "hp_8cfa6859d9227577"}]</data>
  <data key="d2">[{"text": "With some Yellow Sea coast, it borders the prefecture-level cities of Nantong to the south and Taizhou to the west, and is the southernmost county-level division of Yancheng.", "chunk_id": "551f221f922de162", "doc_id": "hp_8cfa6859d9227577"}]</data>
  <data key="d3">["hp_8cfa6859d9227577"]</data>
  <data key="d4">False</data>
</node>
