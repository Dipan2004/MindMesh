  <data key="d7">[{"text": "The 84-acre field has since been known as Huffman Prairie and is designated a National Historic Landmark and part of Ohio's Dayton Aviation Heritage National Historical Park.", "chunk_id": "909c6d3ef553b8b9", "doc_id": "hp_8fc220871dced370", "type": "FORMERLY_OWNED_BY"}]</data>
