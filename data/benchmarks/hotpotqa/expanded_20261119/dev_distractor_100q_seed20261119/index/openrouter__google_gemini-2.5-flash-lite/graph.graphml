  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The fourth series of the British sitcom Absolutely Fabulous.", "chunk_id": "2d1cd752b15a14fe", "doc_id": "hp_323aaf8fc4b0ff2c"}]</data>
  <data key="d2">[{"text": "Absolutely Fabulous (series 4)", "chunk_id": "2d1cd752b15a14fe", "doc_id": "hp_323aaf8fc4b0ff2c"}]</data>
  <data key="d3">["hp_323aaf8fc4b0ff2c"]</data>
