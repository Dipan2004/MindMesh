  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Hong Kong Arts Development Council Scholarship is a scholarship that Leung Po Shan received to study at the University of Leeds.", "chunk_id": "897f999db778cfd7", "doc_id": "hp_0072f61fd930d308"}]</data>
  <data key="d2">[{"text": "She studied at the University of Leeds on a Hong Kong Arts Development Council Scholarship.", "chunk_id": "897f999db778cfd7", "doc_id": "hp_0072f61fd930d308"}]</data>
  <data key="d3">["hp_0072f61fd930d308"]</data>
  <data key="d4">False</data>
</node>
<node id="theater">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Theater is a medium in which Leung Po Shan plays with images, texts, and body.", "chunk_id": "897f999db778cfd7", "doc_id": "hp_0072f61fd930d308"}]</data>
  <data key="d2">[{"text": "Playing with images, texts and body in theater, performance and installation, she has been involved in many major exhibitions, both locally and internationally.", "chunk_id": "897f999db778cfd7", "doc_id": "hp_0072f61fd930d308"}]</data>
  <data key="d3">["hp_0072f61fd930d308"]</data>
  <data key="d4">False</data>
</node>
<node id="Eric Yamamoto">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Eric Yamamoto is the Korematsu Professor of Law and Social Justice at the University of Hawaiʻi at Mānoa William S. Richardson School of Law.", "chunk_id": "f107c34d10795506", "doc_id": "hp_00c8ffa1fdfa046b"}]</data>
  <data key="d2">[{"text": "Eric Yamamoto, the Korematsu Professor of Law and Social Justice at the University of Hawaiʻi at Mānoa William S. Richardson School of Law, is an internationally recognized expert on issues of racial justice, including racial reconciliation and redress.", "chunk_id": "f107c34d10795506", "doc_id": "hp_00c8ffa1fdfa046b"}]</data>
  <data key="d3">["hp_00c8ffa1fdfa046b"]</data>
  <data key="d4">False</data>
</node>
<node id="University of Hawaiʻi at Mānoa William S. Richardson School of Law">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The William S. Richardson School of Law at the University of Hawaiʻi at Mānoa is where Eric Yamamoto holds a professorship.", "chunk_id": "f107c34d10795506", "doc_id": "hp_00c8ffa1fdfa046b"}]</data>
  <data key="d2">[{"text": "Eric Yamamoto, the Korematsu Professor of Law and Social Justice at the University of Hawaiʻi at Mānoa William S. Richardson School of Law, is an internationally recognized expert on issues of racial justice, including racial reconciliation and redress.", "chunk_id": "f107c34d10795506", "doc_id": "hp_00c8ffa1fdfa046b"}]</data>
  <data key="d3">["hp_00c8ffa1fdfa046b"]</data>
  <data key="d4">False</data>
</node>
<node id="Korematsu v. United States">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "Korematsu v. United States is a landmark legal case that influenced Eric Yamamoto's work.", "chunk_id": "f107c34d10795506", "doc_id": "hp_00c8ffa1fdfa046b"}, {"text": "A controversial United States Supreme Court decision of the 20th century, resulting from Fred Korematsu's defiance of the World War II Japanese American internment order.", "chunk_id": "63f34134976a8d32", "doc_id": "hp_18a6d077ab278415"}, {"text": "A case associated with the Japanese exclusion cases.", "chunk_id": "c1e246687344e804", "doc_id": "hp_38ad5fccbbab039a"}, {"text": "A civil rights case.", "chunk_id": "0ba5a45b986c419a", "doc_id": "hp_5dddd5f952802e7e"}, {"text": "A landmark United States Supreme Court case concerning the constitutionality of Executive Order 9066.", "chunk_id": "c923a57087201126", "doc_id": "hp_ad41e3555a82bb26"}, {"text": "A United States Supreme Court decision on the same date as Ex parte Endo, concerning the constitutionality of excluding people of Japanese ancestry from the West Coast.", "chunk_id": "615cdfa10474d8b6", "doc_id": "hp_c36e9406d9e10267"}]</data>
  <data key="d2">[{"text": "Flowing from the landmark Korematsu v. United States case, he is known for his work as a member of Fred Korematsu's legal team.", "chunk_id": "f107c34d10795506", "doc_id": "hp_00c8ffa1fdfa046b"}, {"text": "Dale Minami (born October 13, 1946) is a San Francisco-based lawyer best known for heading the legal team that overturned the conviction of Fred Korematsu, whose defiance of the World War II Japanese American internment order lead to Korematsu v. United States, one of the most controversial United States Supreme Court decisions of the 20th century.", "chunk_id": "63f34134976a8d32", "doc_id": "hp_18a6d077ab278415"}, {"text": "It is often associated with the Japanese exclusion cases (\"Hirabayashi v. United States\", \"Korematsu v. United States\" and \"Ex parte Endo\") because it involved wartime curtailment of fundamental civil liberties under the aegis of military authority, though in this case neither the plaintiff nor the nominal defendant were Japanese.", "chunk_id": "c1e246687344e804", "doc_id": "hp_38ad5fccbbab039a"}, {"text": "The law school has produced leaders in law, government, and society, including Chief Justice of the United States Earl Warren, Secretary of State of the United States Dean Rusk, Attorney General of the United States Edwin Meese, United States Secretary of the Treasury and Chairman of the Federal Reserve G. William Miller, Solicitor General of the United States Theodore Olson, and lead litigator of the \"Korematsu v. United States\" civil rights case, Dale Minami.", "chunk_id": "0ba5a45b986c419a", "doc_id": "hp_5dddd5f952802e7e"}, {"text": "Korematsu v. United States, 323 U.S. 214 (1944), was a landmark United States Supreme Court case concerning the constitutionality of Executive Order 9066, which ordered Japanese Americans into internment camps during World War II regardless of citizenship.", "chunk_id": "c923a57087201126", "doc_id": "hp_ad41e3555a82bb26"}, {"text": "Although the Court did not touch on the constitutionality of the exclusion of people of Japanese ancestry from the West Coast—which they had found not to violate citizen rights in their \"Korematsu v. United States\" decision on the same date—the Endo ruling nonetheless led to the reopening of the West Coast to Japanese Americans after their incarceration in camps across the U.S. interior during World War II.", "chunk_id": "615cdfa10474d8b6", "doc_id": "hp_c36e9406d9e10267"}]</data>
  <data key="d3">["hp_00c8ffa1fdfa046b", "hp_18a6d077ab278415", "hp_38ad5fccbbab039a", "hp_5dddd5f952802e7e", "hp_ad41e3555a82bb26", "hp_c36e9406d9e10267"]</data>
  <data key="d4">False</data>
</node>
<node id="Fred Korematsu">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Fred Korematsu was involved in the Korematsu v. United States case, and Eric Yamamoto was a member of his legal team.", "chunk_id": "f107c34d10795506", "doc_id": "hp_00c8ffa1fdfa046b"}, {"text": "An individual whose conviction was overturned by Dale Minami's legal team, stemming from his defiance of the World War II Japanese American internment order.", "chunk_id": "63f34134976a8d32", "doc_id": "hp_18a6d077ab278415"}]</data>
  <data key="d2">[{"text": "Flowing from the landmark Korematsu v. United States case, he is known for his work as a member of Fred Korematsu's legal team.", "chunk_id": "f107c34d10795506", "doc_id": "hp_00c8ffa1fdfa046b"}, {"text": "Dale Minami (born October 13, 1946) is a San Francisco-based lawyer best known for heading the legal team that overturned the conviction of Fred Korematsu, whose defiance of the World War II Japanese American internment order lead to Korematsu v. United States, one of the most controversial United States Supreme Court decisions of the 20th century.", "chunk_id": "63f34134976a8d32", "doc_id": "hp_18a6d077ab278415"}]</data>
  <data key="d3">["hp_00c8ffa1fdfa046b", "hp_18a6d077ab278415"]</data>
  <data key="d4">False</data>
</node>
<node id="Penicillium restrictum">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A species of the genus \"Penicillium\" that was isolated from the stems of the plant Silybum marianum.", "chunk_id": "bd4cd076593153eb", "doc_id": "hp_01116d3918922396"}]</data>
  <data key="d2">[{"text": "Penicillium restrictum is a species of the genus of \"Penicillium\" which was isolated from the stems of the plant Silybum marianum.", "chunk_id": "bd4cd076593153eb", "doc_id": "hp_01116d3918922396"}]</data>
  <data key="d3">["hp_01116d3918922396"]</data>
  <data key="d4">False</data>
</node>
