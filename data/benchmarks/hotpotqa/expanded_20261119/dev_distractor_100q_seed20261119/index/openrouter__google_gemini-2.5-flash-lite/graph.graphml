  <data key="d7">[{"text": "It is said to closely resemble the ancient Iberian horses that populated Spain before being domesticated.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b", "type": "RESEMBLES"}]</data>
