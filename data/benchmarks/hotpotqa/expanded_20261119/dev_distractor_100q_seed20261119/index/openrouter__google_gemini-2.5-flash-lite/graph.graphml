<edge source="Jorge Amado" target="modern Brazilian writers">
  <data key="d5">["IS_BEST_KNOWN_OF"]</data>
  <data key="d6">Jorge Amado is the best known of modern Brazilian writers.</data>
  <data key="d7">[{"text": "He remains the best known of modern Brazilian writers, with his work having been translated into some 49 languages and popularized in film, notably \"Dona Flor and Her Two Husbands\" in 1978.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c", "type": "IS_BEST_KNOWN_OF"}]</data>
