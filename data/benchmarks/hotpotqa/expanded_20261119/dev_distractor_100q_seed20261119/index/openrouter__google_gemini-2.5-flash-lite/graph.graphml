<node id="Southern New Mexico">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A geographical region in the southern part of New Mexico.", "chunk_id": "255974268309be7d", "doc_id": "hp_d006074a495409b2"}]</data>
  <data key="d2">[{"text": "The Rio Hondo is a 79 mi river in southern New Mexico which begins at the confluence of the Rio Bonito and Rio Ruidoso rivers near the town of Hondo, New Mexico.", "chunk_id": "255974268309be7d", "doc_id": "hp_d006074a495409b2"}]</data>
