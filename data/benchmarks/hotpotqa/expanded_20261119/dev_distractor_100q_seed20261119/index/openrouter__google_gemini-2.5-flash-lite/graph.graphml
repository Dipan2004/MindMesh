<node id="Outrage">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The debut album released by October Rage.", "chunk_id": "c598b20051280564", "doc_id": "hp_d6f470ddf3a3421c"}, {"text": "The official Tower of London board game.", "chunk_id": "00e6b97039cae14c", "doc_id": "hp_2921be96b466f689"}]</data>
  <data key="d2">[{"text": "Following this taste of success recorded the band's debut album, \"Outrage\", released on iTunes September 2011.", "chunk_id": "c598b20051280564", "doc_id": "hp_d6f470ddf3a3421c"}, {"text": "Outrage!, \"the official Tower of London board game\", was first created in 1992 by Imperial Games.", "chunk_id": "00e6b97039cae14c", "doc_id": "hp_2921be96b466f689"}]</data>
