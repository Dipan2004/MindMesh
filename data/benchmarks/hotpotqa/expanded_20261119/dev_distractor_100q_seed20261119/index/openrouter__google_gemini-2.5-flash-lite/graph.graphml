<node id="Peter Hume">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Peter Hume is one of the three brothers who make up the band Evermore.", "chunk_id": "d4587b7df6346e8b", "doc_id": "hp_43e4303474c939c5"}]</data>
  <data key="d2">[{"text": "Hume is the youngest of three brothers (with Peter Hume and Jon Hume) who make up the alternative rock band, Evermore since 1999.", "chunk_id": "d4587b7df6346e8b", "doc_id": "hp_43e4303474c939c5"}]</data>
  <data key="d3">["hp_43e4303474c939c5"]</data>
  <data key="d4">False</data>
</node>
<node id="Jon Hume">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Jon Hume is one of the three brothers who make up the band Evermore.", "chunk_id": "d4587b7df6346e8b", "doc_id": "hp_43e4303474c939c5"}, {"text": "Jon Hume is a guitarist for Evermore and co-producer of the record.", "chunk_id": "d4c212cc890b725d", "doc_id": "hp_b314ee58b364424a"}, {"text": "A member of the band Evermore who commented on the song \"Between the Lines\".", "chunk_id": "5a7629ff0f885755", "doc_id": "hp_b33b91420ae271b4"}, {"text": "Jon Hume is the lead singer of Evermore.", "chunk_id": "502a922827b4a3a3", "doc_id": "hp_fdf3095075ada67d"}]</data>
  <data key="d2">[{"text": "Hume is the youngest of three brothers (with Peter Hume and Jon Hume) who make up the alternative rock band, Evermore since 1999.", "chunk_id": "d4587b7df6346e8b", "doc_id": "hp_43e4303474c939c5"}, {"text": "It was written by Dann Hume, the group's drummer and lead singer and guitarists Jon Hume.", "chunk_id": "d4c212cc890b725d", "doc_id": "hp_b314ee58b364424a"}, {"text": "Evermore's Jon Hume said that \"Between the Lines was the first song to come out of a search for a new musical experience as a band.\"", "chunk_id": "5a7629ff0f885755", "doc_id": "hp_b33b91420ae271b4"}, {"text": "Jon Hume (born 6 November 1983) is the lead singer of Evermore.", "chunk_id": "502a922827b4a3a3", "doc_id": "hp_fdf3095075ada67d"}]</data>
  <data key="d3">["hp_43e4303474c939c5", "hp_b314ee58b364424a", "hp_b33b91420ae271b4", "hp_fdf3095075ada67d"]</data>
  <data key="d4">False</data>
</node>
<node id="Charles Bruce Chatwin">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Charles Bruce Chatwin was an English travel writer, novelist, and journalist.", "chunk_id": "b14a713a662d5851", "doc_id": "hp_43f0ffd390903b19"}]</data>
  <data key="d2">[{"text": "Charles Bruce Chatwin (13 May 194018 January 1989) was an English travel writer, novelist, and journalist.", "chunk_id": "b14a713a662d5851", "doc_id": "hp_43f0ffd390903b19"}]</data>
  <data key="d3">["hp_43f0ffd390903b19"]</data>
  <data key="d4">False</data>
</node>
<node id="In Patagonia">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "\"In Patagonia\" is the first book by Bruce Chatwin, published in 1977.", "chunk_id": "b14a713a662d5851", "doc_id": "hp_43f0ffd390903b19"}]</data>
  <data key="d2">[{"text": "His first book, \"In Patagonia\" (1977), established Chatwin as a travel writer, although he considered himself instead a storyteller, interested in bringing to light unusual tales.", "chunk_id": "b14a713a662d5851", "doc_id": "hp_43f0ffd390903b19"}]</data>
  <data key="d3">["hp_43f0ffd390903b19"]</data>
  <data key="d4">False</data>
</node>
<node id="On the Black Hill">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "\"On the Black Hill\" is a novel by Bruce Chatwin published in 1982, for which he won the James Tait Black Memorial Prize.", "chunk_id": "b14a713a662d5851", "doc_id": "hp_43f0ffd390903b19"}]</data>
  <data key="d2">[{"text": "He won the James Tait Black Memorial Prize for his novel \"On the Black Hill\" (1982) and his novel \"Utz\" (1988) was shortlisted for the Man Booker Prize.", "chunk_id": "b14a713a662d5851", "doc_id": "hp_43f0ffd390903b19"}]</data>
  <data key="d3">["hp_43f0ffd390903b19"]</data>
  <data key="d4">False</data>
</node>
<node id="Utz">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "\"Utz\" is a novel by Bruce Chatwin published in 1988, which was shortlisted for the Man Booker Prize.", "chunk_id": "b14a713a662d5851", "doc_id": "hp_43f0ffd390903b19"}]</data>
  <data key="d2">[{"text": "He won the James Tait Black Memorial Prize for his novel \"On the Black Hill\" (1982) and his novel \"Utz\" (1988) was shortlisted for the Man Booker Prize.", "chunk_id": "b14a713a662d5851", "doc_id": "hp_43f0ffd390903b19"}]</data>
  <data key="d3">["hp_43f0ffd390903b19"]</data>
  <data key="d4">False</data>
</node>
<node id="The Times">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "\"The Times\" is a British daily newspaper, which named Chatwin #46 on their list of \"50 Greatest British Writers Since 1945.\"", "chunk_id": "b14a713a662d5851", "doc_id": "hp_43f0ffd390903b19"}]</data>
  <data key="d2">[{"text": "In 2008 \"The Times\" named Chatwin #46 on their list of \"50 Greatest British Writers Since 1945.\"", "chunk_id": "b14a713a662d5851", "doc_id": "hp_43f0ffd390903b19"}]</data>
  <data key="d3">["hp_43f0ffd390903b19"]</data>
  <data key="d4">False</data>
</node>
<node id="50 Greatest British Writers Since 1945">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "\"50 Greatest British Writers Since 1945\" is a list compiled by \"The Times.\"", "chunk_id": "b14a713a662d5851", "doc_id": "hp_43f0ffd390903b19"}]</data>
  <data key="d2">[{"text": "In 2008 \"The Times\" named Chatwin #46 on their list of \"50 Greatest British Writers Since 1945.\"", "chunk_id": "b14a713a662d5851", "doc_id": "hp_43f0ffd390903b19"}]</data>
  <data key="d3">["hp_43f0ffd390903b19"]</data>
  <data key="d4">False</data>
</node>
<node id="Durvillaea willana">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Durvillaea willana is a kelp species.", "chunk_id": "d0bb177e0eca5e20", "doc_id": "hp_445a6fbf701fbac1"}]</data>
  <data key="d2">[{"text": "Durvillaea willana is a kelp species.", "chunk_id": "d0bb177e0eca5e20", "doc_id": "hp_445a6fbf701fbac1"}]</data>
  <data key="d3">["hp_445a6fbf701fbac1"]</data>
  <data key="d4">False</data>
</node>
<node id="D. antarctica">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "D. antarctica is a kelp species that Durvillaea willana is similar to.", "chunk_id": "d0bb177e0eca5e20", "doc_id": "hp_445a6fbf701fbac1"}]</data>
  <data key="d2">[{"text": "It is similar to \"D. antarctica\" but is found in more sheltered coasts.", "chunk_id": "d0bb177e0eca5e20", "doc_id": "hp_445a6fbf701fbac1"}]</data>
  <data key="d3">["hp_445a6fbf701fbac1"]</data>
  <data key="d4">False</data>
</node>
<node id="D. willana">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "D. willana has smaller blades than D. antarctica and is usually found lower on the shoreline.", "chunk_id": "d0bb177e0eca5e20", "doc_id": "hp_445a6fbf701fbac1"}]</data>
  <data key="d2">[{"text": "\"D. willana\" has smaller blades than \"D. antarctica\" and is usually found lower on the shoreline because its tolerance of wave action is not as great as \"D. antarctica\" (Bradstock, 1989).", "chunk_id": "d0bb177e0eca5e20", "doc_id": "hp_445a6fbf701fbac1"}]</data>
  <data key="d3">["hp_445a6fbf701fbac1"]</data>
  <data key="d4">False</data>
</node>
<node id="bull kelp">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Bull kelp is a common name that Durvillaea willana is often mistaken for.", "chunk_id": "d0bb177e0eca5e20", "doc_id": "hp_445a6fbf701fbac1"}]</data>
  <data key="d2">[{"text": "\"D. willana\" has no common name in New Zealand, however is usually mistaken for bull kelp, \"Durvillaea antarctica\".", "chunk_id": "d0bb177e0eca5e20", "doc_id": "hp_445a6fbf701fbac1"}]</data>
  <data key="d3">["hp_445a6fbf701fbac1"]</data>
  <data key="d4">False</data>
</node>
<node id="Durvillaea antarctica">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Durvillaea antarctica is a species of kelp that Durvillaea willana is often mistaken for.", "chunk_id": "d0bb177e0eca5e20", "doc_id": "hp_445a6fbf701fbac1"}]</data>
  <data key="d2">[{"text": "\"D. willana\" has no common name in New Zealand, however is usually mistaken for bull kelp, \"Durvillaea antarctica\".", "chunk_id": "d0bb177e0eca5e20", "doc_id": "hp_445a6fbf701fbac1"}]</data>
  <data key="d3">["hp_445a6fbf701fbac1"]</data>
  <data key="d4">False</data>
</node>
