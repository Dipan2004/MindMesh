<edge source="Standard Oil of Iowa" target="Standard Oil Trust">
  <data key="d5">["SUBSIDIARY_OF"]</data>
  <data key="d6">Standard Oil of Iowa was created as a subsidiary of the Standard Oil Trust.</data>
  <data key="d7">[{"text": "Standard Oil Company of Iowa was created in 1885 as a subsidiary of the Standard Oil Trust to handle marketing along the Pacific Coast states of Idaho, Oregon, Washington, California, and Arizona.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1", "type": "SUBSIDIARY_OF"}]</data>
