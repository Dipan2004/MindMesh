<node id="Lord Edward Howard">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A Liberal politician who was created Baron Howard of Glossop in 1869.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981"}]</data>
  <data key="d2">[{"text": "It was created in 1869 for the Liberal politician Lord Edward Howard, the second son of Henry Fitzalan-Howard, 13th Duke of Norfolk.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981"}]</data>
  <data key="d3">["hp_1eb78b8119e4d981"]</data>
  <data key="d4">False</data>
</node>
<node id="Henry Fitzalan-Howard">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The 13th Duke of Norfolk.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981"}, {"text": "Henry Fitzalan-Howard was the 15th Duke of Norfolk and the husband of Gwendolen Mary Fitzalan-Howard.", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}, {"text": "The father of Lord Edmund FitzAlan-Howard.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d2">[{"text": "It was created in 1869 for the Liberal politician Lord Edward Howard, the second son of Henry Fitzalan-Howard, 13th Duke of Norfolk.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981"}, {"text": "On 5 February 1904, she married her first cousin once removed, the Henry Fitzalan-Howard, 15th Duke of Norfolk.", "chunk_id": "4f25ba2d6f1f472e", "doc_id": "hp_4b649ff51106ab0b"}, {"text": "Born Lord Edmund FitzAlan-Howard, he was the second son of Henry Fitzalan-Howard, 14th Duke of Norfolk.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d3">["hp_1eb78b8119e4d981", "hp_4b649ff51106ab0b", "hp_e45eb2b0da78e861"]</data>
  <data key="d4">False</data>
</node>
<node id="13th Duke of Norfolk">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The 13th holder of the dukedom of Norfolk.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981"}]</data>
  <data key="d2">[{"text": "It was created in 1869 for the Liberal politician Lord Edward Howard, the second son of Henry Fitzalan-Howard, 13th Duke of Norfolk.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981"}]</data>
  <data key="d3">["hp_1eb78b8119e4d981"]</data>
  <data key="d4">False</data>
</node>
<node id="Mona Stapleton">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The 11th Baroness Beaumont.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981"}, {"text": "Wife of Bernard Fitzalan-Howard and mother of Miles Fitzalan-Howard.", "chunk_id": "8130aa8415f90292", "doc_id": "hp_aa48cba1bf19ae7b"}]</data>
  <data key="d2">[{"text": "His grandson, the third Baron (who succeeded his father), married Mona Stapleton, 11th Baroness Beaumont.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981"}, {"text": "He was the eldest son of Bernard Fitzalan-Howard, 3rd Baron Howard of Glossop, and his wife Mona Stapleton, 11th Baroness Beaumont.", "chunk_id": "8130aa8415f90292", "doc_id": "hp_aa48cba1bf19ae7b"}]</data>
  <data key="d3">["hp_1eb78b8119e4d981", "hp_aa48cba1bf19ae7b"]</data>
  <data key="d4">False</data>
</node>
<node id="11th Baroness Beaumont">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The 11th holder of the barony of Beaumont.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981"}, {"text": "A title held by Mona Stapleton.", "chunk_id": "8130aa8415f90292", "doc_id": "hp_aa48cba1bf19ae7b"}]</data>
  <data key="d2">[{"text": "His grandson, the third Baron (who succeeded his father), married Mona Stapleton, 11th Baroness Beaumont.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981"}, {"text": "He was the eldest son of Bernard Fitzalan-Howard, 3rd Baron Howard of Glossop, and his wife Mona Stapleton, 11th Baroness Beaumont.", "chunk_id": "8130aa8415f90292", "doc_id": "hp_aa48cba1bf19ae7b"}]</data>
  <data key="d3">["hp_1eb78b8119e4d981", "hp_aa48cba1bf19ae7b"]</data>
  <data key="d4">False</data>
</node>
<node id="Miles">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The third Baron Howard of Glossop and succeeded his mother in the barony of Beaumont and his father in the barony of Howard of Glossop.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981"}]</data>
  <data key="d2">[{"text": "Their eldest son, Miles, succeeded his mother in the barony of Beaumont in 1971 and his father in the barony of Howard of Glossop in 1972.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981"}]</data>
  <data key="d3">["hp_1eb78b8119e4d981"]</data>
  <data key="d4">False</data>
</node>
