  <data key="d7">[{"text": "Her first video to receive attention on MTV was \"Borderline\", followed by \"Lucky Star\" and \"Like a Virgin\", which popularized Madonna's image and fashion among younger generation.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00", "type": "RELEASED_VIDEO"}]</data>
