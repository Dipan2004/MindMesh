  <data key="d7">[{"text": "Happy Love Sick is the debut solo album by Shifty Shellshock who is best known as frontman of rap rock band Crazy Town.", "chunk_id": "fb6d4773c5a537c1", "doc_id": "hp_5dba59e0680b3340", "type": "PRODUCED"}]</data>
