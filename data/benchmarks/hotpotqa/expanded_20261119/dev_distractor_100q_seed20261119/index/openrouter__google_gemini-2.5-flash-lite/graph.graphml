</node>
<node id="Galiens li Restorés">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An Old French \"chanson de geste\" that draws heavily from chivalric romance.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d2">[{"text": "Galiens li Restorés, or Galien le Restoré or Galien rhétoré (in English, \"Galien the Restored\"), is an Old French \"chanson de geste\" which borrows heavily from chivalric romance.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d3">["hp_3fac05a2ac9ec6d2"]</data>
  <data key="d4">False</data>
</node>
<node id="Galien le Restoré">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An Old French \"chanson de geste\" that draws heavily from chivalric romance.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d2">[{"text": "Galiens li Restorés, or Galien le Restoré or Galien rhétoré (in English, \"Galien the Restored\"), is an Old French \"chanson de geste\" which borrows heavily from chivalric romance.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d3">["hp_3fac05a2ac9ec6d2"]</data>
  <data key="d4">False</data>
</node>
