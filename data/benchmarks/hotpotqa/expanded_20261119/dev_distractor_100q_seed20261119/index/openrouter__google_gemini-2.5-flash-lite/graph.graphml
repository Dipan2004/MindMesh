<node id="President of the Federal Republic of Germany">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The head of state of the Federal Republic of Germany.", "chunk_id": "ff48931294984b0c", "doc_id": "hp_dcebc5f0fd364ecc"}]</data>
  <data key="d2">[{"text": "Hammerschmidt Villa (German: \"Villa Hammerschmidt\" ) is a villa located in the German city of Bonn that served as the primary official seat and primary official residence of the President of the Federal Republic of Germany from 1950 until 1994.", "chunk_id": "ff48931294984b0c", "doc_id": "hp_dcebc5f0fd364ecc"}]</data>
  <data key="d3">["hp_dcebc5f0fd364ecc"]</data>
  <data key="d4">False</data>
</node>
<node id="Richard von Weizsäcker">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A former President of the Federal Republic of Germany who moved the primary official seat to Bellevue Palace.", "chunk_id": "ff48931294984b0c", "doc_id": "hp_dcebc5f0fd364ecc"}]</data>
  <data key="d2">[{"text": "President Richard von Weizsäcker made Bellevue Palace in Berlin his primary official seat and residence in 1994.", "chunk_id": "ff48931294984b0c", "doc_id": "hp_dcebc5f0fd364ecc"}]</data>
  <data key="d3">["hp_dcebc5f0fd364ecc"]</data>
  <data key="d4">False</data>
</node>
<node id="Bellevue Palace">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The primary official seat and residence of the President of the Federal Republic of Germany since 1994.", "chunk_id": "ff48931294984b0c", "doc_id": "hp_dcebc5f0fd364ecc"}]</data>
  <data key="d2">[{"text": "President Richard von Weizsäcker made Bellevue Palace in Berlin his primary official seat and residence in 1994.", "chunk_id": "ff48931294984b0c", "doc_id": "hp_dcebc5f0fd364ecc"}]</data>
  <data key="d3">["hp_dcebc5f0fd364ecc"]</data>
  <data key="d4">False</data>
</node>
<node id="White House of Bonn">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An alternative name for the Hammerschmidt Villa, due to its resemblance to the White House in the United States.", "chunk_id": "ff48931294984b0c", "doc_id": "hp_dcebc5f0fd364ecc"}]</data>
  <data key="d2">[{"text": "In German, the Villa is also called the \"White House of Bonn\", because of its vague resemblance to the official residence of the President of the United States.", "chunk_id": "ff48931294984b0c", "doc_id": "hp_dcebc5f0fd364ecc"}]</data>
  <data key="d3">["hp_dcebc5f0fd364ecc"]</data>
  <data key="d4">False</data>
</node>
<node id="official residence of the President of the United States">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The official residence of the President of the United States, which the Hammerschmidt Villa is vaguely compared to.", "chunk_id": "ff48931294984b0c", "doc_id": "hp_dcebc5f0fd364ecc"}]</data>
  <data key="d2">[{"text": "In German, the Villa is also called the \"White House of Bonn\", because of its vague resemblance to the official residence of the President of the United States.", "chunk_id": "ff48931294984b0c", "doc_id": "hp_dcebc5f0fd364ecc"}]</data>
