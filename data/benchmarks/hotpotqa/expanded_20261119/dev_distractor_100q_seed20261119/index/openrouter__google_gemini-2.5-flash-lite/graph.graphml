  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Rebels of the Neon God is a film starring Chen Chao-jung.", "chunk_id": "b9f1ded51398adc0", "doc_id": "hp_4ed3904f8086a721"}, {"text": "A 1992 Taiwanese film directed by Tsai Ming-liang.", "chunk_id": "197489edd7e615b2", "doc_id": "hp_e2eedc11b3a4a9ee"}]</data>
  <data key="d2">[{"text": "He is most famous for starring in several of Tsai Ming-liang's films, including \"Rebels of the Neon God\" and \"Vive L'Amour\".", "chunk_id": "b9f1ded51398adc0", "doc_id": "hp_4ed3904f8086a721"}, {"text": "Rebels of the Neon God () is a 1992 Taiwanese film by Tsai Ming-liang.", "chunk_id": "197489edd7e615b2", "doc_id": "hp_e2eedc11b3a4a9ee"}]</data>
