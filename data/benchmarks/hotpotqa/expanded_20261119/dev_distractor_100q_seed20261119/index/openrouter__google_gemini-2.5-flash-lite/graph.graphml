<edge source="Walter Walsh" target="USMC">
  <data key="d5">["WORKS_AT", "SERVED_IN"]</data>
  <data key="d6">Walter Walsh served as a shooting instructor with the Marine Corps until his retirement in the 1970s.</data>
  <data key="d7">[{"text": "He served in the Pacific theatre during World War II with the Marine Corps and, after a brief return to the FBI, served as a shooting instructor with the Marine Corps until his retirement in the 1970s.", "chunk_id": "3fc5da1aa653543a", "doc_id": "hp_95e3e85178f2cc76", "type": "WORKS_AT"}, {"text": "He served in the Pacific theatre during World War II with the Marine Corps and, after a brief return to the FBI, served as a shooting instructor with the Marine Corps until his retirement in the 1970s.", "chunk_id": "3fc5da1aa653543a", "doc_id": "hp_95e3e85178f2cc76", "type": "SERVED_IN"}]</data>
  <data key="d8">hp_95e3e85178f2cc76</data>
</edge>
<edge source="Walter Walsh" target="Olympic shooter">
  <data key="d5">["IS_A"]</data>
  <data key="d6">Walter Walsh was an Olympic shooter.</data>
  <data key="d7">[{"text": "Colonel Walter Rudolph Walsh (May 4, 1907 – April 29, 2014) was an FBI agent, USMC shooting instructor and Olympic shooter.", "chunk_id": "3fc5da1aa653543a", "doc_id": "hp_95e3e85178f2cc76", "type": "IS_A"}]</data>
  <data key="d8">hp_95e3e85178f2cc76</data>
</edge>
