  <data key="d7">[{"text": "11 Downing Street (sometimes referred to as just Number 11) is the official residence of Britain's Chancellor of the Exchequer (who traditionally also has the title of Second Lord of the Treasury).", "chunk_id": "9f673348a0fb7a1f", "doc_id": "hp_75fe9fb18dc6c720", "type": "SYNONYM"}]</data>
