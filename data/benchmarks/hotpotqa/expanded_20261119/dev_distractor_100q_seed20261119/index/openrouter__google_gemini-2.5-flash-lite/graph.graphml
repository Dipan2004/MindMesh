  <data key="d1">[{"text": "The Salado River is a river located east of Añatuya.", "chunk_id": "3e623f78834fd3ec", "doc_id": "hp_7151fb458fd16091"}]</data>
  <data key="d2">[{"text": "It lies on the southeast of the province, east of the Salado River, and about 150 km from the provincial capital Santiago del Estero.", "chunk_id": "3e623f78834fd3ec", "doc_id": "hp_7151fb458fd16091"}]</data>
