  <data key="d5">["BASED_ON"]</data>
  <data key="d6">The television series Sci Fi Science: Physics of the Impossible is based on the book Physics of the Impossible.</data>
  <data key="d7">[{"text": "The series is hosted by theoretical physicist Michio Kaku and is based on his book \"Physics of the Impossible\".", "chunk_id": "fee479fd980ac770", "doc_id": "hp_78779183524b143c", "type": "BASED_ON"}]</data>
  <data key="d8">hp_78779183524b143c</data>
</edge>
