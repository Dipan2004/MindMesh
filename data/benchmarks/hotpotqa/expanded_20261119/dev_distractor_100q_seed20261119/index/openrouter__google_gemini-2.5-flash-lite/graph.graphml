  <data key="d7">[{"text": "Falange Española de las Juntas de Ofensiva Nacional-Sindicalista (Spanish for \"Spanish Phalanx of the Councils of the National-Syndicalist Offensive\"; \"FE de las JONS\" for short), or simply called the \"Falange\" (  ), was a Fascist and National Syndicalist political party founded in 1934 in Spain as merger of the Falange Española (founded in October 1933) and the Juntas de Ofensiva Nacional-Sindicalista (founded in October 1931).", "chunk_id": "da2cebd3507fe424", "doc_id": "hp_b7901eef5f6745f0", "type": "FOUNDED_IN"}]</data>
