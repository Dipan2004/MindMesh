<node id="Soviet Union">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Soviet Union was a socialist state in Eurasia that existed from 1922 to 1991.", "chunk_id": "1052cd6d62d88ef8", "doc_id": "hp_3b5753bc4ac12f28"}, {"text": "The Soviet Union was a country that Alexander Glazunov left in 1928.", "chunk_id": "e64b24cbe66d981f", "doc_id": "hp_7cda087f9f474c1b"}, {"text": "The Soviet Union is a country that Larisa Savchenko-Neiland represented.", "chunk_id": "a082985ce6c40064", "doc_id": "hp_fb47f9f89cb7cf5e"}]</data>
  <data key="d2">[{"text": "He became the first (and to this day remains the only) Polish national in space, when he flew aboard the Soviet Soyuz 30 spacecraft in 1978.", "chunk_id": "1052cd6d62d88ef8", "doc_id": "hp_3b5753bc4ac12f28"}, {"text": "He continued heading the Conservatory until 1930, though he had left the Soviet Union in 1928 and did not return.", "chunk_id": "e64b24cbe66d981f", "doc_id": "hp_7cda087f9f474c1b"}, {"text": "Larisa Savchenko-Neiland (née Savchenko; born 21 July 1966) is a former professional tennis player who represented the Soviet Union and Latvia.", "chunk_id": "a082985ce6c40064", "doc_id": "hp_fb47f9f89cb7cf5e"}]</data>
  <data key="d3">["hp_3b5753bc4ac12f28", "hp_7cda087f9f474c1b", "hp_fb47f9f89cb7cf5e"]</data>
  <data key="d4">False</data>
</node>
