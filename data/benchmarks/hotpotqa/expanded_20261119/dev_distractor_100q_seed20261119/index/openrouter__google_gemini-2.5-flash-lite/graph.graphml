  <data key="d1">[{"text": "A card game adaptation of The Settlers of Catan.", "chunk_id": "155359f8ca0aea2f", "doc_id": "hp_5f6bdf06a278e8d8"}, {"text": "A card game adaptation of \"The Settlers of Catan\".", "chunk_id": "dbfe350afe445342", "doc_id": "hp_a2aabfc161961b2c"}]</data>
  <data key="d2">[{"text": "The Rivals for Catan (German: \"Die Fürsten von Catan\" ) is an updated revision of the \"Catan Card Game\", a card game adaptation of \"The Settlers of Catan\".", "chunk_id": "155359f8ca0aea2f", "doc_id": "hp_5f6bdf06a278e8d8"}, {"text": "The Catan Card Game, originally named The Settlers of Catan: The Card Game, is a card game adaptation of \"The Settlers of Catan\".", "chunk_id": "dbfe350afe445342", "doc_id": "hp_a2aabfc161961b2c"}]</data>
