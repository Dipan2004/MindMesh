<node id="Nivedita ShivRaj">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Nivedita ShivRaj is a carnatic musician whose musical compositions are presented by the Charanams band.", "chunk_id": "97edcc6d4aeb286e", "doc_id": "hp_5dc26ff008a9a27c"}]</data>
  <data key="d2">[{"text": "Charanams band presents musical compositions of carnatic musician Nivedita ShivRaj.", "chunk_id": "97edcc6d4aeb286e", "doc_id": "hp_5dc26ff008a9a27c"}]</data>
