<edge source="Siege of Leith" target="French troops">
  <data key="d5">["PART_OF"]</data>
  <data key="d6">The Siege of Leith involved French troops.</data>
  <data key="d7">[{"text": "The Siege of Leith ended a twelve-year encampment of French troops at Leith, the port near Edinburgh, Scotland.", "chunk_id": "fed038ae0c566b69", "doc_id": "hp_26004159736d7249", "type": "PART_OF"}]</data>
