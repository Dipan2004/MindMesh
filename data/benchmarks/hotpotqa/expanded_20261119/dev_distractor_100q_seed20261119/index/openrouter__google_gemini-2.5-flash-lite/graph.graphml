  <data key="d7">[{"text": "Divya began her career with the film \"Ek Jaan Hain Hum\" (1984) opposite Raj Kapoor's youngest son Rajiv Kapoor.", "chunk_id": "1621f78ea00aa2b4", "doc_id": "hp_140ab3de808ede2a", "type": "ACTED_IN"}]</data>
