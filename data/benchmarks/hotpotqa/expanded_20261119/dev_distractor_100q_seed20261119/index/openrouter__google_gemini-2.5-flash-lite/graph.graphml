  <data key="d5">["IS_A", "IS_A"]</data>
  <data key="d6">Mona Stapleton is the 11th Baroness Beaumont.</data>
  <data key="d7">[{"text": "His grandson, the third Baron (who succeeded his father), married Mona Stapleton, 11th Baroness Beaumont.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981", "type": "IS_A"}, {"text": "He was the eldest son of Bernard Fitzalan-Howard, 3rd Baron Howard of Glossop, and his wife Mona Stapleton, 11th Baroness Beaumont.", "chunk_id": "8130aa8415f90292", "doc_id": "hp_aa48cba1bf19ae7b", "type": "IS_A"}]</data>
