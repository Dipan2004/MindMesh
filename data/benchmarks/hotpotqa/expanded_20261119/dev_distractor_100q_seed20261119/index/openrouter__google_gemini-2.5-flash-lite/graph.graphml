<node id="Battle of Hansan Island">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A naval battle that took place on July 8, 1592, near the Korean island of Hansan.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d2">[{"text": "The naval Battle of Hansan Island, also known as the Battle of Hansando, took place on July 8, 1592, near the Korean island of Hansan.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d3">["hp_4e9436b9b6a97ad9"]</data>
