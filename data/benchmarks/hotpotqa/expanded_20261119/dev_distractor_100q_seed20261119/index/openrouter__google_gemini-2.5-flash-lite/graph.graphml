<edge source="Notre Dame High School for Girls" target="St. Julie Billiart">
  <data key="d5">["BASED_ON"]</data>
  <data key="d6">The teachings of Notre Dame High School for Girls were based on the educational philosophy of St. Julie Billiart.</data>
  <data key="d7">[{"text": "Its teachings were based on the educational philosophy of St. Julie Billiart, founder of the Sisters of Notre Dame de Namur.", "chunk_id": "e1f93f4fdb5e61f5", "doc_id": "hp_db88fb2791fae586", "type": "BASED_ON"}]</data>
