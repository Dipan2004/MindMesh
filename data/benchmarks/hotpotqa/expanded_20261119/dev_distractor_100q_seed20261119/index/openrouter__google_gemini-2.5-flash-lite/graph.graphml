  <data key="d6">Ivan Kaye plays the role of DI Sam Sterne.</data>
  <data key="d7">[{"text": "The six-part series produced by Cinema Verity in association with LWT, broadcast on ITV, follows the work of DI Sam Sterne (Ivan Kaye), a Jewish police detective, as he struggles to balance the demands of the job with his private life.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498", "type": "PLAYS_ROLE"}]</data>
