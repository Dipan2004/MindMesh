<node id="Myanmar">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A country in Southeast Asia.", "chunk_id": "f6e0ca7c3e63f550", "doc_id": "hp_0e1b00a3eeabb9ce"}, {"text": "Myanmar is a country in Southeast Asia.", "chunk_id": "105244edf12919e4", "doc_id": "hp_4584bae78bfb29b3"}, {"text": "A country in Southeast Asia.", "chunk_id": "0cb99287d9c2da80", "doc_id": "hp_81f5a8696daf3dee"}, {"text": "A country bordering southwestern Yunnan, where Ruili is located.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d2">[{"text": "Wanding Border Economic Cooperation Zone (WTBECZ) is a Chinese State Council-approved Industrial Park based in Wanding Town, Ruili City, Dehong Prefecture, Yunnan, China, founded in 1992 and was established to promote trade between China and Myanmar.", "chunk_id": "f6e0ca7c3e63f550", "doc_id": "hp_0e1b00a3eeabb9ce"}, {"text": "It is a major border crossing between China and Myanmar, with the town of Muse located across the border.", "chunk_id": "105244edf12919e4", "doc_id": "hp_4584bae78bfb29b3"}, {"text": "Ruili Border Economic Cooperation Zone (RLBECZ) is a Chinese State Council-approved Industrial Park based in Ruili City, Dehong Prefecture, Yunnan, China, founded in 1992 and was established to promote trade between China and Myanmar.", "chunk_id": "0cb99287d9c2da80", "doc_id": "hp_81f5a8696daf3dee"}, {"text": "The line is slated to run 336.39 km from Dali in central Yunnan to Ruili in southwestern Yunnan on the border with Myanmar.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d3">["hp_0e1b00a3eeabb9ce", "hp_4584bae78bfb29b3", "hp_81f5a8696daf3dee", "hp_c90ebb0b4e670d3e"]</data>
  <data key="d4">False</data>
</node>
