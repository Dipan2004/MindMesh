  <data key="d2">[{"text": "The scenery was executed by Alexander Shervashidze, with costumes under the direction of Mme. A. Youkine.", "chunk_id": "7d4e3a512ec3ac2c", "doc_id": "hp_9db3a175e11b24ac"}]</data>
