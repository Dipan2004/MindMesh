<node id="Commerce Casino">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The sponsor of the 2013 World's Strongest Man event.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "A casino that hosted the 2014 World's Strongest Man event and sponsored it.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d2">[{"text": "The event was sponsored by the Commerce Casino and will be broadcast in the United States on the CBS Sports Network.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "The event was held at the Commerce Casino in Los Angeles, California, the same host city as the 2012 World's Strongest Man contest.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d3">["hp_45c17b9e08342c16", "hp_5d64f24bd8d85ba4"]</data>
