  <data key="d7">[{"text": "The term \"dime novel\" has been used as a catchall term for several different but related forms, referring to dime novels, story papers, five- and ten-cent weeklies, \"thick book\" reprints, and sometimes early pulp magazines.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf", "type": "RELATED_TO"}]</data>
