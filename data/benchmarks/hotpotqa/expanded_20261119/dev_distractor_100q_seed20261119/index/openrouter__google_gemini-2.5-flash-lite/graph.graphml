  <data key="d5">["PLAYED_IN"]</data>
  <data key="d6">The Warroad Lakers played in the Thunder Bay AHA league.</data>
  <data key="d7">[{"text": "The Lakers played in various Manitoba AHA and Thunder Bay AHA senior and intermediate leagues and were granted special eligibility for the Allan Cup and Hardy Cup by the Canadian Amateur Hockey Association.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e", "type": "PLAYED_IN"}]</data>
  <data key="d8">hp_0c2bb267ca87242e</data>
</edge>
<edge source="Warroad Lakers" target="Allan Cup">
  <data key="d5">["ELIGIBLE_FOR", "WON", "FINALIST_IN"]</data>
  <data key="d6">The Warroad Lakers were granted special eligibility for the Allan Cup.</data>
  <data key="d7">[{"text": "The Lakers played in various Manitoba AHA and Thunder Bay AHA senior and intermediate leagues and were granted special eligibility for the Allan Cup and Hardy Cup by the Canadian Amateur Hockey Association.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e", "type": "ELIGIBLE_FOR"}, {"text": "The Lakers were three-time Allan Cup Canadian National Champions, one-time Allan Cup National Finalists, one-time Hardy Cup Canadian National Champions, and one-time Hardy Cup National Finalists.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e", "type": "WON"}, {"text": "The Lakers were three-time Allan Cup Canadian National Champions, one-time Allan Cup National Finalists, one-time Hardy Cup Canadian National Champions, and one-time Hardy Cup National Finalists.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e", "type": "FINALIST_IN"}]</data>
  <data key="d8">hp_0c2bb267ca87242e</data>
</edge>
<edge source="Warroad Lakers" target="Hardy Cup">
  <data key="d5">["ELIGIBLE_FOR", "WON", "FINALIST_IN"]</data>
  <data key="d6">The Warroad Lakers were granted special eligibility for the Hardy Cup.</data>
  <data key="d7">[{"text": "The Lakers played in various Manitoba AHA and Thunder Bay AHA senior and intermediate leagues and were granted special eligibility for the Allan Cup and Hardy Cup by the Canadian Amateur Hockey Association.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e", "type": "ELIGIBLE_FOR"}, {"text": "The Lakers were three-time Allan Cup Canadian National Champions, one-time Allan Cup National Finalists, one-time Hardy Cup Canadian National Champions, and one-time Hardy Cup National Finalists.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e", "type": "WON"}, {"text": "The Lakers were three-time Allan Cup Canadian National Champions, one-time Allan Cup National Finalists, one-time Hardy Cup Canadian National Champions, and one-time Hardy Cup National Finalists.", "chunk_id": "ddf0ad92d8d0e27f", "doc_id": "hp_0c2bb267ca87242e", "type": "FINALIST_IN"}]</data>
  <data key="d8">hp_0c2bb267ca87242e</data>
</edge>
