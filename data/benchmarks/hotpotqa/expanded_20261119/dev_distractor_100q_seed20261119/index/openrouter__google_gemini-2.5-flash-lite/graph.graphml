<node id="Stokely Webster">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Stokely Webster was an American impressionist painter.", "chunk_id": "1207dedf3633b579", "doc_id": "hp_e2ee24b441181783"}]</data>
  <data key="d2">[{"text": "Stokely Webster (1912 – 2001) was best known as an American impressionist painter who studied in Paris.", "chunk_id": "1207dedf3633b579", "doc_id": "hp_e2ee24b441181783"}]</data>
  <data key="d3">["hp_e2ee24b441181783"]</data>
