  <data key="d1">[{"text": "Rose Mary Woods was Richard Nixon's secretary from his days in Congress in 1951, through the end of his political career.", "chunk_id": "7a98a826c469ba66", "doc_id": "hp_866e1a0ee1799d1f"}]</data>
  <data key="d2">[{"text": "Rose Mary Woods (December 26, 1917 – January 22, 2005) was Richard Nixon's secretary from his days in Congress in 1951, through the end of his political career.", "chunk_id": "7a98a826c469ba66", "doc_id": "hp_866e1a0ee1799d1f"}]</data>
  <data key="d3">["hp_866e1a0ee1799d1f"]</data>
