  <data key="d2">[{"text": "He held that position until 1949, when he transferred to federal politics, defeating former New South Wales Premier Jack Lang for the new seat of Blaxland.", "chunk_id": "53f3bbd1c43e3155", "doc_id": "hp_7820faef8a00d610"}]</data>
