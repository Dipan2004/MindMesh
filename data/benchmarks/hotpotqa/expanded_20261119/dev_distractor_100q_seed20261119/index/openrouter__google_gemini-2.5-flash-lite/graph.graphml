  <data key="d2">[{"text": "A Christmas special, 'Gay' (titled 'Absolutely Fabulous in New York' in the United States) was produced following the fourth series and was broadcast in 2002.", "chunk_id": "2d1cd752b15a14fe", "doc_id": "hp_323aaf8fc4b0ff2c"}]</data>
