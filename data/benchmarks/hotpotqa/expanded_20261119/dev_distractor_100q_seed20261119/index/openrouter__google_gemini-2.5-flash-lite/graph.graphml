  <data key="d1">[{"text": "A professional soccer team that played at the stadium.", "chunk_id": "46d1dcb113cf375f", "doc_id": "hp_0503aae2329a84c0"}, {"text": "Sporting Kansas City is a soccer team.", "chunk_id": "a5a5e072ef0dadfe", "doc_id": "hp_51337bcb6dcc3272"}, {"text": "The current name of the Kansas City Wizards soccer team.", "chunk_id": "a27e4bf63c5efe9b", "doc_id": "hp_812fa33d19a7766e"}, {"text": "A professional soccer team that competes in Major League Soccer.", "chunk_id": "4fff3c5799a91438", "doc_id": "hp_8d08fba9378453ea"}]</data>
  <data key="d2">[{"text": "Sporting Kansas City, then called the Kansas City Wizards, played at the stadium in a match against the Colorado Rapids during the 2008 Lamar Hunt U.S. Open Cup.", "chunk_id": "46d1dcb113cf375f", "doc_id": "hp_0503aae2329a84c0"}, {"text": "Johnson's professional soccer administrative resume also includes holding the General Manager position with the Richmond Kickers (at the time members of the A-League/Division 2) and Major League Soccer's Kansas City Wizards (now known as Sporting Kansas City).", "chunk_id": "a5a5e072ef0dadfe", "doc_id": "hp_51337bcb6dcc3272"}, {"text": "It is home of the Kansas City T-Bones of the independent American Association, and the former home of the Kansas City Wizards (now Sporting Kansas City) of Major League Soccer.", "chunk_id": "a27e4bf63c5efe9b", "doc_id": "hp_812fa33d19a7766e"}, {"text": "All-time Sporting Kansas City roster", "chunk_id": "4fff3c5799a91438", "doc_id": "hp_8d08fba9378453ea"}]</data>
  <data key="d3">["hp_0503aae2329a84c0", "hp_51337bcb6dcc3272", "hp_812fa33d19a7766e", "hp_8d08fba9378453ea"]</data>
  <data key="d4">False</data>
</node>
<node id="Kansas City Wizards">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The former name of Sporting Kansas City.", "chunk_id": "46d1dcb113cf375f", "doc_id": "hp_0503aae2329a84c0"}, {"text": "A professional soccer team.", "chunk_id": "29dfa2df58a551ed", "doc_id": "hp_132ccee5aa3dd85c"}, {"text": "A professional soccer team based in Kansas City.", "chunk_id": "ca56de409a030dd6", "doc_id": "hp_33b159b8faca1ec8"}, {"text": "Kansas City Wizards was a soccer team.", "chunk_id": "a5a5e072ef0dadfe", "doc_id": "hp_51337bcb6dcc3272"}, {"text": "A former soccer team that played at CommunityAmerica Ballpark.", "chunk_id": "a27e4bf63c5efe9b", "doc_id": "hp_812fa33d19a7766e"}, {"text": "A professional soccer team based in Kansas City.", "chunk_id": "1dcb1ca9df627726", "doc_id": "hp_8ad05a86a63976c5"}, {"text": "The former name of Sporting Kansas City.", "chunk_id": "4fff3c5799a91438", "doc_id": "hp_8d08fba9378453ea"}, {"text": "A professional soccer team based in Kansas City.", "chunk_id": "e6a59a32f07d004d", "doc_id": "hp_ad68101ffb82caf3"}, {"text": "A professional soccer team based in Kansas City, Missouri.", "chunk_id": "ea967b117448c7a9", "doc_id": "hp_f960cf6c89ae3463"}]</data>
  <data key="d2">[{"text": "Sporting Kansas City, then called the Kansas City Wizards, played at the stadium in a match against the Colorado Rapids during the 2008 Lamar Hunt U.S. Open Cup.", "chunk_id": "46d1dcb113cf375f", "doc_id": "hp_0503aae2329a84c0"}, {"text": "The 1997 Kansas City Wizards season was the second in team and MLS history.", "chunk_id": "29dfa2df58a551ed", "doc_id": "hp_132ccee5aa3dd85c"}, {"text": "The 1998 Kansas City Wizards season was the third MLS history.", "chunk_id": "ca56de409a030dd6", "doc_id": "hp_33b159b8faca1ec8"}, {"text": "Johnson's professional soccer administrative resume also includes holding the General Manager position with the Richmond Kickers (at the time members of the A-League/Division 2) and Major League Soccer's Kansas City Wizards (now known as Sporting Kansas City).", "chunk_id": "a5a5e072ef0dadfe", "doc_id": "hp_51337bcb6dcc3272"}, {"text": "It is home of the Kansas City T-Bones of the independent American Association, and the former home of the Kansas City Wizards (now Sporting Kansas City) of Major League Soccer.", "chunk_id": "a27e4bf63c5efe9b", "doc_id": "hp_812fa33d19a7766e"}, {"text": "1999 Kansas City Wizards season", "chunk_id": "1dcb1ca9df627726", "doc_id": "hp_8ad05a86a63976c5"}, {"text": "Sporting Kansas City (formerly known as Kansas City Wiz and Kansas City Wizards) since the team's first Major League Soccer season in 1996.", "chunk_id": "4fff3c5799a91438", "doc_id": "hp_8d08fba9378453ea"}, {"text": "2008 Kansas City Wizards season", "chunk_id": "e6a59a32f07d004d", "doc_id": "hp_ad68101ffb82caf3"}, {"text": "MLS Cup 2004, the ninth edition of Major League Soccer's championship match, was played between D.C. United and the Kansas City Wizards to decide the champion of the 2004 season.", "chunk_id": "ea967b117448c7a9", "doc_id": "hp_f960cf6c89ae3463"}]</data>
  <data key="d3">["hp_0503aae2329a84c0", "hp_132ccee5aa3dd85c", "hp_33b159b8faca1ec8", "hp_51337bcb6dcc3272", "hp_812fa33d19a7766e", "hp_8ad05a86a63976c5", "hp_8d08fba9378453ea", "hp_ad68101ffb82caf3", "hp_f960cf6c89ae3463"]</data>
  <data key="d4">False</data>
</node>
<node id="Colorado Rapids">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A soccer team that played against Sporting Kansas City.", "chunk_id": "46d1dcb113cf375f", "doc_id": "hp_0503aae2329a84c0"}, {"text": "A professional soccer club.", "chunk_id": "8ec9e2e0b3532cdf", "doc_id": "hp_1eeecb27d77cc2fb"}, {"text": "Colorado Rapids is an MLS club captained by Tim Howard.", "chunk_id": "9fbf6c6c7157eff1", "doc_id": "hp_4d75d6e44332ee9b"}, {"text": "Colorado Rapids is a Major League Soccer club.", "chunk_id": "8d4b7cbdddb5b474", "doc_id": "hp_4f29423425e909b7"}, {"text": "A professional soccer club based in Commerce City, Colorado.", "chunk_id": "1221adbf4371c7a0", "doc_id": "hp_60e7d9ac9e049733"}, {"text": "A Major League Soccer franchise whose development system included the Colorado Rapids U-23 team.", "chunk_id": "2fbe7eef52bbabf7", "doc_id": "hp_b1d9c15ce97f0f1f"}, {"text": "A professional soccer team based in the Denver metropolitan area.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}, {"text": "Colorado Rapids is a Major League Soccer club.", "chunk_id": "43aad4e477f8ff50", "doc_id": "hp_daef9730974fe681"}, {"text": "The Colorado Rapids is a professional soccer team that plays in Major League Soccer.", "chunk_id": "fa8b75f19429db6d", "doc_id": "hp_f0968af3cbb3184b"}]</data>
  <data key="d2">[{"text": "Sporting Kansas City, then called the Kansas City Wizards, played at the stadium in a match against the Colorado Rapids during the 2008 Lamar Hunt U.S. Open Cup.", "chunk_id": "46d1dcb113cf375f", "doc_id": "hp_0503aae2329a84c0"}, {"text": "The Earthquakes finished 8th overall in MLS and finished in the Eastern Conference finals of the MLS Cup playoffs before losing to the Colorado Rapids.", "chunk_id": "8ec9e2e0b3532cdf", "doc_id": "hp_1eeecb27d77cc2fb"}, {"text": "Timothy Matthew Howard (born March 6, 1979) is an American soccer player who captains the MLS club Colorado Rapids and plays for the United States national team as a goalkeeper.", "chunk_id": "9fbf6c6c7157eff1", "doc_id": "hp_4d75d6e44332ee9b"}, {"text": "Shkëlzen Taib Gashi (born 15 July 1988) is an Albanian professional footballer who plays as a midfielder and forward for Major League Soccer club Colorado Rapids and the Albania national team.", "chunk_id": "8d4b7cbdddb5b474", "doc_id": "hp_4f29423425e909b7"}, {"text": "Upon the completion of the regular season the 2010 MLS Cup Playoffs culminated on November 21 with a 2–1 victory by the Colorado Rapids over FC Dallas at Toronto's BMO Field.", "chunk_id": "1221adbf4371c7a0", "doc_id": "hp_60e7d9ac9e049733"}, {"text": "Founded in 2000 as part of the development system for the Colorado Rapids Major League Soccer franchise, the team played in the USL Premier Development League (PDL), the fourth tier of the American Soccer Pyramid, until 2008, when the franchise folded and the team left the league.", "chunk_id": "2fbe7eef52bbabf7", "doc_id": "hp_b1d9c15ce97f0f1f"}, {"text": "MLS Cup 2010, the 15th edition of Major League Soccer's championship match, was played between the Colorado Rapids and FC Dallas to decide the champion of the 2010 season.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}, {"text": "Ian Francis Joyce (born July 12, 1985) is an American soccer player who most recently played for Major League Soccer club Colorado Rapids.", "chunk_id": "43aad4e477f8ff50", "doc_id": "hp_daef9730974fe681"}, {"text": "Zach Thornton (born October 10, 1973 in Edgewood, Maryland) is a retired goalkeeper who spent 16 seasons in Major League Soccer (MLS) with the New York/New Jersey MetroStars (1996–1997), Chicago Fire (1998–2006), Colorado Rapids (2007), New York Red Bulls (2008) and Chivas USA (2008–2011).", "chunk_id": "fa8b75f19429db6d", "doc_id": "hp_f0968af3cbb3184b"}]</data>
  <data key="d3">["hp_0503aae2329a84c0", "hp_1eeecb27d77cc2fb", "hp_4d75d6e44332ee9b", "hp_4f29423425e909b7", "hp_60e7d9ac9e049733", "hp_b1d9c15ce97f0f1f", "hp_b8c5eba035057a5e", "hp_daef9730974fe681", "hp_f0968af3cbb3184b"]</data>
  <data key="d4">False</data>
</node>
