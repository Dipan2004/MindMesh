<node id="University of Minnesota system">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The University of Minnesota system is a public university system in the U.S. state of Minnesota.", "chunk_id": "60d483d501d17f6f", "doc_id": "hp_936dd5018d3d1151"}]</data>
  <data key="d2">[{"text": "Eastcliff is a 20-room house overlooking the Mississippi River in St. Paul, Minnesota, which serves as the official residence of the president of the University of Minnesota system.", "chunk_id": "60d483d501d17f6f", "doc_id": "hp_936dd5018d3d1151"}]</data>
