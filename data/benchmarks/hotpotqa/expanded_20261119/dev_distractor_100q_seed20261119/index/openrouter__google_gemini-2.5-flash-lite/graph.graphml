  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A neighborhood in Dayton, Ohio, that includes Saint Anne's Hill Historic District.", "chunk_id": "b3dd1a340e6929c9", "doc_id": "hp_58345f001027ee37"}]</data>
  <data key="d2">[{"text": "Saint Anne's Hill Historic District is part of the Historic Inner East neighborhood in Dayton, Ohio, United States.", "chunk_id": "b3dd1a340e6929c9", "doc_id": "hp_58345f001027ee37"}]</data>
  <data key="d3">["hp_58345f001027ee37"]</data>
