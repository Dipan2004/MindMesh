<edge source="Nation and Destiny" target="North Korean cinema">
  <data key="d5">["LARGEST_INVESTMENT_IN"]</data>
  <data key="d6">The film series represented the largest investment ever made in the history of North Korean cinema.</data>
  <data key="d7">[{"text": "Conceived as the largest film series ever produced in any country, it was the largest investment ever made in the history of North Korean cinema.", "chunk_id": "459ce873024f40a4", "doc_id": "hp_d64aea307fb47882", "type": "LARGEST_INVESTMENT_IN"}]</data>
