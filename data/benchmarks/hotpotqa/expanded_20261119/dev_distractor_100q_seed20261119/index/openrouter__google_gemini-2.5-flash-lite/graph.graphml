<node id="Archbishop of Canterbury">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The metropolitan bishop of the Province of Canterbury in the Church of England.", "chunk_id": "2c3049d8d75419f1", "doc_id": "hp_1be1d29e3663e988"}]</data>
  <data key="d2">[{"text": "Augustine of Canterbury (born first third of the 6th century – died probably 26 May 604) was a Catholic Benedictine monk who became the first Archbishop of Canterbury in the year 597.", "chunk_id": "2c3049d8d75419f1", "doc_id": "hp_1be1d29e3663e988"}]</data>
  <data key="d3">["hp_1be1d29e3663e988"]</data>
  <data key="d4">False</data>
</node>
<node id="Apostle to the English">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A title given to Augustine of Canterbury for his missionary work.", "chunk_id": "2c3049d8d75419f1", "doc_id": "hp_1be1d29e3663e988"}]</data>
  <data key="d2">[{"text": "He is considered the \"Apostle to the English\" and a founder of the Catholic Church in England.", "chunk_id": "2c3049d8d75419f1", "doc_id": "hp_1be1d29e3663e988"}]</data>
  <data key="d3">["hp_1be1d29e3663e988"]</data>
  <data key="d4">False</data>
</node>
<node id="Catholic Church in England">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Catholic Church's presence and organization within England.", "chunk_id": "2c3049d8d75419f1", "doc_id": "hp_1be1d29e3663e988"}]</data>
  <data key="d2">[{"text": "He is considered the \"Apostle to the English\" and a founder of the Catholic Church in England.", "chunk_id": "2c3049d8d75419f1", "doc_id": "hp_1be1d29e3663e988"}]</data>
  <data key="d3">["hp_1be1d29e3663e988"]</data>
  <data key="d4">False</data>
</node>
<node id="Bishop's House">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Bishop's House is a historical building in Birmingham, England.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d2">[{"text": "The Bishop's House in Birmingham, England was designed by Augustus Pugin as the residence of Thomas Walsh, the first Roman Catholic Bishop of Birmingham.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d3">["hp_1c06089a0ef41f46"]</data>
  <data key="d4">False</data>
</node>
<node id="Augustus Pugin">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Augustus Pugin was an architect who designed the Bishop's House.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d2">[{"text": "The Bishop's House in Birmingham, England was designed by Augustus Pugin as the residence of Thomas Walsh, the first Roman Catholic Bishop of Birmingham.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d3">["hp_1c06089a0ef41f46"]</data>
  <data key="d4">False</data>
</node>
<node id="Thomas Walsh">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Thomas Walsh was the first Roman Catholic Bishop of Birmingham and the intended resident of the Bishop's House.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d2">[{"text": "The Bishop's House in Birmingham, England was designed by Augustus Pugin as the residence of Thomas Walsh, the first Roman Catholic Bishop of Birmingham.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d3">["hp_1c06089a0ef41f46"]</data>
  <data key="d4">False</data>
</node>
<node id="Roman Catholic Bishop of Birmingham">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The title held by Thomas Walsh, the first to occupy the Bishop's House.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d2">[{"text": "The Bishop's House in Birmingham, England was designed by Augustus Pugin as the residence of Thomas Walsh, the first Roman Catholic Bishop of Birmingham.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d3">["hp_1c06089a0ef41f46"]</data>
  <data key="d4">False</data>
</node>
<node id="Bath Street">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Bath Street is a street in Birmingham City Centre where the Bishop's House was situated.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d2">[{"text": "It was situated opposite St Chad's Cathedral, on the corner of Bath Street and Weaman Street in Birmingham City Centre.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d3">["hp_1c06089a0ef41f46"]</data>
  <data key="d4">False</data>
</node>
<node id="Weaman Street">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Weaman Street is a street in Birmingham City Centre where the Bishop's House was situated.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d2">[{"text": "It was situated opposite St Chad's Cathedral, on the corner of Bath Street and Weaman Street in Birmingham City Centre.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d3">["hp_1c06089a0ef41f46"]</data>
  <data key="d4">False</data>
</node>
<node id="Birmingham City Centre">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Birmingham City Centre is the central area of Birmingham where the Bishop's House was located.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d2">[{"text": "It was situated opposite St Chad's Cathedral, on the corner of Bath Street and Weaman Street in Birmingham City Centre.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d3">["hp_1c06089a0ef41f46"]</data>
  <data key="d4">False</data>
</node>
<node id="Lower Paleolithic era">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The earliest period of human history in the Korean Peninsula.", "chunk_id": "1aaf25b79d68fe30", "doc_id": "hp_1c48776465495288"}]</data>
  <data key="d2">[{"text": "The Lower Paleolithic era in the Korean Peninsula began roughly half a million years ago.", "chunk_id": "1aaf25b79d68fe30", "doc_id": "hp_1c48776465495288"}]</data>
  <data key="d3">["hp_1c48776465495288"]</data>
  <data key="d4">False</data>
</node>
<node id="Korean Peninsula">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The geographical region where early Korean history unfolded.", "chunk_id": "1aaf25b79d68fe30", "doc_id": "hp_1c48776465495288"}, {"text": "A peninsula where North Korean forces were withdrawing up the west coast.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "The Lower Paleolithic era in the Korean Peninsula began roughly half a million years ago.", "chunk_id": "1aaf25b79d68fe30", "doc_id": "hp_1c48776465495288"}, {"text": "On 20 October US 187 RCT had parachuted ahead of the advancing UN spearheads into drop zones in Sukchon and Sunchon, 40 km north of the capital Pyongyang, with the objectives of cutting off the retreating North Korean forces that were withdrawing up the west coast of the Korean Peninsula and releasing American and South Korean prisoners of war.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_1c48776465495288", "hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="Korean pottery">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Ceramic artifacts originating from Korea.", "chunk_id": "1aaf25b79d68fe30", "doc_id": "hp_1c48776465495288"}]</data>
  <data key="d2">[{"text": "The earliest known Korean pottery dates to around 8000 BC, and the Neolithic period began after 6000 BC, followed by the Bronze Age by 800 BC, and the Iron Age around 400 BC.", "chunk_id": "1aaf25b79d68fe30", "doc_id": "hp_1c48776465495288"}]</data>
  <data key="d3">["hp_1c48776465495288"]</data>
  <data key="d4">False</data>
</node>
<node id="Neolithic period">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A prehistoric period characterized by the development of agriculture and settled communities.", "chunk_id": "1aaf25b79d68fe30", "doc_id": "hp_1c48776465495288"}]</data>
  <data key="d2">[{"text": "The earliest known Korean pottery dates to around 8000 BC, and the Neolithic period began after 6000 BC, followed by the Bronze Age by 800 BC, and the Iron Age around 400 BC.", "chunk_id": "1aaf25b79d68fe30", "doc_id": "hp_1c48776465495288"}]</data>
  <data key="d3">["hp_1c48776465495288"]</data>
  <data key="d4">False</data>
</node>
<node id="Bronze Age">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A prehistoric period characterized by the widespread use of bronze.", "chunk_id": "1aaf25b79d68fe30", "doc_id": "hp_1c48776465495288"}]</data>
  <data key="d2">[{"text": "The earliest known Korean pottery dates to around 8000 BC, and the Neolithic period began after 6000 BC, followed by the Bronze Age by 800 BC, and the Iron Age around 400 BC.", "chunk_id": "1aaf25b79d68fe30", "doc_id": "hp_1c48776465495288"}]</data>
  <data key="d3">["hp_1c48776465495288"]</data>
  <data key="d4">False</data>
</node>
<node id="Iron Age">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A prehistoric period characterized by the widespread use of iron.", "chunk_id": "1aaf25b79d68fe30", "doc_id": "hp_1c48776465495288"}]</data>
  <data key="d2">[{"text": "The earliest known Korean pottery dates to around 8000 BC, and the Neolithic period began after 6000 BC, followed by the Bronze Age by 800 BC, and the Iron Age around 400 BC.", "chunk_id": "1aaf25b79d68fe30", "doc_id": "hp_1c48776465495288"}]</data>
  <data key="d3">["hp_1c48776465495288"]</data>
  <data key="d4">False</data>
</node>
