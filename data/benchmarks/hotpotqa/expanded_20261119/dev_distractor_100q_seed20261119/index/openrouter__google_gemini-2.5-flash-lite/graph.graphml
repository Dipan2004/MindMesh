<node id="Robert James">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An American businessman and the founder of Raymond James Financial.", "chunk_id": "44c0c5d2ca4184c5", "doc_id": "hp_14d468e130d3ae29"}, {"text": "The father of Thomas James and the founder of Raymond James Financial.", "chunk_id": "b6874d56d2fdd648", "doc_id": "hp_18fbcd7469354b78"}]</data>
  <data key="d2">[{"text": "Robert A. James (died 1983) was an American businessman, the founder of Raymond James Financial, an S&amp;P 500-listed financial services company.", "chunk_id": "44c0c5d2ca4184c5", "doc_id": "hp_14d468e130d3ae29"}, {"text": "Thomas James (born 1942/43) is an American billionaire businessman, the chairman of Raymond James Financial, founded by his father Robert James, for 30 years.", "chunk_id": "b6874d56d2fdd648", "doc_id": "hp_18fbcd7469354b78"}]</data>
  <data key="d3">["hp_14d468e130d3ae29", "hp_18fbcd7469354b78"]</data>
  <data key="d4">False</data>
</node>
<node id="Raymond James Financial">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An S&amp;P 500-listed financial services company founded by Robert A. James.", "chunk_id": "44c0c5d2ca4184c5", "doc_id": "hp_14d468e130d3ae29"}, {"text": "A financial company where Thomas James serves as chairman.", "chunk_id": "b6874d56d2fdd648", "doc_id": "hp_18fbcd7469354b78"}, {"text": "The acquiring company of Morgan Keegan &amp; Co. business units.", "chunk_id": "fb77db64cb286920", "doc_id": "hp_24ed7c7e2985924e"}, {"text": "Raymond James Financial is an American diversified holding company providing financial services.", "chunk_id": "60146d8f881241fd", "doc_id": "hp_39b8c05e25e40014"}, {"text": "The current owner of the firm Morgan Keegan &amp; Company.", "chunk_id": "acbedb4101c218db", "doc_id": "hp_f85849d8812b9ed2"}]</data>
  <data key="d2">[{"text": "Robert A. James (died 1983) was an American businessman, the founder of Raymond James Financial, an S&amp;P 500-listed financial services company.", "chunk_id": "44c0c5d2ca4184c5", "doc_id": "hp_14d468e130d3ae29"}, {"text": "Thomas James (born 1942/43) is an American billionaire businessman, the chairman of Raymond James Financial, founded by his father Robert James, for 30 years.", "chunk_id": "b6874d56d2fdd648", "doc_id": "hp_18fbcd7469354b78"}, {"text": "Raymond James | Morgan Keegan is the interim name of the former Morgan Keegan &amp; Co. business units acquired by Raymond James Financial on April 2, 2012.", "chunk_id": "fb77db64cb286920", "doc_id": "hp_24ed7c7e2985924e"}, {"text": "Raymond James Financial is an American diversified holding company providing financial services to individuals, corporations and municipalities through its subsidiary companies that engage primarily in investment and financial planning, in addition to investment banking and asset management.", "chunk_id": "60146d8f881241fd", "doc_id": "hp_39b8c05e25e40014"}, {"text": "The firm is now owned by Raymond James Financial.", "chunk_id": "acbedb4101c218db", "doc_id": "hp_f85849d8812b9ed2"}]</data>
  <data key="d3">["hp_14d468e130d3ae29", "hp_18fbcd7469354b78", "hp_24ed7c7e2985924e", "hp_39b8c05e25e40014", "hp_f85849d8812b9ed2"]</data>
  <data key="d4">False</data>
</node>
<node id="Catan Histories: Struggle for Rome">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A 2006 German-style board game based on the game mechanics of \"Settlers of Catan\", depicting the fall of the Western Roman Empire.", "chunk_id": "03c733f6cd0d7d56", "doc_id": "hp_14e68ec60eba2e91"}]</data>
  <data key="d2">[{"text": "Catan Histories: Struggle for Rome is a 2006 German-style board game based on the game mechanics of \"Settlers of Catan\", depicting the fall of the Western Roman Empire.", "chunk_id": "03c733f6cd0d7d56", "doc_id": "hp_14e68ec60eba2e91"}]</data>
  <data key="d3">["hp_14e68ec60eba2e91"]</data>
  <data key="d4">False</data>
</node>
<node id="Settlers of Catan">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A board game whose mechanics are used as the basis for Catan Histories: Struggle for Rome.", "chunk_id": "03c733f6cd0d7d56", "doc_id": "hp_14e68ec60eba2e91"}, {"text": "A notable title by Klaus Teuber, which Catan Dice Game re-imagines.", "chunk_id": "d146a6f0cb5047a2", "doc_id": "hp_ba7adfcb35f11075"}]</data>
  <data key="d2">[{"text": "Catan Histories: Struggle for Rome is a 2006 German-style board game based on the game mechanics of \"Settlers of Catan\", depicting the fall of the Western Roman Empire.", "chunk_id": "03c733f6cd0d7d56", "doc_id": "hp_14e68ec60eba2e91"}, {"text": "It is a dice game re-imagining of Teuber's most notable title, \"Settlers of Catan\".", "chunk_id": "d146a6f0cb5047a2", "doc_id": "hp_ba7adfcb35f11075"}]</data>
  <data key="d3">["hp_14e68ec60eba2e91", "hp_ba7adfcb35f11075"]</data>
  <data key="d4">False</data>
</node>
<node id="Western Roman Empire">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An empire whose fall is depicted in the board game Catan Histories: Struggle for Rome.", "chunk_id": "03c733f6cd0d7d56", "doc_id": "hp_14e68ec60eba2e91"}]</data>
  <data key="d2">[{"text": "Catan Histories: Struggle for Rome is a 2006 German-style board game based on the game mechanics of \"Settlers of Catan\", depicting the fall of the Western Roman Empire.", "chunk_id": "03c733f6cd0d7d56", "doc_id": "hp_14e68ec60eba2e91"}]</data>
  <data key="d3">["hp_14e68ec60eba2e91"]</data>
  <data key="d4">False</data>
</node>
<node id="Catan GmbH">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A company that licenses its game mechanics for Catan Histories: Struggle for Rome.", "chunk_id": "03c733f6cd0d7d56", "doc_id": "hp_14e68ec60eba2e91"}, {"text": "A publisher of the Catan Dice Game.", "chunk_id": "d146a6f0cb5047a2", "doc_id": "hp_ba7adfcb35f11075"}]</data>
  <data key="d2">[{"text": "The game is created by Klaus Teuber, the creator of \"Settlers\", and is published under license from Catan GmbH by Kosmos in German and Mayfair Games in English.", "chunk_id": "03c733f6cd0d7d56", "doc_id": "hp_14e68ec60eba2e91"}, {"text": "Catan Dice Game is a German-style board game, developed by Klaus Teuber and published in 2007 by Catan GmbH and its licensors, Kosmos in Germany and Mayfair Games in English-speaking countries.", "chunk_id": "d146a6f0cb5047a2", "doc_id": "hp_ba7adfcb35f11075"}]</data>
  <data key="d3">["hp_14e68ec60eba2e91", "hp_ba7adfcb35f11075"]</data>
  <data key="d4">False</data>
</node>
<node id="Catan Histories">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A series of board games that includes Catan Histories: Struggle for Rome as its second installment.", "chunk_id": "03c733f6cd0d7d56", "doc_id": "hp_14e68ec60eba2e91"}]</data>
  <data key="d2">[{"text": "It is the second game in the \"Catan Histories\" series of board games.", "chunk_id": "03c733f6cd0d7d56", "doc_id": "hp_14e68ec60eba2e91"}]</data>
  <data key="d3">["hp_14e68ec60eba2e91"]</data>
  <data key="d4">False</data>
</node>
