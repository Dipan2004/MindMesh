  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An artist who works with others on a musical piece.", "chunk_id": "79f2e927bc5b3f09", "doc_id": "hp_3b9acbbdcc47f797"}]</data>
  <data key="d2">[{"text": "The latter includes six promotional singles, three singles as a collaborative artist, and five singles as a featured artist.", "chunk_id": "79f2e927bc5b3f09", "doc_id": "hp_3b9acbbdcc47f797"}]</data>
  <data key="d3">["hp_3b9acbbdcc47f797"]</data>
