  <data key="d0">PRODUCT</data>
  <data key="d1">[{"text": "A type of rechargeable battery that relies on lithium ions for its operation.", "chunk_id": "51ed4dfb52cf2e60", "doc_id": "hp_5df9f2d47c876b64"}]</data>
  <data key="d2">[{"text": "The Tesla Gigafactory 1 is an operational lithium-ion battery factory under construction, primarily for Tesla Inc., at the Tahoe Reno Industrial Center (TRIC) in Storey County (near the Community of Clark, Nevada, US).", "chunk_id": "51ed4dfb52cf2e60", "doc_id": "hp_5df9f2d47c876b64"}]</data>
  <data key="d3">["hp_5df9f2d47c876b64"]</data>
