<node id="academic year of 2010-11">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The academic year when Istanbul Şehir University started its education.", "chunk_id": "c4ae848456d08dbd", "doc_id": "hp_0470400943ee62eb"}]</data>
  <data key="d2">[{"text": "The university started its education in the academic year of 2010-11 at its campus in Altunizade, Üsküdar, following a ceremony held on October 5, 2010 that was attended by then State President Abdullah Gül, Prime Minister Recep Tayyip Erdoğan and Minister of Foreign Affairs Ahmet Davutoğlu.", "chunk_id": "c4ae848456d08dbd", "doc_id": "hp_0470400943ee62eb"}]</data>
  <data key="d3">["hp_0470400943ee62eb"]</data>
  <data key="d4">False</data>
</node>
