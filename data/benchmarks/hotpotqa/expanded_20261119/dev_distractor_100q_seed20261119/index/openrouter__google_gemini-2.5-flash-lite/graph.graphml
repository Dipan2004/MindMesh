  <data key="d2">[{"text": "Donald Neil Kerley (born 20 February 1934 in Barmera, South Australia) is a former Australian rules football player and coach.", "chunk_id": "442043eeaf880949", "doc_id": "hp_fe3fc60bc7758add"}]</data>
