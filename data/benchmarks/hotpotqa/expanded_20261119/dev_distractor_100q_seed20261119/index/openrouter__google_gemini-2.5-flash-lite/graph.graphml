<node id="Jakob Ragaz">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Jakob Ragaz was a Swiss architect known for his work on grand hotels.", "chunk_id": "f08df480ee1f1eb9", "doc_id": "hp_eeeb2d687b105e04"}]</data>
  <data key="d2">[{"text": "Jakob Ragaz (29 September 1846 - 27 May 1922) was a Swiss architect.", "chunk_id": "f08df480ee1f1eb9", "doc_id": "hp_eeeb2d687b105e04"}]</data>
