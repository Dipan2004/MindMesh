<edge source="North Irvington Gardens Historic District" target="National Register of Historic Places">
  <data key="d5">["LISTED_ON"]</data>
  <data key="d6">The North Irvington Gardens Historic District was placed on the National Register of Historic Places.</data>
  <data key="d7">[{"text": "It was placed on the National Register of Historic Places on June 27, 2008.", "chunk_id": "0c32c75514abc0dc", "doc_id": "hp_53c0688141ca0284", "type": "LISTED_ON"}]</data>
  <data key="d8">hp_53c0688141ca0284</data>
</edge>
<edge source="North Irvington Gardens Historic District" target="Irvington Historic District">
  <data key="d5">["LOCATED_NORTH_OF"]</data>
  <data key="d6">The North Irvington Gardens Historic District is located immediately to the north of the Irvington Historic District.</data>
  <data key="d7">[{"text": "It is immediately to the north of the Irvington Historic District, which has been on the National Register since 1987, sharing the same east and west boundaries of the older district (Arlington Avenue and Emerson Avenue, respectively), and extending north to 10th and 11th streets.", "chunk_id": "0c32c75514abc0dc", "doc_id": "hp_53c0688141ca0284", "type": "LOCATED_NORTH_OF"}]</data>
