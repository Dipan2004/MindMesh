<node id="Peruc">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A village close to Prague where the film Lunacy was shot.", "chunk_id": "c947b5f039c20a78", "doc_id": "hp_dfa620b8112ac9e5"}]</data>
  <data key="d2">[{"text": "The film was shot between October 2004 and April 2005, on location in the village of Peruc close to Prague, and in Švankmajer's studio in the village of Knovíz.", "chunk_id": "c947b5f039c20a78", "doc_id": "hp_dfa620b8112ac9e5"}]</data>
  <data key="d3">["hp_dfa620b8112ac9e5"]</data>
  <data key="d4">False</data>
</node>
<node id="Knovíz">
