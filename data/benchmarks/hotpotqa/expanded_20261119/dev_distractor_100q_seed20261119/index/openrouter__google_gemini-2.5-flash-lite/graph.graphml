<node id="Absolutely Fabulous">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A British sitcom.", "chunk_id": "2d1cd752b15a14fe", "doc_id": "hp_323aaf8fc4b0ff2c"}, {"text": "A BBC television sitcom created by, written by and starring Jennifer Saunders.", "chunk_id": "f54971948ab8acd8", "doc_id": "hp_327a998a822bc9e6"}]</data>
  <data key="d2">[{"text": "The fourth series of British sitcom \"Absolutely Fabulous\" premiered on BBC One on 31 August 2001.", "chunk_id": "2d1cd752b15a14fe", "doc_id": "hp_323aaf8fc4b0ff2c"}, {"text": "Absolutely Fabulous, also known as Ab Fab, is a BBC television sitcom created by, written by and starring Jennifer Saunders.", "chunk_id": "f54971948ab8acd8", "doc_id": "hp_327a998a822bc9e6"}]</data>
  <data key="d3">["hp_323aaf8fc4b0ff2c", "hp_327a998a822bc9e6"]</data>
  <data key="d4">False</data>
</node>
