  <data key="d1">[{"text": "A system composed of a black hole and a companion star.", "chunk_id": "b630ca764564e39f", "doc_id": "hp_6ffa173614708165"}]</data>
  <data key="d2">[{"text": "M33 X-7 is a black hole binary system in the galaxy M33.", "chunk_id": "b630ca764564e39f", "doc_id": "hp_6ffa173614708165"}]</data>
