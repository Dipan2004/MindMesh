  <data key="d2">[{"text": "Placed on the National Register of Historic Places in 1976 with a boundary increase that took place in 1992, Center Street features Victorian homes built in the late 19th and early 20th centuries.", "chunk_id": "015a08864b0b59a3", "doc_id": "hp_0fac18ff47357f6d"}]</data>
