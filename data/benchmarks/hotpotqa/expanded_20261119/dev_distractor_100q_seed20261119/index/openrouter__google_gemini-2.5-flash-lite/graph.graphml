  <data key="d2">[{"text": "Reason for retaining Hong Kong 08 is to give the team better preparation of 2008 Olympics Qualification games.", "chunk_id": "0fb0a4062ab720d1", "doc_id": "hp_a2558257c20dfe87"}]</data>
