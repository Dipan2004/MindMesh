<node id="Serenity">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A title under which several comic book stories have been released, set in the fictional universe created for Joss Whedon's \"Firefly\" television series and \"Serenity\" film.", "chunk_id": "cd990647fd5220d8", "doc_id": "hp_c4877bdc7a93f3f4"}]</data>
  <data key="d2">[{"text": "Several comic book stories have been released under the Serenity title, set in the fictional universe created for Joss Whedon's \"Firefly\" television series and \"Serenity\" film, and which are considered canon.", "chunk_id": "cd990647fd5220d8", "doc_id": "hp_c4877bdc7a93f3f4"}]</data>
  <data key="d3">["hp_c4877bdc7a93f3f4"]</data>
  <data key="d4">False</data>
</node>
<node id="Firefly">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A television series created by Joss Whedon, part of a fictional universe that includes \"Serenity\" comics and film.", "chunk_id": "cd990647fd5220d8", "doc_id": "hp_c4877bdc7a93f3f4"}, {"text": "Firefly is a television series created by Joss Whedon.", "chunk_id": "21e926e08f92273a", "doc_id": "hp_e70ef6817d0ab0fa"}]</data>
  <data key="d2">[{"text": "Several comic book stories have been released under the Serenity title, set in the fictional universe created for Joss Whedon's \"Firefly\" television series and \"Serenity\" film, and which are considered canon.", "chunk_id": "cd990647fd5220d8", "doc_id": "hp_c4877bdc7a93f3f4"}, {"text": "He is the founder of Mutant Enemy Productions and co-founder of Bellwether Pictures, and is best known as the creator of the television series \"Buffy the Vampire Slayer\" (1997–2003), \"Angel\" (1999–2004), \"Firefly\" (2002), \"Dollhouse\" (2009–10) and \"Agents of S.H.I.E.L.D.\" (from 2013).", "chunk_id": "21e926e08f92273a", "doc_id": "hp_e70ef6817d0ab0fa"}]</data>
  <data key="d3">["hp_c4877bdc7a93f3f4", "hp_e70ef6817d0ab0fa"]</data>
  <data key="d4">False</data>
</node>
<node id="Serenity film">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A film set in the fictional universe created for Joss Whedon's \"Firefly\" television series, which also has associated comic book stories.", "chunk_id": "cd990647fd5220d8", "doc_id": "hp_c4877bdc7a93f3f4"}]</data>
  <data key="d2">[{"text": "Several comic book stories have been released under the Serenity title, set in the fictional universe created for Joss Whedon's \"Firefly\" television series and \"Serenity\" film, and which are considered canon.", "chunk_id": "cd990647fd5220d8", "doc_id": "hp_c4877bdc7a93f3f4"}]</data>
  <data key="d3">["hp_c4877bdc7a93f3f4"]</data>
  <data key="d4">False</data>
</node>
<node id="Those Left Behind">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The first miniseries of \"Serenity\" comics, written by Joss Whedon and Brett Matthews, and illustrated by Will Conrad.", "chunk_id": "cd990647fd5220d8", "doc_id": "hp_c4877bdc7a93f3f4"}]</data>
  <data key="d2">[{"text": "Written by Joss Whedon and Brett Matthews, and illustrated by Will Conrad, the first miniseries, \"Those Left Behind\", was created as a bridge between the events of the series and film.", "chunk_id": "cd990647fd5220d8", "doc_id": "hp_c4877bdc7a93f3f4"}]</data>
  <data key="d3">["hp_c4877bdc7a93f3f4"]</data>
  <data key="d4">False</data>
</node>
<node id="Brett Matthews">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Co-writer of the \"Serenity\" comic miniseries \"Those Left Behind\".", "chunk_id": "cd990647fd5220d8", "doc_id": "hp_c4877bdc7a93f3f4"}]</data>
  <data key="d2">[{"text": "Written by Joss Whedon and Brett Matthews, and illustrated by Will Conrad, the first miniseries, \"Those Left Behind\", was created as a bridge between the events of the series and film.", "chunk_id": "cd990647fd5220d8", "doc_id": "hp_c4877bdc7a93f3f4"}]</data>
  <data key="d3">["hp_c4877bdc7a93f3f4"]</data>
