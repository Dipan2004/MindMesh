  <data key="d5">["TARGETED_BY"]</data>
  <data key="d6">The Capture of St Lucia was an event aimed at capturing the island of St. Lucia.</data>
  <data key="d7">[{"text": "The Capture of St Lucia was the result of a campaign by British land and naval forces to capture the island of St Lucia, which was a French Colony.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605", "type": "TARGETED_BY"}]</data>
