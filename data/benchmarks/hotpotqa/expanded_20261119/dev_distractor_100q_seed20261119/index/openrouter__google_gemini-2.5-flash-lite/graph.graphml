<node id="Hobart">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city in Tasmania, Australia, where the Hotel Grand Chancellor is located.", "chunk_id": "c759b172d9ba0764", "doc_id": "hp_992323b5620cfbfd"}]</data>
  <data key="d2">[{"text": "The Hotel Grand Chancellor is a twelve-storey hotel located on the waterfront of Hobart, Tasmania, Australia", "chunk_id": "c759b172d9ba0764", "doc_id": "hp_992323b5620cfbfd"}]</data>
  <data key="d3">["hp_992323b5620cfbfd"]</data>
  <data key="d4">False</data>
</node>
<node id="Tasmania">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A state of Australia, where Hobart is located.", "chunk_id": "c759b172d9ba0764", "doc_id": "hp_992323b5620cfbfd"}, {"text": "Tasmania is a location in Australia where Atherosperma moschatum is native.", "chunk_id": "e1044c549e97de7c", "doc_id": "hp_dce12d59ef968ea1"}, {"text": "Tasmania is an island state of Australia where Fuscospora gunnii is endemic.", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d2">[{"text": "The Hotel Grand Chancellor is a twelve-storey hotel located on the waterfront of Hobart, Tasmania, Australia", "chunk_id": "c759b172d9ba0764", "doc_id": "hp_992323b5620cfbfd"}, {"text": "Atherosperma moschatum, the southern sassafras or blackheart sassafras, is an evergreen tree native to the cool temperate rainforests of Tasmania, Victoria, and New South Wales in Australia.", "chunk_id": "e1044c549e97de7c", "doc_id": "hp_dce12d59ef968ea1"}, {"text": "Fuscospora gunnii, the tanglefoot- or deciduous beech, or fagus, is a deciduous shrub endemic to the highlands of Tasmania, Australia.", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d3">["hp_992323b5620cfbfd", "hp_dce12d59ef968ea1", "hp_f4fcfac633a5b005"]</data>
  <data key="d4">False</data>
</node>
<node id="Sheraton">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The original name of the Hotel Grand Chancellor when it opened in 1987.", "chunk_id": "c759b172d9ba0764", "doc_id": "hp_992323b5620cfbfd"}]</data>
  <data key="d2">[{"text": "The hotel opened in 1987 as the Sheraton and has since been taken over by the Grand Hotels International group.", "chunk_id": "c759b172d9ba0764", "doc_id": "hp_992323b5620cfbfd"}]</data>
  <data key="d3">["hp_992323b5620cfbfd"]</data>
  <data key="d4">False</data>
</node>
