<node id="musical theatre">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A genre of music theatre.", "chunk_id": "f317bf6030b1131e", "doc_id": "hp_a09bf8eaffccdd21"}]</data>
  <data key="d2">[{"text": "Evans has composed and performed music for opera and musical theatre, piano, art songs, prepared piano, choral music, string orchestra and chamber music.", "chunk_id": "f317bf6030b1131e", "doc_id": "hp_a09bf8eaffccdd21"}]</data>
