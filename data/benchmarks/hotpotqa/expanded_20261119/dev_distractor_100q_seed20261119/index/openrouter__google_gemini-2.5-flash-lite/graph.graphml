  <data key="d2">[{"text": "It is a major interchange for TransLink's Southern Region, being an important stop for Logan City Bus Service routes between Brisbane and Loganholme.", "chunk_id": "d45b60b7abaeaa6a", "doc_id": "hp_85a0b49c6ecc4877"}, {"text": "It is part of the Grand Plaza Shopping Centre and is a major interchange for TransLink's Southern Region.", "chunk_id": "6257f1836522b4a7", "doc_id": "hp_888262fe7c1aaa67"}]</data>
