  <data key="d1">[{"text": "Oklahoma is a state in the United States.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}, {"text": "Oklahoma is a state in the United States.", "chunk_id": "e3f12262205bc9b4", "doc_id": "hp_831c6e1412980f7a"}, {"text": "Oklahoma is a state in the United States.", "chunk_id": "06c3adf08bf6725c", "doc_id": "hp_c096d61b038c9025"}]</data>
  <data key="d2">[{"text": "Frederick is a city and county seat of Tillman County, Oklahoma, United States.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}, {"text": "David Lyle Boren (born April 21, 1941) is an American university administrator and politician from the state of Oklahoma.", "chunk_id": "e3f12262205bc9b4", "doc_id": "hp_831c6e1412980f7a"}, {"text": "MidAmerica Industrial Park is Oklahoma's largest industrial park.", "chunk_id": "06c3adf08bf6725c", "doc_id": "hp_c096d61b038c9025"}]</data>
  <data key="d3">["hp_6eb8e4170df0651b", "hp_831c6e1412980f7a", "hp_c096d61b038c9025"]</data>
