  <data key="d7">[{"text": "He served in the Pacific theatre during World War II with the Marine Corps and, after a brief return to the FBI, served as a shooting instructor with the Marine Corps until his retirement in the 1970s.", "chunk_id": "3fc5da1aa653543a", "doc_id": "hp_95e3e85178f2cc76", "type": "SERVED_DURING"}]</data>
