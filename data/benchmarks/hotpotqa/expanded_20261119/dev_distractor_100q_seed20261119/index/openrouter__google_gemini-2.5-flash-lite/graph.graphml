  <data key="d2">[{"text": "Upon the completion of the regular season the 2010 MLS Cup Playoffs culminated on November 21 with a 2–1 victory by the Colorado Rapids over FC Dallas at Toronto's BMO Field.", "chunk_id": "1221adbf4371c7a0", "doc_id": "hp_60e7d9ac9e049733"}, {"text": "MLS Cup 2010, the 15th edition of Major League Soccer's championship match, was played between the Colorado Rapids and FC Dallas to decide the champion of the 2010 season.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}]</data>
  <data key="d3">["hp_60e7d9ac9e049733", "hp_b8c5eba035057a5e"]</data>
