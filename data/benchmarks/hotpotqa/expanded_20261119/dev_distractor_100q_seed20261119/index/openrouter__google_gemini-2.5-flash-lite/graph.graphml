<node id="Bernard Fitzalan-Howard">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The 16th Duke of Norfolk.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981"}, {"text": "The 3rd Baron Howard of Glossop and father of Miles Fitzalan-Howard.", "chunk_id": "8130aa8415f90292", "doc_id": "hp_aa48cba1bf19ae7b"}]</data>
  <data key="d2">[{"text": "In 1975 he also succeeded in the dukedom of Norfolk on the death of his cousin, Bernard Fitzalan-Howard, 16th Duke of Norfolk.", "chunk_id": "c03507c2a0e02f2e", "doc_id": "hp_1eb78b8119e4d981"}, {"text": "He was the eldest son of Bernard Fitzalan-Howard, 3rd Baron Howard of Glossop, and his wife Mona Stapleton, 11th Baroness Beaumont.", "chunk_id": "8130aa8415f90292", "doc_id": "hp_aa48cba1bf19ae7b"}]</data>
