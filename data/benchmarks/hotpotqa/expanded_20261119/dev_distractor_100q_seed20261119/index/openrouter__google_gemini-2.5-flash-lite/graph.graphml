  <data key="d7">[{"text": "The Asno de las Encartaciones , Basque: \"\" , is a breed of small domestic donkey from the western part of the autonomous community of the Basque Country, in north-east Spain.", "chunk_id": "6c5e6325ed3b9eba", "doc_id": "hp_0a88edb8b9162de6", "type": "LOCATED_IN"}]</data>
