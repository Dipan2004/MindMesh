  <data key="d7">[{"text": "Other species such as \"A. pintoi\" are cultivated worldwide as forage and soil conditioner plants, with the leaves providing high-protein feed for grazing livestock and a nitrogen source in agroforestry and permaculture systems.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746", "type": "USED_FOR"}]</data>
