  <data key="d2">[{"text": "\"Canada's Greatest Athlete\", as he billed himself for promotional purposes, was born in Edmonton, Alberta.", "chunk_id": "0118cdaa518de864", "doc_id": "hp_3a771f493056a90e"}]</data>
  <data key="d3">["hp_3a771f493056a90e"]</data>
  <data key="d4">False</data>
</node>
<node id="Bronko Nagurski">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A professional wrestler who was a World Champion before Gene Kiniski.", "chunk_id": "0118cdaa518de864", "doc_id": "hp_3a771f493056a90e"}]</data>
  <data key="d2">[{"text": "Like Bronko Nagurski before him, Kiniski was one of the first World Champions in professional wrestling to have a previous background in football.", "chunk_id": "0118cdaa518de864", "doc_id": "hp_3a771f493056a90e"}]</data>
  <data key="d3">["hp_3a771f493056a90e"]</data>
  <data key="d4">False</data>
</node>
<node id="professional wrestling">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A form of athletic entertainment that Gene Kiniski participated in.", "chunk_id": "0118cdaa518de864", "doc_id": "hp_3a771f493056a90e"}]</data>
  <data key="d2">[{"text": "Like Bronko Nagurski before him, Kiniski was one of the first World Champions in professional wrestling to have a previous background in football.", "chunk_id": "0118cdaa518de864", "doc_id": "hp_3a771f493056a90e"}]</data>
  <data key="d3">["hp_3a771f493056a90e"]</data>
  <data key="d4">False</data>
</node>
<node id="football">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A sport that Gene Kiniski played.", "chunk_id": "0118cdaa518de864", "doc_id": "hp_3a771f493056a90e"}, {"text": "A sport that Tyler Asemota developed a late interest in.", "chunk_id": "21c5f5a9893cff0d", "doc_id": "hp_449285fab9db13ba"}]</data>
  <data key="d2">[{"text": "Like Bronko Nagurski before him, Kiniski was one of the first World Champions in professional wrestling to have a previous background in football.", "chunk_id": "0118cdaa518de864", "doc_id": "hp_3a771f493056a90e"}, {"text": "Asemota found late interest in football during his sophomore year when a football coach approached him during a track meet because of his outstanding blend of height and speed.", "chunk_id": "21c5f5a9893cff0d", "doc_id": "hp_449285fab9db13ba"}]</data>
  <data key="d3">["hp_3a771f493056a90e", "hp_449285fab9db13ba"]</data>
  <data key="d4">False</data>
</node>
<node id="Kelly Kiniski">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The son of Gene Kiniski and a professional wrestler.", "chunk_id": "0118cdaa518de864", "doc_id": "hp_3a771f493056a90e"}]</data>
  <data key="d2">[{"text": "He is the father of professional wrestler Kelly Kiniski and international amateur/professional wrestler Nick Kiniski.", "chunk_id": "0118cdaa518de864", "doc_id": "hp_3a771f493056a90e"}]</data>
  <data key="d3">["hp_3a771f493056a90e"]</data>
  <data key="d4">False</data>
</node>
<node id="Nick Kiniski">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The son of Gene Kiniski and an international amateur/professional wrestler.", "chunk_id": "0118cdaa518de864", "doc_id": "hp_3a771f493056a90e"}]</data>
  <data key="d2">[{"text": "He is the father of professional wrestler Kelly Kiniski and international amateur/professional wrestler Nick Kiniski.", "chunk_id": "0118cdaa518de864", "doc_id": "hp_3a771f493056a90e"}]</data>
  <data key="d3">["hp_3a771f493056a90e"]</data>
