<node id="Wreckorder">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Wreckorder is the debut solo album released by Fran Healy in October 2010.", "chunk_id": "b495da896345a856", "doc_id": "hp_8e3f3120ae8497a2"}, {"text": "The debut solo album from Travis frontman, Fran Healy.", "chunk_id": "02e94c52db8f837e", "doc_id": "hp_d73d23b34d64cf3a"}]</data>
  <data key="d2">[{"text": "Healy released his debut solo album titled \"Wreckorder\" in October 2010, which featured Paul McCartney on bass.", "chunk_id": "b495da896345a856", "doc_id": "hp_8e3f3120ae8497a2"}, {"text": "Wreckorder is the debut solo album from Travis frontman, Fran Healy.", "chunk_id": "02e94c52db8f837e", "doc_id": "hp_d73d23b34d64cf3a"}]</data>
  <data key="d3">["hp_8e3f3120ae8497a2", "hp_d73d23b34d64cf3a"]</data>
  <data key="d4">False</data>
</node>
<node id="Paul McCartney">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Paul McCartney is a musician who featured on Fran Healy's debut solo album 'Wreckorder'.", "chunk_id": "b495da896345a856", "doc_id": "hp_8e3f3120ae8497a2"}, {"text": "A contributor to the album Wreckorder.", "chunk_id": "02e94c52db8f837e", "doc_id": "hp_d73d23b34d64cf3a"}]</data>
  <data key="d2">[{"text": "Healy released his debut solo album titled \"Wreckorder\" in October 2010, which featured Paul McCartney on bass.", "chunk_id": "b495da896345a856", "doc_id": "hp_8e3f3120ae8497a2"}, {"text": "It was produced by Emery Dobyns, with contributions from Paul McCartney, Neko Case and Noah and the Whale's Tom Hobden.", "chunk_id": "02e94c52db8f837e", "doc_id": "hp_d73d23b34d64cf3a"}]</data>
  <data key="d3">["hp_8e3f3120ae8497a2", "hp_d73d23b34d64cf3a"]</data>
  <data key="d4">False</data>
</node>
<node id="Dance">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A song by the American heavy metal band Ratt.", "chunk_id": "73789dfc1fb7d82f", "doc_id": "hp_8e4dbca3117ac40e"}]</data>
  <data key="d2">[{"text": "\"Dance\" is a song by American heavy metal band Ratt.", "chunk_id": "73789dfc1fb7d82f", "doc_id": "hp_8e4dbca3117ac40e"}]</data>
  <data key="d3">["hp_8e4dbca3117ac40e"]</data>
  <data key="d4">False</data>
</node>
<node id="Billboard Top 100">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A music chart that tracks the popularity of songs.", "chunk_id": "73789dfc1fb7d82f", "doc_id": "hp_8e4dbca3117ac40e"}]</data>
  <data key="d2">[{"text": "It reached #59 on the Billboard Top 100.", "chunk_id": "73789dfc1fb7d82f", "doc_id": "hp_8e4dbca3117ac40e"}]</data>
  <data key="d3">["hp_8e4dbca3117ac40e"]</data>
  <data key="d4">False</data>
</node>
<node id="Beau Hill">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The album producer for 'Dancing Undercover' and a songwriter for the song 'Dance'.", "chunk_id": "73789dfc1fb7d82f", "doc_id": "hp_8e4dbca3117ac40e"}]</data>
  <data key="d2">[{"text": "The song was written by Stephen Pearcy, guitarists Robbin Crosby and Warren DeMartini, and album producer Beau Hill.", "chunk_id": "73789dfc1fb7d82f", "doc_id": "hp_8e4dbca3117ac40e"}]</data>
  <data key="d3">["hp_8e4dbca3117ac40e"]</data>
  <data key="d4">False</data>
</node>
<node id="Stand Up Speak Up">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A Europe-wide campaign launched in January 2005 to protest racist incidents in football.", "chunk_id": "5ffaca7aaea4985f", "doc_id": "hp_8e54e49df0cdefb1"}]</data>
  <data key="d2">[{"text": "Stand Up Speak Up was a Europe-wide campaign that was launched in January 2005 by the French Football player Thierry Henry following an increase in reports of racist incidents in football across Europe.", "chunk_id": "5ffaca7aaea4985f", "doc_id": "hp_8e54e49df0cdefb1"}]</data>
  <data key="d3">["hp_8e54e49df0cdefb1"]</data>
  <data key="d4">False</data>
</node>
<node id="January 2005">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The month and year when the Stand Up Speak Up campaign was launched.", "chunk_id": "5ffaca7aaea4985f", "doc_id": "hp_8e54e49df0cdefb1"}]</data>
  <data key="d2">[{"text": "Stand Up Speak Up was a Europe-wide campaign that was launched in January 2005 by the French Football player Thierry Henry following an increase in reports of racist incidents in football across Europe.", "chunk_id": "5ffaca7aaea4985f", "doc_id": "hp_8e54e49df0cdefb1"}]</data>
  <data key="d3">["hp_8e54e49df0cdefb1"]</data>
  <data key="d4">False</data>
</node>
<node id="Thierry Henry">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A French Football player who launched the Stand Up Speak Up campaign.", "chunk_id": "5ffaca7aaea4985f", "doc_id": "hp_8e54e49df0cdefb1"}]</data>
  <data key="d2">[{"text": "Stand Up Speak Up was a Europe-wide campaign that was launched in January 2005 by the French Football player Thierry Henry following an increase in reports of racist incidents in football across Europe.", "chunk_id": "5ffaca7aaea4985f", "doc_id": "hp_8e54e49df0cdefb1"}]</data>
  <data key="d3">["hp_8e54e49df0cdefb1"]</data>
  <data key="d4">False</data>
</node>
<node id="Nike">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A company that partnered with Thierry Henry for the Stand Up Speak Up campaign.", "chunk_id": "5ffaca7aaea4985f", "doc_id": "hp_8e54e49df0cdefb1"}, {"text": "A company that signed Pam Teeguarden as their first woman tennis player.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d2">[{"text": "Together with Nike and other top European players, he protests against this continuing problem inviting football fans to voice their opposition to racism.", "chunk_id": "5ffaca7aaea4985f", "doc_id": "hp_8e54e49df0cdefb1"}, {"text": "Teeguarden was the first woman tennis player signed by Nike.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d3">["hp_8e54e49df0cdefb1", "hp_8e9d4247e8ae3a7a"]</data>
  <data key="d4">False</data>
</node>
<node id="racism">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The prejudice, discrimination, or antagonism directed against someone of a different race based on the belief that one's own race is superior.", "chunk_id": "5ffaca7aaea4985f", "doc_id": "hp_8e54e49df0cdefb1"}]</data>
  <data key="d2">[{"text": "Together with Nike and other top European players, he protests against this continuing problem inviting football fans to voice their opposition to racism.", "chunk_id": "5ffaca7aaea4985f", "doc_id": "hp_8e54e49df0cdefb1"}]</data>
  <data key="d3">["hp_8e54e49df0cdefb1"]</data>
  <data key="d4">False</data>
</node>
<node id="Stanford Research Park">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A technology park located in Palo Alto, California on land owned by Stanford University.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}]</data>
  <data key="d2">[{"text": "Stanford Research Park is a technology park located in Palo Alto, California on land owned by Stanford University.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}]</data>
  <data key="d3">["hp_8e65f4aec073c221"]</data>
  <data key="d4">False</data>
</node>
<node id="Palo Alto">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city in California where Stanford Research Park is located.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}]</data>
  <data key="d2">[{"text": "Stanford Research Park is a technology park located in Palo Alto, California on land owned by Stanford University.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}]</data>
  <data key="d3">["hp_8e65f4aec073c221"]</data>
  <data key="d4">False</data>
</node>
<node id="Stanford Industrial Park">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The original name of Stanford Research Park, built in 1951.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}]</data>
  <data key="d2">[{"text": "Built in 1951, as Stanford Industrial Park, it claims to be the world's first technology-focused office park.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}]</data>
  <data key="d3">["hp_8e65f4aec073c221"]</data>
  <data key="d4">False</data>
</node>
<node id="Frederick Terman">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The person often credited with the idea and success of the Stanford Research Park.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}]</data>
  <data key="d2">[{"text": "Frederick Terman is often credited with the idea and success of the Stanford Research Park, which was the first university-owned industrial park at the time of its founding and played a key role in creation of Silicon Valley.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}]</data>
  <data key="d3">["hp_8e65f4aec073c221"]</data>
  <data key="d4">False</data>
</node>
<node id="Silicon Valley">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A region in Northern California known for its high concentration of technology companies.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}]</data>
  <data key="d2">[{"text": "Frederick Terman is often credited with the idea and success of the Stanford Research Park, which was the first university-owned industrial park at the time of its founding and played a key role in creation of Silicon Valley.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}]</data>
  <data key="d3">["hp_8e65f4aec073c221"]</data>
  <data key="d4">False</data>
</node>
<node id="Varian Associates">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The first tenant of the new Stanford Industrial Park, which relocated to Palo Alto in 1953.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}]</data>
  <data key="d2">[{"text": "In 1953, Varian Associates relocated to Palo Alto to become the first tenant of the new Stanford Industrial Park.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}]</data>
  <data key="d3">["hp_8e65f4aec073c221"]</data>
  <data key="d4">False</data>
</node>
<node id="Hewlett-Packard">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An early tenant of the Stanford Research Park.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}]</data>
  <data key="d2">[{"text": "Early tenants included Hewlett-Packard, General Electric, and Lockheed.", "chunk_id": "8d1ae06c7ff4736d", "doc_id": "hp_8e65f4aec073c221"}]</data>
  <data key="d3">["hp_8e65f4aec073c221"]</data>
  <data key="d4">False</data>
</node>
