  <data key="d2">[{"text": "Tannahill's original song, first published in Robert Archibald Smith's \"Scottish Minstrel\" (1821–24), is about the hills (\"braes\") around Balquhidder near Lochearnhead.", "chunk_id": "1fcb72fd1832f8a4", "doc_id": "hp_7778e88209c46514"}]</data>
