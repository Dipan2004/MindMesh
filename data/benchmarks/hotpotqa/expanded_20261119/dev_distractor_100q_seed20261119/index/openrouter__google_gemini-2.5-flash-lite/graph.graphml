  <data key="d2">[{"text": "Upon the completion of the regular season the 2010 MLS Cup Playoffs culminated on November 21 with a 2–1 victory by the Colorado Rapids over FC Dallas at Toronto's BMO Field.", "chunk_id": "1221adbf4371c7a0", "doc_id": "hp_60e7d9ac9e049733"}, {"text": "The championship was played at BMO Field in Toronto, Ontario, Canada on November 21, 2010.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}]</data>
