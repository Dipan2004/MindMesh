<node id="Soyuz 30">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Soyuz 30 was a Soviet spacecraft.", "chunk_id": "1052cd6d62d88ef8", "doc_id": "hp_3b5753bc4ac12f28"}]</data>
  <data key="d2">[{"text": "He became the first (and to this day remains the only) Polish national in space, when he flew aboard the Soviet Soyuz 30 spacecraft in 1978.", "chunk_id": "1052cd6d62d88ef8", "doc_id": "hp_3b5753bc4ac12f28"}]</data>
