</node>
<node id="The Seasons">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An allegorical ballet in one act, four scenes.", "chunk_id": "9f4586d543bf0949", "doc_id": "hp_01ee629e87903e97"}]</data>
  <data key="d2">[{"text": "The Seasons (Russian: Времена года , \"Vremena goda\"; also French: \"Les saisons\" ) is an allegorical ballet in one act, four scenes, by the choreographer Marius Petipa, with music by Alexander Glazunov, his Op. 67.", "chunk_id": "9f4586d543bf0949", "doc_id": "hp_01ee629e87903e97"}]</data>
  <data key="d3">["hp_01ee629e87903e97"]</data>
  <data key="d4">False</data>
</node>
<node id="Marius Petipa">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The choreographer of the ballet 'The Seasons'.", "chunk_id": "9f4586d543bf0949", "doc_id": "hp_01ee629e87903e97"}, {"text": "Marius Petipa was a successor to Jules Perrot at the Imperial Theatres.", "chunk_id": "b78dcabed6812ef8", "doc_id": "hp_031cfe5a8b4da13f"}]</data>
  <data key="d2">[{"text": "The Seasons (Russian: Времена года , \"Vremena goda\"; also French: \"Les saisons\" ) is an allegorical ballet in one act, four scenes, by the choreographer Marius Petipa, with music by Alexander Glazunov, his Op. 67.", "chunk_id": "9f4586d543bf0949", "doc_id": "hp_01ee629e87903e97"}, {"text": "Pugni went on the compose for Perrot's successors Arthur Saint-Léon and Marius Petipa, serving as the Imperial Theatre's official composer of ballet music until his death in 1870.", "chunk_id": "b78dcabed6812ef8", "doc_id": "hp_031cfe5a8b4da13f"}]</data>
  <data key="d3">["hp_01ee629e87903e97", "hp_031cfe5a8b4da13f"]</data>
  <data key="d4">False</data>
</node>
<node id="Alexander Glazunov">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The composer of the music for the ballet 'The Seasons'.", "chunk_id": "9f4586d543bf0949", "doc_id": "hp_01ee629e87903e97"}, {"text": "Alexander Konstantinovich Glazunov was a Russian composer, music teacher, and conductor of the late Russian Romantic period.", "chunk_id": "e64b24cbe66d981f", "doc_id": "hp_7cda087f9f474c1b"}]</data>
  <data key="d2">[{"text": "The Seasons (Russian: Времена года , \"Vremena goda\"; also French: \"Les saisons\" ) is an allegorical ballet in one act, four scenes, by the choreographer Marius Petipa, with music by Alexander Glazunov, his Op. 67.", "chunk_id": "9f4586d543bf0949", "doc_id": "hp_01ee629e87903e97"}, {"text": "Alexander Konstantinovich Glazunov (Russian: Алекса́ндр Константи́нович Глазуно́в , 10 August 1865 – 21 March 1936) was a Russian composer, music teacher, and conductor of the late Russian Romantic period.", "chunk_id": "e64b24cbe66d981f", "doc_id": "hp_7cda087f9f474c1b"}]</data>
  <data key="d3">["hp_01ee629e87903e97", "hp_7cda087f9f474c1b"]</data>
  <data key="d4">False</data>
</node>
<node id="Op. 67">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The opus number for the music composed by Alexander Glazunov for 'The Seasons'.", "chunk_id": "9f4586d543bf0949", "doc_id": "hp_01ee629e87903e97"}]</data>
  <data key="d2">[{"text": "The Seasons (Russian: Времена года , \"Vremena goda\"; also French: \"Les saisons\" ) is an allegorical ballet in one act, four scenes, by the choreographer Marius Petipa, with music by Alexander Glazunov, his Op. 67.", "chunk_id": "9f4586d543bf0949", "doc_id": "hp_01ee629e87903e97"}]</data>
  <data key="d3">["hp_01ee629e87903e97"]</data>
  <data key="d4">False</data>
</node>
<node id="Imperial Ballet">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The ballet company that first performed 'The Seasons'.", "chunk_id": "9f4586d543bf0949", "doc_id": "hp_01ee629e87903e97"}]</data>
  <data key="d2">[{"text": "The work was composed in 1899 and first performed by the Imperial Ballet in 1900 in St. Petersburg, Russia.", "chunk_id": "9f4586d543bf0949", "doc_id": "hp_01ee629e87903e97"}]</data>
  <data key="d3">["hp_01ee629e87903e97"]</data>
  <data key="d4">False</data>
</node>
<node id="St. Petersburg">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The city in Russia where 'The Seasons' was first performed.", "chunk_id": "9f4586d543bf0949", "doc_id": "hp_01ee629e87903e97"}, {"text": "St. Petersburg is a city in Russia where the Imperial Theatres are located.", "chunk_id": "b78dcabed6812ef8", "doc_id": "hp_031cfe5a8b4da13f"}, {"text": "A city in Russia from which the R23 highway runs.", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d2">[{"text": "The work was composed in 1899 and first performed by the Imperial Ballet in 1900 in St. Petersburg, Russia.", "chunk_id": "9f4586d543bf0949", "doc_id": "hp_01ee629e87903e97"}, {"text": "Pugni is most noted for the ballets he composed for Her Majesty's Theatre in London (1843–1850), and for the Imperial Theatres in St. Petersburg, Russia (1850–1870).", "chunk_id": "b78dcabed6812ef8", "doc_id": "hp_031cfe5a8b4da13f"}, {"text": "Russian route R23 or Pskov Highway Russian: Федера́льная автомоби́льная доро́га Р23 «Псков» is a Russian federal motorway that runs from St.Petersburg through Pskov until the border with Belarus.", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d3">["hp_01ee629e87903e97", "hp_031cfe5a8b4da13f", "hp_11fde9e76326875f"]</data>
  <data key="d4">False</data>
</node>
<node id="Russia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The country where St. Petersburg is located.", "chunk_id": "9f4586d543bf0949", "doc_id": "hp_01ee629e87903e97"}, {"text": "Russia is a country where St. Petersburg is located and where Cesare Pugni worked.", "chunk_id": "b78dcabed6812ef8", "doc_id": "hp_031cfe5a8b4da13f"}, {"text": "A country allied with Austria against the First French Empire.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}, {"text": "A country spanning Eastern Europe and Northern Asia.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d2">[{"text": "The work was composed in 1899 and first performed by the Imperial Ballet in 1900 in St. Petersburg, Russia.", "chunk_id": "9f4586d543bf0949", "doc_id": "hp_01ee629e87903e97"}, {"text": "Pugni is most noted for the ballets he composed for Her Majesty's Theatre in London (1843–1850), and for the Imperial Theatres in St. Petersburg, Russia (1850–1870).", "chunk_id": "b78dcabed6812ef8", "doc_id": "hp_031cfe5a8b4da13f"}, {"text": "The Battle of Amstetten was a minor engagement during the War of the Third Coalition between the First French Empire and the alliance of Austria and Russia.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}, {"text": "The Baikal Nature Reserve ( ; Russian: Байка́льский запове́дник , \"Baikalski Zapovednik\") is a nature reserve on the southeast shore of Lake Baikal, in southern Buryatia, Russia.", "chunk_id": "95a3fc62833d3b04", "doc_id": "hp_acf14927bc123f83"}]</data>
  <data key="d3">["hp_01ee629e87903e97", "hp_031cfe5a8b4da13f", "hp_1fde0cb754789706", "hp_acf14927bc123f83"]</data>
  <data key="d4">False</data>
</node>
