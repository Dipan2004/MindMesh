  <data key="d7">[{"text": "Wanding Border Economic Cooperation Zone (WTBECZ) is a Chinese State Council-approved Industrial Park based in Wanding Town, Ruili City, Dehong Prefecture, Yunnan, China, founded in 1992 and was established to promote trade between China and Myanmar.", "chunk_id": "f6e0ca7c3e63f550", "doc_id": "hp_0e1b00a3eeabb9ce", "type": "LOCATED_IN"}]</data>
