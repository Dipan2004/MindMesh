  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">Castor Rock is located south of Vindication Island.</data>
  <data key="d7">[{"text": "This rock, with its neighbor Castor Rock, was named \"Castor and Pollux\" during the survey of these islands from \"RRS Discovery II\" in 1930.", "chunk_id": "5492b7c1b1697966", "doc_id": "hp_bd3863e9ad3c06bc", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_bd3863e9ad3c06bc</data>
</edge>
<edge source="Castor Rock" target="South Sandwich Islands">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">Castor Rock is part of the South Sandwich Islands.</data>
  <data key="d7">[{"text": "This rock, with its neighbor Castor Rock, was named \"Castor and Pollux\" during the survey of these islands from \"RRS Discovery II\" in 1930.", "chunk_id": "5492b7c1b1697966", "doc_id": "hp_bd3863e9ad3c06bc", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_bd3863e9ad3c06bc</data>
