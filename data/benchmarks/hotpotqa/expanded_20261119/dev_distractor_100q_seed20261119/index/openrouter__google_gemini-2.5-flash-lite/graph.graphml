  <data key="d1">[{"text": "A billionaire genius who marries Tasha.", "chunk_id": "ddba7c8ee8c2f4a2", "doc_id": "hp_f788a91a3c89341c"}]</data>
  <data key="d2">[{"text": "It focuses on the life of teenager Leo Dooley, whose mother, Tasha, marries billionaire genius Donald Davenport.", "chunk_id": "ddba7c8ee8c2f4a2", "doc_id": "hp_f788a91a3c89341c"}]</data>
  <data key="d3">["hp_f788a91a3c89341c"]</data>
  <data key="d4">False</data>
</node>
<node id="Adam">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "One of three bionic superhumans Leo Dooley meets.", "chunk_id": "ddba7c8ee8c2f4a2", "doc_id": "hp_f788a91a3c89341c"}]</data>
  <data key="d2">[{"text": "He meets Adam, Bree, and Chase, three bionic superhumans, with whom he develops an immediate friendship.", "chunk_id": "ddba7c8ee8c2f4a2", "doc_id": "hp_f788a91a3c89341c"}]</data>
  <data key="d3">["hp_f788a91a3c89341c"]</data>
