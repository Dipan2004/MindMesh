<node id="U-boats">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "German submarines.", "chunk_id": "c88e8c3532f53397", "doc_id": "hp_1ac7b848b0417759"}]</data>
  <data key="d2">[{"text": "Two U-boats were damaged during the attacks.", "chunk_id": "c88e8c3532f53397", "doc_id": "hp_1ac7b848b0417759"}]</data>
  <data key="d3">["hp_1ac7b848b0417759"]</data>
