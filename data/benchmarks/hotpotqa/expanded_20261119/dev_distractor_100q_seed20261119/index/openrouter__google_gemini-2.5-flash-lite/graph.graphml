  <data key="d7">[{"text": "He was also the runner-up at 2005 Hamburg Masters and Canada Masters in 2006 and 2012, a semi-finalist at the 2007 Wimbledon Championships and 2013 US Open and a bronze medallist in men's doubles with Julien Benneteau at the 2012 London Olympics.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c", "type": "WAS_RUNNER_UP_AT"}]</data>
