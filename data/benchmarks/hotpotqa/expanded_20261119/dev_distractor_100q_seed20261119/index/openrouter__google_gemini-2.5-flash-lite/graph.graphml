<edge source="Bernard Fitzalan-Howard, 16th Duke of Norfolk" target="Henry Fitzalan-Howard, 15th Duke of Norfolk">
  <data key="d5">["PARENT_OF"]</data>
  <data key="d6">Henry Fitzalan-Howard was the father of Bernard Fitzalan-Howard.</data>
  <data key="d7">[{"text": "He was the eldest surviving son of Henry Fitzalan-Howard, 15th Duke of Norfolk, who died when Bernard was only 9 years old.", "chunk_id": "004e4fd012a54ec8", "doc_id": "hp_4f583d3862c645a8", "type": "PARENT_OF"}]</data>
