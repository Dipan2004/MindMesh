  <data key="d2">[{"text": "Welch decided to name the song \"What the Water Gave Me\" after seeing a Frida Kahlo painting of the same name.", "chunk_id": "4a33b3fb6c1ee1fa", "doc_id": "hp_7804b34667739a36"}]</data>
