<node id="Gimmigela Chuli">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Gimmigela Chuli, also known as The Twins, is a mountain in the Himalayas.", "chunk_id": "739d8f7ea6dfb06f", "doc_id": "hp_3fe42c6ffa4f5604"}]</data>
  <data key="d2">[{"text": "Gimmigela Chuli, or The Twins, is a mountain in the Himalayas, located on the border between Taplejung, Mechi, Nepal and Sikkim, India.", "chunk_id": "739d8f7ea6dfb06f", "doc_id": "hp_3fe42c6ffa4f5604"}]</data>
  <data key="d3">["hp_3fe42c6ffa4f5604"]</data>
