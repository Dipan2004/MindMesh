<node id="1999 Reading Festival">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 1999 Reading Festival is an event where the band Bloc Party was formed.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
  <data key="d2">[{"text": "The band was formed at the 1999 Reading Festival by Okereke and Lissack.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
  <data key="d3">["hp_69c70a8b17b9692e"]</data>
  <data key="d4">False</data>
</node>
<node id="NME">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "NME is a magazine where Gordon Moakes answered an advert to join Bloc Party.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
  <data key="d2">[{"text": "Moakes joined the band after answering an advert in \"NME\" magazine, while Tong was picked via an audition.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
  <data key="d3">["hp_69c70a8b17b9692e"]</data>
  <data key="d4">False</data>
</node>
<node id="Steve Lamacq">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Steve Lamacq is a BBC Radio 1 DJ who received a demo from Bloc Party.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
  <data key="d2">[{"text": "Bloc Party got their break by giving BBC Radio 1 DJ Steve Lamacq and Franz Ferdinand's lead singer, Alex Kapranos, a copy of their demo \"She's Hearing Voices\".", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
  <data key="d3">["hp_69c70a8b17b9692e"]</data>
  <data key="d4">False</data>
</node>
<node id="Franz Ferdinand">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Franz Ferdinand is a band whose lead singer, Alex Kapranos, received a demo from Bloc Party.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}, {"text": "Franz Ferdinand is a band associated with Alex Kapranos.", "chunk_id": "161799124afdf1e1", "doc_id": "hp_6a39ea6d8c8a05f8"}, {"text": "A band that Alex Kapranos is a part of.", "chunk_id": "f0e4892b3b37bba4", "doc_id": "hp_7cc233817d9e07c7"}]</data>
  <data key="d2">[{"text": "Bloc Party got their break by giving BBC Radio 1 DJ Steve Lamacq and Franz Ferdinand's lead singer, Alex Kapranos, a copy of their demo \"She's Hearing Voices\".", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}, {"text": "BNQT (pronounced banquet ( ) is an indie super-group featuring Fran Healy (Travis), Alex Kapranos (Franz Ferdinand), Eric Pulido (Midlake), Ben Bridwell (Band of Horses) and Jason Lytle (Grandaddy), backed by other members of Midlake; Jesse Chandler, Joey McClellan and McKenzie Smith.", "chunk_id": "161799124afdf1e1", "doc_id": "hp_6a39ea6d8c8a05f8"}, {"text": "Volume 1 is the debut studio album by indie super-group BNQT, lead by Eric Pulido (Midlake) with Ben Bridwell (Band of Horses), Alex Kapranos (Franz Ferdinand), Fran Healy (Travis) and Jason Lytle (Grandaddy), backed by the other members of Midlake.", "chunk_id": "f0e4892b3b37bba4", "doc_id": "hp_7cc233817d9e07c7"}]</data>
  <data key="d3">["hp_69c70a8b17b9692e", "hp_6a39ea6d8c8a05f8", "hp_7cc233817d9e07c7"]</data>
  <data key="d4">False</data>
</node>
<node id="Alex Kapranos">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Alex Kapranos is the lead singer of Franz Ferdinand who received a demo from Bloc Party.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}, {"text": "Alex Kapranos is a member of the indie super-group BNQT and is associated with Franz Ferdinand.", "chunk_id": "161799124afdf1e1", "doc_id": "hp_6a39ea6d8c8a05f8"}, {"text": "A member of the indie super-group BNQT.", "chunk_id": "f0e4892b3b37bba4", "doc_id": "hp_7cc233817d9e07c7"}]</data>
  <data key="d2">[{"text": "Bloc Party got their break by giving BBC Radio 1 DJ Steve Lamacq and Franz Ferdinand's lead singer, Alex Kapranos, a copy of their demo \"She's Hearing Voices\".", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}, {"text": "BNQT (pronounced banquet ( ) is an indie super-group featuring Fran Healy (Travis), Alex Kapranos (Franz Ferdinand), Eric Pulido (Midlake), Ben Bridwell (Band of Horses) and Jason Lytle (Grandaddy), backed by other members of Midlake; Jesse Chandler, Joey McClellan and McKenzie Smith.", "chunk_id": "161799124afdf1e1", "doc_id": "hp_6a39ea6d8c8a05f8"}, {"text": "Volume 1 is the debut studio album by indie super-group BNQT, lead by Eric Pulido (Midlake) with Ben Bridwell (Band of Horses), Alex Kapranos (Franz Ferdinand), Fran Healy (Travis) and Jason Lytle (Grandaddy), backed by the other members of Midlake.", "chunk_id": "f0e4892b3b37bba4", "doc_id": "hp_7cc233817d9e07c7"}]</data>
