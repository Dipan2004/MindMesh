  <data key="d2">[{"text": "Xóchitl Guadalupe Hamada Villarreal (born May 1, 1970) is a semi-retired Japanese-Mexican, \"Luchadora\", or professional wrestler.", "chunk_id": "beab562ef9fe8887", "doc_id": "hp_e53c480ef8a45aab"}]</data>
