<node id="Ura Primary School">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A primary school attended by Karma Phuntsho.", "chunk_id": "a871fb84038a99a1", "doc_id": "hp_e30d91b396b0e3e8"}]</data>
