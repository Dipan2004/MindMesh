  <data key="d2">[{"text": "He was educated at King Edward VI School Retford and Leeds University and was initially a civil servant.", "chunk_id": "2d54d3fa9439ab8e", "doc_id": "hp_e808a689dfcac703"}]</data>
  <data key="d3">["hp_e808a689dfcac703"]</data>
