<edge source="The Seasons" target="St. Petersburg">
  <data key="d5">["FIRST_PERFORMED_IN"]</data>
  <data key="d6">'The Seasons' was first performed in St. Petersburg.</data>
  <data key="d7">[{"text": "The work was composed in 1899 and first performed by the Imperial Ballet in 1900 in St. Petersburg, Russia.", "chunk_id": "9f4586d543bf0949", "doc_id": "hp_01ee629e87903e97", "type": "FIRST_PERFORMED_IN"}]</data>
