  <data key="d2">[{"text": "Surōn to Makuhēru no Nazo no Sutōrī (スローンとマクヘールの謎の物語 , \"Paul Sloane and Des MacHale's Intriguing Tales\") is based on the concept of lateral thinking puzzles, books authored by Paul Sloane and Des MacHale.", "chunk_id": "a5fa71ec4370bfe1", "doc_id": "hp_94fc8885003296ef"}]</data>
  <data key="d3">["hp_94fc8885003296ef"]</data>
