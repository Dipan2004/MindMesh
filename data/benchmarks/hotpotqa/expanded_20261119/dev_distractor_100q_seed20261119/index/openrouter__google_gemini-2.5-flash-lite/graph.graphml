  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The title of the Dancing on Ice franchise in Australia.", "chunk_id": "11198ab313088443", "doc_id": "hp_d35c5fabe367cde8"}]</data>
  <data key="d2">[{"text": "In Australia, where it was titled \"Torvill and Dean's Dancing on Ice\", it was axed after just one series owing to production costs.", "chunk_id": "11198ab313088443", "doc_id": "hp_d35c5fabe367cde8"}]</data>
  <data key="d3">["hp_d35c5fabe367cde8"]</data>
  <data key="d4">False</data>
</node>
<node id="Glasshouse">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A cultural and entertainment centre in Port Macquarie.", "chunk_id": "203bcd26d9746ba7", "doc_id": "hp_d399c5634a0f3001"}]</data>
  <data key="d2">[{"text": "The dismissal of the Port Macquarie-Hastings Council on 27 February 2008 marked the end of a series of events involving a project which was initiated in 2001 in the New South Wales coastal town of Port Macquarie to build a cultural and entertainment centre, known to locals as the Glasshouse.", "chunk_id": "203bcd26d9746ba7", "doc_id": "hp_d399c5634a0f3001"}]</data>
  <data key="d3">["hp_d399c5634a0f3001"]</data>
  <data key="d4">False</data>
</node>
<node id="Port Central">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A neighbouring shopping centre to the Glasshouse project.", "chunk_id": "203bcd26d9746ba7", "doc_id": "hp_d399c5634a0f3001"}]</data>
  <data key="d2">[{"text": "The project, initially a joint venture with the management of the neighbouring shopping centre, Port Central, was originally expected to cost the Council A$ 7.3 million.", "chunk_id": "203bcd26d9746ba7", "doc_id": "hp_d399c5634a0f3001"}]</data>
  <data key="d3">["hp_d399c5634a0f3001"]</data>
  <data key="d4">False</data>
</node>
<node id="Conservation Technician">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Conservation Technician is a specialist trained in basic conservation methods for cultural property.", "chunk_id": "8006a94cf8cc9435", "doc_id": "hp_d3a20c2bbaf8ef60"}]</data>
  <data key="d2">[{"text": "A Conservation Technician is a specialist who is trained in basic conservation methods pertaining to cultural property and may work in museums or public or private conservation organizations.", "chunk_id": "8006a94cf8cc9435", "doc_id": "hp_d3a20c2bbaf8ef60"}]</data>
  <data key="d3">["hp_d3a20c2bbaf8ef60"]</data>
  <data key="d4">False</data>
</node>
<node id="cultural property">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Cultural property refers to items of artistic, historical, or archaeological significance.", "chunk_id": "8006a94cf8cc9435", "doc_id": "hp_d3a20c2bbaf8ef60"}]</data>
  <data key="d2">[{"text": "A Conservation Technician is a specialist who is trained in basic conservation methods pertaining to cultural property and may work in museums or public or private conservation organizations.", "chunk_id": "8006a94cf8cc9435", "doc_id": "hp_d3a20c2bbaf8ef60"}]</data>
  <data key="d3">["hp_d3a20c2bbaf8ef60"]</data>
  <data key="d4">False</data>
</node>
<node id="museums">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Museums are institutions dedicated to the acquisition, preservation, study, and exhibition of works of artistic, cultural, or scientific significance.", "chunk_id": "8006a94cf8cc9435", "doc_id": "hp_d3a20c2bbaf8ef60"}]</data>
  <data key="d2">[{"text": "A Conservation Technician is a specialist who is trained in basic conservation methods pertaining to cultural property and may work in museums or public or private conservation organizations.", "chunk_id": "8006a94cf8cc9435", "doc_id": "hp_d3a20c2bbaf8ef60"}]</data>
  <data key="d3">["hp_d3a20c2bbaf8ef60"]</data>
  <data key="d4">False</data>
</node>
<node id="public or private conservation organizations">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "These are entities that focus on the preservation and restoration of cultural heritage.", "chunk_id": "8006a94cf8cc9435", "doc_id": "hp_d3a20c2bbaf8ef60"}]</data>
  <data key="d2">[{"text": "A Conservation Technician is a specialist who is trained in basic conservation methods pertaining to cultural property and may work in museums or public or private conservation organizations.", "chunk_id": "8006a94cf8cc9435", "doc_id": "hp_d3a20c2bbaf8ef60"}]</data>
  <data key="d3">["hp_d3a20c2bbaf8ef60"]</data>
  <data key="d4">False</data>
</node>
<node id="conservator">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A conservator is a professional responsible for the preservation and restoration of cultural heritage.", "chunk_id": "8006a94cf8cc9435", "doc_id": "hp_d3a20c2bbaf8ef60"}]</data>
  <data key="d2">[{"text": "Typically an individual may work with or be subordinate to a conservator.", "chunk_id": "8006a94cf8cc9435", "doc_id": "hp_d3a20c2bbaf8ef60"}]</data>
  <data key="d3">["hp_d3a20c2bbaf8ef60"]</data>
  <data key="d4">False</data>
</node>
<node id="registrar (museum)">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A registrar in a museum is responsible for managing the collection's records and movement.", "chunk_id": "8006a94cf8cc9435", "doc_id": "hp_d3a20c2bbaf8ef60"}]</data>
  <data key="d2">[{"text": "A technician may also work in conjunction with other collection staff, such as a registrar (museum) or collection manager.", "chunk_id": "8006a94cf8cc9435", "doc_id": "hp_d3a20c2bbaf8ef60"}]</data>
  <data key="d3">["hp_d3a20c2bbaf8ef60"]</data>
  <data key="d4">False</data>
</node>
<node id="collection manager">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A collection manager oversees the care, documentation, and organization of a collection.", "chunk_id": "8006a94cf8cc9435", "doc_id": "hp_d3a20c2bbaf8ef60"}]</data>
  <data key="d2">[{"text": "A technician may also work in conjunction with other collection staff, such as a registrar (museum) or collection manager.", "chunk_id": "8006a94cf8cc9435", "doc_id": "hp_d3a20c2bbaf8ef60"}]</data>
  <data key="d3">["hp_d3a20c2bbaf8ef60"]</data>
  <data key="d4">False</data>
</node>
<node id="Gibraltar Point national nature reserve">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Gibraltar Point national nature reserve is an area of approximately 4.3 km2 in Lincolnshire, England.", "chunk_id": "a241395280ad7f2b", "doc_id": "hp_d424c14b2a283420"}]</data>
  <data key="d2">[{"text": "Gibraltar Point national nature reserve is an area of approximately 4.3 km2 in Lincolnshire, England.", "chunk_id": "a241395280ad7f2b", "doc_id": "hp_d424c14b2a283420"}]</data>
  <data key="d3">["hp_d424c14b2a283420"]</data>
  <data key="d4">False</data>
</node>
<node id="Oceanside, California">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city in California where Phil Edwards is from.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
  <data key="d2">[{"text": "Philip (\"Phil\") Edwards (born June 10, 1938) is an American surfer from Oceanside, California.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
  <data key="d3">["hp_d425f0e62b7587a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Banzai pipeline">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A famous surfing spot in Hawaii.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
  <data key="d2">[{"text": "He is credited with being the first to surf the Banzai pipeline in Hawaii, being the first professional surfer, and creating the first signature surf board.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
  <data key="d3">["hp_d425f0e62b7587a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Hawaii">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A US state where the Banzai pipeline is located.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
  <data key="d2">[{"text": "He is credited with being the first to surf the Banzai pipeline in Hawaii, being the first professional surfer, and creating the first signature surf board.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
  <data key="d3">["hp_d425f0e62b7587a7"]</data>
  <data key="d4">False</data>
</node>
<node id="first professional surfer">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The designation for the first individual to engage in surfing as a profession.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
  <data key="d2">[{"text": "He is credited with being the first to surf the Banzai pipeline in Hawaii, being the first professional surfer, and creating the first signature surf board.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
  <data key="d3">["hp_d425f0e62b7587a7"]</data>
  <data key="d4">False</data>
</node>
<node id="first signature surf board">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "The initial surfboard designed with a professional surfer's endorsement or branding.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
  <data key="d2">[{"text": "He is credited with being the first to surf the Banzai pipeline in Hawaii, being the first professional surfer, and creating the first signature surf board.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
  <data key="d3">["hp_d425f0e62b7587a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Bruce Brown films">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A collection of films directed or produced by Bruce Brown, featuring surfing.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
  <data key="d2">[{"text": "Edwards was also featured prominently in the Bruce Brown films \"The Endless Summer\" and before that \"Surfing Hollow Days\" which featured the first film footage of Pipeline.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
  <data key="d3">["hp_d425f0e62b7587a7"]</data>
  <data key="d4">False</data>
</node>
<node id="The Endless Summer">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A film by Bruce Brown that prominently featured Phil Edwards.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
  <data key="d2">[{"text": "Edwards was also featured prominently in the Bruce Brown films \"The Endless Summer\" and before that \"Surfing Hollow Days\" which featured the first film footage of Pipeline.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7"}]</data>
