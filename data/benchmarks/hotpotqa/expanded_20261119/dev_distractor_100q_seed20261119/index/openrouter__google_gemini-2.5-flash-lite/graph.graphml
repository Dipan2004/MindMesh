  <data key="d7">[{"text": "New York City Ballet (NYCB) is a ballet company founded in 1948 by choreographer George Balanchine and Lincoln Kirstein.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac", "type": "FOUNDED_BY"}, {"text": "Balanchine and Jerome Robbins are considered the founding choreographers of the company.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac", "type": "FOUNDING_CHOREOGRAPHER_OF"}]</data>
