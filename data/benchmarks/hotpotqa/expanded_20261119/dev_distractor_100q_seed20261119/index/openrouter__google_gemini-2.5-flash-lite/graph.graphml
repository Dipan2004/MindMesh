  <data key="d2">[{"text": "The highway runs south of Odintsovo, Kubinka, Mozhaysk, Gagarin, north of Vyazma, through Safonovo and Yartsevo.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}]</data>
