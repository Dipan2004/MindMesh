  <data key="d7">[{"text": "Teatro Giuseppe Verdi (the Giuseppe Verdi Theatre) is a small opera house located in a wing of the Rocca dei Marchesi Pallavicino on the Piazza Giuseppe Verdi in Busseto, Italy, a town closely associated with the life of the opera composer, Giuseppe Verdi.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159", "type": "LOCATED_IN"}]</data>
