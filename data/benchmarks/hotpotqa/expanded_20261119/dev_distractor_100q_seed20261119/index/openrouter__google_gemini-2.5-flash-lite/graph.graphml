  <data key="d7">[{"text": "Harry Robbins \"Bob\" Haldeman (October 27, 1926 – November 12, 1993) was an American political aide and businessman, best known for his service as White House Chief of Staff to President Richard Nixon and his consequent involvement in the Watergate Affair.", "chunk_id": "f87cc652bb7badbf", "doc_id": "hp_49a0bee4f2c64271", "type": "WORKS_AT"}]</data>
