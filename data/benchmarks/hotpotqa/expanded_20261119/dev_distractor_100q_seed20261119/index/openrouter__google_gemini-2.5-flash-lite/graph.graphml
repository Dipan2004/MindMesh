<node id="Kelly Evernden">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A tennis player who lost to Daniel C. Goldie at Wimbledon in 1989.", "chunk_id": "f3bc6bdeb3b7f477", "doc_id": "hp_ce1cd3eb59940b9f"}]</data>
  <data key="d2">[{"text": "The right-hander reached the quarterfinals of Wimbledon in 1989 where he beat Kelly Evernden, Jimmy Connors, Wally Masur and Slobodan Živojinović before losing to Ivan Lendl.", "chunk_id": "f3bc6bdeb3b7f477", "doc_id": "hp_ce1cd3eb59940b9f"}]</data>
  <data key="d3">["hp_ce1cd3eb59940b9f"]</data>
