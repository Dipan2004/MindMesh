  <data key="d7">[{"text": "Military Attack (Chinese: 軍事出擊, originally named Rave) (foaled 4 March 2008) is an Irish-bred, Hong Kong trained Thoroughbred racehorse.", "chunk_id": "4f018bc3fcafe69c", "doc_id": "hp_9e4b0099b07c257e", "type": "TRAINED_IN"}, {"text": "Unraced as a two-year-old he showed promising form in Britain in 2011 before being sold to race in Hong Kong.", "chunk_id": "4f018bc3fcafe69c", "doc_id": "hp_9e4b0099b07c257e", "type": "RACED_IN"}]</data>
