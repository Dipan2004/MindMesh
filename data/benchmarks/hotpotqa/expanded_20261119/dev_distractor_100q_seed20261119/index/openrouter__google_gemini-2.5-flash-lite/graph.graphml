<node id="Tower of London">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A historic castle located on the north bank of the River Thames in central London.", "chunk_id": "00e6b97039cae14c", "doc_id": "hp_2921be96b466f689"}]</data>
  <data key="d2">[{"text": "Outrage!, \"the official Tower of London board game\", was first created in 1992 by Imperial Games.", "chunk_id": "00e6b97039cae14c", "doc_id": "hp_2921be96b466f689"}]</data>
  <data key="d3">["hp_2921be96b466f689"]</data>
  <data key="d4">False</data>
</node>
<node id="Imperial Games">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The company that created the board game Outrage!.", "chunk_id": "00e6b97039cae14c", "doc_id": "hp_2921be96b466f689"}]</data>
  <data key="d2">[{"text": "Outrage!, \"the official Tower of London board game\", was first created in 1992 by Imperial Games.", "chunk_id": "00e6b97039cae14c", "doc_id": "hp_2921be96b466f689"}]</data>
  <data key="d3">["hp_2921be96b466f689"]</data>
  <data key="d4">False</data>
</node>
<node id="British Crown Jewels">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The jewels that are part of the regalia of the British monarchy.", "chunk_id": "00e6b97039cae14c", "doc_id": "hp_2921be96b466f689"}]</data>
  <data key="d2">[{"text": "Players move about the board, which depicts the Tower of London, and attempt to steal the British Crown Jewels.", "chunk_id": "00e6b97039cae14c", "doc_id": "hp_2921be96b466f689"}]</data>
  <data key="d3">["hp_2921be96b466f689"]</data>
  <data key="d4">False</data>
</node>
<node id="Thomas Blood">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A historical figure who attempted to steal the British Crown Jewels.", "chunk_id": "00e6b97039cae14c", "doc_id": "hp_2921be96b466f689"}]</data>
  <data key="d2">[{"text": "In reality, the only modern attempt to steal the Jewels was made in 1671 by Thomas Blood and his accomplices, who failed to escape — an earlier attempt in the early fourteenth century was equally unsuccessful — and the game challenges players to “succeed where they failed.”", "chunk_id": "00e6b97039cae14c", "doc_id": "hp_2921be96b466f689"}]</data>
  <data key="d3">["hp_2921be96b466f689"]</data>
  <data key="d4">False</data>
</node>
<node id="High Street">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A station on the IND Eighth Avenue Line of the New York City Subway.", "chunk_id": "f564de04eff9c006", "doc_id": "hp_29d27b461a953733"}, {"text": "High Street is one of the main thoroughfares and shopping areas in the city centre of Sheffield.", "chunk_id": "7ad43fdb3c803322", "doc_id": "hp_a76877312504b02e"}, {"text": "High Street is a street located in Middletown, which was a prestigious residential area in the 19th century.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}, {"text": "The main street running through the City of Fremantle, Western Australia.", "chunk_id": "34f8dc09ce1efd26", "doc_id": "hp_bf059be871a724bc"}, {"text": "A street in Belfast under which the River Farset is now contained within a tunnel.", "chunk_id": "ffad64e807ea3b1b", "doc_id": "hp_cc911f866aa0efaa"}, {"text": "A street in Westwood, Massachusetts, that is part of the Fisher School–High Street Historic District.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}, {"text": "A long shopping high street in Lincoln, England, identified by the road number B1262.", "chunk_id": "efe0b69c1de30aee", "doc_id": "hp_e27bc9001091b8b8"}, {"text": "A street in Newport with high street shops, a short walk from Friars Walk.", "chunk_id": "4eee42e99e11960b", "doc_id": "hp_ef8cacebb236ea23"}]</data>
  <data key="d2">[{"text": "High Street, also labeled as High Street–Brooklyn Bridge, and also referred to as \"Brooklyn Bridge Plaza\" and \"Cranberry Street\", is a station on the IND Eighth Avenue Line of the New York City Subway.", "chunk_id": "f564de04eff9c006", "doc_id": "hp_29d27b461a953733"}, {"text": "High Street is one of the main thoroughfares and shopping areas in the city centre of Sheffield in South Yorkshire, England, located at the approximate grid reference of [ SK356874] .", "chunk_id": "7ad43fdb3c803322", "doc_id": "hp_a76877312504b02e"}, {"text": "The house, at 318 High Street, faces west from the east side of High Street north of the corner at High and Court Streets.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}, {"text": "High Street is the main street running through the City of Fremantle, Western Australia.", "chunk_id": "34f8dc09ce1efd26", "doc_id": "hp_bf059be871a724bc"}, {"text": "The River Farset is now contained within a tunnel under Belfast's High Street; a tunnel supposedly big enough to take a bus.", "chunk_id": "ffad64e807ea3b1b", "doc_id": "hp_cc911f866aa0efaa"}, {"text": "Fisher School–High Street Historic District is a historic district at 748-850; 751-823 High Street in Westwood, Massachusetts.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}, {"text": "The High Street of Lincoln, England, (road number B1262) is a long shopping high street.", "chunk_id": "efe0b69c1de30aee", "doc_id": "hp_e27bc9001091b8b8"}, {"text": "The complex is a short walk from the high street shops of Commercial Street and High Street.", "chunk_id": "4eee42e99e11960b", "doc_id": "hp_ef8cacebb236ea23"}]</data>
  <data key="d3">["hp_29d27b461a953733", "hp_a76877312504b02e", "hp_a8f5a77458dad7ce", "hp_bf059be871a724bc", "hp_cc911f866aa0efaa", "hp_cdf4d14bbc02d78d", "hp_e27bc9001091b8b8", "hp_ef8cacebb236ea23"]</data>
  <data key="d4">False</data>
</node>
