<edge source="Richard Hammond" target="Richard Hammond's Engineering Connections">
  <data key="d5">["PRESENTS"]</data>
  <data key="d6">Richard Hammond is the presenter of the documentary series 'Richard Hammond's Engineering Connections'.</data>
  <data key="d7">[{"text": "It is presented by Richard Hammond, and looks at how engineers and designers use historic inventions and clues from the natural world in ingenious ways to develop new buildings and machines.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d", "type": "PRESENTS"}]</data>
  <data key="d8">hp_8429039f0ec9c01d</data>
</edge>
