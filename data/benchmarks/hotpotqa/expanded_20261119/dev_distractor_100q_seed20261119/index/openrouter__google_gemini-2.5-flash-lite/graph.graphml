  <data key="d2">[{"text": "It is native to eastern North America from Southern Ontario and Illinois eastward to southeastern Massachusetts and Rhode Island, and south to central Florida and Louisiana.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}]</data>
