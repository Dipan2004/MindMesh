  <data key="d2">[{"text": "The Short Fiction of Norman Mailer is a 1967 anthology of short stories by Norman Mailer.", "chunk_id": "d2f75ec874d75b32", "doc_id": "hp_c1e169e36d7f056a"}]</data>
  <data key="d3">["hp_c1e169e36d7f056a"]</data>
