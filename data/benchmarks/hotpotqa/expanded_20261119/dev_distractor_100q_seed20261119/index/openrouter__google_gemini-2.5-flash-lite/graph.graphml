  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "\"Edward Scissorhands\" is a film directed by Tim Burton.", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}]</data>
  <data key="d2">[{"text": "He is also known as Kevin, Winona Ryder's little brother, in Tim Burton's \"Edward Scissorhands\".", "chunk_id": "cd3dc8041fe2ba4b", "doc_id": "hp_23773bc65d0154a3"}]</data>
