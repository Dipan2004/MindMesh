  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A horse race won by Military Attack in early 2013.", "chunk_id": "4f018bc3fcafe69c", "doc_id": "hp_9e4b0099b07c257e"}]</data>
  <data key="d2">[{"text": "He continued to show useful but unexceptional form before emerging as a dominant middle-distance performer in the early part of 2013, winning the January Cup, Hong Kong Gold Cup, Premier Plate, Queen Elizabeth II Cup and Singapore Airlines International Cup.", "chunk_id": "4f018bc3fcafe69c", "doc_id": "hp_9e4b0099b07c257e"}]</data>
  <data key="d3">["hp_9e4b0099b07c257e"]</data>
  <data key="d4">False</data>
</node>
<node id="Hong Kong Jockey Club Champion Awards">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "An awards ceremony where Military Attack won three awards in July 2013.", "chunk_id": "4f018bc3fcafe69c", "doc_id": "hp_9e4b0099b07c257e"}]</data>
  <data key="d2">[{"text": "In July 2013 at the Hong Kong Jockey Club Champion Awards, he won three awards including the title of Hong Kong Horse of the Year.", "chunk_id": "4f018bc3fcafe69c", "doc_id": "hp_9e4b0099b07c257e"}]</data>
  <data key="d3">["hp_9e4b0099b07c257e"]</data>
  <data key="d4">False</data>
</node>
<node id="Hong Kong Horse of the Year">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A title awarded to Military Attack at the Hong Kong Jockey Club Champion Awards in July 2013.", "chunk_id": "4f018bc3fcafe69c", "doc_id": "hp_9e4b0099b07c257e"}]</data>
  <data key="d2">[{"text": "In July 2013 at the Hong Kong Jockey Club Champion Awards, he won three awards including the title of Hong Kong Horse of the Year.", "chunk_id": "4f018bc3fcafe69c", "doc_id": "hp_9e4b0099b07c257e"}]</data>
  <data key="d3">["hp_9e4b0099b07c257e"]</data>
  <data key="d4">False</data>
</node>
<node id="Billy Sandow">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An American professional wrestler and promoter, also known as Wilhelm Baumann.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d2">[{"text": "Wilhelm Baumann (September 4, 1884 – September 15, 1972), better known as Billy Sandow, was an American professional wrestler and promoter.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d3">["hp_9ebd705ad887d9a9"]</data>
  <data key="d4">False</data>
</node>
<node id="Wilhelm Baumann">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The birth name of Billy Sandow, an American professional wrestler and promoter.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d2">[{"text": "Wilhelm Baumann (September 4, 1884 – September 15, 1972), better known as Billy Sandow, was an American professional wrestler and promoter.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d3">["hp_9ebd705ad887d9a9"]</data>
  <data key="d4">False</data>
</node>
<node id="Ed &quot;Strangler&quot; Lewis">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A professional wrestler managed by Billy Sandow.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d2">[{"text": "He is best remembered as the manager of professional wrestler Ed \"Strangler\" Lewis and a subsequent member of the famed Gold Dust Trio promotion that changed the face of the industry during the 1920s (along with Lewis and Joseph \"Toots\" Mondt).", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d3">["hp_9ebd705ad887d9a9"]</data>
  <data key="d4">False</data>
</node>
<node id="Gold Dust Trio">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A famed promotion that changed the face of the wrestling industry during the 1920s, co-founded by Billy Sandow, Ed \"Strangler\" Lewis, and Joseph \"Toots\" Mondt.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d2">[{"text": "He is best remembered as the manager of professional wrestler Ed \"Strangler\" Lewis and a subsequent member of the famed Gold Dust Trio promotion that changed the face of the industry during the 1920s (along with Lewis and Joseph \"Toots\" Mondt).", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d3">["hp_9ebd705ad887d9a9"]</data>
  <data key="d4">False</data>
</node>
<node id="Joseph &quot;Toots&quot; Mondt">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A member of the Gold Dust Trio promotion along with Billy Sandow and Ed \"Strangler\" Lewis.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d2">[{"text": "He is best remembered as the manager of professional wrestler Ed \"Strangler\" Lewis and a subsequent member of the famed Gold Dust Trio promotion that changed the face of the industry during the 1920s (along with Lewis and Joseph \"Toots\" Mondt).", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d3">["hp_9ebd705ad887d9a9"]</data>
  <data key="d4">False</data>
</node>
<node id="Eugen Sandow">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A professional wrestler and strongman in the late 19th century, from whom Billy Sandow may have taken his ring name.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d2">[{"text": "He may have taken his ring name from Eugen Sandow, a professional wrestler and strongman in the late 19th century; in turn, former WWE wrestler Damien Sandow would adopt his own ring name in honor of Sandow almost a century later.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d3">["hp_9ebd705ad887d9a9"]</data>
  <data key="d4">False</data>
</node>
<node id="Damien Sandow">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A former WWE wrestler who adopted his ring name in honor of Eugen Sandow.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d2">[{"text": "He may have taken his ring name from Eugen Sandow, a professional wrestler and strongman in the late 19th century; in turn, former WWE wrestler Damien Sandow would adopt his own ring name in honor of Sandow almost a century later.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d3">["hp_9ebd705ad887d9a9"]</data>
  <data key="d4">False</data>
</node>
<node id="Billy Jenkins">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A wrestling champion managed by Billy Sandow.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d2">[{"text": "Sandow also served as manager for such wrestling champions as Billy Jenkins, Marin Plestina, Jumping Joe Savoldi and Everett Marshall, and also used the ring name The Zebra Kid in 1951.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d3">["hp_9ebd705ad887d9a9"]</data>
  <data key="d4">False</data>
</node>
<node id="Marin Plestina">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A wrestling champion managed by Billy Sandow.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d2">[{"text": "Sandow also served as manager for such wrestling champions as Billy Jenkins, Marin Plestina, Jumping Joe Savoldi and Everett Marshall, and also used the ring name The Zebra Kid in 1951.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d3">["hp_9ebd705ad887d9a9"]</data>
  <data key="d4">False</data>
</node>
