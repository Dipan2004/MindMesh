<node id="Chicago">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Chicago is a city where the Blackdiamondskye tour kicked off.", "chunk_id": "45cede6375eed8fe", "doc_id": "hp_87324daa70fdbf7e"}, {"text": "Chicago is a city in Illinois where Notre Dame High School for Girls was located.", "chunk_id": "e1f93f4fdb5e61f5", "doc_id": "hp_db88fb2791fae586"}]</data>
  <data key="d2">[{"text": "The tour kicked off on September 16 in Chicago and culminated on October 16 in Paradise, Nevada.", "chunk_id": "45cede6375eed8fe", "doc_id": "hp_87324daa70fdbf7e"}, {"text": "Notre Dame High School for Girls was a private, Roman Catholic, all-girls college prep high school in Chicago, Illinois.", "chunk_id": "e1f93f4fdb5e61f5", "doc_id": "hp_db88fb2791fae586"}]</data>
  <data key="d3">["hp_87324daa70fdbf7e", "hp_db88fb2791fae586"]</data>
