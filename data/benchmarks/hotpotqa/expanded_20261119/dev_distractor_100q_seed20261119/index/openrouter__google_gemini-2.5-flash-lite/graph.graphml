  <data key="d2">[{"text": "The main part of the college is located on the Bailey, occupying nine historic buildings at the east end of Durham Cathedral.", "chunk_id": "ff4792dbca147fed", "doc_id": "hp_fd1eb5f63c8bb581"}]</data>
