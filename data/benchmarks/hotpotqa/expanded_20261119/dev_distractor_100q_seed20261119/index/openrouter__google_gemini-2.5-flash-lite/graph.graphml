<node id="Thailand Masters">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Thailand Masters was a professional snooker tournament.", "chunk_id": "9719756e39f01e98", "doc_id": "hp_b2a5885a3a67beea"}]</data>
  <data key="d2">[{"text": "The Thailand Masters was a professional snooker tournament.", "chunk_id": "9719756e39f01e98", "doc_id": "hp_b2a5885a3a67beea"}]</data>
