  <data key="d2">[{"text": "Mötley Crüe is the eponymous sixth studio album by American heavy metal band Mötley Crüe.", "chunk_id": "c57fbc208f9c8aea", "doc_id": "hp_3835f9a65d3f6cf8"}]</data>
