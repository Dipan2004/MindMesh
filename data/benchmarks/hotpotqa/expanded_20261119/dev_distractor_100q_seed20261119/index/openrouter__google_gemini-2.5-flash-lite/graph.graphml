  <data key="d2">[{"text": "Godwin Birchenough, who was also a nephew of Sir Henry Birchenough, the President of the British South Africa Company, was educated at Rugby and Oriel College, Oxford.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d3">["hp_b4ae5293eb8657fc"]</data>
