  <data key="d7">[{"text": "Fossilized pollen attributed to a close relative of \"Ephedra\" has been dated as far back as the Early Cretaceous.", "chunk_id": "e8e7eb907eb94958", "doc_id": "hp_3ea3f73701bd3b33", "type": "ATTRIBUTED_TO"}]</data>
