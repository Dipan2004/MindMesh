  <data key="d0">DRUG</data>
  <data key="d1">[{"text": "Ibutilide is a Class III antiarrhythmic agent indicated for acute cardioconversion of atrial fibrillation and atrial flutter.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d2">[{"text": "Ibutilide is a Class III antiarrhythmic agent that is indicated for acute cardioconversion of atrial fibrillation and atrial flutter of a recent onset to sinus rhythm.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d3">["hp_6db35b9eeaff2803"]</data>
  <data key="d4">False</data>
</node>
<node id="Class III antiarrhythmic agent">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A class of antiarrhythmic drugs that prolong the action potential and refractory period of cardiac cells.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}, {"text": "Class III antiarrhythmic agents are drugs used to treat cardiac arrhythmias.", "chunk_id": "b7d2a8a0d65a6290", "doc_id": "hp_db684e0053d7062f"}]</data>
  <data key="d2">[{"text": "Ibutilide is a Class III antiarrhythmic agent that is indicated for acute cardioconversion of atrial fibrillation and atrial flutter of a recent onset to sinus rhythm.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}, {"text": "Tedisamil (3,7-dicyclopropylmethyl-9,9-tetramethylene-3,7-diazabicyclo-3,3,1-nonane) is an experimental class III antiarrhythmic agent currently being investigated for the treatment of atrial fibrillation.", "chunk_id": "b7d2a8a0d65a6290", "doc_id": "hp_db684e0053d7062f"}]</data>
  <data key="d3">["hp_6db35b9eeaff2803", "hp_db684e0053d7062f"]</data>
  <data key="d4">False</data>
</node>
<node id="atrial fibrillation">
  <data key="d0">MEDICAL_CONDITION</data>
  <data key="d1">[{"text": "A common heart rhythm disorder characterized by rapid and irregular beating of the upper heart chambers.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}, {"text": "Atrial fibrillation is a condition in which the heart's upper chambers beat with an irregular or rapid rhythm.", "chunk_id": "b7d2a8a0d65a6290", "doc_id": "hp_db684e0053d7062f"}]</data>
  <data key="d2">[{"text": "Ibutilide is a Class III antiarrhythmic agent that is indicated for acute cardioconversion of atrial fibrillation and atrial flutter of a recent onset to sinus rhythm.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}, {"text": "Tedisamil (3,7-dicyclopropylmethyl-9,9-tetramethylene-3,7-diazabicyclo-3,3,1-nonane) is an experimental class III antiarrhythmic agent currently being investigated for the treatment of atrial fibrillation.", "chunk_id": "b7d2a8a0d65a6290", "doc_id": "hp_db684e0053d7062f"}]</data>
  <data key="d3">["hp_6db35b9eeaff2803", "hp_db684e0053d7062f"]</data>
  <data key="d4">False</data>
</node>
<node id="atrial flutter">
  <data key="d0">MEDICAL_CONDITION</data>
  <data key="d1">[{"text": "A heart rhythm disorder characterized by rapid, regular beating of the upper heart chambers.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d2">[{"text": "Ibutilide is a Class III antiarrhythmic agent that is indicated for acute cardioconversion of atrial fibrillation and atrial flutter of a recent onset to sinus rhythm.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d3">["hp_6db35b9eeaff2803"]</data>
  <data key="d4">False</data>
</node>
<node id="sinus rhythm">
  <data key="d0">MEDICAL_CONDITION</data>
  <data key="d1">[{"text": "The normal, regular rhythm of the heart set by the sinoatrial node.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d2">[{"text": "Ibutilide is a Class III antiarrhythmic agent that is indicated for acute cardioconversion of atrial fibrillation and atrial flutter of a recent onset to sinus rhythm.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d3">["hp_6db35b9eeaff2803"]</data>
  <data key="d4">False</data>
</node>
<node id="slow inward sodium current">
  <data key="d0">PHYSIOLOGY</data>
  <data key="d1">[{"text": "A type of ionic current in cardiac cells that affects the action potential duration and refractory period.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d2">[{"text": "It exerts its antiarrhythmic effect by induction of slow inward sodium current, which prolongs action potential and refractory period (physiology) of myocardial cells.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d3">["hp_6db35b9eeaff2803"]</data>
  <data key="d4">False</data>
</node>
<node id="action potential">
  <data key="d0">PHYSIOLOGY</data>
  <data key="d1">[{"text": "The change in electrical potential on the surface of a cell that occurs when it is stimulated.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d2">[{"text": "It exerts its antiarrhythmic effect by induction of slow inward sodium current, which prolongs action potential and refractory period (physiology) of myocardial cells.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d3">["hp_6db35b9eeaff2803"]</data>
  <data key="d4">False</data>
</node>
<node id="refractory period">
  <data key="d0">PHYSIOLOGY</data>
  <data key="d1">[{"text": "The period during which a nerve or muscle cell is incapable of responding to a stimulus.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d2">[{"text": "It exerts its antiarrhythmic effect by induction of slow inward sodium current, which prolongs action potential and refractory period (physiology) of myocardial cells.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d3">["hp_6db35b9eeaff2803"]</data>
  <data key="d4">False</data>
</node>
<node id="myocardial cells">
  <data key="d0">CELL_TYPE</data>
  <data key="d1">[{"text": "The cells that make up the muscle tissue of the heart.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d2">[{"text": "It exerts its antiarrhythmic effect by induction of slow inward sodium current, which prolongs action potential and refractory period (physiology) of myocardial cells.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d3">["hp_6db35b9eeaff2803"]</data>
  <data key="d4">False</data>
</node>
<node id="Class Ia agents">
  <data key="d0">DRUG_CLASS</data>
  <data key="d1">[{"text": "A class of antiarrhythmic drugs that block sodium channels.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d2">[{"text": "Because of its Class III antiarrhythmic activity, there should not be concomitant administration of Class Ia and Class III agents.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d3">["hp_6db35b9eeaff2803"]</data>
  <data key="d4">False</data>
</node>
<node id="Class III agents">
  <data key="d0">DRUG_CLASS</data>
  <data key="d1">[{"text": "A class of antiarrhythmic drugs that prolong the action potential and refractory period of cardiac cells.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d2">[{"text": "Because of its Class III antiarrhythmic activity, there should not be concomitant administration of Class Ia and Class III agents.", "chunk_id": "768d5a792dd04c0c", "doc_id": "hp_6db35b9eeaff2803"}]</data>
  <data key="d3">["hp_6db35b9eeaff2803"]</data>
  <data key="d4">False</data>
</node>
<node id="Wilfred Bamnjo">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Wilfred Bamnjo is a Cameroonian football player.", "chunk_id": "7c7e004f8d4bc49c", "doc_id": "hp_6dd6203cbe711a5e"}]</data>
  <data key="d2">[{"text": "Wilfred Bamnjo (born 27 March 1980 in Cameroon) is a Cameroonian football player who currently plays for Hong Kong First Division League club Happy Valley.", "chunk_id": "7c7e004f8d4bc49c", "doc_id": "hp_6dd6203cbe711a5e"}]</data>
  <data key="d3">["hp_6dd6203cbe711a5e"]</data>
  <data key="d4">False</data>
</node>
<node id="Hong Kong First Division League">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Hong Kong First Division League is a football league in which Happy Valley plays.", "chunk_id": "7c7e004f8d4bc49c", "doc_id": "hp_6dd6203cbe711a5e"}, {"text": "A football league in Hong Kong.", "chunk_id": "0fb0a4062ab720d1", "doc_id": "hp_a2558257c20dfe87"}]</data>
  <data key="d2">[{"text": "Wilfred Bamnjo (born 27 March 1980 in Cameroon) is a Cameroonian football player who currently plays for Hong Kong First Division League club Happy Valley.", "chunk_id": "7c7e004f8d4bc49c", "doc_id": "hp_6dd6203cbe711a5e"}, {"text": "Hong Kong First Division League 2005–06 has 8 teams competing in the league.", "chunk_id": "0fb0a4062ab720d1", "doc_id": "hp_a2558257c20dfe87"}]</data>
  <data key="d3">["hp_6dd6203cbe711a5e", "hp_a2558257c20dfe87"]</data>
  <data key="d4">False</data>
</node>
<node id="defensive midfielder">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Defensive midfielder is the playing position of Wilfred Bamnjo.", "chunk_id": "7c7e004f8d4bc49c", "doc_id": "hp_6dd6203cbe711a5e"}]</data>
  <data key="d2">[{"text": "His position is defensive midfielder.", "chunk_id": "7c7e004f8d4bc49c", "doc_id": "hp_6dd6203cbe711a5e"}]</data>
  <data key="d3">["hp_6dd6203cbe711a5e"]</data>
  <data key="d4">False</data>
</node>
<node id="Hong Kong Makélélé">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Hong Kong Makélélé is a nickname given to Wilfred Bamnjo by supporters.", "chunk_id": "7c7e004f8d4bc49c", "doc_id": "hp_6dd6203cbe711a5e"}]</data>
  <data key="d2">[{"text": "Supporters have given Bamnjo a nickname of \"Hong Kong Makélélé\".", "chunk_id": "7c7e004f8d4bc49c", "doc_id": "hp_6dd6203cbe711a5e"}]</data>
  <data key="d3">["hp_6dd6203cbe711a5e"]</data>
  <data key="d4">False</data>
</node>
<node id="Lamiaceae">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Lamiaceae is a family of plants that includes the genus Salvia.", "chunk_id": "a02f6c09a33fee66", "doc_id": "hp_6e6c3433daecaed3"}, {"text": "Lamiaceae is the mint family of plants.", "chunk_id": "5634c2e12f5049d1", "doc_id": "hp_ea708a0e606fa04d"}]</data>
  <data key="d2">[{"text": "Salvia is the largest genus of plants in the family Lamiaceae, with the number of species estimated to range from 700 to nearly 1,000.", "chunk_id": "a02f6c09a33fee66", "doc_id": "hp_6e6c3433daecaed3"}, {"text": "Salvia is the largest genus of plants in the mint family, Lamiaceae, with nearly 1000 species of shrubs, herbaceous perennials, and annuals.", "chunk_id": "5634c2e12f5049d1", "doc_id": "hp_ea708a0e606fa04d"}]</data>
  <data key="d3">["hp_6e6c3433daecaed3", "hp_ea708a0e606fa04d"]</data>
  <data key="d4">False</data>
</node>
<node id="herbaceous perennials">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Herbaceous perennials are a type of plant that are members of the Salvia genus.", "chunk_id": "a02f6c09a33fee66", "doc_id": "hp_6e6c3433daecaed3"}]</data>
  <data key="d2">[{"text": "Members include shrubs, herbaceous perennials, and annuals.", "chunk_id": "a02f6c09a33fee66", "doc_id": "hp_6e6c3433daecaed3"}]</data>
  <data key="d3">["hp_6e6c3433daecaed3"]</data>
  <data key="d4">False</data>
</node>
<node id="annuals">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Annuals are a type of plant that are members of the Salvia genus.", "chunk_id": "a02f6c09a33fee66", "doc_id": "hp_6e6c3433daecaed3"}]</data>
  <data key="d2">[{"text": "Members include shrubs, herbaceous perennials, and annuals.", "chunk_id": "a02f6c09a33fee66", "doc_id": "hp_6e6c3433daecaed3"}]</data>
  <data key="d3">["hp_6e6c3433daecaed3"]</data>
  <data key="d4">False</data>
</node>
<node id="Central and South America">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Central and South America is a region with approximately 500 species of Salvia.", "chunk_id": "a02f6c09a33fee66", "doc_id": "hp_6e6c3433daecaed3"}, {"text": "Central and South America are regions in the Americas.", "chunk_id": "328b606d106a5a36", "doc_id": "hp_ebe09fc434bfa448"}]</data>
  <data key="d2">[{"text": "There are three main regions of radiation of \"Salvia\": Central and South America, with approximately 500 species; central Asia and the Mediterranean with approx. 250 species; eastern Asia with approximately 90 species.", "chunk_id": "a02f6c09a33fee66", "doc_id": "hp_6e6c3433daecaed3"}, {"text": "They are woody or weakly woody plants occurring in Southeast Asia, the Pacific, Madagascar, Central and South America, and the West Indies.", "chunk_id": "328b606d106a5a36", "doc_id": "hp_ebe09fc434bfa448"}]</data>
  <data key="d3">["hp_6e6c3433daecaed3", "hp_ebe09fc434bfa448"]</data>
  <data key="d4">False</data>
</node>
<node id="central Asia and the Mediterranean">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Central Asia and the Mediterranean is a region with approximately 250 species of Salvia.", "chunk_id": "a02f6c09a33fee66", "doc_id": "hp_6e6c3433daecaed3"}]</data>
  <data key="d2">[{"text": "There are three main regions of radiation of \"Salvia\": Central and South America, with approximately 500 species; central Asia and the Mediterranean with approx. 250 species; eastern Asia with approximately 90 species.", "chunk_id": "a02f6c09a33fee66", "doc_id": "hp_6e6c3433daecaed3"}]</data>
  <data key="d3">["hp_6e6c3433daecaed3"]</data>
  <data key="d4">False</data>
</node>
<node id="eastern Asia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Eastern Asia is a region with approximately 90 species of Salvia.", "chunk_id": "a02f6c09a33fee66", "doc_id": "hp_6e6c3433daecaed3"}]</data>
  <data key="d2">[{"text": "There are three main regions of radiation of \"Salvia\": Central and South America, with approximately 500 species; central Asia and the Mediterranean with approx. 250 species; eastern Asia with approximately 90 species.", "chunk_id": "a02f6c09a33fee66", "doc_id": "hp_6e6c3433daecaed3"}]</data>
  <data key="d3">["hp_6e6c3433daecaed3"]</data>
  <data key="d4">False</data>
</node>
