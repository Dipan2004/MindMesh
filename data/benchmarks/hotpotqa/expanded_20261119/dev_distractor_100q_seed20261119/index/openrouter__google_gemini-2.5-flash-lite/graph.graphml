  <data key="d2">[{"text": "Fisher School–High Street Historic District is a historic district at 748-850; 751-823 High Street in Westwood, Massachusetts.", "chunk_id": "c7e201cfcb080c0d", "doc_id": "hp_cdf4d14bbc02d78d"}]</data>
