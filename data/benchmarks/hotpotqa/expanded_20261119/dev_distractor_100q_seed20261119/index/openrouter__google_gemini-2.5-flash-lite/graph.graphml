  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An institution where Richard William Herrick studied.", "chunk_id": "2d54d3fa9439ab8e", "doc_id": "hp_e808a689dfcac703"}]</data>
  <data key="d2">[{"text": "He was ordained after a period of study at the College of the Resurrection, Mirfield in 1940.", "chunk_id": "2d54d3fa9439ab8e", "doc_id": "hp_e808a689dfcac703"}]</data>
  <data key="d3">["hp_e808a689dfcac703"]</data>
