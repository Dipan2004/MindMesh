<edge source="English force" target="Scotland">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">An English force arrived in Scotland.</data>
  <data key="d7">[{"text": "The French troops arrived by invitation in 1548 and left in 1560 after an English force arrived to attempt to assist in removing them from Scotland.", "chunk_id": "fed038ae0c566b69", "doc_id": "hp_26004159736d7249", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_26004159736d7249</data>
</edge>
