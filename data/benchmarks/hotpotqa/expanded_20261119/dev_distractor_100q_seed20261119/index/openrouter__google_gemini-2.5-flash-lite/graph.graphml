  <data key="d5">["NATIVE_TO", "RARE_IN"]</data>
  <data key="d6">Atherosperma moschatum is native to New South Wales.</data>
  <data key="d7">[{"text": "Atherosperma moschatum, the southern sassafras or blackheart sassafras, is an evergreen tree native to the cool temperate rainforests of Tasmania, Victoria, and New South Wales in Australia.", "chunk_id": "e1044c549e97de7c", "doc_id": "hp_dce12d59ef968ea1", "type": "NATIVE_TO"}, {"text": "It is common in the rainforests of Tasmania and Victoria, but more scattered and rare in the higher altitudes of eastern New South Wales.", "chunk_id": "e1044c549e97de7c", "doc_id": "hp_dce12d59ef968ea1", "type": "RARE_IN"}]</data>
  <data key="d8">hp_dce12d59ef968ea1</data>
</edge>
