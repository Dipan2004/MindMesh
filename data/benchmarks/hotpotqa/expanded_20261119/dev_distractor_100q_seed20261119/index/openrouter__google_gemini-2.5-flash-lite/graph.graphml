<node id="Edward Hall">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Edward Hall is an English professional strongman, notable for being the current World's Strongest Man and the only man to deadlift 500 kg under strongman rules.", "chunk_id": "9b0d62492a00ccff", "doc_id": "hp_6a07e9a4e90de729"}]</data>
  <data key="d2">[{"text": "Edward Hall (born 15 January 1988) is an English professional strongman, notable for being the current World's Strongest Man and the only man to deadlift 500 kg under strongman rules.", "chunk_id": "9b0d62492a00ccff", "doc_id": "hp_6a07e9a4e90de729"}]</data>
  <data key="d3">["hp_6a07e9a4e90de729"]</data>
  <data key="d4">False</data>
</node>
<node id="UK's Strongest Man">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "UK's Strongest Man is an event that Edward Hall has won on multiple occasions.", "chunk_id": "9b0d62492a00ccff", "doc_id": "hp_6a07e9a4e90de729"}]</data>
  <data key="d2">[{"text": "He has also won on multiple occasions both the UK's Strongest Man and England's Strongest Man titles.", "chunk_id": "9b0d62492a00ccff", "doc_id": "hp_6a07e9a4e90de729"}]</data>
  <data key="d3">["hp_6a07e9a4e90de729"]</data>
  <data key="d4">False</data>
</node>
<node id="England's Strongest Man">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "England's Strongest Man is an event that Edward Hall has won on multiple occasions.", "chunk_id": "9b0d62492a00ccff", "doc_id": "hp_6a07e9a4e90de729"}, {"text": "A title won by Ben Kelsey.", "chunk_id": "32542274ed783fb0", "doc_id": "hp_fe45ed2c9dbcb86e"}]</data>
  <data key="d2">[{"text": "He has also won on multiple occasions both the UK's Strongest Man and England's Strongest Man titles.", "chunk_id": "9b0d62492a00ccff", "doc_id": "hp_6a07e9a4e90de729"}, {"text": "Ben Kelsey (born 23 September 1984) is a British strongman competitor, notable for having won the England's Strongest Man title, the title of World's Strongest Man Under 105 kg and having competed at the World's Strongest Man.", "chunk_id": "32542274ed783fb0", "doc_id": "hp_fe45ed2c9dbcb86e"}]</data>
  <data key="d3">["hp_6a07e9a4e90de729", "hp_fe45ed2c9dbcb86e"]</data>
  <data key="d4">False</data>
</node>
