  <data key="d2">[{"text": "Georgina Susan Fitzalan-Howard, Duchess of Norfolk (born 30 January 1962), is the wife of Edward William Fitzalan-Howard, 18th Duke of Norfolk.", "chunk_id": "665f9238f1f644c5", "doc_id": "hp_3896bbdafdb2575f"}, {"text": "Edward William Fitzalan-Howard, 18th Duke of Norfolk, (born 2 December 1956), styled Earl of Arundel between 1975 and 2002, is a British peer, Earl Marshal and son of Miles Fitzalan-Howard, 17th Duke of Norfolk.", "chunk_id": "6517718c3566223d", "doc_id": "hp_87afae3cf599b7ed"}]</data>
  <data key="d3">["hp_3896bbdafdb2575f", "hp_87afae3cf599b7ed"]</data>
