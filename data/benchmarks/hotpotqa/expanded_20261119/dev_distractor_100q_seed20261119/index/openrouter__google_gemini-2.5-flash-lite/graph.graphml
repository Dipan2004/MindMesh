  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "R&amp;B refers to Rhythm and Blues, a genre of popular music that originated in African-American communities in the 1940s.", "chunk_id": "ce87e073e688d786", "doc_id": "hp_e581e2f559367c59"}]</data>
