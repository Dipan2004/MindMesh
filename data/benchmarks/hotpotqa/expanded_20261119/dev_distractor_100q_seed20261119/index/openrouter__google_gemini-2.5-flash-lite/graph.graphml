<node id="Washington, D.C.">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Washington, D.C. is a location where the American University is situated.", "chunk_id": "6c9e11b0297de1c6", "doc_id": "hp_5788c911b27e82a4"}, {"text": "Washington, D.C. is the location of the Library of Congress.", "chunk_id": "7d4e3a512ec3ac2c", "doc_id": "hp_9db3a175e11b24ac"}, {"text": "The location of the independent minyan or chavurah, Tikkun Leil Shabbat.", "chunk_id": "c80672aca910bdd6", "doc_id": "hp_96d9debe51005d2b"}]</data>
  <data key="d2">[{"text": "Yannis attended college at the American University in Washington, D.C. where he studied American Studies and History.", "chunk_id": "6c9e11b0297de1c6", "doc_id": "hp_5788c911b27e82a4"}, {"text": "The American patron of the arts Elizabeth Sprague Coolidge had commissioned the ballet in 1927 for a festival of contemporary music to be held the following year at the Library of Congress in Washington, D.C.", "chunk_id": "7d4e3a512ec3ac2c", "doc_id": "hp_9db3a175e11b24ac"}, {"text": "Tikkun Leil Shabbat is an independent minyan or chavurah in Washington, DC, organized entirely by volunteer leadership and sponsored by Jews United For Justice, DC's local Jewish social justice organization.", "chunk_id": "c80672aca910bdd6", "doc_id": "hp_96d9debe51005d2b"}]</data>
  <data key="d3">["hp_5788c911b27e82a4", "hp_96d9debe51005d2b", "hp_9db3a175e11b24ac"]</data>
  <data key="d4">False</data>
</node>
