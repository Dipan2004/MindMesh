<edge source="Cincinnati Bengals" target="NFL">
  <data key="d5">["PART_OF"]</data>
  <data key="d6">The Cincinnati Bengals are a team within the NFL.</data>
  <data key="d7">[{"text": "As of the conclusion of the 2016-17 season, the Bengals have had 26 seasons without a playoff win - currently the longest streak in the NFL.", "chunk_id": "e487f13bc27a273e", "doc_id": "hp_ffc6a1fc4012397a", "type": "PART_OF"}]</data>
  <data key="d8">hp_ffc6a1fc4012397a</data>
