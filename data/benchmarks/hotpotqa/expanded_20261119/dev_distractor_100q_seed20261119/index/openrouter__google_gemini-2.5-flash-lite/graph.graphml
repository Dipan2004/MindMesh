  <data key="d4">False</data>
</node>
<node id="University of Massachusetts - Amherst">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The University of Massachusetts - Amherst is the current name for Massachusetts Agricultural College.", "chunk_id": "3cd3c8487045d3d4", "doc_id": "hp_8b1f7c86ce5cb296"}]</data>
  <data key="d2">[{"text": "He served as the president of the Oklahoma Agricultural and Mechanical College (now Oklahoma State University) and the Maryland Agricultural College (now the University of Maryland) as well teaching Military Science at Massachusetts Agricultural College (Now the University of Massachusetts - Amherst).", "chunk_id": "3cd3c8487045d3d4", "doc_id": "hp_8b1f7c86ce5cb296"}]</data>
  <data key="d3">["hp_8b1f7c86ce5cb296"]</data>
  <data key="d4">False</data>
</node>
<node id="A Game with Stones">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A nine-minute animated film by Czech animator Jan Švankmajer.", "chunk_id": "1cbc56f52e93151e", "doc_id": "hp_8bcb421ee48fbf62"}]</data>
  <data key="d2">[{"text": "A Game With Stones (Czech: \"Hra s kameny\"), (German: \"Spiel mit Steinen\") is a nine-minute animated film by Czech animator Jan Švankmajer.", "chunk_id": "1cbc56f52e93151e", "doc_id": "hp_8bcb421ee48fbf62"}]</data>
  <data key="d3">["hp_8bcb421ee48fbf62"]</data>
  <data key="d4">False</data>
</node>
<node id="Hra s kameny">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Czech title for the film 'A Game with Stones'.", "chunk_id": "1cbc56f52e93151e", "doc_id": "hp_8bcb421ee48fbf62"}]</data>
  <data key="d2">[{"text": "A Game With Stones (Czech: \"Hra s kameny\"), (German: \"Spiel mit Steinen\") is a nine-minute animated film by Czech animator Jan Švankmajer.", "chunk_id": "1cbc56f52e93151e", "doc_id": "hp_8bcb421ee48fbf62"}]</data>
  <data key="d3">["hp_8bcb421ee48fbf62"]</data>
  <data key="d4">False</data>
</node>
<node id="Spiel mit Steinen">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The German title for the film 'A Game with Stones'.", "chunk_id": "1cbc56f52e93151e", "doc_id": "hp_8bcb421ee48fbf62"}]</data>
  <data key="d2">[{"text": "A Game With Stones (Czech: \"Hra s kameny\"), (German: \"Spiel mit Steinen\") is a nine-minute animated film by Czech animator Jan Švankmajer.", "chunk_id": "1cbc56f52e93151e", "doc_id": "hp_8bcb421ee48fbf62"}]</data>
  <data key="d3">["hp_8bcb421ee48fbf62"]</data>
  <data key="d4">False</data>
</node>
<node id="stop-motion animation">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A type of animation technique used in the film 'A Game with Stones'.", "chunk_id": "1cbc56f52e93151e", "doc_id": "hp_8bcb421ee48fbf62"}]</data>
  <data key="d2">[{"text": "Made in 1965, it utilizes stop-motion animation.", "chunk_id": "1cbc56f52e93151e", "doc_id": "hp_8bcb421ee48fbf62"}]</data>
  <data key="d3">["hp_8bcb421ee48fbf62"]</data>
  <data key="d4">False</data>
</node>
<node id="Shree 420">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A 1955 Hindi film.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d2">[{"text": "Shree 420 (\"Hindi\" श्री ४२०, translation: \"Sir 420\", also transliterated as Shri 420) is a 1955 Hindi film, directed and produced by Raj Kapoor, written by Khwaja Ahmad Abbas, and starring Raj Kapoor and Nargis.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d3">["hp_8c200a803fef76a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Nargis">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Star of the 1955 Hindi film Shree 420.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}, {"text": "An actress who starred in supporting roles in the 1948 film Aag.", "chunk_id": "4df4b5295e67f801", "doc_id": "hp_b8f974e5ce544d7e"}]</data>
  <data key="d2">[{"text": "Shree 420 (\"Hindi\" श्री ४२०, translation: \"Sir 420\", also transliterated as Shri 420) is a 1955 Hindi film, directed and produced by Raj Kapoor, written by Khwaja Ahmad Abbas, and starring Raj Kapoor and Nargis.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}, {"text": "Nargis, Premnath, Nigar Sultana and Kamini Kaushal also starred in supporting roles.", "chunk_id": "4df4b5295e67f801", "doc_id": "hp_b8f974e5ce544d7e"}]</data>
  <data key="d3">["hp_8c200a803fef76a7", "hp_b8f974e5ce544d7e"]</data>
  <data key="d4">False</data>
</node>
<node id="Section 420 of the Indian Penal Code">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A section of the Indian Penal Code that prescribes punishment for cheating.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d2">[{"text": "The number 420 refers to Section 420 of the Indian Penal Code, which prescribes the punishment for the offence of cheating; hence, \"Mr. 420\" is a derogatory term for a cheat.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d3">["hp_8c200a803fef76a7"]</data>
  <data key="d4">False</data>
</node>
<node id="cheating">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "An offense for which Section 420 of the Indian Penal Code prescribes punishment.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d2">[{"text": "The number 420 refers to Section 420 of the Indian Penal Code, which prescribes the punishment for the offence of cheating; hence, \"Mr. 420\" is a derogatory term for a cheat.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d3">["hp_8c200a803fef76a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Bombay">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city where the protagonist of Shree 420 comes with dreams of success.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d2">[{"text": "The film centers on Raj, a poor but educated orphan who comes to Bombay with dreams of success.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d3">["hp_8c200a803fef76a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Charlie Chaplin">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An actor whose \"little tramp\" character influenced Raj Kapoor's character in Shree 420.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d2">[{"text": "Kapoor's character is influenced by Charlie Chaplin's \"little tramp\", much like Kapoor's character in his 1951 \"Awaara\".", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d3">["hp_8c200a803fef76a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Awaara">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A 1951 film starring Raj Kapoor.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d2">[{"text": "Kapoor's character is influenced by Charlie Chaplin's \"little tramp\", much like Kapoor's character in his 1951 \"Awaara\".", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d3">["hp_8c200a803fef76a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Shankar Jaikishan">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The music composing team for the film Shree 420.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d2">[{"text": "The music was composed by the team of Shankar Jaikishan, and the lyrics were penned by Shailendra.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d3">["hp_8c200a803fef76a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Shailendra">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The lyricist for the film Shree 420.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d2">[{"text": "The music was composed by the team of Shankar Jaikishan, and the lyrics were penned by Shailendra.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}]</data>
  <data key="d3">["hp_8c200a803fef76a7"]</data>
  <data key="d4">False</data>
</node>
<node id="John Dustin Archbold">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "John Dustin Archbold was an American capitalist and one of the United States' earliest oil refiners.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}, {"text": "John Dustin Archbold was a major benefactor of Syracuse University.", "chunk_id": "9a89f86e35e64ab2", "doc_id": "hp_b8ec94a3c00016f8"}]</data>
  <data key="d2">[{"text": "John Dustin Archbold (July 26, 1848 in Leesburg, Ohio – December 6, 1916 in Tarrytown, New York) was an American capitalist and one of the United States' earliest oil refiners.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}, {"text": "It was built in 1908 with money donated by John Dustin Archbold, a major benefactor of the university, who also funded the building of Archbold Stadium, just to the west of the gymnasium (now the site of the Carrier Dome).", "chunk_id": "9a89f86e35e64ab2", "doc_id": "hp_b8ec94a3c00016f8"}]</data>
  <data key="d3">["hp_8c2bc815dfcb30af", "hp_b8ec94a3c00016f8"]</data>
  <data key="d4">False</data>
</node>
<node id="Leesburg, Ohio">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Leesburg, Ohio is the birthplace of John Dustin Archbold.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}]</data>
  <data key="d2">[{"text": "John Dustin Archbold (July 26, 1848 in Leesburg, Ohio – December 6, 1916 in Tarrytown, New York) was an American capitalist and one of the United States' earliest oil refiners.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}]</data>
  <data key="d3">["hp_8c2bc815dfcb30af"]</data>
  <data key="d4">False</data>
</node>
<node id="Tarrytown, New York">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Tarrytown, New York is the place where John Dustin Archbold died.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}]</data>
  <data key="d2">[{"text": "John Dustin Archbold (July 26, 1848 in Leesburg, Ohio – December 6, 1916 in Tarrytown, New York) was an American capitalist and one of the United States' earliest oil refiners.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}]</data>
  <data key="d3">["hp_8c2bc815dfcb30af"]</data>
  <data key="d4">False</data>
</node>
<node id="Standard Oil Company">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Standard Oil Company was a major oil company founded by John D. Rockefeller.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}]</data>
  <data key="d2">[{"text": "His small oil company was bought out by John D Rockefeller's Standard Oil Company.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}]</data>
  <data key="d3">["hp_8c2bc815dfcb30af"]</data>
  <data key="d4">False</data>
</node>
<node id="John D Rockefeller">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "John D Rockefeller was the founder of the Standard Oil Company.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}]</data>
  <data key="d2">[{"text": "His small oil company was bought out by John D Rockefeller's Standard Oil Company.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}]</data>
  <data key="d3">["hp_8c2bc815dfcb30af"]</data>
  <data key="d4">False</data>
</node>
<node id="Standard Oil">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Standard Oil was a company where John Dustin Archbold rose rapidly and effectively ran as vice president.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}]</data>
  <data key="d2">[{"text": "Archbold rose rapidly at Standard Oil, handling many of the complex secret negotiations over the years.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}]</data>
  <data key="d3">["hp_8c2bc815dfcb30af"]</data>
  <data key="d4">False</data>
</node>
<node id="Standard Oil of New Jersey">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Standard Oil of New Jersey was one of the smaller operations that Standard Oil was broken up into.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}]</data>
  <data key="d2">[{"text": "The company was broken up by the Supreme Court in 1911 into three dozen smaller operations, Archbold became president of the largest one, Standard Oil of New Jersey.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}]</data>
  <data key="d3">["hp_8c2bc815dfcb30af"]</data>
  <data key="d4">False</data>
</node>
<node id="Supreme Court">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Supreme Court broke up the Standard Oil company in 1911.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}, {"text": "The highest court in the federal judiciary of the United States.", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d2">[{"text": "The company was broken up by the Supreme Court in 1911 into three dozen smaller operations, Archbold became president of the largest one, Standard Oil of New Jersey.", "chunk_id": "bc2d20db8c1bfb47", "doc_id": "hp_8c2bc815dfcb30af"}, {"text": "However, the Supreme Court did not invest the federal government with the authority to protect freedom of movement.", "chunk_id": "bd4c3187e0206f8a", "doc_id": "hp_de77e95616995229"}]</data>
  <data key="d3">["hp_8c2bc815dfcb30af", "hp_de77e95616995229"]</data>
  <data key="d4">False</data>
</node>
<node id="Sam Saturday">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A British television police procedural drama series broadcast in 1992.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d2">[{"text": "Sam Saturday is a British television police procedural drama series, broadcast between 27 June and 8 August 1992.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d3">["hp_8c33eb6416b6e498"]</data>
  <data key="d4">False</data>
</node>
<node id="Cinema Verity">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A production company that produced the series Sam Saturday.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d2">[{"text": "The six-part series produced by Cinema Verity in association with LWT, broadcast on ITV, follows the work of DI Sam Sterne (Ivan Kaye), a Jewish police detective, as he struggles to balance the demands of the job with his private life.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d3">["hp_8c33eb6416b6e498"]</data>
  <data key="d4">False</data>
</node>
<node id="LWT">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A television network that broadcast the series Sam Saturday.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d2">[{"text": "The six-part series produced by Cinema Verity in association with LWT, broadcast on ITV, follows the work of DI Sam Sterne (Ivan Kaye), a Jewish police detective, as he struggles to balance the demands of the job with his private life.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d3">["hp_8c33eb6416b6e498"]</data>
  <data key="d4">False</data>
</node>
<node id="ITV">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A television network that broadcast the series Sam Saturday.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}, {"text": "A television network for which the format of Dancing on Ice was devised.", "chunk_id": "11198ab313088443", "doc_id": "hp_d35c5fabe367cde8"}]</data>
  <data key="d2">[{"text": "The six-part series produced by Cinema Verity in association with LWT, broadcast on ITV, follows the work of DI Sam Sterne (Ivan Kaye), a Jewish police detective, as he struggles to balance the demands of the job with his private life.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}, {"text": "The format, devised by London Weekend Television and Granada Television for ITV, has been a prime-time hit in eight different countries, including Britain and subsequently in Italy and Chile.", "chunk_id": "11198ab313088443", "doc_id": "hp_d35c5fabe367cde8"}]</data>
  <data key="d3">["hp_8c33eb6416b6e498", "hp_d35c5fabe367cde8"]</data>
  <data key="d4">False</data>
</node>
<node id="DI Sam Sterne">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A Jewish police detective who is the main character of the series Sam Saturday.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d2">[{"text": "The six-part series produced by Cinema Verity in association with LWT, broadcast on ITV, follows the work of DI Sam Sterne (Ivan Kaye), a Jewish police detective, as he struggles to balance the demands of the job with his private life.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d3">["hp_8c33eb6416b6e498"]</data>
  <data key="d4">False</data>
</node>
<node id="Ivan Kaye">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The actor who plays DI Sam Sterne.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d2">[{"text": "The six-part series produced by Cinema Verity in association with LWT, broadcast on ITV, follows the work of DI Sam Sterne (Ivan Kaye), a Jewish police detective, as he struggles to balance the demands of the job with his private life.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d3">["hp_8c33eb6416b6e498"]</data>
  <data key="d4">False</data>
</node>
<node id="Alvin Rakoff">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The writer and director who created the series Sam Saturday.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d2">[{"text": "The series was created by writer and director Alvin Rakoff, and was produced by the production company of executive producer Verity Lambert.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d3">["hp_8c33eb6416b6e498"]</data>
  <data key="d4">False</data>
</node>
<node id="Verity Lambert">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The executive producer of the series Sam Saturday.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d2">[{"text": "The series was created by writer and director Alvin Rakoff, and was produced by the production company of executive producer Verity Lambert.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d3">["hp_8c33eb6416b6e498"]</data>
  <data key="d4">False</data>
</node>
<node id="Nick Elliott">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The controller of drama at LWT who commissioned the series Sam Saturday.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d2">[{"text": "The series was just one of a number of commissions made by LWT controller of drama Nick Elliott in 1991, following the announcement that both \"The Ruth Rendell Mysteries\" and \"Inspector Morse\" were to cease production.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d3">["hp_8c33eb6416b6e498"]</data>
  <data key="d4">False</data>
</node>
<node id="The Ruth Rendell Mysteries">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A television series that ceased production.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d2">[{"text": "The series was just one of a number of commissions made by LWT controller of drama Nick Elliott in 1991, following the announcement that both \"The Ruth Rendell Mysteries\" and \"Inspector Morse\" were to cease production.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d3">["hp_8c33eb6416b6e498"]</data>
  <data key="d4">False</data>
</node>
<node id="Inspector Morse">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A television series that ceased production.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d2">[{"text": "The series was just one of a number of commissions made by LWT controller of drama Nick Elliott in 1991, following the announcement that both \"The Ruth Rendell Mysteries\" and \"Inspector Morse\" were to cease production.", "chunk_id": "991c522ae470bacd", "doc_id": "hp_8c33eb6416b6e498"}]</data>
  <data key="d3">["hp_8c33eb6416b6e498"]</data>
  <data key="d4">False</data>
</node>
<node id="Exit Tunes, Inc.">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Exit Tunes, Inc. is a Japanese media company that acts primarily as a music publisher.", "chunk_id": "590e8bd6ca347d80", "doc_id": "hp_8c3eb2c860de1dc2"}]</data>
  <data key="d2">[{"text": "Exit Tunes, Inc. (エグジットチューンズ株式会社 ) is a Japanese media company that acts primarily as a music publisher.", "chunk_id": "590e8bd6ca347d80", "doc_id": "hp_8c3eb2c860de1dc2"}]</data>
  <data key="d3">["hp_8c3eb2c860de1dc2"]</data>
  <data key="d4">False</data>
</node>
<node id="Quake Records">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Quake Records was the name of the company after it became a music company in 2003.", "chunk_id": "590e8bd6ca347d80", "doc_id": "hp_8c3eb2c860de1dc2"}]</data>
  <data key="d2">[{"text": "The company was founded as a printing company in 2001, however later became a music company known as Quake Records in 2003.", "chunk_id": "590e8bd6ca347d80", "doc_id": "hp_8c3eb2c860de1dc2"}]</data>
  <data key="d3">["hp_8c3eb2c860de1dc2"]</data>
  <data key="d4">False</data>
</node>
<node id="Quake Holdings">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Quake Holdings was the name of the company after it was renamed in 2005.", "chunk_id": "590e8bd6ca347d80", "doc_id": "hp_8c3eb2c860de1dc2"}]</data>
  <data key="d2">[{"text": "In 2005, the company was renamed to Quake Holdings.", "chunk_id": "590e8bd6ca347d80", "doc_id": "hp_8c3eb2c860de1dc2"}]</data>
  <data key="d3">["hp_8c3eb2c860de1dc2"]</data>
  <data key="d4">False</data>
</node>
<node id="Pony Canyon">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Pony Canyon is a company that Exit Tunes, Inc. became a subsidiary of.", "chunk_id": "590e8bd6ca347d80", "doc_id": "hp_8c3eb2c860de1dc2"}]</data>
  <data key="d2">[{"text": "The company became a subsidiary of Pony Canyon in 2009 (later becoming a wholly owned subsidiary in 2014), and was renamed Exit Tunes in 2011.", "chunk_id": "590e8bd6ca347d80", "doc_id": "hp_8c3eb2c860de1dc2"}]</data>
  <data key="d3">["hp_8c3eb2c860de1dc2"]</data>
  <data key="d4">False</data>
</node>
<node id="Casuarina Tree">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A tree that is described as strong, gallant, and brave, covered with a creeper bearing red crimson flowers.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d2">[{"text": "The poem begins with the description of the tree.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d3">["hp_8cb6340f34038734"]</data>
  <data key="d4">False</data>
</node>
<node id="Python">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A simile used to describe how the creeper has wound itself round the trunk of the Casuarina Tree.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d2">[{"text": "The poet says that the creeper has wound itself round the rugged trunk of the Casuarina Tree, like a huge Python.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d3">["hp_8cb6340f34038734"]</data>
  <data key="d4">False</data>
</node>
<node id="creeper">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A plant that has wound itself around the Casuarina Tree, leaving deep marks and holding it tightly.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d2">[{"text": "The poet says that the creeper has wound itself round the rugged trunk of the Casuarina Tree, like a huge Python.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d3">["hp_8cb6340f34038734"]</data>
  <data key="d4">False</data>
</node>
<node id="nightingale">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A bird whose song is heard in the garden at night, continuing until dawn.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d2">[{"text": "Often at night, the garden echoes and it seems to be jubilant and the song (of a nightingale) has no end; it continues till dawn.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d3">["hp_8cb6340f34038734"]</data>
  <data key="d4">False</data>
</node>
<node id="gray baboon">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An animal seen sitting on the crest of the Casuarina Tree in winters, watching the sunrise.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d2">[{"text": "Mostly in winters a gray baboon is seen sitting on the crest of the tree seeing the sunrise with her younger ones leaping and playing in the tree's boughs.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d3">["hp_8cb6340f34038734"]</data>
  <data key="d4">False</data>
</node>
<node id="Toru Dutt">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The poet who wrote about the Casuarina Tree and her feelings towards it.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d2">[{"text": "Toru Dutt says that it is not because of the majestic appearance of the Casuarina Tree that it is dear to her heart and soul, but also that she along with her siblings spent happy moments under it.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d3">["hp_8cb6340f34038734"]</data>
  <data key="d4">False</data>
</node>
<node id="Wordsworth">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A poet who sanctified the Yew trees of Borrowdale, mentioned as a parallel to Toru Dutt immortalizing the Casuarina Tree.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d2">[{"text": "She immortalizes the tree through this poem like how Wordsworth sanctified the Yew trees of Borrowdale.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d3">["hp_8cb6340f34038734"]</data>
  <data key="d4">False</data>
</node>
<node id="Yew trees of Borrowdale">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Trees sanctified by Wordsworth, used as a comparison to the Casuarina Tree's immortalization.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d2">[{"text": "She immortalizes the tree through this poem like how Wordsworth sanctified the Yew trees of Borrowdale.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d3">["hp_8cb6340f34038734"]</data>
  <data key="d4">False</data>
</node>
<node id="Oblivion">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A curse that the poet wishes her love for the Casuarina Tree to defend it from, meaning being forgotten.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d2">[{"text": "She says \"May love defend thee from Oblivion's curse'\"- by which she means that she is glad that her love for the Casuarina will protect it from the curse of being forgotten.", "chunk_id": "4311709e1a9f0b6d", "doc_id": "hp_8cb6340f34038734"}]</data>
  <data key="d3">["hp_8cb6340f34038734"]</data>
  <data key="d4">False</data>
</node>
<node id="Robert Keith Orton Jr.">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An American professional wrestler, also known by his ring name \"Cowboy\" Bob Orton.", "chunk_id": "107bd8714a8dad71", "doc_id": "hp_8cbd595289b581da"}]</data>
  <data key="d2">[{"text": "Robert Keith Orton Jr. (born November 10, 1950), better known by the ring name \"Cowboy\" Bob Orton, is an American professional wrestler.", "chunk_id": "107bd8714a8dad71", "doc_id": "hp_8cbd595289b581da"}]</data>
  <data key="d3">["hp_8cbd595289b581da"]</data>
  <data key="d4">False</data>
</node>
<node id="&quot;Cowboy&quot; Bob Orton">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The ring name of Robert Keith Orton Jr., an American professional wrestler.", "chunk_id": "107bd8714a8dad71", "doc_id": "hp_8cbd595289b581da"}]</data>
  <data key="d2">[{"text": "Robert Keith Orton Jr. (born November 10, 1950), better known by the ring name \"Cowboy\" Bob Orton, is an American professional wrestler.", "chunk_id": "107bd8714a8dad71", "doc_id": "hp_8cbd595289b581da"}]</data>
  <data key="d3">["hp_8cbd595289b581da"]</data>
  <data key="d4">False</data>
</node>
<node id="Bob Orton Sr.">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A professional wrestler and the father of Robert Keith Orton Jr.", "chunk_id": "107bd8714a8dad71", "doc_id": "hp_8cbd595289b581da"}]</data>
  <data key="d2">[{"text": "He is the son of professional wrestler Bob Orton Sr., the brother of professional wrestler Barry Orton, and the father of professional wrestler Randy Orton.", "chunk_id": "107bd8714a8dad71", "doc_id": "hp_8cbd595289b581da"}]</data>
  <data key="d3">["hp_8cbd595289b581da"]</data>
  <data key="d4">False</data>
</node>
<node id="WWF">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "World Wrestling Federation, a professional wrestling promotion, now known as WWE.", "chunk_id": "107bd8714a8dad71", "doc_id": "hp_8cbd595289b581da"}]</data>
  <data key="d2">[{"text": "He is best known for his time in the WWF (World Wrestling Federation, now WWE).", "chunk_id": "107bd8714a8dad71", "doc_id": "hp_8cbd595289b581da"}]</data>
  <data key="d3">["hp_8cbd595289b581da"]</data>
  <data key="d4">False</data>
</node>
<node id="World Wrestling Federation">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The former name of the professional wrestling promotion now known as WWE.", "chunk_id": "107bd8714a8dad71", "doc_id": "hp_8cbd595289b581da"}]</data>
  <data key="d2">[{"text": "He is best known for his time in the WWF (World Wrestling Federation, now WWE).", "chunk_id": "107bd8714a8dad71", "doc_id": "hp_8cbd595289b581da"}]</data>
  <data key="d3">["hp_8cbd595289b581da"]</data>
  <data key="d4">False</data>
</node>
<node id="WWE">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A professional wrestling promotion, formerly known as WWF (World Wrestling Federation).", "chunk_id": "107bd8714a8dad71", "doc_id": "hp_8cbd595289b581da"}, {"text": "A professional wrestling company where Damien Sandow was a wrestler.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d2">[{"text": "He is best known for his time in the WWF (World Wrestling Federation, now WWE).", "chunk_id": "107bd8714a8dad71", "doc_id": "hp_8cbd595289b581da"}, {"text": "He may have taken his ring name from Eugen Sandow, a professional wrestler and strongman in the late 19th century; in turn, former WWE wrestler Damien Sandow would adopt his own ring name in honor of Sandow almost a century later.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d3">["hp_8cbd595289b581da", "hp_9ebd705ad887d9a9"]</data>
  <data key="d4">False</data>
</node>
<node id="Dongtai">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Dongtai is a coastal county-level city under the administration of Yancheng, Jiangsu province, China.", "chunk_id": "551f221f922de162", "doc_id": "hp_8cfa6859d9227577"}]</data>
  <data key="d2">[{"text": "Dongtai () is a coastal county-level city under the administration of Yancheng, Jiangsu province, China.", "chunk_id": "551f221f922de162", "doc_id": "hp_8cfa6859d9227577"}]</data>
  <data key="d3">["hp_8cfa6859d9227577"]</data>
  <data key="d4">False</data>
</node>
<node id="Yancheng">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Yancheng is a prefecture-level city in Jiangsu province, China, which administers Dongtai.", "chunk_id": "551f221f922de162", "doc_id": "hp_8cfa6859d9227577"}]</data>
  <data key="d2">[{"text": "Dongtai () is a coastal county-level city under the administration of Yancheng, Jiangsu province, China.", "chunk_id": "551f221f922de162", "doc_id": "hp_8cfa6859d9227577"}]</data>
  <data key="d3">["hp_8cfa6859d9227577"]</data>
  <data key="d4">False</data>
</node>
<node id="Jiangsu province">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Jiangsu province is a province in China where Dongtai is located.", "chunk_id": "551f221f922de162", "doc_id": "hp_8cfa6859d9227577"}]</data>
  <data key="d2">[{"text": "Dongtai () is a coastal county-level city under the administration of Yancheng, Jiangsu province, China.", "chunk_id": "551f221f922de162", "doc_id": "hp_8cfa6859d9227577"}]</data>
  <data key="d3">["hp_8cfa6859d9227577"]</data>
  <data key="d4">False</data>
</node>
<node id="Dongtai urban core">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Dongtai urban core is the central urban area of Dongtai city.", "chunk_id": "551f221f922de162", "doc_id": "hp_8cfa6859d9227577"}]</data>
  <data key="d2">[{"text": "Out of the total population, about 260,000 live in the Dongtai urban core, others are distributed in the 23 suburban towns and rural regions (Some famous towns include Touzao, Anfeng, Qingdong, Sancang, Qianggang, Fu'an, Tangyang, etc.).", "chunk_id": "551f221f922de162", "doc_id": "hp_8cfa6859d9227577"}]</data>
  <data key="d3">["hp_8cfa6859d9227577"]</data>
  <data key="d4">False</data>
</node>
