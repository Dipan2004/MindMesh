  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The German name for the German Attack on Vimy Ridge.", "chunk_id": "2eb3f367156872ac", "doc_id": "hp_69a8458a8adc29ab"}]</data>
  <data key="d2">[{"text": "The German Attack on Vimy Ridge, 21 May (\"Unternehmen Schleswig-Holstein\"/Operation Schleswig-Holstein) was a local attack on the Western Front during the First World War.", "chunk_id": "2eb3f367156872ac", "doc_id": "hp_69a8458a8adc29ab"}]</data>
  <data key="d3">["hp_69a8458a8adc29ab"]</data>
