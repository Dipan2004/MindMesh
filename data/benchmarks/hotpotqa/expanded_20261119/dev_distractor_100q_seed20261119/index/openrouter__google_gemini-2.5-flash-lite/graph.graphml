<node id="ATP final at Bogotá">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The ATP final at Bogotá was an event reached by Ramón Delgado in 1998.", "chunk_id": "15bc153260909107", "doc_id": "hp_2a4f96406daecf89"}]</data>
  <data key="d2">[{"text": "He reached the ATP final at Bogotá in 1998 and the fourth round of the 1998 French Open, defeating Pete Sampras in the second round.", "chunk_id": "15bc153260909107", "doc_id": "hp_2a4f96406daecf89"}]</data>
  <data key="d3">["hp_2a4f96406daecf89"]</data>
