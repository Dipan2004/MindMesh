  <data key="d5">["EXECUTIVE_PRODUCER_OF"]</data>
  <data key="d6">Seth MacFarlane is an executive producer of "Cosmos: A Spacetime Odyssey".</data>
  <data key="d7">[{"text": "Among the executive producers are Seth MacFarlane, whose financial investment was instrumental in bringing the show to broadcast television, and Ann Druyan, a co-author and co-creator of the original television series and Sagan's wife.", "chunk_id": "fcc0f6c36b9c6443", "doc_id": "hp_48076015d5a62427", "type": "EXECUTIVE_PRODUCER_OF"}]</data>
