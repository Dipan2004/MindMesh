<node id="Binchuan">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A county that forms a tripoint with Heqing and Dali City, near Mount Jizu.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d2">[{"text": "The mountain is located to the northeast of Erhai and forms the tripoint of three counties: Heqing, Binchuan, and Dali City.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d3">["hp_b7298b1cd3170cc8"]</data>
  <data key="d4">False</data>
</node>
<node id="Dali City">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city that forms a tripoint with Heqing and Binchuan, near Mount Jizu.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
  <data key="d2">[{"text": "The mountain is located to the northeast of Erhai and forms the tripoint of three counties: Heqing, Binchuan, and Dali City.", "chunk_id": "d12957e9bb1b45a2", "doc_id": "hp_b7298b1cd3170cc8"}]</data>
