<node id="Madison Square Garden">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The venue in New York City where Michael Jackson orchestrated the concerts.", "chunk_id": "27c840a9f2ae6d8f", "doc_id": "hp_e324150cd91f309d"}]</data>
  <data key="d2">[{"text": "The show was edited from footage of two separate concerts Michael had orchestrated in New York City's Madison Square Garden on September 7 and September 10 of 2001.", "chunk_id": "27c840a9f2ae6d8f", "doc_id": "hp_e324150cd91f309d"}]</data>
  <data key="d3">["hp_e324150cd91f309d"]</data>
  <data key="d4">False</data>
</node>
