<node id="P. J. Skellerup">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An individual honored by the naming of Skellerup Glacier, who sponsored the Antarctic wing at Canterbury Museum and has a keen interest in scientific research.", "chunk_id": "24745fbcaed93050", "doc_id": "hp_ddd63b870a280fcc"}]</data>
  <data key="d2">[{"text": "Named in honor of P. J. Skellerup, who sponsored the Antarctic wing at Canterbury Museum.", "chunk_id": "24745fbcaed93050", "doc_id": "hp_ddd63b870a280fcc"}]</data>
