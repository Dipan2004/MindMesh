<node id="Alexander O'Neal">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Alexander O'Neal is an American R&amp;B singer, songwriter and arranger.", "chunk_id": "ce87e073e688d786", "doc_id": "hp_e581e2f559367c59"}]</data>
  <data key="d2">[{"text": "Alexander O'Neal (born November 15, 1953) is an American R&amp;B singer, songwriter and arranger from Natchez, Mississippi.", "chunk_id": "ce87e073e688d786", "doc_id": "hp_e581e2f559367c59"}]</data>
