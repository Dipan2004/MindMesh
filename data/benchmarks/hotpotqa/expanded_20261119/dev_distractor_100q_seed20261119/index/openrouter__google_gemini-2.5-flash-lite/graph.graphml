  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Friendship is a theme that was assigned to episodes of Boogie Woogie.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}]</data>
  <data key="d2">[{"text": "In the earlier seasons, the judges assigned various themes to episodes, including Bollywood, Horror, Friendship among others.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}]</data>
