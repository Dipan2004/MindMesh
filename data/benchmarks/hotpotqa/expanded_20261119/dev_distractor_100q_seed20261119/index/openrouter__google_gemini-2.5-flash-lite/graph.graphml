<edge source="Trail Smoke Eaters" target="Allan Cup">
  <data key="d5">["WON"]</data>
  <data key="d6">The Trail Smoke Eaters won the Allan Cup in 1938 and 1962.</data>
  <data key="d7">[{"text": "The Smoke Eaters won their first Allan Cup in 1938; they won the 1939 World Ice Hockey Championships and the 1961 World Ice Hockey Championships; and they won another Allan Cup in 1962.", "chunk_id": "8c9123487c66f805", "doc_id": "hp_f23b02c7bab7a782", "type": "WON"}]</data>
