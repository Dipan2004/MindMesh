  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Rio Hondo College is a community college.", "chunk_id": "75ff884d3fae85e2", "doc_id": "hp_46658770e8628bf3"}]</data>
  <data key="d2">[{"text": "Rio Hondo College is a community college located in the city of Whittier, California, United States, named after the Rio Hondo.", "chunk_id": "75ff884d3fae85e2", "doc_id": "hp_46658770e8628bf3"}]</data>
