<node id="Hamilton County">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A county in Ohio.", "chunk_id": "491435d83c81db6f", "doc_id": "hp_0995ab48b33dc69d"}]</data>
  <data key="d2">[{"text": "Mount Notre Dame High School (often abbreviated MND or Mt. Notre Dame) is a private, all-female, college-preparatory high school in Reading, a city in Hamilton County, Ohio, north of Cincinnati, Ohio.", "chunk_id": "491435d83c81db6f", "doc_id": "hp_0995ab48b33dc69d"}]</data>
  <data key="d3">["hp_0995ab48b33dc69d"]</data>
  <data key="d4">False</data>
</node>
<node id="Ohio">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A state in the United States.", "chunk_id": "491435d83c81db6f", "doc_id": "hp_0995ab48b33dc69d"}, {"text": "A state in the United States through which Ohio State Route 60 travels.", "chunk_id": "015a08864b0b59a3", "doc_id": "hp_0fac18ff47357f6d"}, {"text": "A state in the United States where Dayton is located.", "chunk_id": "74d72822b81604a9", "doc_id": "hp_39b03b4ecdf340de"}, {"text": "Ohio is a state in the United States.", "chunk_id": "7430715d26fd6b11", "doc_id": "hp_7a28631371b5d588"}, {"text": "The state where Cincinnati is located.", "chunk_id": "1e58cf5b1819e294", "doc_id": "hp_8ad2a2590b2211df"}, {"text": "Ohio is a state in the United States.", "chunk_id": "bbb6119acb937cda", "doc_id": "hp_c38e964da8a4abbb"}, {"text": "Ohio is a state where Davey Tree is the largest employee-owned company.", "chunk_id": "a9e806e2d99c31d9", "doc_id": "hp_d2d8272fe5506239"}]</data>
  <data key="d2">[{"text": "Mount Notre Dame High School (often abbreviated MND or Mt. Notre Dame) is a private, all-female, college-preparatory high school in Reading, a city in Hamilton County, Ohio, north of Cincinnati, Ohio.", "chunk_id": "491435d83c81db6f", "doc_id": "hp_0995ab48b33dc69d"}, {"text": "Once known as Huron Road, Center Street runs current with Ohio State Route 511 and Ohio State Route 60, which travels the entire length of Ohio.", "chunk_id": "015a08864b0b59a3", "doc_id": "hp_0fac18ff47357f6d"}, {"text": "The Historic Inner East neighborhood is located in Dayton, Ohio, United States.", "chunk_id": "74d72822b81604a9", "doc_id": "hp_39b03b4ecdf340de"}, {"text": "East Walnut Hills is a neighborhood in Cincinnati, Ohio, United States.", "chunk_id": "7430715d26fd6b11", "doc_id": "hp_7a28631371b5d588"}, {"text": "Schmidt Field House is an on-campus arena at Xavier University in Cincinnati, Ohio.", "chunk_id": "1e58cf5b1819e294", "doc_id": "hp_8ad2a2590b2211df"}, {"text": "The Huffman Historic District is a historic neighborhood in eastern Dayton, Ohio, United States.", "chunk_id": "bbb6119acb937cda", "doc_id": "hp_c38e964da8a4abbb"}, {"text": "It has been employee owned since 1979 and is the largest employee-owned company in the state of Ohio and one of the top 20 largest in the United States.", "chunk_id": "a9e806e2d99c31d9", "doc_id": "hp_d2d8272fe5506239"}]</data>
  <data key="d3">["hp_0995ab48b33dc69d", "hp_0fac18ff47357f6d", "hp_39b03b4ecdf340de", "hp_7a28631371b5d588", "hp_8ad2a2590b2211df", "hp_c38e964da8a4abbb", "hp_d2d8272fe5506239"]</data>
  <data key="d4">False</data>
</node>
<node id="Cincinnati">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city in Ohio.", "chunk_id": "491435d83c81db6f", "doc_id": "hp_0995ab48b33dc69d"}, {"text": "Cincinnati is a city in Ohio, United States.", "chunk_id": "7430715d26fd6b11", "doc_id": "hp_7a28631371b5d588"}, {"text": "The city in Ohio where Xavier University is located.", "chunk_id": "1e58cf5b1819e294", "doc_id": "hp_8ad2a2590b2211df"}]</data>
  <data key="d2">[{"text": "Mount Notre Dame High School (often abbreviated MND or Mt. Notre Dame) is a private, all-female, college-preparatory high school in Reading, a city in Hamilton County, Ohio, north of Cincinnati, Ohio.", "chunk_id": "491435d83c81db6f", "doc_id": "hp_0995ab48b33dc69d"}, {"text": "East Walnut Hills is a neighborhood in Cincinnati, Ohio, United States.", "chunk_id": "7430715d26fd6b11", "doc_id": "hp_7a28631371b5d588"}, {"text": "Schmidt Field House is an on-campus arena at Xavier University in Cincinnati, Ohio.", "chunk_id": "1e58cf5b1819e294", "doc_id": "hp_8ad2a2590b2211df"}]</data>
  <data key="d3">["hp_0995ab48b33dc69d", "hp_7a28631371b5d588", "hp_8ad2a2590b2211df"]</data>
  <data key="d4">False</data>
</node>
<node id="Sisters of Notre Dame de Namur">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A religious congregation that runs Mount Notre Dame High School.", "chunk_id": "491435d83c81db6f", "doc_id": "hp_0995ab48b33dc69d"}, {"text": "The Sisters of Notre Dame de Namur founded Notre Dame High School for Girls in 1938.", "chunk_id": "e1f93f4fdb5e61f5", "doc_id": "hp_db88fb2791fae586"}, {"text": "A religious congregation that operates Notre Dame High School, Belmont.", "chunk_id": "62dbcbf4d4fa43a6", "doc_id": "hp_fc280682a135c497"}]</data>
  <data key="d2">[{"text": "The school is one of six all-female Catholic high schools in the Cincinnati area and the only that is run by the Sisters of Notre Dame de Namur as a part of the Archdiocese of Cincinnati.", "chunk_id": "491435d83c81db6f", "doc_id": "hp_0995ab48b33dc69d"}, {"text": "Notre Dame High School for Girls was founded in 1938 by the Sisters of Notre Dame de Namur and in 2009, was incorporated by the Archdiocese of Chicago, making it part of the St. Ferdinand Parish.", "chunk_id": "e1f93f4fdb5e61f5", "doc_id": "hp_db88fb2791fae586"}, {"text": "The school is operated by the Sisters of Notre Dame de Namur for the Archdiocese of San Francisco.", "chunk_id": "62dbcbf4d4fa43a6", "doc_id": "hp_fc280682a135c497"}]</data>
  <data key="d3">["hp_0995ab48b33dc69d", "hp_db88fb2791fae586", "hp_fc280682a135c497"]</data>
  <data key="d4">False</data>
</node>
<node id="Archdiocese of Cincinnati">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An ecclesiastical jurisdiction of the Catholic Church in the Cincinnati metropolitan area.", "chunk_id": "491435d83c81db6f", "doc_id": "hp_0995ab48b33dc69d"}]</data>
  <data key="d2">[{"text": "The school is one of six all-female Catholic high schools in the Cincinnati area and the only that is run by the Sisters of Notre Dame de Namur as a part of the Archdiocese of Cincinnati.", "chunk_id": "491435d83c81db6f", "doc_id": "hp_0995ab48b33dc69d"}]</data>
  <data key="d3">["hp_0995ab48b33dc69d"]</data>
  <data key="d4">False</data>
</node>
<node id="Magnolia virginiana">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Magnolia virginiana is a species of flowering plant in the family Magnoliaceae.", "chunk_id": "0b6a1717369be2d5", "doc_id": "hp_09965476daf9cc57"}]</data>
  <data key="d2">[{"text": "Magnolia virginiana", "chunk_id": "0b6a1717369be2d5", "doc_id": "hp_09965476daf9cc57"}]</data>
