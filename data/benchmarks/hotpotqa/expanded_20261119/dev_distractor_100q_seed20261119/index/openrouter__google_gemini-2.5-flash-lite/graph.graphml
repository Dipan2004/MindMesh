  <data key="d7">[{"text": "\"Running\" is the lead single by alternative rock band Evermore, taken from their second studio album, \"Real Life\" (July 2006).", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb", "type": "RELEASED"}, {"text": "\"Light Surrounding You\" is the second single by alternative rock band, Evermore, taken from their second studio album, \"Real Life\" (June 2006).", "chunk_id": "d4c212cc890b725d", "doc_id": "hp_b314ee58b364424a", "type": "PART_OF"}]</data>
  <data key="d8">hp_5a1e23a825efe5cb</data>
</edge>
<edge source="Evermore" target="Australia">
  <data key="d5">["SUCCESSFUL_IN"]</data>
  <data key="d6">Evermore had their most successful single in Australia with "Light Surrounding You".</data>
  <data key="d7">[{"text": "The song was released in October 2006 and peaked at No. 15 on the RIANZ Singles Chart in New Zealand and number one on the ARIA Singles Chart, making it Evermore's most successful single in Australia.", "chunk_id": "d4c212cc890b725d", "doc_id": "hp_b314ee58b364424a", "type": "SUCCESSFUL_IN"}]</data>
  <data key="d8">hp_b314ee58b364424a</data>
</edge>
