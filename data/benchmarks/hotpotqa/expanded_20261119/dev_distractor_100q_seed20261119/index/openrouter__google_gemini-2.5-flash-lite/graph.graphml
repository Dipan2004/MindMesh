<node id="Polaskia chende">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A peculiar chinoa or chende cactus, which is a close relative of Stenocereus.", "chunk_id": "cfcc8f8ff86d83c3", "doc_id": "hp_dbf42d0cc7b618be"}]</data>
  <data key="d2">[{"text": "A close relative is the peculiar chinoa or chende cactus, \"Polaskia chende\".", "chunk_id": "cfcc8f8ff86d83c3", "doc_id": "hp_dbf42d0cc7b618be"}]</data>
  <data key="d3">["hp_dbf42d0cc7b618be"]</data>
  <data key="d4">False</data>
</node>
<node id="Computer repair technician">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A computer repair technician is a person who repairs and maintains computers and servers.", "chunk_id": "ef4743de89955cae", "doc_id": "hp_dc063fd42799d92d"}, {"text": "A profession involving the maintenance and repair of computer hardware and software.", "chunk_id": "681088037d9bda6f", "doc_id": "hp_e1233259446c427d"}]</data>
  <data key="d2">[{"text": "A computer repair technician is a person who repairs and maintains computers and servers.", "chunk_id": "ef4743de89955cae", "doc_id": "hp_dc063fd42799d92d"}, {"text": "Armin Meiwes ( ; born 1 December 1961) is a German computer repair technician who achieved international notoriety for killing and eating a voluntary victim whom he had found via the Internet.", "chunk_id": "681088037d9bda6f", "doc_id": "hp_e1233259446c427d"}]</data>
  <data key="d3">["hp_dc063fd42799d92d", "hp_e1233259446c427d"]</data>
  <data key="d4">False</data>
</node>
<node id="computers">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Computers are electronic devices that process data.", "chunk_id": "ef4743de89955cae", "doc_id": "hp_dc063fd42799d92d"}]</data>
  <data key="d2">[{"text": "A computer repair technician is a person who repairs and maintains computers and servers.", "chunk_id": "ef4743de89955cae", "doc_id": "hp_dc063fd42799d92d"}]</data>
  <data key="d3">["hp_dc063fd42799d92d"]</data>
  <data key="d4">False</data>
</node>
<node id="servers">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Servers are powerful computers that provide services to other computers.", "chunk_id": "ef4743de89955cae", "doc_id": "hp_dc063fd42799d92d"}]</data>
  <data key="d2">[{"text": "A computer repair technician is a person who repairs and maintains computers and servers.", "chunk_id": "ef4743de89955cae", "doc_id": "hp_dc063fd42799d92d"}]</data>
  <data key="d3">["hp_dc063fd42799d92d"]</data>
  <data key="d4">False</data>
</node>
<node id="hardware">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Hardware refers to the physical components of a computer system.", "chunk_id": "ef4743de89955cae", "doc_id": "hp_dc063fd42799d92d"}]</data>
  <data key="d2">[{"text": "The technician's responsibilities may extend to include building or configuring new hardware, installing and updating software packages, and creating and maintaining computer networks.", "chunk_id": "ef4743de89955cae", "doc_id": "hp_dc063fd42799d92d"}]</data>
  <data key="d3">["hp_dc063fd42799d92d"]</data>
  <data key="d4">False</data>
</node>
<node id="software packages">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Software packages are collections of computer programs designed to perform specific tasks.", "chunk_id": "ef4743de89955cae", "doc_id": "hp_dc063fd42799d92d"}]</data>
  <data key="d2">[{"text": "The technician's responsibilities may extend to include building or configuring new hardware, installing and updating software packages, and creating and maintaining computer networks.", "chunk_id": "ef4743de89955cae", "doc_id": "hp_dc063fd42799d92d"}]</data>
  <data key="d3">["hp_dc063fd42799d92d"]</data>
  <data key="d4">False</data>
</node>
<node id="Atherosperma moschatum">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Atherosperma moschatum is an evergreen tree native to the cool temperate rainforests of Tasmania, Victoria, and New South Wales in Australia.", "chunk_id": "e1044c549e97de7c", "doc_id": "hp_dce12d59ef968ea1"}]</data>
  <data key="d2">[{"text": "Atherosperma moschatum, the southern sassafras or blackheart sassafras, is an evergreen tree native to the cool temperate rainforests of Tasmania, Victoria, and New South Wales in Australia.", "chunk_id": "e1044c549e97de7c", "doc_id": "hp_dce12d59ef968ea1"}]</data>
  <data key="d3">["hp_dce12d59ef968ea1"]</data>
  <data key="d4">False</data>
</node>
