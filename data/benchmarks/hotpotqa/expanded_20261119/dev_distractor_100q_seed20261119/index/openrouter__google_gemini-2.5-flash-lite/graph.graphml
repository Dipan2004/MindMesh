<node id="Mexico">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The country where Fernando Fernández was born and died.", "chunk_id": "f22987b0a2a07a86", "doc_id": "hp_0a82eabb231d743f"}, {"text": "Mexico is a country where Pinguicula moranensis is native to.", "chunk_id": "c64585feaab7ebe5", "doc_id": "hp_32c049306a94f329"}, {"text": "Mexico is a country where Megalorhipida dulcis is known from.", "chunk_id": "1d65390cf7063363", "doc_id": "hp_36690b48d45f1e4b"}, {"text": "Mexico is a country where Leucophyllum is native.", "chunk_id": "d3f92c958cb5561c", "doc_id": "hp_51931a701df55281"}, {"text": "Mexico is a country where Oaxaca is located and is the native habitat of Salvia divinorum.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}, {"text": "Mexico is a country of origin for Pinguicula orchidioides.", "chunk_id": "1184555da09f3dbe", "doc_id": "hp_6a6940496f3fa2b9"}, {"text": "Mexico is a country where the State of Mexico is located and where the species Agave ghiesbreghtii is endemic.", "chunk_id": "4b63b68e70b8a72b", "doc_id": "hp_b6c911ef5c542694"}, {"text": "A country in North America.", "chunk_id": "cfcc8f8ff86d83c3", "doc_id": "hp_dbf42d0cc7b618be"}, {"text": "A country where Xóchitl Hamada has worked for most of her professional wrestling career.", "chunk_id": "beab562ef9fe8887", "doc_id": "hp_e53c480ef8a45aab"}, {"text": "Mexico is a country where Weldenia candida originally grows.", "chunk_id": "8fba6fc0a1ff107a", "doc_id": "hp_ead206f3625040bb"}, {"text": "A country in North America.", "chunk_id": "ae8a20956c4e25a8", "doc_id": "hp_f73d55cc65e5508e"}]</data>
  <data key="d2">[{"text": "He was born on November 9, 1916, in Monterrey, Mexico, and died in Mexico City, Mexico, on November 24, 1999.", "chunk_id": "f22987b0a2a07a86", "doc_id": "hp_0a82eabb231d743f"}, {"text": "Pinguicula moranensis is a perennial rosette-forming insectivorous herb native to Mexico and Guatemala.", "chunk_id": "c64585feaab7ebe5", "doc_id": "hp_32c049306a94f329"}, {"text": "Megalorhipida dulcis is a species of moth in the genus \"Megalorhipida\", known from Belize, Costa Rica, and Mexico.", "chunk_id": "1d65390cf7063363", "doc_id": "hp_36690b48d45f1e4b"}, {"text": "Leucophyllum (barometer bush or barometerbush) is a genus of evergreen shrubs in the figwort family, Scrophulariaceae, native to the southwestern United States and Mexico.", "chunk_id": "d3f92c958cb5561c", "doc_id": "hp_51931a701df55281"}, {"text": "Its native habitat is in cloud forest in the isolated Sierra Mazateca of Oaxaca, Mexico, where it grows in shady and moist locations.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}, {"text": "Pinguicula orchidioides is a perennial rosette-forming insectivorous herb native to Mexico and Guatemala.", "chunk_id": "1184555da09f3dbe", "doc_id": "hp_6a6940496f3fa2b9"}, {"text": "The species is endemic in Guatemala and the State of Mexico in Mexico.", "chunk_id": "4b63b68e70b8a72b", "doc_id": "hp_b6c911ef5c542694"}, {"text": "Stenocereus (Gk. stenos, narrow, L. cereus, candle) is a genus of columnar or tree-like cacti from the Baja California Peninsula and other parts of Mexico, Arizona in the United States, Colombia, Costa Rica, Guatemala, Venezuela and the ABC islands of the Dutch Caribbean.", "chunk_id": "cfcc8f8ff86d83c3", "doc_id": "hp_dbf42d0cc7b618be"}, {"text": "Hamada has worked for most of her professional wrestling career in Mexico, making occasional appearances in her father's home country of Japan.", "chunk_id": "beab562ef9fe8887", "doc_id": "hp_e53c480ef8a45aab"}, {"text": "It has one single species: Weldenia candida, which grows originally in Mexico and Guatemala.", "chunk_id": "8fba6fc0a1ff107a", "doc_id": "hp_ead206f3625040bb"}, {"text": "Philadelphus mexicanus is a shrub belonging to the genus \"Philadelphus\", native to Mexico and Guatemala.", "chunk_id": "ae8a20956c4e25a8", "doc_id": "hp_f73d55cc65e5508e"}]</data>
  <data key="d3">["hp_0a82eabb231d743f", "hp_32c049306a94f329", "hp_36690b48d45f1e4b", "hp_51931a701df55281", "hp_5b549ddaeafe9045", "hp_6a6940496f3fa2b9", "hp_b6c911ef5c542694", "hp_dbf42d0cc7b618be", "hp_e53c480ef8a45aab", "hp_ead206f3625040bb", "hp_f73d55cc65e5508e"]</data>
  <data key="d4">False</data>
</node>
