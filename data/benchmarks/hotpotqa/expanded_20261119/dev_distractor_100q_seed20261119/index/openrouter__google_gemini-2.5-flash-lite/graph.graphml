  <data key="d2">[{"text": "He willed his fortune to the Hoch Conservatory Foundation, founded in 1878 in Frankfurt.", "chunk_id": "43c8b1224e31b404", "doc_id": "hp_a82ec9e667a313c7"}]</data>
