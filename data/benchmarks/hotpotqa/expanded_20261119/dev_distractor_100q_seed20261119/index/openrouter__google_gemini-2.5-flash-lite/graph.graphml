<node id="6.5 GWh">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "6.5 GWh is the annual power generation of the Jiangxia Tidal Power Station.", "chunk_id": "ff0f3f2e384a3a68", "doc_id": "hp_49bb33ee8514f5e2"}]</data>
  <data key="d2">[{"text": "The facility generates up to 6.5 GWh of power annually.", "chunk_id": "ff0f3f2e384a3a68", "doc_id": "hp_49bb33ee8514f5e2"}]</data>
  <data key="d3">["hp_49bb33ee8514f5e2"]</data>
