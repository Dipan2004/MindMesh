<node id="André Bauchant">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "André Bauchant designed the scenery and costumes for the ballet Apollo.", "chunk_id": "7d4e3a512ec3ac2c", "doc_id": "hp_9db3a175e11b24ac"}]</data>
  <data key="d2">[{"text": "The scenery and costumes were designed by André Bauchant, with new costumes by Coco Chanel in 1929.", "chunk_id": "7d4e3a512ec3ac2c", "doc_id": "hp_9db3a175e11b24ac"}]</data>
  <data key="d3">["hp_9db3a175e11b24ac"]</data>
