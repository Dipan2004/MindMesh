<node id="1989 Individual Speedway World Championship">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 1989 Individual Speedway World Championship was the 45th Speedway World Championship held since it was first held in 1936.", "chunk_id": "2c62b8e41effed53", "doc_id": "hp_e15a8d4e4eeaa41c"}]</data>
  <data key="d2">[{"text": "The 1989 Individual Speedway World Championship was the 45th Speedway World Championship held since it was first held in 1936.", "chunk_id": "2c62b8e41effed53", "doc_id": "hp_e15a8d4e4eeaa41c"}]</data>
