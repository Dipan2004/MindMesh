<node id="Ninja Tune">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Ninja Tune is an English independent record label.", "chunk_id": "86dbbff6a0d26c75", "doc_id": "hp_417d28d6df2c046e"}, {"text": "Ninja Tune is an independent record label that The Cinematic Orchestra is signed to.", "chunk_id": "596bf9fd0feb5196", "doc_id": "hp_8dde32505087a9ed"}, {"text": "A British-based independent record label.", "chunk_id": "a3f3558032a172fb", "doc_id": "hp_d7e95e82b9681f40"}]</data>
  <data key="d2">[{"text": "Ninja Tune is an English independent record label based in London.", "chunk_id": "86dbbff6a0d26c75", "doc_id": "hp_417d28d6df2c046e"}, {"text": "The group is signed to independent record label Ninja Tune.", "chunk_id": "596bf9fd0feb5196", "doc_id": "hp_8dde32505087a9ed"}, {"text": "It was released under the British-based independent record label Ninja Tune.", "chunk_id": "a3f3558032a172fb", "doc_id": "hp_d7e95e82b9681f40"}]</data>
  <data key="d3">["hp_417d28d6df2c046e", "hp_8dde32505087a9ed", "hp_d7e95e82b9681f40"]</data>
  <data key="d4">False</data>
</node>
<node id="Los Angeles">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Los Angeles is a location where Ninja Tune has a satellite office.", "chunk_id": "86dbbff6a0d26c75", "doc_id": "hp_417d28d6df2c046e"}, {"text": "A city in California that hosted the 2014 World's Strongest Man event.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}, {"text": "The city where the footage for Michael Jackson's This Is It was filmed.", "chunk_id": "e8f7b78282274913", "doc_id": "hp_7df09ceedd2a307f"}, {"text": "Los Angeles is a city in California where Marty Belafsky was born.", "chunk_id": "fc0023c8ca0ec81c", "doc_id": "hp_9355db235edf3f84"}, {"text": "Los Angeles is a city in California where the band Brides of Destruction was formed.", "chunk_id": "d7b89ee6722d4043", "doc_id": "hp_dfded5f3a8af70af"}, {"text": "A city in California where the band Edward Sharpe and the Magnetic Zeros was formed.", "chunk_id": "508eaa5477ac7bce", "doc_id": "hp_f98356ff88ddd6a3"}]</data>
  <data key="d2">[{"text": "It has satellite offices in Los Angeles and Montreal.", "chunk_id": "86dbbff6a0d26c75", "doc_id": "hp_417d28d6df2c046e"}, {"text": "The event was held at the Commerce Casino in Los Angeles, California, the same host city as the 2012 World's Strongest Man contest.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}, {"text": "The footage was filmed in Los Angeles at the Staples Center and The Forum, and features a clip from East Rutherford's Arena where Jackson publicly announced the concert series.", "chunk_id": "e8f7b78282274913", "doc_id": "hp_7df09ceedd2a307f"}, {"text": "Marty Belafsky (born September 19, 1975) is an American actor/comedian born in Los Angeles, California.", "chunk_id": "fc0023c8ca0ec81c", "doc_id": "hp_9355db235edf3f84"}, {"text": "Brides of Destruction was a short-lived American hard rock supergroup from Los Angeles, California, formed in 2002.", "chunk_id": "d7b89ee6722d4043", "doc_id": "hp_dfded5f3a8af70af"}, {"text": "Edward Sharpe and the Magnetic Zeros is an American folk rock band formed in Los Angeles, California in 2007.", "chunk_id": "508eaa5477ac7bce", "doc_id": "hp_f98356ff88ddd6a3"}]</data>
  <data key="d3">["hp_417d28d6df2c046e", "hp_5d64f24bd8d85ba4", "hp_7df09ceedd2a307f", "hp_9355db235edf3f84", "hp_dfded5f3a8af70af", "hp_f98356ff88ddd6a3"]</data>
  <data key="d4">False</data>
</node>
