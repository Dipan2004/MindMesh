<node id="Legal name">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The name that identifies a person for legal, administrative and other official purposes.", "chunk_id": "9eb7211bf3daab76", "doc_id": "hp_06aa9978faa836b4"}]</data>
  <data key="d2">[{"text": "Legal name is the name that identifies a person for legal, administrative and other official purposes.", "chunk_id": "9eb7211bf3daab76", "doc_id": "hp_06aa9978faa836b4"}]</data>
  <data key="d3">["hp_06aa9978faa836b4"]</data>
  <data key="d4">False</data>
</node>
<node id="person">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An individual human being.", "chunk_id": "9eb7211bf3daab76", "doc_id": "hp_06aa9978faa836b4"}]</data>
  <data key="d2">[{"text": "Legal name is the name that identifies a person for legal, administrative and other official purposes.", "chunk_id": "9eb7211bf3daab76", "doc_id": "hp_06aa9978faa836b4"}]</data>
  <data key="d3">["hp_06aa9978faa836b4"]</data>
  <data key="d4">False</data>
</node>
<node id="birth name">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The name of a person that was given for the purpose of registration of the birth and which then appears on a birth certificate.", "chunk_id": "9eb7211bf3daab76", "doc_id": "hp_06aa9978faa836b4"}]</data>
  <data key="d2">[{"text": "A person's first legal name generally is the name of the person that was given for the purpose of registration of the birth and which then appears on a birth certificate (see \"birth name\"), but may change subsequently.", "chunk_id": "9eb7211bf3daab76", "doc_id": "hp_06aa9978faa836b4"}]</data>
  <data key="d3">["hp_06aa9978faa836b4"]</data>
  <data key="d4">False</data>
</node>
<node id="jurisdictions">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Areas over which a legal authority extends.", "chunk_id": "9eb7211bf3daab76", "doc_id": "hp_06aa9978faa836b4"}]</data>
  <data key="d2">[{"text": "Most jurisdictions require the use of a legal name for all legal and administrative purposes, and some jurisdictions permit or require a name change to be recorded at marriage.", "chunk_id": "9eb7211bf3daab76", "doc_id": "hp_06aa9978faa836b4"}]</data>
  <data key="d3">["hp_06aa9978faa836b4"]</data>
  <data key="d4">False</data>
</node>
<node id="marriage">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The legally or formally recognized union of two people as partners in a personal relationship.", "chunk_id": "9eb7211bf3daab76", "doc_id": "hp_06aa9978faa836b4"}]</data>
  <data key="d2">[{"text": "Most jurisdictions require the use of a legal name for all legal and administrative purposes, and some jurisdictions permit or require a name change to be recorded at marriage.", "chunk_id": "9eb7211bf3daab76", "doc_id": "hp_06aa9978faa836b4"}]</data>
  <data key="d3">["hp_06aa9978faa836b4"]</data>
  <data key="d4">False</data>
</node>
<node id="government issued documents">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Official documents issued by a government entity.", "chunk_id": "9eb7211bf3daab76", "doc_id": "hp_06aa9978faa836b4"}]</data>
  <data key="d2">[{"text": "The legal name may need to be used on various government issued documents (e.g., a court order).", "chunk_id": "9eb7211bf3daab76", "doc_id": "hp_06aa9978faa836b4"}]</data>
  <data key="d3">["hp_06aa9978faa836b4"]</data>
  <data key="d4">False</data>
</node>
<node id="court order">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An authoritative directive or command from a judge or court.", "chunk_id": "9eb7211bf3daab76", "doc_id": "hp_06aa9978faa836b4"}]</data>
  <data key="d2">[{"text": "The legal name may need to be used on various government issued documents (e.g., a court order).", "chunk_id": "9eb7211bf3daab76", "doc_id": "hp_06aa9978faa836b4"}]</data>
  <data key="d3">["hp_06aa9978faa836b4"]</data>
  <data key="d4">False</data>
</node>
<node id="Gene Bleymaier">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Gene Bleymaier is an American university administrator.", "chunk_id": "c61e317be1f763fa", "doc_id": "hp_070129db81e76e31"}]</data>
  <data key="d2">[{"text": "Eugene Anthony Bleymaier (born 1953) is an American university administrator who was most recently special advisor to the president at San Jose State University.", "chunk_id": "c61e317be1f763fa", "doc_id": "hp_070129db81e76e31"}]</data>
  <data key="d3">["hp_070129db81e76e31"]</data>
  <data key="d4">False</data>
</node>
<node id="San Jose State University">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "San Jose State University is a university where Gene Bleymaier served as special advisor to the president and athletic director.", "chunk_id": "c61e317be1f763fa", "doc_id": "hp_070129db81e76e31"}]</data>
  <data key="d2">[{"text": "Eugene Anthony Bleymaier (born 1953) is an American university administrator who was most recently special advisor to the president at San Jose State University.", "chunk_id": "c61e317be1f763fa", "doc_id": "hp_070129db81e76e31"}]</data>
  <data key="d3">["hp_070129db81e76e31"]</data>
  <data key="d4">False</data>
</node>
<node id="Boise State University">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Boise State University is a university where Gene Bleymaier served as athletic director.", "chunk_id": "c61e317be1f763fa", "doc_id": "hp_070129db81e76e31"}]</data>
  <data key="d2">[{"text": "Bleymaier was previously an athletic director, first at Boise State University from 1982 to 2011 and San Jose State from 2012 to 2017.", "chunk_id": "c61e317be1f763fa", "doc_id": "hp_070129db81e76e31"}]</data>
  <data key="d3">["hp_070129db81e76e31"]</data>
  <data key="d4">False</data>
</node>
<node id="Leo Braudy">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Leo Braudy is a University Professor and Bing Professor of English at the University of Southern California.", "chunk_id": "1757b3783d9ce887", "doc_id": "hp_071ac294ee5ab8f4"}]</data>
  <data key="d2">[{"text": "Leo Braudy (born June 11, 1941) is University Professor and Bing Professor of English at the University of Southern California, where he teaches 17th- and 18th-century English literature, film history and criticism, and American culture.", "chunk_id": "1757b3783d9ce887", "doc_id": "hp_071ac294ee5ab8f4"}]</data>
  <data key="d3">["hp_071ac294ee5ab8f4"]</data>
  <data key="d4">False</data>
</node>
<node id="University of Southern California">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The University of Southern California is where Leo Braudy teaches.", "chunk_id": "1757b3783d9ce887", "doc_id": "hp_071ac294ee5ab8f4"}, {"text": "An educational institution where Anil Srinivasan was educated.", "chunk_id": "054fd83d35ee6361", "doc_id": "hp_39d1d2299826213a"}]</data>
  <data key="d2">[{"text": "Leo Braudy (born June 11, 1941) is University Professor and Bing Professor of English at the University of Southern California, where he teaches 17th- and 18th-century English literature, film history and criticism, and American culture.", "chunk_id": "1757b3783d9ce887", "doc_id": "hp_071ac294ee5ab8f4"}, {"text": "Born in Chennai, India and educated at the University of Southern California and at Columbia University, New York, he is well known for his collaborative work with Carnatic vocalist Sikkil Gurucharan.", "chunk_id": "054fd83d35ee6361", "doc_id": "hp_39d1d2299826213a"}]</data>
  <data key="d3">["hp_071ac294ee5ab8f4", "hp_39d1d2299826213a"]</data>
  <data key="d4">False</data>
</node>
<node id="Yale">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Yale is a university where Leo Braudy has previously taught.", "chunk_id": "1757b3783d9ce887", "doc_id": "hp_071ac294ee5ab8f4"}]</data>
  <data key="d2">[{"text": "He has previously taught at Yale, Columbia, and Johns Hopkins University.", "chunk_id": "1757b3783d9ce887", "doc_id": "hp_071ac294ee5ab8f4"}]</data>
  <data key="d3">["hp_071ac294ee5ab8f4"]</data>
  <data key="d4">False</data>
</node>
<node id="Columbia">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Columbia is a university where Leo Braudy has previously taught.", "chunk_id": "1757b3783d9ce887", "doc_id": "hp_071ac294ee5ab8f4"}, {"text": "A record label that handled all of Alice in Chains' previous releases.", "chunk_id": "a02521ae2928a8dd", "doc_id": "hp_7e9f73906e63aaa8"}]</data>
  <data key="d2">[{"text": "He has previously taught at Yale, Columbia, and Johns Hopkins University.", "chunk_id": "1757b3783d9ce887", "doc_id": "hp_071ac294ee5ab8f4"}, {"text": "It is the first Alice in Chains album released on Virgin Records and their first venture away from Columbia, who handled all of their previous releases.", "chunk_id": "a02521ae2928a8dd", "doc_id": "hp_7e9f73906e63aaa8"}]</data>
  <data key="d3">["hp_071ac294ee5ab8f4", "hp_7e9f73906e63aaa8"]</data>
  <data key="d4">False</data>
</node>
<node id="Johns Hopkins University">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Johns Hopkins University is a university where Leo Braudy has previously taught.", "chunk_id": "1757b3783d9ce887", "doc_id": "hp_071ac294ee5ab8f4"}]</data>
  <data key="d2">[{"text": "He has previously taught at Yale, Columbia, and Johns Hopkins University.", "chunk_id": "1757b3783d9ce887", "doc_id": "hp_071ac294ee5ab8f4"}]</data>
  <data key="d3">["hp_071ac294ee5ab8f4"]</data>
  <data key="d4">False</data>
</node>
<node id="cultural studies">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Cultural studies is a field in which Leo Braudy is known for his scholarship.", "chunk_id": "1757b3783d9ce887", "doc_id": "hp_071ac294ee5ab8f4"}]</data>
  <data key="d2">[{"text": "He is best known for his cultural studies scholarship on celebrity, masculinity, and film, and is frequently sought after for interviews on popular culture, Hollywood cinema, and the American zeitgeist of the 1950s.", "chunk_id": "1757b3783d9ce887", "doc_id": "hp_071ac294ee5ab8f4"}]</data>
  <data key="d3">["hp_071ac294ee5ab8f4"]</data>
