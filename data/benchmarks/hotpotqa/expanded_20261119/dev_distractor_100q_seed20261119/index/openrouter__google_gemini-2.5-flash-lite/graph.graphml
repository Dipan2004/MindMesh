</node>
<node id="David Byrne">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A musician who co-wrote music with Brian Eno and performed in the Songs of David Byrne and Brian Eno Tour.", "chunk_id": "081d5098b0d99266", "doc_id": "hp_3dfebde99dcc4f0d"}, {"text": "A musician who conducted the Songs of David Byrne and Brian Eno Tour.", "chunk_id": "df7ef40b10735576", "doc_id": "hp_53b8f4d54167f70d"}, {"text": "A Scottish-born American musician, founding member, principal songwriter, lead singer, and guitarist of Talking Heads.", "chunk_id": "46b571411ec4e1b3", "doc_id": "hp_c009c82a5deffa31"}]</data>
  <data key="d2">[{"text": "The Songs of David Byrne and Brian Eno Tour is a 2008–2009 promotional concert tour of music co-written by David Byrne and Brian Eno with performances by Byrne.", "chunk_id": "081d5098b0d99266", "doc_id": "hp_3dfebde99dcc4f0d"}, {"text": "Ride, Rise, Roar is a documentary film chronicling the Songs of David Byrne and Brian Eno Tour conducted by David Byrne in 2008–2009.", "chunk_id": "df7ef40b10735576", "doc_id": "hp_53b8f4d54167f70d"}, {"text": "David Byrne ( ; born 14 May 1952) is a Scottish-born American musician who was the founding member, principal songwriter, and lead singer and guitarist of the American new wave band Talking Heads, active between 1975 and 1991.", "chunk_id": "46b571411ec4e1b3", "doc_id": "hp_c009c82a5deffa31"}]</data>
  <data key="d3">["hp_3dfebde99dcc4f0d", "hp_53b8f4d54167f70d", "hp_c009c82a5deffa31"]</data>
  <data key="d4">False</data>
</node>
