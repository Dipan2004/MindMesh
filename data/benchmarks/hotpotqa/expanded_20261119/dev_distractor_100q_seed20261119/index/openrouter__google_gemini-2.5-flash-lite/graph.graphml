<node id="Idaho">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A state in the Pacific Coast region that was part of Standard Oil of Iowa's marketing area.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}]</data>
  <data key="d2">[{"text": "Standard Oil Company of Iowa was created in 1885 as a subsidiary of the Standard Oil Trust to handle marketing along the Pacific Coast states of Idaho, Oregon, Washington, California, and Arizona.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}]</data>
  <data key="d3">["hp_777b99a15f2523b1"]</data>
  <data key="d4">False</data>
</node>
<node id="Oregon">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A state in the Pacific Coast region that was part of Standard Oil of Iowa's marketing area.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}]</data>
  <data key="d2">[{"text": "Standard Oil Company of Iowa was created in 1885 as a subsidiary of the Standard Oil Trust to handle marketing along the Pacific Coast states of Idaho, Oregon, Washington, California, and Arizona.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}]</data>
  <data key="d3">["hp_777b99a15f2523b1"]</data>
  <data key="d4">False</data>
</node>
<node id="Standard Oil of California">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A company formed in 1877 that was not associated with the Standard Oil Trust.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}]</data>
  <data key="d2">[{"text": "A prior company named Standard Oil of California had been formed in 1877, and was not associated with the Standard Oil Trust.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}]</data>
  <data key="d3">["hp_777b99a15f2523b1"]</data>
  <data key="d4">False</data>
</node>
<node id="Chevron Oil Company">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A company that was later formed from the assets of Standard Oil of Iowa.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}]</data>
  <data key="d2">[{"text": "In 1906, Standard Oil of Iowa was dissolved and its assets handed over to a new Standard Oil of California, later Chevron Oil Company, and now the Chevron Corporation.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}]</data>
  <data key="d3">["hp_777b99a15f2523b1"]</data>
  <data key="d4">False</data>
</node>
<node id="Chevron Corporation">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The current name of the company that evolved from Standard Oil of Iowa.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}]</data>
  <data key="d2">[{"text": "In 1906, Standard Oil of Iowa was dissolved and its assets handed over to a new Standard Oil of California, later Chevron Oil Company, and now the Chevron Corporation.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}]</data>
  <data key="d3">["hp_777b99a15f2523b1"]</data>
  <data key="d4">False</data>
</node>
<node id="Iowa">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A midwestern state for which Standard Oil of Iowa was named, but not a primary marketing area.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}]</data>
  <data key="d2">[{"text": "Though named for the midwestern state, it never included Iowa as one of its primary marketing areas.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1"}]</data>
  <data key="d3">["hp_777b99a15f2523b1"]</data>
