<edge source="United States Food and Drug Administration" target="Electroconvulsive therapy">
  <data key="d5">["CATEGORIZED"]</data>
  <data key="d6">The United States Food and Drug Administration placed ECT machines in the Class III category.</data>
  <data key="d7">[{"text": "ECT machines have been placed in the Class III category (high risk) by the United States Food and Drug Administration (FDA) since 1976.", "chunk_id": "3217d56af62a1f79", "doc_id": "hp_1dfa7f266b4cbbfd", "type": "CATEGORIZED"}]</data>
  <data key="d8">hp_1dfa7f266b4cbbfd</data>
</edge>
