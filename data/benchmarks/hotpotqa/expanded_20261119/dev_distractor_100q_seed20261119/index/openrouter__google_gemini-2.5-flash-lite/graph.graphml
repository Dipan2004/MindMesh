<node id="Fernando da Costa Leal">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A 19th-century Portuguese geologist after whom the scientific name Pachypodium lealii is derived.", "chunk_id": "6be220bfddc2114d", "doc_id": "hp_c0400b095de3dd7b"}]</data>
  <data key="d2">[{"text": "The scientific name derives from the 19th century Portuguese geologist Fernando da Costa Leal, who described the Bottle tree during an exploration in southern Angola.", "chunk_id": "6be220bfddc2114d", "doc_id": "hp_c0400b095de3dd7b"}]</data>
  <data key="d3">["hp_c0400b095de3dd7b"]</data>
  <data key="d4">False</data>
</node>
