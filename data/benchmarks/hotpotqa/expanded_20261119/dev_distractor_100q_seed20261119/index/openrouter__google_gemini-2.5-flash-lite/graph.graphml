<node id="Alma Moodie">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Alma Moodie was an Australian violinist who established an excellent reputation in Germany in the 1920s and 1930s.", "chunk_id": "5978fb5d2c7a87fb", "doc_id": "hp_ac759163e3bcf4aa"}]</data>
  <data key="d2">[{"text": "Alma Templeton Moodie (12 September 18987 March 1943) was an Australian violinist who established an excellent reputation in Germany in the 1920s and 1930s.", "chunk_id": "5978fb5d2c7a87fb", "doc_id": "hp_ac759163e3bcf4aa"}]</data>
  <data key="d3">["hp_ac759163e3bcf4aa"]</data>
  <data key="d4">False</data>
</node>
<node id="Kurt Atterberg">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Kurt Atterberg was a composer whose violin concertos were premiered by Alma Moodie.", "chunk_id": "5978fb5d2c7a87fb", "doc_id": "hp_ac759163e3bcf4aa"}]</data>
  <data key="d2">[{"text": "She and Max Rostal were regarded as the greatest proponents of the Carl Flesch tradition.", "chunk_id": "5978fb5d2c7a87fb", "doc_id": "hp_ac759163e3bcf4aa"}]</data>
  <data key="d3">["hp_ac759163e3bcf4aa"]</data>
  <data key="d4">False</data>
</node>
<node id="Hans Pfitzner">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Hans Pfitzner was a composer whose violin concertos were premiered by Alma Moodie.", "chunk_id": "5978fb5d2c7a87fb", "doc_id": "hp_ac759163e3bcf4aa"}, {"text": "Hans Pfitzner was a pupil of Iwan Knorr.", "chunk_id": "902ae288e12f1dfb", "doc_id": "hp_d0d1ade1227af443"}]</data>
  <data key="d2">[{"text": "She and Max Rostal were regarded as the greatest proponents of the Carl Flesch tradition.", "chunk_id": "5978fb5d2c7a87fb", "doc_id": "hp_ac759163e3bcf4aa"}, {"text": "As a teacher he exerted great influence; among his pupils were Bernhard Sekles, Ernest Bloch, Vladimir Sokalskyi, Ernst Toch, Roger Quilter, Hans Pfitzner, and Cyril Scott.", "chunk_id": "902ae288e12f1dfb", "doc_id": "hp_d0d1ade1227af443"}]</data>
  <data key="d3">["hp_ac759163e3bcf4aa", "hp_d0d1ade1227af443"]</data>
  <data key="d4">False</data>
</node>
<node id="Ernst Krenek">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Ernst Krenek was a composer whose violin concertos were premiered by Alma Moodie.", "chunk_id": "5978fb5d2c7a87fb", "doc_id": "hp_ac759163e3bcf4aa"}]</data>
  <data key="d2">[{"text": "She and Max Rostal were regarded as the greatest proponents of the Carl Flesch tradition.", "chunk_id": "5978fb5d2c7a87fb", "doc_id": "hp_ac759163e3bcf4aa"}]</data>
  <data key="d3">["hp_ac759163e3bcf4aa"]</data>
