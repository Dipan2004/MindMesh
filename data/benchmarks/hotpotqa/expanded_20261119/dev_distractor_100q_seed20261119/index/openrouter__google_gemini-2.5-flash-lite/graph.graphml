  <data key="d2">[{"text": "The song \"Muddy, Sam, And Otis\", is his tribute to Muddy Waters, Sam Cooke, and Otis Redding.", "chunk_id": "ee3812aae430f03c", "doc_id": "hp_56786c080440345c"}]</data>
