  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An organization involved in a licensing dispute with Avalon Hill.", "chunk_id": "22da4e536a889168", "doc_id": "hp_9807d2b35cb4cca7"}]</data>
