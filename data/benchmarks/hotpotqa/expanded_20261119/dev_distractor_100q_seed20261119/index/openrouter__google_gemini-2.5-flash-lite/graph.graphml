</node>
<node id="Greatest Hits &amp; Remixes, Vol. 1">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Greatest Hits &amp; Remixes, Vol. 1 is an album by Paul Oakenfold.", "chunk_id": "0e3a5e1368eb79fe", "doc_id": "hp_c1e92b892fa0c36f"}]</data>
  <data key="d2">[{"text": "It was later included on Shifty Shellshock's 2004 album \"Happy Love Sick\", and Oakenfold's 2007 album \"Greatest Hits &amp; Remixes, Vol. 1\".", "chunk_id": "0e3a5e1368eb79fe", "doc_id": "hp_c1e92b892fa0c36f"}]</data>
