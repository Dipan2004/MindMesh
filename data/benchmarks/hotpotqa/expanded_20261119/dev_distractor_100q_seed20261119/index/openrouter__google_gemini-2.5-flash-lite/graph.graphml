</node>
<node id="MLS Cup 2010">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 15th edition of Major League Soccer's championship match.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}]</data>
  <data key="d2">[{"text": "MLS Cup 2010, the 15th edition of Major League Soccer's championship match, was played between the Colorado Rapids and FC Dallas to decide the champion of the 2010 season.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}]</data>
  <data key="d3">["hp_b8c5eba035057a5e"]</data>
  <data key="d4">False</data>
</node>
<node id="Macoumba Kandji">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A forward for the Colorado Rapids.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}]</data>
  <data key="d2">[{"text": "Colorado Rapids won 2–1 over Dallas on an own goal in extra time, as a shot by Rapids forward Macoumba Kandji was deflected on goal by Dallas defender George John.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}]</data>
  <data key="d3">["hp_b8c5eba035057a5e"]</data>
  <data key="d4">False</data>
</node>
<node id="George John">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A defender for FC Dallas.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}]</data>
  <data key="d2">[{"text": "Colorado Rapids won 2–1 over Dallas on an own goal in extra time, as a shot by Rapids forward Macoumba Kandji was deflected on goal by Dallas defender George John.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}]</data>
  <data key="d3">["hp_b8c5eba035057a5e"]</data>
  <data key="d4">False</data>
</node>
<node id="Syracuse University">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Syracuse University is a university in Syracuse, New York.", "chunk_id": "9a89f86e35e64ab2", "doc_id": "hp_b8ec94a3c00016f8"}]</data>
  <data key="d2">[{"text": "Archbold Gymnasium is a gymnasium located on the campus of Syracuse University in Syracuse, New York.", "chunk_id": "9a89f86e35e64ab2", "doc_id": "hp_b8ec94a3c00016f8"}]</data>
  <data key="d3">["hp_b8ec94a3c00016f8"]</data>
  <data key="d4">False</data>
</node>
<node id="Archbold Stadium">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Archbold Stadium was a stadium located to the west of Archbold Gymnasium.", "chunk_id": "9a89f86e35e64ab2", "doc_id": "hp_b8ec94a3c00016f8"}]</data>
  <data key="d2">[{"text": "It was built in 1908 with money donated by John Dustin Archbold, a major benefactor of the university, who also funded the building of Archbold Stadium, just to the west of the gymnasium (now the site of the Carrier Dome).", "chunk_id": "9a89f86e35e64ab2", "doc_id": "hp_b8ec94a3c00016f8"}]</data>
  <data key="d3">["hp_b8ec94a3c00016f8"]</data>
  <data key="d4">False</data>
</node>
<node id="Flanagan Gymnasium">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Flanagan Gymnasium is a neighboring gymnasium built in 1989.", "chunk_id": "9a89f86e35e64ab2", "doc_id": "hp_b8ec94a3c00016f8"}]</data>
  <data key="d2">[{"text": "The building was rebuilt from 1948 to 1949, and a southern addition was made in 1952, as well as a neighboring gymnasium (Flanagan Gymnasium), which was built in 1989.", "chunk_id": "9a89f86e35e64ab2", "doc_id": "hp_b8ec94a3c00016f8"}]</data>
  <data key="d3">["hp_b8ec94a3c00016f8"]</data>
  <data key="d4">False</data>
</node>
<node id="ROTC programs">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "ROTC programs are housed in Archbold Gymnasium.", "chunk_id": "9a89f86e35e64ab2", "doc_id": "hp_b8ec94a3c00016f8"}]</data>
  <data key="d2">[{"text": "The building now houses the school's ROTC programs, men's and women's rowing indoor facilities, as well as the bursar, financial aid services, aerospace studies and undergraduate processing.", "chunk_id": "9a89f86e35e64ab2", "doc_id": "hp_b8ec94a3c00016f8"}]</data>
  <data key="d3">["hp_b8ec94a3c00016f8"]</data>
  <data key="d4">False</data>
</node>
