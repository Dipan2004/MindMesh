  <data key="d7">[{"text": "In this battle, French troops of the Armée du Nord under Napoleon's command, defeated part of a Prussian army under Field Marshal Prince Blücher, near Ligny in present-day Belgium.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e", "type": "OCCURRED_NEAR"}]</data>
