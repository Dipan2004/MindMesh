  <data key="d2">[{"text": "The group, and its name, was a spoof on the popular group Bananarama and was introduced during the 1988 Christmas Special of \"French &amp; Saunders\", in which Burke was a guest.", "chunk_id": "c11c9287534c04db", "doc_id": "hp_57f0c97f7881985b"}]</data>
  <data key="d3">["hp_57f0c97f7881985b"]</data>
  <data key="d4">False</data>
</node>
<node id="George Seaton">
  <data key="d0">PERSON</data>
