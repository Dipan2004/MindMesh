  <data key="d7">[{"text": "She was closely associated with George Brecht, Jackson Mac Low, John Cage, Joe Jones, Nam June Paik, and Ay-O, other members of Fluxus.", "chunk_id": "bb303342f684188a", "doc_id": "hp_25e106b688a6f938", "type": "MEMBER_OF"}]</data>
  <data key="d8">hp_25e106b688a6f938</data>
