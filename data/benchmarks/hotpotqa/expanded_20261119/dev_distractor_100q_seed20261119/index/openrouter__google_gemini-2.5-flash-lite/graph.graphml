  <data key="d2">[{"text": "The show was hosted by Gerard Ekdom and Michiel Veenstra.", "chunk_id": "7d7d42e40a8d63a0", "doc_id": "hp_a0b6962ec4a5ec5a"}]</data>
  <data key="d3">["hp_a0b6962ec4a5ec5a"]</data>
