<node id="Fray Bartolomé de Las Casas">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A famous Spaniard Roman Catholic after whom Residencial Las Casas and a town in Mexico are named.", "chunk_id": "7866e8332647c234", "doc_id": "hp_b5b563a61951977c"}]</data>
  <data key="d2">[{"text": "It was named after the famous Spaniard Roman Catholic Fray Bartolomé de Las Casas, who also has a town named after him in Mexico, namely San Cristóbal de las Casas.", "chunk_id": "7866e8332647c234", "doc_id": "hp_b5b563a61951977c"}]</data>
