</node>
<node id="epaulette tree">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The epaulette tree is a common name for Pterostyrax hispidus.", "chunk_id": "5a4b1080849ca551", "doc_id": "hp_10ed6dd74595a5bc"}, {"text": "The epaulette tree is a common name for the genus Pterostyrax.", "chunk_id": "0ae20fe970e7c14c", "doc_id": "hp_a0fb254153ed3917"}]</data>
  <data key="d2">[{"text": "Pterostyrax hispidus, the epaulette tree or fragrant epaulette tree, is a species of flowering plant in the family Styracaceae, native to China and Japan.", "chunk_id": "5a4b1080849ca551", "doc_id": "hp_10ed6dd74595a5bc"}, {"text": "Pterostyrax, the epaulette tree, is a small genus of four species of deciduous large shrubs or small trees in the family Styracaceae, native to eastern Asia in China and Japan.", "chunk_id": "0ae20fe970e7c14c", "doc_id": "hp_a0fb254153ed3917"}]</data>
  <data key="d3">["hp_10ed6dd74595a5bc", "hp_a0fb254153ed3917"]</data>
