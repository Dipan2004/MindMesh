  <data key="d1">[{"text": "The National Football League, a professional American football league.", "chunk_id": "67993439885cea0d", "doc_id": "hp_49640c16e77d136e"}, {"text": "The National Football League, a professional American football league.", "chunk_id": "e487f13bc27a273e", "doc_id": "hp_ffc6a1fc4012397a"}]</data>
  <data key="d2">[{"text": "He played for the NFL Seattle Seahawks from 1977–1981, and is the only member of the Seahawks to wear the number 12.", "chunk_id": "67993439885cea0d", "doc_id": "hp_49640c16e77d136e"}, {"text": "As of the conclusion of the 2016-17 season, the Bengals have had 26 seasons without a playoff win - currently the longest streak in the NFL.", "chunk_id": "e487f13bc27a273e", "doc_id": "hp_ffc6a1fc4012397a"}]</data>
