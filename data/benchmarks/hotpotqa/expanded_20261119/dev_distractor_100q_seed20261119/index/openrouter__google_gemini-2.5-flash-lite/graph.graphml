<node id="Check My Brain">
  <data key="d0">SONG</data>
  <data key="d1">[{"text": "Check My Brain is a song by the American rock band Alice in Chains.", "chunk_id": "0ab7d428406248fd", "doc_id": "hp_62d25a1f81638a35"}, {"text": "A single from the album Black Gives Way to Blue that reached No. 1 on Billboard's Mainstream Rock Tracks and was the band's first #1 song on the Alternative Songs chart and on the Hot Rock Songs chart.", "chunk_id": "a02521ae2928a8dd", "doc_id": "hp_7e9f73906e63aaa8"}]</data>
  <data key="d2">[{"text": "\"Check My Brain\" is a song by the American rock band Alice in Chains, featured on their fourth studio album \"Black Gives Way to Blue\" (2009).", "chunk_id": "0ab7d428406248fd", "doc_id": "hp_62d25a1f81638a35"}, {"text": "\"Check My Brain\" and \"Your Decision\" reached No. 1 on Billboard's Mainstream Rock Tracks, while \"Lesson Learned\" reached No. 4.", "chunk_id": "a02521ae2928a8dd", "doc_id": "hp_7e9f73906e63aaa8"}]</data>
  <data key="d3">["hp_62d25a1f81638a35", "hp_7e9f73906e63aaa8"]</data>
  <data key="d4">False</data>
</node>
<node id="August 17, 2009">
  <data key="d0">DATE</data>
  <data key="d1">[{"text": "The release date of the single \"Check My Brain\".", "chunk_id": "0ab7d428406248fd", "doc_id": "hp_62d25a1f81638a35"}]</data>
  <data key="d2">[{"text": "It was released as the second single from the album on August 17, 2009.", "chunk_id": "0ab7d428406248fd", "doc_id": "hp_62d25a1f81638a35"}]</data>
  <data key="d3">["hp_62d25a1f81638a35"]</data>
  <data key="d4">False</data>
</node>
<node id="Billboard Hot Mainstream Rock Tracks">
  <data key="d0">CHART</data>
  <data key="d1">[{"text": "A music chart that tracks mainstream rock songs.", "chunk_id": "0ab7d428406248fd", "doc_id": "hp_62d25a1f81638a35"}]</data>
  <data key="d2">[{"text": "The single topped the \"Billboard\" Hot Mainstream Rock Tracks and \"Billboard\" Rock Songs charts in September 2009.", "chunk_id": "0ab7d428406248fd", "doc_id": "hp_62d25a1f81638a35"}]</data>
  <data key="d3">["hp_62d25a1f81638a35"]</data>
  <data key="d4">False</data>
</node>
<node id="September 2009">
  <data key="d0">DATE</data>
  <data key="d1">[{"text": "The month and year the single topped the Billboard charts.", "chunk_id": "0ab7d428406248fd", "doc_id": "hp_62d25a1f81638a35"}]</data>
  <data key="d2">[{"text": "The single topped the \"Billboard\" Hot Mainstream Rock Tracks and \"Billboard\" Rock Songs charts in September 2009.", "chunk_id": "0ab7d428406248fd", "doc_id": "hp_62d25a1f81638a35"}]</data>
  <data key="d3">["hp_62d25a1f81638a35"]</data>
  <data key="d4">False</data>
</node>
<node id="No Excuses">
  <data key="d0">SONG</data>
  <data key="d1">[{"text": "No Excuses is a single by Alice in Chains released in 1994.", "chunk_id": "0ab7d428406248fd", "doc_id": "hp_62d25a1f81638a35"}]</data>
  <data key="d2">[{"text": "This was the first time an Alice in Chains song would hit #1 on the Hot Mainstream Rock Tracks chart since their 1994 single \"No Excuses\".", "chunk_id": "0ab7d428406248fd", "doc_id": "hp_62d25a1f81638a35"}]</data>
  <data key="d3">["hp_62d25a1f81638a35"]</data>
  <data key="d4">False</data>
</node>
