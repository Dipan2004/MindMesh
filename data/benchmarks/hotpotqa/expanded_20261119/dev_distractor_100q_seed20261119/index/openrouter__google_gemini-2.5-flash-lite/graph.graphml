  <data key="d1">[{"text": "Murder, My Sweet is a 1944 film noir.", "chunk_id": "f4d99f18a4f175d5", "doc_id": "hp_cda28e9f1cb25d71"}]</data>
  <data key="d2">[{"text": "This is the second teaming of Powell and Dmytryk (after \"Murder, My Sweet\").", "chunk_id": "f4d99f18a4f175d5", "doc_id": "hp_cda28e9f1cb25d71"}]</data>
