  <data key="d2">[{"text": "The district is established between Town Creek and Vernon Avenue on the east side of Center Street and between the theater and Morgan Avenue on the west side.", "chunk_id": "015a08864b0b59a3", "doc_id": "hp_0fac18ff47357f6d"}]</data>
