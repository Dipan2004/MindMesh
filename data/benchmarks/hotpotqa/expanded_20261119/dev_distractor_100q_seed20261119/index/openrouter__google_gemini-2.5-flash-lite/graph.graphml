<edge source="Roger Federer" target="2013 Wimbledon Championships – Men's Singles">
  <data key="d5">["PARTICIPATED_IN"]</data>
  <data key="d6">Roger Federer was the defending champion of the 2013 Wimbledon Championships - Men's Singles.</data>
  <data key="d7">[{"text": "Roger Federer was the defending champion but lost in the second round to World No. 116 Sergiy Stakhovsky in a huge upset.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608", "type": "PARTICIPATED_IN"}]</data>
  <data key="d8">hp_0e39951795747608</data>
</edge>
<edge source="Roger Federer" target="2004 French Open">
  <data key="d5">["LOST_TO"]</data>
  <data key="d6">Roger Federer lost to Gustavo Kuerten in the third round of the 2004 French Open.</data>
  <data key="d7">[{"text": "Federer's loss marked the first time since the 2004 French Open, when he lost to Gustavo Kuerten in the third round, that he had failed to reach at least the quarterfinals in a Grand Slam event.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608", "type": "LOST_TO"}]</data>
  <data key="d8">hp_0e39951795747608</data>
</edge>
<edge source="Roger Federer" target="Grand Slam event">
  <data key="d5">["FAILED_TO_REACH_QUARTERFINALS_IN"]</data>
  <data key="d6">Roger Federer failed to reach at least the quarterfinals in a Grand Slam event after his loss in the 2004 French Open.</data>
  <data key="d7">[{"text": "Federer's loss marked the first time since the 2004 French Open, when he lost to Gustavo Kuerten in the third round, that he had failed to reach at least the quarterfinals in a Grand Slam event.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608", "type": "FAILED_TO_REACH_QUARTERFINALS_IN"}]</data>
  <data key="d8">hp_0e39951795747608</data>
</edge>
<edge source="Roger Federer" target="2002">
  <data key="d5">["EARLIEST_EXIT_IN"]</data>
  <data key="d6">Roger Federer had his earliest exit in the Wimbledon tournament in 2002.</data>
  <data key="d7">[{"text": "It was also Federer's earliest exit in this tournament since 2002, and the first time that Federer lost to a player ranked lower than 100 since his loss to then World No. 101 Richard Gasquet at the 2005 Monte Carlo Masters.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608", "type": "EARLIEST_EXIT_IN"}]</data>
  <data key="d8">hp_0e39951795747608</data>
</edge>
<edge source="Roger Federer" target="Richard Gasquet">
  <data key="d5">["LOST_TO"]</data>
  <data key="d6">Roger Federer lost to Richard Gasquet at the 2005 Monte Carlo Masters.</data>
  <data key="d7">[{"text": "It was also Federer's earliest exit in this tournament since 2002, and the first time that Federer lost to a player ranked lower than 100 since his loss to then World No. 101 Richard Gasquet at the 2005 Monte Carlo Masters.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608", "type": "LOST_TO"}]</data>
  <data key="d8">hp_0e39951795747608</data>
</edge>
<edge source="Sergiy Stakhovsky" target="Roger Federer">
  <data key="d5">["DEFEATED"]</data>
  <data key="d6">Sergiy Stakhovsky defeated Roger Federer in the second round of the 2013 Wimbledon Championships.</data>
  <data key="d7">[{"text": "Roger Federer was the defending champion but lost in the second round to World No. 116 Sergiy Stakhovsky in a huge upset.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608", "type": "DEFEATED"}]</data>
  <data key="d8">hp_0e39951795747608</data>
</edge>
<edge source="Jürgen Melzer" target="Sergiy Stakhovsky">
  <data key="d5">["DEFEATED"]</data>
  <data key="d6">Jürgen Melzer defeated Sergiy Stakhovsky in the next round of the 2013 Wimbledon Championships.</data>
  <data key="d7">[{"text": "Stakhovsky was unable to build on his effort and lost in the next round in 4 sets to Jürgen Melzer.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608", "type": "DEFEATED"}]</data>
  <data key="d8">hp_0e39951795747608</data>
</edge>
<edge source="Gustavo Kuerten" target="Roger Federer">
  <data key="d5">["DEFEATED"]</data>
  <data key="d6">Gustavo Kuerten defeated Roger Federer in the third round of the 2004 French Open.</data>
  <data key="d7">[{"text": "Federer's loss marked the first time since the 2004 French Open, when he lost to Gustavo Kuerten in the third round, that he had failed to reach at least the quarterfinals in a Grand Slam event.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608", "type": "DEFEATED"}]</data>
  <data key="d8">hp_0e39951795747608</data>
</edge>
