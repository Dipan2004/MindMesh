  <data key="d2">[{"text": "Grand'Maître is the current Canadian Women's Doubles Champion, winning her 14th doubles title in Langley, British Columbia with Jennifer Saunders in May 2013.", "chunk_id": "55ab038a3c41aeea", "doc_id": "hp_d2b1b9b8bce24c9a"}]</data>
