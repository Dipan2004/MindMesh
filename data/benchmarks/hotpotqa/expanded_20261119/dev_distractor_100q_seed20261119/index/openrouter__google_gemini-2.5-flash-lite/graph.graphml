  <data key="d2">[{"text": "Many scenes shot by cinematographer Harry J. Wild and Dmytryk stand out as classic film noir.", "chunk_id": "f4d99f18a4f175d5", "doc_id": "hp_cda28e9f1cb25d71"}]</data>
