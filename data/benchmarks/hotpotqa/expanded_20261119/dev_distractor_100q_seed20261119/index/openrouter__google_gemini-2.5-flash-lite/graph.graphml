  <data key="d2">[{"text": "His two channels, Nice Peter and Epic Rap Battles (ERB) have a total of over 16 million subscribers, and 3.5 billion views as of January 2017.", "chunk_id": "139ff0daddde19f6", "doc_id": "hp_47717c3619ee9332"}]</data>
