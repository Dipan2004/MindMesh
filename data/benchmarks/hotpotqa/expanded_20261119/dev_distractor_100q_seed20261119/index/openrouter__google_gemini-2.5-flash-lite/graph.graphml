<node id="feminist history">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The historical record and development of feminism, which the \"Town Bloody Hall\" debate was intended to document.", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}]</data>
  <data key="d2">[{"text": "The recording of the debate was intended to ensure the unbiased documentation, allowing it to become a concrete moment in feminist history.", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}]</data>
  <data key="d3">["hp_535589d1805f024e"]</data>
  <data key="d4">False</data>
</node>
<node id="The May Department Stores Company">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The May Department Stores Company was an American department store holding company.", "chunk_id": "7eaecb7c8ff690f9", "doc_id": "hp_537a416acef9e8ad"}, {"text": "The May Department Stores Company was the parent company of Robinsons-May.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d2">[{"text": "The May Department Stores Company was an American department store holding company, formerly headquartered in downtown St. Louis, Missouri.", "chunk_id": "7eaecb7c8ff690f9", "doc_id": "hp_537a416acef9e8ad"}, {"text": "It was a subsidiary of The May Department Stores Company, having been acquired with Federated's takeover of The May Department Stores Company on August 30, 2005.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d3">["hp_537a416acef9e8ad", "hp_70e1b920ca70d1e9"]</data>
