  <data key="d2">[{"text": "Releases include singles by Brooklyn-based indie-pop band The Besties (HP01), Barcelona-based pop group Nosoträsh (HP02) and Austin, Texas-based minimal pop trio Yellow Fever (HP03).", "chunk_id": "ec71908382284000", "doc_id": "hp_353258028a95f6b9"}]</data>
  <data key="d3">["hp_353258028a95f6b9"]</data>
