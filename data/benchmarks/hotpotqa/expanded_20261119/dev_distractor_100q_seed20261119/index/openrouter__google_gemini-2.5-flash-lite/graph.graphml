  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An Old French \"chanson de geste\" that draws heavily from chivalric romance.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d2">[{"text": "Galiens li Restorés, or Galien le Restoré or Galien rhétoré (in English, \"Galien the Restored\"), is an Old French \"chanson de geste\" which borrows heavily from chivalric romance.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d3">["hp_3fac05a2ac9ec6d2"]</data>
  <data key="d4">False</data>
</node>
<node id="Galien the Restored">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An Old French \"chanson de geste\" that draws heavily from chivalric romance.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d2">[{"text": "Galiens li Restorés, or Galien le Restoré or Galien rhétoré (in English, \"Galien the Restored\"), is an Old French \"chanson de geste\" which borrows heavily from chivalric romance.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d3">["hp_3fac05a2ac9ec6d2"]</data>
  <data key="d4">False</data>
</node>
<node id="Old French">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The language in which the \"chanson de geste\" Galiens li Restorés was written.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d2">[{"text": "Galiens li Restorés, or Galien le Restoré or Galien rhétoré (in English, \"Galien the Restored\"), is an Old French \"chanson de geste\" which borrows heavily from chivalric romance.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d3">["hp_3fac05a2ac9ec6d2"]</data>
  <data key="d4">False</data>
</node>
<node id="chivalric romance">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A genre of medieval literature that Galiens li Restorés borrows from.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d2">[{"text": "Galiens li Restorés, or Galien le Restoré or Galien rhétoré (in English, \"Galien the Restored\"), is an Old French \"chanson de geste\" which borrows heavily from chivalric romance.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d3">["hp_3fac05a2ac9ec6d2"]</data>
  <data key="d4">False</data>
</node>
<node id="Pèlerinage de Charlemagne">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An earlier \"chanson de geste\" closely linked to Galiens li Restorés.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d2">[{"text": "The story—which is closely linked to the earlier \"chansons de geste\" \"Pèlerinage de Charlemagne\" and \"The Song of Roland\" (especially in the latter's rhymed version)—tells of the adventures of Galien, son of the hero Olivier and of Jacqueline, the daughter of the (fictional) emperor Hugon (Hue the Strong) of Constantinople.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d3">["hp_3fac05a2ac9ec6d2"]</data>
  <data key="d4">False</data>
</node>
<node id="Galien">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The protagonist of Galiens li Restorés, son of Olivier and Jacqueline.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d2">[{"text": "The story—which is closely linked to the earlier \"chansons de geste\" \"Pèlerinage de Charlemagne\" and \"The Song of Roland\" (especially in the latter's rhymed version)—tells of the adventures of Galien, son of the hero Olivier and of Jacqueline, the daughter of the (fictional) emperor Hugon (Hue the Strong) of Constantinople.", "chunk_id": "850408ca66a7d9e6", "doc_id": "hp_3fac05a2ac9ec6d2"}]</data>
  <data key="d3">["hp_3fac05a2ac9ec6d2"]</data>
