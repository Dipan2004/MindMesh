<node id="The Naked and the Dead">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Naked and the Dead is a novel by Norman Mailer published in 1948.", "chunk_id": "a9b706270ee53f26", "doc_id": "hp_f2e5ed08978257fc"}]</data>
  <data key="d2">[{"text": "His novel \"The Naked and the Dead\" was published in 1948 and brought him renown.", "chunk_id": "a9b706270ee53f26", "doc_id": "hp_f2e5ed08978257fc"}]</data>
  <data key="d3">["hp_f2e5ed08978257fc"]</data>
  <data key="d4">False</data>
</node>
<node id="The Executioner's Song">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Executioner's Song is a work by Norman Mailer published in 1979, which won the Pulitzer Prize for fiction.", "chunk_id": "a9b706270ee53f26", "doc_id": "hp_f2e5ed08978257fc"}]</data>
  <data key="d2">[{"text": "His best-known work is widely considered to be \"The Executioner's Song\" (1979) winner of the Pulitzer Prize for fiction.", "chunk_id": "a9b706270ee53f26", "doc_id": "hp_f2e5ed08978257fc"}]</data>
  <data key="d3">["hp_f2e5ed08978257fc"]</data>
  <data key="d4">False</data>
</node>
<node id="Pulitzer Prize for fiction">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Pulitzer Prize for fiction is an award won by Norman Mailer's \"The Executioner's Song\".", "chunk_id": "a9b706270ee53f26", "doc_id": "hp_f2e5ed08978257fc"}]</data>
  <data key="d2">[{"text": "His best-known work is widely considered to be \"The Executioner's Song\" (1979) winner of the Pulitzer Prize for fiction.", "chunk_id": "a9b706270ee53f26", "doc_id": "hp_f2e5ed08978257fc"}]</data>
  <data key="d3">["hp_f2e5ed08978257fc"]</data>
  <data key="d4">False</data>
</node>
<node id="Armies of the Night">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Armies of the Night is a work by Norman Mailer that won the Pulitzer Prize for non-fiction and the National Book Award.", "chunk_id": "a9b706270ee53f26", "doc_id": "hp_f2e5ed08978257fc"}]</data>
  <data key="d2">[{"text": "\"Armies of the Night\" won the Pulitzer Prize for non-fiction and the National Book Award.", "chunk_id": "a9b706270ee53f26", "doc_id": "hp_f2e5ed08978257fc"}]</data>
