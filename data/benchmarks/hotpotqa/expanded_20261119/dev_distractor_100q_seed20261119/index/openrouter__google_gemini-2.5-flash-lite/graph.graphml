  <data key="d2">[{"text": "\"Sexy Baby\" won the Founders Prize for Best Film by a First Time Director at the 2012 Traverse City Film Festival and \"Hot Girls Wanted\" was nominated in 2015 for a Primetime Emmy and the Grand Jury Prize at the Sundance Film Festival.", "chunk_id": "e68c0632f8756f40", "doc_id": "hp_b25d5e6fd3855bd1"}]</data>
