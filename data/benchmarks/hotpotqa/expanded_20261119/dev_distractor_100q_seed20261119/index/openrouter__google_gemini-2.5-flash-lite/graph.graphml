<node id="Kewal">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The character played by Shashi Kapoor as a child artist in the film Aag.", "chunk_id": "4df4b5295e67f801", "doc_id": "hp_b8f974e5ce544d7e"}]</data>
  <data key="d2">[{"text": "Raj Kapoor's youngest brother Shashi Kapoor appeared as a child artist in this film playing the younger version of his character (Kewal).", "chunk_id": "4df4b5295e67f801", "doc_id": "hp_b8f974e5ce544d7e"}]</data>
  <data key="d3">["hp_b8f974e5ce544d7e"]</data>
