</node>
<node id="Grand Slam (tennis)">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The Grand Slam tournaments are the four most important annual tennis events.", "chunk_id": "9d09b0720a059b02", "doc_id": "hp_3b064c68e72a4e49"}]</data>
  <data key="d2">[{"text": "The Grand Slam tournaments, also called majors, are the four most important annual tennis events.", "chunk_id": "9d09b0720a059b02", "doc_id": "hp_3b064c68e72a4e49"}]</data>
  <data key="d3">["hp_3b064c68e72a4e49"]</data>
  <data key="d4">False</data>
</node>
<node id="majors">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The majors are the four most important annual tennis events, also known as the Grand Slam tournaments.", "chunk_id": "9d09b0720a059b02", "doc_id": "hp_3b064c68e72a4e49"}]</data>
  <data key="d2">[{"text": "The Grand Slam tournaments, also called majors, are the four most important annual tennis events.", "chunk_id": "9d09b0720a059b02", "doc_id": "hp_3b064c68e72a4e49"}]</data>
  <data key="d3">["hp_3b064c68e72a4e49"]</data>
  <data key="d4">False</data>
</node>
<node id="Australian Open">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Australian Open is one of the four Grand Slam tennis tournaments, held in mid January.", "chunk_id": "9d09b0720a059b02", "doc_id": "hp_3b064c68e72a4e49"}, {"text": "The Australian Open is one of the Grand Slam men's doubles titles won by Jim Pugh.", "chunk_id": "7b5e0db5ada508ba", "doc_id": "hp_8ec8cd0791ca8bff"}]</data>
  <data key="d2">[{"text": "The Grand Slam itinerary consists of the Australian Open in mid January, the French Open in May and June, Wimbledon in July, and the US Open in August and September.", "chunk_id": "9d09b0720a059b02", "doc_id": "hp_3b064c68e72a4e49"}, {"text": "A doubles specialist, he won three Grand Slam men's doubles titles (two Australian Open, one Wimbledon) and five Grand Slam mixed doubles titles (three Australian Open, one Wimbledon, one US Open).", "chunk_id": "7b5e0db5ada508ba", "doc_id": "hp_8ec8cd0791ca8bff"}]</data>
  <data key="d3">["hp_3b064c68e72a4e49", "hp_8ec8cd0791ca8bff"]</data>
  <data key="d4">False</data>
</node>
<node id="French Open">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The French Open is one of the four Grand Slam tennis tournaments, held in May and June.", "chunk_id": "9d09b0720a059b02", "doc_id": "hp_3b064c68e72a4e49"}]</data>
  <data key="d2">[{"text": "The Grand Slam itinerary consists of the Australian Open in mid January, the French Open in May and June, Wimbledon in July, and the US Open in August and September.", "chunk_id": "9d09b0720a059b02", "doc_id": "hp_3b064c68e72a4e49"}]</data>
  <data key="d3">["hp_3b064c68e72a4e49"]</data>
  <data key="d4">False</data>
</node>
<node id="hard courts">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Hard courts are a type of tennis court surface used for the Australian and United States tournaments.", "chunk_id": "9d09b0720a059b02", "doc_id": "hp_3b064c68e72a4e49"}]</data>
  <data key="d2">[{"text": "The Australian and United States tournaments are played on hard courts, the French on clay, and Wimbledon on grass.", "chunk_id": "9d09b0720a059b02", "doc_id": "hp_3b064c68e72a4e49"}]</data>
  <data key="d3">["hp_3b064c68e72a4e49"]</data>
