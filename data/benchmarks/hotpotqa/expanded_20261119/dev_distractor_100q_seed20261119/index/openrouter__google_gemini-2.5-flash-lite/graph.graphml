  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An American new wave band active between 1975 and 1991, of which David Byrne was the founding member, principal songwriter, lead singer, and guitarist.", "chunk_id": "46b571411ec4e1b3", "doc_id": "hp_c009c82a5deffa31"}]</data>
  <data key="d2">[{"text": "David Byrne ( ; born 14 May 1952) is a Scottish-born American musician who was the founding member, principal songwriter, and lead singer and guitarist of the American new wave band Talking Heads, active between 1975 and 1991.", "chunk_id": "46b571411ec4e1b3", "doc_id": "hp_c009c82a5deffa31"}]</data>
