<node id="James Burke">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A British broadcaster, science historian, author, and television producer.", "chunk_id": "d20f38d436444ac0", "doc_id": "hp_1fa56752c144bc40"}, {"text": "A science historian who wrote and presented the documentary television series 'The Day the Universe Changed'.", "chunk_id": "641da45da986e5ce", "doc_id": "hp_58b33fe59f58c1ed"}, {"text": "A science historian who created, wrote, and presented the television series and book \"Connections\".", "chunk_id": "ff5da75d9754d424", "doc_id": "hp_83e4174eb0dec6ec"}, {"text": "Creator of the 1978 documentary series 'Connections'.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}]</data>
  <data key="d2">[{"text": "James Burke (born 22 December 1936) is a British broadcaster, science historian, author, and television producer, who is known, among other things, for his documentary television series \"Connections\" (1978), and for its more philosophically oriented companion series, \"The Day the Universe Changed\" (1985), which is about the history of science and technology.", "chunk_id": "d20f38d436444ac0", "doc_id": "hp_1fa56752c144bc40"}, {"text": "The Day the Universe Changed: A Personal View by James Burke is a British documentary television series written and presented by science historian James Burke, originally broadcast on BBC1 from 19 March until 21 May 1985 by the BBC.", "chunk_id": "641da45da986e5ce", "doc_id": "hp_58b33fe59f58c1ed"}, {"text": "Connections is a 10-episode documentary television series and 1978 book (\"Connections\", based on the series) created, written, and presented by science historian James Burke.", "chunk_id": "ff5da75d9754d424", "doc_id": "hp_83e4174eb0dec6ec"}, {"text": "The show's format is very similar to that of James Burke's 1978 documentary series, \"Connections\".", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}]</data>
  <data key="d3">["hp_1fa56752c144bc40", "hp_58b33fe59f58c1ed", "hp_83e4174eb0dec6ec", "hp_8429039f0ec9c01d"]</data>
  <data key="d4">False</data>
</node>
<node id="Connections">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A documentary television series created by James Burke.", "chunk_id": "d20f38d436444ac0", "doc_id": "hp_1fa56752c144bc40"}, {"text": "A 10-episode documentary television series and 1978 book created, written, and presented by James Burke.", "chunk_id": "ff5da75d9754d424", "doc_id": "hp_83e4174eb0dec6ec"}, {"text": "A 1978 documentary series created by James Burke.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}]</data>
  <data key="d2">[{"text": "James Burke (born 22 December 1936) is a British broadcaster, science historian, author, and television producer, who is known, among other things, for his documentary television series \"Connections\" (1978), and for its more philosophically oriented companion series, \"The Day the Universe Changed\" (1985), which is about the history of science and technology.", "chunk_id": "d20f38d436444ac0", "doc_id": "hp_1fa56752c144bc40"}, {"text": "Connections is a 10-episode documentary television series and 1978 book (\"Connections\", based on the series) created, written, and presented by science historian James Burke.", "chunk_id": "ff5da75d9754d424", "doc_id": "hp_83e4174eb0dec6ec"}, {"text": "The show's format is very similar to that of James Burke's 1978 documentary series, \"Connections\".", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}]</data>
  <data key="d3">["hp_1fa56752c144bc40", "hp_83e4174eb0dec6ec", "hp_8429039f0ec9c01d"]</data>
  <data key="d4">False</data>
</node>
<node id="The Day the Universe Changed">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A companion series to \"Connections\" that is more philosophically oriented and about the history of science and technology.", "chunk_id": "d20f38d436444ac0", "doc_id": "hp_1fa56752c144bc40"}, {"text": "A British documentary television series written and presented by James Burke.", "chunk_id": "641da45da986e5ce", "doc_id": "hp_58b33fe59f58c1ed"}]</data>
  <data key="d2">[{"text": "James Burke (born 22 December 1936) is a British broadcaster, science historian, author, and television producer, who is known, among other things, for his documentary television series \"Connections\" (1978), and for its more philosophically oriented companion series, \"The Day the Universe Changed\" (1985), which is about the history of science and technology.", "chunk_id": "d20f38d436444ac0", "doc_id": "hp_1fa56752c144bc40"}, {"text": "The Day the Universe Changed: A Personal View by James Burke is a British documentary television series written and presented by science historian James Burke, originally broadcast on BBC1 from 19 March until 21 May 1985 by the BBC.", "chunk_id": "641da45da986e5ce", "doc_id": "hp_58b33fe59f58c1ed"}]</data>
  <data key="d3">["hp_1fa56752c144bc40", "hp_58b33fe59f58c1ed"]</data>
  <data key="d4">False</data>
</node>
<node id="The Washington Post">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A newspaper that called James Burke \"one of the most intriguing minds in the Western world\".", "chunk_id": "d20f38d436444ac0", "doc_id": "hp_1fa56752c144bc40"}]</data>
  <data key="d2">[{"text": "\"The Washington Post\" called him \"one of the most intriguing minds in the Western world\".", "chunk_id": "d20f38d436444ac0", "doc_id": "hp_1fa56752c144bc40"}]</data>
  <data key="d3">["hp_1fa56752c144bc40"]</data>
  <data key="d4">False</data>
</node>
<node id="Battle of Amstetten">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A minor engagement during the War of the Third Coalition between the First French Empire and the alliance of Austria and Russia.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d2">[{"text": "The Battle of Amstetten was a minor engagement during the War of the Third Coalition between the First French Empire and the alliance of Austria and Russia.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d3">["hp_1fde0cb754789706"]</data>
  <data key="d4">False</data>
</node>
<node id="War of the Third Coalition">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A conflict involving the First French Empire and the alliance of Austria and Russia.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d2">[{"text": "The Battle of Amstetten was a minor engagement during the War of the Third Coalition between the First French Empire and the alliance of Austria and Russia.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d3">["hp_1fde0cb754789706"]</data>
  <data key="d4">False</data>
</node>
<node id="First French Empire">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The empire ruled by Napoleon Bonaparte, which fought against the alliance of Austria and Russia.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d2">[{"text": "The Battle of Amstetten was a minor engagement during the War of the Third Coalition between the First French Empire and the alliance of Austria and Russia.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d3">["hp_1fde0cb754789706"]</data>
  <data key="d4">False</data>
</node>
<node id="Mikhail Kutuzov">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The leader of the retreating Russo-Austrian troops.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d2">[{"text": "It occurred on 5 November 1805, when the retreating Russo-Austrian troops, led by Mikhail Kutuzov, were intercepted by Marshal Joachim Murat's cavalry and a portion of Marshal Jean Lannes' corps.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d3">["hp_1fde0cb754789706"]</data>
  <data key="d4">False</data>
</node>
<node id="Joachim Murat">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Marshal whose cavalry intercepted the retreating Russo-Austrian troops.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d2">[{"text": "It occurred on 5 November 1805, when the retreating Russo-Austrian troops, led by Mikhail Kutuzov, were intercepted by Marshal Joachim Murat's cavalry and a portion of Marshal Jean Lannes' corps.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d3">["hp_1fde0cb754789706"]</data>
  <data key="d4">False</data>
</node>
<node id="Jean Lannes">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Marshal whose corps was part of the French forces.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d2">[{"text": "It occurred on 5 November 1805, when the retreating Russo-Austrian troops, led by Mikhail Kutuzov, were intercepted by Marshal Joachim Murat's cavalry and a portion of Marshal Jean Lannes' corps.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d3">["hp_1fde0cb754789706"]</data>
  <data key="d4">False</data>
</node>
<node id="Pyotr Bagration">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Defended against the advancing French troops and allowed the Russian troops to retreat.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d2">[{"text": "Pyotr Bagration defended against the advancing French troops and allowed the Russian troops to retreat.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d3">["hp_1fde0cb754789706"]</data>
  <data key="d4">False</data>
</node>
<node id="Russian Army">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The army that opposed a significant number of French troops in the open for the first time.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}, {"text": "The military force of Russia that approached Baku in 1723.", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d2">[{"text": "This was the first fight in which a major part of the Russian Army opposed a significant number of French troops in the open.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}, {"text": "The mosque acquired its second name in 1723, when military squadron of Russian Army, consisting of 15 warships and led by Admiral Matyushkin, approached the city from seaside and demanded its surrender during the Russo-Persian War (1722-1723).", "chunk_id": "654007e469298406", "doc_id": "hp_ffb3421ab06921a6"}]</data>
  <data key="d3">["hp_1fde0cb754789706", "hp_ffb3421ab06921a6"]</data>
  <data key="d4">False</data>
</node>
<node id="Russo-Austrian troops">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The allied troops of Russia and Austria, numbering around 6,700, who suffered more casualties but retreated.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d2">[{"text": "The total number of Russo-Austrian troops was around 6,700, while the French troops numbered roughly 10,000 troops.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}]</data>
  <data key="d3">["hp_1fde0cb754789706"]</data>
  <data key="d4">False</data>
</node>
<node id="Candleshoe">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Candleshoe is a 1977 American family adventure film.", "chunk_id": "d023f3e4f264a122", "doc_id": "hp_1fefaf05b2e9d06d"}]</data>
  <data key="d2">[{"text": "Candleshoe is a 1977 American family adventure film produced by Walt Disney Productions based on the Michael Innes novel \"Christmas at Candleshoe\" and starring Jodie Foster, David Niven, Helen Hayes in her last big screen appearance and Leo McKern.", "chunk_id": "d023f3e4f264a122", "doc_id": "hp_1fefaf05b2e9d06d"}]</data>
  <data key="d3">["hp_1fefaf05b2e9d06d"]</data>
  <data key="d4">False</data>
</node>
<node id="Walt Disney Productions">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Walt Disney Productions is the entity that produced the film Candleshoe.", "chunk_id": "d023f3e4f264a122", "doc_id": "hp_1fefaf05b2e9d06d"}, {"text": "Walt Disney Productions produced the film The Black Hole.", "chunk_id": "5adc5270c9844bc8", "doc_id": "hp_75144a703046903e"}, {"text": "Walt Disney Productions is the production company that made the film That Darn Cat!.", "chunk_id": "15791e4c51cf1c4f", "doc_id": "hp_91f76bb6a0249df4"}]</data>
  <data key="d2">[{"text": "Candleshoe is a 1977 American family adventure film produced by Walt Disney Productions based on the Michael Innes novel \"Christmas at Candleshoe\" and starring Jodie Foster, David Niven, Helen Hayes in her last big screen appearance and Leo McKern.", "chunk_id": "d023f3e4f264a122", "doc_id": "hp_1fefaf05b2e9d06d"}, {"text": "The Black Hole is a 1979 American science fiction film directed by Gary Nelson and produced by Walt Disney Productions.", "chunk_id": "5adc5270c9844bc8", "doc_id": "hp_75144a703046903e"}, {"text": "That Darn Cat! is a 1965 American Walt Disney Productions thriller comedy film starring Hayley Mills (in her last of the six films she made for the Walt Disney Studios) and Dean Jones (starring in his first film for Disney) in a story about bank robbers, a kidnapping and a mischievous cat.", "chunk_id": "15791e4c51cf1c4f", "doc_id": "hp_91f76bb6a0249df4"}]</data>
  <data key="d3">["hp_1fefaf05b2e9d06d", "hp_75144a703046903e", "hp_91f76bb6a0249df4"]</data>
  <data key="d4">False</data>
