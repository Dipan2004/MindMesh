<edge source="Hammerschmidt Villa" target="White House of Bonn">
  <data key="d5">["ALSO_CALLED"]</data>
  <data key="d6">The Hammerschmidt Villa is also called the "White House of Bonn" in German.</data>
  <data key="d7">[{"text": "In German, the Villa is also called the \"White House of Bonn\", because of its vague resemblance to the official residence of the President of the United States.", "chunk_id": "ff48931294984b0c", "doc_id": "hp_dcebc5f0fd364ecc", "type": "ALSO_CALLED"}]</data>
