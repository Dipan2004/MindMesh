  <data key="d7">[{"text": "The song was also released as a single in Australia under the name \"By Your Side\", due to the Australian bush fires which were happening at the time.", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e", "type": "RELEASED_IN"}]</data>
