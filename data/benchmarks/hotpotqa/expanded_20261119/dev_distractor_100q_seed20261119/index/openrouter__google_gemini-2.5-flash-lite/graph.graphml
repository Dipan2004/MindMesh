  <data key="d6">Ronald H. Walker became a senior partner at Korn/Ferry International.</data>
  <data key="d7">[{"text": "Walker went on to become a senior partner at Korn/Ferry International, President of the Richard Nixon Foundation, and is currently the Chairman of the Board of the Nixon Foundation.", "chunk_id": "17e54dbd5dd980bc", "doc_id": "hp_cdb59476dc4f3e8a", "type": "SENIOR_PARTNER_AT"}]</data>
