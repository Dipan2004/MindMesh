<node id="olimpijka">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The continuation of the M1 highway after crossing the border into Belarus, leading to Minsk, Brest, and Warsaw.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}]</data>
  <data key="d2">[{"text": "After crossing the border with Belarus, the highway continues (as olimpijka) to Minsk, Brest, and Warsaw.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}]</data>
  <data key="d3">["hp_03076e3832c431da"]</data>
  <data key="d4">False</data>
</node>
<node id="Minsk">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The capital of Belarus, a destination reached by the M1 highway and its continuation, olimpijka.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}]</data>
  <data key="d2">[{"text": "After crossing the border with Belarus, the highway continues (as olimpijka) to Minsk, Brest, and Warsaw.", "chunk_id": "e8bf05a0f017b3d6", "doc_id": "hp_03076e3832c431da"}]</data>
  <data key="d3">["hp_03076e3832c431da"]</data>
