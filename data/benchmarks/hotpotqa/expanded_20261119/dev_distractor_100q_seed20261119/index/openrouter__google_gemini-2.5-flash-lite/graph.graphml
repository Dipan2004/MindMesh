  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The name of several documentary television series based on the newspaper feature.", "chunk_id": "aff35d971d199517", "doc_id": "hp_1ccc4746739c0eec"}]</data>
  <data key="d2">[{"text": "Ripley's Believe It or Not! is the name of several documentary television series based on the newspaper feature.", "chunk_id": "aff35d971d199517", "doc_id": "hp_1ccc4746739c0eec"}]</data>
