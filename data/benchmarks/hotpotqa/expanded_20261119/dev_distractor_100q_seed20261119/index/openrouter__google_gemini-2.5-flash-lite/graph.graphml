<edge source="Computer repair technician" target="hardware">
  <data key="d5">["CONFIGURES"]</data>
  <data key="d6">A computer repair technician configures hardware.</data>
  <data key="d7">[{"text": "The technician's responsibilities may extend to include building or configuring new hardware, installing and updating software packages, and creating and maintaining computer networks.", "chunk_id": "ef4743de89955cae", "doc_id": "hp_dc063fd42799d92d", "type": "CONFIGURES"}]</data>
