<edge source="Mirosław Dreszer" target="European Cup Winners' Cup">
  <data key="d5">["PARTICIPATED_IN"]</data>
  <data key="d6">Mirosław Dreszer participated in the final of the European Cup Winners' Cup in the 1986-87 season.</data>
  <data key="d7">[{"text": "During the final of the European Cup Winners' Cup in the 1986–87 season, he suffered a serious injury against Swiss team FC Sion.", "chunk_id": "2463a2e6b54ba2b9", "doc_id": "hp_3d488dbab399d265", "type": "PARTICIPATED_IN"}]</data>
  <data key="d8">hp_3d488dbab399d265</data>
</edge>
