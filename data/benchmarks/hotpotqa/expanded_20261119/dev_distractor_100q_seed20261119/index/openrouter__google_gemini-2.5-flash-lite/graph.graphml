  <data key="d6">John Lanchbery served as the Principal Conductor of the Royal Ballet from 1959 to 1972.</data>
  <data key="d7">[{"text": "He served as the Principal Conductor of the Royal Ballet from 1959 to 1972, Principal Conductor of the Australian Ballet from 1972 to 1977, and Director of the American Ballet Theatre from 1978 to 1980.", "chunk_id": "9d00c4570c3c8f48", "doc_id": "hp_945d3839e857ef30", "type": "WORKS_AT"}, {"text": "Although he resigned from the position of Director of the Royal Ballet in 1972, he continued to conduct regularly for the Company until 2001.", "chunk_id": "9d00c4570c3c8f48", "doc_id": "hp_945d3839e857ef30", "type": "RESIGNED_FROM"}, {"text": "Although he resigned from the position of Director of the Royal Ballet in 1972, he continued to conduct regularly for the Company until 2001.", "chunk_id": "9d00c4570c3c8f48", "doc_id": "hp_945d3839e857ef30", "type": "CONTINUED_TO_CONDUCT_FOR"}]</data>
  <data key="d8">hp_945d3839e857ef30</data>
</edge>
