  <data key="d2">[{"text": "The main feature of this expansion is the addition of ships, gold rivers, and the pirate to the game, allowing play between multiple islands.", "chunk_id": "4604dd9ff3227806", "doc_id": "hp_f44b12ff517dfad8"}]</data>
