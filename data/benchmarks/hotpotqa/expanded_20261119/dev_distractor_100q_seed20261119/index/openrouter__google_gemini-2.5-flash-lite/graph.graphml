  <data key="d2">[{"text": "Liuyang Two-oriented Industrial Park () is an agricultural products processing industrial park at province level in Liuyang City, Hunan Province, China.", "chunk_id": "6acf624f54ca7f79", "doc_id": "hp_a2f0f467a0548d2b"}]</data>
