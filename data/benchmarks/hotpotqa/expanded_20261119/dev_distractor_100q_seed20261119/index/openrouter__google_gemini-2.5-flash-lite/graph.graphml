<node id="Taiwanese New Wave">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Taiwanese New Wave is a film movement to which Vive L'Amour belongs.", "chunk_id": "8869b7186fadb9af", "doc_id": "hp_a8cea0bffbbab591"}]</data>
  <data key="d2">[{"text": "Vive L'Amour is a 1994 Taiwanese New Wave film by Tsai Ming-liang.", "chunk_id": "8869b7186fadb9af", "doc_id": "hp_a8cea0bffbbab591"}]</data>
  <data key="d3">["hp_a8cea0bffbbab591"]</data>
  <data key="d4">False</data>
</node>
<node id="51st Venice International Film Festival">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 51st Venice International Film Festival is an event where Vive L'Amour premiered.", "chunk_id": "8869b7186fadb9af", "doc_id": "hp_a8cea0bffbbab591"}]</data>
  <data key="d2">[{"text": "It premiered in the 51st Venice International Film Festival, where it won the prestigious Golden Lion.", "chunk_id": "8869b7186fadb9af", "doc_id": "hp_a8cea0bffbbab591"}]</data>
  <data key="d3">["hp_a8cea0bffbbab591"]</data>
  <data key="d4">False</data>
</node>
<node id="Golden Lion">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Golden Lion is a prestigious award won by Vive L'Amour at the 51st Venice International Film Festival.", "chunk_id": "8869b7186fadb9af", "doc_id": "hp_a8cea0bffbbab591"}]</data>
  <data key="d2">[{"text": "It premiered in the 51st Venice International Film Festival, where it won the prestigious Golden Lion.", "chunk_id": "8869b7186fadb9af", "doc_id": "hp_a8cea0bffbbab591"}]</data>
  <data key="d3">["hp_a8cea0bffbbab591"]</data>
  <data key="d4">False</data>
</node>
<node id="Ken Rosewall">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Ken Rosewall is a former world top-ranking amateur and professional tennis player from Australia.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d2">[{"text": "Ken Rosewall Kenneth Robert Rosewall {'1': \", '2': \", '3': 'AM, MBE', '4': \"} (born 2 November 1934) is a former world top-ranking amateur and professional tennis player from Australia.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d3">["hp_a8d43feead8ab699"]</data>
  <data key="d4">False</data>
</node>
<node id="tennis Majors">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Tennis Majors are significant championships in the sport of tennis.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d2">[{"text": "He won a record 23 tennis Majors including 8 Grand Slam singles titles and before the Open Era a record 15 Pro Slam titles and a record 35 Major finals overall.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d3">["hp_a8d43feead8ab699"]</data>
  <data key="d4">False</data>
</node>
<node id="Pro Slam titles">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Pro Slam titles are championships won by professional tennis players before the Open Era.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d2">[{"text": "He won a record 23 tennis Majors including 8 Grand Slam singles titles and before the Open Era a record 15 Pro Slam titles and a record 35 Major finals overall.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d3">["hp_a8d43feead8ab699"]</data>
  <data key="d4">False</data>
</node>
<node id="Major finals">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Major finals are the championship matches of significant tennis tournaments.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d2">[{"text": "He won a record 23 tennis Majors including 8 Grand Slam singles titles and before the Open Era a record 15 Pro Slam titles and a record 35 Major finals overall.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d3">["hp_a8d43feead8ab699"]</data>
  <data key="d4">False</data>
</node>
<node id="Pro Grand Slam">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Pro Grand Slam was a major tennis championship for professional players.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d2">[{"text": "He won the Pro Grand Slam in 1963.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d3">["hp_a8d43feead8ab699"]</data>
  <data key="d4">False</data>
</node>
<node id="slams in doubles">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Slams in doubles refers to major championships won in doubles tennis matches.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d2">[{"text": "Rosewall won 9 slams in doubles with a career double grand slam.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d3">["hp_a8d43feead8ab699"]</data>
  <data key="d4">False</data>
</node>
<node id="career double grand slam">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A career double grand slam is an achievement in tennis where a player wins all four Grand Slam tournaments in both singles and doubles.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d2">[{"text": "Rosewall won 9 slams in doubles with a career double grand slam.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d3">["hp_a8d43feead8ab699"]</data>
  <data key="d4">False</data>
</node>
<node id="backhand">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A backhand is a stroke in tennis where the player swings the racket across their body with the back of their hand facing the ball.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d2">[{"text": "He had a renowned backhand and enjoyed a long career at the highest levels from the early 1950s to the early 1970s.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d3">["hp_a8d43feead8ab699"]</data>
  <data key="d4">False</data>
</node>
<node id="World No. 1 player">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "World No. 1 player is the ranking given to the top-ranked player in professional tennis.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d2">[{"text": "Rosewall was one of the two best male players for about nine years and was the World No. 1 player for a number of years in the early 1960s.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d3">["hp_a8d43feead8ab699"]</data>
  <data key="d4">False</data>
</node>
<node id="Pro Grand Slam titles on three different surfaces">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "This refers to holding major professional tennis titles on grass, clay, and hard courts simultaneously.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d2">[{"text": "Rosewall is the only player to have simultaneously held Pro Grand Slam titles on three different surfaces (1962–1963).", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d3">["hp_a8d43feead8ab699"]</data>
  <data key="d4">False</data>
</node>
<node id="1971 Australian Open">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 1971 Australian Open was a major tennis tournament.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d2">[{"text": "At the 1971 Australian Open he became the first male player during the open era to win a Grand Slam tournament without dropping a set.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d3">["hp_a8d43feead8ab699"]</data>
  <data key="d4">False</data>
</node>
<node id="Grand Slam tournament">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A Grand Slam tournament is one of the four major annual tennis events.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d2">[{"text": "At the 1971 Australian Open he became the first male player during the open era to win a Grand Slam tournament without dropping a set.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699"}]</data>
  <data key="d3">["hp_a8d43feead8ab699"]</data>
  <data key="d4">False</data>
</node>
<node id="Gary Williams">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Gary Bruce Williams is an American university administrator and former college basketball coach.", "chunk_id": "777d709f2b113bd2", "doc_id": "hp_a8de6e8688186343"}]</data>
  <data key="d2">[{"text": "Gary Bruce Williams (born March 4, 1945) is an American university administrator and former college basketball coach.", "chunk_id": "777d709f2b113bd2", "doc_id": "hp_a8de6e8688186343"}]</data>
  <data key="d3">["hp_a8de6e8688186343"]</data>
  <data key="d4">False</data>
</node>
<node id="Ohio State University">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Ohio State University is an institution where Gary Williams served as head coach.", "chunk_id": "777d709f2b113bd2", "doc_id": "hp_a8de6e8688186343"}]</data>
  <data key="d2">[{"text": "He served as the head coach at the University of Maryland, Ohio State University, Boston College, and American University.", "chunk_id": "777d709f2b113bd2", "doc_id": "hp_a8de6e8688186343"}]</data>
  <data key="d3">["hp_a8de6e8688186343"]</data>
  <data key="d4">False</data>
</node>
<node id="Boston College">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Boston College is an institution where Gary Williams served as head coach.", "chunk_id": "777d709f2b113bd2", "doc_id": "hp_a8de6e8688186343"}]</data>
  <data key="d2">[{"text": "He served as the head coach at the University of Maryland, Ohio State University, Boston College, and American University.", "chunk_id": "777d709f2b113bd2", "doc_id": "hp_a8de6e8688186343"}]</data>
  <data key="d3">["hp_a8de6e8688186343"]</data>
