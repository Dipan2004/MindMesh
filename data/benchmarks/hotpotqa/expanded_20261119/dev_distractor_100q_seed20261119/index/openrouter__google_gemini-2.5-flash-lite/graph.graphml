<node id="Someday">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A song by Sugar Ray released in 1999.", "chunk_id": "d2de0918bf1b22b8", "doc_id": "hp_482e2d8f73f605ee"}, {"text": "A hit song by Sugar Ray.", "chunk_id": "ca10670f4e9a955b", "doc_id": "hp_5682f3a022ba8ac2"}]</data>
  <data key="d2">[{"text": "\"Someday\"(1999) is a single from the rock band Sugar Ray from their third album \"\".", "chunk_id": "d2de0918bf1b22b8", "doc_id": "hp_482e2d8f73f605ee"}, {"text": "Subsequent albums shared this style, and the band landed a number of hits with \"Every Morning\" and \"Someday\" from \"\" and \"When It's Over\" from their self-titled album.", "chunk_id": "ca10670f4e9a955b", "doc_id": "hp_5682f3a022ba8ac2"}]</data>
  <data key="d3">["hp_482e2d8f73f605ee", "hp_5682f3a022ba8ac2"]</data>
  <data key="d4">False</data>
</node>
<node id="Hot 100 Airplay">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A music chart that \"Someday\" reached #4 on.", "chunk_id": "d2de0918bf1b22b8", "doc_id": "hp_482e2d8f73f605ee"}]</data>
  <data key="d2">[{"text": "The song reached #7 on both the \"Billboard\" Hot 100 and the Hot Modern Rock Tracks, as well as #4 on the Hot 100 Airplay and #4 on Canada's \"RPM\" singles chart.", "chunk_id": "d2de0918bf1b22b8", "doc_id": "hp_482e2d8f73f605ee"}]</data>
  <data key="d3">["hp_482e2d8f73f605ee"]</data>
  <data key="d4">False</data>
</node>
