<node id="Laurus">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Laurus is a genus of evergreen shrubs and trees in the laurel family, Lauraceae.", "chunk_id": "f0fe680fe359fc0b", "doc_id": "hp_10b3b9822146cc1a"}, {"text": "A genus of evergreen trees belonging to the Laurel family, Lauraceae.", "chunk_id": "1680d6be464bcfe6", "doc_id": "hp_19572b7a0a3ebc1a"}, {"text": "Laurus is a genus of evergreen trees belonging to the Laurel family, Lauraceae.", "chunk_id": "02e85a764b598b43", "doc_id": "hp_d246ca7d297d3c28"}]</data>
  <data key="d2">[{"text": "The name \"Mezilaurus\" (half laurel) refers to its similar appearance to the genus \"Laurus\".", "chunk_id": "f0fe680fe359fc0b", "doc_id": "hp_10b3b9822146cc1a"}, {"text": "belonging to \"Laurus\" genus of evergreen trees belonging to the Laurel family, Lauraceae.", "chunk_id": "1680d6be464bcfe6", "doc_id": "hp_19572b7a0a3ebc1a"}, {"text": "Laurus is a genus of evergreen trees belonging to the Laurel family, Lauraceae.", "chunk_id": "02e85a764b598b43", "doc_id": "hp_d246ca7d297d3c28"}]</data>
  <data key="d3">["hp_10b3b9822146cc1a", "hp_19572b7a0a3ebc1a", "hp_d246ca7d297d3c28"]</data>
  <data key="d4">False</data>
</node>
<node id="Pterostyrax hispidus">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Pterostyrax hispidus is a species of flowering plant.", "chunk_id": "5a4b1080849ca551", "doc_id": "hp_10ed6dd74595a5bc"}]</data>
  <data key="d2">[{"text": "Pterostyrax hispidus, the epaulette tree or fragrant epaulette tree, is a species of flowering plant in the family Styracaceae, native to China and Japan.", "chunk_id": "5a4b1080849ca551", "doc_id": "hp_10ed6dd74595a5bc"}]</data>
