  <data key="d1">[{"text": "A substitute DJ for Ekstra Weekend who has his own show on 3FM.", "chunk_id": "7d7d42e40a8d63a0", "doc_id": "hp_a0b6962ec4a5ec5a"}]</data>
  <data key="d2">[{"text": "Rob Stenders, Paul Rabbering and Bart Arens have all been substitute DJs.", "chunk_id": "7d7d42e40a8d63a0", "doc_id": "hp_a0b6962ec4a5ec5a"}]</data>
  <data key="d3">["hp_a0b6962ec4a5ec5a"]</data>
  <data key="d4">False</data>
</node>
