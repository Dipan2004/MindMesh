<graph edgedefault="directed"><node id="Don't Stop the Music (Robyn album)">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Don't Stop the Music is the third studio album by Swedish pop singer Robyn.", "chunk_id": "b86877119b1982f2", "doc_id": "hp_00249a92367bd5ca"}]</data>
  <data key="d2">[{"text": "Don't Stop the Music is the third studio album by Swedish pop singer Robyn.", "chunk_id": "b86877119b1982f2", "doc_id": "hp_00249a92367bd5ca"}]</data>
  <data key="d3">["hp_00249a92367bd5ca"]</data>
  <data key="d4">False</data>
</node>
<node id="Robyn">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Robyn is a Swedish pop singer.", "chunk_id": "b86877119b1982f2", "doc_id": "hp_00249a92367bd5ca"}, {"text": "A Swedish pop singer.", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}, {"text": "Robyn is a Swedish singer whose first three studio albums were written and produced by Ghost.", "chunk_id": "df83364e0d4a59c9", "doc_id": "hp_f6fa72cb3d251e8b"}]</data>
  <data key="d2">[{"text": "Don't Stop the Music is the third studio album by Swedish pop singer Robyn.", "chunk_id": "b86877119b1982f2", "doc_id": "hp_00249a92367bd5ca"}, {"text": "\"Keep This Fire Burning\" is a song by Swedish pop singer Robyn, released as the first single from her third album \"Don't Stop the Music\".", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}, {"text": "They are perhaps best known for writing and producing Swedish singer Robyn's three first studio albums, \"Robyn Is Here\" (1996), \"My Truth\" (1999), and \"Don't Stop the Music\" (2002).", "chunk_id": "df83364e0d4a59c9", "doc_id": "hp_f6fa72cb3d251e8b"}]</data>
  <data key="d3">["hp_00249a92367bd5ca", "hp_593b07de5fa84d4e", "hp_f6fa72cb3d251e8b"]</data>
  <data key="d4">False</data>
</node>
<node id="BMG">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "BMG is the record label that released the album Don't Stop the Music in Sweden.", "chunk_id": "b86877119b1982f2", "doc_id": "hp_00249a92367bd5ca"}]</data>
  <data key="d2">[{"text": "It was released on 30 October 2002 in Sweden by BMG.", "chunk_id": "b86877119b1982f2", "doc_id": "hp_00249a92367bd5ca"}]</data>
  <data key="d3">["hp_00249a92367bd5ca"]</data>
  <data key="d4">False</data>
</node>
<node id="Keep This Fire Burning">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Keep This Fire Burning is a single from Robyn's album Don't Stop the Music.", "chunk_id": "b86877119b1982f2", "doc_id": "hp_00249a92367bd5ca"}, {"text": "A song by Swedish pop singer Robyn.", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}, {"text": "Keep This Fire Burning is a song from 2003 by Robyn, which was the fourth most played song by Swedish songwriters on Swedish radio from 2000–2009.", "chunk_id": "df83364e0d4a59c9", "doc_id": "hp_f6fa72cb3d251e8b"}]</data>
  <data key="d2">[{"text": "and the two singles \"Keep This Fire Burning\" and \"Don't Stop the Music\" were both top 10 hits.", "chunk_id": "b86877119b1982f2", "doc_id": "hp_00249a92367bd5ca"}, {"text": "\"Keep This Fire Burning\" is a song by Swedish pop singer Robyn, released as the first single from her third album \"Don't Stop the Music\".", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}, {"text": "Robyn's \"Keep This Fire Burning\" from 2003 was the fourth most played song by Swedish songwriters on Swedish radio from 2000–2009.", "chunk_id": "df83364e0d4a59c9", "doc_id": "hp_f6fa72cb3d251e8b"}]</data>
  <data key="d3">["hp_00249a92367bd5ca", "hp_593b07de5fa84d4e", "hp_f6fa72cb3d251e8b"]</data>
  <data key="d4">False</data>
</node>
<node id="Don't Stop the Music">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Don't Stop the Music is a single from Robyn's album of the same name.", "chunk_id": "b86877119b1982f2", "doc_id": "hp_00249a92367bd5ca"}, {"text": "The third album by Swedish pop singer Robyn.", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}, {"text": "Don't Stop the Music is the third studio album by Swedish singer Robyn, released in 2002.", "chunk_id": "df83364e0d4a59c9", "doc_id": "hp_f6fa72cb3d251e8b"}]</data>
  <data key="d2">[{"text": "and the two singles \"Keep This Fire Burning\" and \"Don't Stop the Music\" were both top 10 hits.", "chunk_id": "b86877119b1982f2", "doc_id": "hp_00249a92367bd5ca"}, {"text": "\"Keep This Fire Burning\" is a song by Swedish pop singer Robyn, released as the first single from her third album \"Don't Stop the Music\".", "chunk_id": "159b19643bce98d8", "doc_id": "hp_593b07de5fa84d4e"}, {"text": "They are perhaps best known for writing and producing Swedish singer Robyn's three first studio albums, \"Robyn Is Here\" (1996), \"My Truth\" (1999), and \"Don't Stop the Music\" (2002).", "chunk_id": "df83364e0d4a59c9", "doc_id": "hp_f6fa72cb3d251e8b"}]</data>
  <data key="d3">["hp_00249a92367bd5ca", "hp_593b07de5fa84d4e", "hp_f6fa72cb3d251e8b"]</data>
  <data key="d4">False</data>
</node>
<node id="IFPI">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "IFPI is an organization that certified the single \"Don't Stop The Music\" as platinum.", "chunk_id": "b86877119b1982f2", "doc_id": "hp_00249a92367bd5ca"}]</data>
  <data key="d2">[{"text": "In 2003, \"Don't Stop The Music\" was certified platinum by IFPI, and has sold over 60,000 copies in Sweden.", "chunk_id": "b86877119b1982f2", "doc_id": "hp_00249a92367bd5ca"}]</data>
  <data key="d3">["hp_00249a92367bd5ca"]</data>
  <data key="d4">False</data>
</node>
<node id="Leung Po Shan">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Leung Po Shan is a Hong Kong artist specialized in installation and performance art.", "chunk_id": "897f999db778cfd7", "doc_id": "hp_0072f61fd930d308"}]</data>
  <data key="d2">[{"text": "Leung Po Shan (Anthony, Chinese: 梁寶山) is a Hong Kong artist specialized in installation and performance art.", "chunk_id": "897f999db778cfd7", "doc_id": "hp_0072f61fd930d308"}]</data>
  <data key="d3">["hp_0072f61fd930d308"]</data>
  <data key="d4">False</data>
</node>
<node id="Hong Kong">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Hong Kong is a location where Leung Po Shan was born and where she is from.", "chunk_id": "897f999db778cfd7", "doc_id": "hp_0072f61fd930d308"}, {"text": "A special administrative region of China, located on the southern coast of China.", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1"}, {"text": "A place for which Julius Akosah is eligible to play in international tournaments and where he currently plays for a club.", "chunk_id": "45f30e37c1e59bea", "doc_id": "hp_1cf743b0ec89744f"}, {"text": "A location where a significant legal case took place and which has a Basic Law.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}, {"text": "Hong Kong is a location relevant to Emma Lai's cricket career.", "chunk_id": "841c093ae5da39c9", "doc_id": "hp_654d8d6bcb6a93e2"}, {"text": "The city where the Hong Kong Squash Centre is located and where the event took place.", "chunk_id": "47492e99181fe8a1", "doc_id": "hp_89baa567279cbadc"}, {"text": "A location where the racehorse Military Attack was trained and raced.", "chunk_id": "4f018bc3fcafe69c", "doc_id": "hp_9e4b0099b07c257e"}, {"text": "Hong Kong is a location where GeIL has branches.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}, {"text": "Hong Kong is the birthplace of Marco Fu.", "chunk_id": "40bdefa8eb4df2fe", "doc_id": "hp_d05fd69dc2a1479f"}]</data>
  <data key="d2">[{"text": "Leung Po Shan (Anthony, Chinese: 梁寶山) is a Hong Kong artist specialized in installation and performance art.", "chunk_id": "897f999db778cfd7", "doc_id": "hp_0072f61fd930d308"}, {"text": "New immigrants in Hong Kong", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1"}, {"text": "He was called for Cameroon but he is eligible to play for Hong Kong in international tournaments.", "chunk_id": "45f30e37c1e59bea", "doc_id": "hp_1cf743b0ec89744f"}, {"text": "Director of Immigration v. Chong Fung Yuen was a 2001 case in Hong Kong's Court of Final Appeal.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}, {"text": "Wing Ki Lai or Emma Lai (born March 14, 1988) is a Hong Kong cricketer who plays for Hong Kong women's national cricket team.", "chunk_id": "841c093ae5da39c9", "doc_id": "hp_654d8d6bcb6a93e2"}, {"text": "The event took place at the Hong Kong Squash Centre in Hong Kong from 15–20 November.", "chunk_id": "47492e99181fe8a1", "doc_id": "hp_89baa567279cbadc"}, {"text": "Military Attack (Chinese: 軍事出擊, originally named Rave) (foaled 4 March 2008) is an Irish-bred, Hong Kong trained Thoroughbred racehorse.", "chunk_id": "4f018bc3fcafe69c", "doc_id": "hp_9e4b0099b07c257e"}, {"text": "GeIL’s headquarters is located in Taipei, Taiwan, with branches in Hong Kong and China.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}, {"text": "Marco Fu Ka-chun, MH, JP (, born 8 January 1978 in Hong Kong) is a professional snooker player from Hong Kong.", "chunk_id": "40bdefa8eb4df2fe", "doc_id": "hp_d05fd69dc2a1479f"}]</data>
  <data key="d3">["hp_0072f61fd930d308", "hp_0e063f0231106ec1", "hp_1cf743b0ec89744f", "hp_3bad22e58989e25f", "hp_654d8d6bcb6a93e2", "hp_89baa567279cbadc", "hp_9e4b0099b07c257e", "hp_a08e17bf87e824f4", "hp_d05fd69dc2a1479f"]</data>
  <data key="d4">False</data>
</node>
