<node id="settlers">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The role players assume in the game Catan, attempting to build and develop holdings.", "chunk_id": "492ee6567ec9e1c7", "doc_id": "hp_27d7c27c384bbb29"}]</data>
  <data key="d2">[{"text": "Players assume the roles of settlers, each attempting to build and develop holdings while trading and acquiring resources.", "chunk_id": "492ee6567ec9e1c7", "doc_id": "hp_27d7c27c384bbb29"}]</data>
  <data key="d3">["hp_27d7c27c384bbb29"]</data>
  <data key="d4">False</data>
</node>
