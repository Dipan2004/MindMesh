  <data key="d7">[{"text": "The show is produced by Brannon Braga, and Alan Silvestri composed the backing score.", "chunk_id": "fcc0f6c36b9c6443", "doc_id": "hp_48076015d5a62427", "type": "PRODUCED_BY"}]</data>
