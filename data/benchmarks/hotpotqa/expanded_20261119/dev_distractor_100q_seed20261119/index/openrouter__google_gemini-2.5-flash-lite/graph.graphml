  <data key="d2">[{"text": "Las Abandonadas (The Abandoned) is a Mexican film of 1945, directed by Emilio Fernández, starring Dolores del Río and Pedro Armendáriz.", "chunk_id": "4cb081bc0e3295ae", "doc_id": "hp_52300967f6c3f951"}, {"text": "Bugambilia (\"Bougainvillea\") is a Mexican movie of 1945 directed by Emilio Fernández and starring Dolores del Río and Pedro Armendáriz.", "chunk_id": "3626aa418e38ab94", "doc_id": "hp_b7f3e092b32229f7"}]</data>
