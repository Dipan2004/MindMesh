  <data key="d2">[{"text": "Gimmigela Chuli, or The Twins, is a mountain in the Himalayas, located on the border between Taplejung, Mechi, Nepal and Sikkim, India.", "chunk_id": "739d8f7ea6dfb06f", "doc_id": "hp_3fe42c6ffa4f5604"}, {"text": "It lies on the border between Nepal and India.", "chunk_id": "558ffc5b34f36add", "doc_id": "hp_491d2527c689b954"}, {"text": "Teriya Phounja Magar is a dancer from Rudrapur, Rupandehi district, Nepal.", "chunk_id": "062d56d562b13557", "doc_id": "hp_7f8b94b73851a963"}]</data>
