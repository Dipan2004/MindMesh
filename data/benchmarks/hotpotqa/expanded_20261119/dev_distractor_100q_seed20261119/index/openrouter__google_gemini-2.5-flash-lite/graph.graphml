  <data key="d1">[{"text": "Tim Howard is a world-class goalkeeper.", "chunk_id": "161d23869a931c5c", "doc_id": "hp_0f0066a63ba08f16"}, {"text": "Tim Howard is an American soccer player.", "chunk_id": "9fbf6c6c7157eff1", "doc_id": "hp_4d75d6e44332ee9b"}]</data>
  <data key="d2">[{"text": "Has coached world-class goalkeepers including Tim Howard, before his move to Manchester United, and US full internationals Tony Meola and Jonny Walker.", "chunk_id": "161d23869a931c5c", "doc_id": "hp_0f0066a63ba08f16"}, {"text": "Tim Howard", "chunk_id": "9fbf6c6c7157eff1", "doc_id": "hp_4d75d6e44332ee9b"}]</data>
