<node id="Communist Party of Spain">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A political party that África de las Heras was originally a member of.", "chunk_id": "9c96657c56b59858", "doc_id": "hp_16186a29c9da8f74"}]</data>
  <data key="d2">[{"text": "Originally a member of the Communist Party of Spain, de las Heras participated in various Soviet intelligence operations both during and after the Spanish Civil War.", "chunk_id": "9c96657c56b59858", "doc_id": "hp_16186a29c9da8f74"}]</data>
  <data key="d3">["hp_16186a29c9da8f74"]</data>
  <data key="d4">False</data>
</node>
<node id="Spanish Civil War">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A war during which and after which África de las Heras participated in Soviet intelligence operations.", "chunk_id": "9c96657c56b59858", "doc_id": "hp_16186a29c9da8f74"}, {"text": "A war during which Falange Española de las JONS was merged.", "chunk_id": "da2cebd3507fe424", "doc_id": "hp_b7901eef5f6745f0"}]</data>
  <data key="d2">[{"text": "Originally a member of the Communist Party of Spain, de las Heras participated in various Soviet intelligence operations both during and after the Spanish Civil War.", "chunk_id": "9c96657c56b59858", "doc_id": "hp_16186a29c9da8f74"}, {"text": "The Falange Española de las JONS ceased to exist as such when, during the Spanish Civil War, General Francisco Franco merged it with the Traditionalists in April 1937 to form the similarly named Falange Española Tradicionalista y de las Juntas de Ofensiva Nacional Sindicalista, which became the sole legal party in Spain until its dissolution in 1977.", "chunk_id": "da2cebd3507fe424", "doc_id": "hp_b7901eef5f6745f0"}]</data>
  <data key="d3">["hp_16186a29c9da8f74", "hp_b7901eef5f6745f0"]</data>
  <data key="d4">False</data>
</node>
<node id="The Ballad of Sally Anne">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A song with lyrics written by Alice Randall to a traditional tune.", "chunk_id": "39b1673d4de2e559", "doc_id": "hp_16e24df25317a0c5"}]</data>
  <data key="d2">[{"text": "\"The Ballad of Sally Anne\" is a song with lyrics written by Alice Randall to a traditional tune which is unusual among country songs for the topic, a race lynching.", "chunk_id": "39b1673d4de2e559", "doc_id": "hp_16e24df25317a0c5"}]</data>
  <data key="d3">["hp_16e24df25317a0c5"]</data>
  <data key="d4">False</data>
</node>
<node id="Alice Randall">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The lyricist of the song \"The Ballad of Sally Anne\".", "chunk_id": "39b1673d4de2e559", "doc_id": "hp_16e24df25317a0c5"}]</data>
  <data key="d2">[{"text": "\"The Ballad of Sally Anne\" is a song with lyrics written by Alice Randall to a traditional tune which is unusual among country songs for the topic, a race lynching.", "chunk_id": "39b1673d4de2e559", "doc_id": "hp_16e24df25317a0c5"}]</data>
  <data key="d3">["hp_16e24df25317a0c5"]</data>
  <data key="d4">False</data>
</node>
<node id="race lynching">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The unusual topic of the country song \"The Ballad of Sally Anne\".", "chunk_id": "39b1673d4de2e559", "doc_id": "hp_16e24df25317a0c5"}]</data>
  <data key="d2">[{"text": "\"The Ballad of Sally Anne\" is a song with lyrics written by Alice Randall to a traditional tune which is unusual among country songs for the topic, a race lynching.", "chunk_id": "39b1673d4de2e559", "doc_id": "hp_16e24df25317a0c5"}]</data>
  <data key="d3">["hp_16e24df25317a0c5"]</data>
  <data key="d4">False</data>
</node>
<node id="Mark O'Connor's band project New Nashville Cats">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The band project that recorded the song \"The Ballad of Sally Anne\".", "chunk_id": "39b1673d4de2e559", "doc_id": "hp_16e24df25317a0c5"}]</data>
  <data key="d2">[{"text": "The song was recorded by Mark O'Connor's band project New Nashville Cats.", "chunk_id": "39b1673d4de2e559", "doc_id": "hp_16e24df25317a0c5"}]</data>
  <data key="d3">["hp_16e24df25317a0c5"]</data>
  <data key="d4">False</data>
</node>
<node id="Strictly Come Dancing (South African TV series)">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A South African reality dance competition television series.", "chunk_id": "d4b687c75f256e9b", "doc_id": "hp_177200b5434d50b9"}]</data>
  <data key="d2">[{"text": "Strictly Come Dancing is a South African reality dance competition television series produced for SABC2 by Rapid Blue, based on the British show of the same name.", "chunk_id": "d4b687c75f256e9b", "doc_id": "hp_177200b5434d50b9"}]</data>
  <data key="d3">["hp_177200b5434d50b9"]</data>
