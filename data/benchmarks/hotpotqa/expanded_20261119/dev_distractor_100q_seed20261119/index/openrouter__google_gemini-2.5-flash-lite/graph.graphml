<node id="music professor">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A professor specializing in music.", "chunk_id": "f317bf6030b1131e", "doc_id": "hp_a09bf8eaffccdd21"}]</data>
  <data key="d2">[{"text": "During his 17-year career as a music professor, Evans was named one of two Outstanding Professors of 1981–1982 in the California State University system.", "chunk_id": "f317bf6030b1131e", "doc_id": "hp_a09bf8eaffccdd21"}]</data>
