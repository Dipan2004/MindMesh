  <data key="d2">[{"text": "According to a statement by the producers, the video recognizes Jackson's \"pioneering short films that transformed the entertainment industry with timeless, pop culture classics\".", "chunk_id": "4386b9386a9184fc", "doc_id": "hp_93fcd5b2eb13932b"}]</data>
