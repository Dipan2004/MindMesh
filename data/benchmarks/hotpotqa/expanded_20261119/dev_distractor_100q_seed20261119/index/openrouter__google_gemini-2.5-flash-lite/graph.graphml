  <data key="d2">[{"text": "Penicillium restrictum is a species of the genus of \"Penicillium\" which was isolated from the stems of the plant Silybum marianum.", "chunk_id": "bd4cd076593153eb", "doc_id": "hp_01116d3918922396"}]</data>
  <data key="d3">["hp_01116d3918922396"]</data>
  <data key="d4">False</data>
</node>
<node id="Silybum marianum">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A plant species from whose stems Penicillium restrictum was isolated.", "chunk_id": "bd4cd076593153eb", "doc_id": "hp_01116d3918922396"}, {"text": "Silybum marianum is the most widespread species of Silybum.", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}]</data>
  <data key="d2">[{"text": "Penicillium restrictum is a species of the genus of \"Penicillium\" which was isolated from the stems of the plant Silybum marianum.", "chunk_id": "bd4cd076593153eb", "doc_id": "hp_01116d3918922396"}, {"text": "The most widespread species is \"Silybum marianum\".", "chunk_id": "06967c45da7d01cb", "doc_id": "hp_4fb3a0aca6cf5736"}]</data>
  <data key="d3">["hp_01116d3918922396", "hp_4fb3a0aca6cf5736"]</data>
  <data key="d4">False</data>
</node>
<node id="calbistrin A">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A substance produced by Penicillium restrictum.", "chunk_id": "bd4cd076593153eb", "doc_id": "hp_01116d3918922396"}]</data>
  <data key="d2">[{"text": "\"Penicillium restrictum\" produces calbistrin A", "chunk_id": "bd4cd076593153eb", "doc_id": "hp_01116d3918922396"}]</data>
  <data key="d3">["hp_01116d3918922396"]</data>
