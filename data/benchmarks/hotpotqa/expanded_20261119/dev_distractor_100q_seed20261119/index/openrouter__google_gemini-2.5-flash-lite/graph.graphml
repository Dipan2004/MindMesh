  <data key="d7">[{"text": "City Ballet grew out of earlier troupes: the Producing Company of the School of American Ballet, 1934; the American Ballet, 1935, and Ballet Caravan, 1936, which merged into American Ballet Caravan, 1941; and directly from the Ballet Society, 1946.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac", "type": "PART_OF"}]</data>
