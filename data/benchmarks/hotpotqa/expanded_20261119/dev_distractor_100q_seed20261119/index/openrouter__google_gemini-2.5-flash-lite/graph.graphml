  <data key="d2">[{"text": "The film was based on the 1963 novel \"Undercover Cat\" by Gordon and Mildred Gordon and was directed by Robert Stevenson.", "chunk_id": "15791e4c51cf1c4f", "doc_id": "hp_91f76bb6a0249df4"}]</data>
