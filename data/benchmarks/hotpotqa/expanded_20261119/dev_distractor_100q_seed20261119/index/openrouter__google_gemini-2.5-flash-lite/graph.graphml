  <data key="d1">[{"text": "The 'voice of 3FM' who substituted for Gerard Ekdom on Ekstra Weekend.", "chunk_id": "7d7d42e40a8d63a0", "doc_id": "hp_a0b6962ec4a5ec5a"}]</data>
  <data key="d2">[{"text": "On 6 May 2011, the 'voice of 3FM', Eric Corton, substituted for Gerard Ekdom.", "chunk_id": "7d7d42e40a8d63a0", "doc_id": "hp_a0b6962ec4a5ec5a"}]</data>
