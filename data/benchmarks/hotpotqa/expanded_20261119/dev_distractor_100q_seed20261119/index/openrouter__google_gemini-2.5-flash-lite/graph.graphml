<node id="Bollywood">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Bollywood is the Indian Hindi-language film industry based in Mumbai.", "chunk_id": "1621f78ea00aa2b4", "doc_id": "hp_140ab3de808ede2a"}, {"text": "A film industry associated with romance and the Hindi language.", "chunk_id": "5523473172ebbffa", "doc_id": "hp_4572c47c36fcc241"}, {"text": "Bollywood is a theme that was assigned to episodes of Boogie Woogie.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}, {"text": "The Hindi-language film industry of India.", "chunk_id": "656937d22d978bfd", "doc_id": "hp_e3306a4963e6e08c"}]</data>
  <data key="d2">[{"text": "Divya Rana is a former Bollywood actress most noted for her role in Raj Kapoor's \"Ram Teri Ganga Maili\"", "chunk_id": "1621f78ea00aa2b4", "doc_id": "hp_140ab3de808ede2a"}, {"text": "Prem Rog (Hindi: प्रेम रोग ; English: \"Love Sickness\" ) is 1982 romantic Bollywood film directed by Raj Kapoor.", "chunk_id": "5523473172ebbffa", "doc_id": "hp_4572c47c36fcc241"}, {"text": "In the earlier seasons, the judges assigned various themes to episodes, including Bollywood, Horror, Friendship among others.", "chunk_id": "a6d34da38f2e4327", "doc_id": "hp_a2a8fb62705d96e4"}, {"text": "Born at Kapoor Haveli in Peshawar to actor Prithviraj Kapoorhe was a prominent member of the Kapoor familythat produced several celebrated Bollywood superstars.", "chunk_id": "656937d22d978bfd", "doc_id": "hp_e3306a4963e6e08c"}]</data>
  <data key="d3">["hp_140ab3de808ede2a", "hp_4572c47c36fcc241", "hp_a2a8fb62705d96e4", "hp_e3306a4963e6e08c"]</data>
  <data key="d4">False</data>
</node>
<node id="Ram Teri Ganga Maili">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Ram Teri Ganga Maili is a film noted for Divya Rana's role in it.", "chunk_id": "1621f78ea00aa2b4", "doc_id": "hp_140ab3de808ede2a"}, {"text": "A 1985 Bollywood film directed by Raj Kapoor.", "chunk_id": "9587b01bee29deed", "doc_id": "hp_153a2c475bfeef6e"}]</data>
  <data key="d2">[{"text": "Divya Rana is a former Bollywood actress most noted for her role in Raj Kapoor's \"Ram Teri Ganga Maili\"", "chunk_id": "1621f78ea00aa2b4", "doc_id": "hp_140ab3de808ede2a"}, {"text": "Ram Teri Ganga Maili (literal translation: \"Ram, Your Ganga's Become Impure\") is a 1985 Bollywood film directed by actor-director Raj Kapoor.", "chunk_id": "9587b01bee29deed", "doc_id": "hp_153a2c475bfeef6e"}]</data>
  <data key="d3">["hp_140ab3de808ede2a", "hp_153a2c475bfeef6e"]</data>
  <data key="d4">False</data>
</node>
<node id="Raj Kapoor">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Raj Kapoor is associated with the film \"Ram Teri Ganga Maili\".", "chunk_id": "1621f78ea00aa2b4", "doc_id": "hp_140ab3de808ede2a"}, {"text": "The director of the film \"Mera Naam Joker\".", "chunk_id": "a1abbeeae15652d0", "doc_id": "hp_147900705f372e86"}, {"text": "An actor-director who directed the film Ram Teri Ganga Maili.", "chunk_id": "9587b01bee29deed", "doc_id": "hp_153a2c475bfeef6e"}, {"text": "The director of the 1982 film 'Prem Rog'.", "chunk_id": "5523473172ebbffa", "doc_id": "hp_4572c47c36fcc241"}, {"text": "Raj Kapoor was Karan Kapoor's paternal uncle.", "chunk_id": "9fd31a2bf7019c95", "doc_id": "hp_55a86a5d2ce593ec"}, {"text": "Director, producer, and star of the 1955 Hindi film Shree 420.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}, {"text": "Producer of the Hindi film Kal Aaj Aur Kal.", "chunk_id": "16a91e591a40c438", "doc_id": "hp_b3f0efe2307464b8"}, {"text": "Producer, director, and star of the 1948 film Aag, marking his debut in these roles.", "chunk_id": "4df4b5295e67f801", "doc_id": "hp_b8f974e5ce544d7e"}, {"text": "A noted Indian film actor, producer and director of Hindi cinema.", "chunk_id": "656937d22d978bfd", "doc_id": "hp_e3306a4963e6e08c"}]</data>
  <data key="d2">[{"text": "Divya Rana is a former Bollywood actress most noted for her role in Raj Kapoor's \"Ram Teri Ganga Maili\"", "chunk_id": "1621f78ea00aa2b4", "doc_id": "hp_140ab3de808ede2a"}, {"text": "Mera Naam Joker (translation: \"My Name is Joker\") is a 1970 Indian Hindi drama film directed by Raj Kapoor.", "chunk_id": "a1abbeeae15652d0", "doc_id": "hp_147900705f372e86"}, {"text": "Ram Teri Ganga Maili (literal translation: \"Ram, Your Ganga's Become Impure\") is a 1985 Bollywood film directed by actor-director Raj Kapoor.", "chunk_id": "9587b01bee29deed", "doc_id": "hp_153a2c475bfeef6e"}, {"text": "Prem Rog (Hindi: प्रेम रोग ; English: \"Love Sickness\" ) is 1982 romantic Bollywood film directed by Raj Kapoor.", "chunk_id": "5523473172ebbffa", "doc_id": "hp_4572c47c36fcc241"}, {"text": "His paternal grandfather was Prithviraj Kapoor and his paternal uncles are Raj Kapoor and Shammi Kapoor.", "chunk_id": "9fd31a2bf7019c95", "doc_id": "hp_55a86a5d2ce593ec"}, {"text": "Shree 420 (\"Hindi\" श्री ४२०, translation: \"Sir 420\", also transliterated as Shri 420) is a 1955 Hindi film, directed and produced by Raj Kapoor, written by Khwaja Ahmad Abbas, and starring Raj Kapoor and Nargis.", "chunk_id": "0a8e3d3f676d8b89", "doc_id": "hp_8c200a803fef76a7"}, {"text": "Kal Aaj Aur Kal (Yesterday, Today and Tomorrow) is a 1971 Hindi film produced by Raj Kapoor and directed by his son Randhir Kapoor.", "chunk_id": "16a91e591a40c438", "doc_id": "hp_b3f0efe2307464b8"}, {"text": "Aag (Hindi: आग ; English: \"Fire\" ) is a 1948 Bollywood film which is produced, directed by and stars Raj Kapoor.", "chunk_id": "4df4b5295e67f801", "doc_id": "hp_b8f974e5ce544d7e"}, {"text": "Ranbir Raj Kapoor (14 December 1924 – 2 June 1988), also known as \"the greatest showman of Indian cinema\", was a noted Indian film actor, producer and director of Hindi cinema.", "chunk_id": "656937d22d978bfd", "doc_id": "hp_e3306a4963e6e08c"}]</data>
  <data key="d3">["hp_140ab3de808ede2a", "hp_147900705f372e86", "hp_153a2c475bfeef6e", "hp_4572c47c36fcc241", "hp_55a86a5d2ce593ec", "hp_8c200a803fef76a7", "hp_b3f0efe2307464b8", "hp_b8f974e5ce544d7e", "hp_e3306a4963e6e08c"]</data>
  <data key="d4">False</data>
</node>
<node id="Ek Jaan Hain Hum">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Ek Jaan Hain Hum is a film that marked the beginning of Divya Rana's career.", "chunk_id": "1621f78ea00aa2b4", "doc_id": "hp_140ab3de808ede2a"}]</data>
  <data key="d2">[{"text": "Divya began her career with the film \"Ek Jaan Hain Hum\" (1984) opposite Raj Kapoor's youngest son Rajiv Kapoor.", "chunk_id": "1621f78ea00aa2b4", "doc_id": "hp_140ab3de808ede2a"}]</data>
  <data key="d3">["hp_140ab3de808ede2a"]</data>
  <data key="d4">False</data>
</node>
<node id="Rajiv Kapoor">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Rajiv Kapoor is the youngest son of Raj Kapoor and co-starred with Divya Rana.", "chunk_id": "1621f78ea00aa2b4", "doc_id": "hp_140ab3de808ede2a"}, {"text": "The son of Raj Kapoor and an actor in the film Ram Teri Ganga Maili.", "chunk_id": "9587b01bee29deed", "doc_id": "hp_153a2c475bfeef6e"}]</data>
  <data key="d2">[{"text": "Divya began her career with the film \"Ek Jaan Hain Hum\" (1984) opposite Raj Kapoor's youngest son Rajiv Kapoor.", "chunk_id": "1621f78ea00aa2b4", "doc_id": "hp_140ab3de808ede2a"}, {"text": "The movie stars Mandakini and Rajiv Kapoor, son of Raj Kapoor.", "chunk_id": "9587b01bee29deed", "doc_id": "hp_153a2c475bfeef6e"}]</data>
  <data key="d3">["hp_140ab3de808ede2a", "hp_153a2c475bfeef6e"]</data>
  <data key="d4">False</data>
</node>
