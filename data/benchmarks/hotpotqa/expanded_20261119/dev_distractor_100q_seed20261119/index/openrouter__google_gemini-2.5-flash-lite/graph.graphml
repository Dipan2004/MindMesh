<node id="Ranbir Raj Kapoor">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A noted Indian film actor, producer and director of Hindi cinema.", "chunk_id": "656937d22d978bfd", "doc_id": "hp_e3306a4963e6e08c"}]</data>
  <data key="d2">[{"text": "Ranbir Raj Kapoor (14 December 1924 – 2 June 1988), also known as \"the greatest showman of Indian cinema\", was a noted Indian film actor, producer and director of Hindi cinema.", "chunk_id": "656937d22d978bfd", "doc_id": "hp_e3306a4963e6e08c"}]</data>
  <data key="d3">["hp_e3306a4963e6e08c"]</data>
  <data key="d4">False</data>
</node>
