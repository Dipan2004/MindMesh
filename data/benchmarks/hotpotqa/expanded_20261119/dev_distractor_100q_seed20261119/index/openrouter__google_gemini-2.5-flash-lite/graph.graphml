<node id="Michael Lerner">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Michael Lerner is an American political activist, the editor of \"Tikkun\", and the rabbi of Beyt Tikkun Synagogue.", "chunk_id": "b15598f798e631b6", "doc_id": "hp_ebb527a8921b04b5"}, {"text": "Michael Lerner is the founder of Tikkun magazine.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1"}]</data>
  <data key="d2">[{"text": "Michael Lerner (born 1943) is an American political activist, the editor of \"Tikkun\", a progressive Jewish interfaith magazine based in Berkeley, California, and the rabbi of Beyt Tikkun Synagogue in Berkeley.", "chunk_id": "b15598f798e631b6", "doc_id": "hp_ebb527a8921b04b5"}, {"text": "The magazine was founded in 1986 by Michael Lerner and his then-wife Nan Fink Gefen.", "chunk_id": "db3e8c7571630455", "doc_id": "hp_f15a13a6272383b1"}]</data>
  <data key="d3">["hp_ebb527a8921b04b5", "hp_f15a13a6272383b1"]</data>
  <data key="d4">False</data>
</node>
