<node id="Everything That Happens Will Happen Today">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An album promoted by the Songs of David Byrne and Brian Eno Tour.", "chunk_id": "081d5098b0d99266", "doc_id": "hp_3dfebde99dcc4f0d"}]</data>
  <data key="d2">[{"text": "In addition to being a retrospective of the duo's collaborations, the tour promoted the album \"Everything That Happens Will Happen Today\".", "chunk_id": "081d5098b0d99266", "doc_id": "hp_3dfebde99dcc4f0d"}]</data>
