<node id="southern seas">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The maritime region south of Korea, which came to be dominated by Joseon's forces after the Battle of Hansan Island.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d2">[{"text": "The battle, one of the three great battles won by Joseon during the Imjin Waeran, carried great import, because Joseon's forces now came to dominate the southern seas.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d3">["hp_4e9436b9b6a97ad9"]</data>
  <data key="d4">False</data>
</node>
<node id="Hansan-do">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "An island near which the Battle of Hansan Island took place.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d2">[{"text": "After Hansan-do Toyotomi Hideyoshi ordered the Japanese navy to avoid direct engagement with the Joseon navy and instead station itself in fortifications along the coast to defend important sea lands.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d3">["hp_4e9436b9b6a97ad9"]</data>
