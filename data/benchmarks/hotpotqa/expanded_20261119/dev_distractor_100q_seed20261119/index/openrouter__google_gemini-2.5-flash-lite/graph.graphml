  <data key="d2">[{"text": "Sonic Enemy is an independent record label, owned by Peter Hughes, best known for releasing Beck's first full-length album on cassette, \"Golden Feelings\" (1993).", "chunk_id": "57f89dc3a18cfd92", "doc_id": "hp_02b0abd7864c108e"}]</data>
  <data key="d3">["hp_02b0abd7864c108e"]</data>
