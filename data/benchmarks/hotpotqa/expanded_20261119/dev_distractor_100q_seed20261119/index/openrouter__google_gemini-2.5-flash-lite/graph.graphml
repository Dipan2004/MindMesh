<edge source="Hong Kong's Legislative Council" target="Basic Law">
  <data key="d5">["AMENDED"]</data>
  <data key="d6">The Legislative Council of Hong Kong passed an amendment to the Basic Law.</data>
  <data key="d7">[{"text": "Immediately after the handover of Hong Kong back to Chinese rule, Hong Kong's Legislative Council passed an amendment to the Basic Law that would restrict immigration to children born outside of Hong Kong that were born to Hong Kong residents.", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1", "type": "AMENDED"}]</data>
  <data key="d8">hp_0e063f0231106ec1</data>
</edge>
<edge source="Court of Final Appeal" target="Basic Law">
  <data key="d5">["RULED_AGAINST"]</data>
  <data key="d6">The Court of Final Appeal ruled against an amendment to the Basic Law.</data>
  <data key="d7">[{"text": "The constitutionality of this amendment came to be challenged in court, and in January 1999, the Court of Final Appeal ruled against the amendment.", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1", "type": "RULED_AGAINST"}]</data>
  <data key="d8">hp_0e063f0231106ec1</data>
</edge>
<edge source="mainland China" target="Hong Kong">
  <data key="d5">["GRANTED_RIGHT_OF_ABODE"]</data>
  <data key="d6">People in mainland China were granted the right of abode in Hong Kong.</data>
  <data key="d7">[{"text": "This ruling immediately granted up to 300,000 people in mainland China the right of abode in Hong Kong, and it was estimated that within the next ten years, about 1.6 million people in mainland China would become eligible for right of abode in Hong Kong.", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1", "type": "GRANTED_RIGHT_OF_ABODE"}]</data>
  <data key="d8">hp_0e063f0231106ec1</data>
</edge>
