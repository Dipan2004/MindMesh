</node>
<node id="Brian Shaw">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An athlete from the United States who won the 2013 World's Strongest Man competition.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "An athlete from the United States who finished in third place in the 2014 World's Strongest Man competition.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d2">[{"text": "Brian Shaw from the United States placed first, winning his second WSM title after winning in 2011.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "Hafþór Júlíus Björnsson from Iceland finished in second place, and Brian Shaw from the United States came in third.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d3">["hp_45c17b9e08342c16", "hp_5d64f24bd8d85ba4"]</data>
  <data key="d4">False</data>
</node>
<node id="WSM title">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The championship title awarded in the World's Strongest Man competition.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}]</data>
  <data key="d2">[{"text": "Brian Shaw from the United States placed first, winning his second WSM title after winning in 2011.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}]</data>
  <data key="d3">["hp_45c17b9e08342c16"]</data>
  <data key="d4">False</data>
</node>
<node id="Lithuania">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A country from which Zydrunas Savickas hails.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "A country from which Zydrunas Savickas originates.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d2">[{"text": "Zydrunas Savickas from Lithuania was second after finishing 1st the year before, and Hafþór Júlíus Björnsson from Iceland was third for the second year in a row.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "Zydrunas Savickas from Lithuania finished in first place, this was his fourth WSM title.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d3">["hp_45c17b9e08342c16", "hp_5d64f24bd8d85ba4"]</data>
  <data key="d4">False</data>
</node>
<node id="Iceland">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A country from which Hafþór Júlíus Björnsson hails.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "A country from which Hafþór Júlíus Björnsson originates.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d2">[{"text": "Zydrunas Savickas from Lithuania was second after finishing 1st the year before, and Hafþór Júlíus Björnsson from Iceland was third for the second year in a row.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "Hafþór Júlíus Björnsson from Iceland finished in second place, and Brian Shaw from the United States came in third.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d3">["hp_45c17b9e08342c16", "hp_5d64f24bd8d85ba4"]</data>
  <data key="d4">False</data>
</node>
<node id="Battle of Ligny">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Battle of Ligny was the last victory of the military career of Napoleon Bonaparte.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d2">[{"text": "The Battle of Ligny (16 June 1815) was the last victory of the military career of Napoleon Bonaparte.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d3">["hp_45df433ff36c6e4e"]</data>
  <data key="d4">False</data>
</node>
<node id="Napoleon Bonaparte">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Napoleon Bonaparte was a French military leader and emperor.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d2">[{"text": "The Battle of Ligny (16 June 1815) was the last victory of the military career of Napoleon Bonaparte.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d3">["hp_45df433ff36c6e4e"]</data>
  <data key="d4">False</data>
</node>
<node id="Armée du Nord">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Armée du Nord was a French army commanded by Napoleon Bonaparte.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d2">[{"text": "In this battle, French troops of the Armée du Nord under Napoleon's command, defeated part of a Prussian army under Field Marshal Prince Blücher, near Ligny in present-day Belgium.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d3">["hp_45df433ff36c6e4e"]</data>
  <data key="d4">False</data>
</node>
<node id="Prussian army">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Prussian army was defeated in part by French troops at the Battle of Ligny.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d2">[{"text": "In this battle, French troops of the Armée du Nord under Napoleon's command, defeated part of a Prussian army under Field Marshal Prince Blücher, near Ligny in present-day Belgium.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d3">["hp_45df433ff36c6e4e"]</data>
  <data key="d4">False</data>
</node>
<node id="Field Marshal Prince Blücher">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Field Marshal Prince Blücher commanded part of the Prussian army at the Battle of Ligny.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d2">[{"text": "In this battle, French troops of the Armée du Nord under Napoleon's command, defeated part of a Prussian army under Field Marshal Prince Blücher, near Ligny in present-day Belgium.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d3">["hp_45df433ff36c6e4e"]</data>
  <data key="d4">False</data>
</node>
<node id="Ligny">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Ligny is a location in present-day Belgium where the Battle of Ligny took place.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d2">[{"text": "In this battle, French troops of the Armée du Nord under Napoleon's command, defeated part of a Prussian army under Field Marshal Prince Blücher, near Ligny in present-day Belgium.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d3">["hp_45df433ff36c6e4e"]</data>
  <data key="d4">False</data>
</node>
<node id="tactical win">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A tactical win is a type of victory achieved in battle.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d2">[{"text": "The Battle of Ligny is an example of a tactical win and a strategic loss for the French.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d3">["hp_45df433ff36c6e4e"]</data>
  <data key="d4">False</data>
</node>
<node id="strategic loss">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A strategic loss is a type of defeat that has negative long-term consequences.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d2">[{"text": "The Battle of Ligny is an example of a tactical win and a strategic loss for the French.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d3">["hp_45df433ff36c6e4e"]</data>
  <data key="d4">False</data>
</node>
<node id="IV Prussian corps">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The IV Prussian corps reinforced the Prussian army at the Battle of Waterloo.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d2">[{"text": "While the French troops did force the enemy to retreat, the Prussian army survived and went on to play a pivotal role two days later at the Battle of Waterloo, reinforced by IV Prussian corps that had not participated in the battle at Ligny.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d3">["hp_45df433ff36c6e4e"]</data>
  <data key="d4">False</data>
</node>
<node id="Battle of Waterloo">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Battle of Waterloo occurred two days after the Battle of Ligny and involved the Prussian army.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d2">[{"text": "While the French troops did force the enemy to retreat, the Prussian army survived and went on to play a pivotal role two days later at the Battle of Waterloo, reinforced by IV Prussian corps that had not participated in the battle at Ligny.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d3">["hp_45df433ff36c6e4e"]</data>
  <data key="d4">False</data>
</node>
<node id="Anglo-allied Army">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Anglo-allied Army was an army under Wellington that the Prussian army might have joined at Waterloo.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d2">[{"text": "Had the French army succeeded in keeping the Prussian army from joining the Anglo-allied Army under Wellington at Waterloo, Napoleon might have won the Waterloo Campaign.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d3">["hp_45df433ff36c6e4e"]</data>
  <data key="d4">False</data>
</node>
<node id="Wellington">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Wellington commanded the Anglo-allied Army at the Battle of Waterloo.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}, {"text": "A location where Daniel C. Goldie won tennis titles.", "chunk_id": "f3bc6bdeb3b7f477", "doc_id": "hp_ce1cd3eb59940b9f"}]</data>
  <data key="d2">[{"text": "Had the French army succeeded in keeping the Prussian army from joining the Anglo-allied Army under Wellington at Waterloo, Napoleon might have won the Waterloo Campaign.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}, {"text": "Daniel C. Goldie (born October 3, 1963) is a former tennis player from the United States who won 2 singles (1987, Newport and 1988, Seoul) and 2 doubles titles (1986, Wellington and 1987, Newport).", "chunk_id": "f3bc6bdeb3b7f477", "doc_id": "hp_ce1cd3eb59940b9f"}]</data>
  <data key="d3">["hp_45df433ff36c6e4e", "hp_ce1cd3eb59940b9f"]</data>
  <data key="d4">False</data>
</node>
<node id="Waterloo Campaign">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Waterloo Campaign was a military campaign that Napoleon might have won if the French army had prevented the Prussian army from joining the Anglo-allied Army.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d2">[{"text": "Had the French army succeeded in keeping the Prussian army from joining the Anglo-allied Army under Wellington at Waterloo, Napoleon might have won the Waterloo Campaign.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}]</data>
  <data key="d3">["hp_45df433ff36c6e4e"]</data>
  <data key="d4">False</data>
</node>
<node id="French New Wave">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A film movement that Demy appeared in the wake of.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}]</data>
  <data key="d2">[{"text": "He appeared in the wake of the French New Wave alongside contemporaries like Jean-Luc Godard and François Truffaut.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}]</data>
  <data key="d3">["hp_4627d420baa4b1fd"]</data>
  <data key="d4">False</data>
</node>
<node id="Jean-Luc Godard">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A contemporary of Jacques Demy in the French New Wave.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}]</data>
  <data key="d2">[{"text": "He appeared in the wake of the French New Wave alongside contemporaries like Jean-Luc Godard and François Truffaut.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}]</data>
  <data key="d3">["hp_4627d420baa4b1fd"]</data>
  <data key="d4">False</data>
</node>
<node id="François Truffaut">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A contemporary of Jacques Demy in the French New Wave.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}]</data>
  <data key="d2">[{"text": "He appeared in the wake of the French New Wave alongside contemporaries like Jean-Luc Godard and François Truffaut.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}]</data>
  <data key="d3">["hp_4627d420baa4b1fd"]</data>
  <data key="d4">False</data>
</node>
<node id="Classic Hollywood musicals">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A source of inspiration for Jacques Demy's film style.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}]</data>
  <data key="d2">[{"text": "Demy's style drew upon such diverse sources as Classic Hollywood musicals, the documentary realism of his New Wave colleagues, fairy-tales, jazz, Japanese manga, and the opera.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}]</data>
  <data key="d3">["hp_4627d420baa4b1fd"]</data>
  <data key="d4">False</data>
</node>
<node id="fairy-tales">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A source of inspiration for Jacques Demy's film style.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}]</data>
  <data key="d2">[{"text": "Demy's style drew upon such diverse sources as Classic Hollywood musicals, the documentary realism of his New Wave colleagues, fairy-tales, jazz, Japanese manga, and the opera.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}]</data>
  <data key="d3">["hp_4627d420baa4b1fd"]</data>
  <data key="d4">False</data>
</node>
<node id="jazz">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A source of inspiration for Jacques Demy's film style.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}, {"text": "A musical style from which Ravel borrowed effects for his concerto.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}, {"text": "Jazz is a genre of music that Mark O'Connor plays.", "chunk_id": "83ff2598ffe55600", "doc_id": "hp_f2e2e7c2a56a9856"}]</data>
  <data key="d2">[{"text": "Demy's style drew upon such diverse sources as Classic Hollywood musicals, the documentary realism of his New Wave colleagues, fairy-tales, jazz, Japanese manga, and the opera.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}, {"text": "Ravel composed the concerto after travelling in the United States and is reported to have described the work as \"... written in very much the same spirit as those of Mozart and Saint-Saëns,\" and said that \"it uses certain effects borrowed from jazz, but only in moderation.\"", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}, {"text": "Mark O'Connor (born August 5, 1961, Seattle) is an American bluegrass, jazz and country violinist, fiddler, composer and music teacher.", "chunk_id": "83ff2598ffe55600", "doc_id": "hp_f2e2e7c2a56a9856"}]</data>
  <data key="d3">["hp_4627d420baa4b1fd", "hp_c8a6c3f50e115d2a", "hp_f2e2e7c2a56a9856"]</data>
  <data key="d4">False</data>
</node>
<node id="Japanese manga">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A source of inspiration for Jacques Demy's film style.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}]</data>
  <data key="d2">[{"text": "Demy's style drew upon such diverse sources as Classic Hollywood musicals, the documentary realism of his New Wave colleagues, fairy-tales, jazz, Japanese manga, and the opera.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}]</data>
  <data key="d3">["hp_4627d420baa4b1fd"]</data>
  <data key="d4">False</data>
</node>
<node id="opera">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A source of inspiration for Jacques Demy's film style.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}, {"text": "A dramatic work in one or more acts, set to music for singers and instrumentalists.", "chunk_id": "2891147d16c383c0", "doc_id": "hp_4843512989d31138"}, {"text": "A genre of music theatre.", "chunk_id": "f317bf6030b1131e", "doc_id": "hp_a09bf8eaffccdd21"}]</data>
  <data key="d2">[{"text": "Demy's style drew upon such diverse sources as Classic Hollywood musicals, the documentary realism of his New Wave colleagues, fairy-tales, jazz, Japanese manga, and the opera.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}, {"text": "For an introduction to operatic history, see opera.", "chunk_id": "2891147d16c383c0", "doc_id": "hp_4843512989d31138"}, {"text": "Evans has composed and performed music for opera and musical theatre, piano, art songs, prepared piano, choral music, string orchestra and chamber music.", "chunk_id": "f317bf6030b1131e", "doc_id": "hp_a09bf8eaffccdd21"}]</data>
  <data key="d3">["hp_4627d420baa4b1fd", "hp_4843512989d31138", "hp_a09bf8eaffccdd21"]</data>
  <data key="d4">False</data>
</node>
<node id="teenaged love">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A motif present in Jacques Demy's films.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}]</data>
  <data key="d2">[{"text": "His films contain overlapping continuity (i.e., characters cross over from film to film), lush musical scores (typically composed by Michel Legrand) and motifs like teenaged love, labor rights, incest, and the intersection between dreams and reality.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}]</data>
  <data key="d3">["hp_4627d420baa4b1fd"]</data>
  <data key="d4">False</data>
</node>
