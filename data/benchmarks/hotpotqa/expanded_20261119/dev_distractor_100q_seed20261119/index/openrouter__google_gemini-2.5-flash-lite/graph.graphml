  <data key="d2">[{"text": "The Tesla Gigafactory 1 is an operational lithium-ion battery factory under construction, primarily for Tesla Inc., at the Tahoe Reno Industrial Center (TRIC) in Storey County (near the Community of Clark, Nevada, US).", "chunk_id": "51ed4dfb52cf2e60", "doc_id": "hp_5df9f2d47c876b64"}, {"text": "The Tahoe Reno Industrial Center (TRI Center, or TRIC) is a privately owned 107,000 acre industrial park, located at Interstate 80 next to Clark, Storey County, Nevada.", "chunk_id": "53d19b7b5423b1f7", "doc_id": "hp_63a714bc28813989"}]</data>
