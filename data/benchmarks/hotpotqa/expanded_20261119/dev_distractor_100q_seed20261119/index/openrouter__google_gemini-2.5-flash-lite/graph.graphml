  <data key="d5">["PARTICIPATED_IN"]</data>
  <data key="d6">Emilio Sánchez was a defending champion but did not participate in the 1991 Donnay Indoor Championships – Doubles.</data>
  <data key="d7">[{"text": "Emilio Sánchez and Slobodan Živojinović were the defending champions, but Sánchez did not participate this year.", "chunk_id": "72b8f48b7ecf936b", "doc_id": "hp_335fb09af115eccf", "type": "PARTICIPATED_IN"}]</data>
  <data key="d8">hp_335fb09af115eccf</data>
</edge>
