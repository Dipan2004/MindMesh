<node id="grand hotels">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Large, luxurious hotels, often built during periods of tourism growth.", "chunk_id": "f08df480ee1f1eb9", "doc_id": "hp_eeeb2d687b105e04"}]</data>
  <data key="d2">[{"text": "He is best known for his work on a series of \"grand hotels\" built in connection with the Swiss tourism boom during the second half of the nineteenth century.", "chunk_id": "f08df480ee1f1eb9", "doc_id": "hp_eeeb2d687b105e04"}]</data>
  <data key="d3">["hp_eeeb2d687b105e04"]</data>
