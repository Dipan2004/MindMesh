</edge>
<edge source="Thomas Welton Stanford" target="Australia">
  <data key="d5">["LIVED_IN"]</data>
  <data key="d6">Thomas Welton Stanford lived most of his adult life in Australia.</data>
  <data key="d7">[{"text": "Although living most of his adult life in Australia, he kept his American citizenship and served intermittently as honorary American vice consul-general in Melbourne.", "chunk_id": "232d1486ef3116d2", "doc_id": "hp_69dbe4380588b108", "type": "LIVED_IN"}]</data>
  <data key="d8">hp_69dbe4380588b108</data>
</edge>
