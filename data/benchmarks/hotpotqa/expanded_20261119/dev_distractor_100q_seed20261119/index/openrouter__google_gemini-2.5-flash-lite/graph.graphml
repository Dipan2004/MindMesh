  <data key="d1">[{"text": "Otoka is a location where Istiklal Mosque is situated.", "chunk_id": "1cbf4009842f5c2b", "doc_id": "hp_1228d503d45e5b99"}]</data>
  <data key="d2">[{"text": "Istiqlal Mosque, or Masjid Istiqlal, (Independence Mosque) in Otoka, Sarajevo, Bosnia and Herzegovina is one of the largest mosques in the city.", "chunk_id": "1cbf4009842f5c2b", "doc_id": "hp_1228d503d45e5b99"}]</data>
  <data key="d3">["hp_1228d503d45e5b99"]</data>
  <data key="d4">False</data>
</node>
<node id="Sarajevo">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Sarajevo is a city in Bosnia and Herzegovina where Istiklal Mosque is located.", "chunk_id": "1cbf4009842f5c2b", "doc_id": "hp_1228d503d45e5b99"}]</data>
  <data key="d2">[{"text": "Istiqlal Mosque, or Masjid Istiqlal, (Independence Mosque) in Otoka, Sarajevo, Bosnia and Herzegovina is one of the largest mosques in the city.", "chunk_id": "1cbf4009842f5c2b", "doc_id": "hp_1228d503d45e5b99"}]</data>
  <data key="d3">["hp_1228d503d45e5b99"]</data>
