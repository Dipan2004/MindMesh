<node id="Roger Federer">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A professional tennis player who was the defending champion in the 2013 Wimbledon Championships.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608"}, {"text": "Roger Federer is a Swiss player to whom Mark Philippoussis lost in the 2003 Wimbledon finals.", "chunk_id": "4d09236de753d49e", "doc_id": "hp_3a454527b720381c"}]</data>
  <data key="d2">[{"text": "Roger Federer was the defending champion but lost in the second round to World No. 116 Sergiy Stakhovsky in a huge upset.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608"}, {"text": "He also reached the finals of the 1998 US Open and the 2003 Wimbledon tournaments, losing to countryman Pat Rafter and Swiss Roger Federer respectively.", "chunk_id": "4d09236de753d49e", "doc_id": "hp_3a454527b720381c"}]</data>
  <data key="d3">["hp_0e39951795747608", "hp_3a454527b720381c"]</data>
  <data key="d4">False</data>
</node>
<node id="Sergiy Stakhovsky">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A tennis player ranked World No. 116 who defeated Roger Federer in the second round of the 2013 Wimbledon Championships.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608"}]</data>
  <data key="d2">[{"text": "Roger Federer was the defending champion but lost in the second round to World No. 116 Sergiy Stakhovsky in a huge upset.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608"}]</data>
  <data key="d3">["hp_0e39951795747608"]</data>
  <data key="d4">False</data>
</node>
<node id="Jürgen Melzer">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A tennis player who defeated Sergiy Stakhovsky in the next round of the 2013 Wimbledon Championships.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608"}]</data>
  <data key="d2">[{"text": "Stakhovsky was unable to build on his effort and lost in the next round in 4 sets to Jürgen Melzer.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608"}]</data>
  <data key="d3">["hp_0e39951795747608"]</data>
  <data key="d4">False</data>
</node>
<node id="2004 French Open">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A Grand Slam tennis tournament where Roger Federer lost to Gustavo Kuerten in the third round.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608"}, {"text": "The 2004 French Open was a mixed doubles Grand Slam tennis event.", "chunk_id": "9427c18f95847c63", "doc_id": "hp_be33f525d9693352"}]</data>
  <data key="d2">[{"text": "Federer's loss marked the first time since the 2004 French Open, when he lost to Gustavo Kuerten in the third round, that he had failed to reach at least the quarterfinals in a Grand Slam event.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608"}, {"text": "He won the mixed doubles Grand Slam title at the 2004 French Open, partnering Tatiana Golovin.", "chunk_id": "9427c18f95847c63", "doc_id": "hp_be33f525d9693352"}]</data>
  <data key="d3">["hp_0e39951795747608", "hp_be33f525d9693352"]</data>
  <data key="d4">False</data>
</node>
<node id="Gustavo Kuerten">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A tennis player who defeated Roger Federer in the third round of the 2004 French Open.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608"}]</data>
  <data key="d2">[{"text": "Federer's loss marked the first time since the 2004 French Open, when he lost to Gustavo Kuerten in the third round, that he had failed to reach at least the quarterfinals in a Grand Slam event.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608"}]</data>
  <data key="d3">["hp_0e39951795747608"]</data>
  <data key="d4">False</data>
</node>
<node id="Grand Slam event">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A major tennis tournament.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608"}, {"text": "Grand Slam events are major tennis tournaments.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}]</data>
  <data key="d2">[{"text": "Federer's loss marked the first time since the 2004 French Open, when he lost to Gustavo Kuerten in the third round, that he had failed to reach at least the quarterfinals in a Grand Slam event.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608"}, {"text": "She won 64 Grand Slam events (24 singles, 19 doubles, 21 mixed doubles), which is a record for a male or female player.", "chunk_id": "cc00d89bd0ab005a", "doc_id": "hp_80a1699490fb30e6"}]</data>
  <data key="d3">["hp_0e39951795747608", "hp_80a1699490fb30e6"]</data>
  <data key="d4">False</data>
</node>
<node id="2002">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The year Roger Federer had his earliest exit in the Wimbledon tournament prior to 2013.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608"}]</data>
  <data key="d2">[{"text": "It was also Federer's earliest exit in this tournament since 2002, and the first time that Federer lost to a player ranked lower than 100 since his loss to then World No. 101 Richard Gasquet at the 2005 Monte Carlo Masters.", "chunk_id": "c8cc566295efdc24", "doc_id": "hp_0e39951795747608"}]</data>
  <data key="d3">["hp_0e39951795747608"]</data>
  <data key="d4">False</data>
</node>
