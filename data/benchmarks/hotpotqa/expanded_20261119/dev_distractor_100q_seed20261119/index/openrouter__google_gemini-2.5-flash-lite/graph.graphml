<node id="Yandang Mountains">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A coastal mountain range in southeastern Zhejiang province in eastern China.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26"}]</data>
  <data key="d2">[{"text": "Yandang Mountains or Yandangshan (Chinese:  雁蕩山 ,  雁荡山 ,  \"Yàndàng Shān\",  \"Wild Goose Pond Mountain(s)\") refers, in the broad sense, to a coastal mountain range in southeastern Zhejiang province in eastern China, covering much of the prefecture-level city of Wenzhou (from Pingyang County in the south to Yueqing County in the northeast) and extending to the county-level city of Wenling in Taizhou prefecture.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26"}]</data>
  <data key="d3">["hp_a71b119b261e3b26"]</data>
  <data key="d4">False</data>
</node>
<node id="Yandangshan">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Refers to a coastal mountain range in southeastern Zhejiang province in eastern China, and more narrowly to Mount Yandang, a specific part of the North Yandang around an ancient caldera.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26"}]</data>
  <data key="d2">[{"text": "Yandang Mountains or Yandangshan (Chinese:  雁蕩山 ,  雁荡山 ,  \"Yàndàng Shān\",  \"Wild Goose Pond Mountain(s)\") refers, in the broad sense, to a coastal mountain range in southeastern Zhejiang province in eastern China, covering much of the prefecture-level city of Wenzhou (from Pingyang County in the south to Yueqing County in the northeast) and extending to the county-level city of Wenling in Taizhou prefecture.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26"}]</data>
  <data key="d3">["hp_a71b119b261e3b26"]</data>
  <data key="d4">False</data>
</node>
<node id="Wenzhou">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A prefecture-level city in Zhejiang province that is largely covered by the Yandang Mountains.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26"}]</data>
  <data key="d2">[{"text": "Yandang Mountains or Yandangshan (Chinese:  雁蕩山 ,  雁荡山 ,  \"Yàndàng Shān\",  \"Wild Goose Pond Mountain(s)\") refers, in the broad sense, to a coastal mountain range in southeastern Zhejiang province in eastern China, covering much of the prefecture-level city of Wenzhou (from Pingyang County in the south to Yueqing County in the northeast) and extending to the county-level city of Wenling in Taizhou prefecture.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26"}]</data>
  <data key="d3">["hp_a71b119b261e3b26"]</data>
  <data key="d4">False</data>
</node>
<node id="Pingyang County">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A county in the south of Wenzhou prefecture, part of the area covered by the Yandang Mountains.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26"}]</data>
  <data key="d2">[{"text": "Yandang Mountains or Yandangshan (Chinese:  雁蕩山 ,  雁荡山 ,  \"Yàndàng Shān\",  \"Wild Goose Pond Mountain(s)\") refers, in the broad sense, to a coastal mountain range in southeastern Zhejiang province in eastern China, covering much of the prefecture-level city of Wenzhou (from Pingyang County in the south to Yueqing County in the northeast) and extending to the county-level city of Wenling in Taizhou prefecture.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26"}]</data>
  <data key="d3">["hp_a71b119b261e3b26"]</data>
  <data key="d4">False</data>
