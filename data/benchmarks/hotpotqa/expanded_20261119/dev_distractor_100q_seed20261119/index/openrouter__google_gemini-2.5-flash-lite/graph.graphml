  <data key="d2">[{"text": "She reprised her role as Amy Szalinski in the 1992 sequel, \"Honey, I Blew Up the Kid\" and appeared as Lisa Barnes in \"Where's Rodney?\".", "chunk_id": "6f7849fc13c087db", "doc_id": "hp_7ed9ce59d4321c4f"}]</data>
