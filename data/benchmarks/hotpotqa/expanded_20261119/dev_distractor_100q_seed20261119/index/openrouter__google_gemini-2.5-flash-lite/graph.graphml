  <data key="d2">[{"text": "Chris Hegedus and D. A. Pennebaker produced the film, which stars Jacqueline Ceballos, Germaine Greer, Jill Johnston, Diane Trilling, and Norman Mailer.", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}]</data>
