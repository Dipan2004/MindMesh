<edge source="Leung Po Shan" target="installation art">
  <data key="d5">["SPECIALIZED_IN", "INVOLVED_IN"]</data>
  <data key="d6">Leung Po Shan specializes in installation art.</data>
  <data key="d7">[{"text": "Leung Po Shan (Anthony, Chinese: 梁寶山) is a Hong Kong artist specialized in installation and performance art.", "chunk_id": "897f999db778cfd7", "doc_id": "hp_0072f61fd930d308", "type": "SPECIALIZED_IN"}, {"text": "Playing with images, texts and body in theater, performance and installation, she has been involved in many major exhibitions, both locally and internationally.", "chunk_id": "897f999db778cfd7", "doc_id": "hp_0072f61fd930d308", "type": "INVOLVED_IN"}]</data>
  <data key="d8">hp_0072f61fd930d308</data>
</edge>
