<node id="Dean of Chelmsford">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The head and chair of the Cathedral Chapter of Chelmsford Cathedral.", "chunk_id": "147b3f29c0fcd687", "doc_id": "hp_e801334348d2b1fc"}]</data>
  <data key="d2">[{"text": "The Dean of Chelmsford is the head (\"primus inter pares\" – first among equals) and chair of the Cathedral Chapter, the governing body of Chelmsford Cathedral, the Cathedral Church of St Mary the Virgin, St Peter and St Cedd.", "chunk_id": "147b3f29c0fcd687", "doc_id": "hp_e801334348d2b1fc"}]</data>
  <data key="d3">["hp_e801334348d2b1fc"]</data>
  <data key="d4">False</data>
</node>
<node id="Cathedral Chapter">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The governing body of Chelmsford Cathedral.", "chunk_id": "147b3f29c0fcd687", "doc_id": "hp_e801334348d2b1fc"}]</data>
  <data key="d2">[{"text": "The Dean of Chelmsford is the head (\"primus inter pares\" – first among equals) and chair of the Cathedral Chapter, the governing body of Chelmsford Cathedral, the Cathedral Church of St Mary the Virgin, St Peter and St Cedd.", "chunk_id": "147b3f29c0fcd687", "doc_id": "hp_e801334348d2b1fc"}]</data>
  <data key="d3">["hp_e801334348d2b1fc"]</data>
  <data key="d4">False</data>
</node>
<node id="provost">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A former designation for the head of Chelmsford Cathedral before 2000, equivalent to a dean at most English cathedrals.", "chunk_id": "147b3f29c0fcd687", "doc_id": "hp_e801334348d2b1fc"}]</data>
  <data key="d2">[{"text": "Before 2000 the post was designated as a provost, which was then the equivalent of a dean at most English cathedrals.", "chunk_id": "147b3f29c0fcd687", "doc_id": "hp_e801334348d2b1fc"}]</data>
  <data key="d3">["hp_e801334348d2b1fc"]</data>
  <data key="d4">False</data>
</node>
<node id="Diocese of Chelmsford">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The ecclesiastical province for which Chelmsford Cathedral serves as the mother church.", "chunk_id": "147b3f29c0fcd687", "doc_id": "hp_e801334348d2b1fc"}]</data>
  <data key="d2">[{"text": "The cathedral is the mother church of the Diocese of Chelmsford and seat of the Bishop of Chelmsford.", "chunk_id": "147b3f29c0fcd687", "doc_id": "hp_e801334348d2b1fc"}]</data>
  <data key="d3">["hp_e801334348d2b1fc"]</data>
  <data key="d4">False</data>
</node>
<node id="Chapel of St Peter-on-the-Wall">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A chapel at Bradwell-on-Sea for which the Dean of Chelmsford is responsible.", "chunk_id": "147b3f29c0fcd687", "doc_id": "hp_e801334348d2b1fc"}]</data>
  <data key="d2">[{"text": "The Dean of Chelmsford is also responsible for the Chapel of St Peter-on-the-Wall at Bradwell-on-Sea, founded by St Cedd, among the oldest church buildings in regular use in England.", "chunk_id": "147b3f29c0fcd687", "doc_id": "hp_e801334348d2b1fc"}]</data>
  <data key="d3">["hp_e801334348d2b1fc"]</data>
  <data key="d4">False</data>
</node>
