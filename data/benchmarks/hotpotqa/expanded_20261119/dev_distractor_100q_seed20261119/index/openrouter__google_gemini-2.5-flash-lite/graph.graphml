<node id="carnatic music solfege">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Carnatic music solfege is a vocal technique used in musical compositions that do not have lyrics.", "chunk_id": "97edcc6d4aeb286e", "doc_id": "hp_5dc26ff008a9a27c"}]</data>
  <data key="d2">[{"text": "The compositions do not have any lyrics, but contains carnatic music solfege.", "chunk_id": "97edcc6d4aeb286e", "doc_id": "hp_5dc26ff008a9a27c"}]</data>
  <data key="d3">["hp_5dc26ff008a9a27c"]</data>
  <data key="d4">False</data>
</node>
<node id="Home (Leah McFall song)">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A song recorded by British singer Leah McFall.", "chunk_id": "34f0716f90d6f2b6", "doc_id": "hp_5dcefaaf0dc1a112"}]</data>
  <data key="d2">[{"text": "\"Home\" is a song recorded by British singer Leah McFall, the runner-up on the second series of the BBC talent show \"The Voice\", featuring guest vocals from her show mentor will.i.am.", "chunk_id": "34f0716f90d6f2b6", "doc_id": "hp_5dcefaaf0dc1a112"}]</data>
