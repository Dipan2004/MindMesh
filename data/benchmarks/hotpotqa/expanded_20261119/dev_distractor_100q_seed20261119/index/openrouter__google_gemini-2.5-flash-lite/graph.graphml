<edge source="Boulevard Solitude" target="Paris">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">Boulevard Solitude is relocated to Paris.</data>
  <data key="d7">[{"text": "The piece is a reworking of the Manon Lescaut story, already adapted operatically by Auber, Massenet and Puccini, and here relocated to Paris after the Second World War where, as is noted in Grove, the focus of the story moves away from Manon and towards Armand des Grieux.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_ce10cea1030952d1</data>
</edge>
<edge source="Boulevard Solitude" target="Second World War">
  <data key="d5">["SET_AFTER"]</data>
  <data key="d6">Boulevard Solitude is set after the Second World War.</data>
  <data key="d7">[{"text": "The piece is a reworking of the Manon Lescaut story, already adapted operatically by Auber, Massenet and Puccini, and here relocated to Paris after the Second World War where, as is noted in Grove, the focus of the story moves away from Manon and towards Armand des Grieux.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1", "type": "SET_AFTER"}]</data>
  <data key="d8">hp_ce10cea1030952d1</data>
</edge>
<edge source="Boulevard Solitude" target="jazz influences">
  <data key="d5">["HAS_INFLUENCE_FROM"]</data>
  <data key="d6">Boulevard Solitude has strong jazz influences.</data>
  <data key="d7">[{"text": "The work stands out for its strong jazz influences, from a composer who had hitherto been associated with twelve tone technique.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1", "type": "HAS_INFLUENCE_FROM"}]</data>
  <data key="d8">hp_ce10cea1030952d1</data>
</edge>
<edge source="Hans Werner Henze" target="Boulevard Solitude">
  <data key="d5">["COMPOSED"]</data>
  <data key="d6">Hans Werner Henze composed Boulevard Solitude.</data>
  <data key="d7">[{"text": "Boulevard Solitude is a \"Lyrisches Drama \" (lyric drama) or opera in one act by Hans Werner Henze to a German libretto by Grete Weil after the play by Walter Jockisch, in its turn a modern retelling of François Prévost's \"Manon Lescaut\".", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1", "type": "COMPOSED"}]</data>
  <data key="d8">hp_ce10cea1030952d1</data>
</edge>
<edge source="Hans Werner Henze" target="twelve tone technique">
  <data key="d5">["ASSOCIATED_WITH"]</data>
  <data key="d6">Hans Werner Henze had hitherto been associated with twelve tone technique.</data>
  <data key="d7">[{"text": "The work stands out for its strong jazz influences, from a composer who had hitherto been associated with twelve tone technique.", "chunk_id": "8dbccb5758e54e3f", "doc_id": "hp_ce10cea1030952d1", "type": "ASSOCIATED_WITH"}]</data>
  <data key="d8">hp_ce10cea1030952d1</data>
</edge>
