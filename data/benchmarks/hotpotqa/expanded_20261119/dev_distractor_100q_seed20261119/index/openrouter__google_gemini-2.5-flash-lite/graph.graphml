  <data key="d7">[{"text": "After serving for four years as Whig Member of Parliament for Richmond, he was given command of the fifth-rate HMS \"Euryalus\" and took part in the unsuccessful Walcheren Campaign in July 1809 during the Napoleonic Wars.", "chunk_id": "d43d20bf97a0fc28", "doc_id": "hp_56ae2e2bc0735743", "type": "PART_OF"}]</data>
