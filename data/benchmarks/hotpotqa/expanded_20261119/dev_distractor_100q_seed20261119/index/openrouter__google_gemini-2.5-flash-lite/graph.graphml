  <data key="d2">[{"text": "When one of the two was absent, he was replaced by Domien Verschuuren, nicknamed Iemand Anders (someone else), who used to be the producer of the show until Tjitse Leemhuis took his role.", "chunk_id": "7d7d42e40a8d63a0", "doc_id": "hp_a0b6962ec4a5ec5a"}]</data>
  <data key="d3">["hp_a0b6962ec4a5ec5a"]</data>
