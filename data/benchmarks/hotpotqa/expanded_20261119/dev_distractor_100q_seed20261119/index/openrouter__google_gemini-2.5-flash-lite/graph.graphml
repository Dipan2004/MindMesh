  <data key="d7">[{"text": "Walsh joined the FBI in 1934, serving during the Public enemy era, and was involved in several high-profile FBI cases, including the capture of Arthur Barker and the killing of Al Brady.", "chunk_id": "3fc5da1aa653543a", "doc_id": "hp_95e3e85178f2cc76", "type": "INVOLVED_IN_KILLING_OF"}]</data>
