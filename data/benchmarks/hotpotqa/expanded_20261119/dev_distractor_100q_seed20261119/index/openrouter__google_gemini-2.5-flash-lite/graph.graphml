  <data key="d7">[{"text": "It is restricted in the wild to remote regions of the Gobi and Taklamakan Deserts of Mongolia and Xinjiang.", "chunk_id": "c4aa14b79da7a5bc", "doc_id": "hp_353e9e34cd9559b7", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_353e9e34cd9559b7</data>
</edge>
<edge source="wild Bactrian camel" target="C. ferus">
  <data key="d5">["IS_A"]</data>
  <data key="d6">The wild Bactrian camel is also known as C. ferus.</data>
  <data key="d7">[{"text": "The three surviving species of camel are the dromedary, or one-humped camel (\"C. dromedarius\"), which inhabits the Middle East and the Horn of Africa; the Bactrian, or two-humped camel (\"C. bactrianus\"), which inhabits Central Asia; and the critically endangered wild Bactrian camel (\"C. ferus\") that has limited populations in remote areas of northwest China and Mongolia.", "chunk_id": "0f4c26b19727d970", "doc_id": "hp_706e5d69c6cb6d2b", "type": "IS_A"}]</data>
  <data key="d8">hp_706e5d69c6cb6d2b</data>
</edge>
