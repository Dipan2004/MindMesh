<node id="Kriminal-Magazin">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A German entertainment magazine that published crime fiction monthly from 1929 to 1931.", "chunk_id": "bfcce5e0acb26b17", "doc_id": "hp_2f330331b69ce452"}]</data>
  <data key="d2">[{"text": "The Kriminal-Magazin (\"Crime Magazine\") was a German entertainment magazine that published crime fiction every month during 1929-1931.", "chunk_id": "bfcce5e0acb26b17", "doc_id": "hp_2f330331b69ce452"}]</data>
  <data key="d3">["hp_2f330331b69ce452"]</data>
  <data key="d4">False</data>
</node>
<node id="crime fiction">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Fictional stories centered around criminal activity.", "chunk_id": "bfcce5e0acb26b17", "doc_id": "hp_2f330331b69ce452"}]</data>
  <data key="d2">[{"text": "The Kriminal-Magazin (\"Crime Magazine\") was a German entertainment magazine that published crime fiction every month during 1929-1931.", "chunk_id": "bfcce5e0acb26b17", "doc_id": "hp_2f330331b69ce452"}]</data>
  <data key="d3">["hp_2f330331b69ce452"]</data>
  <data key="d4">False</data>
</node>
<node id="Leipzig">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city in Germany, known for its publishing houses.", "chunk_id": "bfcce5e0acb26b17", "doc_id": "hp_2f330331b69ce452"}, {"text": "Leipzig is a city in Germany, mentioned in comparison to the age of the Hoch Conservatory.", "chunk_id": "43c8b1224e31b404", "doc_id": "hp_a82ec9e667a313c7"}]</data>
  <data key="d2">[{"text": "The magazine was distributed by the Leipzig publishing house Wilhelm Goldmann, selling about 100,000 copies per issue.", "chunk_id": "bfcce5e0acb26b17", "doc_id": "hp_2f330331b69ce452"}, {"text": "It is, after Leipzig and Berlin, the seventh oldest music conservatory in Germany.", "chunk_id": "43c8b1224e31b404", "doc_id": "hp_a82ec9e667a313c7"}]</data>
  <data key="d3">["hp_2f330331b69ce452", "hp_a82ec9e667a313c7"]</data>
  <data key="d4">False</data>
</node>
<node id="Wilhelm Goldmann">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A publishing house located in Leipzig.", "chunk_id": "bfcce5e0acb26b17", "doc_id": "hp_2f330331b69ce452"}]</data>
  <data key="d2">[{"text": "The magazine was distributed by the Leipzig publishing house Wilhelm Goldmann, selling about 100,000 copies per issue.", "chunk_id": "bfcce5e0acb26b17", "doc_id": "hp_2f330331b69ce452"}]</data>
  <data key="d3">["hp_2f330331b69ce452"]</data>
  <data key="d4">False</data>
</node>
<node id="Edgar Wallace">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An English writer who was the publisher of the Kriminal-Magazin.", "chunk_id": "bfcce5e0acb26b17", "doc_id": "hp_2f330331b69ce452"}]</data>
  <data key="d2">[{"text": "The publisher was the English writer Edgar Wallace, whose photo was seen on each cover on the bottom left.", "chunk_id": "bfcce5e0acb26b17", "doc_id": "hp_2f330331b69ce452"}]</data>
  <data key="d3">["hp_2f330331b69ce452"]</data>
  <data key="d4">False</data>
</node>
