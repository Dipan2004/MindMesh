  <data key="d7">[{"text": "Although the proposed design for the facility was 3,000 kW, the current installed capacity is 3,200 kW, generated from one unit of 500 kW, one unit of 600 kW, and three units of 700 kW, totalling the installed capacity to 3,200 kW.", "chunk_id": "ff0f3f2e384a3a68", "doc_id": "hp_49bb33ee8514f5e2", "type": "HAS_CAPACITY"}]</data>
