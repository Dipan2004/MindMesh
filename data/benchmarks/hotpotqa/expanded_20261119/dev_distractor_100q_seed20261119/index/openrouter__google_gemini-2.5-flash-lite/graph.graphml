  <data key="d2">[{"text": "Dann Hume (born Daniel Benjamin Cobbe, 1 September 1987, Whangaparaoa, New Zealand) is a singer-songwriter and record producer.", "chunk_id": "d4587b7df6346e8b", "doc_id": "hp_43e4303474c939c5"}]</data>
  <data key="d3">["hp_43e4303474c939c5"]</data>
