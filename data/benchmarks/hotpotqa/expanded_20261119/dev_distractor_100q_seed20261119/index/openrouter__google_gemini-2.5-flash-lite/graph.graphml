<edge source="Edward Hall" target="World's Strongest Man">
  <data key="d5">["WON", "WON"]</data>
  <data key="d6">Edward Hall is notable for being the current World's Strongest Man.</data>
  <data key="d7">[{"text": "Edward Hall (born 15 January 1988) is an English professional strongman, notable for being the current World's Strongest Man and the only man to deadlift 500 kg under strongman rules.", "chunk_id": "9b0d62492a00ccff", "doc_id": "hp_6a07e9a4e90de729", "type": "WON"}, {"text": "He is the 2017 World's Strongest Man and the current world record holder in the deadlift with straps.", "chunk_id": "9b0d62492a00ccff", "doc_id": "hp_6a07e9a4e90de729", "type": "WON"}]</data>
  <data key="d8">hp_6a07e9a4e90de729</data>
</edge>
<edge source="Edward Hall" target="UK's Strongest Man">
  <data key="d5">["WON"]</data>
  <data key="d6">Edward Hall has won the UK's Strongest Man title on multiple occasions.</data>
  <data key="d7">[{"text": "He has also won on multiple occasions both the UK's Strongest Man and England's Strongest Man titles.", "chunk_id": "9b0d62492a00ccff", "doc_id": "hp_6a07e9a4e90de729", "type": "WON"}]</data>
  <data key="d8">hp_6a07e9a4e90de729</data>
</edge>
<edge source="Edward Hall" target="England's Strongest Man">
  <data key="d5">["WON"]</data>
  <data key="d6">Edward Hall has won the England's Strongest Man title on multiple occasions.</data>
  <data key="d7">[{"text": "He has also won on multiple occasions both the UK's Strongest Man and England's Strongest Man titles.", "chunk_id": "9b0d62492a00ccff", "doc_id": "hp_6a07e9a4e90de729", "type": "WON"}]</data>
  <data key="d8">hp_6a07e9a4e90de729</data>
</edge>
