  <data key="d1">[{"text": "Church of England clergy are ministers of the Church of England.", "chunk_id": "ff4792dbca147fed", "doc_id": "hp_fd1eb5f63c8bb581"}]</data>
  <data key="d2">[{"text": "St Chad's College is a recognised (independent) college of Durham University in England, founded in 1904 as an Anglican hall for the training of Church of England clergy.", "chunk_id": "ff4792dbca147fed", "doc_id": "hp_fd1eb5f63c8bb581"}]</data>
