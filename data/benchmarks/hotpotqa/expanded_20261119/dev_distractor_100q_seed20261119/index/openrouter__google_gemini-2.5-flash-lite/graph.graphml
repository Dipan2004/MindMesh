</node>
<node id="Frederick Regional Airport">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Frederick Regional Airport is an airport located in Frederick, Oklahoma.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}]</data>
  <data key="d2">[{"text": "Frederick is home to three dairies, a 1400-acre industrial park, and Frederick Regional Airport, which includes restored World War II hangars which house the World War II Airborne Demonstration Team.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}]</data>
  <data key="d3">["hp_6eb8e4170df0651b"]</data>
  <data key="d4">False</data>
</node>
