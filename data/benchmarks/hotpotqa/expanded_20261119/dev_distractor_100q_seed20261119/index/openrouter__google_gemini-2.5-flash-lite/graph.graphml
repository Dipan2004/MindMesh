<node id="Arachis monticola">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Arachis monticola is a close relative of the domesticated peanut.", "chunk_id": "4fb00b903790bf5f", "doc_id": "hp_854482b064cdae3e"}]</data>
