<node id="recusancy">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Recusancy refers to the state of being Catholic in England historically.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}]</data>
  <data key="d2">[{"text": "The dukes have historically been Catholic, a state of affairs known as recusancy in England.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}]</data>
  <data key="d3">["hp_c50a06491df52f2d"]</data>
  <data key="d4">False</data>
</node>
