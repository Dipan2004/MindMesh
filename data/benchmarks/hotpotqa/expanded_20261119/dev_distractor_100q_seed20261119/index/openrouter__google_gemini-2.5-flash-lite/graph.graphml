<node id="Edward Brooks Sr.">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Edward Brooks Sr. was a local lumber magnate who first built Eastcliff in 1922.", "chunk_id": "60d483d501d17f6f", "doc_id": "hp_936dd5018d3d1151"}]</data>
  <data key="d2">[{"text": "It was first built in 1922 by local lumber magnate Edward Brooks Sr. and donated to the university by the Brooks family in 1958, beginning its service as the president's official residence in 1960 when O. Meredith Wilson took the position.", "chunk_id": "60d483d501d17f6f", "doc_id": "hp_936dd5018d3d1151"}]</data>
  <data key="d3">["hp_936dd5018d3d1151"]</data>
  <data key="d4">False</data>
</node>
<node id="Brooks family">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The Brooks family donated Eastcliff to the university in 1958.", "chunk_id": "60d483d501d17f6f", "doc_id": "hp_936dd5018d3d1151"}]</data>
  <data key="d2">[{"text": "It was first built in 1922 by local lumber magnate Edward Brooks Sr. and donated to the university by the Brooks family in 1958, beginning its service as the president's official residence in 1960 when O. Meredith Wilson took the position.", "chunk_id": "60d483d501d17f6f", "doc_id": "hp_936dd5018d3d1151"}]</data>
  <data key="d3">["hp_936dd5018d3d1151"]</data>
  <data key="d4">False</data>
</node>
