<edge source="Donald Neil Kerley" target="South Australia">
  <data key="d5">["BORN_IN", "PLAYED_STATE_GAMES_FOR"]</data>
  <data key="d6">Donald Neil Kerley was born in South Australia.</data>
  <data key="d7">[{"text": "Donald Neil Kerley (born 20 February 1934 in Barmera, South Australia) is a former Australian rules football player and coach.", "chunk_id": "442043eeaf880949", "doc_id": "hp_fe3fc60bc7758add", "type": "BORN_IN"}, {"text": "Known to his mates as either Neil or Knuckles and to South Australian football fans as King Kerley or simply \"Kerls\", he is best known for taking three clubs to four South Australian National Football League (SANFL) premierships over three decades as both a player and coach and for playing 32 state games for South Australia.", "chunk_id": "442043eeaf880949", "doc_id": "hp_fe3fc60bc7758add", "type": "PLAYED_STATE_GAMES_FOR"}]</data>
  <data key="d8">hp_fe3fc60bc7758add</data>
</edge>
<edge source="Donald Neil Kerley" target="South Australian National Football League (SANFL)">
  <data key="d5">["PLAYED_IN", "COACHED_IN"]</data>
  <data key="d6">Donald Neil Kerley played in the South Australian National Football League (SANFL).</data>
  <data key="d7">[{"text": "Known to his mates as either Neil or Knuckles and to South Australian football fans as King Kerley or simply \"Kerls\", he is best known for taking three clubs to four South Australian National Football League (SANFL) premierships over three decades as both a player and coach and for playing 32 state games for South Australia.", "chunk_id": "442043eeaf880949", "doc_id": "hp_fe3fc60bc7758add", "type": "PLAYED_IN"}, {"text": "Known to his mates as either Neil or Knuckles and to South Australian football fans as King Kerley or simply \"Kerls\", he is best known for taking three clubs to four South Australian National Football League (SANFL) premierships over three decades as both a player and coach and for playing 32 state games for South Australia.", "chunk_id": "442043eeaf880949", "doc_id": "hp_fe3fc60bc7758add", "type": "COACHED_IN"}]</data>
  <data key="d8">hp_fe3fc60bc7758add</data>
</edge>
<edge source="Neil" target="Donald Neil Kerley">
  <data key="d5">["IS_NICKNAME_OF"]</data>
  <data key="d6">Neil is a nickname for Donald Neil Kerley.</data>
  <data key="d7">[{"text": "Known to his mates as either Neil or Knuckles and to South Australian football fans as King Kerley or simply \"Kerls\", he is best known for taking three clubs to four South Australian National Football League (SANFL) premierships over three decades as both a player and coach and for playing 32 state games for South Australia.", "chunk_id": "442043eeaf880949", "doc_id": "hp_fe3fc60bc7758add", "type": "IS_NICKNAME_OF"}]</data>
  <data key="d8">hp_fe3fc60bc7758add</data>
</edge>
<edge source="Neil" target="Donald">
  <data key="d5">["PREFERRED_NAME_OVER"]</data>
  <data key="d6">Neil was preferred over Donald.</data>
  <data key="d7">[{"text": "Despite his first name being Donald, it was his mother Lillian's strong dislike of shortening Christian names that led everyone calling him Neil and not Don or Donald from an early age.", "chunk_id": "442043eeaf880949", "doc_id": "hp_fe3fc60bc7758add", "type": "PREFERRED_NAME_OVER"}]</data>
  <data key="d8">hp_fe3fc60bc7758add</data>
</edge>
