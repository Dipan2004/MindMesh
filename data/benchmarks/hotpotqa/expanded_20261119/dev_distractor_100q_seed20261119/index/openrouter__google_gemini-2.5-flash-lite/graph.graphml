<node id="Barnet">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Barnet is a location in England.", "chunk_id": "71ca2b70887b01d6", "doc_id": "hp_e61b677c687681e5"}]</data>
  <data key="d2">[{"text": "Darland's Lake Nature Reserve is a nature reserve south of Totteridge Village in Barnet, England.", "chunk_id": "71ca2b70887b01d6", "doc_id": "hp_e61b677c687681e5"}]</data>
  <data key="d3">["hp_e61b677c687681e5"]</data>
  <data key="d4">False</data>
</node>
<node id="London Borough of Barnet">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The London Borough of Barnet is an organization that owns Darland's Lake Nature Reserve.", "chunk_id": "71ca2b70887b01d6", "doc_id": "hp_e61b677c687681e5"}]</data>
  <data key="d2">[{"text": "It is owned by the London Borough of Barnet and was managed from 1971 by the Hertfordshire and Middlesex Wildlife Trust, and more recently by the borough council.", "chunk_id": "71ca2b70887b01d6", "doc_id": "hp_e61b677c687681e5"}]</data>
  <data key="d3">["hp_e61b677c687681e5"]</data>
  <data key="d4">False</data>
</node>
<node id="Hertfordshire and Middlesex Wildlife Trust">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Hertfordshire and Middlesex Wildlife Trust is an organization that managed Darland's Lake Nature Reserve from 1971.", "chunk_id": "71ca2b70887b01d6", "doc_id": "hp_e61b677c687681e5"}]</data>
  <data key="d2">[{"text": "It is owned by the London Borough of Barnet and was managed from 1971 by the Hertfordshire and Middlesex Wildlife Trust, and more recently by the borough council.", "chunk_id": "71ca2b70887b01d6", "doc_id": "hp_e61b677c687681e5"}]</data>
  <data key="d3">["hp_e61b677c687681e5"]</data>
  <data key="d4">False</data>
</node>
<node id="borough council">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The borough council is an organization that managed Darland's Lake Nature Reserve more recently.", "chunk_id": "71ca2b70887b01d6", "doc_id": "hp_e61b677c687681e5"}]</data>
  <data key="d2">[{"text": "It is owned by the London Borough of Barnet and was managed from 1971 by the Hertfordshire and Middlesex Wildlife Trust, and more recently by the borough council.", "chunk_id": "71ca2b70887b01d6", "doc_id": "hp_e61b677c687681e5"}]</data>
  <data key="d3">["hp_e61b677c687681e5"]</data>
  <data key="d4">False</data>
</node>
<node id="Wildlife Trust">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Wildlife Trust is an organization that was proposed to lease Darland's Lake Nature Reserve.", "chunk_id": "71ca2b70887b01d6", "doc_id": "hp_e61b677c687681e5"}]</data>
  <data key="d2">[{"text": "However, the transfer did not take place and the nature reserve is currently not managed.", "chunk_id": "71ca2b70887b01d6", "doc_id": "hp_e61b677c687681e5"}]</data>
  <data key="d3">["hp_e61b677c687681e5"]</data>
  <data key="d4">False</data>
</node>
<node id="Emilio Fernández Romo">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Emilio Fernández Romo is the birth name of Emilio \"El Indio\" Fernández.", "chunk_id": "e2bd3c61103e4d8b", "doc_id": "hp_e6718a97d51ea825"}]</data>
  <data key="d2">[{"text": "Emilio \"El Indio\" Fernández (born Emilio Fernández Romo, ] ; March 26, 1904 – August 6, 1986) was a Mexican film director, actor and screenwriter.", "chunk_id": "e2bd3c61103e4d8b", "doc_id": "hp_e6718a97d51ea825"}]</data>
  <data key="d3">["hp_e6718a97d51ea825"]</data>
