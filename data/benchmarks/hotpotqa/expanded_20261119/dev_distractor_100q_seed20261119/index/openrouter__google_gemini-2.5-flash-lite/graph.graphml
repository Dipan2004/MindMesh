<edge source="Convoy TM 1" target="U-boat wolf pack">
  <data key="d5">["ATTACKED_BY"]</data>
  <data key="d6">Convoy TM 1 was attacked by a U-boat wolf pack.</data>
  <data key="d7">[{"text": "The convoy was attacked by a U-boat wolf pack in the central Atlantic Ocean, and most of the merchant vessels were sunk.", "chunk_id": "c88e8c3532f53397", "doc_id": "hp_1ac7b848b0417759", "type": "ATTACKED_BY"}]</data>
  <data key="d8">hp_1ac7b848b0417759</data>
