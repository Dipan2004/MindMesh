<node id="Hippophae rhamnoides">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A species of flowering plant in the family Elaeagnaceae, also known as common sea buckthorn.", "chunk_id": "cffa64332d9d5303", "doc_id": "hp_132646060315257f"}]</data>
  <data key="d2">[{"text": "Hippophae rhamnoides, also known as common sea buckthorn is a species of flowering plant in the family Elaeagnaceae, native to the cold-temperate regions of Europe and Asia.", "chunk_id": "cffa64332d9d5303", "doc_id": "hp_132646060315257f"}]</data>
  <data key="d3">["hp_132646060315257f"]</data>
  <data key="d4">False</data>
</node>
<node id="common sea buckthorn">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Another name for Hippophae rhamnoides, a species of flowering plant in the family Elaeagnaceae.", "chunk_id": "cffa64332d9d5303", "doc_id": "hp_132646060315257f"}]</data>
  <data key="d2">[{"text": "Hippophae rhamnoides, also known as common sea buckthorn is a species of flowering plant in the family Elaeagnaceae, native to the cold-temperate regions of Europe and Asia.", "chunk_id": "cffa64332d9d5303", "doc_id": "hp_132646060315257f"}]</data>
  <data key="d3">["hp_132646060315257f"]</data>
  <data key="d4">False</data>
</node>
<node id="Elaeagnaceae">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The family to which Hippophae rhamnoides belongs.", "chunk_id": "cffa64332d9d5303", "doc_id": "hp_132646060315257f"}, {"text": "Elaeagnaceae is a family of deciduous shrubs.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d2">[{"text": "Hippophae rhamnoides, also known as common sea buckthorn is a species of flowering plant in the family Elaeagnaceae, native to the cold-temperate regions of Europe and Asia.", "chunk_id": "cffa64332d9d5303", "doc_id": "hp_132646060315257f"}, {"text": "Hippophae is a genus of sea buckthorns, deciduous shrubs in the family Elaeagnaceae.", "chunk_id": "76c5812c98da2210", "doc_id": "hp_1dd36dcaeea5be41"}]</data>
  <data key="d3">["hp_132646060315257f", "hp_1dd36dcaeea5be41"]</data>
  <data key="d4">False</data>
</node>
<node id="Europe">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A continent native to Hippophae rhamnoides.", "chunk_id": "cffa64332d9d5303", "doc_id": "hp_132646060315257f"}, {"text": "Europe is a continent where the Dom-Hotel is considered one of the oldest grand hotels.", "chunk_id": "cf3ed09c1d2f8654", "doc_id": "hp_5d7964cd7edd106e"}, {"text": "A continent where World War I originated.", "chunk_id": "b344f42adf99d038", "doc_id": "hp_831bc66834df032a"}, {"text": "A continent across which the Native Tour traveled.", "chunk_id": "fbf2e81187688813", "doc_id": "hp_bf77c9d36b5389d5"}, {"text": "Europe is a continent into which cameline was imported.", "chunk_id": "80b52c81ca855fef", "doc_id": "hp_c12a13b85cfa0362"}, {"text": "A continent located entirely in the Northern Hemisphere and mostly in the Eastern Hemisphere.", "chunk_id": "7fcbe97a0e441ab4", "doc_id": "hp_d534800743a3d491"}, {"text": "Europe is a continent where Bothriochloa ischaemum var. ischaemum is native.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d2">[{"text": "Hippophae rhamnoides, also known as common sea buckthorn is a species of flowering plant in the family Elaeagnaceae, native to the cold-temperate regions of Europe and Asia.", "chunk_id": "cffa64332d9d5303", "doc_id": "hp_132646060315257f"}, {"text": "The hotels is one of the oldest grand hotels in Europe; its location and history make it one of the city's most prominent buildings.", "chunk_id": "cf3ed09c1d2f8654", "doc_id": "hp_5d7964cd7edd106e"}, {"text": "World War I (WWI or WW1), also known as the First World War, the Great War, or the War to End All Wars, was a global war originating in Europe that lasted from 28 July 1914 to 11 November 1918.", "chunk_id": "b344f42adf99d038", "doc_id": "hp_831bc66834df032a"}, {"text": "The tour has traveled across five continents; Asia, Europe, Oceania, North America, and Africa.", "chunk_id": "fbf2e81187688813", "doc_id": "hp_bf77c9d36b5389d5"}, {"text": "It was imported from Cyprus and Syria into Europe.", "chunk_id": "80b52c81ca855fef", "doc_id": "hp_c12a13b85cfa0362"}, {"text": "The label currently holds 19 bands, 5 of which are based in The United States and Europe.", "chunk_id": "7fcbe97a0e441ab4", "doc_id": "hp_d534800743a3d491"}, {"text": "Two varieties are recognized, of which \"Bothriochloa ischaemum\" var. \"ischaemum\" is native to Europe, Asia, and Africa and naturalized elsewhere, and var. \"songarica\" is native to Asia and naturalized elsewhere.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d3">["hp_132646060315257f", "hp_5d7964cd7edd106e", "hp_831bc66834df032a", "hp_bf77c9d36b5389d5", "hp_c12a13b85cfa0362", "hp_d534800743a3d491", "hp_f7e1751d7e276925"]</data>
  <data key="d4">False</data>
</node>
<node id="Asia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A continent native to Hippophae rhamnoides.", "chunk_id": "cffa64332d9d5303", "doc_id": "hp_132646060315257f"}, {"text": "A continent across which the Native Tour traveled.", "chunk_id": "fbf2e81187688813", "doc_id": "hp_bf77c9d36b5389d5"}, {"text": "Asia is a continent where cameline was thought to have been originally made.", "chunk_id": "80b52c81ca855fef", "doc_id": "hp_c12a13b85cfa0362"}, {"text": "Asia is a continent where many E-roads have been extended into.", "chunk_id": "048735b969f03581", "doc_id": "hp_f7b91e330a134361"}, {"text": "Asia is a continent where Bothriochloa ischaemum var. ischaemum and var. songarica are native.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d2">[{"text": "Hippophae rhamnoides, also known as common sea buckthorn is a species of flowering plant in the family Elaeagnaceae, native to the cold-temperate regions of Europe and Asia.", "chunk_id": "cffa64332d9d5303", "doc_id": "hp_132646060315257f"}, {"text": "The tour has traveled across five continents; Asia, Europe, Oceania, North America, and Africa.", "chunk_id": "fbf2e81187688813", "doc_id": "hp_bf77c9d36b5389d5"}, {"text": "By tradition it is commonly thought to have been originally made of camel's hair in Asia.", "chunk_id": "80b52c81ca855fef", "doc_id": "hp_c12a13b85cfa0362"}, {"text": "Many of the E-roads have been extended into Asia since the year 2000", "chunk_id": "048735b969f03581", "doc_id": "hp_f7b91e330a134361"}, {"text": "Two varieties are recognized, of which \"Bothriochloa ischaemum\" var. \"ischaemum\" is native to Europe, Asia, and Africa and naturalized elsewhere, and var. \"songarica\" is native to Asia and naturalized elsewhere.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d3">["hp_132646060315257f", "hp_bf77c9d36b5389d5", "hp_c12a13b85cfa0362", "hp_f7b91e330a134361", "hp_f7e1751d7e276925"]</data>
  <data key="d4">False</data>
</node>
<node id="spiny deciduous shrub">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A description of the physical form of Hippophae rhamnoides.", "chunk_id": "cffa64332d9d5303", "doc_id": "hp_132646060315257f"}]</data>
  <data key="d2">[{"text": "It is a spiny deciduous shrub.", "chunk_id": "cffa64332d9d5303", "doc_id": "hp_132646060315257f"}]</data>
