  <data key="d2">[{"text": "Andatee China Marine Fuel Service Corporation (\"Andatee\") (NASDAQ: AMCF ) is a marine fuel wholesale and retail company that is based in Dalian, China.", "chunk_id": "0ae16a4e4e4c0144", "doc_id": "hp_1e1ee8b3317b2831"}]</data>
  <data key="d3">["hp_1e1ee8b3317b2831"]</data>
  <data key="d4">False</data>
</node>
<node id="Tianjin">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Tianjin is a municipality directly under the central government in China where Andatee sells oil fuel products.", "chunk_id": "0ae16a4e4e4c0144", "doc_id": "hp_1e1ee8b3317b2831"}]</data>
  <data key="d2">[{"text": "The company sells oil fuel products mainly to one municipality directly under the central government and four big provinces in the Northeast and East of China, namely Tianjin, Liaoning, Shandong, Jiangsu and Zhejiang.", "chunk_id": "0ae16a4e4e4c0144", "doc_id": "hp_1e1ee8b3317b2831"}]</data>
  <data key="d3">["hp_1e1ee8b3317b2831"]</data>
  <data key="d4">False</data>
</node>
<node id="Liaoning">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Liaoning is a province in Northeast China where Andatee sells oil fuel products.", "chunk_id": "0ae16a4e4e4c0144", "doc_id": "hp_1e1ee8b3317b2831"}]</data>
  <data key="d2">[{"text": "The company sells oil fuel products mainly to one municipality directly under the central government and four big provinces in the Northeast and East of China, namely Tianjin, Liaoning, Shandong, Jiangsu and Zhejiang.", "chunk_id": "0ae16a4e4e4c0144", "doc_id": "hp_1e1ee8b3317b2831"}]</data>
  <data key="d3">["hp_1e1ee8b3317b2831"]</data>
  <data key="d4">False</data>
</node>
