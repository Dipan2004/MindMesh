<node id="Norman O'Neill">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Norman O'Neill was an English composer and conductor of Irish background who specialized largely in works for the theatre.", "chunk_id": "4bfef8abd6a74664", "doc_id": "hp_ca727488ffb2c1ba"}]</data>
  <data key="d2">[{"text": "Norman Houston O'Neill (14 March 1875 – 3 March 1934) was an English composer and conductor of Irish background who specialized largely in works for the theatre.", "chunk_id": "4bfef8abd6a74664", "doc_id": "hp_ca727488ffb2c1ba"}]</data>
  <data key="d3">["hp_ca727488ffb2c1ba"]</data>
  <data key="d4">False</data>
</node>
<node id="Arthur Somervell">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Arthur Somervell was someone with whom Norman O'Neill studied in London.", "chunk_id": "4bfef8abd6a74664", "doc_id": "hp_ca727488ffb2c1ba"}]</data>
  <data key="d2">[{"text": "He studied in London with Arthur Somervell and with Iwan Knorr at the Hoch Conservatory in Frankfurt from 1893 to 1897.", "chunk_id": "4bfef8abd6a74664", "doc_id": "hp_ca727488ffb2c1ba"}]</data>
  <data key="d3">["hp_ca727488ffb2c1ba"]</data>
  <data key="d4">False</data>
</node>
<node id="Iwan Knorr">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Iwan Knorr was someone with whom Norman O'Neill studied at the Hoch Conservatory in Frankfurt.", "chunk_id": "4bfef8abd6a74664", "doc_id": "hp_ca727488ffb2c1ba"}, {"text": "Iwan Knorr was a German composer and teacher of music.", "chunk_id": "902ae288e12f1dfb", "doc_id": "hp_d0d1ade1227af443"}]</data>
  <data key="d2">[{"text": "He studied in London with Arthur Somervell and with Iwan Knorr at the Hoch Conservatory in Frankfurt from 1893 to 1897.", "chunk_id": "4bfef8abd6a74664", "doc_id": "hp_ca727488ffb2c1ba"}, {"text": "Iwan Knorr (3 January 1853 – 22 January 1916) was a German composer and teacher of music.", "chunk_id": "902ae288e12f1dfb", "doc_id": "hp_d0d1ade1227af443"}]</data>
  <data key="d3">["hp_ca727488ffb2c1ba", "hp_d0d1ade1227af443"]</data>
  <data key="d4">False</data>
</node>
<node id="Eric Stenbock">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Eric Stenbock facilitated Norman O'Neill's studies at the Hoch Conservatory.", "chunk_id": "4bfef8abd6a74664", "doc_id": "hp_ca727488ffb2c1ba"}]</data>
  <data key="d2">[{"text": "His studies there were facilitated by Eric Stenbock.", "chunk_id": "4bfef8abd6a74664", "doc_id": "hp_ca727488ffb2c1ba"}]</data>
  <data key="d3">["hp_ca727488ffb2c1ba"]</data>
  <data key="d4">False</data>
</node>
<node id="Frankfurt Group">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Frankfurt Group was a circle of composers who studied at Hoch's Conservatory in the late 1890s.", "chunk_id": "4bfef8abd6a74664", "doc_id": "hp_ca727488ffb2c1ba"}]</data>
  <data key="d2">[{"text": "He belonged to the Frankfurt Group, a circle of composers who studied at Hoch's Conservatory in the late 1890s.", "chunk_id": "4bfef8abd6a74664", "doc_id": "hp_ca727488ffb2c1ba"}]</data>
  <data key="d3">["hp_ca727488ffb2c1ba"]</data>
  <data key="d4">False</data>
</node>
<node id="Greek mythology">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Semele is a figure in Greek mythology.", "chunk_id": "237c807e83e54ea2", "doc_id": "hp_cac556477f0e3a91"}]</data>
  <data key="d2">[{"text": "Semele ( ; Greek: Σεμέλη \"Semelē\"), in Greek mythology, daughter of the Boeotian hero Cadmus and Harmonia, was the mortal mother of Dionysus by Zeus in one of his many origin myths.", "chunk_id": "237c807e83e54ea2", "doc_id": "hp_cac556477f0e3a91"}]</data>
  <data key="d3">["hp_cac556477f0e3a91"]</data>
  <data key="d4">False</data>
</node>
<node id="Cadmus">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Cadmus was the Boeotian hero and father of Semele.", "chunk_id": "237c807e83e54ea2", "doc_id": "hp_cac556477f0e3a91"}]</data>
  <data key="d2">[{"text": "Semele ( ; Greek: Σεμέλη \"Semelē\"), in Greek mythology, daughter of the Boeotian hero Cadmus and Harmonia, was the mortal mother of Dionysus by Zeus in one of his many origin myths.", "chunk_id": "237c807e83e54ea2", "doc_id": "hp_cac556477f0e3a91"}]</data>
  <data key="d3">["hp_cac556477f0e3a91"]</data>
  <data key="d4">False</data>
</node>
<node id="Harmonia">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Harmonia was the mother of Semele.", "chunk_id": "237c807e83e54ea2", "doc_id": "hp_cac556477f0e3a91"}]</data>
  <data key="d2">[{"text": "Semele ( ; Greek: Σεμέλη \"Semelē\"), in Greek mythology, daughter of the Boeotian hero Cadmus and Harmonia, was the mortal mother of Dionysus by Zeus in one of his many origin myths.", "chunk_id": "237c807e83e54ea2", "doc_id": "hp_cac556477f0e3a91"}]</data>
  <data key="d3">["hp_cac556477f0e3a91"]</data>
  <data key="d4">False</data>
</node>
<node id="Dionysus">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Dionysus was the son of Semele and Zeus.", "chunk_id": "237c807e83e54ea2", "doc_id": "hp_cac556477f0e3a91"}]</data>
  <data key="d2">[{"text": "Semele ( ; Greek: Σεμέλη \"Semelē\"), in Greek mythology, daughter of the Boeotian hero Cadmus and Harmonia, was the mortal mother of Dionysus by Zeus in one of his many origin myths.", "chunk_id": "237c807e83e54ea2", "doc_id": "hp_cac556477f0e3a91"}]</data>
