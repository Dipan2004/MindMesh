<node id="1948 Bollywood film">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A film produced in Bollywood in the year 1948.", "chunk_id": "4df4b5295e67f801", "doc_id": "hp_b8f974e5ce544d7e"}]</data>
  <data key="d2">[{"text": "Aag (Hindi: आग ; English: \"Fire\" ) is a 1948 Bollywood film which is produced, directed by and stars Raj Kapoor.", "chunk_id": "4df4b5295e67f801", "doc_id": "hp_b8f974e5ce544d7e"}]</data>
  <data key="d3">["hp_b8f974e5ce544d7e"]</data>
  <data key="d4">False</data>
</node>
<node id="R.K. Banner">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The banner under which the film Aag was first produced.", "chunk_id": "4df4b5295e67f801", "doc_id": "hp_b8f974e5ce544d7e"}]</data>
  <data key="d2">[{"text": "The film marked the debut of Raj Kapoor as producer and director and was the first film produced by his R.K. Banner.", "chunk_id": "4df4b5295e67f801", "doc_id": "hp_b8f974e5ce544d7e"}]</data>
  <data key="d3">["hp_b8f974e5ce544d7e"]</data>
  <data key="d4">False</data>
</node>
<node id="Premnath">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An actor who starred in supporting roles in the 1948 film Aag.", "chunk_id": "4df4b5295e67f801", "doc_id": "hp_b8f974e5ce544d7e"}]</data>
  <data key="d2">[{"text": "Nargis, Premnath, Nigar Sultana and Kamini Kaushal also starred in supporting roles.", "chunk_id": "4df4b5295e67f801", "doc_id": "hp_b8f974e5ce544d7e"}]</data>
  <data key="d3">["hp_b8f974e5ce544d7e"]</data>
  <data key="d4">False</data>
</node>
