  <data key="d2">[{"text": "According to the rule, the bottom 2 teams, Hong Kong 08 and South China, should relegate to the Second Division.", "chunk_id": "0fb0a4062ab720d1", "doc_id": "hp_a2558257c20dfe87"}]</data>
  <data key="d3">["hp_a2558257c20dfe87"]</data>
