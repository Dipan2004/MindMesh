<node id="Giuseppe Verdi">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An Italian composer who lived from 1813 to 1901.", "chunk_id": "177ec9b189005c78", "doc_id": "hp_1b1a3259f3592689"}, {"text": "An opera composer whose life is closely associated with Busseto.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}, {"text": "Giuseppe Verdi was an Italian composer who was tutored by Ferdinando Provesi.", "chunk_id": "6f1f0a0b8ceacebf", "doc_id": "hp_504f3a1745c4e938"}, {"text": "Giuseppe Verdi was an Italian opera composer.", "chunk_id": "c214c2a3be6eb2a2", "doc_id": "hp_8575e392dbd806a5"}, {"text": "An Italian composer whose adult life events were the basis for a biographical film.", "chunk_id": "a3324ed3bd44545e", "doc_id": "hp_b4630593e3e0662f"}, {"text": "Giuseppe Verdi is a person after whom Parma Airport is named.", "chunk_id": "90aa0e3b675f8e93", "doc_id": "hp_e9d687a7dd49fca0"}]</data>
  <data key="d2">[{"text": "The film portrays the life of the composer Giuseppe Verdi (1813-1901).", "chunk_id": "177ec9b189005c78", "doc_id": "hp_1b1a3259f3592689"}, {"text": "Teatro Giuseppe Verdi (the Giuseppe Verdi Theatre) is a small opera house located in a wing of the Rocca dei Marchesi Pallavicino on the Piazza Giuseppe Verdi in Busseto, Italy, a town closely associated with the life of the opera composer, Giuseppe Verdi.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}, {"text": "Provesi is best known as being an early tutor of Giuseppe Verdi when he was the \"Maestro di cappella\" (master of music) at the St. Bartolomeo cathedral in Busseto (the town very close to Le Roncole, the village where Verdi was born.)", "chunk_id": "6f1f0a0b8ceacebf", "doc_id": "hp_504f3a1745c4e938"}, {"text": "Giuseppe Fortunino Francesco Verdi (] ; 9 or 10 October 1813 – 27 January 1901) was an Italian opera composer.", "chunk_id": "c214c2a3be6eb2a2", "doc_id": "hp_8575e392dbd806a5"}, {"text": "Giuseppe Verdi, released theatrically in the USA as The Life and Music of Giuseppe Verdi and on video as Verdi, the King of Melody, is a 1953 Italian biographical film starring Pierre Cressoy and directed by Raffaello Matarazzo.", "chunk_id": "a3324ed3bd44545e", "doc_id": "hp_b4630593e3e0662f"}, {"text": "It is also known as Giuseppe Verdi Airport or Parma \"Giuseppe Verdi\" Airport, named after Giuseppe Verdi.", "chunk_id": "90aa0e3b675f8e93", "doc_id": "hp_e9d687a7dd49fca0"}]</data>
  <data key="d3">["hp_1b1a3259f3592689", "hp_22c8c1dec547c159", "hp_504f3a1745c4e938", "hp_8575e392dbd806a5", "hp_b4630593e3e0662f", "hp_e9d687a7dd49fca0"]</data>
  <data key="d4">False</data>
</node>
<node id="The White Squadron">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A film in which Fosco Giachetti played patriotic roles.", "chunk_id": "177ec9b189005c78", "doc_id": "hp_1b1a3259f3592689"}]</data>
  <data key="d2">[{"text": "The casting of Giachetti as Verdi was intended to emphasise the composer's patriotism, as he had recently played patriotic roles in films such as \"The White Squadron\".", "chunk_id": "177ec9b189005c78", "doc_id": "hp_1b1a3259f3592689"}]</data>
  <data key="d3">["hp_1b1a3259f3592689"]</data>
  <data key="d4">False</data>
</node>
<node id="Cinecittà Studios">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A film studio located in Rome where the film 'Giuseppe Verdi' was made.", "chunk_id": "177ec9b189005c78", "doc_id": "hp_1b1a3259f3592689"}]</data>
  <data key="d2">[{"text": "The film was made at the Cinecittà Studios in Rome.", "chunk_id": "177ec9b189005c78", "doc_id": "hp_1b1a3259f3592689"}]</data>
  <data key="d3">["hp_1b1a3259f3592689"]</data>
  <data key="d4">False</data>
</node>
<node id="Rome">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The city in Italy where Cinecittà Studios is located.", "chunk_id": "177ec9b189005c78", "doc_id": "hp_1b1a3259f3592689"}, {"text": "Rome is the capital city of Italy.", "chunk_id": "7774f7d0fd5a7c20", "doc_id": "hp_768bd041b089468b"}]</data>
  <data key="d2">[{"text": "The film was made at the Cinecittà Studios in Rome.", "chunk_id": "177ec9b189005c78", "doc_id": "hp_1b1a3259f3592689"}, {"text": "After a match between Romania and Italy, played in Rome, he was nicknamed by the Italian football fans \"Il Dio\", because of his incredible saves.", "chunk_id": "7774f7d0fd5a7c20", "doc_id": "hp_768bd041b089468b"}]</data>
  <data key="d3">["hp_1b1a3259f3592689", "hp_768bd041b089468b"]</data>
  <data key="d4">False</data>
</node>
