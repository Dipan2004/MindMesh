  <data key="d2">[{"text": "Boogie Woogie Kids Championship was an Indian dance competition television series created and directed by Javed Jaffrey and Ravi Behl, owners of R&amp;N TV Productions, for Sony Entertainment Television and Sony Entertainment Television Asia.", "chunk_id": "0ed37f3f70846148", "doc_id": "hp_fa98fe724fcd50b7"}]</data>
