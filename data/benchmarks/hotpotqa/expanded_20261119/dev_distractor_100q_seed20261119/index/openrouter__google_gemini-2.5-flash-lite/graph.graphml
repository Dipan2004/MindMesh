<node id="WWI">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "An alternative name for World War I.", "chunk_id": "b344f42adf99d038", "doc_id": "hp_831bc66834df032a"}]</data>
  <data key="d2">[{"text": "World War I (WWI or WW1), also known as the First World War, the Great War, or the War to End All Wars, was a global war originating in Europe that lasted from 28 July 1914 to 11 November 1918.", "chunk_id": "b344f42adf99d038", "doc_id": "hp_831bc66834df032a"}]</data>
  <data key="d3">["hp_831bc66834df032a"]</data>
