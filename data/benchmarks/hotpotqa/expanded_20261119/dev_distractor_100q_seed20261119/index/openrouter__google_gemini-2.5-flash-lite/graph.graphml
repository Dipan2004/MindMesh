  <data key="d2">[{"text": "In 2014, the series won a Daytime Creative Arts Emmy Award for Outstanding Special Class Directing (Anne Fox), Single Camera Photography, and Single Camera Editing.", "chunk_id": "e18b18a89628579b", "doc_id": "hp_4267fa308ce99424"}]</data>
