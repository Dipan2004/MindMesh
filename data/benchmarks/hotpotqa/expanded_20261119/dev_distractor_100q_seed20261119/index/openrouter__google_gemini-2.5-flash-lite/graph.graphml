<node id="Kele Okereke">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The lead singer of British indie rock band Bloc Party and the artist behind the solo album 'The Boxer'.", "chunk_id": "bb2b762aba15f55a", "doc_id": "hp_24b106283a2f2b9f"}, {"text": "Kele Okereke is a member of the band Bloc Party, playing lead vocals, rhythm guitar, keyboards, and sampler.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}, {"text": "Kele Okereke is the lead singer and rhythm guitarist of the British rock band Bloc Party.", "chunk_id": "145e5d0c1408e198", "doc_id": "hp_e5470b4e6fa8bc35"}]</data>
  <data key="d2">[{"text": "The Boxer is the debut solo album by Kele Okereke, the lead singer of British indie rock band Bloc Party.", "chunk_id": "bb2b762aba15f55a", "doc_id": "hp_24b106283a2f2b9f"}, {"text": "Bloc Party are an English indie rock band, currently composed of Kele Okereke (lead vocals, rhythm guitar, keyboards, sampler), Russell Lissack (lead guitar, keyboards), Justin Harris (bass guitar, keyboards, saxophones, backing vocals) and Louise Bartle (drums, percussion).", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}, {"text": "The Hunter is the first EP (and follow up to the 2010 solo album \"The Boxer\") by Kele Okereke (under the professional name Kele), lead singer and rhythm guitarist of the British rock band Bloc Party.", "chunk_id": "145e5d0c1408e198", "doc_id": "hp_e5470b4e6fa8bc35"}]</data>
  <data key="d3">["hp_24b106283a2f2b9f", "hp_69c70a8b17b9692e", "hp_e5470b4e6fa8bc35"]</data>
  <data key="d4">False</data>
</node>
<node id="Bloc Party">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A British indie rock band.", "chunk_id": "bb2b762aba15f55a", "doc_id": "hp_24b106283a2f2b9f"}, {"text": "Bloc Party is an English indie rock band.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}, {"text": "Bloc Party is a British rock band.", "chunk_id": "145e5d0c1408e198", "doc_id": "hp_e5470b4e6fa8bc35"}]</data>
  <data key="d2">[{"text": "The Boxer is the debut solo album by Kele Okereke, the lead singer of British indie rock band Bloc Party.", "chunk_id": "bb2b762aba15f55a", "doc_id": "hp_24b106283a2f2b9f"}, {"text": "Bloc Party are an English indie rock band, currently composed of Kele Okereke (lead vocals, rhythm guitar, keyboards, sampler), Russell Lissack (lead guitar, keyboards), Justin Harris (bass guitar, keyboards, saxophones, backing vocals) and Louise Bartle (drums, percussion).", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}, {"text": "The Hunter is the first EP (and follow up to the 2010 solo album \"The Boxer\") by Kele Okereke (under the professional name Kele), lead singer and rhythm guitarist of the British rock band Bloc Party.", "chunk_id": "145e5d0c1408e198", "doc_id": "hp_e5470b4e6fa8bc35"}]</data>
  <data key="d3">["hp_24b106283a2f2b9f", "hp_69c70a8b17b9692e", "hp_e5470b4e6fa8bc35"]</data>
  <data key="d4">False</data>
</node>
<node id="Kele">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The professional name used by Kele Okereke for his solo releases.", "chunk_id": "bb2b762aba15f55a", "doc_id": "hp_24b106283a2f2b9f"}, {"text": "Kele is the professional name used by Kele Okereke.", "chunk_id": "145e5d0c1408e198", "doc_id": "hp_e5470b4e6fa8bc35"}]</data>
  <data key="d2">[{"text": "Okereke released the album under the professional name of Kele on 21 June 2010.", "chunk_id": "bb2b762aba15f55a", "doc_id": "hp_24b106283a2f2b9f"}, {"text": "The Hunter is the first EP (and follow up to the 2010 solo album \"The Boxer\") by Kele Okereke (under the professional name Kele), lead singer and rhythm guitarist of the British rock band Bloc Party.", "chunk_id": "145e5d0c1408e198", "doc_id": "hp_e5470b4e6fa8bc35"}]</data>
  <data key="d3">["hp_24b106283a2f2b9f", "hp_e5470b4e6fa8bc35"]</data>
  <data key="d4">False</data>
</node>
<node id="Rise">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A song uploaded by Kele Okereke to his personal website as promotion for his album 'The Boxer'.", "chunk_id": "bb2b762aba15f55a", "doc_id": "hp_24b106283a2f2b9f"}]</data>
  <data key="d2">[{"text": "As promotion, he uploaded the songs \"Rise\" and \"Walk Tall\" to his personal website on 13 May.", "chunk_id": "bb2b762aba15f55a", "doc_id": "hp_24b106283a2f2b9f"}]</data>
  <data key="d3">["hp_24b106283a2f2b9f"]</data>
