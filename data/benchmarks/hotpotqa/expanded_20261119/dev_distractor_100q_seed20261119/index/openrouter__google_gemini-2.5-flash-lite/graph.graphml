<edge source="Russell Lissack" target="Bloc Party">
  <data key="d5">["MEMBER_OF", "FOUNDED"]</data>
  <data key="d6">Russell Lissack is a member of the band Bloc Party.</data>
  <data key="d7">[{"text": "Bloc Party are an English indie rock band, currently composed of Kele Okereke (lead vocals, rhythm guitar, keyboards, sampler), Russell Lissack (lead guitar, keyboards), Justin Harris (bass guitar, keyboards, saxophones, backing vocals) and Louise Bartle (drums, percussion).", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e", "type": "MEMBER_OF"}, {"text": "The band was formed at the 1999 Reading Festival by Okereke and Lissack.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e", "type": "FOUNDED"}]</data>
  <data key="d8">hp_69c70a8b17b9692e</data>
</edge>
