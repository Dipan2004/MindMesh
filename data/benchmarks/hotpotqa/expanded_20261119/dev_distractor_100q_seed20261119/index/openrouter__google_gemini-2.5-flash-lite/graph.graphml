  <data key="d2">[{"text": "There are annual world championship events in the sport of motorcycle speedway for individual riders - the Speedway Grand Prix - and for national teams - the Speedway World Cup.", "chunk_id": "e5d5a4b02c67ef13", "doc_id": "hp_a39a6df00bec9318"}]</data>
