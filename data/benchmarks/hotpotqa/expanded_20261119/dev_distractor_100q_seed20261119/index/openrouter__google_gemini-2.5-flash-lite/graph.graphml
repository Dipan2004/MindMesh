  <data key="d7">[{"text": "Gayle released \"Don't It Make My Brown Eyes Blue\" in 1977 which became her signature song and brought her crossover pop success.", "chunk_id": "79f2e927bc5b3f09", "doc_id": "hp_3b9acbbdcc47f797", "type": "PERFORMED_BY"}]</data>
  <data key="d8">hp_3b9acbbdcc47f797</data>
</edge>
