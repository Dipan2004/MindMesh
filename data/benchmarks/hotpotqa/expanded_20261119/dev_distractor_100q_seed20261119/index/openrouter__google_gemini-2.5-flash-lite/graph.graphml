  <data key="d5">["REPAIRS"]</data>
  <data key="d6">A computer repair technician repairs computers.</data>
  <data key="d7">[{"text": "A computer repair technician is a person who repairs and maintains computers and servers.", "chunk_id": "ef4743de89955cae", "doc_id": "hp_dc063fd42799d92d", "type": "REPAIRS"}]</data>
