  <data key="d2">[{"text": "Born in Chennai, India and educated at the University of Southern California and at Columbia University, New York, he is well known for his collaborative work with Carnatic vocalist Sikkil Gurucharan.", "chunk_id": "054fd83d35ee6361", "doc_id": "hp_39d1d2299826213a"}]</data>
