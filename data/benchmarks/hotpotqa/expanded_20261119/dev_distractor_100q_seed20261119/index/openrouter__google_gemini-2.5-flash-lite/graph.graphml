<edge source="Won Gyun" target="Joseon Dynasty">
  <data key="d5">["PART_OF"]</data>
  <data key="d6">Won Gyun was a general and admiral during the Joseon Dynasty.</data>
  <data key="d7">[{"text": "Won Gyun (Korean: 원균, hanja:元均 ; 12 February 1540 – 27 August 1597) was a Korean general and admiral during the Joseon Dynasty.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92", "type": "PART_OF"}]</data>
