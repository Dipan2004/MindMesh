  <data key="d5">["IS_A"]</data>
  <data key="d6">Despoina was the goddess of mysteries of Arcadian cults.</data>
  <data key="d7">[{"text": "She was the goddess of mysteries of Arcadian cults worshipped under the title \"Despoina\", \"the mistress\" alongside her mother Demeter, one of the goddesses of the Eleusinian mysteries.", "chunk_id": "e7a3b85aaae283b2", "doc_id": "hp_438860de5931a74b", "type": "IS_A"}]</data>
