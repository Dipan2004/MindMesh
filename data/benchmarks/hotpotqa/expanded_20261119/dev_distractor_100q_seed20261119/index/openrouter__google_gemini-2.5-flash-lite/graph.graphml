  <data key="d5">["LOCATED_IN", "LOCATED_IN"]</data>
  <data key="d6">The RIANZ Singles Chart is located in New Zealand.</data>
  <data key="d7">[{"text": "It peaked at No. 4 on their native RIANZ Singles Chart in New Zealand and No. 5 on their adopted country of Australia's ARIA Singles Chart.", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb", "type": "LOCATED_IN"}, {"text": "The song was released in October 2006 and peaked at No. 15 on the RIANZ Singles Chart in New Zealand and number one on the ARIA Singles Chart, making it Evermore's most successful single in Australia.", "chunk_id": "d4c212cc890b725d", "doc_id": "hp_b314ee58b364424a", "type": "LOCATED_IN"}]</data>
