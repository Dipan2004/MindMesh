<node id="Battle of Verdun">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A major battle fought during World War I.", "chunk_id": "2eb3f367156872ac", "doc_id": "hp_69a8458a8adc29ab"}]</data>
  <data key="d2">[{"text": "After the beginning of the Battle of Verdun (21 February – 18 December 1916), the Tenth Army was withdrawn and the British First Army and Third Army on either flank, took over he French positions.", "chunk_id": "2eb3f367156872ac", "doc_id": "hp_69a8458a8adc29ab"}]</data>
