  <data key="d2">[{"text": "Since the beginning of the 1998-99 season, the Chinook League has produced four Allan Cup National Champions: the 1999 Stony Plain Eagles, and the 2009, 2013 and 2016 Bentley Generals.", "chunk_id": "a9aaf20a5efa7119", "doc_id": "hp_935a97e967fb1363"}]</data>
