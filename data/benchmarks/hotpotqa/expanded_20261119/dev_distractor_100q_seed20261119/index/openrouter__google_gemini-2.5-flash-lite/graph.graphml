  <data key="d2">[{"text": "A self-described \"Comic/Guitar Hero,\" he is best known for the comedy on his YouTube channel, NicePeter, especially the comedic series \"Epic Rap Battles of History\".", "chunk_id": "139ff0daddde19f6", "doc_id": "hp_47717c3619ee9332"}]</data>
