<edge source="Yandang Mountains" target="Zhejiang province">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">The Yandang Mountains are located in southeastern Zhejiang province.</data>
  <data key="d7">[{"text": "Yandang Mountains or Yandangshan (Chinese:  雁蕩山 ,  雁荡山 ,  \"Yàndàng Shān\",  \"Wild Goose Pond Mountain(s)\") refers, in the broad sense, to a coastal mountain range in southeastern Zhejiang province in eastern China, covering much of the prefecture-level city of Wenzhou (from Pingyang County in the south to Yueqing County in the northeast) and extending to the county-level city of Wenling in Taizhou prefecture.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_a71b119b261e3b26</data>
</edge>
