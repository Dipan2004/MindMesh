<node id="Clara Josephine Wieck">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The birth name of Clara Schumann.", "chunk_id": "933ccb664a9a5ee9", "doc_id": "hp_82f5ebc51e47c5a7"}]</data>
  <data key="d2">[{"text": "Clara Schumann (\"née\" Clara Josephine Wieck; 13 September 1819 – 20 May 1896) was a German musician and composer, considered one of the most distinguished pianists of the Romantic era.", "chunk_id": "933ccb664a9a5ee9", "doc_id": "hp_82f5ebc51e47c5a7"}]</data>
  <data key="d3">["hp_82f5ebc51e47c5a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Romantic era">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A historical period known for its distinguished pianists.", "chunk_id": "933ccb664a9a5ee9", "doc_id": "hp_82f5ebc51e47c5a7"}]</data>
  <data key="d2">[{"text": "Clara Schumann (\"née\" Clara Josephine Wieck; 13 September 1819 – 20 May 1896) was a German musician and composer, considered one of the most distinguished pianists of the Romantic era.", "chunk_id": "933ccb664a9a5ee9", "doc_id": "hp_82f5ebc51e47c5a7"}]</data>
  <data key="d3">["hp_82f5ebc51e47c5a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Robert Schumann">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A composer and the husband of Clara Schumann.", "chunk_id": "933ccb664a9a5ee9", "doc_id": "hp_82f5ebc51e47c5a7"}]</data>
  <data key="d2">[{"text": "Her husband was the composer Robert Schumann.", "chunk_id": "933ccb664a9a5ee9", "doc_id": "hp_82f5ebc51e47c5a7"}]</data>
  <data key="d3">["hp_82f5ebc51e47c5a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Johannes Brahms">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A composer whom Clara and Robert Schumann encouraged.", "chunk_id": "933ccb664a9a5ee9", "doc_id": "hp_82f5ebc51e47c5a7"}]</data>
  <data key="d2">[{"text": "Together they encouraged Johannes Brahms.", "chunk_id": "933ccb664a9a5ee9", "doc_id": "hp_82f5ebc51e47c5a7"}]</data>
  <data key="d3">["hp_82f5ebc51e47c5a7"]</data>
  <data key="d4">False</data>
</node>
<node id="Variations and Fugue on a Theme by Handel">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A piece by Brahms that Clara Schumann premiered.", "chunk_id": "933ccb664a9a5ee9", "doc_id": "hp_82f5ebc51e47c5a7"}]</data>
  <data key="d2">[{"text": "She later premiered some other pieces by Brahms, notably the \"Variations and Fugue on a Theme by Handel\".", "chunk_id": "933ccb664a9a5ee9", "doc_id": "hp_82f5ebc51e47c5a7"}]</data>
  <data key="d3">["hp_82f5ebc51e47c5a7"]</data>
  <data key="d4">False</data>
</node>
