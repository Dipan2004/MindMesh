  <data key="d2">[{"text": "This would be published in a book, together with stories by Norman Mailer and Carlos Fuentes, which would be handed out to passengers flying between Italy and Central, North and South America in 1992, the year of the fifth centennial.", "chunk_id": "eba842781d3e0f53", "doc_id": "hp_2fa6e4f30229c0a7"}]</data>
