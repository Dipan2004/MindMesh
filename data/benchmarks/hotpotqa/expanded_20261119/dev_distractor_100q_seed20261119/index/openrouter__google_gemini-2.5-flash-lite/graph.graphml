<node id="The Friendly City">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Friendly City was a former title for Frederick, Oklahoma.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}]</data>
  <data key="d2">[{"text": "Once titled \"The Friendly City\", its charm and receptiveness leaves visitors feeling like locals.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}]</data>
  <data key="d3">["hp_6eb8e4170df0651b"]</data>
  <data key="d4">False</data>
</node>
<node id="agriculture">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Agriculture is the practice of farming, including cultivation of the soil for the growing of crops and the rearing of animals to provide food, wool, and other products.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}]</data>
  <data key="d2">[{"text": "It is an agriculture-based community that primarily produces wheat, cotton, and cattle.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}]</data>
  <data key="d3">["hp_6eb8e4170df0651b"]</data>
  <data key="d4">False</data>
</node>
<node id="wheat">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Wheat is a cereal grain.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}]</data>
  <data key="d2">[{"text": "It is an agriculture-based community that primarily produces wheat, cotton, and cattle.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}]</data>
  <data key="d3">["hp_6eb8e4170df0651b"]</data>
  <data key="d4">False</data>
</node>
<node id="cotton">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Cotton is a soft, fluffy staple fiber that grows in a boll, or protective case, around the seeds of cotton plants.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}, {"text": "Cotton is a material that can be combined with camel's hair to create a woolen textile.", "chunk_id": "80b52c81ca855fef", "doc_id": "hp_c12a13b85cfa0362"}]</data>
  <data key="d2">[{"text": "It is an agriculture-based community that primarily produces wheat, cotton, and cattle.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}, {"text": "It is also described as a warm light woolen textile of camel's hair combined with wool or cotton.", "chunk_id": "80b52c81ca855fef", "doc_id": "hp_c12a13b85cfa0362"}]</data>
  <data key="d3">["hp_6eb8e4170df0651b", "hp_c12a13b85cfa0362"]</data>
  <data key="d4">False</data>
</node>
<node id="cattle">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Cattle are domesticated bovine animals.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}]</data>
  <data key="d2">[{"text": "It is an agriculture-based community that primarily produces wheat, cotton, and cattle.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}]</data>
  <data key="d3">["hp_6eb8e4170df0651b"]</data>
