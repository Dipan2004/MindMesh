  <data key="d2">[{"text": "The Cabinet of Jan Svankmajer is a 1984 surreal short stop-motion film by the Quay Brothers, an homage to the influential short film maker Jan Švankmajer.", "chunk_id": "a444120708251a3f", "doc_id": "hp_84e3d8dcd0f0d6d5"}]</data>
