<node id="Bothriochloa ischaemum">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Bothriochloa ischaemum is a species of perennial grass in the family Poaceae.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d2">[{"text": "Bothriochloa ischaemum is a species of perennial grass in the family Poaceae, found throughout much of the world.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d3">["hp_f7e1751d7e276925"]</data>
  <data key="d4">False</data>
</node>
<node id="Poaceae">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Poaceae is the family to which Bothriochloa ischaemum belongs.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d2">[{"text": "Bothriochloa ischaemum is a species of perennial grass in the family Poaceae, found throughout much of the world.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d3">["hp_f7e1751d7e276925"]</data>
  <data key="d4">False</data>
</node>
<node id="yellow bluestem">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Yellow bluestem is a common name for Bothriochloa ischaemum.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d2">[{"text": "It is commonly known as yellow bluestem.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d3">["hp_f7e1751d7e276925"]</data>
  <data key="d4">False</data>
</node>
<node id="Bothriochloa ischaemum var. ischaemum">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Bothriochloa ischaemum var. ischaemum is a variety native to Europe, Asia, and Africa.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d2">[{"text": "Two varieties are recognized, of which \"Bothriochloa ischaemum\" var. \"ischaemum\" is native to Europe, Asia, and Africa and naturalized elsewhere, and var. \"songarica\" is native to Asia and naturalized elsewhere.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d3">["hp_f7e1751d7e276925"]</data>
  <data key="d4">False</data>
</node>
<node id="Bothriochloa ischaemum var. songarica">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Bothriochloa ischaemum var. songarica is a variety native to Asia and naturalized elsewhere.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d2">[{"text": "Two varieties are recognized, of which \"Bothriochloa ischaemum\" var. \"ischaemum\" is native to Europe, Asia, and Africa and naturalized elsewhere, and var. \"songarica\" is native to Asia and naturalized elsewhere.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d3">["hp_f7e1751d7e276925"]</data>
  <data key="d4">False</data>
</node>
<node id="King Ranch bluestem">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "King Ranch bluestem is a common name for Bothriochloa ischaemum var. songarica in Texas.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d2">[{"text": "Var. \"songarica\" is an invasive weed in Texas, where it is known as \"King Ranch bluestem\"; it has displaced native grasses in large areas of central and south Texas.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d3">["hp_f7e1751d7e276925"]</data>
  <data key="d4">False</data>
</node>
<node id="central and south Texas">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Central and south Texas are areas where Bothriochloa ischaemum var. songarica has displaced native grasses.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d2">[{"text": "Var. \"songarica\" is an invasive weed in Texas, where it is known as \"King Ranch bluestem\"; it has displaced native grasses in large areas of central and south Texas.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925"}]</data>
  <data key="d3">["hp_f7e1751d7e276925"]</data>
  <data key="d4">False</data>
</node>
