  <data key="d2">[{"text": "It was released on March 15, 1994, and is the only album that does not feature lead singer Vince Neil, who had departed from the band in 1992.", "chunk_id": "c57fbc208f9c8aea", "doc_id": "hp_3835f9a65d3f6cf8"}]</data>
