  <data key="d7">[{"text": "The series is hosted by theoretical physicist Michio Kaku and is based on his book \"Physics of the Impossible\".", "chunk_id": "fee479fd980ac770", "doc_id": "hp_78779183524b143c", "type": "HOSTS"}]</data>
