</node>
<node id="Maria Candelaria">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Maria Candelaria is a film directed by Emilio Fernández that won the Palme d'Or award.", "chunk_id": "e2bd3c61103e4d8b", "doc_id": "hp_e6718a97d51ea825"}]</data>
  <data key="d2">[{"text": "He is best known for his work as director of the film \"Maria Candelaria\" (1944), which won the Palme d'Or award at the 1946 Cannes Film Festival.", "chunk_id": "e2bd3c61103e4d8b", "doc_id": "hp_e6718a97d51ea825"}]</data>
  <data key="d3">["hp_e6718a97d51ea825"]</data>
  <data key="d4">False</data>
</node>
