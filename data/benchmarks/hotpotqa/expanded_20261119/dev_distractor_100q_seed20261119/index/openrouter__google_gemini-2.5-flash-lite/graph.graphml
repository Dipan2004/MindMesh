<edge source="South China" target="Hong Kong First Division League">
  <data key="d5">["PROMISED_TO_EXPAND_BUDGET_FOR"]</data>
  <data key="d6">South China promised to expand its budget for the Hong Kong First Division League.</data>
  <data key="d7">[{"text": "South China was retained because the club promised to expand its next season's budget and sign new quality players.", "chunk_id": "0fb0a4062ab720d1", "doc_id": "hp_a2558257c20dfe87", "type": "PROMISED_TO_EXPAND_BUDGET_FOR"}]</data>
