<node id="University of Leeds">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The University of Leeds is an institution where Leung Po Shan studied.", "chunk_id": "897f999db778cfd7", "doc_id": "hp_0072f61fd930d308"}]</data>
  <data key="d2">[{"text": "She studied at the University of Leeds on a Hong Kong Arts Development Council Scholarship.", "chunk_id": "897f999db778cfd7", "doc_id": "hp_0072f61fd930d308"}]</data>
  <data key="d3">["hp_0072f61fd930d308"]</data>
  <data key="d4">False</data>
