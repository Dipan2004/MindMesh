</node>
<node id="Laos">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A country in Southeast Asia where the military situation was discussed in the Zilch memo.", "chunk_id": "51c2cb97c1a1900f", "doc_id": "hp_7681eb8af0f9cd50"}]</data>
  <data key="d2">[{"text": "A memorandum known as the Zilch memo was an American government document sent by National Security Advisor Henry Kissinger to President Richard Nixon on January 3, 1972, about the military situation in Laos during the Vietnam War.", "chunk_id": "51c2cb97c1a1900f", "doc_id": "hp_7681eb8af0f9cd50"}]</data>
