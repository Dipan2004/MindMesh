<node id="Russell Lissack">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Russell Lissack is a member of the band Bloc Party, playing lead guitar and keyboards.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
  <data key="d2">[{"text": "Bloc Party are an English indie rock band, currently composed of Kele Okereke (lead vocals, rhythm guitar, keyboards, sampler), Russell Lissack (lead guitar, keyboards), Justin Harris (bass guitar, keyboards, saxophones, backing vocals) and Louise Bartle (drums, percussion).", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
