  <data key="d2">[{"text": "The Kritikos Lagonikos (Cretan Hound) (Greek:Kρητικός Λαγωνικός) is a hunting breed of dog from the island of Crete, in Greece.", "chunk_id": "23bea06c26701fe1", "doc_id": "hp_9dcbf20f76a63e66"}]</data>
