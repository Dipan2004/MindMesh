  <data key="d7">[{"text": "The Mihrimah Sultan Mosque (Turkish: 'Mihrimah Sultan Camii' ) is an Ottoman mosque located in the Edirnekapı neighborhood near the Byzantine land walls of Istanbul, Turkey.", "chunk_id": "2b745e897c8565f6", "doc_id": "hp_a52cead96a6e20c2", "type": "LOCATED_IN"}, {"text": "Located on the peak of the Sixth Hill near the highest point of the city, the mosque is a prominent landmark in Istanbul.", "chunk_id": "2b745e897c8565f6", "doc_id": "hp_a52cead96a6e20c2", "type": "IS_LANDMARK_IN"}]</data>
