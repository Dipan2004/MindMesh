<node id="English foxhounds">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Foxhounds originating from England.", "chunk_id": "64230ad5f64c09df", "doc_id": "hp_1098786addde3675"}, {"text": "Foxhound dog breeds originating from England.", "chunk_id": "6a4f265a07c810a2", "doc_id": "hp_499a4bbcdeae5a6b"}]</data>
  <data key="d2">[{"text": "It is one of the Anglo-French hound breeds which were created by crossing French scenthounds with English (Anglo) foxhounds.", "chunk_id": "64230ad5f64c09df", "doc_id": "hp_1098786addde3675"}, {"text": "It is one of the Anglo-French hound breeds which were created by crossing French scenthounds with English (Anglo) Foxhounds.", "chunk_id": "6a4f265a07c810a2", "doc_id": "hp_499a4bbcdeae5a6b"}]</data>
  <data key="d3">["hp_1098786addde3675", "hp_499a4bbcdeae5a6b"]</data>
  <data key="d4">False</data>
</node>
