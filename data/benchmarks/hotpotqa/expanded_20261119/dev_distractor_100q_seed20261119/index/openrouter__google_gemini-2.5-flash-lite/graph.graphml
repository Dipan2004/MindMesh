<node id="Geraldine Granger">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Geraldine Granger is the lead role played by Dawn French in the sitcom \"The Vicar of Dibley\".", "chunk_id": "8f5e1ed518366291", "doc_id": "hp_b150127ee448fafd"}]</data>
  <data key="d2">[{"text": "She is best known for starring in and writing for the comedy sketch show \"French and Saunders\" with comedy partner Jennifer Saunders and for playing the lead role as Geraldine Granger in the sitcom \"The Vicar of Dibley\".", "chunk_id": "8f5e1ed518366291", "doc_id": "hp_b150127ee448fafd"}]</data>
