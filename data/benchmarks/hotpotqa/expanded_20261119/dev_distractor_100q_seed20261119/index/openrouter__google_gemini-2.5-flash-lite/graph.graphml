<node id="Parma Airport">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Parma Airport is an airport located northwest of Parma, Italy.", "chunk_id": "90aa0e3b675f8e93", "doc_id": "hp_e9d687a7dd49fca0"}]</data>
