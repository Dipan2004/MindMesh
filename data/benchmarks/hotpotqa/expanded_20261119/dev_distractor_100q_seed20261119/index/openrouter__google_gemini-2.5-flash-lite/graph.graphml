</node>
<node id="University of Oklahoma">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The University of Oklahoma is a public research university in Norman, Oklahoma.", "chunk_id": "e3f12262205bc9b4", "doc_id": "hp_831c6e1412980f7a"}, {"text": "The University of Oklahoma is where Lawrence Haskell served as the head baseball coach.", "chunk_id": "bf6beb2e41c2adee", "doc_id": "hp_ae365671bb34f99c"}]</data>
  <data key="d2">[{"text": "He is currently the 13th president of the University of Oklahoma.", "chunk_id": "e3f12262205bc9b4", "doc_id": "hp_831c6e1412980f7a"}, {"text": "He served as the head baseball coach at the University of Oklahoma from 1927 to 1941.", "chunk_id": "bf6beb2e41c2adee", "doc_id": "hp_ae365671bb34f99c"}]</data>
  <data key="d3">["hp_831c6e1412980f7a", "hp_ae365671bb34f99c"]</data>
  <data key="d4">False</data>
</node>
<node id="President of the University of Oklahoma">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The President of the University of Oklahoma is the chief executive officer of the university.", "chunk_id": "e3f12262205bc9b4", "doc_id": "hp_831c6e1412980f7a"}]</data>
  <data key="d2">[{"text": "He is currently the 13th president of the University of Oklahoma.", "chunk_id": "e3f12262205bc9b4", "doc_id": "hp_831c6e1412980f7a"}]</data>
  <data key="d3">["hp_831c6e1412980f7a"]</data>
  <data key="d4">False</data>
</node>
<node id="Senate Select Committee on Intelligence">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Senate Select Committee on Intelligence is a select committee of the United States Senate that oversees the United States intelligence community.", "chunk_id": "e3f12262205bc9b4", "doc_id": "hp_831c6e1412980f7a"}]</data>
  <data key="d2">[{"text": "He was the longest serving chairman of the Senate Select Committee on Intelligence.", "chunk_id": "e3f12262205bc9b4", "doc_id": "hp_831c6e1412980f7a"}]</data>
  <data key="d3">["hp_831c6e1412980f7a"]</data>
  <data key="d4">False</data>
</node>
<node id="Chairman of the Senate Select Committee on Intelligence">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Chairman of the Senate Select Committee on Intelligence is the presiding officer of the committee.", "chunk_id": "e3f12262205bc9b4", "doc_id": "hp_831c6e1412980f7a"}]</data>
  <data key="d2">[{"text": "He was the longest serving chairman of the Senate Select Committee on Intelligence.", "chunk_id": "e3f12262205bc9b4", "doc_id": "hp_831c6e1412980f7a"}]</data>
  <data key="d3">["hp_831c6e1412980f7a"]</data>
  <data key="d4">False</data>
</node>
<node id="Rhonda Vincent">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Rhonda Lea Vincent is an American bluegrass singer, songwriter, and multi-instrumentalist.", "chunk_id": "23d585cac1877284", "doc_id": "hp_8366c7a6ce08c469"}]</data>
  <data key="d2">[{"text": "Rhonda Lea Vincent (born July 13, 1962) is an American bluegrass singer, songwriter, and multi-instrumentalist.", "chunk_id": "23d585cac1877284", "doc_id": "hp_8366c7a6ce08c469"}]</data>
  <data key="d3">["hp_8366c7a6ce08c469"]</data>
  <data key="d4">False</data>
</node>
<node id="The Wall Street Journal">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Wall Street Journal is a publication that proclaimed Rhonda Vincent the new Queen of Bluegrass.", "chunk_id": "23d585cac1877284", "doc_id": "hp_8366c7a6ce08c469"}]</data>
  <data key="d2">[{"text": "In 2000, \"The Wall Street Journal\" proclaimed Vincent \"the new Queen of Bluegrass\".", "chunk_id": "23d585cac1877284", "doc_id": "hp_8366c7a6ce08c469"}]</data>
  <data key="d3">["hp_8366c7a6ce08c469"]</data>
  <data key="d4">False</data>
</node>
<node id="Scombroid food poisoning">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Scombroid food poisoning is a foodborne illness that results from eating spoiled (decayed) fish.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f"}]</data>
  <data key="d2">[{"text": "Scombroid food poisoning is a foodborne illness that results from eating spoiled (decayed) fish.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f"}]</data>
  <data key="d3">["hp_837937fae6ec3e6f"]</data>
  <data key="d4">False</data>
</node>
<node id="foodborne illness">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A foodborne illness is a disease transmitted to people through contaminated food.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f"}]</data>
  <data key="d2">[{"text": "Scombroid food poisoning is a foodborne illness that results from eating spoiled (decayed) fish.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f"}]</data>
  <data key="d3">["hp_837937fae6ec3e6f"]</data>
  <data key="d4">False</data>
</node>
<node id="fish">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Fish are aquatic, gill-bearing, vertebrate animals that lack limbs with digits.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f"}]</data>
  <data key="d2">[{"text": "Scombroid food poisoning is a foodborne illness that results from eating spoiled (decayed) fish.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f"}]</data>
  <data key="d3">["hp_837937fae6ec3e6f"]</data>
  <data key="d4">False</data>
</node>
<node id="ciguatera">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Ciguatera is a type of seafood poisoning.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f"}]</data>
  <data key="d2">[{"text": "Along with ciguatera, it is listed as a common type of seafood poisoning.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f"}]</data>
  <data key="d3">["hp_837937fae6ec3e6f"]</data>
  <data key="d4">False</data>
</node>
<node id="seafood poisoning">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Seafood poisoning is a type of foodborne illness caused by consuming contaminated seafood.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f"}]</data>
  <data key="d2">[{"text": "Along with ciguatera, it is listed as a common type of seafood poisoning.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f"}]</data>
  <data key="d3">["hp_837937fae6ec3e6f"]</data>
  <data key="d4">False</data>
</node>
<node id="histamine">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The toxin believed to be responsible for scombroid food poisoning is histamine.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f"}]</data>
  <data key="d2">[{"text": "The toxin believed to be responsible is histamine, formed as the flesh of the fish begins to decay.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f"}]</data>
  <data key="d3">["hp_837937fae6ec3e6f"]</data>
  <data key="d4">False</data>
</node>
<node id="food allergy">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A food allergy is an immune system reaction that occurs soon after eating a certain food.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f"}]</data>
  <data key="d2">[{"text": "As histamine is also the natural agent involved in allergic reactions, scombroid food poisoning often gets misidentified as a food allergy.", "chunk_id": "6a55b822cef44711", "doc_id": "hp_837937fae6ec3e6f"}]</data>
  <data key="d3">["hp_837937fae6ec3e6f"]</data>
  <data key="d4">False</data>
</node>
<node id="Lemonade and Brownies">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The debut studio album by the American rock band Sugar Ray.", "chunk_id": "349853336eca2d3b", "doc_id": "hp_83c086e4312cda99"}]</data>
  <data key="d2">[{"text": "Lemonade and Brownies is the debut studio album by the American rock band Sugar Ray.", "chunk_id": "349853336eca2d3b", "doc_id": "hp_83c086e4312cda99"}]</data>
  <data key="d3">["hp_83c086e4312cda99"]</data>
  <data key="d4">False</data>
</node>
<node id="Joseph McGinty &quot;McG&quot; Nichol">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The band's director friend who produced the album.", "chunk_id": "349853336eca2d3b", "doc_id": "hp_83c086e4312cda99"}]</data>
  <data key="d2">[{"text": "It was produced by the band's director friend Joseph McGinty \"McG\" Nichol and DJ Lethal and released on April 4, 1995 by Atlantic Records.", "chunk_id": "349853336eca2d3b", "doc_id": "hp_83c086e4312cda99"}]</data>
  <data key="d3">["hp_83c086e4312cda99"]</data>
  <data key="d4">False</data>
</node>
<node id="DJ Lethal">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A producer of the album.", "chunk_id": "349853336eca2d3b", "doc_id": "hp_83c086e4312cda99"}]</data>
  <data key="d2">[{"text": "It was produced by the band's director friend Joseph McGinty \"McG\" Nichol and DJ Lethal and released on April 4, 1995 by Atlantic Records.", "chunk_id": "349853336eca2d3b", "doc_id": "hp_83c086e4312cda99"}]</data>
  <data key="d3">["hp_83c086e4312cda99"]</data>
  <data key="d4">False</data>
</node>
<node id="Atlantic Records">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A record label that released the album.", "chunk_id": "349853336eca2d3b", "doc_id": "hp_83c086e4312cda99"}]</data>
  <data key="d2">[{"text": "It was produced by the band's director friend Joseph McGinty \"McG\" Nichol and DJ Lethal and released on April 4, 1995 by Atlantic Records.", "chunk_id": "349853336eca2d3b", "doc_id": "hp_83c086e4312cda99"}]</data>
  <data key="d3">["hp_83c086e4312cda99"]</data>
  <data key="d4">False</data>
</node>
<node id="Nicole Eggert">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An actress featured on the album cover.", "chunk_id": "349853336eca2d3b", "doc_id": "hp_83c086e4312cda99"}]</data>
  <data key="d2">[{"text": "Actress Nicole Eggert is featured on the cover.", "chunk_id": "349853336eca2d3b", "doc_id": "hp_83c086e4312cda99"}]</data>
  <data key="d3">["hp_83c086e4312cda99"]</data>
  <data key="d4">False</data>
</node>
<node id="Mick Jackson">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The producer and director of the \"Connections\" television series.", "chunk_id": "ff5da75d9754d424", "doc_id": "hp_83e4174eb0dec6ec"}]</data>
  <data key="d2">[{"text": "The series was produced and directed by Mick Jackson of the BBC Science and Features Department and first aired in 1978 (UK) and 1979 (USA).", "chunk_id": "ff5da75d9754d424", "doc_id": "hp_83e4174eb0dec6ec"}]</data>
  <data key="d3">["hp_83e4174eb0dec6ec"]</data>
  <data key="d4">False</data>
</node>
<node id="BBC Science and Features Department">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The department within the BBC that produced and directed the \"Connections\" television series.", "chunk_id": "ff5da75d9754d424", "doc_id": "hp_83e4174eb0dec6ec"}]</data>
  <data key="d2">[{"text": "The series was produced and directed by Mick Jackson of the BBC Science and Features Department and first aired in 1978 (UK) and 1979 (USA).", "chunk_id": "ff5da75d9754d424", "doc_id": "hp_83e4174eb0dec6ec"}]</data>
  <data key="d3">["hp_83e4174eb0dec6ec"]</data>
  <data key="d4">False</data>
</node>
<node id="history of science and invention">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The interdisciplinary approach taken by the \"Connections\" series to explore how discoveries and achievements built upon each other.", "chunk_id": "ff5da75d9754d424", "doc_id": "hp_83e4174eb0dec6ec"}]</data>
  <data key="d2">[{"text": "It took an interdisciplinary approach to the history of science and invention, and demonstrated how various discoveries, scientific achievements, and historical world events were built from one another successively in an interconnected way to bring about particular aspects of modern technology.", "chunk_id": "ff5da75d9754d424", "doc_id": "hp_83e4174eb0dec6ec"}]</data>
  <data key="d3">["hp_83e4174eb0dec6ec"]</data>
  <data key="d4">False</data>
</node>
<node id="modern technology">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "The aspects of modern technology that the \"Connections\" series demonstrated were brought about by interconnected discoveries and achievements.", "chunk_id": "ff5da75d9754d424", "doc_id": "hp_83e4174eb0dec6ec"}]</data>
  <data key="d2">[{"text": "It took an interdisciplinary approach to the history of science and invention, and demonstrated how various discoveries, scientific achievements, and historical world events were built from one another successively in an interconnected way to bring about particular aspects of modern technology.", "chunk_id": "ff5da75d9754d424", "doc_id": "hp_83e4174eb0dec6ec"}]</data>
  <data key="d3">["hp_83e4174eb0dec6ec"]</data>
  <data key="d4">False</data>
</node>
<node id="Richard Hammond's Engineering Connections">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A documentary series presented by Richard Hammond that explores how engineers and designers utilize historical inventions and natural world clues to create new buildings and machines.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}]</data>
  <data key="d2">[{"text": "Richard Hammond's Engineering Connections is a documentary series originally broadcast on the National Geographic Channel, and later on BBC2.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}]</data>
  <data key="d3">["hp_8429039f0ec9c01d"]</data>
  <data key="d4">False</data>
</node>
<node id="Richard Hammond">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The presenter of the documentary series 'Richard Hammond's Engineering Connections'.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}]</data>
  <data key="d2">[{"text": "It is presented by Richard Hammond, and looks at how engineers and designers use historic inventions and clues from the natural world in ingenious ways to develop new buildings and machines.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}]</data>
  <data key="d3">["hp_8429039f0ec9c01d"]</data>
  <data key="d4">False</data>
</node>
<node id="National Geographic Channel">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A television channel that originally broadcast the documentary series 'Richard Hammond's Engineering Connections'.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}]</data>
  <data key="d2">[{"text": "Richard Hammond's Engineering Connections is a documentary series originally broadcast on the National Geographic Channel, and later on BBC2.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}]</data>
  <data key="d3">["hp_8429039f0ec9c01d"]</data>
  <data key="d4">False</data>
</node>
<node id="BBC2">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A television channel that later broadcast the documentary series 'Richard Hammond's Engineering Connections'.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}]</data>
  <data key="d2">[{"text": "Richard Hammond's Engineering Connections is a documentary series originally broadcast on the National Geographic Channel, and later on BBC2.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}]</data>
  <data key="d3">["hp_8429039f0ec9c01d"]</data>
  <data key="d4">False</data>
</node>
<node id="Sky">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A service provider offering on-demand viewing of 'Richard Hammond's Engineering Connections' for subscribers.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}]</data>
  <data key="d2">[{"text": "None of the three series of the programme are available to purchase on DVD in the UK, however, all three can be watched on demand for subscribers of National Geographic on Sky, Virgin Media and BT Vision.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}]</data>
  <data key="d3">["hp_8429039f0ec9c01d"]</data>
  <data key="d4">False</data>
</node>
