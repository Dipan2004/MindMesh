<node id="Gigafactory 1">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Gigafactory 1 is an operational lithium-ion battery factory under construction.", "chunk_id": "51ed4dfb52cf2e60", "doc_id": "hp_5df9f2d47c876b64"}, {"text": "A factory being built at the Tahoe Reno Industrial Center.", "chunk_id": "53d19b7b5423b1f7", "doc_id": "hp_63a714bc28813989"}]</data>
  <data key="d2">[{"text": "The Tesla Gigafactory 1 is an operational lithium-ion battery factory under construction, primarily for Tesla Inc., at the Tahoe Reno Industrial Center (TRIC) in Storey County (near the Community of Clark, Nevada, US).", "chunk_id": "51ed4dfb52cf2e60", "doc_id": "hp_5df9f2d47c876b64"}, {"text": "The Gigafactory 1 is being built there to serve Tesla Motors and Panasonic.", "chunk_id": "53d19b7b5423b1f7", "doc_id": "hp_63a714bc28813989"}]</data>
  <data key="d3">["hp_5df9f2d47c876b64", "hp_63a714bc28813989"]</data>
  <data key="d4">False</data>
</node>
