  <data key="d1">[{"text": "A location where Michael Yorke became Dean in 1999.", "chunk_id": "8920fade874a14dc", "doc_id": "hp_51685a23dbd90e79"}]</data>
  <data key="d2">[{"text": "In 1999 he became Dean of Lichfield, and is now in retirement as Dean Emeritus.", "chunk_id": "8920fade874a14dc", "doc_id": "hp_51685a23dbd90e79"}]</data>
  <data key="d3">["hp_51685a23dbd90e79"]</data>
