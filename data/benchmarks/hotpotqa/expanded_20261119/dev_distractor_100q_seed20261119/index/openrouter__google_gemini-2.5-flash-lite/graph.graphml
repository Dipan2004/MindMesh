<node id="Hondo Valley">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A valley in southern New Mexico through which the Rio Hondo flows.", "chunk_id": "255974268309be7d", "doc_id": "hp_d006074a495409b2"}]</data>
  <data key="d2">[{"text": "The river flows eastward through the Hondo Valley in the foothills of the Sierra Blanca and Capitan Mountains, roughly paralleling the route of U.S. Route 70 through the towns of Picacho and Tinnie.", "chunk_id": "255974268309be7d", "doc_id": "hp_d006074a495409b2"}]</data>
