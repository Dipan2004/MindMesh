  <data key="d7">[{"text": "Russian Route A180, also known as Narva Highway (Russian: Федера́льная автомоби́льная доро́га А180 «На́рва» , Federal highway A180 \"Narva\") is a Russian federal highway that runs from Saint Petersburg through Ivangorod up to the border with Estonia by the Narva River, with the Estonian city of Narva on the opposite bank, which explains the name of the highway.", "chunk_id": "53eccf7b7bf86b26", "doc_id": "hp_b85dbf7e5499fa3f", "type": "LOCATED_IN"}]</data>
