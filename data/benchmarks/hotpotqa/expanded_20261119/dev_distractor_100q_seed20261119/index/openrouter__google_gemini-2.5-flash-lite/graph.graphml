<edge source="British Fifth Army" target="Field Marshal Sir Douglas Haig">
  <data key="d5">["INSTRUCTED_BY"]</data>
  <data key="d6">Field Marshal Sir Douglas Haig instructed the British Fifth Army.</data>
  <data key="d7">[{"text": "The Fifth Army was instructed by Field Marshal Sir Douglas Haig to prepare systematic attacks to capture portions of the German defences.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad", "type": "INSTRUCTED_BY"}]</data>
  <data key="d8">hp_d6e57e7111053cad</data>
</edge>
<edge source="Battle of the Ancre" target="Ancre">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">The Battle of the Ancre took place on the Ancre.</data>
  <data key="d7">[{"text": "After the Battle of the Ancre (13–18 November 1916), British attacks on the Somme front stopped for the winter.", "chunk_id": "82f41c75b9724943", "doc_id": "hp_d6e57e7111053cad", "type": "LOCATED_IN"}]</data>
