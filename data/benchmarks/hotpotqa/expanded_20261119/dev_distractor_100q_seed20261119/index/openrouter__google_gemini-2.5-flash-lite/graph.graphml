<edge source="1918 Allan Cup" target="Allan Cup">
  <data key="d5">["PART_OF"]</data>
  <data key="d6">The 1918 Allan Cup playoff marked the 11th time the Allan Cup had a champion.</data>
  <data key="d7">[{"text": "The 1918 playoff marked the 11th time the Allan Cup had a champion.", "chunk_id": "af23101286e3cc88", "doc_id": "hp_0cfa6ed1fb9c0e08", "type": "PART_OF"}]</data>
  <data key="d8">hp_0cfa6ed1fb9c0e08</data>
</edge>
<edge source="Gollum browser" target="Wikipedia">
  <data key="d5">["USED_FOR", "USED_FOR"]</data>
  <data key="d6">Gollum browser is designed to browse Wikipedia in an easier way.</data>
  <data key="d7">[{"text": "Gollum browser is a web application designed to browse Wikipedia in an easier way than directly using the web browser.", "chunk_id": "1900876eb0183fa0", "doc_id": "hp_0d2b9749009e4dd9", "type": "USED_FOR"}, {"text": "According to one blogger, Gollum provides a way to bypass censorship of Wikipedia in China.", "chunk_id": "1900876eb0183fa0", "doc_id": "hp_0d2b9749009e4dd9", "type": "USED_FOR"}]</data>
  <data key="d8">hp_0d2b9749009e4dd9</data>
</edge>
