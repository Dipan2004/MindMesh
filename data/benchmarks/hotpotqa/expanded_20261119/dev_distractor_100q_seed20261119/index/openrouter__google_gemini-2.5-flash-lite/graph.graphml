  <data key="d2">[{"text": "A feature about her titled Student Body appeared in the September 1968 edition of Playboy and was reprinted in the 1971 Playboy special edition The Youth Culture.", "chunk_id": "b9e66f096d2d52e7", "doc_id": "hp_a9fead16be02ae83"}]</data>
