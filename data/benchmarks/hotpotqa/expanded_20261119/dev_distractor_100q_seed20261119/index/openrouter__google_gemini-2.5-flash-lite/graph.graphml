  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location where Ellis Gowing began his career as a Curate.", "chunk_id": "b450b5ae25bb633c", "doc_id": "hp_0e84d56941e20a86"}]</data>
  <data key="d2">[{"text": "He began his career as a Curate at The Oaks, New South Wales, after which he served at Armidale Cathedral.", "chunk_id": "b450b5ae25bb633c", "doc_id": "hp_0e84d56941e20a86"}]</data>
