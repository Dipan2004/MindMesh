  <data key="d1">[{"text": "The Thailand Open was a previous name for the Thailand Masters snooker tournament.", "chunk_id": "9719756e39f01e98", "doc_id": "hp_b2a5885a3a67beea"}]</data>
  <data key="d2">[{"text": "Previously known as Asian Open and Thailand Open, it was a ranking tournament from 1989/90 to 2001/02.", "chunk_id": "9719756e39f01e98", "doc_id": "hp_b2a5885a3a67beea"}]</data>
  <data key="d3">["hp_b2a5885a3a67beea"]</data>
