  <data key="d1">[{"text": "Home Free is a full-length album by The Besties.", "chunk_id": "ec71908382284000", "doc_id": "hp_353258028a95f6b9"}]</data>
  <data key="d2">[{"text": "Later on, the label began releasing full-length albums, beginning with The Besties' Home Free (HP08), originally released on CD, and later as a vinyl LP.", "chunk_id": "ec71908382284000", "doc_id": "hp_353258028a95f6b9"}]</data>
