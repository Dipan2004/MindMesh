  <data key="d2">[{"text": "An event called the \"Thailand Masters\" also formed part of the \"World Series\" in 1991/92, with Steve Davis beating Stephen Hendry 6–3.", "chunk_id": "9719756e39f01e98", "doc_id": "hp_b2a5885a3a67beea"}]</data>
