  <data key="d5">["LED_CAMPAIGNS_WITH"]</data>
  <data key="d6">Won Gyun led many successful campaigns with Yi Il against the Jurchens.</data>
  <data key="d7">[{"text": "Won led many successful campaigns with Yi Il and Yi Sun-sin against the Jurchens.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92", "type": "LED_CAMPAIGNS_WITH"}]</data>
