  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city in Pakistan where Kapoor Haveli is located.", "chunk_id": "656937d22d978bfd", "doc_id": "hp_e3306a4963e6e08c"}]</data>
  <data key="d2">[{"text": "Born at Kapoor Haveli in Peshawar to actor Prithviraj Kapoorhe was a prominent member of the Kapoor familythat produced several celebrated Bollywood superstars.", "chunk_id": "656937d22d978bfd", "doc_id": "hp_e3306a4963e6e08c"}]</data>
  <data key="d3">["hp_e3306a4963e6e08c"]</data>
  <data key="d4">False</data>
</node>
<node id="Dime novel">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A form of late 19th-century and early 20th-century U.S. popular fiction issued in series of inexpensive paperbound editions.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d2">[{"text": "The dime novel is a form of late 19th-century and early 20th-century U.S. popular fiction issued in series of inexpensive paperbound editions.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d3">["hp_e364a8973c287ebf"]</data>
  <data key="d4">False</data>
</node>
<node id="story papers">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A type of publication related to dime novels.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d2">[{"text": "The term \"dime novel\" has been used as a catchall term for several different but related forms, referring to dime novels, story papers, five- and ten-cent weeklies, \"thick book\" reprints, and sometimes early pulp magazines.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d3">["hp_e364a8973c287ebf"]</data>
  <data key="d4">False</data>
</node>
<node id="five- and ten-cent weeklies">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A type of publication related to dime novels.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d2">[{"text": "The term \"dime novel\" has been used as a catchall term for several different but related forms, referring to dime novels, story papers, five- and ten-cent weeklies, \"thick book\" reprints, and sometimes early pulp magazines.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d3">["hp_e364a8973c287ebf"]</data>
  <data key="d4">False</data>
</node>
<node id="&quot;thick book&quot; reprints">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A type of publication related to dime novels.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d2">[{"text": "The term \"dime novel\" has been used as a catchall term for several different but related forms, referring to dime novels, story papers, five- and ten-cent weeklies, \"thick book\" reprints, and sometimes early pulp magazines.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d3">["hp_e364a8973c287ebf"]</data>
  <data key="d4">False</data>
</node>
<node id="early pulp magazines">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A type of publication related to dime novels.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d2">[{"text": "The term \"dime novel\" has been used as a catchall term for several different but related forms, referring to dime novels, story papers, five- and ten-cent weeklies, \"thick book\" reprints, and sometimes early pulp magazines.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d3">["hp_e364a8973c287ebf"]</data>
  <data key="d4">False</data>
</node>
<node id="Western Dime Novels">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A short-lived pulp magazine that used the term \"dime novel\" as its title.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d2">[{"text": "The term was used as a title as late as 1940, in the short-lived pulp magazine \"Western Dime Novels\".", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d3">["hp_e364a8973c287ebf"]</data>
  <data key="d4">False</data>
</node>
<node id="mass-market paperbacks">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A modern form of book publishing that evolved from dime novels.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d2">[{"text": "Dime novels are the antecedent of today's mass-market paperbacks, comic books, television shows and movies based on dime-novel genres.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d3">["hp_e364a8973c287ebf"]</data>
  <data key="d4">False</data>
</node>
<node id="comic books">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A modern form of publication that evolved from dime novels.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d2">[{"text": "Dime novels are the antecedent of today's mass-market paperbacks, comic books, television shows and movies based on dime-novel genres.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d3">["hp_e364a8973c287ebf"]</data>
  <data key="d4">False</data>
</node>
