  <data key="d2">[{"text": "High Street starts at the Commercial Street, Fitzalan Square and Haymarket junction and runs for approximately 400 metres west to conclude near the Sheffield Cathedral where it forms a Y-junction with Fargate and Church Street.", "chunk_id": "7ad43fdb3c803322", "doc_id": "hp_a76877312504b02e"}]</data>
