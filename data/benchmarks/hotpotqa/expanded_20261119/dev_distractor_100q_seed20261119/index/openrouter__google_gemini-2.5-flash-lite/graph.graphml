  <data key="d2">[{"text": "Salvia divinorum (also known as sage of the diviners, ska maría pastora, seer's sage, yerba de la pastora and just salvia) is a psychoactive plant which can induce visions and other spiritual experiences.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d3">["hp_5b549ddaeafe9045"]</data>
