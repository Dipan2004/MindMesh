  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An updated revision of the Catan Card Game, which is a card game adaptation of The Settlers of Catan.", "chunk_id": "155359f8ca0aea2f", "doc_id": "hp_5f6bdf06a278e8d8"}]</data>
