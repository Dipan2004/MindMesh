  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Russian federal motorway that runs from St. Petersburg through Pskov until the border with Belarus.", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d2">[{"text": "Russian route R23 or Pskov Highway Russian: Федера́льная автомоби́льная доро́га Р23 «Псков» is a Russian federal motorway that runs from St.Petersburg through Pskov until the border with Belarus.", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d3">["hp_11fde9e76326875f"]</data>
  <data key="d4">False</data>
</node>
<node id="Pskov Highway">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Russian federal motorway that runs from St. Petersburg through Pskov until the border with Belarus.", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d2">[{"text": "Russian route R23 or Pskov Highway Russian: Федера́льная автомоби́льная доро́га Р23 «Псков» is a Russian federal motorway that runs from St.Petersburg through Pskov until the border with Belarus.", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d3">["hp_11fde9e76326875f"]</data>
  <data key="d4">False</data>
</node>
<node id="Pskov">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city in Russia through which the R23 highway runs.", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d2">[{"text": "Russian route R23 or Pskov Highway Russian: Федера́льная автомоби́льная доро́га Р23 «Псков» is a Russian federal motorway that runs from St.Petersburg through Pskov until the border with Belarus.", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d3">["hp_11fde9e76326875f"]</data>
  <data key="d4">False</data>
</node>
<node id="European route E95">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A European route that the R23 highway is part of.", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d2">[{"text": "It is part of European route E95.", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d3">["hp_11fde9e76326875f"]</data>
  <data key="d4">False</data>
</node>
<node id="Soviet times">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A historical period during which the R23 highway was sometimes called 'Kiev Highway'.", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d2">[{"text": "Since Soviet times it has sometimes been called \"Kiev Highway\".", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d3">["hp_11fde9e76326875f"]</data>
  <data key="d4">False</data>
</node>
<node id="Kiev Highway">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An alternative name for the R23 highway, used since Soviet times.", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d2">[{"text": "Since Soviet times it has sometimes been called \" Kiev Highway\".", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d3">["hp_11fde9e76326875f"]</data>
