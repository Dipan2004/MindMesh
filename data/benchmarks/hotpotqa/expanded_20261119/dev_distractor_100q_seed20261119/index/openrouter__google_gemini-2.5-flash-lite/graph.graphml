<node id="black hole membrane paradigm">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A simplified model in black hole theory used for visualizing and calculating quantum mechanical effects on the exterior physics of black holes.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3"}]</data>
  <data key="d2">[{"text": "In black hole theory, the black hole membrane paradigm is a simplified model, useful for visualising and calculating the effects predicted by quantum mechanics for the exterior physics of black holes, without using quantum-mechanical principles or calculations.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3"}]</data>
  <data key="d3">["hp_b71363459a2e11a3"]</data>
  <data key="d4">False</data>
</node>
<node id="quantum mechanics">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A fundamental theory in physics that provides a description of the physical properties of nature at the scale of atoms and subatomic particles.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3"}]</data>
  <data key="d2">[{"text": "In black hole theory, the black hole membrane paradigm is a simplified model, useful for visualising and calculating the effects predicted by quantum mechanics for the exterior physics of black holes, without using quantum-mechanical principles or calculations.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3"}]</data>
  <data key="d3">["hp_b71363459a2e11a3"]</data>
  <data key="d4">False</data>
</node>
<node id="Kip S. Thorne">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "One of the creators of the black hole membrane paradigm approach to the theory of black holes.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3"}]</data>
  <data key="d2">[{"text": "This approach to the theory of black holes was created by Kip S. Thorne, R. H. Price and D. A. Macdonald.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3"}]</data>
  <data key="d3">["hp_b71363459a2e11a3"]</data>
  <data key="d4">False</data>
</node>
<node id="R. H. Price">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "One of the creators of the black hole membrane paradigm approach to the theory of black holes.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3"}]</data>
  <data key="d2">[{"text": "This approach to the theory of black holes was created by Kip S. Thorne, R. H. Price and D. A. Macdonald.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3"}]</data>
  <data key="d3">["hp_b71363459a2e11a3"]</data>
  <data key="d4">False</data>
</node>
<node id="D. A. Macdonald">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "One of the creators of the black hole membrane paradigm approach to the theory of black holes.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3"}]</data>
  <data key="d2">[{"text": "This approach to the theory of black holes was created by Kip S. Thorne, R. H. Price and D. A. Macdonald.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3"}]</data>
