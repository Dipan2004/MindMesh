<node id="Beyond Outrage">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A 2012 film directed by Kitano, which Outrage Coda is a sequel to.", "chunk_id": "b645440e66e580ca", "doc_id": "hp_b8efddf6bd2e02c9"}]</data>
  <data key="d2">[{"text": "It is a sequel to Kitano's 2012 film, \"Beyond Outrage\", and completes Kitano's Outrage trilogy started in 2010.", "chunk_id": "b645440e66e580ca", "doc_id": "hp_b8efddf6bd2e02c9"}]</data>
