<node id="Sire Records">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A record label with which Madonna signed a recording contract.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d2">[{"text": "In 1982, Madonna signed a recording contract with Sire Records and released her first two singles before launching her eponymous debut album.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d3">["hp_f2eafe05aec63f00"]</data>
  <data key="d4">False</data>
</node>
<node id="Borderline">
