</node>
<node id="Yunnan">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A province in China.", "chunk_id": "f6e0ca7c3e63f550", "doc_id": "hp_0e1b00a3eeabb9ce"}, {"text": "A province in China.", "chunk_id": "0cb99287d9c2da80", "doc_id": "hp_81f5a8696daf3dee"}]</data>
  <data key="d2">[{"text": "Wanding Border Economic Cooperation Zone (WTBECZ) is a Chinese State Council-approved Industrial Park based in Wanding Town, Ruili City, Dehong Prefecture, Yunnan, China, founded in 1992 and was established to promote trade between China and Myanmar.", "chunk_id": "f6e0ca7c3e63f550", "doc_id": "hp_0e1b00a3eeabb9ce"}, {"text": "Ruili Border Economic Cooperation Zone (RLBECZ) is a Chinese State Council-approved Industrial Park based in Ruili City, Dehong Prefecture, Yunnan, China, founded in 1992 and was established to promote trade between China and Myanmar.", "chunk_id": "0cb99287d9c2da80", "doc_id": "hp_81f5a8696daf3dee"}]</data>
