<node id="film noir">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Film noir is a cinematic term used in English to describe stylish Hollywood crime dramas, particularly those that emphasize cynical attitudes and sexual content.", "chunk_id": "f4d99f18a4f175d5", "doc_id": "hp_cda28e9f1cb25d71"}]</data>
  <data key="d2">[{"text": "Cornered is a 1945 film noir starring Dick Powell and directed by Edward Dmytryk.", "chunk_id": "f4d99f18a4f175d5", "doc_id": "hp_cda28e9f1cb25d71"}]</data>
  <data key="d3">["hp_cda28e9f1cb25d71"]</data>
  <data key="d4">False</data>
</node>
