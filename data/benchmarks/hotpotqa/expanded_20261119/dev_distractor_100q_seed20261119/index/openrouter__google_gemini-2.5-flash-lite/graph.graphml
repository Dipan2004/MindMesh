<node id="Joseon naval campaigns of 1592">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "Naval campaigns conducted by Korean admiral Yi Sun-sin during Japanese invasions of Korea against the Japanese forces of Toyotomi Hideyoshi.", "chunk_id": "68610c0d374404f2", "doc_id": "hp_3358c15c20048369"}, {"text": "These were three naval campaigns conducted by Korean admiral Yi Sun-sin in 1592.", "chunk_id": "bf39df43067a80b1", "doc_id": "hp_3a9829e8fd3b32c6"}]</data>
  <data key="d2">[{"text": "The Joseon naval campaigns of 1592 was naval campaigns conducted by Korean admiral Yi Sun-sin during Japanese invasions of Korea (1592-1598) against the Japanese forces of Toyotomi Hideyoshi.", "chunk_id": "68610c0d374404f2", "doc_id": "hp_3358c15c20048369"}, {"text": "The Battle of Happo was a naval engagement on May 7, 1592, one of the three Joseon naval campaigns of 1592 conducted by Korean admiral Yi Sun-sin during Japanese invasions of Korea (1592-1598) against the Japanese forces of Toyotomi Hideyoshi.", "chunk_id": "bf39df43067a80b1", "doc_id": "hp_3a9829e8fd3b32c6"}]</data>
  <data key="d3">["hp_3358c15c20048369", "hp_3a9829e8fd3b32c6"]</data>
  <data key="d4">False</data>
</node>
<node id="Japanese invasions of Korea">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A series of invasions by Japanese forces into Korea, occurring between 1592 and 1598.", "chunk_id": "68610c0d374404f2", "doc_id": "hp_3358c15c20048369"}, {"text": "These were invasions of Korea by Japanese forces that took place from 1592 to 1598.", "chunk_id": "bf39df43067a80b1", "doc_id": "hp_3a9829e8fd3b32c6"}, {"text": "A series of conflicts that occurred in the late 16th century, documented in the Nanjung Ilgi.", "chunk_id": "99c215cb87242ef5", "doc_id": "hp_d01934819d3bc4ad"}]</data>
  <data key="d2">[{"text": "The Joseon naval campaigns of 1592 was naval campaigns conducted by Korean admiral Yi Sun-sin during Japanese invasions of Korea (1592-1598) against the Japanese forces of Toyotomi Hideyoshi.", "chunk_id": "68610c0d374404f2", "doc_id": "hp_3358c15c20048369"}, {"text": "The Battle of Happo was a naval engagement on May 7, 1592, one of the three Joseon naval campaigns of 1592 conducted by Korean admiral Yi Sun-sin during Japanese invasions of Korea (1592-1598) against the Japanese forces of Toyotomi Hideyoshi.", "chunk_id": "bf39df43067a80b1", "doc_id": "hp_3a9829e8fd3b32c6"}, {"text": "It was written between January 1, 1592 and November 17, 1598, a first person narrative of the admiral's perspective on the Japanese invasions of Korea in the late 16th century.", "chunk_id": "99c215cb87242ef5", "doc_id": "hp_d01934819d3bc4ad"}]</data>
  <data key="d3">["hp_3358c15c20048369", "hp_3a9829e8fd3b32c6", "hp_d01934819d3bc4ad"]</data>
  <data key="d4">False</data>
</node>
<node id="Toyotomi Hideyoshi">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The leader of the Japanese forces during the Japanese invasions of Korea.", "chunk_id": "68610c0d374404f2", "doc_id": "hp_3358c15c20048369"}, {"text": "Toyotomi Hideyoshi was associated with the Japanese forces during the Japanese invasions of Korea.", "chunk_id": "bf39df43067a80b1", "doc_id": "hp_3a9829e8fd3b32c6"}, {"text": "A Japanese leader who ordered the Japanese navy to change its strategy after the Battle of Hansan Island.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d2">[{"text": "The Joseon naval campaigns of 1592 was naval campaigns conducted by Korean admiral Yi Sun-sin during Japanese invasions of Korea (1592-1598) against the Japanese forces of Toyotomi Hideyoshi.", "chunk_id": "68610c0d374404f2", "doc_id": "hp_3358c15c20048369"}, {"text": "The Battle of Happo was a naval engagement on May 7, 1592, one of the three Joseon naval campaigns of 1592 conducted by Korean admiral Yi Sun-sin during Japanese invasions of Korea (1592-1598) against the Japanese forces of Toyotomi Hideyoshi.", "chunk_id": "bf39df43067a80b1", "doc_id": "hp_3a9829e8fd3b32c6"}, {"text": "After Hansan-do Toyotomi Hideyoshi ordered the Japanese navy to avoid direct engagement with the Joseon navy and instead station itself in fortifications along the coast to defend important sea lands.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d3">["hp_3358c15c20048369", "hp_3a9829e8fd3b32c6", "hp_4e9436b9b6a97ad9"]</data>
  <data key="d4">False</data>
</node>
<node id="Eulji Mundeok">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A great general in Korean History.", "chunk_id": "68610c0d374404f2", "doc_id": "hp_3358c15c20048369"}]</data>
  <data key="d2">[{"text": "These campaigns made Yi a legendary figure in Korean History on par, if not surpassing the great general Eulji Mundeok.", "chunk_id": "68610c0d374404f2", "doc_id": "hp_3358c15c20048369"}]</data>
  <data key="d3">["hp_3358c15c20048369"]</data>
  <data key="d4">False</data>
</node>
<node id="Ming China">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A region that the Japanese invasion aimed to conquer.", "chunk_id": "68610c0d374404f2", "doc_id": "hp_3358c15c20048369"}]</data>
  <data key="d2">[{"text": "The campaigns of Yi were vital in halting the Japanese invasion, which had the ultimate aim of conquering not just Korea, but Ming China as well.", "chunk_id": "68610c0d374404f2", "doc_id": "hp_3358c15c20048369"}]</data>
  <data key="d3">["hp_3358c15c20048369"]</data>
  <data key="d4">False</data>
</node>
