  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The location of the high school where the 1987 cross country team was formed.", "chunk_id": "9d28f9473b12c4d8", "doc_id": "hp_edbc6b0a7b7dac2a"}]</data>
  <data key="d2">[{"text": "Based on the true story of a 1987 cross country team from a mainly Latino high school in McFarland, California, the film stars Kevin Costner as Jim White, the school's coach, who leads the team to win a state championship.", "chunk_id": "9d28f9473b12c4d8", "doc_id": "hp_edbc6b0a7b7dac2a"}]</data>
  <data key="d3">["hp_edbc6b0a7b7dac2a"]</data>
