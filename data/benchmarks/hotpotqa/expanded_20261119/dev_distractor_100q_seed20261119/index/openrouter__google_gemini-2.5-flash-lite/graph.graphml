  <data key="d2">[{"text": "Atherosperma moschatum, the southern sassafras or blackheart sassafras, is an evergreen tree native to the cool temperate rainforests of Tasmania, Victoria, and New South Wales in Australia.", "chunk_id": "e1044c549e97de7c", "doc_id": "hp_dce12d59ef968ea1"}]</data>
