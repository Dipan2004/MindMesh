  <data key="d7">[{"text": "Oenanthe javanica, commonly Java waterdropwort, Chinese celery, Indian pennywort, water celery and water dropwort, is a plant of the water dropwort genus originating from East Asia.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2", "type": "ORIGINATED_FROM"}]</data>
