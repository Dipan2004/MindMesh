<node id="New York City Ballet">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A ballet company founded in 1948.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac"}, {"text": "An organization for which 'Le baiser de la fée' was revised in 1950.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}, {"text": "A ballet company for which \"In G Major\" was created.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d2">[{"text": "New York City Ballet (NYCB) is a ballet company founded in 1948 by choreographer George Balanchine and Lincoln Kirstein.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac"}, {"text": "Le baiser de la fée (\"The Fairy's Kiss\") is a ballet in one act and four scenes composed by Igor Stravinsky in 1928 and revised in 1950 for George Balanchine and the New York City Ballet.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}, {"text": "In G Major is a ballet made for New York City Ballet's Ravel Festival by ballet master Jerome Robbins to the composer's \"Piano Concerto in G Major\" (1928–31).", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d3">["hp_28406ea7c841b0ac", "hp_869cb734bf497707", "hp_c8a6c3f50e115d2a"]</data>
  <data key="d4">False</data>
</node>
<node id="NYCB">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An abbreviation for New York City Ballet.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac"}]</data>
  <data key="d2">[{"text": "New York City Ballet (NYCB) is a ballet company founded in 1948 by choreographer George Balanchine and Lincoln Kirstein.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac"}]</data>
  <data key="d3">["hp_28406ea7c841b0ac"]</data>
  <data key="d4">False</data>
</node>
<node id="George Balanchine">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A choreographer who co-founded the New York City Ballet.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac"}, {"text": "A recipient of the revised version of 'Le baiser de la fée' for the New York City Ballet.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}, {"text": "George Balanchine choreographed the ballet Apollo in 1928.", "chunk_id": "7d4e3a512ec3ac2c", "doc_id": "hp_9db3a175e11b24ac"}]</data>
  <data key="d2">[{"text": "New York City Ballet (NYCB) is a ballet company founded in 1948 by choreographer George Balanchine and Lincoln Kirstein.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac"}, {"text": "Le baiser de la fée (\"The Fairy's Kiss\") is a ballet in one act and four scenes composed by Igor Stravinsky in 1928 and revised in 1950 for George Balanchine and the New York City Ballet.", "chunk_id": "a78396980a135cb4", "doc_id": "hp_869cb734bf497707"}, {"text": "It was choreographed in 1928 by twenty-four-year-old George Balanchine, with the composer contributing the libretto.", "chunk_id": "7d4e3a512ec3ac2c", "doc_id": "hp_9db3a175e11b24ac"}]</data>
  <data key="d3">["hp_28406ea7c841b0ac", "hp_869cb734bf497707", "hp_9db3a175e11b24ac"]</data>
  <data key="d4">False</data>
</node>
<node id="Lincoln Kirstein">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A co-founder of the New York City Ballet.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac"}]</data>
  <data key="d2">[{"text": "New York City Ballet (NYCB) is a ballet company founded in 1948 by choreographer George Balanchine and Lincoln Kirstein.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac"}]</data>
  <data key="d3">["hp_28406ea7c841b0ac"]</data>
  <data key="d4">False</data>
</node>
<node id="Léon Barzin">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The first music director of the New York City Ballet.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac"}]</data>
  <data key="d2">[{"text": "Léon Barzin was the company's first music director.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac"}]</data>
  <data key="d3">["hp_28406ea7c841b0ac"]</data>
  <data key="d4">False</data>
</node>
<node id="Jerome Robbins">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A founding choreographer of the New York City Ballet.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac"}, {"text": "The ballet master who created \"In G Major\".", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d2">[{"text": "Balanchine and Jerome Robbins are considered the founding choreographers of the company.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac"}, {"text": "In G Major is a ballet made for New York City Ballet's Ravel Festival by ballet master Jerome Robbins to the composer's \"Piano Concerto in G Major\" (1928–31).", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d3">["hp_28406ea7c841b0ac", "hp_c8a6c3f50e115d2a"]</data>
  <data key="d4">False</data>
</node>
<node id="Producing Company of the School of American Ballet">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An earlier troupe that grew into the New York City Ballet.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac"}]</data>
  <data key="d2">[{"text": "City Ballet grew out of earlier troupes: the Producing Company of the School of American Ballet, 1934; the American Ballet, 1935, and Ballet Caravan, 1936, which merged into American Ballet Caravan, 1941; and directly from the Ballet Society, 1946.", "chunk_id": "667cc3f7eec09440", "doc_id": "hp_28406ea7c841b0ac"}]</data>
  <data key="d3">["hp_28406ea7c841b0ac"]</data>
  <data key="d4">False</data>
</node>
