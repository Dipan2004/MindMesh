<node id="True Blue">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Madonna's third studio album, from which the title track's music video was created via a contest.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d2">[{"text": "With the title track from her third studio album \"True Blue\" (1986), Madonna's impact on MTV and popular music was established when a contest entitled \"Making My Video\", was held to create a music video for the song.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d3">["hp_f2eafe05aec63f00"]</data>
  <data key="d4">False</data>
</node>
<node id="Making My Video">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A contest held to create a music video for the title track of Madonna's album \"True Blue\".", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d2">[{"text": "With the title track from her third studio album \"True Blue\" (1986), Madonna's impact on MTV and popular music was established when a contest entitled \"Making My Video\", was held to create a music video for the song.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d3">["hp_f2eafe05aec63f00"]</data>
  <data key="d4">False</data>
</node>
<node id="La Isla Bonita">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A music video released in 1987 that showed Madonna's fascination with Hispanic culture and religious symbolism.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d2">[{"text": "\"La Isla Bonita\" and \"Who's That Girl\", both released in 1987, showed Madonna's fascination with Hispanic culture and religious symbolism.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d3">["hp_f2eafe05aec63f00"]</data>
  <data key="d4">False</data>
</node>
<node id="Who's That Girl">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A music video released in 1987 that showed Madonna's fascination with Hispanic culture and religious symbolism.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d2">[{"text": "\"La Isla Bonita\" and \"Who's That Girl\", both released in 1987, showed Madonna's fascination with Hispanic culture and religious symbolism.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d3">["hp_f2eafe05aec63f00"]</data>
  <data key="d4">False</data>
</node>
<node id="Like a Prayer">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A music video released in 1989 that caused strong reactions due to its controversial imagery.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d2">[{"text": "In 1989, the video of \"Like a Prayer\" portrayed her dancing in front of burning crosses, receiving stigmata, kissing a black saint and having sex with him in a church altar.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d3">["hp_f2eafe05aec63f00"]</data>
  <data key="d4">False</data>
</node>
<node id="Express Yourself">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A music video released in 1989 that was critically appreciated for its positive feminist themes.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d2">[{"text": "\"Express Yourself\" released the same year was critically appreciated for its positive feminist themes.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d3">["hp_f2eafe05aec63f00"]</data>
  <data key="d4">False</data>
</node>
<node id="Brazilian writer">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A writer from Brazil.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c"}]</data>
  <data key="d2">[{"text": "Jorge Leal Amado de Faria (] , 10 August 1912 – 6 August 2001) was a Brazilian writer of the modernist school.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c"}]</data>
  <data key="d3">["hp_f34261cdc3c2359c"]</data>
  <data key="d4">False</data>
</node>
<node id="modernist school">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A literary school associated with modernism.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c"}]</data>
  <data key="d2">[{"text": "Jorge Leal Amado de Faria (] , 10 August 1912 – 6 August 2001) was a Brazilian writer of the modernist school.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c"}]</data>
  <data key="d3">["hp_f34261cdc3c2359c"]</data>
  <data key="d4">False</data>
</node>
<node id="modern Brazilian writers">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Writers from Brazil who are considered modern.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c"}]</data>
  <data key="d2">[{"text": "He remains the best known of modern Brazilian writers, with his work having been translated into some 49 languages and popularized in film, notably \"Dona Flor and Her Two Husbands\" in 1978.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c"}]</data>
  <data key="d3">["hp_f34261cdc3c2359c"]</data>
  <data key="d4">False</data>
</node>
<node id="Dona Flor and Her Two Husbands">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A film popularized from Jorge Amado's work.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c"}]</data>
  <data key="d2">[{"text": "He remains the best known of modern Brazilian writers, with his work having been translated into some 49 languages and popularized in film, notably \"Dona Flor and Her Two Husbands\" in 1978.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c"}]</data>
  <data key="d3">["hp_f34261cdc3c2359c"]</data>
  <data key="d4">False</data>
</node>
<node id="Mestiço Brazil">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A term referring to Brazil with a mixed racial and cultural heritage.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c"}]</data>
  <data key="d2">[{"text": "His work reflects the image of a Mestiço Brazil and is marked by religious syncretism.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c"}]</data>
  <data key="d3">["hp_f34261cdc3c2359c"]</data>
  <data key="d4">False</data>
</node>
<node id="religious syncretism">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The merging of different religious beliefs and practices.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c"}]</data>
  <data key="d2">[{"text": "His work reflects the image of a Mestiço Brazil and is marked by religious syncretism.", "chunk_id": "6ab1b1b0f987ea76", "doc_id": "hp_f34261cdc3c2359c"}]</data>
  <data key="d3">["hp_f34261cdc3c2359c"]</data>
  <data key="d4">False</data>
</node>
<node id="Catan: Seafarers">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An expansion of the board game \"The Settlers of Catan\" for three to four players.", "chunk_id": "4604dd9ff3227806", "doc_id": "hp_f44b12ff517dfad8"}]</data>
  <data key="d2">[{"text": "Catan: Seafarers, or Seafarers of Catan in older editions, (German: \"Die Seefahrer von Catan\" ) is an expansion of the board game \"The Settlers of Catan\" for three to four players (five-to-six-player play is also possible with both of the respective five-to-six-player extensions).", "chunk_id": "4604dd9ff3227806", "doc_id": "hp_f44b12ff517dfad8"}]</data>
  <data key="d3">["hp_f44b12ff517dfad8"]</data>
  <data key="d4">False</data>
</node>
