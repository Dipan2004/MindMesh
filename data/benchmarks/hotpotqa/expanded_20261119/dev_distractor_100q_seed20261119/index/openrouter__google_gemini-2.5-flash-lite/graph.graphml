  <data key="d5">["ASSOCIATED_WITH"]</data>
  <data key="d6">Morchella ulmaria is often associated with Liriodendron tulipifera (the American tulip tree).</data>
  <data key="d7">[{"text": "The species occurs in the forests of Midwestern North America, often associated with white ash (\"Fraxinus americana\"), the American tulip tree (\"Liriodendron tulipifera\") or species of maple or elm.", "chunk_id": "90e3a51e13c6358a", "doc_id": "hp_a1c843f7fa58c1d3", "type": "ASSOCIATED_WITH"}]</data>
  <data key="d8">hp_a1c843f7fa58c1d3</data>
</edge>
<edge source="Morchella ulmaria" target="M. castanea">
  <data key="d5">["RELATED_TO"]</data>
  <data key="d6">Morchella ulmaria is closely related to M. castanea.</data>
  <data key="d7">[{"text": "It is closely related to \"M. castanea\" and 2 unnamed species from Asia.", "chunk_id": "90e3a51e13c6358a", "doc_id": "hp_a1c843f7fa58c1d3", "type": "RELATED_TO"}]</data>
  <data key="d8">hp_a1c843f7fa58c1d3</data>
</edge>
<edge source="Morchella cryptica" target="Michael Kuo">
  <data key="d5">["DESCRIBED_BY"]</data>
  <data key="d6">Michael Kuo and colleagues described Morchella cryptica.</data>
  <data key="d7">[{"text": "Later in the same year, Michael Kuo and colleagues described \"Morchella cryptica\", which is a junior synonym of \"M. ulmaria\".", "chunk_id": "90e3a51e13c6358a", "doc_id": "hp_a1c843f7fa58c1d3", "type": "DESCRIBED_BY"}]</data>
