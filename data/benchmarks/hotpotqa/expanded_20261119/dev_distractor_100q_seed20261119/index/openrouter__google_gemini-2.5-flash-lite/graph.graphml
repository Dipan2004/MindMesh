  <data key="d8">hp_b6c911ef5c542694</data>
</edge>
<edge source="black hole membrane paradigm" target="black hole">
  <data key="d5">["PART_OF"]</data>
  <data key="d6">The black hole membrane paradigm is a model within the theory of black holes.</data>
  <data key="d7">[{"text": "In black hole theory, the black hole membrane paradigm is a simplified model, useful for visualising and calculating the effects predicted by quantum mechanics for the exterior physics of black holes, without using quantum-mechanical principles or calculations.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3", "type": "PART_OF"}]</data>
  <data key="d8">hp_b71363459a2e11a3</data>
</edge>
<edge source="black hole membrane paradigm" target="quantum mechanics">
  <data key="d5">["USED_FOR"]</data>
  <data key="d6">The black hole membrane paradigm is useful for visualizing and calculating effects predicted by quantum mechanics.</data>
  <data key="d7">[{"text": "In black hole theory, the black hole membrane paradigm is a simplified model, useful for visualising and calculating the effects predicted by quantum mechanics for the exterior physics of black holes, without using quantum-mechanical principles or calculations.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3", "type": "USED_FOR"}]</data>
