  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Blue Nile is a band whose song \"The Downtown Lights\" was covered on the album.", "chunk_id": "ee3812aae430f03c", "doc_id": "hp_56786c080440345c"}]</data>
  <data key="d2">[{"text": "The album includes covers of Bob Dylan's \"Sweetheart Like You\" and The Blue Nile's \"The Downtown Lights\".", "chunk_id": "ee3812aae430f03c", "doc_id": "hp_56786c080440345c"}]</data>
  <data key="d3">["hp_56786c080440345c"]</data>
