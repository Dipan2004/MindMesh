  <data key="d2">[{"text": "The breed is used for hunting in packs and descends from the old Hound of Saintonge type of large hunting dog.", "chunk_id": "c2eabaef2329cb08", "doc_id": "hp_6fcdf37bec724a84"}, {"text": "The breed is used for hunting in packs and descends from the old Hound of Saintonge type of large hunting dog.", "chunk_id": "de5a56171a2e0728", "doc_id": "hp_7ed6a2b681322402"}]</data>
