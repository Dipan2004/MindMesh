</node>
<node id="Governor of New Mexico">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The person who serves as the governor of the state of New Mexico.", "chunk_id": "8f43bdf21d1f96f0", "doc_id": "hp_c748835c7175602a"}]</data>
  <data key="d2">[{"text": "The New Mexico Governor's Residence is the official residence of the Governor of New Mexico and his or her family.", "chunk_id": "8f43bdf21d1f96f0", "doc_id": "hp_c748835c7175602a"}]</data>
  <data key="d3">["hp_c748835c7175602a"]</data>
