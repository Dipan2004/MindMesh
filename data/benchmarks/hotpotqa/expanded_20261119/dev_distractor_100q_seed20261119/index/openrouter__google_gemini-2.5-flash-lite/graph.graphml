  <data key="d2">[{"text": "The single \"Starry Eyed Surprise\", a collaboration between Paul Oakenfold and Shellshock that was originally released in 2002 on Oakenfold's album \"Bunkka\", also appears on this CD.", "chunk_id": "fb6d4773c5a537c1", "doc_id": "hp_5dba59e0680b3340"}, {"text": "It was released in July 2002 as the second single from his album \"Bunkka\".", "chunk_id": "0e3a5e1368eb79fe", "doc_id": "hp_c1e92b892fa0c36f"}]</data>
