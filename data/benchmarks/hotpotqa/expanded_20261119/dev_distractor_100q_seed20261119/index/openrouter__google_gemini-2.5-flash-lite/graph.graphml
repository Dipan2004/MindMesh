  <data key="d2">[{"text": "The Grand Anglo-Français Blanc et Orange (FCI No.324) translated into English as the Great Anglo-French White and Orange Hound, is a breed of dog used in hunting as a scenthound, usually in packs.", "chunk_id": "64230ad5f64c09df", "doc_id": "hp_1098786addde3675"}]</data>
