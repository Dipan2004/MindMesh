  <data key="d6">The May Department Stores Company was formerly headquartered in St. Louis.</data>
  <data key="d7">[{"text": "The May Department Stores Company was an American department store holding company, formerly headquartered in downtown St. Louis, Missouri.", "chunk_id": "7eaecb7c8ff690f9", "doc_id": "hp_537a416acef9e8ad", "type": "LOCATED_IN"}]</data>
