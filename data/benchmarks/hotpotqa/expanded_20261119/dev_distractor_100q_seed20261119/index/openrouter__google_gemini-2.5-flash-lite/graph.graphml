  <data key="d2">[{"text": "The Braques français are hunting dogs, from a very old type of gun dog used for pointing the location of game birds for a hunter.", "chunk_id": "27ab68d978f43c6c", "doc_id": "hp_cdc7b0cc951d083b"}]</data>
