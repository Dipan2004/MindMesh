<node id="operetta-musical">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A genre of musical theater that is sung throughout, exemplified by Une chambre en ville and The Umbrellas of Cherbourg.", "chunk_id": "79ecca5757e35f6c", "doc_id": "hp_a7f67f1b79caebb6"}]</data>
  <data key="d2">[{"text": "Like Demy's most famous film, \"The Umbrellas of Cherbourg\", it is an operetta-musical in which every line of dialogue is sung.", "chunk_id": "79ecca5757e35f6c", "doc_id": "hp_a7f67f1b79caebb6"}]</data>
  <data key="d3">["hp_a7f67f1b79caebb6"]</data>
  <data key="d4">False</data>
</node>
