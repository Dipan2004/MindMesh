<node id="MAI Systems Corp. v. Peak Computer, Inc.">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A legal case heard by the United States Court of Appeals for the Ninth Circuit concerning copyright violation.", "chunk_id": "2f0d266511dd6551", "doc_id": "hp_94b359165f10bad8"}]</data>
  <data key="d2">[{"text": "MAI Systems Corp. v. Peak Computer, Inc., 991 F.2d 511 (9th Cir. 1993), was a case heard by the United States Court of Appeals for the Ninth Circuit which addressed the issue of whether the loading of software programs into Random-Access Memory (RAM) by a computer repair technician during maintenance constituted an unauthorized software copy and therefore a copyright violation.", "chunk_id": "2f0d266511dd6551", "doc_id": "hp_94b359165f10bad8"}]</data>
  <data key="d3">["hp_94b359165f10bad8"]</data>
  <data key="d4">False</data>
</node>
<node id="United States Court of Appeals for the Ninth Circuit">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A federal court that heard the case MAI Systems Corp. v. Peak Computer, Inc.", "chunk_id": "2f0d266511dd6551", "doc_id": "hp_94b359165f10bad8"}]</data>
  <data key="d2">[{"text": "MAI Systems Corp. v. Peak Computer, Inc., 991 F.2d 511 (9th Cir. 1993), was a case heard by the United States Court of Appeals for the Ninth Circuit which addressed the issue of whether the loading of software programs into Random-Access Memory (RAM) by a computer repair technician during maintenance constituted an unauthorized software copy and therefore a copyright violation.", "chunk_id": "2f0d266511dd6551", "doc_id": "hp_94b359165f10bad8"}]</data>
  <data key="d3">["hp_94b359165f10bad8"]</data>
  <data key="d4">False</data>
</node>
<node id="Random-Access Memory (RAM)">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A type of computer memory where software programs were loaded during maintenance.", "chunk_id": "2f0d266511dd6551", "doc_id": "hp_94b359165f10bad8"}]</data>
  <data key="d2">[{"text": "MAI Systems Corp. v. Peak Computer, Inc., 991 F.2d 511 (9th Cir. 1993), was a case heard by the United States Court of Appeals for the Ninth Circuit which addressed the issue of whether the loading of software programs into Random-Access Memory (RAM) by a computer repair technician during maintenance constituted an unauthorized software copy and therefore a copyright violation.", "chunk_id": "2f0d266511dd6551", "doc_id": "hp_94b359165f10bad8"}]</data>
  <data key="d3">["hp_94b359165f10bad8"]</data>
  <data key="d4">False</data>
</node>
<node id="copyright violation">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The unauthorized copying of software programs.", "chunk_id": "2f0d266511dd6551", "doc_id": "hp_94b359165f10bad8"}]</data>
  <data key="d2">[{"text": "MAI Systems Corp. v. Peak Computer, Inc., 991 F.2d 511 (9th Cir. 1993), was a case heard by the United States Court of Appeals for the Ninth Circuit which addressed the issue of whether the loading of software programs into Random-Access Memory (RAM) by a computer repair technician during maintenance constituted an unauthorized software copy and therefore a copyright violation.", "chunk_id": "2f0d266511dd6551", "doc_id": "hp_94b359165f10bad8"}]</data>
  <data key="d3">["hp_94b359165f10bad8"]</data>
  <data key="d4">False</data>
</node>
<node id="United States Congress">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The legislative body that enacted an amendment to overrule a specific court holding.", "chunk_id": "2f0d266511dd6551", "doc_id": "hp_94b359165f10bad8"}]</data>
  <data key="d2">[{"text": "The court held that it did, although the United States Congress subsequently enacted an amendment to to specifically overrule this holding in the circumstances of computer repair.", "chunk_id": "2f0d266511dd6551", "doc_id": "hp_94b359165f10bad8"}]</data>
  <data key="d3">["hp_94b359165f10bad8"]</data>
  <data key="d4">False</data>
</node>
