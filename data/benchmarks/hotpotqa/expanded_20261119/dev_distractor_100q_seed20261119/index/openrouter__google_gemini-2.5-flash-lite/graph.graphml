  <data key="d2">[{"text": "The Retuertas horse, Spanish: Caballo de las Retuertas or Caballo de las Retuertas de Doñana , is a rare breed of horse indigenous to the Andalusia region of Spain.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d3">["hp_f5a05d2ab71d3e1b"]</data>
  <data key="d4">False</data>
</node>
<node id="Andalusia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Andalusia is a region in Spain where the Retuertas horse is indigenous.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d2">[{"text": "The Retuertas horse, Spanish: Caballo de las Retuertas or Caballo de las Retuertas de Doñana , is a rare breed of horse indigenous to the Andalusia region of Spain.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d3">["hp_f5a05d2ab71d3e1b"]</data>
  <data key="d4">False</data>
</node>
<node id="ancient Iberian horses">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Ancient Iberian horses are believed to be closely resembled by the Retuertas horse and populated Spain before domestication.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d2">[{"text": "It is said to closely resemble the ancient Iberian horses that populated Spain before being domesticated.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d3">["hp_f5a05d2ab71d3e1b"]</data>
  <data key="d4">False</data>
</node>
<node id="Doñana National Park">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Doñana National Park is a location in Spain where the Retuertas horse is now found.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d2">[{"text": "It is now found only in the Doñana National Park in the provinces of Huelva and Sevilla, and in The Biological Reserve \"Campanarios de Azaba\" in Espeja (Salamanca province) a part of which is the research reserve of the Consejo Superior de Investigaciones Científicas, the Spanish National Research Council.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d3">["hp_f5a05d2ab71d3e1b"]</data>
  <data key="d4">False</data>
</node>
<node id="Huelva">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Huelva is a province in Spain where the Retuertas horse is found within Doñana National Park.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d2">[{"text": "It is now found only in the Doñana National Park in the provinces of Huelva and Sevilla, and in The Biological Reserve \"Campanarios de Azaba\" in Espeja (Salamanca province) a part of which is the research reserve of the Consejo Superior de Investigaciones Científicas, the Spanish National Research Council.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d3">["hp_f5a05d2ab71d3e1b"]</data>
  <data key="d4">False</data>
</node>
<node id="Sevilla">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Sevilla is a province in Spain where the Retuertas horse is found within Doñana National Park.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d2">[{"text": "It is now found only in the Doñana National Park in the provinces of Huelva and Sevilla, and in The Biological Reserve \"Campanarios de Azaba\" in Espeja (Salamanca province) a part of which is the research reserve of the Consejo Superior de Investigaciones Científicas, the Spanish National Research Council.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
