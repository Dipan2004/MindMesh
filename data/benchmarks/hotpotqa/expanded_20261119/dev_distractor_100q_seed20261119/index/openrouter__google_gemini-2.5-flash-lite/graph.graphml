<node id="Sixth Hill">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Sixth Hill is a location in Istanbul near the highest point of the city.", "chunk_id": "2b745e897c8565f6", "doc_id": "hp_a52cead96a6e20c2"}]</data>
  <data key="d2">[{"text": "Located on the peak of the Sixth Hill near the highest point of the city, the mosque is a prominent landmark in Istanbul.", "chunk_id": "2b745e897c8565f6", "doc_id": "hp_a52cead96a6e20c2"}]</data>
