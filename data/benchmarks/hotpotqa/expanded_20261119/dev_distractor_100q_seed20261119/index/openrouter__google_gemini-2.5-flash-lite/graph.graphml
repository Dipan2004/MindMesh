  <data key="d2">[{"text": "The Bottle tree (\"Pachypodium lealii\" Welw.) is a species of plant included in the \"genus\" \"Pachypodium\".", "chunk_id": "6be220bfddc2114d", "doc_id": "hp_c0400b095de3dd7b"}]</data>
