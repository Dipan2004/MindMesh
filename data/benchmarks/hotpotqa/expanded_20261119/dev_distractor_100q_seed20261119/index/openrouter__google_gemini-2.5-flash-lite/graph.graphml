</node>
<node id="science and technology">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Advances in these fields are the primary focus of the documentary series 'The Day the Universe Changed'.", "chunk_id": "641da45da986e5ce", "doc_id": "hp_58b33fe59f58c1ed"}]</data>
  <data key="d2">[{"text": "The series' primary focus is on the effect of advances in science and technology on western society in its philosophical aspects.", "chunk_id": "641da45da986e5ce", "doc_id": "hp_58b33fe59f58c1ed"}]</data>
  <data key="d3">["hp_58b33fe59f58c1ed"]</data>
  <data key="d4">False</data>
</node>
<node id="western society">
  <data key="d0">OTHER</data>
