  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "An ancient Scottish custom still observed at Burghead.", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d2">[{"text": "Burning the clavie is an ancient Scottish custom still observed at Burghead, a fishing village on the Moray Firth.", "chunk_id": "297c3e9ada099ad7", "doc_id": "hp_d679e270f6739fa5"}]</data>
  <data key="d3">["hp_d679e270f6739fa5"]</data>
