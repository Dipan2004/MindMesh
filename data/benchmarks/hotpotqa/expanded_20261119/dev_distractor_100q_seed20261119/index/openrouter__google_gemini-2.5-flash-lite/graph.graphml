  <data key="d7">[{"text": "Penicillium restrictum is a species of the genus of \"Penicillium\" which was isolated from the stems of the plant Silybum marianum.", "chunk_id": "bd4cd076593153eb", "doc_id": "hp_01116d3918922396", "type": "PART_OF"}]</data>
