<node id="Injaz">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Injaz is a female dromedary camel, credited with being the world's first cloned camel.", "chunk_id": "a0eaa1f65d7ed5d5", "doc_id": "hp_b2592bcfce5865bb"}]</data>
  <data key="d2">[{"text": "Injaz (Arabic: إنجاز‎ ‎ , meaning \"achievement\"; born April 8, 2009) is a female dromedary camel, credited with being the world's first cloned camel.", "chunk_id": "a0eaa1f65d7ed5d5", "doc_id": "hp_b2592bcfce5865bb"}]</data>
  <data key="d3">["hp_b2592bcfce5865bb"]</data>
  <data key="d4">False</data>
</node>
<node id="Dr. Nisar Ahmad Wani">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Dr. Nisar Ahmad Wani is a reproductive biologist and head of the research team at the Camel Reproduction Center.", "chunk_id": "a0eaa1f65d7ed5d5", "doc_id": "hp_b2592bcfce5865bb"}]</data>
  <data key="d2">[{"text": "Dr. Nisar Ahmad Wani, a reproductive biologist and head of the research team at the Camel Reproduction Center in Dubai, United Arab Emirates, announced on April 14, 2009, that the cloned camel was born after an \"uncomplicated\" gestation of 378 days.", "chunk_id": "a0eaa1f65d7ed5d5", "doc_id": "hp_b2592bcfce5865bb"}]</data>
  <data key="d3">["hp_b2592bcfce5865bb"]</data>
  <data key="d4">False</data>
</node>
<node id="Camel Reproduction Center">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Camel Reproduction Center is where the research team led by Dr. Nisar Ahmad Wani was based.", "chunk_id": "a0eaa1f65d7ed5d5", "doc_id": "hp_b2592bcfce5865bb"}]</data>
  <data key="d2">[{"text": "Dr. Nisar Ahmad Wani, a reproductive biologist and head of the research team at the Camel Reproduction Center in Dubai, United Arab Emirates, announced on April 14, 2009, that the cloned camel was born after an \"uncomplicated\" gestation of 378 days.", "chunk_id": "a0eaa1f65d7ed5d5", "doc_id": "hp_b2592bcfce5865bb"}]</data>
  <data key="d3">["hp_b2592bcfce5865bb"]</data>
  <data key="d4">False</data>
</node>
