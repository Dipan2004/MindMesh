<node id="Ontario">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A province in Canada, where Hamilton is located and the Allan Cup Hockey league operates.", "chunk_id": "c0af2c2509f54ce5", "doc_id": "hp_2072dc38221ffe1f"}, {"text": "A province in Canada, where Toronto and Notre Dame High School are located.", "chunk_id": "59f1fceefedd98a3", "doc_id": "hp_97bc21ad7dfa71c1"}, {"text": "A province in Canada.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}]</data>
  <data key="d2">[{"text": "The Hamilton Steelhawks are a senior-level ice hockey team based in Hamilton, Ontario, Canada.", "chunk_id": "c0af2c2509f54ce5", "doc_id": "hp_2072dc38221ffe1f"}, {"text": "Notre Dame High School (also known as NDHS, Notre Dame H.S., Notre Dame, or simply Dame) is an all-girls Roman Catholic secondary school in Toronto, Ontario, Canada.", "chunk_id": "59f1fceefedd98a3", "doc_id": "hp_97bc21ad7dfa71c1"}, {"text": "The championship was played at BMO Field in Toronto, Ontario, Canada on November 21, 2010.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}]</data>
  <data key="d3">["hp_2072dc38221ffe1f", "hp_97bc21ad7dfa71c1", "hp_b8c5eba035057a5e"]</data>
  <data key="d4">False</data>
</node>
<node id="Canada">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A country where Hamilton and Ontario are located.", "chunk_id": "c0af2c2509f54ce5", "doc_id": "hp_2072dc38221ffe1f"}, {"text": "The country represented by the Toronto National Sea Fleas in the 1933 World Ice Hockey Championships.", "chunk_id": "fecd6ff50a6d6817", "doc_id": "hp_2509ce49ef3c84a3"}, {"text": "A country in North America.", "chunk_id": "da467109040d67f5", "doc_id": "hp_2ea484cb715401dc"}, {"text": "A country in North America.", "chunk_id": "1221adbf4371c7a0", "doc_id": "hp_60e7d9ac9e049733"}, {"text": "A country where Toronto and Ontario are located.", "chunk_id": "59f1fceefedd98a3", "doc_id": "hp_97bc21ad7dfa71c1"}, {"text": "A country in North America.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}, {"text": "Canada is a country where Davey Tree provides services.", "chunk_id": "a9e806e2d99c31d9", "doc_id": "hp_d2d8272fe5506239"}, {"text": "Canada is a country that was represented at the 1933 World Ice Hockey Championships.", "chunk_id": "4bbb68cf46284da6", "doc_id": "hp_f18e54e3d937fb49"}]</data>
  <data key="d2">[{"text": "The Hamilton Steelhawks are a senior-level ice hockey team based in Hamilton, Ontario, Canada.", "chunk_id": "c0af2c2509f54ce5", "doc_id": "hp_2072dc38221ffe1f"}, {"text": "The Toronto National Sea Fleas were a senior men's amateur ice hockey team that won the 1932 Allan Cup, and also represented Canada at the 1933 World Ice Hockey Championships held in Prague, Czechoslovakia where the team lost the final game to the United States in overtime to capture the silver medal for Canada.", "chunk_id": "fecd6ff50a6d6817", "doc_id": "hp_2509ce49ef3c84a3"}, {"text": "Carnival Eats is a Canadian television series about various eating establishments at carnivals in Canada and the United States.", "chunk_id": "da467109040d67f5", "doc_id": "hp_2ea484cb715401dc"}, {"text": "The 2010 Major League Soccer season was the 98th season of FIFA-sanctioned soccer, the 32nd with a national first-division league, in the United States and Canada, and the 15th in MLS history.", "chunk_id": "1221adbf4371c7a0", "doc_id": "hp_60e7d9ac9e049733"}, {"text": "Notre Dame High School (also known as NDHS, Notre Dame H.S., Notre Dame, or simply Dame) is an all-girls Roman Catholic secondary school in Toronto, Ontario, Canada.", "chunk_id": "59f1fceefedd98a3", "doc_id": "hp_97bc21ad7dfa71c1"}, {"text": "The championship was played at BMO Field in Toronto, Ontario, Canada on November 21, 2010.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}, {"text": "The Davey Tree Expert Company, also known as Davey Tree, is an American multinational employee-owned corporation that provides tree, utility, lawn care, and environmental consulting services in the green industry throughout the United States and Canada.", "chunk_id": "a9e806e2d99c31d9", "doc_id": "hp_d2d8272fe5506239"}, {"text": "This team went on to represent Canada at the 1933 World Ice Hockey Championships held in Prague, Czechoslovakia where the team lost the final game to the United States in overtime to capture the silver medal for Canada.", "chunk_id": "4bbb68cf46284da6", "doc_id": "hp_f18e54e3d937fb49"}]</data>
  <data key="d3">["hp_2072dc38221ffe1f", "hp_2509ce49ef3c84a3", "hp_2ea484cb715401dc", "hp_60e7d9ac9e049733", "hp_97bc21ad7dfa71c1", "hp_b8c5eba035057a5e", "hp_d2d8272fe5506239", "hp_f18e54e3d937fb49"]</data>
  <data key="d4">False</data>
</node>
<node id="Allan Cup Hockey">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A league within the Ontario Hockey Association for senior ice hockey.", "chunk_id": "c0af2c2509f54ce5", "doc_id": "hp_2072dc38221ffe1f"}, {"text": "The top tier Canadian Senior ice hockey league in the province of Ontario.", "chunk_id": "8a85ab40137c3013", "doc_id": "hp_c2681de15433dd19"}]</data>
  <data key="d2">[{"text": "The team is a member of the Allan Cup Hockey league of the Ontario Hockey Association, the top tier of senior ice hockey in Ontario, and eligible for the Allan Cup national championship.", "chunk_id": "c0af2c2509f54ce5", "doc_id": "hp_2072dc38221ffe1f"}, {"text": "Allan Cup Hockey (ACH) is the top tier Canadian Senior ice hockey league in the province of Ontario.", "chunk_id": "8a85ab40137c3013", "doc_id": "hp_c2681de15433dd19"}]</data>
  <data key="d3">["hp_2072dc38221ffe1f", "hp_c2681de15433dd19"]</data>
  <data key="d4">False</data>
</node>
<node id="Ontario Hockey Association">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An organization that includes the Allan Cup Hockey league as its top tier of senior ice hockey in Ontario.", "chunk_id": "c0af2c2509f54ce5", "doc_id": "hp_2072dc38221ffe1f"}, {"text": "An organization that Allan Cup Hockey is a member of.", "chunk_id": "8a85ab40137c3013", "doc_id": "hp_c2681de15433dd19"}]</data>
  <data key="d2">[{"text": "The team is a member of the Allan Cup Hockey league of the Ontario Hockey Association, the top tier of senior ice hockey in Ontario, and eligible for the Allan Cup national championship.", "chunk_id": "c0af2c2509f54ce5", "doc_id": "hp_2072dc38221ffe1f"}, {"text": "As a member of the Ontario Hockey Association and Hockey Canada, the league's champion contends for the famed Allan Cup each year.", "chunk_id": "8a85ab40137c3013", "doc_id": "hp_c2681de15433dd19"}]</data>
  <data key="d3">["hp_2072dc38221ffe1f", "hp_c2681de15433dd19"]</data>
  <data key="d4">False</data>
</node>
