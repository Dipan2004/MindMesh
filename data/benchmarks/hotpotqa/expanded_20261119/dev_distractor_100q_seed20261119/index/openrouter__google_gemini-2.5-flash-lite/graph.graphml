<node id="laurel">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Laurel is a plant whose leaves resemble those of Hakea laurina.", "chunk_id": "eaaf032797ec83a6", "doc_id": "hp_e771d223ba00e086"}]</data>
  <data key="d2">[{"text": "The specific epithet, derived from the Latin \"laurus\", is given for the resemblance to the leaves of laurel.", "chunk_id": "eaaf032797ec83a6", "doc_id": "hp_e771d223ba00e086"}]</data>
