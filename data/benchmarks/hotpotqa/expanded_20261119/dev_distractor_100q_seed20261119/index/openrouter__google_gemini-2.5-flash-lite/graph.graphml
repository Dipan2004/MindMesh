<node id="Matt Tong">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Matt Tong is a former member of the band Bloc Party.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
  <data key="d2">[{"text": "Former members Matt Tong and Gordon Moakes left the band in 2013 and 2015 respectively.", "chunk_id": "71ac561d76e09011", "doc_id": "hp_69c70a8b17b9692e"}]</data>
  <data key="d3">["hp_69c70a8b17b9692e"]</data>
