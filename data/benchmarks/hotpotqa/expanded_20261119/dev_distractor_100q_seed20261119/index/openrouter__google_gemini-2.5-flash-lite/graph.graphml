  <data key="d5">["DIVIDED_BY"]</data>
  <data key="d6">The Oujiang River divides the Yandang Mountains into two parts.</data>
  <data key="d7">[{"text": "The mountain range is divided in two by the Oujiang River, the two parts being the North Yandang and South Yandang.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26", "type": "DIVIDED_BY"}]</data>
