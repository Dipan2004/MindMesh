  <data key="d7">[{"text": "British pop singer Kim Wilde covered \"You Keep Me Hangin' On\" in 1986, bumping it back to number one on the \"Billboard\" Hot 100 in June 1987.", "chunk_id": "b4d3f874cde3d202", "doc_id": "hp_d679581e3707876c", "type": "CHARTED_ON"}]</data>
  <data key="d8">hp_d679581e3707876c</data>
</edge>
