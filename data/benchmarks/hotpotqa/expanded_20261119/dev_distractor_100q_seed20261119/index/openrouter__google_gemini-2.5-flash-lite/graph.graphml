<edge source="Mirosław Dreszer" target="GKS 71 Tychy">
  <data key="d5">["PLAYED_FOR"]</data>
  <data key="d6">Mirosław Dreszer began playing for GKS 71 Tychy.</data>
  <data key="d7">[{"text": "He began playing for GKS 71 Tychy; he played in the Polish First Division in the 1984–85 season, and played for Legia Warsaw in the 1985–86 season in two matches.", "chunk_id": "2463a2e6b54ba2b9", "doc_id": "hp_3d488dbab399d265", "type": "PLAYED_FOR"}]</data>
  <data key="d8">hp_3d488dbab399d265</data>
</edge>
