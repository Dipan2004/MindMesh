</node>
<node id="Konrad Zuse Medal">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Konrad Zuse Medal is the highest award of the Gesellschaft für Informatik.", "chunk_id": "d9c7f79a6d0cc7cf", "doc_id": "hp_1af5bb541eef600d"}]</data>
  <data key="d2">[{"text": "The Konrad Zuse Medal is the highest award of the Gesellschaft für Informatik (the German Computer Science Society), given every two years to one or sometimes two leading German computer scientists.", "chunk_id": "d9c7f79a6d0cc7cf", "doc_id": "hp_1af5bb541eef600d"}]</data>
  <data key="d3">["hp_1af5bb541eef600d"]</data>
  <data key="d4">False</data>
</node>
<node id="Gesellschaft für Informatik">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Gesellschaft für Informatik is the German Computer Science Society.", "chunk_id": "d9c7f79a6d0cc7cf", "doc_id": "hp_1af5bb541eef600d"}]</data>
  <data key="d2">[{"text": "The Konrad Zuse Medal is the highest award of the Gesellschaft für Informatik (the German Computer Science Society), given every two years to one or sometimes two leading German computer scientists.", "chunk_id": "d9c7f79a6d0cc7cf", "doc_id": "hp_1af5bb541eef600d"}]</data>
  <data key="d3">["hp_1af5bb541eef600d"]</data>
  <data key="d4">False</data>
</node>
