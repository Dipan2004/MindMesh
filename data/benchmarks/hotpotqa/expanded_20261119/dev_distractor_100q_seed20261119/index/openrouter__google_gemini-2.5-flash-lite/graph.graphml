<node id="NASA">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The National Aeronautics and Space Administration, a U.S. government agency responsible for the civilian space program, as well as aeronautics and space research.", "chunk_id": "a257f50e0bcd3ee4", "doc_id": "hp_a3c13d7a17deb19d"}, {"text": "NASA is the organization for which Byron K. Lichtenberg flew aboard two Space Shuttle missions as a Payload Specialist.", "chunk_id": "986fec5d5c4ec7fd", "doc_id": "hp_ab0e95c94eff4211"}]</data>
  <data key="d2">[{"text": "He was Chief of NASA's Non-Renewable Resources Branch and Program Scientist of the Space Shuttle's first scientific flights with cargo that included experiments related to geology, atmospheric chemistry, meteorology, marine biology, and plant physiology in the earth and life sciences.", "chunk_id": "a257f50e0bcd3ee4", "doc_id": "hp_a3c13d7a17deb19d"}, {"text": "Byron Kurt Lichtenberg, Sc. D. (born February 19, 1948) is an American engineer and fighter pilot who flew aboard two NASA Space Shuttle missions as a Payload Specialist.", "chunk_id": "986fec5d5c4ec7fd", "doc_id": "hp_ab0e95c94eff4211"}]</data>
  <data key="d3">["hp_a3c13d7a17deb19d", "hp_ab0e95c94eff4211"]</data>
  <data key="d4">False</data>
</node>
<node id="Non-Renewable Resources Branch">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A branch within NASA focused on non-renewable resources.", "chunk_id": "a257f50e0bcd3ee4", "doc_id": "hp_a3c13d7a17deb19d"}]</data>
  <data key="d2">[{"text": "He was Chief of NASA's Non-Renewable Resources Branch and Program Scientist of the Space Shuttle's first scientific flights with cargo that included experiments related to geology, atmospheric chemistry, meteorology, marine biology, and plant physiology in the earth and life sciences.", "chunk_id": "a257f50e0bcd3ee4", "doc_id": "hp_a3c13d7a17deb19d"}]</data>
  <data key="d3">["hp_a3c13d7a17deb19d"]</data>
  <data key="d4">False</data>
</node>
<node id="Space Shuttle">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A reusable spacecraft developed by NASA for transporting people and cargo to and from low Earth orbit.", "chunk_id": "a257f50e0bcd3ee4", "doc_id": "hp_a3c13d7a17deb19d"}, {"text": "The Space Shuttle is a spacecraft that Byron K. Lichtenberg flew on as a Payload Specialist.", "chunk_id": "986fec5d5c4ec7fd", "doc_id": "hp_ab0e95c94eff4211"}]</data>
  <data key="d2">[{"text": "He was Chief of NASA's Non-Renewable Resources Branch and Program Scientist of the Space Shuttle's first scientific flights with cargo that included experiments related to geology, atmospheric chemistry, meteorology, marine biology, and plant physiology in the earth and life sciences.", "chunk_id": "a257f50e0bcd3ee4", "doc_id": "hp_a3c13d7a17deb19d"}, {"text": "Byron Kurt Lichtenberg, Sc. D. (born February 19, 1948) is an American engineer and fighter pilot who flew aboard two NASA Space Shuttle missions as a Payload Specialist.", "chunk_id": "986fec5d5c4ec7fd", "doc_id": "hp_ab0e95c94eff4211"}]</data>
  <data key="d3">["hp_a3c13d7a17deb19d", "hp_ab0e95c94eff4211"]</data>
  <data key="d4">False</data>
</node>
<node id="geology">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The scientific study of the Earth's physical structure and substance, its history, and the processes which act on it.", "chunk_id": "a257f50e0bcd3ee4", "doc_id": "hp_a3c13d7a17deb19d"}]</data>
  <data key="d2">[{"text": "He was Chief of NASA's Non-Renewable Resources Branch and Program Scientist of the Space Shuttle's first scientific flights with cargo that included experiments related to geology, atmospheric chemistry, meteorology, marine biology, and plant physiology in the earth and life sciences.", "chunk_id": "a257f50e0bcd3ee4", "doc_id": "hp_a3c13d7a17deb19d"}]</data>
  <data key="d3">["hp_a3c13d7a17deb19d"]</data>
  <data key="d4">False</data>
</node>
<node id="atmospheric chemistry">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The study of the chemical reactions that occur in the Earth's atmosphere.", "chunk_id": "a257f50e0bcd3ee4", "doc_id": "hp_a3c13d7a17deb19d"}]</data>
  <data key="d2">[{"text": "He was Chief of NASA's Non-Renewable Resources Branch and Program Scientist of the Space Shuttle's first scientific flights with cargo that included experiments related to geology, atmospheric chemistry, meteorology, marine biology, and plant physiology in the earth and life sciences.", "chunk_id": "a257f50e0bcd3ee4", "doc_id": "hp_a3c13d7a17deb19d"}]</data>
