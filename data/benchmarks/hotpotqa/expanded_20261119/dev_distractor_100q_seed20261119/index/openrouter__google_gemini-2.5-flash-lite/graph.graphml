  <data key="d5">["RELEASED_THROUGH"]</data>
  <data key="d6">"Honey, We Shrunk Ourselves" was released through Walt Disney Home Video.</data>
  <data key="d7">[{"text": "The directorial debut of cinematographer Dean Cundey and released through Walt Disney Home Video, it tells the story of inventor Wayne Szalinski as he accidentally shrinks his wife, brother, sister-in-law, and himself with his electromagnetic shrink ray.", "chunk_id": "dc5757b648896eba", "doc_id": "hp_a279428a0dd44903", "type": "RELEASED_THROUGH"}]</data>
