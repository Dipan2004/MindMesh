<node id="H. R. Haldeman">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "H. R. Haldeman was an American political aide and businessman.", "chunk_id": "f87cc652bb7badbf", "doc_id": "hp_49a0bee4f2c64271"}, {"text": "H. R. Haldeman was an operator of Nixon's presidential campaign.", "chunk_id": "7a98a826c469ba66", "doc_id": "hp_866e1a0ee1799d1f"}]</data>
  <data key="d2">[{"text": "H. R. Haldeman", "chunk_id": "f87cc652bb7badbf", "doc_id": "hp_49a0bee4f2c64271"}, {"text": "Before H. R. Haldeman and John Ehrlichman became the operators of Nixon's presidential campaign, Woods was Nixon's gatekeeper.", "chunk_id": "7a98a826c469ba66", "doc_id": "hp_866e1a0ee1799d1f"}]</data>
  <data key="d3">["hp_49a0bee4f2c64271", "hp_866e1a0ee1799d1f"]</data>
  <data key="d4">False</data>
</node>
<node id="Harry Robbins &quot;Bob&quot; Haldeman">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Harry Robbins \"Bob\" Haldeman was an American political aide and businessman, best known for his service as White House Chief of Staff to President Richard Nixon and his consequent involvement in the Watergate Affair.", "chunk_id": "f87cc652bb7badbf", "doc_id": "hp_49a0bee4f2c64271"}]</data>
  <data key="d2">[{"text": "Harry Robbins \"Bob\" Haldeman (October 27, 1926 – November 12, 1993) was an American political aide and businessman, best known for his service as White House Chief of Staff to President Richard Nixon and his consequent involvement in the Watergate Affair.", "chunk_id": "f87cc652bb7badbf", "doc_id": "hp_49a0bee4f2c64271"}]</data>
  <data key="d3">["hp_49a0bee4f2c64271"]</data>
  <data key="d4">False</data>
</node>
<node id="White House Chief of Staff">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "White House Chief of Staff is a position within the White House Office.", "chunk_id": "f87cc652bb7badbf", "doc_id": "hp_49a0bee4f2c64271"}]</data>
  <data key="d2">[{"text": "Harry Robbins \"Bob\" Haldeman (October 27, 1926 – November 12, 1993) was an American political aide and businessman, best known for his service as White House Chief of Staff to President Richard Nixon and his consequent involvement in the Watergate Affair.", "chunk_id": "f87cc652bb7badbf", "doc_id": "hp_49a0bee4f2c64271"}]</data>
  <data key="d3">["hp_49a0bee4f2c64271"]</data>
  <data key="d4">False</data>
</node>
<node id="President Richard Nixon">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "President Richard Nixon was the President of the United States.", "chunk_id": "f87cc652bb7badbf", "doc_id": "hp_49a0bee4f2c64271"}, {"text": "The President for whom Charles Colson and H.R. Haldeman acted as hatchet men.", "chunk_id": "d0b1e443837cd70f", "doc_id": "hp_5042be17d44308ee"}, {"text": "The former president whose presidential papers and tape recordings were to be obtained under the Presidential Recordings and Materials Preservation Act.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d2">[{"text": "Harry Robbins \"Bob\" Haldeman (October 27, 1926 – November 12, 1993) was an American political aide and businessman, best known for his service as White House Chief of Staff to President Richard Nixon and his consequent involvement in the Watergate Affair.", "chunk_id": "f87cc652bb7badbf", "doc_id": "hp_49a0bee4f2c64271"}, {"text": "Charles Colson was known as a hatchet man for President Richard Nixon, as was H.R. Haldeman, who proudly described himself as \"Richard Nixon's 'son of a bitch'\".", "chunk_id": "d0b1e443837cd70f", "doc_id": "hp_5042be17d44308ee"}, {"text": "The Presidential Recordings and Materials Preservation Act, signed into law by President Gerald Ford in 1974, ordered that the Administrator of General Services obtain President Richard Nixon’s presidential papers and tape recordings.", "chunk_id": "011991db30ac2dac", "doc_id": "hp_ba0b2efa73fa43d2"}]</data>
  <data key="d3">["hp_49a0bee4f2c64271", "hp_5042be17d44308ee", "hp_ba0b2efa73fa43d2"]</data>
  <data key="d4">False</data>
</node>
<node id="Watergate Affair">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Watergate Affair was a major political scandal in the United States involving an illegal break-in at the Democratic National Committee headquarters.", "chunk_id": "f87cc652bb7badbf", "doc_id": "hp_49a0bee4f2c64271"}]</data>
  <data key="d2">[{"text": "Harry Robbins \"Bob\" Haldeman (October 27, 1926 – November 12, 1993) was an American political aide and businessman, best known for his service as White House Chief of Staff to President Richard Nixon and his consequent involvement in the Watergate Affair.", "chunk_id": "f87cc652bb7badbf", "doc_id": "hp_49a0bee4f2c64271"}]</data>
  <data key="d3">["hp_49a0bee4f2c64271"]</data>
  <data key="d4">False</data>
</node>
<node id="Jiangxia Tidal Power Station">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Jiangxia Tidal Power Station is the fourth largest tidal power station in the world.", "chunk_id": "ff0f3f2e384a3a68", "doc_id": "hp_49bb33ee8514f5e2"}]</data>
  <data key="d2">[{"text": "The Jiangxia Tidal Power Station (江厦潮汐电站) is the fourth largest tidal power station in the world, located in Wuyantou, Wenling City, Zhejiang Province, China.", "chunk_id": "ff0f3f2e384a3a68", "doc_id": "hp_49bb33ee8514f5e2"}]</data>
  <data key="d3">["hp_49bb33ee8514f5e2"]</data>
  <data key="d4">False</data>
</node>
<node id="Wuyantou">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Wuyantou is a location within Wenling City, Zhejiang Province, China.", "chunk_id": "ff0f3f2e384a3a68", "doc_id": "hp_49bb33ee8514f5e2"}]</data>
  <data key="d2">[{"text": "The Jiangxia Tidal Power Station (江厦潮汐电站) is the fourth largest tidal power station in the world, located in Wuyantou, Wenling City, Zhejiang Province, China.", "chunk_id": "ff0f3f2e384a3a68", "doc_id": "hp_49bb33ee8514f5e2"}]</data>
  <data key="d3">["hp_49bb33ee8514f5e2"]</data>
  <data key="d4">False</data>
</node>
<node id="Wenling City">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Wenling City is a city in Zhejiang Province, China.", "chunk_id": "ff0f3f2e384a3a68", "doc_id": "hp_49bb33ee8514f5e2"}]</data>
  <data key="d2">[{"text": "The Jiangxia Tidal Power Station (江厦潮汐电站) is the fourth largest tidal power station in the world, located in Wuyantou, Wenling City, Zhejiang Province, China.", "chunk_id": "ff0f3f2e384a3a68", "doc_id": "hp_49bb33ee8514f5e2"}]</data>
  <data key="d3">["hp_49bb33ee8514f5e2"]</data>
  <data key="d4">False</data>
</node>
<node id="3,000 kW">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "3,000 kW was the proposed design capacity for the Jiangxia Tidal Power Station.", "chunk_id": "ff0f3f2e384a3a68", "doc_id": "hp_49bb33ee8514f5e2"}]</data>
  <data key="d2">[{"text": "Although the proposed design for the facility was 3,000 kW, the current installed capacity is 3,200 kW, generated from one unit of 500 kW, one unit of 600 kW, and three units of 700 kW, totalling the installed capacity to 3,200 kW.", "chunk_id": "ff0f3f2e384a3a68", "doc_id": "hp_49bb33ee8514f5e2"}]</data>
  <data key="d3">["hp_49bb33ee8514f5e2"]</data>
  <data key="d4">False</data>
</node>
<node id="3,200 kW">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "3,200 kW is the current installed capacity of the Jiangxia Tidal Power Station.", "chunk_id": "ff0f3f2e384a3a68", "doc_id": "hp_49bb33ee8514f5e2"}]</data>
  <data key="d2">[{"text": "Although the proposed design for the facility was 3,000 kW, the current installed capacity is 3,200 kW, generated from one unit of 500 kW, one unit of 600 kW, and three units of 700 kW, totalling the installed capacity to 3,200 kW.", "chunk_id": "ff0f3f2e384a3a68", "doc_id": "hp_49bb33ee8514f5e2"}]</data>
  <data key="d3">["hp_49bb33ee8514f5e2"]</data>
  <data key="d4">False</data>
</node>
