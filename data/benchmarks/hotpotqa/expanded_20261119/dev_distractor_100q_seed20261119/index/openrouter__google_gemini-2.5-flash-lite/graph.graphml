  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The state where Kansas City is located.", "chunk_id": "29dfa2df58a551ed", "doc_id": "hp_132ccee5aa3dd85c"}, {"text": "A state in the Midwestern United States.", "chunk_id": "ca56de409a030dd6", "doc_id": "hp_33b159b8faca1ec8"}, {"text": "Missouri is a state in the United States where St. Louis is located.", "chunk_id": "7eaecb7c8ff690f9", "doc_id": "hp_537a416acef9e8ad"}, {"text": "A state in the Midwestern United States.", "chunk_id": "1dcb1ca9df627726", "doc_id": "hp_8ad05a86a63976c5"}]</data>
  <data key="d2">[{"text": "Played at Arrowhead Stadium in Kansas City, Missouri.", "chunk_id": "29dfa2df58a551ed", "doc_id": "hp_132ccee5aa3dd85c"}, {"text": "Played at Arrowhead Stadium in Kansas City, Missouri.", "chunk_id": "ca56de409a030dd6", "doc_id": "hp_33b159b8faca1ec8"}, {"text": "The May Department Stores Company was an American department store holding company, formerly headquartered in downtown St. Louis, Missouri.", "chunk_id": "7eaecb7c8ff690f9", "doc_id": "hp_537a416acef9e8ad"}, {"text": "The 1999 Kansas City Wizards season was played at Arrowhead Stadium in Kansas City, Missouri.", "chunk_id": "1dcb1ca9df627726", "doc_id": "hp_8ad05a86a63976c5"}]</data>
