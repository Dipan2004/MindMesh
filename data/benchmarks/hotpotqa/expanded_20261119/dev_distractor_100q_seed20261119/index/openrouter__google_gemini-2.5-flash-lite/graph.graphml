<node id="Europe's Strongest Man">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "An annual strength athletics competition that began in 1980.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}]</data>
  <data key="d2">[{"text": "Europe's Strongest Man is an annual strength athletics competition which began in 1980.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}]</data>
  <data key="d3">["hp_3957e4fb7391cc33"]</data>
  <data key="d4">False</data>
</node>
<node id="Mariusz Pudzianowski">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The competitor who currently holds the record for most wins in Europe's Strongest Man.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}]</data>
  <data key="d2">[{"text": "Mariusz Pudzianowski currently holds the record for most wins with 6 titles.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}]</data>
  <data key="d3">["hp_3957e4fb7391cc33"]</data>
  <data key="d4">False</data>
</node>
<node id="Zydrunas Savickas">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A competitor who holds 3 titles in Europe's Strongest Man.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}, {"text": "An athlete from Lithuania who placed second in the 2013 World's Strongest Man competition.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "An athlete from Lithuania who won the 2014 World's Strongest Man competition.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d2">[{"text": "Zydrunas Savickas, Geoff Capes, Riku Kiri and Hafþór Júlíus Björnsson each hold 3 titles.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}, {"text": "Zydrunas Savickas from Lithuania was second after finishing 1st the year before, and Hafþór Júlíus Björnsson from Iceland was third for the second year in a row.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "Zydrunas Savickas from Lithuania finished in first place, this was his fourth WSM title.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d3">["hp_3957e4fb7391cc33", "hp_45c17b9e08342c16", "hp_5d64f24bd8d85ba4"]</data>
  <data key="d4">False</data>
</node>
<node id="Geoff Capes">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A competitor who holds 3 titles in Europe's Strongest Man.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}, {"text": "A competitor in the 1980 World's Strongest Man competition who finished third.", "chunk_id": "22af8bb1815b8995", "doc_id": "hp_b1381d79c5b4d390"}]</data>
  <data key="d2">[{"text": "Zydrunas Savickas, Geoff Capes, Riku Kiri and Hafþór Júlíus Björnsson each hold 3 titles.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}, {"text": "Lars Hedlund from Sweden finished second after finishing second the previous year, and Geoff Capes from the United Kingdom finished third.", "chunk_id": "22af8bb1815b8995", "doc_id": "hp_b1381d79c5b4d390"}]</data>
  <data key="d3">["hp_3957e4fb7391cc33", "hp_b1381d79c5b4d390"]</data>
  <data key="d4">False</data>
</node>
