<node id="1936 Individual Speedway World Championship">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 1936 Individual Speedway World Championship was the first ever Speedway World Championship.", "chunk_id": "1606e1aa9cfc722b", "doc_id": "hp_631a38475ad4383e"}]</data>
  <data key="d2">[{"text": "The 1936 Individual Speedway World Championship was the first ever Speedway World Championship and was won by Lionel Van Praag of Australia.", "chunk_id": "1606e1aa9cfc722b", "doc_id": "hp_631a38475ad4383e"}]</data>
  <data key="d3">["hp_631a38475ad4383e"]</data>
  <data key="d4">False</data>
</node>
<node id="Speedway World Championship">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Speedway World Championship is a racing event.", "chunk_id": "1606e1aa9cfc722b", "doc_id": "hp_631a38475ad4383e"}, {"text": "The Speedway World Championship is a championship that was first held in 1936.", "chunk_id": "2c62b8e41effed53", "doc_id": "hp_e15a8d4e4eeaa41c"}, {"text": "A championship event for motorcycle speedway riders.", "chunk_id": "c6546edc8fa1b181", "doc_id": "hp_ea9deb27c486c338"}]</data>
  <data key="d2">[{"text": "The 1936 Individual Speedway World Championship was the first ever Speedway World Championship and was won by Lionel Van Praag of Australia.", "chunk_id": "1606e1aa9cfc722b", "doc_id": "hp_631a38475ad4383e"}, {"text": "The 1989 Individual Speedway World Championship was the 45th Speedway World Championship held since it was first held in 1936.", "chunk_id": "2c62b8e41effed53", "doc_id": "hp_e15a8d4e4eeaa41c"}, {"text": "Jack Ellis Young (31 January 1925 in Adelaide, South Australia – 28 August 1987 in Adelaide) was a Motorcycle speedway rider who won the Speedway World Championship in 1951 and 1952.", "chunk_id": "c6546edc8fa1b181", "doc_id": "hp_ea9deb27c486c338"}]</data>
  <data key="d3">["hp_631a38475ad4383e", "hp_e15a8d4e4eeaa41c", "hp_ea9deb27c486c338"]</data>
  <data key="d4">False</data>
</node>
<node id="Lionel Van Praag">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Lionel Van Praag won the 1936 Individual Speedway World Championship.", "chunk_id": "1606e1aa9cfc722b", "doc_id": "hp_631a38475ad4383e"}]</data>
  <data key="d2">[{"text": "The 1936 Individual Speedway World Championship was the first ever Speedway World Championship and was won by Lionel Van Praag of Australia.", "chunk_id": "1606e1aa9cfc722b", "doc_id": "hp_631a38475ad4383e"}]</data>
  <data key="d3">["hp_631a38475ad4383e"]</data>
  <data key="d4">False</data>
</node>
<node id="Wembley Stadium">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Wembley Stadium is a venue that hosted the World Final.", "chunk_id": "1606e1aa9cfc722b", "doc_id": "hp_631a38475ad4383e"}]</data>
  <data key="d2">[{"text": "It was the first of a record 26 times that London's Wembley Stadium would host the World Final with the last being in 1981.", "chunk_id": "1606e1aa9cfc722b", "doc_id": "hp_631a38475ad4383e"}]</data>
  <data key="d3">["hp_631a38475ad4383e"]</data>
  <data key="d4">False</data>
</node>
<node id="World Final">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The World Final is an event hosted at Wembley Stadium.", "chunk_id": "1606e1aa9cfc722b", "doc_id": "hp_631a38475ad4383e"}]</data>
  <data key="d2">[{"text": "It was the first of a record 26 times that London's Wembley Stadium would host the World Final with the last being in 1981.", "chunk_id": "1606e1aa9cfc722b", "doc_id": "hp_631a38475ad4383e"}]</data>
