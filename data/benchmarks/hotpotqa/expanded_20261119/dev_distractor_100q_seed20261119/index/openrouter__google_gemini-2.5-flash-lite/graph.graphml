  <data key="d5">["PUBLISHED_BY"]</data>
  <data key="d6">Goodman, Lieber, Kurtzberg &amp; Holliway is a fictional law firm appearing in American comic books published by Marvel Comics.</data>
  <data key="d7">[{"text": "Goodman, Lieber, Kurtzberg &amp; Holliway is a fictional law firm appearing in American comic books published by Marvel Comics.", "chunk_id": "8668a35a82ba8929", "doc_id": "hp_3caacc282a8db693", "type": "PUBLISHED_BY"}]</data>
