<edge source="Phil Edwards" target="Banzai pipeline">
  <data key="d5">["FIRST_TO_SURF"]</data>
  <data key="d6">Phil Edwards is credited with being the first to surf the Banzai pipeline.</data>
  <data key="d7">[{"text": "He is credited with being the first to surf the Banzai pipeline in Hawaii, being the first professional surfer, and creating the first signature surf board.", "chunk_id": "bbc12d32fc610206", "doc_id": "hp_d425f0e62b7587a7", "type": "FIRST_TO_SURF"}]</data>
