<edge source="Nivedita ShivRaj" target="South Indian carnatic music">
  <data key="d5">["COMPOSES_IN"]</data>
  <data key="d6">Nivedita ShivRaj is a carnatic musician whose compositions are based on South Indian Carnatic music.</data>
