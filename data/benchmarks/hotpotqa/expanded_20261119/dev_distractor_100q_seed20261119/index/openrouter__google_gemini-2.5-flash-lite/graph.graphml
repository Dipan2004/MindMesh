<edge source="Damien Sandow" target="Eugen Sandow">
  <data key="d5">["NAMED_AFTER"]</data>
  <data key="d6">Damien Sandow adopted his ring name in honor of Eugen Sandow.</data>
  <data key="d7">[{"text": "He may have taken his ring name from Eugen Sandow, a professional wrestler and strongman in the late 19th century; in turn, former WWE wrestler Damien Sandow would adopt his own ring name in honor of Sandow almost a century later.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9", "type": "NAMED_AFTER"}]</data>
  <data key="d8">hp_9ebd705ad887d9a9</data>
</edge>
