  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A wrestling champion managed by Billy Sandow.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d2">[{"text": "Sandow also served as manager for such wrestling champions as Billy Jenkins, Marin Plestina, Jumping Joe Savoldi and Everett Marshall, and also used the ring name The Zebra Kid in 1951.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d3">["hp_9ebd705ad887d9a9"]</data>
  <data key="d4">False</data>
</node>
<node id="Everett Marshall">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A wrestling champion managed by Billy Sandow.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d2">[{"text": "Sandow also served as manager for such wrestling champions as Billy Jenkins, Marin Plestina, Jumping Joe Savoldi and Everett Marshall, and also used the ring name The Zebra Kid in 1951.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d3">["hp_9ebd705ad887d9a9"]</data>
  <data key="d4">False</data>
</node>
<node id="The Zebra Kid">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A ring name used by Billy Sandow in 1951.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d2">[{"text": "Sandow also served as manager for such wrestling champions as Billy Jenkins, Marin Plestina, Jumping Joe Savoldi and Everett Marshall, and also used the ring name The Zebra Kid in 1951.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d3">["hp_9ebd705ad887d9a9"]</data>
  <data key="d4">False</data>
</node>
<node id="Wrestling Observer Newsletter Hall of Fame">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Hall of Fame for which Billy Sandow was a charter inductee in 1996.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d2">[{"text": "He was a charter inductee of the Wrestling Observer Newsletter Hall of Fame in 1996.", "chunk_id": "8cf7327046599231", "doc_id": "hp_9ebd705ad887d9a9"}]</data>
  <data key="d3">["hp_9ebd705ad887d9a9"]</data>
  <data key="d4">False</data>
</node>
<node id="Extreme mass ratio inspiral">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "An extreme mass ratio inspiral (EMRI) is the orbit of a relatively light object around a much heavier object that gradually decays due the emission of gravitational waves.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d2">[{"text": "In astrophysics, an extreme mass ratio inspiral (EMRI) is the orbit of a relatively light object around a much heavier (by a factor 10,000 or more) object, that gradually decays due the emission of gravitational waves.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d3">["hp_9ef7f82d0f1702ec"]</data>
  <data key="d4">False</data>
</node>
<node id="astrophysics">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Astrophysics is a branch of astronomy that employs the principles of physics and chemistry to study celestial objects and phenomena.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d2">[{"text": "In astrophysics, an extreme mass ratio inspiral (EMRI) is the orbit of a relatively light object around a much heavier (by a factor 10,000 or more) object, that gradually decays due the emission of gravitational waves.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d3">["hp_9ef7f82d0f1702ec"]</data>
  <data key="d4">False</data>
</node>
<node id="gravitational waves">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Gravitational waves are ripples in the fabric of spacetime, generated by the acceleration of masses.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d2">[{"text": "In astrophysics, an extreme mass ratio inspiral (EMRI) is the orbit of a relatively light object around a much heavier (by a factor 10,000 or more) object, that gradually decays due the emission of gravitational waves.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d3">["hp_9ef7f82d0f1702ec"]</data>
  <data key="d4">False</data>
</node>
<node id="centers of galaxies">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The centers of galaxies are regions where stellar mass compact objects may be found orbiting a supermassive black hole.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d2">[{"text": "Such systems are likely to be found in the centers of galaxies, where stellar mass compact objects, such as stellar black holes and neutron stars, may be found orbiting a supermassive black hole.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d3">["hp_9ef7f82d0f1702ec"]</data>
  <data key="d4">False</data>
</node>
<node id="stellar mass compact objects">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Stellar mass compact objects are dense remnants of stars, such as black holes and neutron stars.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d2">[{"text": "Such systems are likely to be found in the centers of galaxies, where stellar mass compact objects, such as stellar black holes and neutron stars, may be found orbiting a supermassive black hole.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d3">["hp_9ef7f82d0f1702ec"]</data>
  <data key="d4">False</data>
</node>
<node id="stellar black holes">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Stellar black holes are a type of compact object formed from the gravitational collapse of massive stars.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d2">[{"text": "Such systems are likely to be found in the centers of galaxies, where stellar mass compact objects, such as stellar black holes and neutron stars, may be found orbiting a supermassive black hole.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d3">["hp_9ef7f82d0f1702ec"]</data>
  <data key="d4">False</data>
</node>
<node id="neutron stars">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Neutron stars are the incredibly dense collapsed cores of massive stars that have exploded as supernovae.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d2">[{"text": "Such systems are likely to be found in the centers of galaxies, where stellar mass compact objects, such as stellar black holes and neutron stars, may be found orbiting a supermassive black hole.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d3">["hp_9ef7f82d0f1702ec"]</data>
  <data key="d4">False</data>
</node>
<node id="supermassive black hole">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A supermassive black hole is a black hole of an intermediate mass, varying from 100,000 to over 10 billion solar masses.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d2">[{"text": "Such systems are likely to be found in the centers of galaxies, where stellar mass compact objects, such as stellar black holes and neutron stars, may be found orbiting a supermassive black hole.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d3">["hp_9ef7f82d0f1702ec"]</data>
  <data key="d4">False</data>
</node>
<node id="extreme mass ratio binary black hole">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "An extreme mass ratio binary black hole is a system where one black hole orbits another much heavier black hole.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d2">[{"text": "In the case of a black hole in orbit around another black hole this is an extreme mass ratio binary black hole.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d3">["hp_9ef7f82d0f1702ec"]</data>
  <data key="d4">False</data>
</node>
<node id="EMRI">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "EMRI is sometimes used as a shorthand to denote the emitted gravitational waveform as well as the orbit itself.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d2">[{"text": "The term EMRI is sometimes used as a shorthand to denote the emitted gravitational waveform as well as the orbit itself.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d3">["hp_9ef7f82d0f1702ec"]</data>
  <data key="d4">False</data>
</node>
<node id="gravitational waveform">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A gravitational waveform is a ripple in spacetime generated by the acceleration of masses, often associated with extreme astrophysical events.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d2">[{"text": "The term EMRI is sometimes used as a shorthand to denote the emitted gravitational waveform as well as the orbit itself.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}]</data>
  <data key="d3">["hp_9ef7f82d0f1702ec"]</data>
  <data key="d4">False</data>
</node>
<node id="GeIL">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "GeIL is a manufacturer of computer hardware components.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}]</data>
  <data key="d2">[{"text": "Golden Emperor International Ltd. or commonly known as GeIL is a manufacturer of computer hardware components, based in Taipei, Taiwan with focus in DRAM and flash based memory products since 1993.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}]</data>
  <data key="d3">["hp_a08e17bf87e824f4"]</data>
  <data key="d4">False</data>
</node>
<node id="Golden Emperor International Ltd.">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Golden Emperor International Ltd. is the full name for GeIL, a manufacturer of computer hardware components.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}]</data>
  <data key="d2">[{"text": "Golden Emperor International Ltd. or commonly known as GeIL is a manufacturer of computer hardware components, based in Taipei, Taiwan with focus in DRAM and flash based memory products since 1993.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}]</data>
  <data key="d3">["hp_a08e17bf87e824f4"]</data>
  <data key="d4">False</data>
</node>
<node id="Taipei">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Taipei is a location where GeIL is based and has its headquarters.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}, {"text": "Taipei is the city where the main characters of Vive L'Amour unknowingly share an apartment.", "chunk_id": "8869b7186fadb9af", "doc_id": "hp_a8cea0bffbbab591"}, {"text": "A city where the stories of 'Rebels of the Neon God' are set.", "chunk_id": "197489edd7e615b2", "doc_id": "hp_e2eedc11b3a4a9ee"}]</data>
  <data key="d2">[{"text": "Golden Emperor International Ltd. or commonly known as GeIL is a manufacturer of computer hardware components, based in Taipei, Taiwan with focus in DRAM and flash based memory products since 1993.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}, {"text": "The film features striking images and sparse dialogue on urban alienation and loneliness, with three main characters unknowingly sharing an apartment in Taipei.", "chunk_id": "8869b7186fadb9af", "doc_id": "hp_a8cea0bffbbab591"}, {"text": "It tells two stories of Taipei youth.", "chunk_id": "197489edd7e615b2", "doc_id": "hp_e2eedc11b3a4a9ee"}]</data>
  <data key="d3">["hp_a08e17bf87e824f4", "hp_a8cea0bffbbab591", "hp_e2eedc11b3a4a9ee"]</data>
  <data key="d4">False</data>
</node>
<node id="DRAM">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "DRAM is a type of memory product that GeIL focuses on.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}]</data>
  <data key="d2">[{"text": "Golden Emperor International Ltd. or commonly known as GeIL is a manufacturer of computer hardware components, based in Taipei, Taiwan with focus in DRAM and flash based memory products since 1993.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}]</data>
  <data key="d3">["hp_a08e17bf87e824f4"]</data>
  <data key="d4">False</data>
</node>
<node id="flash based memory products">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Flash based memory products are a focus for GeIL.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}]</data>
  <data key="d2">[{"text": "Golden Emperor International Ltd. or commonly known as GeIL is a manufacturer of computer hardware components, based in Taipei, Taiwan with focus in DRAM and flash based memory products since 1993.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}]</data>
  <data key="d3">["hp_a08e17bf87e824f4"]</data>
  <data key="d4">False</data>
</node>
<node id="memory module design">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Memory module design is an area GeIL has been concentrating on since 1993.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}]</data>
  <data key="d2">[{"text": "Since then, GeIL has been concentrating in memory module design and manufacturing technology.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}]</data>
  <data key="d3">["hp_a08e17bf87e824f4"]</data>
  <data key="d4">False</data>
</node>
<node id="manufacturing technology">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Manufacturing technology is an area GeIL has been concentrating on since 1993.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}]</data>
  <data key="d2">[{"text": "Since then, GeIL has been concentrating in memory module design and manufacturing technology.", "chunk_id": "94d646829c3ad5f6", "doc_id": "hp_a08e17bf87e824f4"}]</data>
  <data key="d3">["hp_a08e17bf87e824f4"]</data>
  <data key="d4">False</data>
</node>
<node id="Richard Bunger Evans">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An American composer and pianist.", "chunk_id": "f317bf6030b1131e", "doc_id": "hp_a09bf8eaffccdd21"}]</data>
  <data key="d2">[{"text": "Richard Bunger Evans, also known as Richard Bunger, (born 1942) is an American composer and pianist who worked with John Cage and subsequently wrote \"the classic book on John Cage,\" \"The Well-Prepared Piano\".", "chunk_id": "f317bf6030b1131e", "doc_id": "hp_a09bf8eaffccdd21"}]</data>
  <data key="d3">["hp_a09bf8eaffccdd21"]</data>
  <data key="d4">False</data>
</node>
