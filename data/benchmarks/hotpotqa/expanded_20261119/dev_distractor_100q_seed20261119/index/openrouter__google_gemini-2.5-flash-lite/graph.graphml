  <data key="d4">False</data>
</node>
<node id="The Biological Reserve &quot;Campanarios de Azaba&quot;">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Biological Reserve \"Campanarios de Azaba\" is a location in Espeja, Salamanca province, where the Retuertas horse is found.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d2">[{"text": "It is now found only in the Doñana National Park in the provinces of Huelva and Sevilla, and in The Biological Reserve \"Campanarios de Azaba\" in Espeja (Salamanca province) a part of which is the research reserve of the Consejo Superior de Investigaciones Científicas, the Spanish National Research Council.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d3">["hp_f5a05d2ab71d3e1b"]</data>
  <data key="d4">False</data>
</node>
<node id="Espeja">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Espeja is a location in Salamanca province where The Biological Reserve \"Campanarios de Azaba\" is situated.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d2">[{"text": "It is now found only in the Doñana National Park in the provinces of Huelva and Sevilla, and in The Biological Reserve \"Campanarios de Azaba\" in Espeja (Salamanca province) a part of which is the research reserve of the Consejo Superior de Investigaciones Científicas, the Spanish National Research Council.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d3">["hp_f5a05d2ab71d3e1b"]</data>
  <data key="d4">False</data>
</node>
<node id="Salamanca province">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Salamanca province is a province in Spain where Espeja is located.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d2">[{"text": "It is now found only in the Doñana National Park in the provinces of Huelva and Sevilla, and in The Biological Reserve \"Campanarios de Azaba\" in Espeja (Salamanca province) a part of which is the research reserve of the Consejo Superior de Investigaciones Científicas, the Spanish National Research Council.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d3">["hp_f5a05d2ab71d3e1b"]</data>
  <data key="d4">False</data>
</node>
<node id="Consejo Superior de Investigaciones Científicas">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Consejo Superior de Investigaciones Científicas is the Spanish National Research Council and has a research reserve within The Biological Reserve \"Campanarios de Azaba\".", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d2">[{"text": "It is now found only in the Doñana National Park in the provinces of Huelva and Sevilla, and in The Biological Reserve \"Campanarios de Azaba\" in Espeja (Salamanca province) a part of which is the research reserve of the Consejo Superior de Investigaciones Científicas, the Spanish National Research Council.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d3">["hp_f5a05d2ab71d3e1b"]</data>
  <data key="d4">False</data>
</node>
<node id="Spanish National Research Council">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Spanish National Research Council is the English name for the Consejo Superior de Investigaciones Científicas.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d2">[{"text": "It is now found only in the Doñana National Park in the provinces of Huelva and Sevilla, and in The Biological Reserve \"Campanarios de Azaba\" in Espeja (Salamanca province) a part of which is the research reserve of the Consejo Superior de Investigaciones Científicas, the Spanish National Research Council.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d3">["hp_f5a05d2ab71d3e1b"]</data>
  <data key="d4">False</data>
</node>
<node id="genetic study">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A genetic study by the CSIC indicated that the Retuertas horse is one of the oldest European breeds.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d2">[{"text": "According to a genetic study by the CSIC, the Retuertas horse is one of the oldest European breeds.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d3">["hp_f5a05d2ab71d3e1b"]</data>
  <data key="d4">False</data>
</node>
<node id="CSIC">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "CSIC is an abbreviation for the Consejo Superior de Investigaciones Científicas, which conducted a genetic study on the Retuertas horse.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d2">[{"text": "According to a genetic study by the CSIC, the Retuertas horse is one of the oldest European breeds.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d3">["hp_f5a05d2ab71d3e1b"]</data>
  <data key="d4">False</data>
</node>
<node id="oldest European breeds">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Retuertas horse is identified as one of the oldest European breeds, dating back 3000 years BP.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d2">[{"text": "According to a genetic study by the CSIC, the Retuertas horse is one of the oldest European breeds., dating to 3000 years BP, and the only one living in the wild and isolated from other populations.", "chunk_id": "c416a15787294ca0", "doc_id": "hp_f5a05d2ab71d3e1b"}]</data>
  <data key="d3">["hp_f5a05d2ab71d3e1b"]</data>
  <data key="d4">False</data>
</node>
