<node id="Santiago del Estero">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Santiago del Estero is a province in Argentina where Árraga is located.", "chunk_id": "1169ed720e69619f", "doc_id": "hp_20739c2399543481"}, {"text": "The capital of Santiago del Estero Province in northern Argentina.", "chunk_id": "eee0658a37ea7481", "doc_id": "hp_5d6ed7a42a524dc4"}, {"text": "Santiago del Estero is a location in the same province as Barrancas and Salavina.", "chunk_id": "1c837566de6c327a", "doc_id": "hp_63f113b7dfd806d3"}, {"text": "Santiago del Estero is a province in Argentina.", "chunk_id": "3e623f78834fd3ec", "doc_id": "hp_7151fb458fd16091"}, {"text": "Santiago del Estero is a location where Ana María Corradi de Beltrán was born and a province she represents in the Argentine Senate.", "chunk_id": "685842ecaf52465b", "doc_id": "hp_794a0a02949af675"}, {"text": "A city in the Santiago del Estero Province of Argentina.", "chunk_id": "c4c74d93654d6651", "doc_id": "hp_d82c744304c9486a"}]</data>
  <data key="d2">[{"text": "Árraga is a municipality and village in Santiago del Estero in Argentina.", "chunk_id": "1169ed720e69619f", "doc_id": "hp_20739c2399543481"}, {"text": "Santiago del Estero (] , Spanish for \"Saint-James-Upon-The-Lagoon\") is the capital of Santiago del Estero Province in northern Argentina.", "chunk_id": "eee0658a37ea7481", "doc_id": "hp_5d6ed7a42a524dc4"}, {"text": "Sixto Doroteo Palavecino (March 31, 1915, Barrancas, Salavina, Santiago del Estero Province, Argentina – April 24, 2009, Santiago del Estero, same province) was a poet, musician and singer of Argentine folk music, who started playing the violin when he was 10 years old.", "chunk_id": "1c837566de6c327a", "doc_id": "hp_63f113b7dfd806d3"}, {"text": "Añatuya is a city in the province of Santiago del Estero, Argentina.", "chunk_id": "3e623f78834fd3ec", "doc_id": "hp_7151fb458fd16091"}, {"text": "Ana María Corradi de Beltrán (born 25 April 1962 in La Banda, Santiago del Estero) is an Argentine politician.", "chunk_id": "685842ecaf52465b", "doc_id": "hp_794a0a02949af675"}, {"text": "Vicecomodoro Ángel de la Paz Aragonés Airport (Spanish: \"Aeropuerto de Santiago del Estero – Ángel de la Paz Aragonés\" ) (IATA: SDE, ICAO: SANE) is located 6 km north-northwest of the center of Santiago del Estero, a city in the Santiago del Estero Province of Argentina.", "chunk_id": "c4c74d93654d6651", "doc_id": "hp_d82c744304c9486a"}]</data>
  <data key="d3">["hp_20739c2399543481", "hp_5d6ed7a42a524dc4", "hp_63f113b7dfd806d3", "hp_7151fb458fd16091", "hp_794a0a02949af675", "hp_d82c744304c9486a"]</data>
  <data key="d4">False</data>
</node>
<node id="Silípica Department">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Silípica Department is a administrative division in the province of Santiago del Estero.", "chunk_id": "1169ed720e69619f", "doc_id": "hp_20739c2399543481"}]</data>
  <data key="d2">[{"text": "It is the head district of the Silípica Department to the southwest of the province of Santiago del Estero.", "chunk_id": "1169ed720e69619f", "doc_id": "hp_20739c2399543481"}]</data>
  <data key="d3">["hp_20739c2399543481"]</data>
  <data key="d4">False</data>
</node>
<node id="Santiago del Estero (capital)">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Santiago del Estero (capital) is the provincial capital city of Santiago del Estero.", "chunk_id": "1169ed720e69619f", "doc_id": "hp_20739c2399543481"}]</data>
  <data key="d2">[{"text": "It is located 32 km from the provincial capital city of Santiago del Estero (capital), south along National Route 9.", "chunk_id": "1169ed720e69619f", "doc_id": "hp_20739c2399543481"}]</data>
  <data key="d3">["hp_20739c2399543481"]</data>
