<node id="Oujiang River">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A river that divides the Yandang Mountains into two parts.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26"}]</data>
  <data key="d2">[{"text": "The mountain range is divided in two by the Oujiang River, the two parts being the North Yandang and South Yandang.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26"}]</data>
  <data key="d3">["hp_a71b119b261e3b26"]</data>
  <data key="d4">False</data>
</node>
<node id="North Yandang">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "One of the two parts of the Yandang Mountains, divided by the Oujiang River.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26"}]</data>
  <data key="d2">[{"text": "The mountain range is divided in two by the Oujiang River, the two parts being the North Yandang and South Yandang.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26"}]</data>
  <data key="d3">["hp_a71b119b261e3b26"]</data>
  <data key="d4">False</data>
</node>
<node id="South Yandang">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "One of the two parts of the Yandang Mountains, divided by the Oujiang River.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26"}]</data>
  <data key="d2">[{"text": "The mountain range is divided in two by the Oujiang River, the two parts being the North Yandang and South Yandang.", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26"}]</data>
  <data key="d3">["hp_a71b119b261e3b26"]</data>
