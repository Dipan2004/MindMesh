  <data key="d2">[{"text": "Although North America has a number of prestigious strongman events determining the \"Strongest Man in America\", the \"Strongest Man in Canada\" and the \"Strongest Man in North America\", the All-American Strongman Challenge has added kudos because it is open to entrants from overseas with the potential to bring in leading international competitors as well.", "chunk_id": "fb43fe49d9c01907", "doc_id": "hp_1183c20fecf2a891"}]</data>
  <data key="d3">["hp_1183c20fecf2a891"]</data>
  <data key="d4">False</data>
</node>
<node id="Strongest Man in North America">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A strongman event to determine the strongest man in North America.", "chunk_id": "fb43fe49d9c01907", "doc_id": "hp_1183c20fecf2a891"}]</data>
  <data key="d2">[{"text": "Although North America has a number of prestigious strongman events determining the \"Strongest Man in America\", the \"Strongest Man in Canada\" and the \"Strongest Man in North America\", the All-American Strongman Challenge has added kudos because it is open to entrants from overseas with the potential to bring in leading international competitors as well.", "chunk_id": "fb43fe49d9c01907", "doc_id": "hp_1183c20fecf2a891"}]</data>
  <data key="d3">["hp_1183c20fecf2a891"]</data>
  <data key="d4">False</data>
</node>
<node id="World's Strongest Man">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A competition to determine the world's strongest man.", "chunk_id": "fb43fe49d9c01907", "doc_id": "hp_1183c20fecf2a891"}, {"text": "A contest for which Europe's Strongest Man serves as a qualifying event.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}, {"text": "A competition to determine the world's strongest man.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "A competition to determine the world's strongest man.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}, {"text": "World's Strongest Man is an event that Edward Hall is notable for winning.", "chunk_id": "9b0d62492a00ccff", "doc_id": "hp_6a07e9a4e90de729"}, {"text": "World's Strongest Man is a competition that Robert Oberst competes in yearly.", "chunk_id": "fd867132c1c55e97", "doc_id": "hp_ab10a66f84257538"}, {"text": "A competition to determine the strongest man in the world.", "chunk_id": "22af8bb1815b8995", "doc_id": "hp_b1381d79c5b4d390"}, {"text": "An event in which Ben Kelsey has competed.", "chunk_id": "32542274ed783fb0", "doc_id": "hp_fe45ed2c9dbcb86e"}]</data>
  <data key="d2">[{"text": "It is notable for the calibre of entrants it has attracted, with many World's Strongest Man finalists being represented.", "chunk_id": "fb43fe49d9c01907", "doc_id": "hp_1183c20fecf2a891"}, {"text": "The contest serves as a qualifying event for the World's Strongest Man contest, with the top 3 placings qualifying for that year's WSM contest.", "chunk_id": "be86e96f0a793ea6", "doc_id": "hp_3957e4fb7391cc33"}, {"text": "The 2013 World's Strongest Man was the 36th edition of World's Strongest Man.", "chunk_id": "241806d0ee3666dd", "doc_id": "hp_45c17b9e08342c16"}, {"text": "The 2014 World's Strongest Man was the 37th edition of World's Strongest Man.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}, {"text": "Edward Hall (born 15 January 1988) is an English professional strongman, notable for being the current World's Strongest Man and the only man to deadlift 500 kg under strongman rules.", "chunk_id": "9b0d62492a00ccff", "doc_id": "hp_6a07e9a4e90de729"}, {"text": "He is a yearly competitor of the World's Strongest Man including the 2013 World's Strongest Man, 2014 World's Strongest Man, 2015 World's Strongest Man and the 2016 World's Strongest Man competitions.", "chunk_id": "fd867132c1c55e97", "doc_id": "hp_ab10a66f84257538"}, {"text": "The 1980 World's Strongest Man was the fourth edition of World's Strongest Man and was won by Bill Kazmaier from the United States.", "chunk_id": "22af8bb1815b8995", "doc_id": "hp_b1381d79c5b4d390"}, {"text": "Ben Kelsey (born 23 September 1984) is a British strongman competitor, notable for having won the England's Strongest Man title, the title of World's Strongest Man Under 105 kg and having competed at the World's Strongest Man.", "chunk_id": "32542274ed783fb0", "doc_id": "hp_fe45ed2c9dbcb86e"}]</data>
  <data key="d3">["hp_1183c20fecf2a891", "hp_3957e4fb7391cc33", "hp_45c17b9e08342c16", "hp_5d64f24bd8d85ba4", "hp_6a07e9a4e90de729", "hp_ab10a66f84257538", "hp_b1381d79c5b4d390", "hp_fe45ed2c9dbcb86e"]</data>
  <data key="d4">False</data>
</node>
<node id="ITC Transmission">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "ITC Transmission is an electricity transmission company.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d2">[{"text": "ITC Transmission was founded in 1999 as International Transmission Co., a subsidiary of Detroit Edison (since renamed DTE Energy Electric Company, itself a subsidiary of DTE Energy), charged in the ownership, operation and maintenance of Detroit Edison's transmission system.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d3">["hp_1199b329dbff9419"]</data>
  <data key="d4">False</data>
</node>
<node id="International Transmission Co.">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "International Transmission Co. was the original name of ITC Transmission.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d2">[{"text": "ITC Transmission was founded in 1999 as International Transmission Co., a subsidiary of Detroit Edison (since renamed DTE Energy Electric Company, itself a subsidiary of DTE Energy), charged in the ownership, operation and maintenance of Detroit Edison's transmission system.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d3">["hp_1199b329dbff9419"]</data>
  <data key="d4">False</data>
</node>
<node id="Detroit Edison">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Detroit Edison was the original parent company of ITC Transmission.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d2">[{"text": "ITC Transmission was founded in 1999 as International Transmission Co., a subsidiary of Detroit Edison (since renamed DTE Energy Electric Company, itself a subsidiary of DTE Energy), charged in the ownership, operation and maintenance of Detroit Edison's transmission system.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d3">["hp_1199b329dbff9419"]</data>
  <data key="d4">False</data>
</node>
<node id="DTE Energy Electric Company">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "DTE Energy Electric Company is the renamed version of Detroit Edison.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d2">[{"text": "ITC Transmission was founded in 1999 as International Transmission Co., a subsidiary of Detroit Edison (since renamed DTE Energy Electric Company, itself a subsidiary of DTE Energy), charged in the ownership, operation and maintenance of Detroit Edison's transmission system.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d3">["hp_1199b329dbff9419"]</data>
  <data key="d4">False</data>
</node>
<node id="DTE Energy">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "DTE Energy is the parent company of DTE Energy Electric Company.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d2">[{"text": "ITC Transmission was founded in 1999 as International Transmission Co., a subsidiary of Detroit Edison (since renamed DTE Energy Electric Company, itself a subsidiary of DTE Energy), charged in the ownership, operation and maintenance of Detroit Edison's transmission system.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d3">["hp_1199b329dbff9419"]</data>
  <data key="d4">False</data>
</node>
<node id="ITC Holdings Corp.">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "ITC Holdings Corp. is the parent company of ITC Transmission.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d2">[{"text": "In 2003, DTE sold the subsidiary to ITC Holdings Corp.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d3">["hp_1199b329dbff9419"]</data>
  <data key="d4">False</data>
</node>
<node id="electricity transmission company">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A company that transmits electricity.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d2">[{"text": "In 2004, ITC Transmission became the first, fully independent electricity transmission company in the United States following the 2003 transfer of ownership from DTE Energy to ITC Transmission’s parent company, ITC Holdings Corp.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d3">["hp_1199b329dbff9419"]</data>
  <data key="d4">False</data>
</node>
<node id="high-voltage system">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A system that transmits electricity at high voltage.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d2">[{"text": "ITC Transmission owns a fully regulated, high-voltage system that transmits electricity to local electricity distribution facilities.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d3">["hp_1199b329dbff9419"]</data>
  <data key="d4">False</data>
</node>
<node id="electricity">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A form of energy that is transmitted by ITC Transmission.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d2">[{"text": "ITC Transmission owns a fully regulated, high-voltage system that transmits electricity to local electricity distribution facilities.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d3">["hp_1199b329dbff9419"]</data>
  <data key="d4">False</data>
</node>
<node id="local electricity distribution facilities">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Facilities that distribute electricity locally.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d2">[{"text": "ITC Transmission owns a fully regulated, high-voltage system that transmits electricity to local electricity distribution facilities.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d3">["hp_1199b329dbff9419"]</data>
  <data key="d4">False</data>
</node>
<node id="Novi, Michigan">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The headquarters of ITC Holdings Corp.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d2">[{"text": "ITC Holdings Corp. () became a publicly traded company in 2005 and is headquartered in Novi, Michigan.", "chunk_id": "f936ea1678ff51f5", "doc_id": "hp_1199b329dbff9419"}]</data>
  <data key="d3">["hp_1199b329dbff9419"]</data>
  <data key="d4">False</data>
</node>
<node id="St. Lucia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "An island that was a French Colony and was captured by British forces.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d2">[{"text": "The Capture of St Lucia was the result of a campaign by British land and naval forces to capture the island of St Lucia, which was a French Colony.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d3">["hp_11c2671edfb8f605"]</data>
  <data key="d4">False</data>
</node>
<node id="Capture of St Lucia">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A campaign by British land and naval forces to capture the island of St Lucia from the French.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d2">[{"text": "The Capture of St Lucia was the result of a campaign by British land and naval forces to capture the island of St Lucia, which was a French Colony.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d3">["hp_11c2671edfb8f605"]</data>
  <data key="d4">False</data>
</node>
<node id="British land and naval forces">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The military forces of Britain involved in the campaign to capture St. Lucia.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d2">[{"text": "The Capture of St Lucia was the result of a campaign by British land and naval forces to capture the island of St Lucia, which was a French Colony.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d3">["hp_11c2671edfb8f605"]</data>
  <data key="d4">False</data>
</node>
<node id="French Colony">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A colony belonging to France.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d2">[{"text": "The Capture of St Lucia was the result of a campaign by British land and naval forces to capture the island of St Lucia, which was a French Colony.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d3">["hp_11c2671edfb8f605"]</data>
  <data key="d4">False</data>
</node>
<node id="Britain">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A country whose forces were involved in military actions against French forces.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}, {"text": "The country of origin for the rider Bob Oakley.", "chunk_id": "3f37f1d57cb3f639", "doc_id": "hp_71501f4cf0223b43"}, {"text": "A location where the racehorse Military Attack showed promising form in 2011.", "chunk_id": "4f018bc3fcafe69c", "doc_id": "hp_9e4b0099b07c257e"}, {"text": "A country where Dancing on Ice has been a prime-time hit.", "chunk_id": "11198ab313088443", "doc_id": "hp_d35c5fabe367cde8"}]</data>
  <data key="d2">[{"text": "Britain's actions followed the capture of the British controlled island of Dominica by French forces after a surprise invasion in September 1778.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}, {"text": "Second was Welshman Freddie Williams on 13 points, with Britain's Bob Oakley third on 12 points.", "chunk_id": "3f37f1d57cb3f639", "doc_id": "hp_71501f4cf0223b43"}, {"text": "Unraced as a two-year-old he showed promising form in Britain in 2011 before being sold to race in Hong Kong.", "chunk_id": "4f018bc3fcafe69c", "doc_id": "hp_9e4b0099b07c257e"}, {"text": "The format, devised by London Weekend Television and Granada Television for ITV, has been a prime-time hit in eight different countries, including Britain and subsequently in Italy and Chile.", "chunk_id": "11198ab313088443", "doc_id": "hp_d35c5fabe367cde8"}]</data>
  <data key="d3">["hp_11c2671edfb8f605", "hp_71501f4cf0223b43", "hp_9e4b0099b07c257e", "hp_d35c5fabe367cde8"]</data>
  <data key="d4">False</data>
</node>
<node id="Dominica">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "An island controlled by the British that was captured by French forces.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d2">[{"text": "Britain's actions followed the capture of the British controlled island of Dominica by French forces after a surprise invasion in September 1778.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d3">["hp_11c2671edfb8f605"]</data>
  <data key="d4">False</data>
</node>
<node id="French forces">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The military forces of France involved in capturing Dominica and reinforcing St. Lucia.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d2">[{"text": "Britain's actions followed the capture of the British controlled island of Dominica by French forces after a surprise invasion in September 1778.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d3">["hp_11c2671edfb8f605"]</data>
  <data key="d4">False</data>
</node>
<node id="Battle of St. Lucia">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A battle where the British fleet defeated a French fleet sent to reinforce St. Lucia.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d2">[{"text": "During the Battle of St. Lucia the British fleet defeated a French fleet sent to reinforced the island, and a few days later French troops were soundly defeated by British troops during the Battle of Morne de la Vierge.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d3">["hp_11c2671edfb8f605"]</data>
  <data key="d4">False</data>
</node>
<node id="British fleet">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The naval forces of Britain that participated in the Battle of St. Lucia.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d2">[{"text": "During the Battle of St. Lucia the British fleet defeated a French fleet sent to reinforced the island, and a few days later French troops were soundly defeated by British troops during the Battle of Morne de la Vierge.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d3">["hp_11c2671edfb8f605"]</data>
  <data key="d4">False</data>
</node>
<node id="French fleet">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The naval forces of France that were sent to reinforce St. Lucia.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d2">[{"text": "During the Battle of St. Lucia the British fleet defeated a French fleet sent to reinforced the island, and a few days later French troops were soundly defeated by British troops during the Battle of Morne de la Vierge.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d3">["hp_11c2671edfb8f605"]</data>
  <data key="d4">False</data>
</node>
<node id="British troops">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The land forces of Britain that defeated French troops during the Battle of Morne de la Vierge.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d2">[{"text": "During the Battle of St. Lucia the British fleet defeated a French fleet sent to reinforced the island, and a few days later French troops were soundly defeated by British troops during the Battle of Morne de la Vierge.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d3">["hp_11c2671edfb8f605"]</data>
  <data key="d4">False</data>
</node>
<node id="Battle of Morne de la Vierge">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A battle where British troops defeated French troops.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d2">[{"text": "During the Battle of St. Lucia the British fleet defeated a French fleet sent to reinforced the island, and a few days later French troops were soundly defeated by British troops during the Battle of Morne de la Vierge.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d3">["hp_11c2671edfb8f605"]</data>
  <data key="d4">False</data>
</node>
<node id="French garrison">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The French military forces stationed on St. Lucia that surrendered.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d2">[{"text": "Realising that another British fleet would arrive shortly with reinforcements, the French garrison surrendered.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d3">["hp_11c2671edfb8f605"]</data>
  <data key="d4">False</data>
</node>
<node id="Martinique">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location to which the French fleet returned after leaving St. Lucia.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d2">[{"text": "The remaining French troops were evacuated and the French fleet returned to Martinique, leaving the island in the hands of the British.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}]</data>
  <data key="d3">["hp_11c2671edfb8f605"]</data>
  <data key="d4">False</data>
</node>
<node id="R23 highway">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Russian federal motorway that runs from St. Petersburg through Pskov until the border with Belarus.", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d2">[{"text": "R23 highway (Russia)", "chunk_id": "5d5f281fa6cfe100", "doc_id": "hp_11fde9e76326875f"}]</data>
  <data key="d3">["hp_11fde9e76326875f"]</data>
  <data key="d4">False</data>
</node>
