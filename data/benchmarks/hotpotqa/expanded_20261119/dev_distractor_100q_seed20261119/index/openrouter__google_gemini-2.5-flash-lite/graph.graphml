  <data key="d7">[{"text": "With the help of John Cage and his agent Mimi Johnson, Zaj also toured in different cities in the United States in the late 1970s.", "chunk_id": "b647f648f08782f6", "doc_id": "hp_205b52451626bfb6", "type": "AGENT_OF"}]</data>
  <data key="d8">hp_205b52451626bfb6</data>
</edge>
<edge source="Milan" target="Italy">
  <data key="d5">["LOCATED_IN", "LOCATED_IN"]</data>
  <data key="d6">Milan is located in Italy.</data>
  <data key="d7">[{"text": "Zaj was an experimental music and performance art group formed in 1959 in Milan, Italy by composers and intermedia artists Walter Marchetti and Juan Hidalgo with the support of the American composer John Cage.", "chunk_id": "b647f648f08782f6", "doc_id": "hp_205b52451626bfb6", "type": "LOCATED_IN"}, {"text": "The tour began on April 2, 2013, in Milan, Italy and finished on September 20, 2015, in São Paulo, Brazil.", "chunk_id": "fbf2e81187688813", "doc_id": "hp_bf77c9d36b5389d5", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_205b52451626bfb6</data>
</edge>
