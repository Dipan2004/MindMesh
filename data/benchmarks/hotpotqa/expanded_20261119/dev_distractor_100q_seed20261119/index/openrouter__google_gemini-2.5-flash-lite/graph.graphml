  <data key="d8">hp_9be184228ee1e48d</data>
</edge>
<edge source="Port Macquarie" target="Port Macquarie-Hastings">
  <data key="d5">["PART_OF"]</data>
  <data key="d6">Port Macquarie is a coastal town in the local government area of Port Macquarie-Hastings.</data>
  <data key="d7">[{"text": "Port Macquarie is a coastal town in the local government area of Port Macquarie-Hastings.", "chunk_id": "6223f89935ee9cfe", "doc_id": "hp_de00d7ebc47399cc", "type": "PART_OF"}]</data>
  <data key="d8">hp_de00d7ebc47399cc</data>
</edge>
<edge source="Port Macquarie" target="Mid North Coast">
  <data key="d5">["LOCATED_IN"]</data>
