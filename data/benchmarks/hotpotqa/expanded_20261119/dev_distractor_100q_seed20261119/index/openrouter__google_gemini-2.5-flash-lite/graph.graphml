  <data key="d2">[{"text": "The song was released in October 2006 and peaked at No. 15 on the RIANZ Singles Chart in New Zealand and number one on the ARIA Singles Chart, making it Evermore's most successful single in Australia.", "chunk_id": "d4c212cc890b725d", "doc_id": "hp_b314ee58b364424a"}]</data>
