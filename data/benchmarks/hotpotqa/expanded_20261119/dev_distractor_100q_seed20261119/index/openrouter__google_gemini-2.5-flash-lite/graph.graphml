<node id="The Holocaust">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A genocide in which Adolf Hitler's Nazi Germany and its World War II collaborators killed some six million European Jews.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d2">[{"text": "The Holocaust, also referred to as the Shoah, was a genocide in which Adolf Hitler's Nazi Germany and its World War II collaborators killed some six million European Jews.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d3">["hp_58dc44606385cdf1"]</data>
  <data key="d4">False</data>
</node>
<node id="Shoah">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Another name for the Holocaust, a genocide.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}, {"text": "Another name for the Holocaust, referred to in Hebrew.", "chunk_id": "b24df285a9cc0262", "doc_id": "hp_ea0eba1a0f59fdf8"}]</data>
  <data key="d2">[{"text": "The Holocaust, also referred to as the Shoah, was a genocide in which Adolf Hitler's Nazi Germany and its World War II collaborators killed some six million European Jews.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}, {"text": "Also referred to as the Shoah (in Hebrew), the Holocaust was a genocide in which some six million European Jews were killed by Nazi Germany and its World War II collaborators.", "chunk_id": "b24df285a9cc0262", "doc_id": "hp_ea0eba1a0f59fdf8"}]</data>
  <data key="d3">["hp_58dc44606385cdf1", "hp_ea0eba1a0f59fdf8"]</data>
  <data key="d4">False</data>
</node>
<node id="Adolf Hitler">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Leader associated with Nazi Germany during the Holocaust.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d2">[{"text": "The Holocaust, also referred to as the Shoah, was a genocide in which Adolf Hitler's Nazi Germany and its World War II collaborators killed some six million European Jews.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d3">["hp_58dc44606385cdf1"]</data>
  <data key="d4">False</data>
</node>
<node id="Nazi Germany">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The regime led by Adolf Hitler during World War II, responsible for the Holocaust.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}, {"text": "Nazi Germany was involved in dealings with William de Ropp before and during the Second World War.", "chunk_id": "c718da7aed95bfa4", "doc_id": "hp_6693cb8c76cc99b6"}, {"text": "The German state from 1933 to 1945, led by Adolf Hitler and the Nazi Party.", "chunk_id": "b24df285a9cc0262", "doc_id": "hp_ea0eba1a0f59fdf8"}]</data>
  <data key="d2">[{"text": "The Holocaust, also referred to as the Shoah, was a genocide in which Adolf Hitler's Nazi Germany and its World War II collaborators killed some six million European Jews.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}, {"text": "Baron William Sylvester de Ropp, originally Sylvester Wilhelm Gotthard von der Ropp (12 December 1886 - 1973 ) was a British agent involved in dealings with Nazi Germany before and during the Second World War.", "chunk_id": "c718da7aed95bfa4", "doc_id": "hp_6693cb8c76cc99b6"}, {"text": "Also referred to as the Shoah (in Hebrew), the Holocaust was a genocide in which some six million European Jews were killed by Nazi Germany and its World War II collaborators.", "chunk_id": "b24df285a9cc0262", "doc_id": "hp_ea0eba1a0f59fdf8"}]</data>
  <data key="d3">["hp_58dc44606385cdf1", "hp_6693cb8c76cc99b6", "hp_ea0eba1a0f59fdf8"]</data>
  <data key="d4">False</data>
</node>
<node id="European Jews">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The primary victims of the Holocaust, with approximately six million killed.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}, {"text": "Jewish people who resided in Europe.", "chunk_id": "b24df285a9cc0262", "doc_id": "hp_ea0eba1a0f59fdf8"}]</data>
  <data key="d2">[{"text": "The Holocaust, also referred to as the Shoah, was a genocide in which Adolf Hitler's Nazi Germany and its World War II collaborators killed some six million European Jews.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}, {"text": "Also referred to as the Shoah (in Hebrew), the Holocaust was a genocide in which some six million European Jews were killed by Nazi Germany and its World War II collaborators.", "chunk_id": "b24df285a9cc0262", "doc_id": "hp_ea0eba1a0f59fdf8"}]</data>
  <data key="d3">["hp_58dc44606385cdf1", "hp_ea0eba1a0f59fdf8"]</data>
  <data key="d4">False</data>
</node>
<node id="children">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A significant portion of the Holocaust victims, with 1.5 million killed.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d2">[{"text": "The victims included 1.5 million children and constituted about two-thirds of the nine million Jews in Continental Europe.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d3">["hp_58dc44606385cdf1"]</data>
  <data key="d4">False</data>
</node>
<node id="Jews in Continental Europe">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The population group from which two-thirds of the victims of the Holocaust were drawn.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d2">[{"text": "The victims included 1.5 million children and constituted about two-thirds of the nine million Jews in Continental Europe.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d3">["hp_58dc44606385cdf1"]</data>
  <data key="d4">False</data>
</node>
<node id="Roma">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A non-Jewish ethnic group considered victims in a broader definition of the Holocaust.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d2">[{"text": "A broader definition of the Holocaust includes non-Jewish victims such as the Roma, ethnic Poles, other Slavic ethnic groups, and the disabled and mentally ill.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d3">["hp_58dc44606385cdf1"]</data>
  <data key="d4">False</data>
</node>
<node id="ethnic Poles">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A non-Jewish ethnic group considered victims in a broader definition of the Holocaust.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d2">[{"text": "A broader definition of the Holocaust includes non-Jewish victims such as the Roma, ethnic Poles, other Slavic ethnic groups, and the disabled and mentally ill.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d3">["hp_58dc44606385cdf1"]</data>
  <data key="d4">False</data>
</node>
<node id="other Slavic ethnic groups">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Non-Jewish ethnic groups considered victims in a broader definition of the Holocaust.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d2">[{"text": "A broader definition of the Holocaust includes non-Jewish victims such as the Roma, ethnic Poles, other Slavic ethnic groups, and the disabled and mentally ill.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d3">["hp_58dc44606385cdf1"]</data>
  <data key="d4">False</data>
</node>
<node id="the disabled and mentally ill">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Groups considered victims in a broader definition of the Holocaust.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d2">[{"text": "A broader definition of the Holocaust includes non-Jewish victims such as the Roma, ethnic Poles, other Slavic ethnic groups, and the disabled and mentally ill.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d3">["hp_58dc44606385cdf1"]</data>
  <data key="d4">False</data>
</node>
<node id="Soviet citizens">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A group included in an even broader definition of Holocaust victims.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d2">[{"text": "An even broader definition includes Soviet citizens and prisoners of war, homosexuals, Jehovah's Witnesses, black people, and political opponents of the Nazis.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d3">["hp_58dc44606385cdf1"]</data>
  <data key="d4">False</data>
</node>
<node id="prisoners of war">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A group included in an even broader definition of Holocaust victims.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}, {"text": "Individuals who were held captive during wartime and are eligible for the Escapees' Medal if they escaped or died attempting to escape.", "chunk_id": "cd19157192f4048d", "doc_id": "hp_e60b5baaa105aa72"}]</data>
  <data key="d2">[{"text": "An even broader definition includes Soviet citizens and prisoners of war, homosexuals, Jehovah's Witnesses, black people, and political opponents of the Nazis.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}, {"text": "The Escapees' Medal (French: \"Médaille des Évadés\" ) is a military award bestowed by the government of France to individuals who were prisoners of war and who successfully escaped internment or died as a result of their escape attempt.", "chunk_id": "cd19157192f4048d", "doc_id": "hp_e60b5baaa105aa72"}]</data>
  <data key="d3">["hp_58dc44606385cdf1", "hp_e60b5baaa105aa72"]</data>
  <data key="d4">False</data>
</node>
<node id="homosexuals">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A group included in an even broader definition of Holocaust victims.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d2">[{"text": "An even broader definition includes Soviet citizens and prisoners of war, homosexuals, Jehovah's Witnesses, black people, and political opponents of the Nazis.", "chunk_id": "0b6495ca8fb3c7ab", "doc_id": "hp_58dc44606385cdf1"}]</data>
  <data key="d3">["hp_58dc44606385cdf1"]</data>
  <data key="d4">False</data>
</node>
<node id="Jehovah's Witnesses">
  <data key="d0">OTHER</data>
