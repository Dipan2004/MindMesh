  <data key="d7">[{"text": "Subsequent albums shared this style, and the band landed a number of hits with \"Every Morning\" and \"Someday\" from \"\" and \"When It's Over\" from their self-titled album.", "chunk_id": "ca10670f4e9a955b", "doc_id": "hp_5682f3a022ba8ac2", "type": "RELEASED"}]</data>
