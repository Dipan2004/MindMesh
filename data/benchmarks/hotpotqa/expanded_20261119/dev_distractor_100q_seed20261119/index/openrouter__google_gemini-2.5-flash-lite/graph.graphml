<node id="Philippines">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Philippines is a country where Ayala Malls are located.", "chunk_id": "00d6e00c58449962", "doc_id": "hp_1223b1c0f959c0b7"}, {"text": "The Philippines is a sovereign country in Southeast Asia.", "chunk_id": "851db6962c10e795", "doc_id": "hp_13b0e7c83e58b31d"}, {"text": "A country in Southeast Asia.", "chunk_id": "e1d593be07df808c", "doc_id": "hp_cb1242fdf9501f1e"}]</data>
  <data key="d2">[{"text": "Founded in 1988, Ayala Malls own a chain of large shopping malls, all located in the Philippines.", "chunk_id": "00d6e00c58449962", "doc_id": "hp_1223b1c0f959c0b7"}, {"text": "Bonifacio High Street is a mixed-use development in Bonifacio Global City, Taguig, Metro Manila, Philippines located just near Serendra, Market! Market! and SM Aura Premier.", "chunk_id": "851db6962c10e795", "doc_id": "hp_13b0e7c83e58b31d"}, {"text": "Carmelray Industrial Park 2 or (CIP2), is an industrial park in the Philippines, located at barangay Punta, Calamba City, Laguna, this industrial zone serves some of the biggest and nearest companies in Calamba.", "chunk_id": "e1d593be07df808c", "doc_id": "hp_cb1242fdf9501f1e"}]</data>
  <data key="d3">["hp_1223b1c0f959c0b7", "hp_13b0e7c83e58b31d", "hp_cb1242fdf9501f1e"]</data>
  <data key="d4">False</data>
</node>
<node id="SM Supermalls">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "SM Supermalls is a shopping mall retailer in the Philippines.", "chunk_id": "00d6e00c58449962", "doc_id": "hp_1223b1c0f959c0b7"}]</data>
  <data key="d2">[{"text": "Ayala Malls is the one of the largest shopping mall retailer in the Philippines, along with SM Supermalls and Robinsons Malls.", "chunk_id": "00d6e00c58449962", "doc_id": "hp_1223b1c0f959c0b7"}]</data>
  <data key="d3">["hp_1223b1c0f959c0b7"]</data>
  <data key="d4">False</data>
</node>
