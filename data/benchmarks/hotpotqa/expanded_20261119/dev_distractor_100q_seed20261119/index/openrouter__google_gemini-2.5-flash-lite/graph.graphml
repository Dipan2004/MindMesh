  <data key="d5">["RESPONSIBLE_FOR"]</data>
  <data key="d6">The nature conservation authorities of the Celle district are responsible for the Kiehnmoor reserve.</data>
  <data key="d7">[{"text": "The nature conservation authorities of these districts are responsible for the reserve.", "chunk_id": "582723cb6f560140", "doc_id": "hp_5fffbcc1125c9880", "type": "RESPONSIBLE_FOR"}]</data>
  <data key="d8">hp_5fffbcc1125c9880</data>
</edge>
