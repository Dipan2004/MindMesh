</node>
<node id="Japanese navy">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The naval forces of Japan, which were ordered to avoid direct engagement with the Joseon navy after the Battle of Hansan Island.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d2">[{"text": "After Hansan-do Toyotomi Hideyoshi ordered the Japanese navy to avoid direct engagement with the Joseon navy and instead station itself in fortifications along the coast to defend important sea lands.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
