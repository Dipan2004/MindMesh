<node id="Huron Road">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The former name of Center Street.", "chunk_id": "015a08864b0b59a3", "doc_id": "hp_0fac18ff47357f6d"}]</data>
  <data key="d2">[{"text": "Once known as Huron Road, Center Street runs current with Ohio State Route 511 and Ohio State Route 60, which travels the entire length of Ohio.", "chunk_id": "015a08864b0b59a3", "doc_id": "hp_0fac18ff47357f6d"}]</data>
