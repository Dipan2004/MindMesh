<edge source="RT Rail" target="Ealing Community Transport (ECT)">
  <data key="d5">["SUBSIDIARY_OF"]</data>
  <data key="d6">RT Rail was a subsidiary of Ealing Community Transport (ECT).</data>
  <data key="d7">[{"text": "RT Rail was a small British railway spot-hire company, a subsidiary of Ealing Community Transport (ECT), that specialised in Class 08 shunting locomotives.", "chunk_id": "0b2d1c38faa33c81", "doc_id": "hp_606b6b7ccce7aff0", "type": "SUBSIDIARY_OF"}]</data>
