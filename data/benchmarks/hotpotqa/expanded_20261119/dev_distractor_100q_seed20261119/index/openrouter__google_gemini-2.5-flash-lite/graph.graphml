  <data key="d2">[{"text": "\"Misunderstood\" is a power ballad by the American heavy metal band Mötley Crüe, released on their 1994 eponymous album.", "chunk_id": "624e18b05fcc8d7f", "doc_id": "hp_1b0a2bc66f05d3d7"}]</data>
  <data key="d3">["hp_1b0a2bc66f05d3d7"]</data>
  <data key="d4">False</data>
</node>
<node id="Mötley Crüe">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An American heavy metal band.", "chunk_id": "624e18b05fcc8d7f", "doc_id": "hp_1b0a2bc66f05d3d7"}, {"text": "An American heavy metal band.", "chunk_id": "c57fbc208f9c8aea", "doc_id": "hp_3835f9a65d3f6cf8"}, {"text": "Mötley Crüe is a band that John Corabi was previously a part of.", "chunk_id": "b2f9c45a132af4aa", "doc_id": "hp_9bd16802d05d1fe0"}, {"text": "An American heavy metal band.", "chunk_id": "c9bbbe3c308c2b93", "doc_id": "hp_b1506249f268430c"}]</data>
  <data key="d2">[{"text": "\"Misunderstood\" is a power ballad by the American heavy metal band Mötley Crüe, released on their 1994 eponymous album.", "chunk_id": "624e18b05fcc8d7f", "doc_id": "hp_1b0a2bc66f05d3d7"}, {"text": "Mötley Crüe is the eponymous sixth studio album by American heavy metal band Mötley Crüe.", "chunk_id": "c57fbc208f9c8aea", "doc_id": "hp_3835f9a65d3f6cf8"}, {"text": "Union is an American rock group formed in 1997 featuring lead vocalist and guitarist John Corabi (ex-The Scream and Mötley Crüe), guitarist Bruce Kulick (ex-Kiss), bassist James Hunting (David Lee Roth and Eddie Money), and drummer Brent Fitz (Slash).", "chunk_id": "b2f9c45a132af4aa", "doc_id": "hp_9bd16802d05d1fe0"}, {"text": "\"Hooligan's Holiday\" is a song by American heavy metal band, Mötley Crüe, released on their 1994 eponymous album.", "chunk_id": "c9bbbe3c308c2b93", "doc_id": "hp_b1506249f268430c"}]</data>
  <data key="d3">["hp_1b0a2bc66f05d3d7", "hp_3835f9a65d3f6cf8", "hp_9bd16802d05d1fe0", "hp_b1506249f268430c"]</data>
  <data key="d4">False</data>
</node>
<node id="1994 eponymous album">
  <data key="d0">ALBUM</data>
  <data key="d1">[{"text": "The 1994 eponymous album by Mötley Crüe.", "chunk_id": "624e18b05fcc8d7f", "doc_id": "hp_1b0a2bc66f05d3d7"}, {"text": "The 1994 album by Mötley Crüe, which features the song 'Hooligan's Holiday'.", "chunk_id": "c9bbbe3c308c2b93", "doc_id": "hp_b1506249f268430c"}]</data>
  <data key="d2">[{"text": "\"Misunderstood\" is a power ballad by the American heavy metal band Mötley Crüe, released on their 1994 eponymous album.", "chunk_id": "624e18b05fcc8d7f", "doc_id": "hp_1b0a2bc66f05d3d7"}, {"text": "\"Hooligan's Holiday\" is a song by American heavy metal band, Mötley Crüe, released on their 1994 eponymous album.", "chunk_id": "c9bbbe3c308c2b93", "doc_id": "hp_b1506249f268430c"}]</data>
  <data key="d3">["hp_1b0a2bc66f05d3d7", "hp_b1506249f268430c"]</data>
  <data key="d4">False</data>
</node>
<node id="John Corabi">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Vocalist and guitarist for Mötley Crüe.", "chunk_id": "624e18b05fcc8d7f", "doc_id": "hp_1b0a2bc66f05d3d7"}, {"text": "Former vocalist of The Scream and replacement for Vince Neil in Mötley Crüe.", "chunk_id": "c57fbc208f9c8aea", "doc_id": "hp_3835f9a65d3f6cf8"}, {"text": "John Corabi is the lead vocalist and guitarist for the band Union.", "chunk_id": "b2f9c45a132af4aa", "doc_id": "hp_9bd16802d05d1fe0"}, {"text": "Vocalist and rhythm guitarist who wrote the lyrics for 'Hooligan's Holiday'.", "chunk_id": "c9bbbe3c308c2b93", "doc_id": "hp_b1506249f268430c"}, {"text": "John Corabi was a previous member of the band Brides of Destruction, playing rhythm guitar.", "chunk_id": "d7b89ee6722d4043", "doc_id": "hp_dfded5f3a8af70af"}]</data>
  <data key="d2">[{"text": "The lyrics were written by vocalist/guitarist John Corabi and bassist Nikki Sixx, while the music was written by Corabi, Sixx, drummer Tommy Lee and guitarist Mick Mars.", "chunk_id": "624e18b05fcc8d7f", "doc_id": "hp_1b0a2bc66f05d3d7"}, {"text": "Neil was replaced by former The Scream vocalist John Corabi on the album.", "chunk_id": "c57fbc208f9c8aea", "doc_id": "hp_3835f9a65d3f6cf8"}, {"text": "Union is an American rock group formed in 1997 featuring lead vocalist and guitarist John Corabi (ex-The Scream and Mötley Crüe), guitarist Bruce Kulick (ex-Kiss), bassist James Hunting (David Lee Roth and Eddie Money), and drummer Brent Fitz (Slash).", "chunk_id": "b2f9c45a132af4aa", "doc_id": "hp_9bd16802d05d1fe0"}, {"text": "The lyrics to the song were written by vocalist/rhythm guitarist John Corabi and bassist Nikki Sixx, while the music was written by Corabi, Sixx, drummer Tommy Lee and guitarist Mick Mars.", "chunk_id": "c9bbbe3c308c2b93", "doc_id": "hp_b1506249f268430c"}, {"text": "Previous members of the band were Nikki Sixx (bass), Kris Kohls (drums), Adam Hamilton (keyboard), John Corabi (rhythm guitar), Scott Sorry (bass) and Ginger (rhythm guitar).", "chunk_id": "d7b89ee6722d4043", "doc_id": "hp_dfded5f3a8af70af"}]</data>
  <data key="d3">["hp_1b0a2bc66f05d3d7", "hp_3835f9a65d3f6cf8", "hp_9bd16802d05d1fe0", "hp_b1506249f268430c", "hp_dfded5f3a8af70af"]</data>
  <data key="d4">False</data>
</node>
