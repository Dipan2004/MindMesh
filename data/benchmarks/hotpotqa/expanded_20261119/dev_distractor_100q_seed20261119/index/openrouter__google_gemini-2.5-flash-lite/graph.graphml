<node id="Carl Sagan">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The presenter of the 1980 television series \"Cosmos\".", "chunk_id": "fcc0f6c36b9c6443", "doc_id": "hp_48076015d5a62427"}]</data>
  <data key="d2">[{"text": "The show is a follow-up to the 1980 television series \"\", which was presented by Carl Sagan on the Public Broadcasting Service and is considered a milestone for scientific documentaries.", "chunk_id": "fcc0f6c36b9c6443", "doc_id": "hp_48076015d5a62427"}]</data>
  <data key="d3">["hp_48076015d5a62427"]</data>
  <data key="d4">False</data>
</node>
<node id="Public Broadcasting Service">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The broadcasting service where the 1980 \"Cosmos\" series was presented.", "chunk_id": "fcc0f6c36b9c6443", "doc_id": "hp_48076015d5a62427"}]</data>
  <data key="d2">[{"text": "The show is a follow-up to the 1980 television series \"\", which was presented by Carl Sagan on the Public Broadcasting Service and is considered a milestone for scientific documentaries.", "chunk_id": "fcc0f6c36b9c6443", "doc_id": "hp_48076015d5a62427"}]</data>
  <data key="d3">["hp_48076015d5a62427"]</data>
  <data key="d4">False</data>
</node>
<node id="Neil deGrasse Tyson">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The astrophysicist who presents the \"Cosmos: A Spacetime Odyssey\" series.", "chunk_id": "fcc0f6c36b9c6443", "doc_id": "hp_48076015d5a62427"}]</data>
  <data key="d2">[{"text": "The show is presented by astrophysicist Neil deGrasse Tyson, who, as a young high school student, was inspired by Sagan.", "chunk_id": "fcc0f6c36b9c6443", "doc_id": "hp_48076015d5a62427"}]</data>
  <data key="d3">["hp_48076015d5a62427"]</data>
  <data key="d4">False</data>
</node>
<node id="Seth MacFarlane">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An executive producer of \"Cosmos: A Spacetime Odyssey\" whose financial investment was instrumental in bringing the show to broadcast television.", "chunk_id": "fcc0f6c36b9c6443", "doc_id": "hp_48076015d5a62427"}]</data>
  <data key="d2">[{"text": "Among the executive producers are Seth MacFarlane, whose financial investment was instrumental in bringing the show to broadcast television, and Ann Druyan, a co-author and co-creator of the original television series and Sagan's wife.", "chunk_id": "fcc0f6c36b9c6443", "doc_id": "hp_48076015d5a62427"}]</data>
  <data key="d3">["hp_48076015d5a62427"]</data>
  <data key="d4">False</data>
</node>
