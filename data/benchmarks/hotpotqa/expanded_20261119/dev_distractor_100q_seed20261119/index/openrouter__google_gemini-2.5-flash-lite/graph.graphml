<edge source="Black hole bomb" target="superradiant scattering">
  <data key="d5">["UTILIZES"]</data>
  <data key="d6">A black hole bomb is a physical effect that utilizes superradiant scattering.</data>
  <data key="d7">[{"text": "A black hole bomb is the name given to a physical effect utilizing how a bosonic field impinging on a rotating black hole can be amplified through superradiant scattering.", "chunk_id": "7e7db6cd424d1ca0", "doc_id": "hp_0a14829980a416a2", "type": "UTILIZES"}]</data>
  <data key="d8">hp_0a14829980a416a2</data>
</edge>
<edge source="Black hole bomb" target="superradiant instability">
  <data key="d5">["MECHANISM_IS"]</data>
  <data key="d6">Superradiant instability is the mechanism by which the black hole bomb functions.</data>
  <data key="d7">[{"text": "The mechanism by which the black hole bomb functions is called superradiant instability.", "chunk_id": "7e7db6cd424d1ca0", "doc_id": "hp_0a14829980a416a2", "type": "MECHANISM_IS"}]</data>
  <data key="d8">hp_0a14829980a416a2</data>
</edge>
<edge source="bosonic field" target="rotating black hole">
  <data key="d5">["IMPINGES_ON"]</data>
  <data key="d6">A bosonic field impinges on a rotating black hole.</data>
  <data key="d7">[{"text": "A black hole bomb is the name given to a physical effect utilizing how a bosonic field impinging on a rotating black hole can be amplified through superradiant scattering.", "chunk_id": "7e7db6cd424d1ca0", "doc_id": "hp_0a14829980a416a2", "type": "IMPINGES_ON"}]</data>
  <data key="d8">hp_0a14829980a416a2</data>
</edge>
<edge source="bosonic field" target="superradiant scattering">
  <data key="d5">["AMPLIFIED_BY"]</data>
  <data key="d6">A bosonic field can be amplified through superradiant scattering.</data>
  <data key="d7">[{"text": "A black hole bomb is the name given to a physical effect utilizing how a bosonic field impinging on a rotating black hole can be amplified through superradiant scattering.", "chunk_id": "7e7db6cd424d1ca0", "doc_id": "hp_0a14829980a416a2", "type": "AMPLIFIED_BY"}]</data>
  <data key="d8">hp_0a14829980a416a2</data>
</edge>
<edge source="bosonic field" target="Black hole bomb">
  <data key="d5">["PART_OF"]</data>
  <data key="d6">The bosonic field is a component or condition for the black hole bomb effect.</data>
  <data key="d7">[{"text": "An additional condition which must be met is that the field must have a rest mass different from zero.", "chunk_id": "7e7db6cd424d1ca0", "doc_id": "hp_0a14829980a416a2", "type": "PART_OF"}]</data>
  <data key="d8">hp_0a14829980a416a2</data>
</edge>
