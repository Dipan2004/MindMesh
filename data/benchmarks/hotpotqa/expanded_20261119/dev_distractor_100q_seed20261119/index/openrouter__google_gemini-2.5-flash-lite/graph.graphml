<node id="The Jane Austen Book Club (novel)">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A 2004 novel by Karen Joy Fowler.", "chunk_id": "960736ea8d07a2ff", "doc_id": "hp_dcfcbf551d8f7cb7"}]</data>
  <data key="d2">[{"text": "The screenplay, adapted from the 2004 novel of the same name by Karen Joy Fowler, focuses on a book club formed specifically to discuss the six novels written by Jane Austen.", "chunk_id": "960736ea8d07a2ff", "doc_id": "hp_dcfcbf551d8f7cb7"}]</data>
  <data key="d3">["hp_dcfcbf551d8f7cb7"]</data>
