<node id="Godwin Birchenough">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The Very Reverend Godwin Birchenough was an English clergyman and author.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d2">[{"text": "The Very Reverend Godwin Birchenough (27 October 1880, Macclesfield, Cheshire – 3 March, 1953) was the only son of Walter Edwin Birchenough and was the grandson of John Birchenough, a prominent Macclesfield silk manufacturer.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d3">["hp_b4ae5293eb8657fc"]</data>
  <data key="d4">False</data>
</node>
<node id="Walter Edwin Birchenough">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Walter Edwin Birchenough was the father of Godwin Birchenough.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d2">[{"text": "The Very Reverend Godwin Birchenough (27 October 1880, Macclesfield, Cheshire – 3 March, 1953) was the only son of Walter Edwin Birchenough and was the grandson of John Birchenough, a prominent Macclesfield silk manufacturer.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d3">["hp_b4ae5293eb8657fc"]</data>
  <data key="d4">False</data>
</node>
<node id="John Birchenough">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "John Birchenough was a prominent Macclesfield silk manufacturer and the grandfather of Godwin Birchenough.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d2">[{"text": "The Very Reverend Godwin Birchenough (27 October 1880, Macclesfield, Cheshire – 3 March, 1953) was the only son of Walter Edwin Birchenough and was the grandson of John Birchenough, a prominent Macclesfield silk manufacturer.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d3">["hp_b4ae5293eb8657fc"]</data>
  <data key="d4">False</data>
</node>
<node id="Sir Henry Birchenough">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Sir Henry Birchenough was the President of the British South Africa Company and an uncle of Godwin Birchenough.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d2">[{"text": "Godwin Birchenough, who was also a nephew of Sir Henry Birchenough, the President of the British South Africa Company, was educated at Rugby and Oriel College, Oxford.", "chunk_id": "d5ff55241924fd08", "doc_id": "hp_b4ae5293eb8657fc"}]</data>
  <data key="d3">["hp_b4ae5293eb8657fc"]</data>
  <data key="d4">False</data>
</node>
