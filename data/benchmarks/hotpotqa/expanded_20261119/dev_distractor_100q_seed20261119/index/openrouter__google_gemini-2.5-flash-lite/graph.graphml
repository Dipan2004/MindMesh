<node id="Australian Federated Union of Locomotive Enginemen">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Australian Federated Union of Locomotive Enginemen was an organization of which Eli James Harrison was an official and later president.", "chunk_id": "53f3bbd1c43e3155", "doc_id": "hp_7820faef8a00d610"}]</data>
  <data key="d2">[{"text": "He was an official of the Australian Federated Union of Locomotive Enginemen from 1930 to 1949, and was its president in 1948.", "chunk_id": "53f3bbd1c43e3155", "doc_id": "hp_7820faef8a00d610"}]</data>
