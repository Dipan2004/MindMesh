<node id="Elizabeth Sprague Coolidge">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Elizabeth Sprague Coolidge commissioned the ballet Apollo in 1927.", "chunk_id": "7d4e3a512ec3ac2c", "doc_id": "hp_9db3a175e11b24ac"}]</data>
  <data key="d2">[{"text": "The American patron of the arts Elizabeth Sprague Coolidge had commissioned the ballet in 1927 for a festival of contemporary music to be held the following year at the Library of Congress in Washington, D.C.", "chunk_id": "7d4e3a512ec3ac2c", "doc_id": "hp_9db3a175e11b24ac"}]</data>
  <data key="d3">["hp_9db3a175e11b24ac"]</data>
  <data key="d4">False</data>
</node>
