</node>
<node id="Kodak">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Kodak is a company that produces motion picture cinema film.", "chunk_id": "95552dd280ce88ab", "doc_id": "hp_fad0e22310177840"}]</data>
  <data key="d2">[{"text": "Cinestill Film creates photographic film for still cameras from Kodak's motion picture cinema film.", "chunk_id": "95552dd280ce88ab", "doc_id": "hp_fad0e22310177840"}]</data>
  <data key="d3">["hp_fad0e22310177840"]</data>
