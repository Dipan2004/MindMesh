</node>
<node id="Ingwald &quot;Ingo&quot; Preminger">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A film producer and literary agent.", "chunk_id": "11399d9e6ed9e2a4", "doc_id": "hp_2f3cd8d24b5f56f1"}]</data>
  <data key="d2">[{"text": "Ingwald \"Ingo\" Preminger (25 February 1911 in Czernowitz, Austria-Hungary (now Chernivtsi, Ukraine) – 7 June 2006 in Pacific Palisades, California) was a film producer.", "chunk_id": "11399d9e6ed9e2a4", "doc_id": "hp_2f3cd8d24b5f56f1"}]</data>
  <data key="d3">["hp_2f3cd8d24b5f56f1"]</data>
  <data key="d4">False</data>
</node>
<node id="Czernowitz">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The birthplace of Ingo Preminger, now Chernivtsi, Ukraine.", "chunk_id": "11399d9e6ed9e2a4", "doc_id": "hp_2f3cd8d24b5f56f1"}]</data>
  <data key="d2">[{"text": "Ingwald \"Ingo\" Preminger (25 February 1911 in Czernowitz, Austria-Hungary (now Chernivtsi, Ukraine) – 7 June 2006 in Pacific Palisades, California) was a film producer.", "chunk_id": "11399d9e6ed9e2a4", "doc_id": "hp_2f3cd8d24b5f56f1"}]</data>
  <data key="d3">["hp_2f3cd8d24b5f56f1"]</data>
  <data key="d4">False</data>
</node>
<node id="Austria-Hungary">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The historical country where Czernowitz was located at the time of Ingo Preminger's birth.", "chunk_id": "11399d9e6ed9e2a4", "doc_id": "hp_2f3cd8d24b5f56f1"}, {"text": "Austria-Hungary was the country of origin for Otto Preminger.", "chunk_id": "82bcd4a397a999ac", "doc_id": "hp_80a324515dfb8756"}]</data>
  <data key="d2">[{"text": "Ingwald \"Ingo\" Preminger (25 February 1911 in Czernowitz, Austria-Hungary (now Chernivtsi, Ukraine) – 7 June 2006 in Pacific Palisades, California) was a film producer.", "chunk_id": "11399d9e6ed9e2a4", "doc_id": "hp_2f3cd8d24b5f56f1"}, {"text": "Otto Ludwig Preminger ( , ] ; 5 December 1905 – 23 April 1986) was an American theatre and film director, originally from Austria-Hungary.", "chunk_id": "82bcd4a397a999ac", "doc_id": "hp_80a324515dfb8756"}]</data>
  <data key="d3">["hp_2f3cd8d24b5f56f1", "hp_80a324515dfb8756"]</data>
  <data key="d4">False</data>
</node>
<node id="Chernivtsi">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The current name of the city where Ingo Preminger was born, formerly Czernowitz.", "chunk_id": "11399d9e6ed9e2a4", "doc_id": "hp_2f3cd8d24b5f56f1"}]</data>
  <data key="d2">[{"text": "Ingwald \"Ingo\" Preminger (25 February 1911 in Czernowitz, Austria-Hungary (now Chernivtsi, Ukraine) – 7 June 2006 in Pacific Palisades, California) was a film producer.", "chunk_id": "11399d9e6ed9e2a4", "doc_id": "hp_2f3cd8d24b5f56f1"}]</data>
  <data key="d3">["hp_2f3cd8d24b5f56f1"]</data>
  <data key="d4">False</data>
</node>
<node id="Ukraine">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The country where Chernivtsi, the birthplace of Ingo Preminger, is currently located.", "chunk_id": "11399d9e6ed9e2a4", "doc_id": "hp_2f3cd8d24b5f56f1"}, {"text": "Ukraine is the current location of the Imperial Kharkiv Conservatory.", "chunk_id": "902ae288e12f1dfb", "doc_id": "hp_d0d1ade1227af443"}]</data>
  <data key="d2">[{"text": "Ingwald \"Ingo\" Preminger (25 February 1911 in Czernowitz, Austria-Hungary (now Chernivtsi, Ukraine) – 7 June 2006 in Pacific Palisades, California) was a film producer.", "chunk_id": "11399d9e6ed9e2a4", "doc_id": "hp_2f3cd8d24b5f56f1"}, {"text": "In 1874 he became a teacher and in 1878 director of music theory instruction at the Imperial Kharkiv Conservatory, in what is now Ukraine.", "chunk_id": "902ae288e12f1dfb", "doc_id": "hp_d0d1ade1227af443"}]</data>
  <data key="d3">["hp_2f3cd8d24b5f56f1", "hp_d0d1ade1227af443"]</data>
  <data key="d4">False</data>
</node>
