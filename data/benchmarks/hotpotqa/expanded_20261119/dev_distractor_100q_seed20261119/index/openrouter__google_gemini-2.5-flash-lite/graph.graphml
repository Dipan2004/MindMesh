<node id="Tsai Ming-liang">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The director of the short film 'The Skywalk Is Gone'.", "chunk_id": "35c0175244287063", "doc_id": "hp_0f9af0ba02de054d"}, {"text": "The writer and director of the film Face.", "chunk_id": "bf222019d166cecc", "doc_id": "hp_43d5603d87ef8a29"}, {"text": "The director of the 2014 film \"Journey to the West\".", "chunk_id": "622ee3b62c51dc89", "doc_id": "hp_4ec892d7236b016a"}, {"text": "Tsai Ming-liang is a film director whose films starred Chen Chao-jung.", "chunk_id": "b9f1ded51398adc0", "doc_id": "hp_4ed3904f8086a721"}, {"text": "Tsai Ming-liang is the director of the Taiwanese New Wave film Vive L'Amour.", "chunk_id": "8869b7186fadb9af", "doc_id": "hp_a8cea0bffbbab591"}, {"text": "Tsai Ming-liang is the director of the 2001 film What Time Is It There?.", "chunk_id": "a02ee8f00c70f3d0", "doc_id": "hp_aa32f692005a1346"}, {"text": "Tsai Ming-liang is a Taiwanese filmmaker born on October 27, 1957.", "chunk_id": "8489a252dab5e027", "doc_id": "hp_c5ca2a20b1d36543"}, {"text": "Tsai Ming-liang is the director of the 1997 Taiwanese film, The River.", "chunk_id": "7bffd42be46931a1", "doc_id": "hp_cf140eedea6d3843"}, {"text": "The director of the Taiwanese film 'Rebels of the Neon God'.", "chunk_id": "197489edd7e615b2", "doc_id": "hp_e2eedc11b3a4a9ee"}]</data>
  <data key="d2">[{"text": "The Skywalk is Gone (Mandarin name: Tianqiao bu jian le) is a 2002 Taiwanese short film directed by Tsai Ming-liang and starring Chen Shiang-chyi and Lee Kang-sheng.", "chunk_id": "35c0175244287063", "doc_id": "hp_0f9af0ba02de054d"}, {"text": "Face is a 2009 Taiwanese-French film written and directed by Tsai Ming-liang.", "chunk_id": "bf222019d166cecc", "doc_id": "hp_43d5603d87ef8a29"}, {"text": "Journey to the West () is a 2014 French-Taiwanese film directed by Tsai Ming-liang.", "chunk_id": "622ee3b62c51dc89", "doc_id": "hp_4ec892d7236b016a"}, {"text": "He is most famous for starring in several of Tsai Ming-liang's films, including \"Rebels of the Neon God\" and \"Vive L'Amour\".", "chunk_id": "b9f1ded51398adc0", "doc_id": "hp_4ed3904f8086a721"}, {"text": "Vive L'Amour is a 1994 Taiwanese New Wave film by Tsai Ming-liang.", "chunk_id": "8869b7186fadb9af", "doc_id": "hp_a8cea0bffbbab591"}, {"text": "What Time Is It There? (Chinese:《你那邊幾點》) is a 2001 film directed by Tsai Ming-liang.", "chunk_id": "a02ee8f00c70f3d0", "doc_id": "hp_aa32f692005a1346"}, {"text": "Tsai Ming-liang () (born 27 October 1957) is a Taiwanese filmmaker.", "chunk_id": "8489a252dab5e027", "doc_id": "hp_c5ca2a20b1d36543"}, {"text": "The River is a 1997 Taiwanese film directed by Tsai Ming-liang and starring Lee Kang-sheng, Miao Tien, and Lu Yi-ching.", "chunk_id": "7bffd42be46931a1", "doc_id": "hp_cf140eedea6d3843"}, {"text": "Rebels of the Neon God () is a 1992 Taiwanese film by Tsai Ming-liang.", "chunk_id": "197489edd7e615b2", "doc_id": "hp_e2eedc11b3a4a9ee"}]</data>
  <data key="d3">["hp_0f9af0ba02de054d", "hp_43d5603d87ef8a29", "hp_4ec892d7236b016a", "hp_4ed3904f8086a721", "hp_a8cea0bffbbab591", "hp_aa32f692005a1346", "hp_c5ca2a20b1d36543", "hp_cf140eedea6d3843", "hp_e2eedc11b3a4a9ee"]</data>
  <data key="d4">False</data>
</node>
<node id="Chen Shiang-chyi">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An actor in the short film 'The Skywalk Is Gone'.", "chunk_id": "35c0175244287063", "doc_id": "hp_0f9af0ba02de054d"}, {"text": "Chen Shiang-chyi is an actor in the 2001 film What Time Is It There?.", "chunk_id": "a02ee8f00c70f3d0", "doc_id": "hp_aa32f692005a1346"}]</data>
  <data key="d2">[{"text": "The Skywalk is Gone (Mandarin name: Tianqiao bu jian le) is a 2002 Taiwanese short film directed by Tsai Ming-liang and starring Chen Shiang-chyi and Lee Kang-sheng.", "chunk_id": "35c0175244287063", "doc_id": "hp_0f9af0ba02de054d"}, {"text": "It stars Lee Kang-sheng, Chen Shiang-chyi, and Lu Yi-Ching.", "chunk_id": "a02ee8f00c70f3d0", "doc_id": "hp_aa32f692005a1346"}]</data>
  <data key="d3">["hp_0f9af0ba02de054d", "hp_aa32f692005a1346"]</data>
  <data key="d4">False</data>
</node>
<node id="Lee Kang-sheng">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An actor in the short film 'The Skywalk Is Gone'.", "chunk_id": "35c0175244287063", "doc_id": "hp_0f9af0ba02de054d"}, {"text": "Lee Kang-sheng is an actor in the 2001 film What Time Is It There?.", "chunk_id": "a02ee8f00c70f3d0", "doc_id": "hp_aa32f692005a1346"}, {"text": "Lee Kang-sheng is an actor who starred in the 1997 Taiwanese film, The River.", "chunk_id": "7bffd42be46931a1", "doc_id": "hp_cf140eedea6d3843"}, {"text": "The actor who plays Hsiao Kang in 'Rebels of the Neon God'.", "chunk_id": "197489edd7e615b2", "doc_id": "hp_e2eedc11b3a4a9ee"}]</data>
  <data key="d2">[{"text": "The Skywalk is Gone (Mandarin name: Tianqiao bu jian le) is a 2002 Taiwanese short film directed by Tsai Ming-liang and starring Chen Shiang-chyi and Lee Kang-sheng.", "chunk_id": "35c0175244287063", "doc_id": "hp_0f9af0ba02de054d"}, {"text": "It stars Lee Kang-sheng, Chen Shiang-chyi, and Lu Yi-Ching.", "chunk_id": "a02ee8f00c70f3d0", "doc_id": "hp_aa32f692005a1346"}, {"text": "The River is a 1997 Taiwanese film directed by Tsai Ming-liang and starring Lee Kang-sheng, Miao Tien, and Lu Yi-ching.", "chunk_id": "7bffd42be46931a1", "doc_id": "hp_cf140eedea6d3843"}, {"text": "One details alienated buxiban student Hsiao Kang (Lee Kang-sheng) and his troubled interactions with his family.", "chunk_id": "197489edd7e615b2", "doc_id": "hp_e2eedc11b3a4a9ee"}]</data>
  <data key="d3">["hp_0f9af0ba02de054d", "hp_aa32f692005a1346", "hp_cf140eedea6d3843", "hp_e2eedc11b3a4a9ee"]</data>
  <data key="d4">False</data>
</node>
<node id="Freaky Eaters">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A documentary television series.", "chunk_id": "f7949c0c0e713fa5", "doc_id": "hp_0fa7f8efa8e13f38"}]</data>
  <data key="d2">[{"text": "Freaky Eaters is an American documentary television series based on the BBC series of the same name that aired on TLC.", "chunk_id": "f7949c0c0e713fa5", "doc_id": "hp_0fa7f8efa8e13f38"}]</data>
