<node id="R.C Gunn">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "R.C Gunn discovered Fuscospora gunnii in 1847.", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d2">[{"text": "It was discovered in 1847 by R.C Gunn and evidence exists that it once lived in Antarctica.", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d3">["hp_f4fcfac633a5b005"]</data>
  <data key="d4">False</data>
</node>
<node id="Antarctica">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Antarctica is a continent where evidence suggests Fuscospora gunnii once lived.", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d2">[{"text": "It was discovered in 1847 by R.C Gunn and evidence exists that it once lived in Antarctica.", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d3">["hp_f4fcfac633a5b005"]</data>
  <data key="d4">False</data>
</node>
<node id="F. Gunnii">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "F. Gunnii is an abbreviation for Fuscospora gunnii.", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d2">[{"text": "\"F. Gunnii\" was previously included in the genus \"Nothofagus\", although recent DNA analysis has placed it in the genus \"Fuscospora\".", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d3">["hp_f4fcfac633a5b005"]</data>
  <data key="d4">False</data>
</node>
<node id="Nothofagus">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Nothofagus is a genus that F. Gunnii was previously included in.", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d2">[{"text": "\"F. Gunnii\" was previously included in the genus \"Nothofagus\", although recent DNA analysis has placed it in the genus \"Fuscospora\".", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d3">["hp_f4fcfac633a5b005"]</data>
  <data key="d4">False</data>
</node>
<node id="Fuscospora">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Fuscospora is a genus that F. Gunnii has been placed in after recent DNA analysis.", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d2">[{"text": "\"F. Gunnii\" was previously included in the genus \"Nothofagus\", although recent DNA analysis has placed it in the genus \"Fuscospora\".", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d3">["hp_f4fcfac633a5b005"]</data>
  <data key="d4">False</data>
</node>
<node id="DNA analysis">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "DNA analysis is a technology used to determine the genus placement of F. Gunnii.", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d2">[{"text": "\"F. Gunnii\" was previously included in the genus \"Nothofagus\", although recent DNA analysis has placed it in the genus \"Fuscospora\".", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d3">["hp_f4fcfac633a5b005"]</data>
  <data key="d4">False</data>
</node>
<node id="woody tree">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A small woody tree with a shrubby appearance, F. Gunnii can grow up to 3m.", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d2">[{"text": "\"F. Gunnii\" is a small woody tree with a shrubby appearance known to grow up to 3 m .", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d3">["hp_f4fcfac633a5b005"]</data>
  <data key="d4">False</data>
</node>
<node id="Tasmanian maritime climate">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Tasmanian maritime climate is a factor limiting the habitat of Fuscospora gunnii to mountains.", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d2">[{"text": "It lives only on mountains due to temperature limitations within the Tasmanian maritime climate and can survive up to heights of 1400 m .", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d3">["hp_f4fcfac633a5b005"]</data>
  <data key="d4">False</data>
</node>
<node id="alpine and sub-alpine regions">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Alpine and sub-alpine regions in the west to central portions of Tasmania are where Fuscospora gunnii grows.", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d2">[{"text": "It grows in alpine and sub-alpine regions in the west to central portions of the state but is absent from the mountains of the northeast.", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d3">["hp_f4fcfac633a5b005"]</data>
  <data key="d4">False</data>
</node>
<node id="woody ground cover">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Fuscospora gunnii can grow as a woody ground cover.", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d2">[{"text": "Though capable of reaching the size of a small tree, it rarely exceeds 2 m in height, instead growing as a thick shrub or as a woody ground cover hence its common name of \"tanglefoot\".", "chunk_id": "cc7d1eb73c73bea4", "doc_id": "hp_f4fcfac633a5b005"}]</data>
  <data key="d3">["hp_f4fcfac633a5b005"]</data>
  <data key="d4">False</data>
</node>
