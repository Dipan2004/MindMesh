  <data key="d2">[{"text": "The battle, one of the three great battles won by Joseon during the Imjin Waeran, carried great import, because Joseon's forces now came to dominate the southern seas.", "chunk_id": "4d06ff352195041a", "doc_id": "hp_4e9436b9b6a97ad9"}]</data>
  <data key="d3">["hp_4e9436b9b6a97ad9"]</data>
