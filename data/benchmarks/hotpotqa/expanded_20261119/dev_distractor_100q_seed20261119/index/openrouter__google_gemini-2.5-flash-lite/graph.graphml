  <data key="d2">[{"text": "Following this he was Rector of Hadstock, a Canon Residentiary at Chelmsford Cathedral, Vicar of St Margaret’s with St Nicholas, King’s Lynn and Provost of Portsmouth Cathedral.", "chunk_id": "8920fade874a14dc", "doc_id": "hp_51685a23dbd90e79"}]</data>
