  <data key="d2">[{"text": "He was awarded the Rajyotsava Prashasti, the highhest civilian honour of the state of Karnataka, for his contribution towards Carnatic music.", "chunk_id": "0f45fd72ea12d7a5", "doc_id": "hp_4a19ddee33b69a6c"}]</data>
