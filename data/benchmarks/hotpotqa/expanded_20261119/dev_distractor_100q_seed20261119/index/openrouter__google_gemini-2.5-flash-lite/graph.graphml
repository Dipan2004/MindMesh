  <data key="d2">[{"text": "It was first built in 1922 by local lumber magnate Edward Brooks Sr. and donated to the university by the Brooks family in 1958, beginning its service as the president's official residence in 1960 when O. Meredith Wilson took the position.", "chunk_id": "60d483d501d17f6f", "doc_id": "hp_936dd5018d3d1151"}]</data>
  <data key="d3">["hp_936dd5018d3d1151"]</data>
