  <data key="d7">[{"text": "More narrowly, Yandangshan is also used more narrowly to refer to Mount Yandang , a specific part of the North Yandang around an ancient caldera near a small town of the same name (雁荡镇 , \"Yàndàng Zhèn\").", "chunk_id": "696929108fab1bcf", "doc_id": "hp_a71b119b261e3b26", "type": "NARROWER_SENSE_OF"}]</data>
