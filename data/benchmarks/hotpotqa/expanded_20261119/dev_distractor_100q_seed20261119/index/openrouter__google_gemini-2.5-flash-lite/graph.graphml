  <data key="d7">[{"text": "As a teacher he exerted great influence; among his pupils were Bernhard Sekles, Ernest Bloch, Vladimir Sokalskyi, Ernst Toch, Roger Quilter, Hans Pfitzner, and Cyril Scott.", "chunk_id": "902ae288e12f1dfb", "doc_id": "hp_d0d1ade1227af443", "type": "TAUGHT"}]</data>
