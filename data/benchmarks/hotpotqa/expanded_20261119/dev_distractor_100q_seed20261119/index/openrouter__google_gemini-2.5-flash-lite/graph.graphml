  <data key="d7">[{"text": "Two varieties are recognized, of which \"Bothriochloa ischaemum\" var. \"ischaemum\" is native to Europe, Asia, and Africa and naturalized elsewhere, and var. \"songarica\" is native to Asia and naturalized elsewhere.", "chunk_id": "d4e8ac5bda630039", "doc_id": "hp_f7e1751d7e276925", "type": "NATIVE_TO"}]</data>
