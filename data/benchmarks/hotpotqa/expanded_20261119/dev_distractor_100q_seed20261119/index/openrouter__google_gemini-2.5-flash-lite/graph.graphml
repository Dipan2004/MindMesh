  <data key="d2">[{"text": "In the exclusive hotel market, along with the Occidental were the Lick House, the Russ House, the Cosmopolitan, the Grand, the Palace, and the Baldwin.", "chunk_id": "fbd09bf5bc7b0c64", "doc_id": "hp_350233375cc7c884"}]</data>
