  <data key="d7">[{"text": "Demy's style drew upon such diverse sources as Classic Hollywood musicals, the documentary realism of his New Wave colleagues, fairy-tales, jazz, Japanese manga, and the opera.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd", "type": "INFLUENCED_BY"}]</data>
