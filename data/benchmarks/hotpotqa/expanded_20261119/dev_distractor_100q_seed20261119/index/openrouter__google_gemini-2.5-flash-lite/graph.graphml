<edge source="Won Gyun" target="Jurchens">
  <data key="d5">["DEFENDED_AGAINST"]</data>
  <data key="d6">Won Gyun was assigned to the northern border to defend against the Jurchens.</data>
  <data key="d7">[{"text": "He was qualified as a military officer and was first assigned to the northern border to defend against the Jurchens, who frequently raided Korean villages.", "chunk_id": "a6aad735bf59fe92", "doc_id": "hp_75d8594536b8ad92", "type": "DEFENDED_AGAINST"}]</data>
