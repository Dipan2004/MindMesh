  <data key="d2">[{"text": "He has also won three Dove Awards for his music, and the 1999 Christian Country Music Association Award for Best Musician.", "chunk_id": "73ee4754182774e7", "doc_id": "hp_0e12ea58b60d4b89"}]</data>
