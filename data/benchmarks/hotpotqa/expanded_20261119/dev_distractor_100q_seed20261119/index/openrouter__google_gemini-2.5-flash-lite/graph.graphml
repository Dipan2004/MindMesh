<edge source="Barrie Karp" target="New York City">
  <data key="d5">["EDUCATED_IN"]</data>
  <data key="d6">Barrie Karp has been an educator in New York City colleges and universities.</data>
  <data key="d7">[{"text": "She has been an educator in philosophy, cultural studies, humanities and arts from a feminist and anti-racist perspective in New York City colleges and universities since 1970.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8", "type": "EDUCATED_IN"}]</data>
