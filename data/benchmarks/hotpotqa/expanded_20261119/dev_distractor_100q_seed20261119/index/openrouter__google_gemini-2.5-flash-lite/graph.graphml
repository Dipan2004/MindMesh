  <data key="d2">[{"text": "The 2010 Individual Speedway World Championship Grand Prix Qualification were a series of motorcycle speedway meetings used to determine the three riders who qualified for the 2010 Speedway Grand Prix.", "chunk_id": "41d562b159afe9d1", "doc_id": "hp_025c1875e6de72c3"}, {"text": "The defending Champion, Tomasz Gollob, who was a 2010 Speedway Grand Prix leader, resigned from the IMP Final.", "chunk_id": "5ade499ae57701ad", "doc_id": "hp_ed02c3d2ffc66fa6"}]</data>
