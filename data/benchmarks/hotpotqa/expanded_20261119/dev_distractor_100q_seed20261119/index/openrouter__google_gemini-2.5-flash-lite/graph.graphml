  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Ayala Land is an affiliate of Ayala Corporation and owns Ayala Malls.", "chunk_id": "00d6e00c58449962", "doc_id": "hp_1223b1c0f959c0b7"}, {"text": "Ayala Land is a real-estate company and an affiliate of Ayala Corporation.", "chunk_id": "851db6962c10e795", "doc_id": "hp_13b0e7c83e58b31d"}]</data>
  <data key="d2">[{"text": "Ayala Malls is a real-estate subsidiary of Ayala Land, an affiliate of Ayala Corporation.", "chunk_id": "00d6e00c58449962", "doc_id": "hp_1223b1c0f959c0b7"}, {"text": "It is owned by Ayala Malls, a real-estate subsidiary of Ayala Land, which is an affiliate of Ayala Corporation.", "chunk_id": "851db6962c10e795", "doc_id": "hp_13b0e7c83e58b31d"}]</data>
