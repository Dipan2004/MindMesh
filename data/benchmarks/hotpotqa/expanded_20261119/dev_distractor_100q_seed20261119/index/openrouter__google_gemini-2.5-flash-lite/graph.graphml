<node id="genetic diversity">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Genetic diversity refers to the total number of genetic characteristics in the genetic makeup of a species.", "chunk_id": "1ebe815f1bd477dc", "doc_id": "hp_3e85df348bfa75a4"}]</data>
  <data key="d2">[{"text": "A recent study found considerable genetic diversity within \"L. nobilis\", and that \"L. azorica\" is not genetically or morphologically distinct.", "chunk_id": "1ebe815f1bd477dc", "doc_id": "hp_3e85df348bfa75a4"}]</data>
  <data key="d3">["hp_3e85df348bfa75a4"]</data>
  <data key="d4">False</data>
</node>
<node id="Manley Field House">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Manley Field House is a multi-purpose arena in Syracuse, New York.", "chunk_id": "f2b57f4a59e6b366", "doc_id": "hp_3e92bdc5489290ce"}, {"text": "Manley Field House is a building that became the home to the men's basketball team in 1962.", "chunk_id": "9a89f86e35e64ab2", "doc_id": "hp_b8ec94a3c00016f8"}]</data>
  <data key="d2">[{"text": "Manley Field House is a multi-purpose arena in Syracuse, New York.", "chunk_id": "f2b57f4a59e6b366", "doc_id": "hp_3e92bdc5489290ce"}, {"text": "It served as the home to the men's basketball team until the building of the Manley Field House in 1962, with the exception of the time from January, 1947 to 1949.", "chunk_id": "9a89f86e35e64ab2", "doc_id": "hp_b8ec94a3c00016f8"}]</data>
