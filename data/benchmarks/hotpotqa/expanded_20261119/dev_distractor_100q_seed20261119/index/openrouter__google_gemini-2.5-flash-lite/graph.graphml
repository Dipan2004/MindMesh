  <data key="d2">[{"text": "She is the wife of novelist and screenwriter Nick Hornby.", "chunk_id": "fd23682473d95ea6", "doc_id": "hp_30782028ac642da1"}, {"text": "Brooklyn is a 2015 British-Canadian-Irish romantic drama film directed by John Crowley and written by Nick Hornby, based on Colm Tóibín's 2009 novel of the same name.", "chunk_id": "9c48cbccc18a0d76", "doc_id": "hp_86e77156fb2dbece"}]</data>
