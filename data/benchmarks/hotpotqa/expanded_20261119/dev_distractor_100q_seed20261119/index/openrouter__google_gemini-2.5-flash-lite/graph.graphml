  <data key="d2">[{"text": "Defending champion Don Reinhoudt withdrew from the competition due to injury; this would be his final World's Strongest Man.", "chunk_id": "22af8bb1815b8995", "doc_id": "hp_b1381d79c5b4d390"}]</data>
