<node id="U.S. Army Air Service">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The aviation branch of the U.S. Army during World War I.", "chunk_id": "45856128b6a22257", "doc_id": "hp_7e06d5c1c2ef0dce"}]</data>
  <data key="d2">[{"text": "The U.S. Army Air Service (which later became the U.S. Air Force) played a significant role in this action.", "chunk_id": "45856128b6a22257", "doc_id": "hp_7e06d5c1c2ef0dce"}]</data>
