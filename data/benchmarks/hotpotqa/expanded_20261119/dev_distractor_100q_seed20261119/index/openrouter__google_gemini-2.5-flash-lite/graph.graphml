<node id="Kim Myung-min">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The actor who starred as Yi Sun-sin in the television series 'Immortal Admiral Yi Sun-sin'.", "chunk_id": "c7de5b4d4d75a945", "doc_id": "hp_98a7f8e12fb63c7b"}]</data>
  <data key="d2">[{"text": "Immortal Admiral Yi Sun-sin (; lit. \"The Immortal Yi Sun-sin\") is a South Korean television series based on the life of Yi Sun-sin, starring Kim Myung-min in the title role.", "chunk_id": "c7de5b4d4d75a945", "doc_id": "hp_98a7f8e12fb63c7b"}]</data>
  <data key="d3">["hp_98a7f8e12fb63c7b"]</data>
  <data key="d4">False</data>
</node>
<node id="KBS1">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The South Korean television channel that aired 'Immortal Admiral Yi Sun-sin'.", "chunk_id": "c7de5b4d4d75a945", "doc_id": "hp_98a7f8e12fb63c7b"}]</data>
  <data key="d2">[{"text": "It aired on KBS1 from September 4, 2004 to August 28, 2005 on Saturdays and Sundays at 21:45 for 104 episodes.", "chunk_id": "c7de5b4d4d75a945", "doc_id": "hp_98a7f8e12fb63c7b"}]</data>
  <data key="d3">["hp_98a7f8e12fb63c7b"]</data>
  <data key="d4">False</data>
</node>
