  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A Senior Fellow at the Independent Institute, author, and lawyer known for his litigation on behalf of the National Rifle Association.", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
  <data key="d2">[{"text": "Stephen P. Halbrook is a Senior Fellow at the Independent Institute and an author and lawyer known for his litigation on behalf of the National Rifle Association.", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}]</data>
