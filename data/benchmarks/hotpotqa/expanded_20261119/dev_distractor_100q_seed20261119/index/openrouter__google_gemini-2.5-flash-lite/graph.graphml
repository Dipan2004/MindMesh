  <data key="d2">[{"text": "Founded in 1867, originally as the independent incorporated village of Woodburn, East Walnut Hills is a diverse neighborhood, both ethnically and economically.", "chunk_id": "7430715d26fd6b11", "doc_id": "hp_7a28631371b5d588"}]</data>
