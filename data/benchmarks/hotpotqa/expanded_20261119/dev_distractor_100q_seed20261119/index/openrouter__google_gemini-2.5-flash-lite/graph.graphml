<node id="Lillian">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The mother of Donald Neil Kerley.", "chunk_id": "442043eeaf880949", "doc_id": "hp_fe3fc60bc7758add"}]</data>
  <data key="d2">[{"text": "Despite his first name being Donald, it was his mother Lillian's strong dislike of shortening Christian names that led everyone calling him Neil and not Don or Donald from an early age.", "chunk_id": "442043eeaf880949", "doc_id": "hp_fe3fc60bc7758add"}]</data>
