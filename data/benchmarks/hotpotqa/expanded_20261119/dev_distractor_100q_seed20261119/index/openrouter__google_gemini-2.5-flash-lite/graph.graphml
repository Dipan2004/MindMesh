  <data key="d2">[{"text": "Leung graduated from the Chinese University of Hong Kong, majoring in Fine Arts and pursued a Masters of Philosophy degree there.", "chunk_id": "897f999db778cfd7", "doc_id": "hp_0072f61fd930d308"}]</data>
