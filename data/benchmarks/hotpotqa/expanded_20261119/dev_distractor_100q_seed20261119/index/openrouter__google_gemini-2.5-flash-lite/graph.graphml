</node>
<node id="Arundel Castle">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Arundel Castle is the seat of the Duke of Norfolk.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}]</data>
  <data key="d2">[{"text": "The seat of the Duke of Norfolk is Arundel Castle in Sussex, although the title refers to the county of Norfolk.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}]</data>
  <data key="d3">["hp_c50a06491df52f2d"]</data>
  <data key="d4">False</data>
</node>
<node id="Sussex">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Sussex is a county in England where Arundel Castle is located.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}]</data>
  <data key="d2">[{"text": "The seat of the Duke of Norfolk is Arundel Castle in Sussex, although the title refers to the county of Norfolk.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}]</data>
  <data key="d3">["hp_c50a06491df52f2d"]</data>
  <data key="d4">False</data>
</node>
<node id="Norfolk">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Norfolk is a county in England that the title Duke of Norfolk refers to.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}]</data>
  <data key="d2">[{"text": "The seat of the Duke of Norfolk is Arundel Castle in Sussex, although the title refers to the county of Norfolk.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}]</data>
