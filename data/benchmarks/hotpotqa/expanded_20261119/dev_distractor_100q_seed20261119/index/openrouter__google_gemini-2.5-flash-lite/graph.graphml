  <data key="d1">[{"text": "The World War II Airborne Demonstration Team is an organization that uses restored World War II hangars.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}]</data>
  <data key="d2">[{"text": "Frederick Regional Airport, which includes restored World War II hangars which house the World War II Airborne Demonstration Team.", "chunk_id": "7ed2f23b7d77b089", "doc_id": "hp_6eb8e4170df0651b"}]</data>
