<node id="Jaime Fernández Reyes">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A Mexican actor who lived from December 6, 1937, to April 15, 2005.", "chunk_id": "5caaa82e915cbb20", "doc_id": "hp_f4a1d9afa0828a54"}]</data>
  <data key="d2">[{"text": "Jaime Fernández Reyes (December 6, 1937 – April 15, 2005) was a Mexican actor.", "chunk_id": "5caaa82e915cbb20", "doc_id": "hp_f4a1d9afa0828a54"}]</data>
  <data key="d3">["hp_f4a1d9afa0828a54"]</data>
  <data key="d4">False</data>
</node>
<node id="Silver Ariel awards">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Awards that are the Mexican equivalent of the Oscar.", "chunk_id": "5caaa82e915cbb20", "doc_id": "hp_f4a1d9afa0828a54"}]</data>
  <data key="d2">[{"text": "Over his career, he won 3 Silver Ariel awards - the Mexican equivalent of the Oscar - including one for what is arguably his best-known role, playing Friday in Luis Buñuel's \"Robinson Crusoe\".", "chunk_id": "5caaa82e915cbb20", "doc_id": "hp_f4a1d9afa0828a54"}]</data>
  <data key="d3">["hp_f4a1d9afa0828a54"]</data>
  <data key="d4">False</data>
</node>
<node id="Oscar">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A prestigious award, often considered the highest honor in the American film industry.", "chunk_id": "5caaa82e915cbb20", "doc_id": "hp_f4a1d9afa0828a54"}]</data>
  <data key="d2">[{"text": "Over his career, he won 3 Silver Ariel awards - the Mexican equivalent of the Oscar - including one for what is arguably his best-known role, playing Friday in Luis Buñuel's \"Robinson Crusoe\".", "chunk_id": "5caaa82e915cbb20", "doc_id": "hp_f4a1d9afa0828a54"}]</data>
  <data key="d3">["hp_f4a1d9afa0828a54"]</data>
