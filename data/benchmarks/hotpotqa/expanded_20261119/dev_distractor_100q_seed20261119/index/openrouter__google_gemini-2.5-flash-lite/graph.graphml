<node id="Dayton, Ohio">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city in the United States where Saint Anne's Hill Historic District is located.", "chunk_id": "b3dd1a340e6929c9", "doc_id": "hp_58345f001027ee37"}, {"text": "A city in the United States where the Central Avenue Historic District and Grafton Hill are located.", "chunk_id": "967deaf2512420da", "doc_id": "hp_6f092134262031b8"}, {"text": "A location where Torrence Huffman was a banker and loaned pasture land to the Wright brothers.", "chunk_id": "909c6d3ef553b8b9", "doc_id": "hp_8fc220871dced370"}]</data>
  <data key="d2">[{"text": "Saint Anne's Hill Historic District is part of the Historic Inner East neighborhood in Dayton, Ohio, United States.", "chunk_id": "b3dd1a340e6929c9", "doc_id": "hp_58345f001027ee37"}, {"text": "The Central Avenue Historic District is a small segment of the larger Grafton Hill neighborhood of Dayton, Ohio, United States.", "chunk_id": "967deaf2512420da", "doc_id": "hp_6f092134262031b8"}, {"text": "Torrence Huffman was a banker in Dayton, Ohio who loaned pasture land to the Wright brothers where they perfected their first airplanes and started the first pilot training school.", "chunk_id": "909c6d3ef553b8b9", "doc_id": "hp_8fc220871dced370"}]</data>
  <data key="d3">["hp_58345f001027ee37", "hp_6f092134262031b8", "hp_8fc220871dced370"]</data>
  <data key="d4">False</data>
</node>
<node id="St. Anne's Hill">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A neighborhood characterized by Victorian residences and German heritage.", "chunk_id": "b3dd1a340e6929c9", "doc_id": "hp_58345f001027ee37"}]</data>
  <data key="d2">[{"text": "St. Anne's Hill constitutes a grouping of both vernacular and high style Victorian residences which date roughly from 1860 to the early 20th century.", "chunk_id": "b3dd1a340e6929c9", "doc_id": "hp_58345f001027ee37"}]</data>
  <data key="d3">["hp_58345f001027ee37"]</data>
  <data key="d4">False</data>
</node>
