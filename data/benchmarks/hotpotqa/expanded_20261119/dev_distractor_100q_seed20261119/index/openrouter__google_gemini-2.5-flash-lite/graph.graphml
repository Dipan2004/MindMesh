  <data key="d2">[{"text": "The song \"Truth\" was featured in the season 4 premiere of AMC's \"Breaking Bad\" titled \"Box Cutter\".", "chunk_id": "1f1504795345835d", "doc_id": "hp_319b85ef31304b0b"}]</data>
