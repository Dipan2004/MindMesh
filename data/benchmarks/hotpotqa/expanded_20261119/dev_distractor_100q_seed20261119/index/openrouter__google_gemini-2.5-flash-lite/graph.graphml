<node id="Mount Grundy">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Mount Grundy is the northernmost area for Atherosperma moschatum in eastern New South Wales.", "chunk_id": "e1044c549e97de7c", "doc_id": "hp_dce12d59ef968ea1"}]</data>
  <data key="d2">[{"text": "The northernmost area is at Mount Grundy, west of Port Macquarie.", "chunk_id": "e1044c549e97de7c", "doc_id": "hp_dce12d59ef968ea1"}]</data>
