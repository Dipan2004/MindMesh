  <data key="d2">[{"text": "Her first video to receive attention on MTV was \"Borderline\", followed by \"Lucky Star\" and \"Like a Virgin\", which popularized Madonna's image and fashion among younger generation.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d3">["hp_f2eafe05aec63f00"]</data>
  <data key="d4">False</data>
</node>
<node id="Like a Virgin">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A music video by Madonna that popularized her image and fashion.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
  <data key="d2">[{"text": "Her first video to receive attention on MTV was \"Borderline\", followed by \"Lucky Star\" and \"Like a Virgin\", which popularized Madonna's image and fashion among younger generation.", "chunk_id": "ead4118602be8d9d", "doc_id": "hp_f2eafe05aec63f00"}]</data>
