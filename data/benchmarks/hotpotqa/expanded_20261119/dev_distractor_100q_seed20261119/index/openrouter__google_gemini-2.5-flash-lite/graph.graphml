<edge source="Holocaust" target="Shoah">
  <data key="d5">["SYNONYM_OF"]</data>
  <data key="d6">The Shoah is another name for the Holocaust.</data>
  <data key="d7">[{"text": "Also referred to as the Shoah (in Hebrew), the Holocaust was a genocide in which some six million European Jews were killed by Nazi Germany and its World War II collaborators.", "chunk_id": "b24df285a9cc0262", "doc_id": "hp_ea0eba1a0f59fdf8", "type": "SYNONYM_OF"}]</data>
