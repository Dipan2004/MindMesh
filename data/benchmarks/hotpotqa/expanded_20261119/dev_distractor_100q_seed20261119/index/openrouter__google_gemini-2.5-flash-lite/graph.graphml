<node id="Moment (magazine)">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An independent magazine for a Jewish-American audience.", "chunk_id": "7156f0efb6184faa", "doc_id": "hp_02c3149273f48869"}]</data>
  <data key="d2">[{"text": "Moment is an independent magazine for a Jewish-American audience and is not tied to any movement or ideology.", "chunk_id": "7156f0efb6184faa", "doc_id": "hp_02c3149273f48869"}]</data>
  <data key="d3">["hp_02c3149273f48869"]</data>
  <data key="d4">False</data>
</node>
<node id="Elie Wiesel">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Nobel Prize laureate who co-founded Moment magazine.", "chunk_id": "7156f0efb6184faa", "doc_id": "hp_02c3149273f48869"}]</data>
  <data key="d2">[{"text": "\"Moment\" was founded in 1975, by Nobel Prize laureate Elie Wiesel and Jewish activist Leonard Fein, who served as the magazine's first editor from 1975 to 1987.", "chunk_id": "7156f0efb6184faa", "doc_id": "hp_02c3149273f48869"}]</data>
  <data key="d3">["hp_02c3149273f48869"]</data>
  <data key="d4">False</data>
</node>
<node id="Leonard Fein">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Jewish activist and the first editor of Moment magazine.", "chunk_id": "7156f0efb6184faa", "doc_id": "hp_02c3149273f48869"}]</data>
  <data key="d2">[{"text": "\"Moment\" was founded in 1975, by Nobel Prize laureate Elie Wiesel and Jewish activist Leonard Fein, who served as the magazine's first editor from 1975 to 1987.", "chunk_id": "7156f0efb6184faa", "doc_id": "hp_02c3149273f48869"}]</data>
  <data key="d3">["hp_02c3149273f48869"]</data>
  <data key="d4">False</data>
</node>
<node id="Hershel Shanks">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The editor of Moment magazine from 1987 to 2004.", "chunk_id": "7156f0efb6184faa", "doc_id": "hp_02c3149273f48869"}]</data>
  <data key="d2">[{"text": "Hershel Shanks served as the editor from 1987 to 2004.", "chunk_id": "7156f0efb6184faa", "doc_id": "hp_02c3149273f48869"}]</data>
  <data key="d3">["hp_02c3149273f48869"]</data>
