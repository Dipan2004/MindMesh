  <data key="d2">[{"text": "Nargis, Premnath, Nigar Sultana and Kamini Kaushal also starred in supporting roles.", "chunk_id": "4df4b5295e67f801", "doc_id": "hp_b8f974e5ce544d7e"}]</data>
