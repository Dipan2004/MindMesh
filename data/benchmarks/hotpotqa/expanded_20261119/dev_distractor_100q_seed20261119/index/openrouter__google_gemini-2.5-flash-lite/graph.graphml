<edge source="Istanbul" target="Turkey">
  <data key="d5">["LOCATED_IN", "LOCATED_IN", "LOCATED_IN", "LOCATED_IN"]</data>
  <data key="d6">Istanbul is located in Turkey.</data>
  <data key="d7">[{"text": "Gül Mosque (Turkish: \"Gül Camii\" , meaning: \"The Mosque of the Rose\" in English) is a former Eastern Orthodox church in Istanbul, Turkey, converted into a mosque by the Ottomans.", "chunk_id": "8567d31eef2db61e", "doc_id": "hp_7afc03b2a09c3287", "type": "LOCATED_IN"}, {"text": "The Gazi Atik Ali Pasha Mosque (Turkish: \"Gazi Atik Ali Paşa Camii\" ) is an old Ottoman mosque located in the Çemberlitaş neighbourhood of the Fatih district in Istanbul, Turkey.", "chunk_id": "8f5d1ed038b51df1", "doc_id": "hp_90153a2ea74b8250", "type": "LOCATED_IN"}, {"text": "The Firuz Ağa Mosque (Turkish: \"Firuz Ağa Camii\" ) is an old Ottoman mosque in the Fatih district of Istanbul, Turkey.", "chunk_id": "f4b3646a27921496", "doc_id": "hp_ac4c6b296e4e7b01", "type": "LOCATED_IN"}, {"text": "It stands in what is now Gülhane Park, Istanbul, Turkey.", "chunk_id": "dffd0908b3e87179", "doc_id": "hp_c9f9cf36b314fa0a", "type": "LOCATED_IN"}]</data>
  <data key="d8">hp_7afc03b2a09c3287</data>
</edge>
