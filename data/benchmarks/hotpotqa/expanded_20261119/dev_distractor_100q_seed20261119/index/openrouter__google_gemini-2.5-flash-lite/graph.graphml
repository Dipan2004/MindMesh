  <data key="d2">[{"text": "Randal Barry Orton (born May 28, 1958), better known as Barry Orton, is an American actor, musician, and former professional wrestler.", "chunk_id": "a487060ceea70598", "doc_id": "hp_6bd7dd353d530418"}, {"text": "He is the son of professional wrestler Bob Orton Sr., the brother of professional wrestler Barry Orton, and the father of professional wrestler Randy Orton.", "chunk_id": "107bd8714a8dad71", "doc_id": "hp_8cbd595289b581da"}]</data>
