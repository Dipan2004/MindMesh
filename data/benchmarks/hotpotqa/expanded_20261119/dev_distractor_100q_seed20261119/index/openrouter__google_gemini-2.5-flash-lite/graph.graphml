<node id="Hot Girls Wanted">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A 2015 American documentary about young adult pornography.", "chunk_id": "bf5bfb020d2a9309", "doc_id": "hp_30efae93610e2be7"}, {"text": "An acclaimed documentary for which Tyler Strickland provided the score.", "chunk_id": "9e7955d7c6c8fafa", "doc_id": "hp_7abb1e9cbcc5a896"}, {"text": "\"Hot Girls Wanted\" is a documentary film co-directed by Jill Bauer and Ronna Gradus in 2015.", "chunk_id": "e68c0632f8756f40", "doc_id": "hp_b25d5e6fd3855bd1"}]</data>
  <data key="d2">[{"text": "Hot Girls Wanted is a 2015 American documentary on young adult pornography directed by Jill Bauer and Ronna Gradus.", "chunk_id": "bf5bfb020d2a9309", "doc_id": "hp_30efae93610e2be7"}, {"text": "He is best known for providing the scores for acclaimed documentaries such as Rashida Jones’s \"Hot Girls Wanted\", CNN’s \"Fresh Dressed\", and Netflix’s \"Audrie &amp; Daisy\".", "chunk_id": "9e7955d7c6c8fafa", "doc_id": "hp_7abb1e9cbcc5a896"}, {"text": "Bauer and Ronna Gradus co-directed two documentary films, \"Sexy Baby\" (2012) and \"Hot Girls Wanted\" (2015).", "chunk_id": "e68c0632f8756f40", "doc_id": "hp_b25d5e6fd3855bd1"}]</data>
  <data key="d3">["hp_30efae93610e2be7", "hp_7abb1e9cbcc5a896", "hp_b25d5e6fd3855bd1"]</data>
