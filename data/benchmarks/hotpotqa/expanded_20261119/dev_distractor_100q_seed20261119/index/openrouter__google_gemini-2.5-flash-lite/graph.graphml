<node id="Molly Stark">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Molly Stark is a character played by Amy O'Neill on \"The Young and the Restless\".", "chunk_id": "6f7849fc13c087db", "doc_id": "hp_7ed9ce59d4321c4f"}]</data>
  <data key="d2">[{"text": "After appearing in several sitcoms and starring as Molly Stark on \"The Young and the Restless\" in 1986, she was cast in her notable role as Amy Szalinski in the 1989 Disney film, \"Honey, I Shrunk the Kids\", for which she was nominated for a Young Artist Award.", "chunk_id": "6f7849fc13c087db", "doc_id": "hp_7ed9ce59d4321c4f"}]</data>
