  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Tristan da Cunha is an island where a few species of Phylica occur.", "chunk_id": "6b62f66ee7182ec5", "doc_id": "hp_2ca4198c5242553c"}]</data>
  <data key="d2">[{"text": "A few species occur in other parts of southern Africa, and on islands including Madagascar, the Mascarene Islands, Île Amsterdam, Saint Helena, Tristan da Cunha, and Gough Island.", "chunk_id": "6b62f66ee7182ec5", "doc_id": "hp_2ca4198c5242553c"}]</data>
  <data key="d3">["hp_2ca4198c5242553c"]</data>
  <data key="d4">False</data>
</node>
<node id="Gough Island">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Gough Island is an island where a few species of Phylica occur.", "chunk_id": "6b62f66ee7182ec5", "doc_id": "hp_2ca4198c5242553c"}]</data>
  <data key="d2">[{"text": "A few species occur in other parts of southern Africa, and on islands including Madagascar, the Mascarene Islands, Île Amsterdam, Saint Helena, Tristan da Cunha, and Gough Island.", "chunk_id": "6b62f66ee7182ec5", "doc_id": "hp_2ca4198c5242553c"}]</data>
  <data key="d3">["hp_2ca4198c5242553c"]</data>
  <data key="d4">False</data>
</node>
<node id="Columba Domínguez Adalid">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Columba Domínguez Adalid was a Mexican actress, singer, and painter.", "chunk_id": "c5b56d3da2c4d74b", "doc_id": "hp_2cf3a3820e736dce"}]</data>
  <data key="d2">[{"text": "Columba Domínguez Adalid (March 4, 1929 – August 13, 2014) was a Mexican actress, singer, and painter.", "chunk_id": "c5b56d3da2c4d74b", "doc_id": "hp_2cf3a3820e736dce"}]</data>
  <data key="d3">["hp_2cf3a3820e736dce"]</data>
  <data key="d4">False</data>
</node>
<node id="Golden Age of Mexican cinema">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Golden Age of Mexican cinema is a period in which Columba Domínguez was considered a crucial figure.", "chunk_id": "c5b56d3da2c4d74b", "doc_id": "hp_2cf3a3820e736dce"}, {"text": "The Golden Age of Mexican cinema was a period in which Emilio Fernández was a prolific film director.", "chunk_id": "e2bd3c61103e4d8b", "doc_id": "hp_e6718a97d51ea825"}]</data>
  <data key="d2">[{"text": "Considered a crucial figure in the Golden Age of Mexican cinema, she was one of the muses of the film director Emilio Fernández, with whom she was romantically linked for several years.", "chunk_id": "c5b56d3da2c4d74b", "doc_id": "hp_2cf3a3820e736dce"}, {"text": "He was one of the most prolific film directors of the Golden Age of Mexican cinema in the 1940s and 1950s.", "chunk_id": "e2bd3c61103e4d8b", "doc_id": "hp_e6718a97d51ea825"}]</data>
  <data key="d3">["hp_2cf3a3820e736dce", "hp_e6718a97d51ea825"]</data>
  <data key="d4">False</data>
</node>
<node id="Pueblerina">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Pueblerina is a film from 1949 for which Columba Domínguez is particularly remembered for her performance.", "chunk_id": "c5b56d3da2c4d74b", "doc_id": "hp_2cf3a3820e736dce"}]</data>
  <data key="d2">[{"text": "She is remembered particularly for her performance in the film \"Pueblerina\" (1949), which is considered one of the jewels of the Mexican Cinema.", "chunk_id": "c5b56d3da2c4d74b", "doc_id": "hp_2cf3a3820e736dce"}]</data>
  <data key="d3">["hp_2cf3a3820e736dce"]</data>
  <data key="d4">False</data>
</node>
<node id="Mexican Cinema">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Mexican Cinema is a field where the film \"Pueblerina\" is considered one of its jewels.", "chunk_id": "c5b56d3da2c4d74b", "doc_id": "hp_2cf3a3820e736dce"}]</data>
  <data key="d2">[{"text": "She is remembered particularly for her performance in the film \"Pueblerina\" (1949), which is considered one of the jewels of the Mexican Cinema.", "chunk_id": "c5b56d3da2c4d74b", "doc_id": "hp_2cf3a3820e736dce"}]</data>
  <data key="d3">["hp_2cf3a3820e736dce"]</data>
  <data key="d4">False</data>
</node>
<node id="Overtime (ice hockey)">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A method of extending an ice hockey game when the scores are tied after regulation.", "chunk_id": "2f0c7a6928ef44b4", "doc_id": "hp_2d53d1bdc10ca42f"}]</data>
  <data key="d2">[{"text": "Overtime is a method of extending an ice hockey game when the scores are tied after regulation.", "chunk_id": "2f0c7a6928ef44b4", "doc_id": "hp_2d53d1bdc10ca42f"}]</data>
  <data key="d3">["hp_2d53d1bdc10ca42f"]</data>
  <data key="d4">False</data>
</node>
<node id="ice hockey">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A team sport played on ice, in which skaters use sticks to shoot a vulcanized rubber puck into their opponent's net.", "chunk_id": "2f0c7a6928ef44b4", "doc_id": "hp_2d53d1bdc10ca42f"}]</data>
  <data key="d2">[{"text": "Overtime is a method of extending an ice hockey game when the scores are tied after regulation.", "chunk_id": "2f0c7a6928ef44b4", "doc_id": "hp_2d53d1bdc10ca42f"}]</data>
  <data key="d3">["hp_2d53d1bdc10ca42f"]</data>
  <data key="d4">False</data>
</node>
<node id="overtime period">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A specific period of play used to extend an ice hockey game when scores are tied after regulation.", "chunk_id": "2f0c7a6928ef44b4", "doc_id": "hp_2d53d1bdc10ca42f"}]</data>
  <data key="d2">[{"text": "The two main methods of extending the game are the overtime period (commonly referred to as overtime) and the shootout.", "chunk_id": "2f0c7a6928ef44b4", "doc_id": "hp_2d53d1bdc10ca42f"}]</data>
  <data key="d3">["hp_2d53d1bdc10ca42f"]</data>
  <data key="d4">False</data>
</node>
<node id="BioFuels Security Act">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A proposed legislative Act of Congress intended to phase out current single-fueled vehicles in favor of flexible-fuel vehicles.", "chunk_id": "fa13ca5ccf4e8a1a", "doc_id": "hp_2d81843de2ac0409"}]</data>
  <data key="d2">[{"text": "The BioFuels Security Act is a proposed legislative Act of Congress intended to phase out current single-fueled vehicles in favor of flexible-fuel vehicles.", "chunk_id": "fa13ca5ccf4e8a1a", "doc_id": "hp_2d81843de2ac0409"}]</data>
  <data key="d3">["hp_2d81843de2ac0409"]</data>
  <data key="d4">False</data>
</node>
<node id="Congress">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The legislative body of the United States.", "chunk_id": "fa13ca5ccf4e8a1a", "doc_id": "hp_2d81843de2ac0409"}, {"text": "A legislative body before which Stephen Halbrook has testified.", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}, {"text": "The legislative body of the United States, responsible for confirming vice presidential nominees.", "chunk_id": "54142f25de20997e", "doc_id": "hp_adfdee30bf450e7d"}]</data>
  <data key="d2">[{"text": "The BioFuels Security Act is a proposed legislative Act of Congress intended to phase out current single-fueled vehicles in favor of flexible-fuel vehicles.", "chunk_id": "fa13ca5ccf4e8a1a", "doc_id": "hp_2d81843de2ac0409"}, {"text": "He has testified before congress on multiple occasions.", "chunk_id": "eab3a4e28ecc70cf", "doc_id": "hp_3196bc16ccdc716d"}, {"text": "However, Nixon settled on House Minority Leader Gerald Ford of Michigan, who was popular among the members of Congress and who was good friends with Nixon.", "chunk_id": "54142f25de20997e", "doc_id": "hp_adfdee30bf450e7d"}]</data>
  <data key="d3">["hp_2d81843de2ac0409", "hp_3196bc16ccdc716d", "hp_adfdee30bf450e7d"]</data>
  <data key="d4">False</data>
</node>
<node id="single-fueled vehicles">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Vehicles that operate on a single type of fuel.", "chunk_id": "fa13ca5ccf4e8a1a", "doc_id": "hp_2d81843de2ac0409"}]</data>
  <data key="d2">[{"text": "The BioFuels Security Act is a proposed legislative Act of Congress intended to phase out current single-fueled vehicles in favor of flexible-fuel vehicles.", "chunk_id": "fa13ca5ccf4e8a1a", "doc_id": "hp_2d81843de2ac0409"}]</data>
  <data key="d3">["hp_2d81843de2ac0409"]</data>
  <data key="d4">False</data>
</node>
<node id="flexible-fuel vehicles">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Vehicles that can run on more than one type of fuel.", "chunk_id": "fa13ca5ccf4e8a1a", "doc_id": "hp_2d81843de2ac0409"}]</data>
  <data key="d2">[{"text": "The BioFuels Security Act is a proposed legislative Act of Congress intended to phase out current single-fueled vehicles in favor of flexible-fuel vehicles.", "chunk_id": "fa13ca5ccf4e8a1a", "doc_id": "hp_2d81843de2ac0409"}]</data>
  <data key="d3">["hp_2d81843de2ac0409"]</data>
  <data key="d4">False</data>
</node>
<node id="contemporary single-fuel vehicles">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Current vehicles that operate on a single type of fuel.", "chunk_id": "fa13ca5ccf4e8a1a", "doc_id": "hp_2d81843de2ac0409"}]</data>
  <data key="d2">[{"text": "Under this proposal, contemporary single-fuel vehicles would cease production in 2016.", "chunk_id": "fa13ca5ccf4e8a1a", "doc_id": "hp_2d81843de2ac0409"}]</data>
  <data key="d3">["hp_2d81843de2ac0409"]</data>
  <data key="d4">False</data>
</node>
<node id="Lonicera morrowii">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Lonicera morrowii, also known as Morrow's honeysuckle, is a deciduous honeysuckle species.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d2">[{"text": "Lonicera morrowii", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d3">["hp_2dbc22a588912449"]</data>
  <data key="d4">False</data>
</node>
<node id="Morrow's honeysuckle">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Morrow's honeysuckle is a deciduous honeysuckle in the family Caprifoliaceae, native to Japan, Korea, and Northeast China.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d2">[{"text": "Lonicera morrowii, the Morrow's honeysuckle, is a deciduous honeysuckle in the family Caprifoliaceae, native to Japan, Korea, and Northeast China.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d3">["hp_2dbc22a588912449"]</data>
  <data key="d4">False</data>
</node>
<node id="Caprifoliaceae">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Caprifoliaceae is the family to which Lonicera morrowii belongs.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d2">[{"text": "Lonicera morrowii, the Morrow's honeysuckle, is a deciduous honeysuckle in the family Caprifoliaceae, native to Japan, Korea, and Northeast China.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d3">["hp_2dbc22a588912449"]</data>
  <data key="d4">False</data>
</node>
<node id="Korea">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Korea is a native region of Lonicera morrowii.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}, {"text": "A country represented in the film festival.", "chunk_id": "9196783ed67a5319", "doc_id": "hp_81d3603dff093a10"}]</data>
  <data key="d2">[{"text": "Lonicera morrowii, the Morrow's honeysuckle, is a deciduous honeysuckle in the family Caprifoliaceae, native to Japan, Korea, and Northeast China.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}, {"text": "Ranging from action to comedy, sci-fi to horror, to genre-bending altogether, this year's films represented not only Korea's top box-office hits but also some of the industry's most creative and substantial movies to date.", "chunk_id": "9196783ed67a5319", "doc_id": "hp_81d3603dff093a10"}]</data>
  <data key="d3">["hp_2dbc22a588912449", "hp_81d3603dff093a10"]</data>
  <data key="d4">False</data>
</node>
<node id="Northeast China">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Northeast China is a native region of Lonicera morrowii.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d2">[{"text": "Lonicera morrowii, the Morrow's honeysuckle, is a deciduous honeysuckle in the family Caprifoliaceae, native to Japan, Korea, and Northeast China.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d3">["hp_2dbc22a588912449"]</data>
  <data key="d4">False</data>
</node>
<node id="shrub">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Lonicera morrowii is a shrub that reaches a height of 2-2.5 m.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}, {"text": "Agastachys odorata is normally a shrub in situations other than rainforests.", "chunk_id": "19175e33feb82407", "doc_id": "hp_753b5832724c81c3"}, {"text": "Shrubs are a type of plant that are members of the Salvia genus.", "chunk_id": "a02f6c09a33fee66", "doc_id": "hp_6e6c3433daecaed3"}]</data>
  <data key="d2">[{"text": "It is a shrub, reaching a height of 2-2.5 m, with oblong leaves 4–6 cm long.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}, {"text": "It can grow in some rainforests where it forms a small tree but is normally a shrub in all other situations.", "chunk_id": "19175e33feb82407", "doc_id": "hp_753b5832724c81c3"}, {"text": "Members include shrubs, herbaceous perennials, and annuals.", "chunk_id": "a02f6c09a33fee66", "doc_id": "hp_6e6c3433daecaed3"}]</data>
  <data key="d3">["hp_2dbc22a588912449", "hp_6e6c3433daecaed3", "hp_753b5832724c81c3"]</data>
  <data key="d4">False</data>
</node>
<node id="oblong leaves">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Oblong leaves are a characteristic of Lonicera morrowii, measuring 4–6 cm long.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d2">[{"text": "It is a shrub, reaching a height of 2-2.5 m, with oblong leaves 4–6 cm long.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d3">["hp_2dbc22a588912449"]</data>
  <data key="d4">False</data>
</node>
<node id="white to pale yellow flowers">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The flowers of Lonicera morrowii are white to pale yellow.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d2">[{"text": "The flowers are white to pale yellow, and the fruit is a dark red berry 7–8 mm diameter containing numerous seeds.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d3">["hp_2dbc22a588912449"]</data>
  <data key="d4">False</data>
</node>
<node id="dark red berry">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The fruit of Lonicera morrowii is a dark red berry, 7–8 mm in diameter, containing numerous seeds.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d2">[{"text": "The flowers are white to pale yellow, and the fruit is a dark red berry 7–8 mm diameter containing numerous seeds.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d3">["hp_2dbc22a588912449"]</data>
  <data key="d4">False</data>
</node>
<node id="birds">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Birds eat the dark red berries of Lonicera morrowii.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d2">[{"text": "The berries, while eaten frequently by birds, are considered poisonous to humans.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d3">["hp_2dbc22a588912449"]</data>
  <data key="d4">False</data>
</node>
<node id="humans">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The berries of Lonicera morrowii are considered poisonous to humans.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d2">[{"text": "The berries, while eaten frequently by birds, are considered poisonous to humans.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d3">["hp_2dbc22a588912449"]</data>
  <data key="d4">False</data>
</node>
<node id="bush honeysuckle">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Bush honeysuckle is a colloquial name for Lonicera morrowii in the United States.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d2">[{"text": "It is colloquially called \"bush honeysuckle\" in the United States, and is considered an invasive species.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d3">["hp_2dbc22a588912449"]</data>
  <data key="d4">False</data>
</node>
<node id="invasive species">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Lonicera morrowii is considered an invasive species.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d2">[{"text": "It is colloquially called \"bush honeysuckle\" in the United States, and is considered an invasive species.", "chunk_id": "f7b345f78dfedaf4", "doc_id": "hp_2dbc22a588912449"}]</data>
  <data key="d3">["hp_2dbc22a588912449"]</data>
  <data key="d4">False</data>
</node>
<node id="Carnival Eats">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Canadian television series about various eating establishments at carnivals in Canada and the United States.", "chunk_id": "da467109040d67f5", "doc_id": "hp_2ea484cb715401dc"}]</data>
  <data key="d2">[{"text": "Carnival Eats is a Canadian television series about various eating establishments at carnivals in Canada and the United States.", "chunk_id": "da467109040d67f5", "doc_id": "hp_2ea484cb715401dc"}]</data>
  <data key="d3">["hp_2ea484cb715401dc"]</data>
  <data key="d4">False</data>
</node>
<node id="Noah Cappe">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The host of the television series Carnival Eats.", "chunk_id": "da467109040d67f5", "doc_id": "hp_2ea484cb715401dc"}]</data>
  <data key="d2">[{"text": "The series features host Noah Cappe as he travels to the many carnivals, state fairs and festivals to sample a variety of unique culinary creations available only at these aptly named \"gastronomic freak shows\".", "chunk_id": "da467109040d67f5", "doc_id": "hp_2ea484cb715401dc"}]</data>
  <data key="d3">["hp_2ea484cb715401dc"]</data>
  <data key="d4">False</data>
</node>
