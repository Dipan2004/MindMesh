  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Taizhou is a prefecture-level city bordering Dongtai to the west.", "chunk_id": "551f221f922de162", "doc_id": "hp_8cfa6859d9227577"}, {"text": "Taizhou is a municipal region in southeastern Zhejiang province, China.", "chunk_id": "6cbf95d958c94cd7", "doc_id": "hp_8f217e15be3875b3"}]</data>
  <data key="d2">[{"text": "With some Yellow Sea coast, it borders the prefecture-level cities of Nantong to the south and Taizhou to the west, and is the southernmost county-level division of Yancheng.", "chunk_id": "551f221f922de162", "doc_id": "hp_8cfa6859d9227577"}, {"text": "Wenling (Wenling dialect: Uen-lin Zy ] ; ) is a coastal county-level city in the municipal region of Taizhou, in southeastern Zhejiang province, China.", "chunk_id": "6cbf95d958c94cd7", "doc_id": "hp_8f217e15be3875b3"}]</data>
  <data key="d3">["hp_8cfa6859d9227577", "hp_8f217e15be3875b3"]</data>
  <data key="d4">False</data>
</node>
