<node id="Earl of Arundel">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The title Earl of Arundel was styled by Edward Fitzalan-Howard between 1975 and 2002.", "chunk_id": "6517718c3566223d", "doc_id": "hp_87afae3cf599b7ed"}, {"text": "The Earl of Arundel is a title that is held by the premier Earl in the peerage of England.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}]</data>
  <data key="d2">[{"text": "Edward William Fitzalan-Howard, 18th Duke of Norfolk, (born 2 December 1956), styled Earl of Arundel between 1975 and 2002, is a British peer, Earl Marshal and son of Miles Fitzalan-Howard, 17th Duke of Norfolk.", "chunk_id": "6517718c3566223d", "doc_id": "hp_87afae3cf599b7ed"}, {"text": "The Duke of Norfolk is the premier Duke in the peerage of England, and also, as Earl of Arundel, the premier Earl.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}]</data>
  <data key="d3">["hp_87afae3cf599b7ed", "hp_c50a06491df52f2d"]</data>
  <data key="d4">False</data>
</node>
<node id="British peer">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Edward William Fitzalan-Howard is a British peer.", "chunk_id": "6517718c3566223d", "doc_id": "hp_87afae3cf599b7ed"}]</data>
  <data key="d2">[{"text": "Edward William Fitzalan-Howard, 18th Duke of Norfolk, (born 2 December 1956), styled Earl of Arundel between 1975 and 2002, is a British peer, Earl Marshal and son of Miles Fitzalan-Howard, 17th Duke of Norfolk.", "chunk_id": "6517718c3566223d", "doc_id": "hp_87afae3cf599b7ed"}]</data>
  <data key="d3">["hp_87afae3cf599b7ed"]</data>
  <data key="d4">False</data>
</node>
<node id="Earl Marshal">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Edward William Fitzalan-Howard holds the position of Earl Marshal.", "chunk_id": "6517718c3566223d", "doc_id": "hp_87afae3cf599b7ed"}, {"text": "The Earl Marshal is an office of an English peerage.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}, {"text": "Earl Marshal is a title held by Charles Howard, 10th Duke of Norfolk.", "chunk_id": "82f681104648a1d9", "doc_id": "hp_d31213ec63e217cc"}]</data>
  <data key="d2">[{"text": "Edward William Fitzalan-Howard, 18th Duke of Norfolk, (born 2 December 1956), styled Earl of Arundel between 1975 and 2002, is a British peer, Earl Marshal and son of Miles Fitzalan-Howard, 17th Duke of Norfolk.", "chunk_id": "6517718c3566223d", "doc_id": "hp_87afae3cf599b7ed"}, {"text": "The Duke of Norfolk is, moreover, the Earl Marshal and hereditary Marshal of England.", "chunk_id": "d5d5843a216fa828", "doc_id": "hp_c50a06491df52f2d"}, {"text": "Charles Howard, 10th Duke of Norfolk, Earl Marshal (1 December 1720 – 31 August 1786), was an English peer and politician.", "chunk_id": "82f681104648a1d9", "doc_id": "hp_d31213ec63e217cc"}]</data>
  <data key="d3">["hp_87afae3cf599b7ed", "hp_c50a06491df52f2d", "hp_d31213ec63e217cc"]</data>
  <data key="d4">False</data>
</node>
