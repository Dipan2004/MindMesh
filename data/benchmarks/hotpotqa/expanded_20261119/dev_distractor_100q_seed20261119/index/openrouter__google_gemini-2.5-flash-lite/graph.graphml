<node id="South Australia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A state in Australia where Kangaroo Island is located.", "chunk_id": "de697cb94cf1954b", "doc_id": "hp_e13c0cde045c0455"}, {"text": "The state in Australia where Adelaide is located.", "chunk_id": "c6546edc8fa1b181", "doc_id": "hp_ea9deb27c486c338"}, {"text": "A state in Australia where Barmera is located and where Donald Neil Kerley played state games.", "chunk_id": "442043eeaf880949", "doc_id": "hp_fe3fc60bc7758add"}]</data>
  <data key="d2">[{"text": "Leslie Gladys Williams (born on Kangaroo Island, South Australia), an Australian politician and a member of the New South Wales Legislative Assembly representing Port Macquarie since 2011 for the Nationals.", "chunk_id": "de697cb94cf1954b", "doc_id": "hp_e13c0cde045c0455"}, {"text": "Jack Ellis Young (31 January 1925 in Adelaide, South Australia – 28 August 1987 in Adelaide) was a Motorcycle speedway rider who won the Speedway World Championship in 1951 and 1952.", "chunk_id": "c6546edc8fa1b181", "doc_id": "hp_ea9deb27c486c338"}, {"text": "Donald Neil Kerley (born 20 February 1934 in Barmera, South Australia) is a former Australian rules football player and coach.", "chunk_id": "442043eeaf880949", "doc_id": "hp_fe3fc60bc7758add"}]</data>
  <data key="d3">["hp_e13c0cde045c0455", "hp_ea9deb27c486c338", "hp_fe3fc60bc7758add"]</data>
  <data key="d4">False</data>
</node>
