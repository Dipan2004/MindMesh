  <data key="d5">["PARTICIPATED_IN"]</data>
  <data key="d6">Slobodan Živojinović was a defending champion and partnered with Boris Becker in the 1991 Donnay Indoor Championships – Doubles.</data>
  <data key="d7">[{"text": "Emilio Sánchez and Slobodan Živojinović were the defending champions, but Sánchez did not participate this year.", "chunk_id": "72b8f48b7ecf936b", "doc_id": "hp_335fb09af115eccf", "type": "PARTICIPATED_IN"}]</data>
  <data key="d8">hp_335fb09af115eccf</data>
</edge>
<edge source="Slobodan Živojinović" target="Boris Becker">
  <data key="d5">["PARTNERED_WITH"]</data>
  <data key="d6">Slobodan Živojinović partnered with Boris Becker in the 1991 Donnay Indoor Championships – Doubles.</data>
  <data key="d7">[{"text": "Živojinović partnered Boris Becker, withdrawing prior to their semifinals match.", "chunk_id": "72b8f48b7ecf936b", "doc_id": "hp_335fb09af115eccf", "type": "PARTNERED_WITH"}]</data>
  <data key="d8">hp_335fb09af115eccf</data>
</edge>
<edge source="Nenad Zimonjić" target="World No. 1 in doubles">
  <data key="d5">["ACHIEVED_RANKING"]</data>
  <data key="d6">Nenad Zimonjić achieved the World No. 1 ranking in doubles.</data>
  <data key="d7">[{"text": "Together with Nenad Zimonjić he is the only tennis player from Serbia to be the World No. 1 in doubles.", "chunk_id": "490dadce2e52df18", "doc_id": "hp_2f7e3f7e6c207aff", "type": "ACHIEVED_RANKING"}]</data>
  <data key="d8">hp_2f7e3f7e6c207aff</data>
</edge>
<edge source="Nenad Zimonjić" target="Slobodan Živojinović">
  <data key="d5">["SUCCESSOR_OF"]</data>
  <data key="d6">Nenad Zimonjić is the second tennis doubles player from Serbia to hold the World No. 1, after Slobodan Živojinović.</data>
  <data key="d7">[{"text": "He is the second tennis doubles player from Serbia to hold the World No. 1, after Slobodan Živojinović.", "chunk_id": "d03416aefc62fa72", "doc_id": "hp_75e8629db66341ba", "type": "SUCCESSOR_OF"}]</data>
  <data key="d8">hp_75e8629db66341ba</data>
</edge>
<edge source="Nenad Zimonjić" target="Davis Cup">
  <data key="d5">["PARTICIPATED_IN"]</data>
  <data key="d6">Nenad Zimonjić has participated in 54 Davis Cup ties.</data>
  <data key="d7">[{"text": "A 22 year span consisting of 54 Davis Cup ties including 43 victories has resulted in him becoming the most accomplished Davis Cup player in his nations history.", "chunk_id": "d03416aefc62fa72", "doc_id": "hp_75e8629db66341ba", "type": "PARTICIPATED_IN"}]</data>
  <data key="d8">hp_75e8629db66341ba</data>
</edge>
<edge source="Jorge Amado" target="The Discovery of America by the Turks">
  <data key="d5">["WROTE", "SUBMITTED"]</data>
  <data key="d6">Jorge Amado is the author of the novel 'The Discovery of America by the Turks'.</data>
  <data key="d7">[{"text": "It was written by Jorge Amado in 1994 but not published in English until 2012.", "chunk_id": "eba842781d3e0f53", "doc_id": "hp_2fa6e4f30229c0a7", "type": "WROTE"}, {"text": "Amado submitted The Discovery of America by the Turks but the Italian book was never published, leaving Amado free to publish the 77-page story as a separate volume.", "chunk_id": "eba842781d3e0f53", "doc_id": "hp_2fa6e4f30229c0a7", "type": "SUBMITTED"}]</data>
  <data key="d8">hp_2fa6e4f30229c0a7</data>
</edge>
<edge source="Jorge Amado" target="The Violent Land">
  <data key="d5">["WROTE"]</data>
  <data key="d6">Jorge Amado is the author of the novel The Violent Land.</data>
  <data key="d7">[{"text": "The Violent Land (Portuguese: Terras do Sem Fim) is a Brazilian Modernist novel written by Jorge Amado in 1943 and published in English in 1945.", "chunk_id": "5b9d731909fa866e", "doc_id": "hp_3182b9b6096ed733", "type": "WROTE"}]</data>
  <data key="d8">hp_3182b9b6096ed733</data>
</edge>
<edge source="Jorge Amado" target="Sea of Death">
  <data key="d5">["WROTE", "WROTE_IN_RESPONSE_TO"]</data>
  <data key="d6">Jorge Amado is the author who wrote the novel Sea of Death.</data>
  <data key="d7">[{"text": "Sea of Death (Portuguese: Mar Morto) is a Brazilian Modernist novel written by Jorge Amado.", "chunk_id": "3fb4165ab8df2c3b", "doc_id": "hp_646fbde6ba07517a", "type": "WROTE"}, {"text": "Amado wrote the novel in response to his first arrest for \"being a communist\".", "chunk_id": "3fb4165ab8df2c3b", "doc_id": "hp_646fbde6ba07517a", "type": "WROTE_IN_RESPONSE_TO"}]</data>
  <data key="d8">hp_646fbde6ba07517a</data>
</edge>
<edge source="Jorge Amado" target="Coutinho family's land">
  <data key="d5">["REFERENCES"]</data>
  <data key="d6">Jorge Amado references the Coutinho family's land in his books.</data>
  <data key="d7">[{"text": "Elsimar Metzker Coutinho (Pojuca, May 18, 1930) is a Brazilian scientist of Luso-Austrian descent, professor, gynecologist and television personality, and character named as \"Prince of Itapoan\", in the books of Jorge Amado which references the Coutinho family's land in Itapoan where Amado himself lived.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0", "type": "REFERENCES"}]</data>
  <data key="d8">hp_ac3086730c4518d0</data>
</edge>
<edge source="Jorge Amado" target="Itapoan">
  <data key="d5">["LIVED_IN"]</data>
  <data key="d6">Jorge Amado lived in Itapoan.</data>
  <data key="d7">[{"text": "Elsimar Metzker Coutinho (Pojuca, May 18, 1930) is a Brazilian scientist of Luso-Austrian descent, professor, gynecologist and television personality, and character named as \"Prince of Itapoan\", in the books of Jorge Amado which references the Coutinho family's land in Itapoan where Amado himself lived.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0", "type": "LIVED_IN"}]</data>
  <data key="d8">hp_ac3086730c4518d0</data>
</edge>
