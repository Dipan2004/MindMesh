<node id="Brooklyn">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A borough of New York City.", "chunk_id": "f564de04eff9c006", "doc_id": "hp_29d27b461a953733"}, {"text": "\"Brooklyn\" is a film produced by Amanda Posey.", "chunk_id": "fd23682473d95ea6", "doc_id": "hp_30782028ac642da1"}, {"text": "Brooklyn is a borough of New York City.", "chunk_id": "ec71908382284000", "doc_id": "hp_353258028a95f6b9"}, {"text": "A film produced by Finola Dwyer.", "chunk_id": "3828ca4f693d4c11", "doc_id": "hp_7ec49f9c2f83c204"}, {"text": "A location in New York where the film Brooklyn is set.", "chunk_id": "9c48cbccc18a0d76", "doc_id": "hp_86e77156fb2dbece"}, {"text": "There is also a wing of the label based in Brooklyn, New York that handles releases in the United States, as well as a German division called Domino Deutschland and a French division called Domino France.", "chunk_id": "ce488a80e2770168", "doc_id": "hp_928492f8f11b78de"}]</data>
  <data key="d2">[{"text": "It is located at Cadman Plaza East near Red Cross Place and the Brooklyn Bridge approach in Brooklyn Heights, Brooklyn.", "chunk_id": "f564de04eff9c006", "doc_id": "hp_29d27b461a953733"}, {"text": "Amanda Rachel Posey (born June 1965) is a British film producer, best known for her films \"An Education\" and \"Brooklyn\", produced with frequent collaborator Finola Dwyer.", "chunk_id": "fd23682473d95ea6", "doc_id": "hp_30782028ac642da1"}, {"text": "Hugpatch Records is a record label based out of Brooklyn, New York.", "chunk_id": "ec71908382284000", "doc_id": "hp_353258028a95f6b9"}, {"text": "Finola Dwyer {'1': \", '2\": \", '3\": \", '4\": \"} is a UK-based New Zealand film producer and editor, best known for her films \"An Education\" and \"Brooklyn\", produced with frequent collaborator Amanda Posey.", "chunk_id": "3828ca4f693d4c11", "doc_id": "hp_7ec49f9c2f83c204"}, {"text": "Set in 1951 and 1952, the film tells the story of a young Irish woman's immigration to Brooklyn, where she falls in love.", "chunk_id": "9c48cbccc18a0d76", "doc_id": "hp_86e77156fb2dbece"}, {"text": "There is also a wing of the label based in Brooklyn, New York that handles releases in the United States, as well as a German division called Domino Deutschland and a French division called Domino France.", "chunk_id": "ce488a80e2770168", "doc_id": "hp_928492f8f11b78de"}]</data>
  <data key="d3">["hp_29d27b461a953733", "hp_30782028ac642da1", "hp_353258028a95f6b9", "hp_7ec49f9c2f83c204", "hp_86e77156fb2dbece", "hp_928492f8f11b78de"]</data>
  <data key="d4">False</data>
</node>
<node id="Washington Street">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "An older street name that intersected with High Street.", "chunk_id": "f564de04eff9c006", "doc_id": "hp_29d27b461a953733"}, {"text": "Washington Streets is a street located in Middletown, between which and Church Streets was a prestigious residential area.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d2">[{"text": "Its name comes from older street names; its original location was at the intersection of High Street and Washington Street.", "chunk_id": "f564de04eff9c006", "doc_id": "hp_29d27b461a953733"}, {"text": "High Street between Church and Washington Streets was the most prestigious residential area in Middletown during the 19th century.", "chunk_id": "f59d19c59637dd92", "doc_id": "hp_a8f5a77458dad7ce"}]</data>
  <data key="d3">["hp_29d27b461a953733", "hp_a8f5a77458dad7ce"]</data>
  <data key="d4">False</data>
</node>
