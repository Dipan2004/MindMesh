</node>
<node id="St Chad's Cathedral">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Metropolitan Cathedral Church and Basilica of Saint Chad, serving as the mother church of the Archdiocese of Birmingham and province of the Catholic Church in Great Britain.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}, {"text": "St Chad's Cathedral is a landmark located opposite the Bishop's House.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d2">[{"text": "The Metropolitan Cathedral Church and Basilica of Saint Chad is the mother church of the Archdiocese of Birmingham and province of the Catholic Church in Great Britain and is dedicated to Saint Chad of Mercia.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}, {"text": "It was situated opposite St Chad's Cathedral, on the corner of Bath Street and Weaman Street in Birmingham City Centre.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}]</data>
  <data key="d3">["hp_0534f445d9d271ad", "hp_1c06089a0ef41f46"]</data>
  <data key="d4">False</data>
</node>
<node id="Saint Chad of Mercia">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The person to whom St Chad's Cathedral is dedicated.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}]</data>
  <data key="d2">[{"text": "The Metropolitan Cathedral Church and Basilica of Saint Chad is the mother church of the Archdiocese of Birmingham and province of the Catholic Church in Great Britain and is dedicated to Saint Chad of Mercia.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}]</data>
  <data key="d3">["hp_0534f445d9d271ad"]</data>
  <data key="d4">False</data>
</node>
<node id="Augustus Welby Pugin">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The architect who built St Chad's Cathedral.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}]</data>
  <data key="d2">[{"text": "Built by Augustus Welby Pugin and substantially complete by 1841, St Chad's is one of the first four Catholic churches that were constructed after the English Reformation and raised to cathedral status in 1852.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}]</data>
  <data key="d3">["hp_0534f445d9d271ad"]</data>
  <data key="d4">False</data>
</node>
<node id="Catholic Church">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A major Christian church that has St Chad's Cathedral as its mother church in the Archdiocese of Birmingham and province in Great Britain.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}, {"text": "The Catholic Church was opposed to the \"vistas\" because of the violence and women portrayed.", "chunk_id": "15bc36547e2dd368", "doc_id": "hp_729cba8a7fa727ec"}]</data>
  <data key="d2">[{"text": "The Metropolitan Cathedral Church and Basilica of Saint Chad is the mother church of the Archdiocese of Birmingham and province of the Catholic Church in Great Britain and is dedicated to Saint Chad of Mercia.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}, {"text": "At the time, the Catholic Church and the press were strongly opposed to the “vistas” because of the violence and women that was portrayed.", "chunk_id": "15bc36547e2dd368", "doc_id": "hp_729cba8a7fa727ec"}]</data>
  <data key="d3">["hp_0534f445d9d271ad", "hp_729cba8a7fa727ec"]</data>
  <data key="d4">False</data>
</node>
<node id="English Reformation">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A historical period during which St Chad's was one of the first four Catholic churches constructed and later raised to cathedral status.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}]</data>
  <data key="d2">[{"text": "Built by Augustus Welby Pugin and substantially complete by 1841, St Chad's is one of the first four Catholic churches that were constructed after the English Reformation and raised to cathedral status in 1852.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}]</data>
  <data key="d3">["hp_0534f445d9d271ad"]</data>
  <data key="d4">False</data>
</node>
<node id="Downside Abbey">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "One of the other minor basilicas in England.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}]</data>
  <data key="d2">[{"text": "It is one of only four minor basilicas in England (the others being Downside Abbey, the National Shrine of Our Lady at Walsingham and Corpus Christi Priory, this last now disused).", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}]</data>
  <data key="d3">["hp_0534f445d9d271ad"]</data>
  <data key="d4">False</data>
</node>
<node id="National Shrine of Our Lady at Walsingham">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "One of the other minor basilicas in England.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}]</data>
  <data key="d2">[{"text": "It is one of only four minor basilicas in England (the others being Downside Abbey, the National Shrine of Our Lady at Walsingham and Corpus Christi Priory, this last now disused).", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}]</data>
  <data key="d3">["hp_0534f445d9d271ad"]</data>
  <data key="d4">False</data>
</node>
<node id="Corpus Christi Priory">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "One of the other minor basilicas in England, now disused.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}]</data>
  <data key="d2">[{"text": "It is one of only four minor basilicas in England (the others being Downside Abbey, the National Shrine of Our Lady at Walsingham and Corpus Christi Priory, this last now disused).", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}]</data>
  <data key="d3">["hp_0534f445d9d271ad"]</data>
  <data key="d4">False</data>
</node>
<node id="Birmingham">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The city where St Chad's Cathedral is located.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}, {"text": "Birmingham is a city in England.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}, {"text": "Birmingham is a city in England.", "chunk_id": "11a5bbb4b1c95f73", "doc_id": "hp_7986a45cdf0624b2"}, {"text": "Birmingham is a city where Superior Bancorp had its corporate headquarters.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d2">[{"text": "The cathedral is located in a public greenspace near St Chad's Queensway, in central Birmingham.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}, {"text": "The Bishop's House in Birmingham, England was designed by Augustus Pugin as the residence of Thomas Walsh, the first Roman Catholic Bishop of Birmingham.", "chunk_id": "74b0b5ae2ae36009", "doc_id": "hp_1c06089a0ef41f46"}, {"text": "St Philip's was built in the early 18th century in the Baroque style by Thomas Archer and is located on Colmore Row, Birmingham, England.", "chunk_id": "11a5bbb4b1c95f73", "doc_id": "hp_7986a45cdf0624b2"}, {"text": "The company was publicly held and had its corporate headquarters in Birmingham, Alabama.", "chunk_id": "6085be5766826ce9", "doc_id": "hp_c26329b4dd98f983"}]</data>
  <data key="d3">["hp_0534f445d9d271ad", "hp_1c06089a0ef41f46", "hp_7986a45cdf0624b2", "hp_c26329b4dd98f983"]</data>
  <data key="d4">False</data>
</node>
<node id="Bernard Longley">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The Archbishop of Birmingham as of 2014.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}]</data>
  <data key="d2">[{"text": "s of 2014 the Archbishop was Bernard Longley and the Dean Canon Gerry Breen.", "chunk_id": "f2b68869424d089d", "doc_id": "hp_0534f445d9d271ad"}]</data>
  <data key="d3">["hp_0534f445d9d271ad"]</data>
  <data key="d4">False</data>
</node>
