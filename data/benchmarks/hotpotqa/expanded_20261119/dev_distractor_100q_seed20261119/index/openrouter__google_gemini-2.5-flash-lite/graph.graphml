  <data key="d2">[{"text": "Divya later acted in films like \"Watan Ke Rakhwale\", \"Ek Hi Maqsad , Aasmaan (1984) , Maa Kasam (1985 film) , Param Dharam as Munnibai)\" and many others.", "chunk_id": "1621f78ea00aa2b4", "doc_id": "hp_140ab3de808ede2a"}]</data>
