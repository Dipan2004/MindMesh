  <data key="d2">[{"text": "She came into the public spot light during her performances on the dance competition television series \"Dance India Dance Li'l Masters\" which she won on 21 June 2014.", "chunk_id": "062d56d562b13557", "doc_id": "hp_7f8b94b73851a963"}]</data>
