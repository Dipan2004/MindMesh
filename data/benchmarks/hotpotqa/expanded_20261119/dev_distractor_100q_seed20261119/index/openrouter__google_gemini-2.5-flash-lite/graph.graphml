</node>
<node id="Pam Teeguarden">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Pam Teeguarden is a former American professional tennis player.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d2">[{"text": "Pam Teeguarden (born April 17, 1951) is a former American professional tennis player in the 1970s and 1980s, ranked in the top 20 from 1970–1975, according to \"John Dolan's Women's Tennis Ultimate Guide\", prior to computer rankings.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d3">["hp_8e9d4247e8ae3a7a"]</data>
  <data key="d4">False</data>
</node>
<node id="John Dolan's Women's Tennis Ultimate Guide">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A guide that provided rankings for women's tennis prior to computer rankings.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d2">[{"text": "Pam Teeguarden (born April 17, 1951) is a former American professional tennis player in the 1970s and 1980s, ranked in the top 20 from 1970–1975, according to \"John Dolan's Women's Tennis Ultimate Guide\", prior to computer rankings.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d3">["hp_8e9d4247e8ae3a7a"]</data>
  <data key="d4">False</data>
</node>
<node id="Jerry Teeguarden">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Jerry Teeguarden is the father of Pam Teeguarden and a well-known coach.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d2">[{"text": "Her father Jerry, a well known coach, helped Margaret Court win the coveted Grand Slam (all four Grand Slam titles in one year) in 1970 and Virginia Wade to her 1977 Wimbledon triumph.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d3">["hp_8e9d4247e8ae3a7a"]</data>
  <data key="d4">False</data>
</node>
<node id="Virginia Wade">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Virginia Wade is a tennis player who achieved a Wimbledon triumph in 1977.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d2">[{"text": "Her father Jerry, a well known coach, helped Margaret Court win the coveted Grand Slam (all four Grand Slam titles in one year) in 1970 and Virginia Wade to her 1977 Wimbledon triumph.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d3">["hp_8e9d4247e8ae3a7a"]</data>
  <data key="d4">False</data>
</node>
<node id="Madison Avenue advertising executives">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A group of advertising executives from Madison Avenue who voted Pam Teeguarden the \"Most Watchable Player\".", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d2">[{"text": "Teeguarden was voted the \"Most Watchable Player\" based on play and appearance by a group of Madison Avenue advertising executives or \"Mad Men\" while playing at the US Open.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d3">["hp_8e9d4247e8ae3a7a"]</data>
  <data key="d4">False</data>
</node>
<node id="Mad Men">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An alternative name for Madison Avenue advertising executives.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d2">[{"text": "Teeguarden was voted the \"Most Watchable Player\" based on play and appearance by a group of Madison Avenue advertising executives or \"Mad Men\" while playing at the US Open.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d3">["hp_8e9d4247e8ae3a7a"]</data>
  <data key="d4">False</data>
</node>
<node id="Chris Evert">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Chris Evert is a tennis player who played in 20 consecutive US Opens, surpassing Pam Teeguarden's record.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d2">[{"text": "Teeguarden played in 19 consecutive US Opens, holding the record until Chris Evert played in 20.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d3">["hp_8e9d4247e8ae3a7a"]</data>
  <data key="d4">False</data>
</node>
<node id="Los Angeles Strings Team Tennis team">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A team that Pam Teeguarden played on and was victorious with in 1981.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d2">[{"text": "She played on the victorious Los Angeles Strings Team Tennis team in 1981 and won the Team Tennis Mixed Doubles Division with Tom Gullikson in 1977; they were also runners-up in the league that year.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d3">["hp_8e9d4247e8ae3a7a"]</data>
  <data key="d4">False</data>
</node>
<node id="Tom Gullikson">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Tom Gullikson is a tennis player who won the Team Tennis Mixed Doubles Division with Pam Teeguarden in 1977.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d2">[{"text": "She played on the victorious Los Angeles Strings Team Tennis team in 1981 and won the Team Tennis Mixed Doubles Division with Tom Gullikson in 1977; they were also runners-up in the league that year.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d3">["hp_8e9d4247e8ae3a7a"]</data>
  <data key="d4">False</data>
</node>
<node id="The French Open">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A Grand Slam tennis tournament where Pam Teeguarden was a quarter finalist in singles.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d2">[{"text": "She won two Grand Slam Doubles Titles and was a quarter finalist in singles at the U.S. Open and The French Open.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d3">["hp_8e9d4247e8ae3a7a"]</data>
  <data key="d4">False</data>
</node>
<node id="The Bridgestone Doubles Championships">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A tennis tournament held in Tokyo in 1975 where Pam Teeguarden wore the first all-black outfit.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d2">[{"text": "She wore the first all black outfit in the history of tennis in 1975 at The Bridgestone Doubles Championships in Tokyo, starting a trend that is still popular today.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d3">["hp_8e9d4247e8ae3a7a"]</data>
  <data key="d4">False</data>
</node>
<node id="Grand Slam">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Winning all four Grand Slam tennis titles in one year.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d2">[{"text": "Her father Jerry, a well known coach, helped Margaret Court win the coveted Grand Slam (all four Grand Slam titles in one year) in 1970 and Virginia Wade to her 1977 Wimbledon triumph.", "chunk_id": "b07f6a48318ea8c0", "doc_id": "hp_8e9d4247e8ae3a7a"}]</data>
  <data key="d3">["hp_8e9d4247e8ae3a7a"]</data>
  <data key="d4">False</data>
</node>
