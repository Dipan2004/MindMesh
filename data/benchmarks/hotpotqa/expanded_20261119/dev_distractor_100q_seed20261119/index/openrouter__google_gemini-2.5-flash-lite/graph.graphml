  <data key="d2">[{"text": "The scientific name derives from the 19th century Portuguese geologist Fernando da Costa Leal, who described the Bottle tree during an exploration in southern Angola.", "chunk_id": "6be220bfddc2114d", "doc_id": "hp_c0400b095de3dd7b"}]</data>
