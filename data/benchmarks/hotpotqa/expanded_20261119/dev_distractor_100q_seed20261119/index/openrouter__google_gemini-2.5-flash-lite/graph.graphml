  <data key="d7">[{"text": "Tongyeong (] ) is a coastal city in South Gyeongsang Province, South Korea.", "chunk_id": "c3d0968c45bdecd5", "doc_id": "hp_5597a745514f1f39", "type": "LOCATED_IN"}]</data>
