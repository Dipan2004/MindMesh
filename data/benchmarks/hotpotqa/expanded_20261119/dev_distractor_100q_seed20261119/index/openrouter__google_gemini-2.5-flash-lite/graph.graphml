<node id="Alice in Chains">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An American rock band.", "chunk_id": "ac14247b71085709", "doc_id": "hp_0c8c04014969d68b"}, {"text": "The band that performed the song \"Your Decision\".", "chunk_id": "a5827a6383be59e3", "doc_id": "hp_6033a8a5e79f67f7"}, {"text": "Alice in Chains is an American rock band.", "chunk_id": "0ab7d428406248fd", "doc_id": "hp_62d25a1f81638a35"}, {"text": "Alice in Chains is a band that released the album \"Black Gives Way to Blue\".", "chunk_id": "c77d6dbc2b68e499", "doc_id": "hp_78545ba127712d38"}, {"text": "An American rock band.", "chunk_id": "a02521ae2928a8dd", "doc_id": "hp_7e9f73906e63aaa8"}, {"text": "Alice in Chains is an American band that participated in the Blackdiamondskye tour.", "chunk_id": "45cede6375eed8fe", "doc_id": "hp_87324daa70fdbf7e"}, {"text": "Alice in Chains is an alternative metal band.", "chunk_id": "d4b180f1810dfb51", "doc_id": "hp_98b62ec679c7b310"}, {"text": "An American rock band.", "chunk_id": "4943bcc30a38ea88", "doc_id": "hp_b5f26a3c7ae777dc"}, {"text": "An American metal band.", "chunk_id": "e152947c3cf74e57", "doc_id": "hp_c79be23e68ef1865"}]</data>
  <data key="d2">[{"text": "The Devil Put Dinosaurs Here is the fifth studio album by the American rock band Alice in Chains, released on May 28, 2013.", "chunk_id": "ac14247b71085709", "doc_id": "hp_0c8c04014969d68b"}, {"text": "\"Your Decision\" is a song by Alice in Chains, featured on their fourth studio album \"Black Gives Way to Blue\" (2009).", "chunk_id": "a5827a6383be59e3", "doc_id": "hp_6033a8a5e79f67f7"}, {"text": "\"Check My Brain\" is a song by the American rock band Alice in Chains, featured on their fourth studio album \"Black Gives Way to Blue\" (2009).", "chunk_id": "0ab7d428406248fd", "doc_id": "hp_62d25a1f81638a35"}, {"text": "Staub also mixed Alice in Chains' fourth studio album, \"Black Gives Way to Blue\".", "chunk_id": "c77d6dbc2b68e499", "doc_id": "hp_78545ba127712d38"}, {"text": "Black Gives Way to Blue is the fourth studio album by the American rock band Alice in Chains, released in September 29, 2009.", "chunk_id": "a02521ae2928a8dd", "doc_id": "hp_7e9f73906e63aaa8"}, {"text": "Blackdiamondskye was a 2010 North American concert tour by American bands Alice in Chains, Mastodon, and Deftones.", "chunk_id": "45cede6375eed8fe", "doc_id": "hp_87324daa70fdbf7e"}, {"text": "William Bradley DuVall (born September 6, 1967) is an American musician, best known as being the current co-vocalist and a rhythm guitarist for the alternative metal band Alice in Chains replacing original vocalist Layne Staley, who died in 2002.", "chunk_id": "d4b180f1810dfb51", "doc_id": "hp_98b62ec679c7b310"}, {"text": "\"Lesson Learned\" is a song by the American rock band Alice in Chains, featured on their fourth studio album, \"Black Gives Way to Blue\" (2009).", "chunk_id": "4943bcc30a38ea88", "doc_id": "hp_b5f26a3c7ae777dc"}, {"text": "\"A Looking in View\" is a song by American metal band Alice in Chains, featured on their fourth studio album \"Black Gives Way to Blue\" (2009).", "chunk_id": "e152947c3cf74e57", "doc_id": "hp_c79be23e68ef1865"}]</data>
  <data key="d3">["hp_0c8c04014969d68b", "hp_6033a8a5e79f67f7", "hp_62d25a1f81638a35", "hp_78545ba127712d38", "hp_7e9f73906e63aaa8", "hp_87324daa70fdbf7e", "hp_98b62ec679c7b310", "hp_b5f26a3c7ae777dc", "hp_c79be23e68ef1865"]</data>
  <data key="d4">False</data>
</node>
<node id="May 28, 2013">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The release date of the album 'The Devil Put Dinosaurs Here'.", "chunk_id": "ac14247b71085709", "doc_id": "hp_0c8c04014969d68b"}]</data>
  <data key="d2">[{"text": "The Devil Put Dinosaurs Here is the fifth studio album by the American rock band Alice in Chains, released on May 28, 2013.", "chunk_id": "ac14247b71085709", "doc_id": "hp_0c8c04014969d68b"}]</data>
  <data key="d3">["hp_0c8c04014969d68b"]</data>
  <data key="d4">False</data>
</node>
<node id="Black Gives Way to Blue">
  <data key="d0">ALBUM</data>
  <data key="d1">[{"text": "The previous album by Alice in Chains, released in 2009.", "chunk_id": "ac14247b71085709", "doc_id": "hp_0c8c04014969d68b"}, {"text": "The fourth studio album by Alice in Chains, released in 2009.", "chunk_id": "a5827a6383be59e3", "doc_id": "hp_6033a8a5e79f67f7"}, {"text": "Black Gives Way to Blue is the fourth studio album by Alice in Chains.", "chunk_id": "0ab7d428406248fd", "doc_id": "hp_62d25a1f81638a35"}, {"text": "\"Black Gives Way to Blue\" is the fourth studio album by Alice in Chains.", "chunk_id": "c77d6dbc2b68e499", "doc_id": "hp_78545ba127712d38"}, {"text": "The fourth studio album by the American rock band Alice in Chains.", "chunk_id": "a02521ae2928a8dd", "doc_id": "hp_7e9f73906e63aaa8"}, {"text": "Black Gives Way to Blue is an album by Alice in Chains, which contributed to the name of the Blackdiamondskye tour.", "chunk_id": "45cede6375eed8fe", "doc_id": "hp_87324daa70fdbf7e"}, {"text": "Black Gives Way to Blue is an album by Alice in Chains released in 2009.", "chunk_id": "d4b180f1810dfb51", "doc_id": "hp_98b62ec679c7b310"}, {"text": "The fourth studio album by Alice in Chains.", "chunk_id": "4943bcc30a38ea88", "doc_id": "hp_b5f26a3c7ae777dc"}, {"text": "The fourth studio album by Alice in Chains.", "chunk_id": "e152947c3cf74e57", "doc_id": "hp_c79be23e68ef1865"}]</data>
  <data key="d2">[{"text": "Following a worldwide tour in support of its previous album, \"Black Gives Way to Blue\" (2009), Alice in Chains began work on a new album.", "chunk_id": "ac14247b71085709", "doc_id": "hp_0c8c04014969d68b"}, {"text": "\"Your Decision\" is a song by Alice in Chains, featured on their fourth studio album \"Black Gives Way to Blue\" (2009).", "chunk_id": "a5827a6383be59e3", "doc_id": "hp_6033a8a5e79f67f7"}, {"text": "\"Check My Brain\" is a song by the American rock band Alice in Chains, featured on their fourth studio album \"Black Gives Way to Blue\" (2009).", "chunk_id": "0ab7d428406248fd", "doc_id": "hp_62d25a1f81638a35"}, {"text": "Staub also mixed Alice in Chains' fourth studio album, \"Black Gives Way to Blue\".", "chunk_id": "c77d6dbc2b68e499", "doc_id": "hp_78545ba127712d38"}, {"text": "Black Gives Way to Blue is the fourth studio album by the American rock band Alice in Chains, released in September 29, 2009.", "chunk_id": "a02521ae2928a8dd", "doc_id": "hp_7e9f73906e63aaa8"}, {"text": "Blackdiamondskye is a portmanteau of the three band's most recent albums: Alice in Chains' \"Black Gives Way to Blue\", Deftones' \"Diamond Eyes\", and Mastodon's \"Crack the Skye\".", "chunk_id": "45cede6375eed8fe", "doc_id": "hp_87324daa70fdbf7e"}, {"text": "DuVall joined Alice in Chains in 2006, and he appears on the 2009 album \"Black Gives Way to Blue\" as well as the 2013 follow-up \"The Devil Put Dinosaurs Here\".", "chunk_id": "d4b180f1810dfb51", "doc_id": "hp_98b62ec679c7b310"}, {"text": "\"Lesson Learned\" is a song by the American rock band Alice in Chains, featured on their fourth studio album, \"Black Gives Way to Blue\" (2009).", "chunk_id": "4943bcc30a38ea88", "doc_id": "hp_b5f26a3c7ae777dc"}, {"text": "\"A Looking in View\" is a song by American metal band Alice in Chains, featured on their fourth studio album \"Black Gives Way to Blue\" (2009).", "chunk_id": "e152947c3cf74e57", "doc_id": "hp_c79be23e68ef1865"}]</data>
  <data key="d3">["hp_0c8c04014969d68b", "hp_6033a8a5e79f67f7", "hp_62d25a1f81638a35", "hp_78545ba127712d38", "hp_7e9f73906e63aaa8", "hp_87324daa70fdbf7e", "hp_98b62ec679c7b310", "hp_b5f26a3c7ae777dc", "hp_c79be23e68ef1865"]</data>
  <data key="d4">False</data>
</node>
<node id="July 2011">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The month and year Alice in Chains entered the studio to start work on their fifth album.", "chunk_id": "ac14247b71085709", "doc_id": "hp_0c8c04014969d68b"}]</data>
  <data key="d2">[{"text": "The band entered the studio in July 2011 to start work on their fifth album.", "chunk_id": "ac14247b71085709", "doc_id": "hp_0c8c04014969d68b"}]</data>
  <data key="d3">["hp_0c8c04014969d68b"]</data>
  <data key="d4">False</data>
</node>
<node id="Jerry Cantrell">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Guitarist for Alice in Chains who underwent shoulder surgery.", "chunk_id": "ac14247b71085709", "doc_id": "hp_0c8c04014969d68b"}]</data>
  <data key="d2">[{"text": "During the writing and recording sessions, guitarist Jerry Cantrell underwent shoulder surgery, which resulted in the delay of the album.", "chunk_id": "ac14247b71085709", "doc_id": "hp_0c8c04014969d68b"}]</data>
  <data key="d3">["hp_0c8c04014969d68b"]</data>
  <data key="d4">False</data>
</node>
<node id="December 2012">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The month and year the recording sessions of 'The Devil Put Dinosaurs Here' were completed.", "chunk_id": "ac14247b71085709", "doc_id": "hp_0c8c04014969d68b"}]</data>
  <data key="d2">[{"text": "The recording sessions of \"The Devil Put Dinosaurs Here\" were completed in December 2012.", "chunk_id": "ac14247b71085709", "doc_id": "hp_0c8c04014969d68b"}]</data>
  <data key="d3">["hp_0c8c04014969d68b"]</data>
  <data key="d4">False</data>
</node>
<node id="Ningxiang High-tech Industrial Park">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Ningxiang High-tech Industrial Park is a high-tech industrial park at the province level in Ningxiang City, Hunan Province, China.", "chunk_id": "e5fc7c6607c7f74d", "doc_id": "hp_0cadb19ab7b7f673"}]</data>
  <data key="d2">[{"text": "Ningxiang High-tech Industrial Park () is a High tech industrial park at province level in Ningxiang City, Hunan Province, China.", "chunk_id": "e5fc7c6607c7f74d", "doc_id": "hp_0cadb19ab7b7f673"}]</data>
  <data key="d3">["hp_0cadb19ab7b7f673"]</data>
  <data key="d4">False</data>
</node>
<node id="Jinzhou New Urban Area Industrial Concentration District">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Jinzhou New Urban Area Industrial Concentration District was the original name of the Ningxiang High-tech Industrial Park, created in 2006.", "chunk_id": "e5fc7c6607c7f74d", "doc_id": "hp_0cadb19ab7b7f673"}]</data>
  <data key="d2">[{"text": "It is the original Jinzhou New Urban Area Industrial Concentration District () created in 2006;", "chunk_id": "e5fc7c6607c7f74d", "doc_id": "hp_0cadb19ab7b7f673"}]</data>
  <data key="d3">["hp_0cadb19ab7b7f673"]</data>
  <data key="d4">False</data>
</node>
<node id="Jinzhou New Urban Area">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Jinzhou New Urban Area is a common short name for the Jinzhou New Urban Area Industrial Concentration District.", "chunk_id": "e5fc7c6607c7f74d", "doc_id": "hp_0cadb19ab7b7f673"}]</data>
  <data key="d2">[{"text": "it is usually referred to as \"Jinzhou New Urban Area\" () for short.", "chunk_id": "e5fc7c6607c7f74d", "doc_id": "hp_0cadb19ab7b7f673"}]</data>
  <data key="d3">["hp_0cadb19ab7b7f673"]</data>
  <data key="d4">False</data>
</node>
<node id="Ningxiang City">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Ningxiang City is a city in Hunan Province, China, where the Ningxiang High-tech Industrial Park is located.", "chunk_id": "e5fc7c6607c7f74d", "doc_id": "hp_0cadb19ab7b7f673"}]</data>
  <data key="d2">[{"text": "Ningxiang High-tech Industrial Park () is a High tech industrial park at province level in Ningxiang City, Hunan Province, China.", "chunk_id": "e5fc7c6607c7f74d", "doc_id": "hp_0cadb19ab7b7f673"}]</data>
  <data key="d3">["hp_0cadb19ab7b7f673"]</data>
  <data key="d4">False</data>
</node>
<node id="Hunan Province">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Hunan Province is a province in China where Ningxiang City is located.", "chunk_id": "e5fc7c6607c7f74d", "doc_id": "hp_0cadb19ab7b7f673"}, {"text": "A province in China.", "chunk_id": "6acf624f54ca7f79", "doc_id": "hp_a2f0f467a0548d2b"}]</data>
  <data key="d2">[{"text": "Ningxiang High-tech Industrial Park () is a High tech industrial park at province level in Ningxiang City, Hunan Province, China.", "chunk_id": "e5fc7c6607c7f74d", "doc_id": "hp_0cadb19ab7b7f673"}, {"text": "Liuyang Two-oriented Industrial Park () is an agricultural products processing industrial park at province level in Liuyang City, Hunan Province, China.", "chunk_id": "6acf624f54ca7f79", "doc_id": "hp_a2f0f467a0548d2b"}]</data>
  <data key="d3">["hp_0cadb19ab7b7f673", "hp_a2f0f467a0548d2b"]</data>
  <data key="d4">False</data>
</node>
<node id="Jinzhou Town">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Jinzhou Town is the core area of the Ningxiang High-tech Industrial Park.", "chunk_id": "e5fc7c6607c7f74d", "doc_id": "hp_0cadb19ab7b7f673"}]</data>
  <data key="d2">[{"text": "Its core area is in Jinzhou Town, the industrial park is a part of the core zone of Xiangjiang New Area.", "chunk_id": "e5fc7c6607c7f74d", "doc_id": "hp_0cadb19ab7b7f673"}]</data>
  <data key="d3">["hp_0cadb19ab7b7f673"]</data>
  <data key="d4">False</data>
</node>
<node id="Xiangjiang New Area">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Xiangjiang New Area is a core zone, and the Ningxiang High-tech Industrial Park is a part of it.", "chunk_id": "e5fc7c6607c7f74d", "doc_id": "hp_0cadb19ab7b7f673"}]</data>
  <data key="d2">[{"text": "Its core area is in Jinzhou Town, the industrial park is a part of the core zone of Xiangjiang New Area.", "chunk_id": "e5fc7c6607c7f74d", "doc_id": "hp_0cadb19ab7b7f673"}]</data>
  <data key="d3">["hp_0cadb19ab7b7f673"]</data>
  <data key="d4">False</data>
</node>
<node id="1918 Allan Cup">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 1918 Allan Cup was the Canadian national senior ice hockey championship for the 1917-18 Senior season.", "chunk_id": "af23101286e3cc88", "doc_id": "hp_0cfa6ed1fb9c0e08"}]</data>
  <data key="d2">[{"text": "The 1918 Allan Cup was the Canadian national senior ice hockey championship for the 1917-18 Senior season.", "chunk_id": "af23101286e3cc88", "doc_id": "hp_0cfa6ed1fb9c0e08"}]</data>
  <data key="d3">["hp_0cfa6ed1fb9c0e08"]</data>
  <data key="d4">False</data>
</node>
<node id="Canadian national senior ice hockey championship">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The Canadian national senior ice hockey championship is a competition for the 1917-18 Senior season.", "chunk_id": "af23101286e3cc88", "doc_id": "hp_0cfa6ed1fb9c0e08"}]</data>
  <data key="d2">[{"text": "The 1918 Allan Cup was the Canadian national senior ice hockey championship for the 1917-18 Senior season.", "chunk_id": "af23101286e3cc88", "doc_id": "hp_0cfa6ed1fb9c0e08"}]</data>
  <data key="d3">["hp_0cfa6ed1fb9c0e08"]</data>
  <data key="d4">False</data>
</node>
<node id="Kitchener Greenshirts">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The Kitchener Greenshirts hosted the final challenge for the 1918 Allan Cup.", "chunk_id": "af23101286e3cc88", "doc_id": "hp_0cfa6ed1fb9c0e08"}]</data>
  <data key="d2">[{"text": "The final challenge was hosted by the Kitchener Greenshirts and Toronto, Ontario.", "chunk_id": "af23101286e3cc88", "doc_id": "hp_0cfa6ed1fb9c0e08"}]</data>
  <data key="d3">["hp_0cfa6ed1fb9c0e08"]</data>
  <data key="d4">False</data>
</node>
<node id="Toronto, Ontario">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Toronto, Ontario was a location where the final challenge for the 1918 Allan Cup was hosted.", "chunk_id": "af23101286e3cc88", "doc_id": "hp_0cfa6ed1fb9c0e08"}]</data>
  <data key="d2">[{"text": "The final challenge was hosted by the Kitchener Greenshirts and Toronto, Ontario.", "chunk_id": "af23101286e3cc88", "doc_id": "hp_0cfa6ed1fb9c0e08"}]</data>
  <data key="d3">["hp_0cfa6ed1fb9c0e08"]</data>
  <data key="d4">False</data>
</node>
<node id="Gollum browser">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Gollum browser is a web application designed to browse Wikipedia in an easier way than directly using the web browser.", "chunk_id": "1900876eb0183fa0", "doc_id": "hp_0d2b9749009e4dd9"}]</data>
  <data key="d2">[{"text": "Gollum browser is a web application designed to browse Wikipedia in an easier way than directly using the web browser.", "chunk_id": "1900876eb0183fa0", "doc_id": "hp_0d2b9749009e4dd9"}]</data>
  <data key="d3">["hp_0d2b9749009e4dd9"]</data>
  <data key="d4">False</data>
</node>
<node id="Wikipedia">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Wikipedia is a web-based, free content encyclopedia.", "chunk_id": "1900876eb0183fa0", "doc_id": "hp_0d2b9749009e4dd9"}, {"text": "An online, user-editable encyclopedia.", "chunk_id": "f591d9caea3d5b63", "doc_id": "hp_4173a308cdb39479"}, {"text": "A collaborative, web-based, free-content encyclopedia project.", "chunk_id": "903bcebb130bdbec", "doc_id": "hp_c9583d290063614a"}]</data>
  <data key="d2">[{"text": "Gollum browser is a web application designed to browse Wikipedia in an easier way than directly using the web browser.", "chunk_id": "1900876eb0183fa0", "doc_id": "hp_0d2b9749009e4dd9"}, {"text": "Truth in Numbers? Everything, According to Wikipedia is a 2010 American documentary film that explores the history and cultural implications of the online, user-editable encyclopedia Wikipedia.", "chunk_id": "f591d9caea3d5b63", "doc_id": "hp_4173a308cdb39479"}, {"text": "The Truth According to Wikipedia, also referred to as Wiki's Truth (Dutch: Wiki's Waarheid ), is a Dutch documentary about Wikipedia directed by Ijsbrand van Veelen.", "chunk_id": "903bcebb130bdbec", "doc_id": "hp_c9583d290063614a"}]</data>
  <data key="d3">["hp_0d2b9749009e4dd9", "hp_4173a308cdb39479", "hp_c9583d290063614a"]</data>
  <data key="d4">False</data>
</node>
<node id="Harald Hanek">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Harald Hanek is the creator of the Gollum browser.", "chunk_id": "1900876eb0183fa0", "doc_id": "hp_0d2b9749009e4dd9"}]</data>
  <data key="d2">[{"text": "Gollum was created by Harald Hanek in 2005 using PHP and Ajax.", "chunk_id": "1900876eb0183fa0", "doc_id": "hp_0d2b9749009e4dd9"}]</data>
  <data key="d3">["hp_0d2b9749009e4dd9"]</data>
  <data key="d4">False</data>
</node>
<node id="PHP">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "PHP is a popular general-purpose scripting language that is especially suited to web development.", "chunk_id": "1900876eb0183fa0", "doc_id": "hp_0d2b9749009e4dd9"}]</data>
  <data key="d2">[{"text": "Gollum was created by Harald Hanek in 2005 using PHP and Ajax.", "chunk_id": "1900876eb0183fa0", "doc_id": "hp_0d2b9749009e4dd9"}]</data>
  <data key="d3">["hp_0d2b9749009e4dd9"]</data>
  <data key="d4">False</data>
</node>
<node id="Ajax">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "Ajax is a set of asynchronous programming techniques used for the creation of interactive web applications.", "chunk_id": "1900876eb0183fa0", "doc_id": "hp_0d2b9749009e4dd9"}]</data>
  <data key="d2">[{"text": "Gollum was created by Harald Hanek in 2005 using PHP and Ajax.", "chunk_id": "1900876eb0183fa0", "doc_id": "hp_0d2b9749009e4dd9"}]</data>
  <data key="d3">["hp_0d2b9749009e4dd9"]</data>
  <data key="d4">False</data>
</node>
<node id="Chinese rule">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The governance and authority of China over a territory.", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1"}]</data>
  <data key="d2">[{"text": "Immediately after the handover of Hong Kong back to Chinese rule, Hong Kong's Legislative Council passed an amendment to the Basic Law that would restrict immigration to children born outside of Hong Kong that were born to Hong Kong residents.", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1"}]</data>
  <data key="d3">["hp_0e063f0231106ec1"]</data>
  <data key="d4">False</data>
</node>
<node id="Hong Kong's Legislative Council">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The legislative body of Hong Kong.", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1"}]</data>
  <data key="d2">[{"text": "Immediately after the handover of Hong Kong back to Chinese rule, Hong Kong's Legislative Council passed an amendment to the Basic Law that would restrict immigration to children born outside of Hong Kong that were born to Hong Kong residents.", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1"}]</data>
  <data key="d3">["hp_0e063f0231106ec1"]</data>
  <data key="d4">False</data>
</node>
<node id="Basic Law">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The constitutional document of Hong Kong.", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1"}]</data>
  <data key="d2">[{"text": "Immediately after the handover of Hong Kong back to Chinese rule, Hong Kong's Legislative Council passed an amendment to the Basic Law that would restrict immigration to children born outside of Hong Kong that were born to Hong Kong residents.", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1"}]</data>
  <data key="d3">["hp_0e063f0231106ec1"]</data>
  <data key="d4">False</data>
</node>
<node id="Court of Final Appeal">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The highest court in Hong Kong.", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1"}, {"text": "The highest court in Hong Kong.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d2">[{"text": "The constitutionality of this amendment came to be challenged in court, and in January 1999, the Court of Final Appeal ruled against the amendment.", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1"}, {"text": "Director of Immigration v. Chong Fung Yuen was a 2001 case in Hong Kong's Court of Final Appeal.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d3">["hp_0e063f0231106ec1", "hp_3bad22e58989e25f"]</data>
  <data key="d4">False</data>
</node>
<node id="mainland China">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The continental part of China, excluding its special administrative regions and islands.", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1"}, {"text": "The country where the film Crazy Stone was produced and released.", "chunk_id": "a13465975c9baab0", "doc_id": "hp_4ef90677e921765c"}]</data>
  <data key="d2">[{"text": "This ruling immediately granted up to 300,000 people in mainland China the right of abode in Hong Kong, and it was estimated that within the next ten years, about 1.6 million people in mainland China would become eligible for right of abode in Hong Kong.", "chunk_id": "7074f7b060a6535a", "doc_id": "hp_0e063f0231106ec1"}, {"text": "Crazy Stone () is a 2006 mainland Chinese black comedy film directed by Ning Hao and produced by Andy Lau.", "chunk_id": "a13465975c9baab0", "doc_id": "hp_4ef90677e921765c"}]</data>
  <data key="d3">["hp_0e063f0231106ec1", "hp_4ef90677e921765c"]</data>
  <data key="d4">False</data>
</node>
<node id="Phil Driscoll">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A trumpeter, singer, composer, and producer who performs in various music genres and styles.", "chunk_id": "73ee4754182774e7", "doc_id": "hp_0e12ea58b60d4b89"}]</data>
  <data key="d2">[{"text": "Phil Driscoll (born November 9, 1947) is a trumpeter, singer, composer, and producer.", "chunk_id": "73ee4754182774e7", "doc_id": "hp_0e12ea58b60d4b89"}]</data>
  <data key="d3">["hp_0e12ea58b60d4b89"]</data>
  <data key="d4">False</data>
</node>
<node id="rock and roll">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A music genre and style that Phil Driscoll performs in.", "chunk_id": "73ee4754182774e7", "doc_id": "hp_0e12ea58b60d4b89"}]</data>
  <data key="d2">[{"text": "He performs in varying music genres and styles which include rock and roll, rhythm and blues, and patriotic music, and is best known for his work in Christian music and his longterm Christian ministry.", "chunk_id": "73ee4754182774e7", "doc_id": "hp_0e12ea58b60d4b89"}]</data>
  <data key="d3">["hp_0e12ea58b60d4b89"]</data>
  <data key="d4">False</data>
</node>
