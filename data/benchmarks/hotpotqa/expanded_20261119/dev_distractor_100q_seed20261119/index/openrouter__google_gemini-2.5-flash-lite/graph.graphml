<node id="tikkun kor'im">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "There are two types of tikkun, a \"tikkun kor'im\" and a \"tikkun soferim\".", "chunk_id": "3853c8ec18df06f6", "doc_id": "hp_3a31e87c9b9c8fd2"}]</data>
  <data key="d2">[{"text": "There are two types of tikkun, a \"tikkun kor'im\" and a \"tikkun soferim\".", "chunk_id": "3853c8ec18df06f6", "doc_id": "hp_3a31e87c9b9c8fd2"}]</data>
  <data key="d3">["hp_3a31e87c9b9c8fd2"]</data>
  <data key="d4">False</data>
</node>
