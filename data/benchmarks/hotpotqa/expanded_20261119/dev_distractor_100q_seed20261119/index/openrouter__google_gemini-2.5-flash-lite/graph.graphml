  <data key="d7">[{"text": "Among the executive producers are Seth MacFarlane, whose financial investment was instrumental in bringing the show to broadcast television, and Ann Druyan, a co-author and co-creator of the original television series and Sagan's wife.", "chunk_id": "fcc0f6c36b9c6443", "doc_id": "hp_48076015d5a62427", "type": "CO_CREATOR_OF"}]</data>
  <data key="d8">hp_48076015d5a62427</data>
</edge>
