<node id="Teatro Giuseppe Verdi">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A small opera house located in a wing of the Rocca dei Marchesi Pallavicino.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}]</data>
  <data key="d2">[{"text": "Teatro Giuseppe Verdi (the Giuseppe Verdi Theatre) is a small opera house located in a wing of the Rocca dei Marchesi Pallavicino on the Piazza Giuseppe Verdi in Busseto, Italy, a town closely associated with the life of the opera composer, Giuseppe Verdi.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}]</data>
  <data key="d3">["hp_22c8c1dec547c159"]</data>
  <data key="d4">False</data>
</node>
<node id="Rocca dei Marchesi Pallavicino">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A fortress that was the family's palace and is now the city hall.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}]</data>
  <data key="d2">[{"text": "Teatro Giuseppe Verdi (the Giuseppe Verdi Theatre) is a small opera house located in a wing of the Rocca dei Marchesi Pallavicino on the Piazza Giuseppe Verdi in Busseto, Italy, a town closely associated with the life of the opera composer, Giuseppe Verdi.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}]</data>
  <data key="d3">["hp_22c8c1dec547c159"]</data>
  <data key="d4">False</data>
</node>
<node id="Piazza Giuseppe Verdi">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A piazza in Busseto, Italy.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}]</data>
  <data key="d2">[{"text": "Teatro Giuseppe Verdi (the Giuseppe Verdi Theatre) is a small opera house located in a wing of the Rocca dei Marchesi Pallavicino on the Piazza Giuseppe Verdi in Busseto, Italy, a town closely associated with the life of the opera composer, Giuseppe Verdi.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}]</data>
  <data key="d3">["hp_22c8c1dec547c159"]</data>
  <data key="d4">False</data>
</node>
<node id="Busseto">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A town closely associated with the life of the opera composer, Giuseppe Verdi.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}, {"text": "Busseto is a town very close to Le Roncole, where Verdi was born, and where the St. Bartolomeo cathedral is located.", "chunk_id": "6f1f0a0b8ceacebf", "doc_id": "hp_504f3a1745c4e938"}]</data>
  <data key="d2">[{"text": "Teatro Giuseppe Verdi (the Giuseppe Verdi Theatre) is a small opera house located in a wing of the Rocca dei Marchesi Pallavicino on the Piazza Giuseppe Verdi in Busseto, Italy, a town closely associated with the life of the opera composer, Giuseppe Verdi.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}, {"text": "Provesi is best known as being an early tutor of Giuseppe Verdi when he was the \"Maestro di cappella\" (master of music) at the St. Bartolomeo cathedral in Busseto (the town very close to Le Roncole, the village where Verdi was born.)", "chunk_id": "6f1f0a0b8ceacebf", "doc_id": "hp_504f3a1745c4e938"}]</data>
  <data key="d3">["hp_22c8c1dec547c159", "hp_504f3a1745c4e938"]</data>
  <data key="d4">False</data>
</node>
<node id="rocca">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A term for a fortress, specifically referring to the Rocca dei Marchesi Pallavicino.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}]</data>
  <data key="d2">[{"text": "From the 13th century, the “rocca” or “fortress” was the family’s palace; it is now the city hall after being acquired by the municipality in 1856.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}]</data>
  <data key="d3">["hp_22c8c1dec547c159"]</data>
  <data key="d4">False</data>
</node>
<node id="fortress">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A defensive structure, referring to the Rocca dei Marchesi Pallavicino.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}]</data>
  <data key="d2">[{"text": "From the 13th century, the “rocca” or “fortress” was the family’s palace; it is now the city hall after being acquired by the municipality in 1856.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}]</data>
  <data key="d3">["hp_22c8c1dec547c159"]</data>
  <data key="d4">False</data>
</node>
<node id="municipality">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The governing body of Busseto that acquired the Rocca dei Marchesi Pallavicino.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}]</data>
  <data key="d2">[{"text": "From the 13th century, the “rocca” or “fortress” was the family’s palace; it is now the city hall after being acquired by the municipality in 1856.", "chunk_id": "63570f207001f1f0", "doc_id": "hp_22c8c1dec547c159"}]</data>
  <data key="d3">["hp_22c8c1dec547c159"]</data>
  <data key="d4">False</data>
</node>
<node id="Insects">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An upcoming film directed by Jan Švankmajer.", "chunk_id": "f3d66ce3888765ed", "doc_id": "hp_22e5ba95304c8c50"}]</data>
  <data key="d2">[{"text": "Insects (Czech: \"Hmyz\" ) is an upcoming film directed by Jan Švankmajer, the film is based on the play \"Pictures from the Insects' Life\" by Karel and Josef Čapek.", "chunk_id": "f3d66ce3888765ed", "doc_id": "hp_22e5ba95304c8c50"}]</data>
  <data key="d3">["hp_22e5ba95304c8c50"]</data>
  <data key="d4">False</data>
</node>
<node id="Jan Švankmajer">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The director of the upcoming film 'Insects'.", "chunk_id": "f3d66ce3888765ed", "doc_id": "hp_22e5ba95304c8c50"}, {"text": "Jan Švankmajer is the director of the film 'The Death of Stalinism in Bohemia'.", "chunk_id": "7947a367f556d5b8", "doc_id": "hp_6b88bc8862070da2"}, {"text": "An influential short film maker who inspired 'The Cabinet of Jan Svankmajer'.", "chunk_id": "a444120708251a3f", "doc_id": "hp_84e3d8dcd0f0d6d5"}, {"text": "A Czech animator.", "chunk_id": "39592b16dc8ece21", "doc_id": "hp_873b85c0ff464a88"}, {"text": "Jan Švankmajer is the director and animator of the short film Meat Love.", "chunk_id": "78d702eb64aa0c99", "doc_id": "hp_89ef8e61a35751f3"}, {"text": "A Czech animator who created the film 'A Game with Stones'.", "chunk_id": "1cbc56f52e93151e", "doc_id": "hp_8bcb421ee48fbf62"}, {"text": "The director of the 1964 animated short film 'The Last Trick'.", "chunk_id": "134ef8db403da064", "doc_id": "hp_bf43ba8a29c65d6d"}, {"text": "A Czech filmmaker and artist known for his surrealist animations and features.", "chunk_id": "199af7f0c12c9d9f", "doc_id": "hp_c3249c342e938cd5"}, {"text": "The director of the 2005 Czech film Lunacy.", "chunk_id": "c947b5f039c20a78", "doc_id": "hp_dfa620b8112ac9e5"}]</data>
  <data key="d2">[{"text": "Insects (Czech: \"Hmyz\" ) is an upcoming film directed by Jan Švankmajer, the film is based on the play \"Pictures from the Insects' Life\" by Karel and Josef Čapek.", "chunk_id": "f3d66ce3888765ed", "doc_id": "hp_22e5ba95304c8c50"}, {"text": "The style of the film is surrealist, and the director Jan Švankmajer has been described by \"The New York Times\" as being \"One of cinema's most visionary surrealists\".", "chunk_id": "7947a367f556d5b8", "doc_id": "hp_6b88bc8862070da2"}, {"text": "The Cabinet of Jan Svankmajer is a 1984 surreal short stop-motion film by the Quay Brothers, an homage to the influential short film maker Jan Švankmajer.", "chunk_id": "a444120708251a3f", "doc_id": "hp_84e3d8dcd0f0d6d5"}, {"text": "Czech animators include Jiří Trnka, Karel Zeman, Břetislav Pojar, Jan Švankmajer or Jiří Barta.", "chunk_id": "39592b16dc8ece21", "doc_id": "hp_873b85c0ff464a88"}, {"text": "Meat Love is a 1989 Czechoslovak animated short film directed and animated by Jan Švankmajer.", "chunk_id": "78d702eb64aa0c99", "doc_id": "hp_89ef8e61a35751f3"}, {"text": "A Game With Stones (Czech: \"Hra s kameny\"), (German: \"Spiel mit Steinen\") is a nine-minute animated film by Czech animator Jan Švankmajer.", "chunk_id": "1cbc56f52e93151e", "doc_id": "hp_8bcb421ee48fbf62"}, {"text": "The Last Trick (Czech: Poslední trik pana Schwarcewalldea a pana Edgara ) is a 1964 Czechoslovak animated short film by Jan Švankmajer.", "chunk_id": "134ef8db403da064", "doc_id": "hp_bf43ba8a29c65d6d"}, {"text": "Jan Švankmajer (] ; born 4 September 1934) is a Czech filmmaker and artist whose work spans several media.", "chunk_id": "199af7f0c12c9d9f", "doc_id": "hp_c3249c342e938cd5"}, {"text": "Lunacy (Czech: Šílení ) is a 2005 Czech film by Jan Švankmajer.", "chunk_id": "c947b5f039c20a78", "doc_id": "hp_dfa620b8112ac9e5"}]</data>
  <data key="d3">["hp_22e5ba95304c8c50", "hp_6b88bc8862070da2", "hp_84e3d8dcd0f0d6d5", "hp_873b85c0ff464a88", "hp_89ef8e61a35751f3", "hp_8bcb421ee48fbf62", "hp_bf43ba8a29c65d6d", "hp_c3249c342e938cd5", "hp_dfa620b8112ac9e5"]</data>
  <data key="d4">False</data>
</node>
