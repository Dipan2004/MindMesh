<edge source="Layne Staley" target="Alice in Chains">
  <data key="d5">["FORMER_MEMBER_OF", "FORMER_MEMBER_OF"]</data>
  <data key="d6">Layne Staley was the singer for Alice in Chains.</data>
  <data key="d7">[{"text": "It is their first record without singer Layne Staley, who died in 2002.", "chunk_id": "a02521ae2928a8dd", "doc_id": "hp_7e9f73906e63aaa8", "type": "FORMER_MEMBER_OF"}, {"text": "William Bradley DuVall (born September 6, 1967) is an American musician, best known as being the current co-vocalist and a rhythm guitarist for the alternative metal band Alice in Chains replacing original vocalist Layne Staley, who died in 2002.", "chunk_id": "d4b180f1810dfb51", "doc_id": "hp_98b62ec679c7b310", "type": "FORMER_MEMBER_OF"}]</data>
  <data key="d8">hp_7e9f73906e63aaa8</data>
</edge>
<edge source="William DuVall" target="Alice in Chains">
  <data key="d5">["MEMBER_OF", "REPLACED", "MEMBER_OF", "REPLACED"]</data>
  <data key="d6">William DuVall is the new vocalist and rhythm guitarist for Alice in Chains.</data>
  <data key="d7">[{"text": "It instead features new vocalist and rhythm guitarist William DuVall.", "chunk_id": "a02521ae2928a8dd", "doc_id": "hp_7e9f73906e63aaa8", "type": "MEMBER_OF"}, {"text": "William Bradley DuVall (born September 6, 1967) is an American musician, best known as being the current co-vocalist and a rhythm guitarist for the alternative metal band Alice in Chains replacing original vocalist Layne Staley, who died in 2002.", "chunk_id": "d4b180f1810dfb51", "doc_id": "hp_98b62ec679c7b310", "type": "REPLACED"}, {"text": "DuVall joined Alice in Chains in 2006, and he appears on the 2009 album \"Black Gives Way to Blue\" as well as the 2013 follow-up \"The Devil Put Dinosaurs Here\".", "chunk_id": "d4b180f1810dfb51", "doc_id": "hp_98b62ec679c7b310", "type": "MEMBER_OF"}, {"text": "The song was the band's first release with vocalist William DuVall, who replaced the band's original vocalist, Layne Staley.", "chunk_id": "e152947c3cf74e57", "doc_id": "hp_c79be23e68ef1865", "type": "REPLACED"}]</data>
  <data key="d8">hp_7e9f73906e63aaa8</data>
</edge>
