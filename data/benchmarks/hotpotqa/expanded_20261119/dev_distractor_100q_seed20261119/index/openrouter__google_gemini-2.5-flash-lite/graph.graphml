  <data key="d2">[{"text": "Lars Hedlund from Sweden finished second after finishing second the previous year, and Geoff Capes from the United Kingdom finished third.", "chunk_id": "22af8bb1815b8995", "doc_id": "hp_b1381d79c5b4d390"}]</data>
