  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A book written by Richard Bunger Evans about John Cage.", "chunk_id": "f317bf6030b1131e", "doc_id": "hp_a09bf8eaffccdd21"}]</data>
  <data key="d2">[{"text": "Richard Bunger Evans, also known as Richard Bunger, (born 1942) is an American composer and pianist who worked with John Cage and subsequently wrote \"the classic book on John Cage,\" \"The Well-Prepared Piano\".", "chunk_id": "f317bf6030b1131e", "doc_id": "hp_a09bf8eaffccdd21"}]</data>
  <data key="d3">["hp_a09bf8eaffccdd21"]</data>
