  <data key="d2">[{"text": "The film is also known by the alternative title The Life of Giuseppe Verdi.", "chunk_id": "177ec9b189005c78", "doc_id": "hp_1b1a3259f3592689"}]</data>
  <data key="d3">["hp_1b1a3259f3592689"]</data>
  <data key="d4">False</data>
</node>
<node id="Augustine of Canterbury">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A Catholic Benedictine monk who became the first Archbishop of Canterbury.", "chunk_id": "2c3049d8d75419f1", "doc_id": "hp_1be1d29e3663e988"}]</data>
  <data key="d2">[{"text": "Augustine of Canterbury (born first third of the 6th century – died probably 26 May 604) was a Catholic Benedictine monk who became the first Archbishop of Canterbury in the year 597.", "chunk_id": "2c3049d8d75419f1", "doc_id": "hp_1be1d29e3663e988"}]</data>
  <data key="d3">["hp_1be1d29e3663e988"]</data>
  <data key="d4">False</data>
</node>
