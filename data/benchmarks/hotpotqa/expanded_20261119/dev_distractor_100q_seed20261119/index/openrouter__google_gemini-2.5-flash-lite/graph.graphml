  <data key="d2">[{"text": "He has also had a solo music career and appeared in the reality television series \"Celebrity Rehab\" 1 and 2 and \"Sober House\" 1 and 2.", "chunk_id": "1e82acbea30954cf", "doc_id": "hp_c1c0a020ac369351"}]</data>
