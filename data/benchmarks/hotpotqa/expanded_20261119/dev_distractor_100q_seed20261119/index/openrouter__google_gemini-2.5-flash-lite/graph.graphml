<node id="Director of Immigration v Chong Fung Yuen">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A 2001 case in Hong Kong's Court of Final Appeal.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d2">[{"text": "Director of Immigration v Chong Fung Yuen was a 2001 case in Hong Kong's Court of Final Appeal.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d3">["hp_3bad22e58989e25f"]</data>
  <data key="d4">False</data>
</node>
<node id="Andrew Li">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The Chief Justice who delivered the unanimous opinion in the case.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d2">[{"text": "Chief Justice Andrew Li, in the Court's unanimous opinion, affirmed lower court decisions that Chinese citizens born in Hong Kong enjoyed the right of abode regardless of the Hong Kong immigration status of their parents.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d3">["hp_3bad22e58989e25f"]</data>
  <data key="d4">False</data>
</node>
<node id="Chinese citizens">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A group of people who were granted the right of abode in Hong Kong.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d2">[{"text": "Chief Justice Andrew Li, in the Court's unanimous opinion, affirmed lower court decisions that Chinese citizens born in Hong Kong enjoyed the right of abode regardless of the Hong Kong immigration status of their parents.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d3">["hp_3bad22e58989e25f"]</data>
  <data key="d4">False</data>
</node>
<node id="right of abode">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The legal right to live in a place.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d2">[{"text": "Chief Justice Andrew Li, in the Court's unanimous opinion, affirmed lower court decisions that Chinese citizens born in Hong Kong enjoyed the right of abode regardless of the Hong Kong immigration status of their parents.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d3">["hp_3bad22e58989e25f"]</data>
  <data key="d4">False</data>
</node>
<node id="Hong Kong Basic Law">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The constitutional document of Hong Kong.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d2">[{"text": "The case touched on issues of interpretation of the Hong Kong Basic Law, both common law interpretation by courts in Hong Kong as well as interpretation by the Standing Committee of the National People's Congress (NPCSC) of the People's Republic of China.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d3">["hp_3bad22e58989e25f"]</data>
  <data key="d4">False</data>
</node>
<node id="Standing Committee of the National People's Congress">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A body of the People's Republic of China that interprets the Hong Kong Basic Law.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d2">[{"text": "The case touched on issues of interpretation of the Hong Kong Basic Law, both common law interpretation by courts in Hong Kong as well as interpretation by the Standing Committee of the National People's Congress (NPCSC) of the People's Republic of China.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d3">["hp_3bad22e58989e25f"]</data>
  <data key="d4">False</data>
</node>
<node id="People's Republic of China">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A country whose legislative body's standing committee interprets the Hong Kong Basic Law.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}, {"text": "The People's Republic of China is a country in East Asia.", "chunk_id": "105244edf12919e4", "doc_id": "hp_4584bae78bfb29b3"}]</data>
  <data key="d2">[{"text": "The case touched on issues of interpretation of the Hong Kong Basic Law, both common law interpretation by courts in Hong Kong as well as interpretation by the Standing Committee of the National People's Congress (NPCSC) of the People's Republic of China.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}, {"text": "Ruili (; Burmese: ရွှေလီ ; Thai: เมืองมาว ) is a county-level city of Dehong Prefecture, in the west of Yunnan province, People's Republic of China.", "chunk_id": "105244edf12919e4", "doc_id": "hp_4584bae78bfb29b3"}]</data>
  <data key="d3">["hp_3bad22e58989e25f", "hp_4584bae78bfb29b3"]</data>
  <data key="d4">False</data>
</node>
<node id="Albert Chen">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A professor at the University of Hong Kong who commented on the case.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d2">[{"text": "Professor Albert Chen of the University of Hong Kong describes the case as part of a \"period of elaboration and consolidation of the regime of rights in the Hong Kong SAR\", lasting roughly from 2000 to 2002.", "chunk_id": "e783910d896b84d9", "doc_id": "hp_3bad22e58989e25f"}]</data>
  <data key="d3">["hp_3bad22e58989e25f"]</data>
  <data key="d4">False</data>
</node>
