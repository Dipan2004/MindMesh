<node id="June 28, 2012">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The opening date of Kunming Changshui International Airport.", "chunk_id": "9432ffb2818fa833", "doc_id": "hp_9c94d1d46a54f88d"}]</data>
  <data key="d2">[{"text": "The airport opened at 08:00 (UTC+8) on June 28, 2012, replacing the old Kunming Wujiaba International Airport, which will be demolished.", "chunk_id": "9432ffb2818fa833", "doc_id": "hp_9c94d1d46a54f88d"}]</data>
