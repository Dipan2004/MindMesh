<node id="Mihrimah Sultan Mosque">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Mihrimah Sultan Mosque is an Ottoman mosque located in the Edirnekapı neighborhood near the Byzantine land walls of Istanbul, Turkey.", "chunk_id": "2b745e897c8565f6", "doc_id": "hp_a52cead96a6e20c2"}]</data>
  <data key="d2">[{"text": "The Mihrimah Sultan Mosque (Turkish: 'Mihrimah Sultan Camii' ) is an Ottoman mosque located in the Edirnekapı neighborhood near the Byzantine land walls of Istanbul, Turkey.", "chunk_id": "2b745e897c8565f6", "doc_id": "hp_a52cead96a6e20c2"}]</data>
