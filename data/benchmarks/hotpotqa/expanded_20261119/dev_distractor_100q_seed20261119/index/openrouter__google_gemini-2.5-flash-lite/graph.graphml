<node id="RIANZ Singles Chart">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The official singles chart in New Zealand.", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb"}, {"text": "The RIANZ Singles Chart is a music chart in New Zealand.", "chunk_id": "d4c212cc890b725d", "doc_id": "hp_b314ee58b364424a"}]</data>
  <data key="d2">[{"text": "It peaked at No. 4 on their native RIANZ Singles Chart in New Zealand and No. 5 on their adopted country of Australia's ARIA Singles Chart.", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb"}, {"text": "The song was released in October 2006 and peaked at No. 15 on the RIANZ Singles Chart in New Zealand and number one on the ARIA Singles Chart, making it Evermore's most successful single in Australia.", "chunk_id": "d4c212cc890b725d", "doc_id": "hp_b314ee58b364424a"}]</data>
  <data key="d3">["hp_5a1e23a825efe5cb", "hp_b314ee58b364424a"]</data>
  <data key="d4">False</data>
</node>
<node id="ARIA Singles Chart">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The official singles chart in Australia.", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb"}, {"text": "The ARIA Singles Chart is a music chart in Australia.", "chunk_id": "d4c212cc890b725d", "doc_id": "hp_b314ee58b364424a"}]</data>
  <data key="d2">[{"text": "It peaked at No. 4 on their native RIANZ Singles Chart in New Zealand and No. 5 on their adopted country of Australia's ARIA Singles Chart.", "chunk_id": "bf8df350b104fc54", "doc_id": "hp_5a1e23a825efe5cb"}, {"text": "The song was released in October 2006 and peaked at No. 15 on the RIANZ Singles Chart in New Zealand and number one on the ARIA Singles Chart, making it Evermore's most successful single in Australia.", "chunk_id": "d4c212cc890b725d", "doc_id": "hp_b314ee58b364424a"}]</data>
  <data key="d3">["hp_5a1e23a825efe5cb", "hp_b314ee58b364424a"]</data>
  <data key="d4">False</data>
</node>
<node id="Oenanthe javanica">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Oenanthe javanica is a plant of the water dropwort genus originating from East Asia.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d2">[{"text": "Oenanthe javanica, commonly Java waterdropwort, Chinese celery, Indian pennywort, water celery and water dropwort, is a plant of the water dropwort genus originating from East Asia.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d3">["hp_5af6f615361404c2"]</data>
  <data key="d4">False</data>
</node>
<node id="Java waterdropwort">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Java waterdropwort is a common name for Oenanthe javanica.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d2">[{"text": "Oenanthe javanica, commonly Java waterdropwort, Chinese celery, Indian pennywort, water celery and water dropwort, is a plant of the water dropwort genus originating from East Asia.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d3">["hp_5af6f615361404c2"]</data>
  <data key="d4">False</data>
</node>
<node id="Chinese celery">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Chinese celery is a common name for Oenanthe javanica and also for Apium graveolens var. secalinum.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d2">[{"text": "Oenanthe javanica, commonly Java waterdropwort, Chinese celery, Indian pennywort, water celery and water dropwort, is a plant of the water dropwort genus originating from East Asia.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d3">["hp_5af6f615361404c2"]</data>
  <data key="d4">False</data>
</node>
<node id="Indian pennywort">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Indian pennywort is a common name for Oenanthe javanica.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d2">[{"text": "Oenanthe javanica, commonly Java waterdropwort, Chinese celery, Indian pennywort, water celery and water dropwort, is a plant of the water dropwort genus originating from East Asia.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d3">["hp_5af6f615361404c2"]</data>
  <data key="d4">False</data>
</node>
<node id="water celery">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Water celery is a common name for Oenanthe javanica.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d2">[{"text": "Oenanthe javanica, commonly Java waterdropwort, Chinese celery, Indian pennywort, water celery and water dropwort, is a plant of the water dropwort genus originating from East Asia.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d3">["hp_5af6f615361404c2"]</data>
  <data key="d4">False</data>
</node>
<node id="water dropwort">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Water dropwort is a common name for Oenanthe javanica and also refers to the genus Oenanthe.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d2">[{"text": "Oenanthe javanica, commonly Java waterdropwort, Chinese celery, Indian pennywort, water celery and water dropwort, is a plant of the water dropwort genus originating from East Asia.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d3">["hp_5af6f615361404c2"]</data>
  <data key="d4">False</data>
</node>
<node id="Apium graveolens var. secalinum">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Apium graveolens var. secalinum is a plant also known as Chinese celery.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d2">[{"text": "(Chinese celery is also the name given to \"Apium graveolens\" var. \"secalinum\").", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d3">["hp_5af6f615361404c2"]</data>
  <data key="d4">False</data>
</node>
<node id="East Asia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "East Asia is a region of origin for Oenanthe javanica.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}, {"text": "A geographical region where Sino-Tibetan languages are spoken.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}, {"text": "A region where Tetrapanax papyrifer is widely cultivated.", "chunk_id": "4bcf587974d76b12", "doc_id": "hp_f0145d341f76a4f3"}]</data>
  <data key="d2">[{"text": "Oenanthe javanica, commonly Java waterdropwort, Chinese celery, Indian pennywort, water celery and water dropwort, is a plant of the water dropwort genus originating from East Asia.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}, {"text": "The Sino-Tibetan languages, in a few sources also known as Tibeto-Burman or Trans-Himalayan, are a family of more than 400 languages spoken in East Asia, Southeast Asia and South Asia.", "chunk_id": "8d2f0f99801ebf15", "doc_id": "hp_b4175e524ae4a823"}, {"text": "It is endemic to Taiwan, but widely cultivated in East Asia and sometimes in other tropical regions as well.", "chunk_id": "4bcf587974d76b12", "doc_id": "hp_f0145d341f76a4f3"}]</data>
  <data key="d3">["hp_5af6f615361404c2", "hp_b4175e524ae4a823", "hp_f0145d341f76a4f3"]</data>
  <data key="d4">False</data>
</node>
<node id="temperate Asia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Temperate Asia is part of the widespread native distribution of Oenanthe javanica.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d2">[{"text": "It has a widespread native distribution in temperate Asia and tropical Asia, and is also native to Queensland, Australia.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d3">["hp_5af6f615361404c2"]</data>
  <data key="d4">False</data>
</node>
<node id="tropical Asia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Tropical Asia is part of the widespread native distribution of Oenanthe javanica.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d2">[{"text": "It has a widespread native distribution in temperate Asia and tropical Asia, and is also native to Queensland, Australia.", "chunk_id": "ec6a06d2240b9f28", "doc_id": "hp_5af6f615361404c2"}]</data>
  <data key="d3">["hp_5af6f615361404c2"]</data>
  <data key="d4">False</data>
</node>
<node id="Salvia divinorum">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Salvia divinorum is a psychoactive plant that can induce visions and other spiritual experiences.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d2">[{"text": "Salvia divinorum (also known as sage of the diviners, ska maría pastora, seer's sage, yerba de la pastora and just salvia) is a psychoactive plant which can induce visions and other spiritual experiences.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d3">["hp_5b549ddaeafe9045"]</data>
  <data key="d4">False</data>
</node>
