  <data key="d1">[{"text": "Visions are spiritual experiences that can be induced by Salvia divinorum.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d2">[{"text": "Salvia divinorum (also known as sage of the diviners, ska maría pastora, seer's sage, yerba de la pastora and just salvia) is a psychoactive plant which can induce visions and other spiritual experiences.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d3">["hp_5b549ddaeafe9045"]</data>
  <data key="d4">False</data>
</node>
<node id="spiritual experiences">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Spiritual experiences can be induced by Salvia divinorum.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d2">[{"text": "Salvia divinorum (also known as sage of the diviners, ska maría pastora, seer's sage, yerba de la pastora and just salvia) is a psychoactive plant which can induce visions and other spiritual experiences.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d3">["hp_5b549ddaeafe9045"]</data>
  <data key="d4">False</data>
</node>
<node id="cloud forest">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Cloud forest is the native habitat of Salvia divinorum.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d2">[{"text": "Its native habitat is in cloud forest in the isolated Sierra Mazateca of Oaxaca, Mexico, where it grows in shady and moist locations.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d3">["hp_5b549ddaeafe9045"]</data>
  <data key="d4">False</data>
</node>
<node id="Sierra Mazateca">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Sierra Mazateca is an isolated mountain range in Oaxaca, Mexico, which is the native habitat of Salvia divinorum.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d2">[{"text": "Its native habitat is in cloud forest in the isolated Sierra Mazateca of Oaxaca, Mexico, where it grows in shady and moist locations.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d3">["hp_5b549ddaeafe9045"]</data>
  <data key="d4">False</data>
</node>
<node id="Oaxaca">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Oaxaca is a state in Mexico where the Sierra Mazateca is located and is the native habitat of Salvia divinorum.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d2">[{"text": "Its native habitat is in cloud forest in the isolated Sierra Mazateca of Oaxaca, Mexico, where it grows in shady and moist locations.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d3">["hp_5b549ddaeafe9045"]</data>
  <data key="d4">False</data>
</node>
<node id="hollow square stems">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Hollow square stems are a physical characteristic of the Salvia divinorum plant.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d2">[{"text": "The plant grows to over a meter high, has hollow square stems, large leaves, and occasional white flowers with violet calyxes.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d3">["hp_5b549ddaeafe9045"]</data>
  <data key="d4">False</data>
</node>
<node id="large leaves">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Large leaves are a physical characteristic of the Salvia divinorum plant.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d2">[{"text": "The plant grows to over a meter high, has hollow square stems, large leaves, and occasional white flowers with violet calyxes.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d3">["hp_5b549ddaeafe9045"]</data>
  <data key="d4">False</data>
</node>
<node id="white flowers">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "White flowers are a physical characteristic of the Salvia divinorum plant.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}, {"text": "Masses of white flowers are produced by Agastachys odorata in erect spikes.", "chunk_id": "19175e33feb82407", "doc_id": "hp_753b5832724c81c3"}]</data>
  <data key="d2">[{"text": "The plant grows to over a meter high, has hollow square stems, large leaves, and occasional white flowers with violet calyxes.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}, {"text": "Masses of white flowers are produced in erect spikes from the ends of the branches.", "chunk_id": "19175e33feb82407", "doc_id": "hp_753b5832724c81c3"}]</data>
  <data key="d3">["hp_5b549ddaeafe9045", "hp_753b5832724c81c3"]</data>
  <data key="d4">False</data>
</node>
<node id="violet calyxes">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Violet calyxes are a physical characteristic of the Salvia divinorum plant.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d2">[{"text": "The plant grows to over a meter high, has hollow square stems, large leaves, and occasional white flowers with violet calyxes.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d3">["hp_5b549ddaeafe9045"]</data>
  <data key="d4">False</data>
</node>
<node id="cultigen">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A cultigen is a plant that has been significantly modified by humans.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d2">[{"text": "Botanists have not determined whether \"Salvia divinorum\" is a cultigen or a hybrid; native plants reproduce vegetatively, rarely producing viable seed.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d3">["hp_5b549ddaeafe9045"]</data>
  <data key="d4">False</data>
</node>
<node id="hybrid">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A hybrid is the offspring of two plants or animals of different species or varieties.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d2">[{"text": "Botanists have not determined whether \"Salvia divinorum\" is a cultigen or a hybrid; native plants reproduce vegetatively, rarely producing viable seed.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d3">["hp_5b549ddaeafe9045"]</data>
  <data key="d4">False</data>
</node>
<node id="viable seed">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Viable seed is seed that is capable of germinating and developing into a new plant.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d2">[{"text": "Botanists have not determined whether \"Salvia divinorum\" is a cultigen or a hybrid; native plants reproduce vegetatively, rarely producing viable seed.", "chunk_id": "b84d18605bb81aec", "doc_id": "hp_5b549ddaeafe9045"}]</data>
  <data key="d3">["hp_5b549ddaeafe9045"]</data>
  <data key="d4">False</data>
</node>
<node id="May Company California">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A chain of department stores that operated in Southern California and Nevada.", "chunk_id": "a4a90e9e8bea2ac1", "doc_id": "hp_5c13848c5f73cf0b"}]</data>
  <data key="d2">[{"text": "May Company California was a chain of department stores operating in Southern California and Nevada, with headquarters in North Hollywood, California.", "chunk_id": "a4a90e9e8bea2ac1", "doc_id": "hp_5c13848c5f73cf0b"}]</data>
  <data key="d3">["hp_5c13848c5f73cf0b"]</data>
  <data key="d4">False</data>
</node>
<node id="Southern California">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A region where May Company California operated department stores.", "chunk_id": "a4a90e9e8bea2ac1", "doc_id": "hp_5c13848c5f73cf0b"}, {"text": "Southern California is a region where Robinsons-May operated.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d2">[{"text": "May Company California was a chain of department stores operating in Southern California and Nevada, with headquarters in North Hollywood, California.", "chunk_id": "a4a90e9e8bea2ac1", "doc_id": "hp_5c13848c5f73cf0b"}, {"text": "Robinsons-May was a chain of department stores operating in Southern California, Arizona and Las Vegas, Nevada, previously with headquarters in North Hollywood, California.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d3">["hp_5c13848c5f73cf0b", "hp_70e1b920ca70d1e9"]</data>
  <data key="d4">False</data>
</node>
<node id="North Hollywood">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The location of the headquarters for May Company California.", "chunk_id": "a4a90e9e8bea2ac1", "doc_id": "hp_5c13848c5f73cf0b"}, {"text": "North Hollywood, California was the previous headquarters of Robinsons-May.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d2">[{"text": "May Company California was a chain of department stores operating in Southern California and Nevada, with headquarters in North Hollywood, California.", "chunk_id": "a4a90e9e8bea2ac1", "doc_id": "hp_5c13848c5f73cf0b"}, {"text": "Robinsons-May was a chain of department stores operating in Southern California, Arizona and Las Vegas, Nevada, previously with headquarters in North Hollywood, California.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d3">["hp_5c13848c5f73cf0b", "hp_70e1b920ca70d1e9"]</data>
  <data key="d4">False</data>
</node>
<node id="May Department Stores">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The parent company of May Company California.", "chunk_id": "a4a90e9e8bea2ac1", "doc_id": "hp_5c13848c5f73cf0b"}]</data>
  <data key="d2">[{"text": "It was a subsidiary of May Department Stores and merged with May's other Southern California subsidiary, J. W. Robinson's, in 1993 to form Robinsons-May.", "chunk_id": "a4a90e9e8bea2ac1", "doc_id": "hp_5c13848c5f73cf0b"}]</data>
  <data key="d3">["hp_5c13848c5f73cf0b"]</data>
  <data key="d4">False</data>
</node>
<node id="J. W. Robinson's">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Another Southern California subsidiary of May Department Stores.", "chunk_id": "a4a90e9e8bea2ac1", "doc_id": "hp_5c13848c5f73cf0b"}]</data>
  <data key="d2">[{"text": "It was a subsidiary of May Department Stores and merged with May's other Southern California subsidiary, J. W. Robinson's, in 1993 to form Robinsons-May.", "chunk_id": "a4a90e9e8bea2ac1", "doc_id": "hp_5c13848c5f73cf0b"}]</data>
  <data key="d3">["hp_5c13848c5f73cf0b"]</data>
  <data key="d4">False</data>
</node>
<node id="Robinsons-May">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A department store chain formed by the merger of May Company California and J. W. Robinson's.", "chunk_id": "a4a90e9e8bea2ac1", "doc_id": "hp_5c13848c5f73cf0b"}, {"text": "Robinsons-May was a chain of department stores.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d2">[{"text": "It was a subsidiary of May Department Stores and merged with May's other Southern California subsidiary, J. W. Robinson's, in 1993 to form Robinsons-May.", "chunk_id": "a4a90e9e8bea2ac1", "doc_id": "hp_5c13848c5f73cf0b"}, {"text": "Robinsons-May was a chain of department stores operating in Southern California, Arizona and Las Vegas, Nevada, previously with headquarters in North Hollywood, California.", "chunk_id": "6599befc2a7488c2", "doc_id": "hp_70e1b920ca70d1e9"}]</data>
  <data key="d3">["hp_5c13848c5f73cf0b", "hp_70e1b920ca70d1e9"]</data>
  <data key="d4">False</data>
</node>
<node id="V404 Cygni">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "V404 Cygni is a microquasar and a binary system.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}]</data>
  <data key="d2">[{"text": "V404 Cygni is a microquasar and a binary system consisting of a black hole with a mass of about and an early K companion star of mass slightly smaller than the Sun in the constellation of Cygnus.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}]</data>
  <data key="d3">["hp_5c775ec40e7241ed"]</data>
  <data key="d4">False</data>
</node>
<node id="microquasar">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A microquasar is a celestial object that resembles a quasar but is much smaller.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}]</data>
  <data key="d2">[{"text": "V404 Cygni is a microquasar and a binary system consisting of a black hole with a mass of about and an early K companion star of mass slightly smaller than the Sun in the constellation of Cygnus.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}]</data>
  <data key="d3">["hp_5c775ec40e7241ed"]</data>
  <data key="d4">False</data>
</node>
<node id="binary system">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A binary system is a system of two objects that orbit a common center of mass.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}]</data>
  <data key="d2">[{"text": "V404 Cygni is a microquasar and a binary system consisting of a black hole with a mass of about and an early K companion star of mass slightly smaller than the Sun in the constellation of Cygnus.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}]</data>
  <data key="d3">["hp_5c775ec40e7241ed"]</data>
  <data key="d4">False</data>
</node>
<node id="black hole">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A black hole is a region of spacetime where gravity is so strong that nothing, not even light, can escape.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}, {"text": "A region of spacetime where gravity is so strong that nothing, not even light, can escape.", "chunk_id": "34ff5929268b9929", "doc_id": "hp_6f7e07fa996d26c4"}, {"text": "A black hole is a region of spacetime where gravity is so strong that nothing, not even light, can escape.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}, {"text": "A region of spacetime where gravity is so strong that nothing, not even light, can escape.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3"}, {"text": "A region of spacetime where gravity is so strong that nothing, not even light, can escape.", "chunk_id": "e1493fe4a7e31d6c", "doc_id": "hp_e09ae53df97c48d0"}]</data>
  <data key="d2">[{"text": "V404 Cygni is a microquasar and a binary system consisting of a black hole with a mass of about and an early K companion star of mass slightly smaller than the Sun in the constellation of Cygnus.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}, {"text": "In general relativity, the de Sitter–Schwarzschild solution describes a black hole in a causal patch of de Sitter space.", "chunk_id": "34ff5929268b9929", "doc_id": "hp_6f7e07fa996d26c4"}, {"text": "In the case of a black hole in orbit around another black hole this is an extreme mass ratio binary black hole.", "chunk_id": "85874c3e24dbd553", "doc_id": "hp_9ef7f82d0f1702ec"}, {"text": "In black hole theory, the black hole membrane paradigm is a simplified model, useful for visualising and calculating the effects predicted by quantum mechanics for the exterior physics of black holes, without using quantum-mechanical principles or calculations.", "chunk_id": "fa3f5736c05b811f", "doc_id": "hp_b71363459a2e11a3"}, {"text": "The ergosphere is a region located outside a rotating black hole's outer event horizon.", "chunk_id": "e1493fe4a7e31d6c", "doc_id": "hp_e09ae53df97c48d0"}]</data>
  <data key="d3">["hp_5c775ec40e7241ed", "hp_6f7e07fa996d26c4", "hp_9ef7f82d0f1702ec", "hp_b71363459a2e11a3", "hp_e09ae53df97c48d0"]</data>
  <data key="d4">False</data>
</node>
<node id="early K companion star">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An early K companion star is a star of spectral type K that is smaller than the Sun.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}]</data>
  <data key="d2">[{"text": "V404 Cygni is a microquasar and a binary system consisting of a black hole with a mass of about and an early K companion star of mass slightly smaller than the Sun in the constellation of Cygnus.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}]</data>
  <data key="d3">["hp_5c775ec40e7241ed"]</data>
  <data key="d4">False</data>
</node>
<node id="Sun">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The Sun is the star at the center of the Solar System.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}, {"text": "The star at the center of our Solar System, used as a unit of mass for celestial objects.", "chunk_id": "b630ca764564e39f", "doc_id": "hp_6ffa173614708165"}]</data>
  <data key="d2">[{"text": "V404 Cygni is a microquasar and a binary system consisting of a black hole with a mass of about and an early K companion star of mass slightly smaller than the Sun in the constellation of Cygnus.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}, {"text": "M33 X-7 is the largest known stellar black hole with an estimated mass of 15.65 times that of the Sun (M ).", "chunk_id": "b630ca764564e39f", "doc_id": "hp_6ffa173614708165"}]</data>
  <data key="d3">["hp_5c775ec40e7241ed", "hp_6ffa173614708165"]</data>
  <data key="d4">False</data>
</node>
<node id="Cygnus">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Cygnus is a constellation in the northern sky.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}]</data>
  <data key="d2">[{"text": "V404 Cygni is a microquasar and a binary system consisting of a black hole with a mass of about and an early K companion star of mass slightly smaller than the Sun in the constellation of Cygnus.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}]</data>
  <data key="d3">["hp_5c775ec40e7241ed"]</data>
  <data key="d4">False</data>
</node>
<node id="accretion disk">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "An accretion disk is a structure formed by matter falling into a massive object.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}]</data>
  <data key="d2">[{"text": "Due to their proximity and the intense gravity of the black hole, the companion star loses mass to an accretion disk around the black hole and ultimately to the black hole itself.", "chunk_id": "948a0917b69a52a4", "doc_id": "hp_5c775ec40e7241ed"}]</data>
  <data key="d3">["hp_5c775ec40e7241ed"]</data>
  <data key="d4">False</data>
</node>
<node id="2014 World's Strongest Man">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 37th edition of the World's Strongest Man competition.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}, {"text": "The 2014 World's Strongest Man is a competition that Robert Oberst competed in.", "chunk_id": "fd867132c1c55e97", "doc_id": "hp_ab10a66f84257538"}]</data>
  <data key="d2">[{"text": "The 2014 World's Strongest Man was the 37th edition of World's Strongest Man.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}, {"text": "He is a yearly competitor of the World's Strongest Man including the 2013 World's Strongest Man, 2014 World's Strongest Man, 2015 World's Strongest Man and the 2016 World's Strongest Man competitions.", "chunk_id": "fd867132c1c55e97", "doc_id": "hp_ab10a66f84257538"}]</data>
  <data key="d3">["hp_5d64f24bd8d85ba4", "hp_ab10a66f84257538"]</data>
  <data key="d4">False</data>
</node>
<node id="2012 World's Strongest Man">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A previous edition of the World's Strongest Man contest held in Los Angeles.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d2">[{"text": "The event was held at the Commerce Casino in Los Angeles, California, the same host city as the 2012 World's Strongest Man contest.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d3">["hp_5d64f24bd8d85ba4"]</data>
  <data key="d4">False</data>
</node>
<node id="WSM">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "An abbreviation for World's Strongest Man.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d2">[{"text": "Zydrunas Savickas from Lithuania finished in first place, this was his fourth WSM title.", "chunk_id": "db784b086e9df3ea", "doc_id": "hp_5d64f24bd8d85ba4"}]</data>
  <data key="d3">["hp_5d64f24bd8d85ba4"]</data>
  <data key="d4">False</data>
</node>
<node id="Dulce River">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A river located in Argentina.", "chunk_id": "eee0658a37ea7481", "doc_id": "hp_5d6ed7a42a524dc4"}]</data>
  <data key="d2">[{"text": "It lies on the Dulce River and on National Route 9, at a distance of 1,042 km north-northwest from Buenos Aires.", "chunk_id": "eee0658a37ea7481", "doc_id": "hp_5d6ed7a42a524dc4"}]</data>
  <data key="d3">["hp_5d6ed7a42a524dc4"]</data>
  <data key="d4">False</data>
</node>
<node id="Buenos Aires">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The capital and largest city of Argentina.", "chunk_id": "eee0658a37ea7481", "doc_id": "hp_5d6ed7a42a524dc4"}]</data>
  <data key="d2">[{"text": "It lies on the Dulce River and on National Route 9, at a distance of 1,042 km north-northwest from Buenos Aires.", "chunk_id": "eee0658a37ea7481", "doc_id": "hp_5d6ed7a42a524dc4"}]</data>
  <data key="d3">["hp_5d6ed7a42a524dc4"]</data>
  <data key="d4">False</data>
</node>
<node id="Spanish settlers">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "People from Spain who established settlements in new territories.", "chunk_id": "eee0658a37ea7481", "doc_id": "hp_5d6ed7a42a524dc4"}]</data>
  <data key="d2">[{"text": "Santiago del Estero was the first city founded by Spanish settlers in the territory that is now Argentina.", "chunk_id": "eee0658a37ea7481", "doc_id": "hp_5d6ed7a42a524dc4"}]</data>
  <data key="d3">["hp_5d6ed7a42a524dc4"]</data>
  <data key="d4">False</data>
</node>
<node id="Madre de Ciudades">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A nickname for Santiago del Estero, meaning 'Mother of Cities'.", "chunk_id": "eee0658a37ea7481", "doc_id": "hp_5d6ed7a42a524dc4"}]</data>
  <data key="d2">[{"text": "As such, it is nicknamed \"Madre de Ciudades\" (Mother of Cities).", "chunk_id": "eee0658a37ea7481", "doc_id": "hp_5d6ed7a42a524dc4"}]</data>
  <data key="d3">["hp_5d6ed7a42a524dc4"]</data>
  <data key="d4">False</data>
</node>
<node id="mother of cities and cradle of folklore">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An official declaration for Santiago del Estero, signifying its historical importance and cultural heritage.", "chunk_id": "eee0658a37ea7481", "doc_id": "hp_5d6ed7a42a524dc4"}]</data>
  <data key="d2">[{"text": "Similarly, it has been officially declared the \"mother of cities and cradle of folklore.\"", "chunk_id": "eee0658a37ea7481", "doc_id": "hp_5d6ed7a42a524dc4"}]</data>
  <data key="d3">["hp_5d6ed7a42a524dc4"]</data>
  <data key="d4">False</data>
</node>
<node id="Dom-Hotel">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The Dom-Hotel is a five-star hotel in Cologne, Germany.", "chunk_id": "cf3ed09c1d2f8654", "doc_id": "hp_5d7964cd7edd106e"}]</data>
  <data key="d2">[{"text": "The Dom-Hotel is a five-star hotel in Cologne, Germany, located on Roncalliplatz in Innenstadt.", "chunk_id": "cf3ed09c1d2f8654", "doc_id": "hp_5d7964cd7edd106e"}]</data>
  <data key="d3">["hp_5d7964cd7edd106e"]</data>
  <data key="d4">False</data>
</node>
<node id="Cologne">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Cologne is a city in Germany where the Dom-Hotel is located.", "chunk_id": "cf3ed09c1d2f8654", "doc_id": "hp_5d7964cd7edd106e"}]</data>
  <data key="d2">[{"text": "The Dom-Hotel is a five-star hotel in Cologne, Germany, located on Roncalliplatz in Innenstadt.", "chunk_id": "cf3ed09c1d2f8654", "doc_id": "hp_5d7964cd7edd106e"}]</data>
  <data key="d3">["hp_5d7964cd7edd106e"]</data>
  <data key="d4">False</data>
</node>
<node id="Roncalliplatz">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Roncalliplatz is a location in Innenstadt where the Dom-Hotel is situated.", "chunk_id": "cf3ed09c1d2f8654", "doc_id": "hp_5d7964cd7edd106e"}]</data>
  <data key="d2">[{"text": "The Dom-Hotel is a five-star hotel in Cologne, Germany, located on Roncalliplatz in Innenstadt.", "chunk_id": "cf3ed09c1d2f8654", "doc_id": "hp_5d7964cd7edd106e"}]</data>
  <data key="d3">["hp_5d7964cd7edd106e"]</data>
  <data key="d4">False</data>
</node>
<node id="Innenstadt">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Innenstadt is a district in Cologne where Roncalliplatz is located.", "chunk_id": "cf3ed09c1d2f8654", "doc_id": "hp_5d7964cd7edd106e"}]</data>
  <data key="d2">[{"text": "The Dom-Hotel is a five-star hotel in Cologne, Germany, located on Roncalliplatz in Innenstadt.", "chunk_id": "cf3ed09c1d2f8654", "doc_id": "hp_5d7964cd7edd106e"}]</data>
  <data key="d3">["hp_5d7964cd7edd106e"]</data>
  <data key="d4">False</data>
</node>
<node id="Cologne Cathedral">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Cologne Cathedral, also known as the \"Dom\", is a direct neighbour to the Dom-Hotel.", "chunk_id": "cf3ed09c1d2f8654", "doc_id": "hp_5d7964cd7edd106e"}]</data>
  <data key="d2">[{"text": "The hotel is named after Cologne Cathedral (the \"Dom\"), which is its direct neighbour.", "chunk_id": "cf3ed09c1d2f8654", "doc_id": "hp_5d7964cd7edd106e"}]</data>
  <data key="d3">["hp_5d7964cd7edd106e"]</data>
  <data key="d4">False</data>
</node>
<node id="Happy Love Sick">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The debut solo album by Shifty Shellshock.", "chunk_id": "fb6d4773c5a537c1", "doc_id": "hp_5dba59e0680b3340"}, {"text": "The debut album of Shifty Shellshock, from which \"Slide Along Side\" was released as the lead single.", "chunk_id": "f4e1b3dad9a27f75", "doc_id": "hp_89d981307f6f6b55"}, {"text": "Happy Love Sick is an album by Shifty Shellshock.", "chunk_id": "0e3a5e1368eb79fe", "doc_id": "hp_c1e92b892fa0c36f"}]</data>
  <data key="d2">[{"text": "Happy Love Sick is the debut solo album by Shifty Shellshock who is best known as frontman of rap rock band Crazy Town.", "chunk_id": "fb6d4773c5a537c1", "doc_id": "hp_5dba59e0680b3340"}, {"text": "It was released in June 2004 as the lead single from his debut album \"Happy Love Sick\".", "chunk_id": "f4e1b3dad9a27f75", "doc_id": "hp_89d981307f6f6b55"}, {"text": "It was later included on Shifty Shellshock's 2004 album \"Happy Love Sick\", and Oakenfold's 2007 album \"Greatest Hits &amp; Remixes, Vol. 1\".", "chunk_id": "0e3a5e1368eb79fe", "doc_id": "hp_c1e92b892fa0c36f"}]</data>
  <data key="d3">["hp_5dba59e0680b3340", "hp_89d981307f6f6b55", "hp_c1e92b892fa0c36f"]</data>
  <data key="d4">False</data>
</node>
<node id="Shifty Shellshock">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Frontman of the rap rock band Crazy Town.", "chunk_id": "fb6d4773c5a537c1", "doc_id": "hp_5dba59e0680b3340"}, {"text": "The artist who recorded the song \"Slide Along Side\".", "chunk_id": "f4e1b3dad9a27f75", "doc_id": "hp_89d981307f6f6b55"}, {"text": "The stage name of Seth Brooks Binzer, an American music artist.", "chunk_id": "1e82acbea30954cf", "doc_id": "hp_c1c0a020ac369351"}, {"text": "Shifty Shellshock is a person who provided vocals for the song Starry Eyed Surprise and is associated with Crazy Town.", "chunk_id": "0e3a5e1368eb79fe", "doc_id": "hp_c1e92b892fa0c36f"}]</data>
  <data key="d2">[{"text": "Happy Love Sick is the debut solo album by Shifty Shellshock who is best known as frontman of rap rock band Crazy Town.", "chunk_id": "fb6d4773c5a537c1", "doc_id": "hp_5dba59e0680b3340"}, {"text": "\"Slide Along Side\" is a song recorded by Shifty Shellshock.", "chunk_id": "f4e1b3dad9a27f75", "doc_id": "hp_89d981307f6f6b55"}, {"text": "Seth Brooks Binzer (born August 23, 1974), better known by his stage name Shifty Shellshock, is an American music artist, best known for being a co-founder and front man of the rap rock band Crazy Town, and their hit song \"Butterfly\".", "chunk_id": "1e82acbea30954cf", "doc_id": "hp_c1c0a020ac369351"}, {"text": "It features vocals by Shifty Shellshock of Crazy Town.", "chunk_id": "0e3a5e1368eb79fe", "doc_id": "hp_c1e92b892fa0c36f"}]</data>
  <data key="d3">["hp_5dba59e0680b3340", "hp_89d981307f6f6b55", "hp_c1c0a020ac369351", "hp_c1e92b892fa0c36f"]</data>
  <data key="d4">False</data>
</node>
<node id="Crazy Town">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A rap rock band.", "chunk_id": "fb6d4773c5a537c1", "doc_id": "hp_5dba59e0680b3340"}, {"text": "A rap rock band co-founded and fronted by Shifty Shellshock.", "chunk_id": "1e82acbea30954cf", "doc_id": "hp_c1c0a020ac369351"}, {"text": "Crazy Town is an organization that Shifty Shellshock is associated with.", "chunk_id": "0e3a5e1368eb79fe", "doc_id": "hp_c1e92b892fa0c36f"}]</data>
  <data key="d2">[{"text": "Happy Love Sick is the debut solo album by Shifty Shellshock who is best known as frontman of rap rock band Crazy Town.", "chunk_id": "fb6d4773c5a537c1", "doc_id": "hp_5dba59e0680b3340"}, {"text": "Seth Brooks Binzer (born August 23, 1974), better known by his stage name Shifty Shellshock, is an American music artist, best known for being a co-founder and front man of the rap rock band Crazy Town, and their hit song \"Butterfly\".", "chunk_id": "1e82acbea30954cf", "doc_id": "hp_c1c0a020ac369351"}, {"text": "It features vocals by Shifty Shellshock of Crazy Town.", "chunk_id": "0e3a5e1368eb79fe", "doc_id": "hp_c1e92b892fa0c36f"}]</data>
  <data key="d3">["hp_5dba59e0680b3340", "hp_c1c0a020ac369351", "hp_c1e92b892fa0c36f"]</data>
  <data key="d4">False</data>
</node>
<node id="Slide Along Side">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An original single included on the album Happy Love Sick.", "chunk_id": "fb6d4773c5a537c1", "doc_id": "hp_5dba59e0680b3340"}, {"text": "A song recorded by Shifty Shellshock.", "chunk_id": "f4e1b3dad9a27f75", "doc_id": "hp_89d981307f6f6b55"}]</data>
  <data key="d2">[{"text": "The album includes the original singles \"Slide Along Side\" and \"Turning Me On\".", "chunk_id": "fb6d4773c5a537c1", "doc_id": "hp_5dba59e0680b3340"}, {"text": "\"Slide Along Side\" is a song recorded by Shifty Shellshock.", "chunk_id": "f4e1b3dad9a27f75", "doc_id": "hp_89d981307f6f6b55"}]</data>
  <data key="d3">["hp_5dba59e0680b3340", "hp_89d981307f6f6b55"]</data>
