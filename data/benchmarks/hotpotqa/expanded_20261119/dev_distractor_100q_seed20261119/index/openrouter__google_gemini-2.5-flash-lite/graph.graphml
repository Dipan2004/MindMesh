<edge source="Konrad Zuse Medal" target="Gesellschaft für Informatik">
  <data key="d5">["AWARDED_BY"]</data>
  <data key="d6">The Konrad Zuse Medal is the highest award of the Gesellschaft für Informatik.</data>
  <data key="d7">[{"text": "The Konrad Zuse Medal is the highest award of the Gesellschaft für Informatik (the German Computer Science Society), given every two years to one or sometimes two leading German computer scientists.", "chunk_id": "d9c7f79a6d0cc7cf", "doc_id": "hp_1af5bb541eef600d", "type": "AWARDED_BY"}]</data>
  <data key="d8">hp_1af5bb541eef600d</data>
</edge>
<edge source="Konrad Zuse Medal" target="Konrad Zuse">
  <data key="d5">["NAMED_AFTER"]</data>
  <data key="d6">The Konrad Zuse Medal is named after Konrad Zuse.</data>
  <data key="d7">[{"text": "It is named after German computer pioneer Konrad Zuse.", "chunk_id": "d9c7f79a6d0cc7cf", "doc_id": "hp_1af5bb541eef600d", "type": "NAMED_AFTER"}]</data>
  <data key="d8">hp_1af5bb541eef600d</data>
</edge>
<edge source="Gesellschaft für Informatik" target="German Computer Science Society">
  <data key="d5">["IS_A"]</data>
  <data key="d6">The Gesellschaft für Informatik is also known as the German Computer Science Society.</data>
  <data key="d7">[{"text": "The Konrad Zuse Medal is the highest award of the Gesellschaft für Informatik (the German Computer Science Society), given every two years to one or sometimes two leading German computer scientists.", "chunk_id": "d9c7f79a6d0cc7cf", "doc_id": "hp_1af5bb541eef600d", "type": "IS_A"}]</data>
  <data key="d8">hp_1af5bb541eef600d</data>
</edge>
