  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A singer who popularized the song \"I'll Keep the Lovelight Burning\" in 1949.", "chunk_id": "bbfe6a719c1cc2a9", "doc_id": "hp_96c36b4e80e10bfc"}, {"text": "Patti Page was an American singer of traditional pop music and country music.", "chunk_id": "ef27f320448f191e", "doc_id": "hp_b4dbe878b3203aad"}]</data>
  <data key="d2">[{"text": "\"I'll Keep the Lovelight Burning\" is a popular song written in 1942 by Harry Tobias, Nick Kenny, and Harold Levey, popularized by Patti Page in 1949.", "chunk_id": "bbfe6a719c1cc2a9", "doc_id": "hp_96c36b4e80e10bfc"}, {"text": "Clara Ann Fowler (November 8, 1927 – January 1, 2013), known by her professional name Patti Page, was an American singer of traditional pop music and country music.", "chunk_id": "ef27f320448f191e", "doc_id": "hp_b4dbe878b3203aad"}]</data>
  <data key="d3">["hp_96c36b4e80e10bfc", "hp_b4dbe878b3203aad"]</data>
  <data key="d4">False</data>
</node>
<node id="Louis Armstrong">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A musician who covered the song \"I'll Keep the Lovelight Burning\" in 1949.", "chunk_id": "bbfe6a719c1cc2a9", "doc_id": "hp_96c36b4e80e10bfc"}]</data>
  <data key="d2">[{"text": "Louis Armstrong also covered the song in 1949.", "chunk_id": "bbfe6a719c1cc2a9", "doc_id": "hp_96c36b4e80e10bfc"}]</data>
  <data key="d3">["hp_96c36b4e80e10bfc"]</data>
  <data key="d4">False</data>
</node>
<node id="Tikkun Leil Shabbat">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An independent minyan or chavurah in Washington, DC, organized entirely by volunteer leadership.", "chunk_id": "c80672aca910bdd6", "doc_id": "hp_96d9debe51005d2b"}]</data>
  <data key="d2">[{"text": "Tikkun Leil Shabbat is an independent minyan or chavurah in Washington, DC, organized entirely by volunteer leadership and sponsored by Jews United For Justice, DC's local Jewish social justice organization.", "chunk_id": "c80672aca910bdd6", "doc_id": "hp_96d9debe51005d2b"}]</data>
