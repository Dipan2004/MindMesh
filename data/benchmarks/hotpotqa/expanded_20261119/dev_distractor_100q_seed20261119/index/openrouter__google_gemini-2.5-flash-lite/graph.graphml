<edge source="Dean of Chelmsford" target="Cathedral Chapter">
  <data key="d5">["CHAIR_OF"]</data>
  <data key="d6">The Dean of Chelmsford chairs the Cathedral Chapter.</data>
  <data key="d7">[{"text": "The Dean of Chelmsford is the head (\"primus inter pares\" – first among equals) and chair of the Cathedral Chapter, the governing body of Chelmsford Cathedral, the Cathedral Church of St Mary the Virgin, St Peter and St Cedd.", "chunk_id": "147b3f29c0fcd687", "doc_id": "hp_e801334348d2b1fc", "type": "CHAIR_OF"}]</data>
