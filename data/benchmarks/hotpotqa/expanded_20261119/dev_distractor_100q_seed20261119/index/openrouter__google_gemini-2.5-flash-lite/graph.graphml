  <data key="d7">[{"text": "North of the Kiehnmoor and immediately adjacent to it is the valley of a partially dammed stream, the \"Gerdau\", and the Brambosteler Moor nature reserve.", "chunk_id": "582723cb6f560140", "doc_id": "hp_5fffbcc1125c9880", "type": "LOCATED_NEAR"}]</data>
