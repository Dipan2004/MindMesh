<node id="IUCN Protected Area Management Category IV Reserves">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Twin Swamps and Ellen Brook are classified as IUCN Protected Area Management Category IV Reserves.", "chunk_id": "dca355f8299f1441", "doc_id": "hp_88918699b9d7513f"}]</data>
  <data key="d2">[{"text": "Twin Swamps and Ellen Brook are IUCN Protected Area Management Category IV Reserves, while the Mogumber Nature Reserve is a Category Ia nature reserve.", "chunk_id": "dca355f8299f1441", "doc_id": "hp_88918699b9d7513f"}]</data>
