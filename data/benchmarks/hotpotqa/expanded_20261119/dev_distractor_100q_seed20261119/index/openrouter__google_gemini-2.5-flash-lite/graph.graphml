  <data key="d7">[{"text": "Manon Lescaut (\"L'Histoire du chevalier des Grieux et de Manon Lescaut\") is a novel by French author Abbé Prévost.", "chunk_id": "1a052a3777da7f37", "doc_id": "hp_1e281004ae376688", "type": "WRITTEN_BY"}]</data>
