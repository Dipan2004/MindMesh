  <data key="d2">[{"text": "Jim Pugh (born February 5, 1964 in Burbank, California) is a former professional tennis player from the United States.", "chunk_id": "7b5e0db5ada508ba", "doc_id": "hp_8ec8cd0791ca8bff"}]</data>
