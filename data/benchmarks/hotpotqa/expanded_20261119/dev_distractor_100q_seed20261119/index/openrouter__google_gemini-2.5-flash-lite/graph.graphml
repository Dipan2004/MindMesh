<edge source="National Geographic Explorer" target="Nickelodeon">
  <data key="d5">["PREMIERED_ON"]</data>
  <data key="d6">National Geographic Explorer originally premiered on Nickelodeon.</data>
  <data key="d7">[{"text": "National Geographic Explorer (or simply Explorer) is an American documentary television series that originally premiered on Nickelodeon on April 7, 1985, after having been produced as a less costly and intensive alternative to PBS's \"National Geographic Specials\" by Pittsburgh station WQED.", "chunk_id": "f810a5fb38ef5d82", "doc_id": "hp_7baec64414b3f113", "type": "PREMIERED_ON"}]</data>
  <data key="d8">hp_7baec64414b3f113</data>
</edge>
