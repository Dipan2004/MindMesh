<node id="Kapoor family">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A famous family that starred three generations in the film Kal Aaj Aur Kal.", "chunk_id": "16a91e591a40c438", "doc_id": "hp_b3f0efe2307464b8"}, {"text": "A prominent family in Indian cinema that produced several Bollywood superstars.", "chunk_id": "656937d22d978bfd", "doc_id": "hp_e3306a4963e6e08c"}]</data>
  <data key="d2">[{"text": "The film's USP is the appearance of three generations of the famous Kapoor family starring Prithviraj Kapoor, his son Raj Kapoor, Raj Kapoor's son Randhir Kapoor (in his acting debut) and Randhir's real-life wife-to-be Babita.", "chunk_id": "16a91e591a40c438", "doc_id": "hp_b3f0efe2307464b8"}, {"text": "Born at Kapoor Haveli in Peshawar to actor Prithviraj Kapoorhe was a prominent member of the Kapoor familythat produced several celebrated Bollywood superstars.", "chunk_id": "656937d22d978bfd", "doc_id": "hp_e3306a4963e6e08c"}]</data>
  <data key="d3">["hp_b3f0efe2307464b8", "hp_e3306a4963e6e08c"]</data>
  <data key="d4">False</data>
</node>
<node id="Randhir's real-life wife-to-be Babita">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Randhir Kapoor's real-life wife-to-be who starred in the film Kal Aaj Aur Kal.", "chunk_id": "16a91e591a40c438", "doc_id": "hp_b3f0efe2307464b8"}]</data>
  <data key="d2">[{"text": "The film's USP is the appearance of three generations of the famous Kapoor family starring Prithviraj Kapoor, his son Raj Kapoor, Raj Kapoor's son Randhir Kapoor (in his acting debut) and Randhir's real-life wife-to-be Babita.", "chunk_id": "16a91e591a40c438", "doc_id": "hp_b3f0efe2307464b8"}]</data>
  <data key="d3">["hp_b3f0efe2307464b8"]</data>
  <data key="d4">False</data>
</node>
