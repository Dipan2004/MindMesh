  <data key="d5">["USED_FOR"]</data>
  <data key="d6">A cable car was used to connect parts of the G59 exhibition.</data>
  <data key="d7">[{"text": "The two separate halves of the exposition were connected by commuter ferries and a specially created cable car.", "chunk_id": "a9b5754861a849a2", "doc_id": "hp_a9d3423ff7479e28", "type": "USED_FOR"}]</data>
  <data key="d8">hp_a9d3423ff7479e28</data>
</edge>
<edge source="Vicky Brago-Mitchell" target="Stanford University">
  <data key="d5">["STUDENT_AT", "ATTENDED"]</data>
  <data key="d6">Vicky Brago-Mitchell was a student at Stanford University in the 1960s.</data>
  <data key="d7">[{"text": "Vicky Brago-Mitchell is an American fractal artist known in the 1960s as a Stanford University student who, while working as a topless dancer, ran for student body president.", "chunk_id": "b9e66f096d2d52e7", "doc_id": "hp_a9fead16be02ae83", "type": "STUDENT_AT"}, {"text": "After graduating from high school she attended Stanford University as a scholarship student majoring in Spanish.", "chunk_id": "b9e66f096d2d52e7", "doc_id": "hp_a9fead16be02ae83", "type": "ATTENDED"}]</data>
  <data key="d8">hp_a9fead16be02ae83</data>
</edge>
<edge source="Vicky Brago-Mitchell" target="Denis Hayes">
  <data key="d5">["LOST_TO"]</data>
  <data key="d6">Vicky Brago-Mitchell lost the student body president election to Denis Hayes.</data>
  <data key="d7">[{"text": "She won the preliminary election, but lost to eventual Earth Day national coordinator Denis Hayes in a two-person runoff election.", "chunk_id": "b9e66f096d2d52e7", "doc_id": "hp_a9fead16be02ae83", "type": "LOST_TO"}]</data>
  <data key="d8">hp_a9fead16be02ae83</data>
</edge>
<edge source="Vicky Brago-Mitchell" target="Yakima, Washington">
  <data key="d5">["BORN_IN"]</data>
  <data key="d6">Vicky Brago-Mitchell was born in Yakima, Washington.</data>
  <data key="d7">[{"text": "She was born on September 30, 1946 in Yakima, Washington.", "chunk_id": "b9e66f096d2d52e7", "doc_id": "hp_a9fead16be02ae83", "type": "BORN_IN"}]</data>
  <data key="d8">hp_a9fead16be02ae83</data>
</edge>
<edge source="Vicky Brago-Mitchell" target="Victoria Jane Bowles">
  <data key="d5">["FORMER_NAME"]</data>
  <data key="d6">Victoria Jane Bowles is the former name of Vicky Brago-Mitchell.</data>
  <data key="d7">[{"text": "Daughter of a Methodist minister, she grew up as Victoria Jane Bowles in small towns in Washington, Oregon and Montana.", "chunk_id": "b9e66f096d2d52e7", "doc_id": "hp_a9fead16be02ae83", "type": "FORMER_NAME"}]</data>
  <data key="d8">hp_a9fead16be02ae83</data>
</edge>
<edge source="Vicky Brago-Mitchell" target="Stanford Chaparral">
  <data key="d5">["APPEARED_IN"]</data>
  <data key="d6">Vicky Brago-Mitchell appeared nude in the Stanford Chaparral in 1967.</data>
  <data key="d7">[{"text": "In 1967 she was the first American college girl to appear nude in a campus magazine, the Stanford Chaparral (\"Stanford Chaparral\", Spring 1967).", "chunk_id": "b9e66f096d2d52e7", "doc_id": "hp_a9fead16be02ae83", "type": "APPEARED_IN"}]</data>
  <data key="d8">hp_a9fead16be02ae83</data>
</edge>
<edge source="Vicky Brago-Mitchell" target="Vicky Drake">
  <data key="d5">["USED_STAGE_NAME"]</data>
  <data key="d6">Vicky Brago-Mitchell used the stage name Vicky Drake while working as a topless dancer.</data>
  <data key="d7">[{"text": "In 1968 she began working at night as a topless dancer under the stage name Vicky Drake, and ran for student body president with a campaign poster that was a photo of herself posing nude on the Stanford Mausoleum (\"Stanford Alumni Magazine\", September/October 1994).", "chunk_id": "b9e66f096d2d52e7", "doc_id": "hp_a9fead16be02ae83", "type": "USED_STAGE_NAME"}]</data>
  <data key="d8">hp_a9fead16be02ae83</data>
</edge>
<edge source="Vicky Brago-Mitchell" target="Stanford Mausoleum">
  <data key="d5">["POSED_ON"]</data>
  <data key="d6">Vicky Brago-Mitchell posed nude on the Stanford Mausoleum for a campaign poster.</data>
  <data key="d7">[{"text": "In 1968 she began working at night as a topless dancer under the stage name Vicky Drake, and ran for student body president with a campaign poster that was a photo of herself posing nude on the Stanford Mausoleum (\"Stanford Alumni Magazine\", September/October 1994).", "chunk_id": "b9e66f096d2d52e7", "doc_id": "hp_a9fead16be02ae83", "type": "POSED_ON"}]</data>
  <data key="d8">hp_a9fead16be02ae83</data>
</edge>
<edge source="Denis Hayes" target="Earth Day">
  <data key="d5">["COORDINATOR_OF"]</data>
  <data key="d6">Denis Hayes was the national coordinator for Earth Day.</data>
  <data key="d7">[{"text": "She won the preliminary election, but lost to eventual Earth Day national coordinator Denis Hayes in a two-person runoff election.", "chunk_id": "b9e66f096d2d52e7", "doc_id": "hp_a9fead16be02ae83", "type": "COORDINATOR_OF"}]</data>
  <data key="d8">hp_a9fead16be02ae83</data>
</edge>
