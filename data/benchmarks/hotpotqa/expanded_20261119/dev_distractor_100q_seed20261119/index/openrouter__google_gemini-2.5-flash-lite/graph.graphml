<node id="In G Major">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A ballet created for New York City Ballet's Ravel Festival.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d2">[{"text": "In G Major is a ballet made for New York City Ballet's Ravel Festival by ballet master Jerome Robbins to the composer's \"Piano Concerto in G Major\" (1928–31).", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d3">["hp_c8a6c3f50e115d2a"]</data>
  <data key="d4">False</data>
</node>
<node id="Ravel Festival">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A festival for which the ballet \"In G Major\" was created.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d2">[{"text": "In G Major is a ballet made for New York City Ballet's Ravel Festival by ballet master Jerome Robbins to the composer's \"Piano Concerto in G Major\" (1928–31).", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d3">["hp_c8a6c3f50e115d2a"]</data>
  <data key="d4">False</data>
</node>
<node id="Piano Concerto in G Major">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A musical composition by Ravel, used for the ballet \"In G Major\".", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d2">[{"text": "In G Major is a ballet made for New York City Ballet's Ravel Festival by ballet master Jerome Robbins to the composer's \"Piano Concerto in G Major\" (1928–31).", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d3">["hp_c8a6c3f50e115d2a"]</data>
  <data key="d4">False</data>
</node>
<node id="New York State Theater">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The venue where \"In G Major\" premiered.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d2">[{"text": "The premiere took place May 15, 1975 at the New York State Theater, Lincoln Center, with lighting by Mark Stanley.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d3">["hp_c8a6c3f50e115d2a"]</data>
  <data key="d4">False</data>
</node>
<node id="Lincoln Center">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A complex that includes the New York State Theater.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d2">[{"text": "The premiere took place May 15, 1975 at the New York State Theater, Lincoln Center, with lighting by Mark Stanley.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d3">["hp_c8a6c3f50e115d2a"]</data>
  <data key="d4">False</data>
</node>
<node id="Mark Stanley">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The lighting designer for the premiere of \"In G Major\".", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d2">[{"text": "The premiere took place May 15, 1975 at the New York State Theater, Lincoln Center, with lighting by Mark Stanley.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d3">["hp_c8a6c3f50e115d2a"]</data>
  <data key="d4">False</data>
</node>
<node id="Paris Opera Ballet">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A ballet company that staged Robbins' ballet under the name \"En Sol\".", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d2">[{"text": "The Paris Opera Ballet commissioned scenery and costumes by Erté when it staged Robbins' ballet under the name \"En Sol\", decor which has subsequently been borrowed by City Ballet.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d3">["hp_c8a6c3f50e115d2a"]</data>
  <data key="d4">False</data>
</node>
<node id="Erté">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The designer of scenery and costumes for the Paris Opera Ballet's production of Robbins' ballet.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d2">[{"text": "The Paris Opera Ballet commissioned scenery and costumes by Erté when it staged Robbins' ballet under the name \"En Sol\", decor which has subsequently been borrowed by City Ballet.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d3">["hp_c8a6c3f50e115d2a"]</data>
  <data key="d4">False</data>
</node>
<node id="En Sol">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The name under which the Paris Opera Ballet staged Robbins' ballet.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d2">[{"text": "The Paris Opera Ballet commissioned scenery and costumes by Erté when it staged Robbins' ballet under the name \"En Sol\", decor which has subsequently been borrowed by City Ballet.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d3">["hp_c8a6c3f50e115d2a"]</data>
  <data key="d4">False</data>
</node>
<node id="City Ballet">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An organization that borrowed decor for Robbins' ballet.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d2">[{"text": "The Paris Opera Ballet commissioned scenery and costumes by Erté when it staged Robbins' ballet under the name \"En Sol\", decor which has subsequently been borrowed by City Ballet.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d3">["hp_c8a6c3f50e115d2a"]</data>
  <data key="d4">False</data>
</node>
<node id="Ravel">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The composer of the \"Piano Concerto in G Major\".", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d2">[{"text": "Ravel composed the concerto after travelling in the United States and is reported to have described the work as \"... written in very much the same spirit as those of Mozart and Saint-Saëns,\" and said that \"it uses certain effects borrowed from jazz, but only in moderation.\"", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d3">["hp_c8a6c3f50e115d2a"]</data>
  <data key="d4">False</data>
</node>
<node id="Mozart">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A composer whose work Ravel compared his concerto to.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d2">[{"text": "Ravel composed the concerto after travelling in the United States and is reported to have described the work as \"... written in very much the same spirit as those of Mozart and Saint-Saëns,\" and said that \"it uses certain effects borrowed from jazz, but only in moderation.\"", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d3">["hp_c8a6c3f50e115d2a"]</data>
  <data key="d4">False</data>
</node>
<node id="Saint-Saëns">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A composer whose work Ravel compared his concerto to.", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d2">[{"text": "Ravel composed the concerto after travelling in the United States and is reported to have described the work as \"... written in very much the same spirit as those of Mozart and Saint-Saëns,\" and said that \"it uses certain effects borrowed from jazz, but only in moderation.\"", "chunk_id": "19fd24643eea1f76", "doc_id": "hp_c8a6c3f50e115d2a"}]</data>
  <data key="d3">["hp_c8a6c3f50e115d2a"]</data>
  <data key="d4">False</data>
</node>
<node id="Dali–Ruili Railway">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A single-track electrified railroad under construction in Yunnan Province of Southwest China.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d2">[{"text": "The Dali–Ruili Railway or Darui Railway (), is a single-track electrified railroad under construction in Yunnan Province of Southwest China.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d3">["hp_c90ebb0b4e670d3e"]</data>
  <data key="d4">False</data>
</node>
<node id="Dali">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A city in central Yunnan from which the Dali-Ruili Railway is slated to run.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d2">[{"text": "The line is slated to run 336.39 km from Dali in central Yunnan to Ruili in southwestern Yunnan on the border with Myanmar.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d3">["hp_c90ebb0b4e670d3e"]</data>
  <data key="d4">False</data>
</node>
<node id="Gaoligong Mountains">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A mountain range through which a 36-km tunnel will be constructed for the Dali-Ruili Railway.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d2">[{"text": "The line traverses rugged terrain, and bridges and tunnels will account for 75% of the total track length, including a 36-km tunnel through the Gaoligong Mountains.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d3">["hp_c90ebb0b4e670d3e"]</data>
  <data key="d4">False</data>
</node>
<node id="Yangbi Yi Autonomous County">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A county along the route of the Dali-Ruili Railway.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d2">[{"text": "Cities and towns along route include Dali, Yangbi Yi Autonomous County, Yongping County, Baoshan, Mang City (also known as Mangshi or Dehong) and Ruili.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d3">["hp_c90ebb0b4e670d3e"]</data>
  <data key="d4">False</data>
</node>
<node id="Yongping County">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A county along the route of the Dali-Ruili Railway.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d2">[{"text": "Cities and towns along route include Dali, Yangbi Yi Autonomous County, Yongping County, Baoshan, Mang City (also known as Mangshi or Dehong) and Ruili.", "chunk_id": "0473e71883947c27", "doc_id": "hp_c90ebb0b4e670d3e"}]</data>
  <data key="d3">["hp_c90ebb0b4e670d3e"]</data>
  <data key="d4">False</data>
</node>
