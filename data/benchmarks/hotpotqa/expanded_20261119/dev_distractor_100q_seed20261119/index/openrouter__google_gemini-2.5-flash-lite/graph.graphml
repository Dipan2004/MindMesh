<edge source="Standard Oil of Iowa" target="Standard Oil of California">
  <data key="d5">["DISSOLVED_INTO"]</data>
  <data key="d6">Standard Oil of Iowa was dissolved and its assets were handed over to a new Standard Oil of California.</data>
  <data key="d7">[{"text": "In 1906, Standard Oil of Iowa was dissolved and its assets handed over to a new Standard Oil of California, later Chevron Oil Company, and now the Chevron Corporation.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1", "type": "DISSOLVED_INTO"}]</data>
