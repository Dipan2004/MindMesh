<node id="Peacefrog Records">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Peacefrog Records is an independent record label based in London, United Kingdom.", "chunk_id": "1c1d19351df2d318", "doc_id": "hp_28fb4ee88cd9de85"}]</data>
  <data key="d2">[{"text": "Peacefrog Records is an independent record label based in London, United Kingdom.", "chunk_id": "1c1d19351df2d318", "doc_id": "hp_28fb4ee88cd9de85"}]</data>
  <data key="d3">["hp_28fb4ee88cd9de85"]</data>
  <data key="d4">False</data>
</node>
<node id="United Kingdom">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The United Kingdom is a country where Peacefrog Records is based.", "chunk_id": "1c1d19351df2d318", "doc_id": "hp_28fb4ee88cd9de85"}, {"text": "The United Kingdom is a location where The Black Hole was released.", "chunk_id": "5adc5270c9844bc8", "doc_id": "hp_75144a703046903e"}, {"text": "The country Geoff Capes is from.", "chunk_id": "22af8bb1815b8995", "doc_id": "hp_b1381d79c5b4d390"}, {"text": "A sovereign country that Barbados gained political independence from.", "chunk_id": "f15b4d073be58d53", "doc_id": "hp_ebe7b6e221d5e13c"}]</data>
  <data key="d2">[{"text": "Peacefrog Records is an independent record label based in London, United Kingdom.", "chunk_id": "1c1d19351df2d318", "doc_id": "hp_28fb4ee88cd9de85"}, {"text": "The film was released on December 18, 1979 in the United Kingdom and on December 21, 1979 in the United States.", "chunk_id": "5adc5270c9844bc8", "doc_id": "hp_75144a703046903e"}, {"text": "Lars Hedlund from Sweden finished second after finishing second the previous year, and Geoff Capes from the United Kingdom finished third.", "chunk_id": "22af8bb1815b8995", "doc_id": "hp_b1381d79c5b4d390"}, {"text": "It later continued in the role of official residence and office of the Governor-General following political independence from the United Kingdom in 1966.", "chunk_id": "f15b4d073be58d53", "doc_id": "hp_ebe7b6e221d5e13c"}]</data>
  <data key="d3">["hp_28fb4ee88cd9de85", "hp_75144a703046903e", "hp_b1381d79c5b4d390", "hp_ebe7b6e221d5e13c"]</data>
  <data key="d4">False</data>
</node>
<node id="electronic music">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Electronic music is a style of music produced by Peacefrog Records.", "chunk_id": "1c1d19351df2d318", "doc_id": "hp_28fb4ee88cd9de85"}]</data>
  <data key="d2">[{"text": "The label produces releases in many different styles of electronic music, as well as branching out into folk and indie artists such as José González, Nouvelle Vague and Little Dragon.", "chunk_id": "1c1d19351df2d318", "doc_id": "hp_28fb4ee88cd9de85"}]</data>
  <data key="d3">["hp_28fb4ee88cd9de85"]</data>
  <data key="d4">False</data>
</node>
