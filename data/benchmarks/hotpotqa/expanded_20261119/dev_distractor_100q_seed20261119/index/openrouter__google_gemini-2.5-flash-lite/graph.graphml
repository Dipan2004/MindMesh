  <data key="d5">["USED_FOR", "USED_FOR", "USED_FOR"]</data>
  <data key="d6">MLS used shootouts to decide draws.</data>
  <data key="d7">[{"text": "MLS did not allow matches to end in ties and thus Shootouts were used to decide draws, the stats that follow do not include shootout goals scored and the teams actually point total in the regular season was 49 even though it is shown below as 63.", "chunk_id": "29dfa2df58a551ed", "doc_id": "hp_132ccee5aa3dd85c", "type": "USED_FOR"}, {"text": "MLS did not allow matches to end in ties in 1998 and thus Shootouts were used to decide draws, the stats that follow do not include shootout goals scored and the teams actually point total in the regular season was 32 even though it is shown below as 36.", "chunk_id": "ca56de409a030dd6", "doc_id": "hp_33b159b8faca1ec8", "type": "USED_FOR"}, {"text": "MLS did not allow matches to end in ties in 1999 and thus Shootouts were used to decide draws, the stats that follow do not include shootout goals scored and the teams actually point total in the regular season was 20 even though it is shown below as 24.", "chunk_id": "1dcb1ca9df627726", "doc_id": "hp_8ad05a86a63976c5", "type": "USED_FOR"}]</data>
  <data key="d8">hp_132ccee5aa3dd85c</data>
</edge>
