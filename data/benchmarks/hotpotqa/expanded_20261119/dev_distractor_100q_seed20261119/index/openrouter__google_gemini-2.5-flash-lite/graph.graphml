  <data key="d7">[{"text": "The show is presented by astrophysicist Neil deGrasse Tyson, who, as a young high school student, was inspired by Sagan.", "chunk_id": "fcc0f6c36b9c6443", "doc_id": "hp_48076015d5a62427", "type": "PRESENTS"}]</data>
