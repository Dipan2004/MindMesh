</node>
<node id="North Korea">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A country in East Asia, one of the two Koreas.", "chunk_id": "ab78baf12b2f8b16", "doc_id": "hp_b840ad7146ba28d6"}, {"text": "An isolated country from which information on its cinema is difficult to obtain.", "chunk_id": "7cd59a2829630305", "doc_id": "hp_bb98f886833576c8"}]</data>
  <data key="d2">[{"text": "The term \"Cinema of Korea\" (or \"Korean cinema\") encompasses the motion picture industries of North and South Korea.", "chunk_id": "ab78baf12b2f8b16", "doc_id": "hp_b840ad7146ba28d6"}, {"text": "Because of the isolated nature of the country, information—particularly unbiased information—on North Korean cinema is difficult to find.", "chunk_id": "7cd59a2829630305", "doc_id": "hp_bb98f886833576c8"}]</data>
  <data key="d3">["hp_b840ad7146ba28d6", "hp_bb98f886833576c8"]</data>
  <data key="d4">False</data>
</node>
<node id="Korean War">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A war fought from 1950 to 1953 between North Korea, supported by China and the Soviet Union, and South Korea, supported by the United Nations, primarily the United States.", "chunk_id": "ab78baf12b2f8b16", "doc_id": "hp_b840ad7146ba28d6"}, {"text": "A war during which North Korean forces invaded South Korea.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d2">[{"text": "As with all aspects of Korean life during the past century, the film industry has often been at the mercy of political events, from the late Joseon dynasty to the Korean War to domestic governmental interference.", "chunk_id": "ab78baf12b2f8b16", "doc_id": "hp_b840ad7146ba28d6"}, {"text": "The Battle of Yongju (21–22 October 1950), also known as the Battle of the Apple Orchard, took place as part of the United Nations (UN) offensive towards the Yalu River, against the North Korean forces which had invaded South Korea during the Korean War.", "chunk_id": "3b98f4b424fb0646", "doc_id": "hp_c1f8f58c74899fbc"}]</data>
  <data key="d3">["hp_b840ad7146ba28d6", "hp_c1f8f58c74899fbc"]</data>
  <data key="d4">False</data>
</node>
<node id="A180 highway">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Russian federal highway also known as Narva Highway.", "chunk_id": "53eccf7b7bf86b26", "doc_id": "hp_b85dbf7e5499fa3f"}]</data>
  <data key="d2">[{"text": "A180 highway (Russia)", "chunk_id": "53eccf7b7bf86b26", "doc_id": "hp_b85dbf7e5499fa3f"}]</data>
  <data key="d3">["hp_b85dbf7e5499fa3f"]</data>
  <data key="d4">False</data>
</node>
<node id="Russian Route A180">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Russian federal highway, also known as Narva Highway.", "chunk_id": "53eccf7b7bf86b26", "doc_id": "hp_b85dbf7e5499fa3f"}]</data>
  <data key="d2">[{"text": "Russian Route A180, also known as Narva Highway (Russian: Федера́льная автомоби́льная доро́га А180 «На́рва» , Federal highway A180 \"Narva\") is a Russian federal highway that runs from Saint Petersburg through Ivangorod up to the border with Estonia by the Narva River, with the Estonian city of Narva on the opposite bank, which explains the name of the highway.", "chunk_id": "53eccf7b7bf86b26", "doc_id": "hp_b85dbf7e5499fa3f"}]</data>
  <data key="d3">["hp_b85dbf7e5499fa3f"]</data>
  <data key="d4">False</data>
</node>
<node id="Narva Highway">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A Russian federal highway, also known as Russian Route A180.", "chunk_id": "53eccf7b7bf86b26", "doc_id": "hp_b85dbf7e5499fa3f"}]</data>
  <data key="d2">[{"text": "Russian Route A180, also known as Narva Highway (Russian: Федера́льная автомоби́льная доро́га А180 «На́рва» , Federal highway A180 \"Narva\") is a Russian federal highway that runs from Saint Petersburg through Ivangorod up to the border with Estonia by the Narva River, with the Estonian city of Narva on the opposite bank, which explains the name of the highway.", "chunk_id": "53eccf7b7bf86b26", "doc_id": "hp_b85dbf7e5499fa3f"}]</data>
  <data key="d3">["hp_b85dbf7e5499fa3f"]</data>
  <data key="d4">False</data>
</node>
