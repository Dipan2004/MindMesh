  <data key="d2">[{"text": "The National Oil Corporation (NOC; Arabic: المؤسسة الوطنية للنفط‎ ‎ ) is the national oil company of Libya.", "chunk_id": "3bd8bdbee13ce970", "doc_id": "hp_f5e542612484aad3"}]</data>
