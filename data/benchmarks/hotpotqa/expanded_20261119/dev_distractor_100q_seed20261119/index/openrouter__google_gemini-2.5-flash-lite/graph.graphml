  <data key="d7">[{"text": "It is located on the Mid North Coast of New South Wales, Australia, about 390 km north of Sydney, and 570 km south of Brisbane.", "chunk_id": "6223f89935ee9cfe", "doc_id": "hp_de00d7ebc47399cc", "type": "LOCATED_IN"}]</data>
