  <data key="d2">[{"text": "None of the three series of the programme are available to purchase on DVD in the UK, however, all three can be watched on demand for subscribers of National Geographic on Sky, Virgin Media and BT Vision.", "chunk_id": "ec87e3591d7acc99", "doc_id": "hp_8429039f0ec9c01d"}]</data>
