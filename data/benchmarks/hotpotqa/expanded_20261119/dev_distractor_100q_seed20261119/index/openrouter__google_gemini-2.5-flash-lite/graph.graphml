<node id="Seattle Sounders FC 2">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An American soccer club based in Seattle, Washington, competing in the United Soccer League as the reserve team of Seattle Sounders FC.", "chunk_id": "0383bd36f57d412b", "doc_id": "hp_c9681d41f79300d2"}]</data>
  <data key="d2">[{"text": "Seattle Sounders FC 2 (nicknamed S2) is an American soccer club based in Seattle, Washington that competes in the United Soccer League, the third tier of the United States Soccer Pyramid, as the reserve team of Seattle Sounders FC.", "chunk_id": "0383bd36f57d412b", "doc_id": "hp_c9681d41f79300d2"}]</data>
