<node id="White House Office of Presidential Advance">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The White House Office of Presidential Advance was an office within the White House administration.", "chunk_id": "17e54dbd5dd980bc", "doc_id": "hp_cdb59476dc4f3e8a"}]</data>
  <data key="d2">[{"text": "Walker served in the administration of President Richard Nixon, first as the first Director of the White House Office of Presidential Advance, and later as Director of the National Park Service (1972–1975).", "chunk_id": "17e54dbd5dd980bc", "doc_id": "hp_cdb59476dc4f3e8a"}]</data>
  <data key="d3">["hp_cdb59476dc4f3e8a"]</data>
