  <data key="d2">[{"text": "Genadendal Residence ] is the official residence of the President of South Africa when in office at Tuynhuys, Cape Town.", "chunk_id": "f05b7044d350a953", "doc_id": "hp_20bf70e341654a18"}]</data>
  <data key="d3">["hp_20bf70e341654a18"]</data>
