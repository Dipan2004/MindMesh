<node id="BRIT Awards">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The BRIT Awards are an annual event where Travis has twice been awarded British album of the year.", "chunk_id": "8043cae2ef7b7fae", "doc_id": "hp_5e36dcc4c1a872ca"}, {"text": "An awards ceremony where Florence and the Machine received an award in 2009.", "chunk_id": "a0e37e5744f28418", "doc_id": "hp_6d4a91fc9052bf4e"}]</data>
  <data key="d2">[{"text": "Travis have twice been awarded British album of the year at the annual BRIT Awards, and are often credited with having paved the way for bands such as Coldplay, Keane and Snow Patrol.", "chunk_id": "8043cae2ef7b7fae", "doc_id": "hp_5e36dcc4c1a872ca"}, {"text": "At the 2009 Brit Awards they received the Brit Awards \"Critics' Choice\" award.", "chunk_id": "a0e37e5744f28418", "doc_id": "hp_6d4a91fc9052bf4e"}]</data>
  <data key="d3">["hp_5e36dcc4c1a872ca", "hp_6d4a91fc9052bf4e"]</data>
  <data key="d4">False</data>
</node>
