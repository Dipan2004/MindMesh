<edge source="Springwood bus station" target="TransLink">
  <data key="d5">["SERVED_BY", "PART_OF"]</data>
  <data key="d6">The Springwood Bus Station is served by TransLink bus routes.</data>
  <data key="d7">[{"text": "The Springwood Bus Station, at Springwood, is served by TransLink bus routes.", "chunk_id": "d45b60b7abaeaa6a", "doc_id": "hp_85a0b49c6ecc4877", "type": "SERVED_BY"}, {"text": "It is a major interchange for TransLink's Southern Region, being an important stop for Logan City Bus Service routes between Brisbane and Loganholme.", "chunk_id": "d45b60b7abaeaa6a", "doc_id": "hp_85a0b49c6ecc4877", "type": "PART_OF"}]</data>
