  <data key="d2">[{"text": "Xóchitl Hamada has worked for Mexico's two largest wrestling companies, Consejo Mundial de Lucha Libre (CMLL) and Asistencia Asesoría y Administración (AAA).", "chunk_id": "beab562ef9fe8887", "doc_id": "hp_e53c480ef8a45aab"}]</data>
