<node id="Toronto National Sea Fleas">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "A senior men's amateur ice hockey team.", "chunk_id": "fecd6ff50a6d6817", "doc_id": "hp_2509ce49ef3c84a3"}, {"text": "The Toronto National Sea Fleas was a team that won the 1932 Allan Cup.", "chunk_id": "4bbb68cf46284da6", "doc_id": "hp_f18e54e3d937fb49"}]</data>
  <data key="d2">[{"text": "The Toronto National Sea Fleas were a senior men's amateur ice hockey team that won the 1932 Allan Cup, and also represented Canada at the 1933 World Ice Hockey Championships held in Prague, Czechoslovakia where the team lost the final game to the United States in overtime to capture the silver medal for Canada.", "chunk_id": "fecd6ff50a6d6817", "doc_id": "hp_2509ce49ef3c84a3"}, {"text": "The 1932 Allan Cup was won by the Toronto National Sea Fleas.", "chunk_id": "4bbb68cf46284da6", "doc_id": "hp_f18e54e3d937fb49"}]</data>
  <data key="d3">["hp_2509ce49ef3c84a3", "hp_f18e54e3d937fb49"]</data>
  <data key="d4">False</data>
</node>
<node id="1932 Allan Cup">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "An ice hockey competition won by the Toronto National Sea Fleas.", "chunk_id": "fecd6ff50a6d6817", "doc_id": "hp_2509ce49ef3c84a3"}, {"text": "The 1932 Allan Cup was a championship event.", "chunk_id": "4bbb68cf46284da6", "doc_id": "hp_f18e54e3d937fb49"}]</data>
  <data key="d2">[{"text": "The Toronto National Sea Fleas were a senior men's amateur ice hockey team that won the 1932 Allan Cup, and also represented Canada at the 1933 World Ice Hockey Championships held in Prague, Czechoslovakia where the team lost the final game to the United States in overtime to capture the silver medal for Canada.", "chunk_id": "fecd6ff50a6d6817", "doc_id": "hp_2509ce49ef3c84a3"}, {"text": "1932 Allan Cup", "chunk_id": "4bbb68cf46284da6", "doc_id": "hp_f18e54e3d937fb49"}]</data>
  <data key="d3">["hp_2509ce49ef3c84a3", "hp_f18e54e3d937fb49"]</data>
  <data key="d4">False</data>
</node>
<node id="1933 World Ice Hockey Championships">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "An international ice hockey competition where the Toronto National Sea Fleas represented Canada.", "chunk_id": "fecd6ff50a6d6817", "doc_id": "hp_2509ce49ef3c84a3"}, {"text": "The 1933 World Ice Hockey Championships was an international ice hockey competition.", "chunk_id": "4bbb68cf46284da6", "doc_id": "hp_f18e54e3d937fb49"}]</data>
  <data key="d2">[{"text": "The Toronto National Sea Fleas were a senior men's amateur ice hockey team that won the 1932 Allan Cup, and also represented Canada at the 1933 World Ice Hockey Championships held in Prague, Czechoslovakia where the team lost the final game to the United States in overtime to capture the silver medal for Canada.", "chunk_id": "fecd6ff50a6d6817", "doc_id": "hp_2509ce49ef3c84a3"}, {"text": "This team went on to represent Canada at the 1933 World Ice Hockey Championships held in Prague, Czechoslovakia where the team lost the final game to the United States in overtime to capture the silver medal for Canada.", "chunk_id": "4bbb68cf46284da6", "doc_id": "hp_f18e54e3d937fb49"}]</data>
  <data key="d3">["hp_2509ce49ef3c84a3", "hp_f18e54e3d937fb49"]</data>
  <data key="d4">False</data>
</node>
<node id="Prague">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The city in Czechoslovakia where the 1933 World Ice Hockey Championships were held.", "chunk_id": "fecd6ff50a6d6817", "doc_id": "hp_2509ce49ef3c84a3"}, {"text": "A city near the village of Peruc where the film Lunacy was shot.", "chunk_id": "c947b5f039c20a78", "doc_id": "hp_dfa620b8112ac9e5"}, {"text": "Prague was the host city for the 1933 World Ice Hockey Championships.", "chunk_id": "4bbb68cf46284da6", "doc_id": "hp_f18e54e3d937fb49"}]</data>
  <data key="d2">[{"text": "The Toronto National Sea Fleas were a senior men's amateur ice hockey team that won the 1932 Allan Cup, and also represented Canada at the 1933 World Ice Hockey Championships held in Prague, Czechoslovakia where the team lost the final game to the United States in overtime to capture the silver medal for Canada.", "chunk_id": "fecd6ff50a6d6817", "doc_id": "hp_2509ce49ef3c84a3"}, {"text": "The film was shot between October 2004 and April 2005, on location in the village of Peruc close to Prague, and in Švankmajer's studio in the village of Knovíz.", "chunk_id": "c947b5f039c20a78", "doc_id": "hp_dfa620b8112ac9e5"}, {"text": "This team went on to represent Canada at the 1933 World Ice Hockey Championships held in Prague, Czechoslovakia where the team lost the final game to the United States in overtime to capture the silver medal for Canada.", "chunk_id": "4bbb68cf46284da6", "doc_id": "hp_f18e54e3d937fb49"}]</data>
  <data key="d3">["hp_2509ce49ef3c84a3", "hp_dfa620b8112ac9e5", "hp_f18e54e3d937fb49"]</data>
  <data key="d4">False</data>
</node>
<node id="Czechoslovakia">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The country where Prague is located and where the 1933 World Ice Hockey Championships were held.", "chunk_id": "fecd6ff50a6d6817", "doc_id": "hp_2509ce49ef3c84a3"}, {"text": "The country where the animated short film 'The Last Trick' was produced.", "chunk_id": "134ef8db403da064", "doc_id": "hp_bf43ba8a29c65d6d"}, {"text": "Czechoslovakia was the country where the 1933 World Ice Hockey Championships were held.", "chunk_id": "4bbb68cf46284da6", "doc_id": "hp_f18e54e3d937fb49"}]</data>
  <data key="d2">[{"text": "The Toronto National Sea Fleas were a senior men's amateur ice hockey team that won the 1932 Allan Cup, and also represented Canada at the 1933 World Ice Hockey Championships held in Prague, Czechoslovakia where the team lost the final game to the United States in overtime to capture the silver medal for Canada.", "chunk_id": "fecd6ff50a6d6817", "doc_id": "hp_2509ce49ef3c84a3"}, {"text": "The Last Trick (Czech: Poslední trik pana Schwarcewalldea a pana Edgara ) is a 1964 Czechoslovak animated short film by Jan Švankmajer.", "chunk_id": "134ef8db403da064", "doc_id": "hp_bf43ba8a29c65d6d"}, {"text": "This team went on to represent Canada at the 1933 World Ice Hockey Championships held in Prague, Czechoslovakia where the team lost the final game to the United States in overtime to capture the silver medal for Canada.", "chunk_id": "4bbb68cf46284da6", "doc_id": "hp_f18e54e3d937fb49"}]</data>
  <data key="d3">["hp_2509ce49ef3c84a3", "hp_bf43ba8a29c65d6d", "hp_f18e54e3d937fb49"]</data>
  <data key="d4">False</data>
</node>
<node id="Rio Hondo">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A river located in northern New Mexico.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}, {"text": "The Rio Hondo is a geographical feature after which Rio Hondo College is named.", "chunk_id": "75ff884d3fae85e2", "doc_id": "hp_46658770e8628bf3"}, {"text": "Rio Hondo is a city in Texas, USA.", "chunk_id": "4794c1c9636159ee", "doc_id": "hp_81c072f4caf17f94"}, {"text": "A creek that the Rio Hondo Bike Path parallels.", "chunk_id": "a2f7562b6d871ad4", "doc_id": "hp_900332dfe25fe511"}, {"text": "A 79-mile river located in southern New Mexico.", "chunk_id": "255974268309be7d", "doc_id": "hp_d006074a495409b2"}]</data>
  <data key="d2">[{"text": "Rio Hondo (Northern New Mexico)", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}, {"text": "Rio Hondo College is a community college located in the city of Whittier, California, United States, named after the Rio Hondo.", "chunk_id": "75ff884d3fae85e2", "doc_id": "hp_46658770e8628bf3"}, {"text": "Rio Hondo Independent School District is a public school district based in Rio Hondo, Texas (USA).", "chunk_id": "4794c1c9636159ee", "doc_id": "hp_81c072f4caf17f94"}, {"text": "The Rio Hondo Bike Path is a Class 1 bicycle path that parallels the Rio Hondo (creek) through the San Gabriel Valley, in eastern Los Angeles County, California.", "chunk_id": "a2f7562b6d871ad4", "doc_id": "hp_900332dfe25fe511"}, {"text": "The Rio Hondo is a 79 mi river in southern New Mexico which begins at the confluence of the Rio Bonito and Rio Ruidoso rivers near the town of Hondo, New Mexico.", "chunk_id": "255974268309be7d", "doc_id": "hp_d006074a495409b2"}]</data>
  <data key="d3">["hp_254f59b0af5e9003", "hp_46658770e8628bf3", "hp_81c072f4caf17f94", "hp_900332dfe25fe511", "hp_d006074a495409b2"]</data>
  <data key="d4">False</data>
</node>
<node id="Northern New Mexico">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A geographical region in the northern part of New Mexico.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d2">[{"text": "In northern New Mexico, the Rio Hondo begins high in the Sangre de Cristo Mountains near Taos Ski Valley and flows for approximately 20 mi into the Rio Grande.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d3">["hp_254f59b0af5e9003"]</data>
  <data key="d4">False</data>
</node>
<node id="Sangre de Cristo Mountains">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A mountain range in northern New Mexico where the Rio Hondo begins.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d2">[{"text": "In northern New Mexico, the Rio Hondo begins high in the Sangre de Cristo Mountains near Taos Ski Valley and flows for approximately 20 mi into the Rio Grande.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d3">["hp_254f59b0af5e9003"]</data>
  <data key="d4">False</data>
</node>
<node id="Taos Ski Valley">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location in the Sangre de Cristo Mountains near where the Rio Hondo begins and a source of wastewater.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d2">[{"text": "In northern New Mexico, the Rio Hondo begins high in the Sangre de Cristo Mountains near Taos Ski Valley and flows for approximately 20 mi into the Rio Grande.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d3">["hp_254f59b0af5e9003"]</data>
  <data key="d4">False</data>
</node>
<node id="Rio Grande">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A river into which the Rio Hondo flows.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d2">[{"text": "In northern New Mexico, the Rio Hondo begins high in the Sangre de Cristo Mountains near Taos Ski Valley and flows for approximately 20 mi into the Rio Grande.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d3">["hp_254f59b0af5e9003"]</data>
  <data key="d4">False</data>
</node>
<node id="bird-watching">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An activity for which portions of the Rio Hondo are prized.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d2">[{"text": "Portions of the Rio Hondo are prized as prime spots for bird-watching and fishing.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d3">["hp_254f59b0af5e9003"]</data>
  <data key="d4">False</data>
</node>
<node id="fishing">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An activity for which portions of the Rio Hondo are prized.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d2">[{"text": "Portions of the Rio Hondo are prized as prime spots for bird-watching and fishing.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d3">["hp_254f59b0af5e9003"]</data>
  <data key="d4">False</data>
</node>
<node id="New Mexico Environment Department Surface Water Quality Bureau">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An organization that conducted a study on the Rio Hondo in 2005.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d2">[{"text": "The river was the subject of a 2005 study by the New Mexico Environment Department Surface Water Quality Bureau into the effects of wastewater from Taos Ski Valley, which is discharged from the Village of Taos Ski Valley Waste Water Treatment Plant.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d3">["hp_254f59b0af5e9003"]</data>
  <data key="d4">False</data>
</node>
<node id="wastewater">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Discharged from Taos Ski Valley and studied for its effects on the Rio Hondo.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d2">[{"text": "The river was the subject of a 2005 study by the New Mexico Environment Department Surface Water Quality Bureau into the effects of wastewater from Taos Ski Valley, which is discharged from the Village of Taos Ski Valley Waste Water Treatment Plant.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d3">["hp_254f59b0af5e9003"]</data>
  <data key="d4">False</data>
</node>
<node id="Village of Taos Ski Valley Waste Water Treatment Plant">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The facility from which wastewater is discharged.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d2">[{"text": "The river was the subject of a 2005 study by the New Mexico Environment Department Surface Water Quality Bureau into the effects of wastewater from Taos Ski Valley, which is discharged from the Village of Taos Ski Valley Waste Water Treatment Plant.", "chunk_id": "39706fd17d18aa0c", "doc_id": "hp_254f59b0af5e9003"}]</data>
  <data key="d3">["hp_254f59b0af5e9003"]</data>
  <data key="d4">False</data>
</node>
<node id="Arachis">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Arachis is a genus of about 70 species of annual and perennial flowering plants in the pea family (Fabaceae), native to South America.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}, {"text": "Arachis is a genus that contains Arachis monticola and Arachis hypogaea.", "chunk_id": "4fb00b903790bf5f", "doc_id": "hp_854482b064cdae3e"}]</data>
  <data key="d2">[{"text": "Arachis is a genus of about 70 species of annual and perennial flowering plants in the pea family (Fabaceae), native to South America, and was recently assigned to the informal monophyletic \"Pterocarpus\" clade of the Dalbergieae.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}, {"text": "Besides the peanut, it is the only other tetraploid species in the genus \"Arachis\".", "chunk_id": "4fb00b903790bf5f", "doc_id": "hp_854482b064cdae3e"}]</data>
  <data key="d3">["hp_259c900d1fad8746", "hp_854482b064cdae3e"]</data>
  <data key="d4">False</data>
</node>
<node id="Fabaceae">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Fabaceae is the pea family, which includes the genus Arachis.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d2">[{"text": "Arachis is a genus of about 70 species of annual and perennial flowering plants in the pea family (Fabaceae), native to South America, and was recently assigned to the informal monophyletic \"Pterocarpus\" clade of the Dalbergieae.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d3">["hp_259c900d1fad8746"]</data>
  <data key="d4">False</data>
</node>
<node id="South America">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "South America is the native region for the genus Arachis.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d2">[{"text": "Arachis is a genus of about 70 species of annual and perennial flowering plants in the pea family (Fabaceae), native to South America, and was recently assigned to the informal monophyletic \"Pterocarpus\" clade of the Dalbergieae.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d3">["hp_259c900d1fad8746"]</data>
  <data key="d4">False</data>
</node>
<node id="Pterocarpus">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Pterocarpus is an informal monophyletic clade to which Arachis has been recently assigned.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d2">[{"text": "Arachis is a genus of about 70 species of annual and perennial flowering plants in the pea family (Fabaceae), native to South America, and was recently assigned to the informal monophyletic \"Pterocarpus\" clade of the Dalbergieae.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d3">["hp_259c900d1fad8746"]</data>
  <data key="d4">False</data>
</node>
<node id="Dalbergieae">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Dalbergieae is a taxonomic tribe to which the informal clade Pterocarpus belongs, and Arachis has been assigned.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d2">[{"text": "Arachis is a genus of about 70 species of annual and perennial flowering plants in the pea family (Fabaceae), native to South America, and was recently assigned to the informal monophyletic \"Pterocarpus\" clade of the Dalbergieae.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d3">["hp_259c900d1fad8746"]</data>
  <data key="d4">False</data>
</node>
<node id="Arachis hypogaea">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Arachis hypogaea, commonly known as the peanut, is a major food crop species of global importance.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}, {"text": "Arachis hypogaea is the domesticated peanut.", "chunk_id": "4fb00b903790bf5f", "doc_id": "hp_854482b064cdae3e"}]</data>
  <data key="d2">[{"text": "At least one species, the peanut (\"Arachis hypogaea\"), is a major food crop species of global importance; some of the other species are cultivated for food to a small extent in South America.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}, {"text": "Arachis monticola is a close relative of the domesticated peanut (\"Arachis hypogaea\").", "chunk_id": "4fb00b903790bf5f", "doc_id": "hp_854482b064cdae3e"}]</data>
  <data key="d3">["hp_259c900d1fad8746", "hp_854482b064cdae3e"]</data>
  <data key="d4">False</data>
</node>
<node id="peanut">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The peanut, scientifically known as Arachis hypogaea, is a significant global food crop.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d2">[{"text": "At least one species, the peanut (\"Arachis hypogaea\"), is a major food crop species of global importance; some of the other species are cultivated for food to a small extent in South America.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d3">["hp_259c900d1fad8746"]</data>
  <data key="d4">False</data>
</node>
<node id="A. pintoi">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A. pintoi is a species within the Arachis genus cultivated worldwide as forage and soil conditioner plants.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d2">[{"text": "Other species such as \"A. pintoi\" are cultivated worldwide as forage and soil conditioner plants, with the leaves providing high-protein feed for grazing livestock and a nitrogen source in agroforestry and permaculture systems.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d3">["hp_259c900d1fad8746"]</data>
  <data key="d4">False</data>
</node>
<node id="agroforestry">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Agroforestry is a land-use system where trees and agricultural crops are grown together, and A. pintoi can be used as a nitrogen source within it.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d2">[{"text": "Other species such as \"A. pintoi\" are cultivated worldwide as forage and soil conditioner plants, with the leaves providing high-protein feed for grazing livestock and a nitrogen source in agroforestry and permaculture systems.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d3">["hp_259c900d1fad8746"]</data>
  <data key="d4">False</data>
</node>
<node id="permaculture">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Permaculture is a system of agricultural and social design principles centered on simulating or directly utilizing the patterns and resilient features observed in natural ecosystems, and A. pintoi can be used as a nitrogen source within it.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d2">[{"text": "Other species such as \"A. pintoi\" are cultivated worldwide as forage and soil conditioner plants, with the leaves providing high-protein feed for grazing livestock and a nitrogen source in agroforestry and permaculture systems.", "chunk_id": "ba034880e13d7dbd", "doc_id": "hp_259c900d1fad8746"}]</data>
  <data key="d3">["hp_259c900d1fad8746"]</data>
  <data key="d4">False</data>
</node>
<node id="Shigeko Kubota">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A Japanese video artist, sculptor, and avant-garde performance artist.", "chunk_id": "bb303342f684188a", "doc_id": "hp_25e106b688a6f938"}]</data>
  <data key="d2">[{"text": "Shigeko Kubota (久保田 成子 , Kubota Shigeko ) (2 August 1937 – 23 July 2015) was a Japanese video artist, sculptor and avant-garde performance artist, who mostly lived in New York City.", "chunk_id": "bb303342f684188a", "doc_id": "hp_25e106b688a6f938"}]</data>
  <data key="d3">["hp_25e106b688a6f938"]</data>
  <data key="d4">False</data>
</node>
<node id="Sony Portapak">
  <data key="d0">TECHNOLOGY</data>
  <data key="d1">[{"text": "A portable video camera adopted by Shigeko Kubota in 1967.", "chunk_id": "bb303342f684188a", "doc_id": "hp_25e106b688a6f938"}]</data>
  <data key="d2">[{"text": "She was one of the first artists to adopt the portable video camera Sony Portapak in 1967.", "chunk_id": "bb303342f684188a", "doc_id": "hp_25e106b688a6f938"}]</data>
  <data key="d3">["hp_25e106b688a6f938"]</data>
  <data key="d4">False</data>
</node>
<node id="New York City">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The city where Shigeko Kubota mostly lived and moved to in 1964.", "chunk_id": "bb303342f684188a", "doc_id": "hp_25e106b688a6f938"}, {"text": "New York City is a location in the United States where the band Das Damen was formed.", "chunk_id": "2a770550ab855da2", "doc_id": "hp_487457843d9527fb"}, {"text": "The city where \"The Town Hall\" is located and the panel debate was filmed.", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}, {"text": "New York City is a location where Barrie Karp has been an educator.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}, {"text": "A city where the album Wreckorder was recorded.", "chunk_id": "02e94c52db8f837e", "doc_id": "hp_d73d23b34d64cf3a"}, {"text": "A major city in the United States, home to the Five Families of the Mafia.", "chunk_id": "e73f7ce666aa44ac", "doc_id": "hp_e188311f102838e1"}, {"text": "The location where the Michael Jackson: 30th Anniversary Celebration took place.", "chunk_id": "27c840a9f2ae6d8f", "doc_id": "hp_e324150cd91f309d"}, {"text": "New York City is the location where the record producing and songwriting team, Ghost, is based.", "chunk_id": "df83364e0d4a59c9", "doc_id": "hp_f6fa72cb3d251e8b"}]</data>
  <data key="d2">[{"text": "Shigeko Kubota (久保田 成子 , Kubota Shigeko ) (2 August 1937 – 23 July 2015) was a Japanese video artist, sculptor and avant-garde performance artist, who mostly lived in New York City.", "chunk_id": "bb303342f684188a", "doc_id": "hp_25e106b688a6f938"}, {"text": "Das Damen was an alternative rock band from New York City, United States, formed in 1984.", "chunk_id": "2a770550ab855da2", "doc_id": "hp_487457843d9527fb"}, {"text": "Filmed on April 30, 1971, in The Town Hall in New York City, \"Town Bloody Hall\" features a panel of feminist advocates for the women's liberation movement and Norman Mailer, the writer of \"The Prisoner of Sex\".", "chunk_id": "a75812f45ba95804", "doc_id": "hp_535589d1805f024e"}, {"text": "She has been an educator in philosophy, cultural studies, humanities and arts from a feminist and anti-racist perspective in New York City colleges and universities since 1970.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}, {"text": "The album was recorded in late 2009 in Berlin and New York City, before being completed in Vermont in early 2010.", "chunk_id": "02e94c52db8f837e", "doc_id": "hp_d73d23b34d64cf3a"}, {"text": "Joseph Dominick \"Joe\" Pistone, alias Donnie Brasco, (born September 17, 1939), is a former FBI agent who worked undercover for six years infiltrating the Bonanno crime family and to a lesser extent the Colombo crime family, two of the Five Families of the Mafia in New York City.", "chunk_id": "e73f7ce666aa44ac", "doc_id": "hp_e188311f102838e1"}, {"text": "The Michael Jackson: 30th Anniversary Celebration was a 2001 New York City revue show by Michael Jackson.", "chunk_id": "27c840a9f2ae6d8f", "doc_id": "hp_e324150cd91f309d"}, {"text": "Ghost is a Swedish record producing and songwriting team, composed of Ulf Lindström and Johan Ekhé, based in New York City.", "chunk_id": "df83364e0d4a59c9", "doc_id": "hp_f6fa72cb3d251e8b"}]</data>
  <data key="d3">["hp_25e106b688a6f938", "hp_487457843d9527fb", "hp_535589d1805f024e", "hp_65a971e7a10d79c8", "hp_d73d23b34d64cf3a", "hp_e188311f102838e1", "hp_e324150cd91f309d", "hp_f6fa72cb3d251e8b"]</data>
  <data key="d4">False</data>
</node>
<node id="George Brecht">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A member of Fluxus closely associated with Shigeko Kubota.", "chunk_id": "bb303342f684188a", "doc_id": "hp_25e106b688a6f938"}]</data>
  <data key="d2">[{"text": "She was closely associated with George Brecht, Jackson Mac Low, John Cage, Joe Jones, Nam June Paik, and Ay-O, other members of Fluxus.", "chunk_id": "bb303342f684188a", "doc_id": "hp_25e106b688a6f938"}]</data>
  <data key="d3">["hp_25e106b688a6f938"]</data>
