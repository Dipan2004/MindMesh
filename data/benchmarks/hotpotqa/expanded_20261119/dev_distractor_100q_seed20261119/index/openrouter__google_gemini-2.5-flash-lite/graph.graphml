  <data key="d1">[{"text": "An upscale seafood restaurant in San Francisco.", "chunk_id": "a607c1419ccde322", "doc_id": "hp_83075853aa855bc1"}]</data>
  <data key="d2">[{"text": "He was the Corporate Executive Chef of Aqua, an upscale seafood restaurant in San Francisco, where he earned 2 Michelin stars in 2006, the first time Michelin came to the San Francisco Bay Area, and again in 2007 and 2008.", "chunk_id": "a607c1419ccde322", "doc_id": "hp_83075853aa855bc1"}]</data>
