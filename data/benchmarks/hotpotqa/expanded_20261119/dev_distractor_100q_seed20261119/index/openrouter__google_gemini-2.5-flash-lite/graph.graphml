  <data key="d1">[{"text": "A chart that \"A Pair of Brown Eyes\" was the first single by The Pogues to make.", "chunk_id": "b52105e0cc7ef21b", "doc_id": "hp_da38acdde66d2037"}]</data>
  <data key="d2">[{"text": "The single was their first to make the UK Top 100, peaking at Number 72.", "chunk_id": "b52105e0cc7ef21b", "doc_id": "hp_da38acdde66d2037"}]</data>
