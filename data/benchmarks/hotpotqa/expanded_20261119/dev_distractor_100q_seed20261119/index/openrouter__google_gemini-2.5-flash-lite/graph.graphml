  <data key="d4">False</data>
</node>
<node id="quick-written, lurid potboilers">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A pejorative term used in the modern age to describe sensationalized but superficial literary works, often associated with dime novels.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d2">[{"text": "In the modern age, the term \"dime novel\" has been used to refer to quickly written, lurid potboilers, usually as a pejorative to describe a sensationalized but superficial literary work.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d3">["hp_e364a8973c287ebf"]</data>
  <data key="d4">False</data>
</node>
<node id="sensationalized but superficial literary work">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A type of literary work that is often pejoratively described using the term \"dime novel\".", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d2">[{"text": "In the modern age, the term \"dime novel\" has been used to refer to quickly written, lurid potboilers, usually as a pejorative to describe a sensationalized but superficial literary work.", "chunk_id": "0f2d5a5e9d103a1e", "doc_id": "hp_e364a8973c287ebf"}]</data>
  <data key="d3">["hp_e364a8973c287ebf"]</data>
  <data key="d4">False</data>
</node>
<node id="Viscount FitzAlan of Derwent">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A title in the Peerage of the United Kingdom.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d2">[{"text": "Viscount FitzAlan of Derwent, of Derwent in the County of Derby, was a title in the Peerage of the United Kingdom.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d3">["hp_e45eb2b0da78e861"]</data>
  <data key="d4">False</data>
</node>
<node id="Derwent">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location associated with the title Viscount FitzAlan of Derwent.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d2">[{"text": "Viscount FitzAlan of Derwent, of Derwent in the County of Derby, was a title in the Peerage of the United Kingdom.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d3">["hp_e45eb2b0da78e861"]</data>
  <data key="d4">False</data>
</node>
<node id="Lord Edmund Talbot">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The first holder of the title Viscount FitzAlan of Derwent.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d2">[{"text": "It was created in 1921 for Lord Edmund Talbot on his appointment as Lord Lieutenant of Ireland.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d3">["hp_e45eb2b0da78e861"]</data>
  <data key="d4">False</data>
</node>
<node id="Lord Lieutenant of Ireland">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An official position in Ireland.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d2">[{"text": "It was created in 1921 for Lord Edmund Talbot on his appointment as Lord Lieutenant of Ireland.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d3">["hp_e45eb2b0da78e861"]</data>
  <data key="d4">False</data>
</node>
<node id="Lord Edmund FitzAlan-Howard">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The birth name of Viscount FitzAlan of Derwent.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d2">[{"text": "Born Lord Edmund FitzAlan-Howard, he was the second son of Henry Fitzalan-Howard, 14th Duke of Norfolk.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d3">["hp_e45eb2b0da78e861"]</data>
  <data key="d4">False</data>
</node>
<node id="14th Duke of Norfolk">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A ducal title held by Henry Fitzalan-Howard.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d2">[{"text": "Born Lord Edmund FitzAlan-Howard, he was the second son of Henry Fitzalan-Howard, 14th Duke of Norfolk.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d3">["hp_e45eb2b0da78e861"]</data>
  <data key="d4">False</data>
</node>
<node id="Talbot">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A surname assumed by Lord Edmund FitzAlan-Howard.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d2">[{"text": "In 1876 he assumed by Royal licence the surname of Talbot in lieu of his patronymic in an unsuccessful attempt to succeed to the estates of the Earl of Shrewsbury.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d3">["hp_e45eb2b0da78e861"]</data>
  <data key="d4">False</data>
</node>
<node id="Earl of Shrewsbury">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A title whose estates Lord Edmund FitzAlan-Howard attempted to succeed to.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d2">[{"text": "In 1876 he assumed by Royal licence the surname of Talbot in lieu of his patronymic in an unsuccessful attempt to succeed to the estates of the Earl of Shrewsbury.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d3">["hp_e45eb2b0da78e861"]</data>
  <data key="d4">False</data>
</node>
<node id="the second Viscount">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The son of the first Viscount FitzAlan of Derwent, and the second Viscount himself.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d2">[{"text": "The title became extinct on the death of his son, the second Viscount, in 1962.", "chunk_id": "5339cb4abc2a7e68", "doc_id": "hp_e45eb2b0da78e861"}]</data>
  <data key="d3">["hp_e45eb2b0da78e861"]</data>
  <data key="d4">False</data>
</node>
<node id="Parramatta Female Factory">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A former penal colony building in New South Wales.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d2">[{"text": "The Parramatta Female Factory, in the former penal colony of New South Wales, is located in the grounds of Cumberland Hospital, North Parramatta, New South Wales.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d3">["hp_e4df916ac39f713d"]</data>
  <data key="d4">False</data>
</node>
<node id="Cumberland Hospital">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A hospital located in North Parramatta, New South Wales, on whose grounds the Parramatta Female Factory is situated.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d2">[{"text": "The Parramatta Female Factory, in the former penal colony of New South Wales, is located in the grounds of Cumberland Hospital, North Parramatta, New South Wales.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d3">["hp_e4df916ac39f713d"]</data>
  <data key="d4">False</data>
</node>
<node id="North Parramatta">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location in New South Wales where Cumberland Hospital is situated.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d2">[{"text": "The Parramatta Female Factory, in the former penal colony of New South Wales, is located in the grounds of Cumberland Hospital, North Parramatta, New South Wales.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d3">["hp_e4df916ac39f713d"]</data>
  <data key="d4">False</data>
</node>
<node id="Van Diemen's Land">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A former penal colony where female factories were also established.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d2">[{"text": "It was one of 13 female factories in the colonies of New South Wales and Van Diemen's Land.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d3">["hp_e4df916ac39f713d"]</data>
  <data key="d4">False</data>
</node>
<node id="Bathurst">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location in New South Wales where a female factory was established.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d2">[{"text": "In New South Wales, female factories were also established in Bathurst, Newcastle, Port Macquarie and Moreton Bay (2 factories).", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d3">["hp_e4df916ac39f713d"]</data>
  <data key="d4">False</data>
</node>
<node id="Newcastle">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location in New South Wales where a female factory was established.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d2">[{"text": "In New South Wales, female factories were also established in Bathurst, Newcastle, Port Macquarie and Moreton Bay (2 factories).", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d3">["hp_e4df916ac39f713d"]</data>
  <data key="d4">False</data>
</node>
<node id="Moreton Bay">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location in New South Wales where two female factories were established.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d2">[{"text": "In New South Wales, female factories were also established in Bathurst, Newcastle, Port Macquarie and Moreton Bay (2 factories).", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d3">["hp_e4df916ac39f713d"]</data>
  <data key="d4">False</data>
</node>
<node id="British bridewells">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A type of institution that combined functions of prisons and workhouses, influencing the idea of female factories.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d2">[{"text": "The factory idea was a combination of the functions of the British bridewells, prisons and workhouses.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d3">["hp_e4df916ac39f713d"]</data>
  <data key="d4">False</data>
</node>
<node id="prisons">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An institution for the confinement of people accused or convicted of a crime, whose functions were combined in the idea of female factories.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d2">[{"text": "The factory idea was a combination of the functions of the British bridewells, prisons and workhouses.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d3">["hp_e4df916ac39f713d"]</data>
  <data key="d4">False</data>
</node>
<node id="workhouses">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An institution where the poor were housed and set to work, whose functions were combined in the idea of female factories.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d2">[{"text": "The factory idea was a combination of the functions of the British bridewells, prisons and workhouses.", "chunk_id": "4149c8ff0afe3241", "doc_id": "hp_e4df916ac39f713d"}]</data>
  <data key="d3">["hp_e4df916ac39f713d"]</data>
  <data key="d4">False</data>
</node>
