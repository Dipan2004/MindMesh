<edge source="State House (Kenya)" target="President of Kenya">
  <data key="d5">["OFFICIAL_RESIDENCE_OF", "OFFICIAL_RESIDENCE_OF"]</data>
  <data key="d6">State House is the official residence of the President of Kenya.</data>
  <data key="d7">[{"text": "State House is the official residence of the President of Kenya.", "chunk_id": "91f35c37b306bce4", "doc_id": "hp_96146a01a8e436ac", "type": "OFFICIAL_RESIDENCE_OF"}, {"text": "As the Prime Minister's position was abolished, it has been the official residence of the president since then.", "chunk_id": "91f35c37b306bce4", "doc_id": "hp_96146a01a8e436ac", "type": "OFFICIAL_RESIDENCE_OF"}]</data>
  <data key="d8">hp_96146a01a8e436ac</data>
</edge>
<edge source="State House (Kenya)" target="Prime Minister of Kenya">
  <data key="d5">["OFFICIAL_RESIDENCE_OF"]</data>
  <data key="d6">State House was the residence of the Prime Minister of Kenya from independence until Kenya transformed into a republic.</data>
  <data key="d7">[{"text": "It was the residence of the Prime Minister of Kenya from independence until Kenya (12 Dec 1963) transformed into a republic (12 Dec 1964).", "chunk_id": "91f35c37b306bce4", "doc_id": "hp_96146a01a8e436ac", "type": "OFFICIAL_RESIDENCE_OF"}]</data>
  <data key="d8">hp_96146a01a8e436ac</data>
</edge>
<edge source="Prime Minister of Kenya" target="President of Kenya">
  <data key="d5">["SUCCESSOR_OF"]</data>
  <data key="d6">The position of Prime Minister was abolished and replaced by the President.</data>
  <data key="d7">[{"text": "As the Prime Minister's position was abolished, it has been the official residence of the president since then.", "chunk_id": "91f35c37b306bce4", "doc_id": "hp_96146a01a8e436ac", "type": "SUCCESSOR_OF"}]</data>
  <data key="d8">hp_96146a01a8e436ac</data>
</edge>
