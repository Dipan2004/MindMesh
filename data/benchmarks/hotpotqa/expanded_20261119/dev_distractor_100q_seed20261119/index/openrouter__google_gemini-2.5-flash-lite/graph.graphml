  <data key="d5">["GUARANTEES"]</data>
  <data key="d6">The First Amendment guarantees freedom of speech.</data>
  <data key="d7">[{"text": "Chaplinsky v. New Hampshire, 315 U.S. 568 (1942) , is a United States Supreme Court case in which the Court articulated the fighting words doctrine, a limitation of the First Amendment's guarantee of freedom of speech.", "chunk_id": "e32ee493ed809ece", "doc_id": "hp_3811e4729d75dd3c", "type": "GUARANTEES"}]</data>
  <data key="d8">hp_3811e4729d75dd3c</data>
</edge>
<edge source="Mötley Crüe (album)" target="Mötley Crüe">
  <data key="d5">["PART_OF"]</data>
  <data key="d6">The album Mötley Crüe is the sixth studio album by the band Mötley Crüe.</data>
  <data key="d7">[{"text": "Mötley Crüe is the eponymous sixth studio album by American heavy metal band Mötley Crüe.", "chunk_id": "c57fbc208f9c8aea", "doc_id": "hp_3835f9a65d3f6cf8", "type": "PART_OF"}]</data>
