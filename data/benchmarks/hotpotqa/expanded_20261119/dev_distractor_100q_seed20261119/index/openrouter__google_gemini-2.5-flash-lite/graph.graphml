<node id="Tennessee">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Tennessee is a state in the USA for which the tulip tree is the state tree.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}, {"text": "Tennessee is a state in the United States where Knoxville is located.", "chunk_id": "74228f58befa481c", "doc_id": "hp_ce2bd99669ff9d0d"}, {"text": "A state in the United States where Memphis is located.", "chunk_id": "acbedb4101c218db", "doc_id": "hp_f85849d8812b9ed2"}]</data>
  <data key="d2">[{"text": "The tulip tree is the state tree of Indiana, Kentucky, and Tennessee.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}, {"text": "10 Years is an American alternative metal band, formed in Knoxville, Tennessee in 1999.", "chunk_id": "74228f58befa481c", "doc_id": "hp_ce2bd99669ff9d0d"}, {"text": "Allen B. Morgan Jr.", "chunk_id": "acbedb4101c218db", "doc_id": "hp_f85849d8812b9ed2"}]</data>
  <data key="d3">["hp_2c1beb2f73cca8d4", "hp_ce2bd99669ff9d0d", "hp_f85849d8812b9ed2"]</data>
  <data key="d4">False</data>
</node>
<node id="flowering period">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The flowering period is when the Liriodendron tulipifera trees bloom.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}]</data>
  <data key="d2">[{"text": "April marks the start of the flowering period in the southern USA (except as noted below); trees at the northern limit of cultivation begin to flower in June.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}]</data>
  <data key="d3">["hp_2c1beb2f73cca8d4"]</data>
  <data key="d4">False</data>
</node>
<node id="nectar">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Nectar is a substance yielded by the flowers of the tulip tree.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}]</data>
  <data key="d2">[{"text": "The flowers are pale green or yellow (rarely white), with an orange band on the tepals; they yield large quantities of nectar.", "chunk_id": "976ede3d58522907", "doc_id": "hp_2c1beb2f73cca8d4"}]</data>
  <data key="d3">["hp_2c1beb2f73cca8d4"]</data>
  <data key="d4">False</data>
</node>
<node id="Euryops chrysanthemoides">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Euryops chrysanthemoides is a small shrub native to Southern Africa.", "chunk_id": "402abfe881c67ee7", "doc_id": "hp_2c7ea4fcf64b2cee"}]</data>
  <data key="d2">[{"text": "Euryops chrysanthemoides (with the common names African bush daisy or bull's-eye) is a small shrub native to Southern Africa that is also grown as a horticultural specimen in tropical to subtropical regions around the world.", "chunk_id": "402abfe881c67ee7", "doc_id": "hp_2c7ea4fcf64b2cee"}]</data>
  <data key="d3">["hp_2c7ea4fcf64b2cee"]</data>
  <data key="d4">False</data>
</node>
