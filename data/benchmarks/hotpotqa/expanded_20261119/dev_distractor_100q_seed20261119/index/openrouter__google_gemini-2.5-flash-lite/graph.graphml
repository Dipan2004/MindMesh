  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Andatee China Marine Fuel Service Corporation is a marine fuel wholesale and retail company based in Dalian, China.", "chunk_id": "0ae16a4e4e4c0144", "doc_id": "hp_1e1ee8b3317b2831"}]</data>
  <data key="d2">[{"text": "Andatee China Marine Fuel Service Corporation (\"Andatee\") (NASDAQ: AMCF ) is a marine fuel wholesale and retail company that is based in Dalian, China.", "chunk_id": "0ae16a4e4e4c0144", "doc_id": "hp_1e1ee8b3317b2831"}]</data>
  <data key="d3">["hp_1e1ee8b3317b2831"]</data>
  <data key="d4">False</data>
