<node id="Hollywood">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Hollywood is a location where Emilio Fernández worked in film productions.", "chunk_id": "e2bd3c61103e4d8b", "doc_id": "hp_e6718a97d51ea825"}]</data>
  <data key="d2">[{"text": "As an actor, he worked in numerous film productions in Mexico and in Hollywood.", "chunk_id": "e2bd3c61103e4d8b", "doc_id": "hp_e6718a97d51ea825"}]</data>
