  <data key="d2">[{"text": "and was also short-listed for the 2014 Man Booker Prize.", "chunk_id": "ad844d39ed13dc56", "doc_id": "hp_201f87e77880c43e"}]</data>
  <data key="d3">["hp_201f87e77880c43e"]</data>
  <data key="d4">False</data>
</node>
<node id="Zaj">
