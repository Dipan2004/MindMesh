  <data key="d6">Idaho was one of the Pacific Coast states included in Standard Oil of Iowa's marketing area.</data>
  <data key="d7">[{"text": "Standard Oil Company of Iowa was created in 1885 as a subsidiary of the Standard Oil Trust to handle marketing along the Pacific Coast states of Idaho, Oregon, Washington, California, and Arizona.", "chunk_id": "d3eeaf18714a1e1a", "doc_id": "hp_777b99a15f2523b1", "type": "MARKETING_AREA"}]</data>
