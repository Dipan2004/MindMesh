<edge source="Dick Powell" target="Edward Dmytryk">
  <data key="d5">["COLLABORATED_WITH"]</data>
  <data key="d6">Dick Powell and Edward Dmytryk worked together on "Murder, My Sweet".</data>
  <data key="d7">[{"text": "This is the second teaming of Powell and Dmytryk (after \"Murder, My Sweet\").", "chunk_id": "f4d99f18a4f175d5", "doc_id": "hp_cda28e9f1cb25d71", "type": "COLLABORATED_WITH"}]</data>
