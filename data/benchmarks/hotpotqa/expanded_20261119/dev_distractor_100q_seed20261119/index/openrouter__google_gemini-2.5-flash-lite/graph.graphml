  <data key="d2">[{"text": "Barrie Karp (born 1945 in Laredo, Texas) is an artist, independent scholar and academic.", "chunk_id": "866b0454e7429f00", "doc_id": "hp_65a971e7a10d79c8"}]</data>
  <data key="d3">["hp_65a971e7a10d79c8"]</data>
