  <data key="d7">[{"text": "He won a record 23 tennis Majors including 8 Grand Slam singles titles and before the Open Era a record 15 Pro Slam titles and a record 35 Major finals overall.", "chunk_id": "430b814f8abe3ad2", "doc_id": "hp_a8d43feead8ab699", "type": "PARTICIPATED_IN"}]</data>
