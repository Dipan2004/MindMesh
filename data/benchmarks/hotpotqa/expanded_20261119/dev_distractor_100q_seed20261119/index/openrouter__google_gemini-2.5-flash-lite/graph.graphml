<node id="advertising">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The activity or profession of producing advertisements for commercial products or services.", "chunk_id": "bfcce5e0acb26b17", "doc_id": "hp_2f330331b69ce452"}]</data>
  <data key="d2">[{"text": "The magazine included about 100 pages and was relatively cheap, mainly because it was financed largely through advertising.", "chunk_id": "bfcce5e0acb26b17", "doc_id": "hp_2f330331b69ce452"}]</data>
  <data key="d3">["hp_2f330331b69ce452"]</data>
