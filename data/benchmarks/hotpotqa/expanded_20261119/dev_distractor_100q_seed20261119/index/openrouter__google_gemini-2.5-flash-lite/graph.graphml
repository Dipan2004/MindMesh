  <data key="d7">[{"text": "Elsimar Metzker Coutinho (Pojuca, May 18, 1930) is a Brazilian scientist of Luso-Austrian descent, professor, gynecologist and television personality, and character named as \"Prince of Itapoan\", in the books of Jorge Amado which references the Coutinho family's land in Itapoan where Amado himself lived.", "chunk_id": "778c6f7f3382dee3", "doc_id": "hp_ac3086730c4518d0", "type": "BORN_IN"}]</data>
