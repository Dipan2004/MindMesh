  <data key="d7">[{"text": "Common names include \"tea plant\", \"tea shrub\", and \"tea tree\" (not to be confused with \"Melaleuca alternifolia\", the source of tea tree oil, or \"Leptospermum scoparium\", the New Zealand teatree).", "chunk_id": "a5aa45896dba5811", "doc_id": "hp_e59ae7221bb43fd2", "type": "HAS_COMMON_NAME"}]</data>
