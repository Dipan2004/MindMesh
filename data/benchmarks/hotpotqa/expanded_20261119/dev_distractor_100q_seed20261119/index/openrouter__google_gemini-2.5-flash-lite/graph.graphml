  <data key="d5">["FOUNDED_BY"]</data>
  <data key="d6">Juan Hidalgo co-founded Zaj.</data>
  <data key="d7">[{"text": "Zaj was an experimental music and performance art group formed in 1959 in Milan, Italy by composers and intermedia artists Walter Marchetti and Juan Hidalgo with the support of the American composer John Cage.", "chunk_id": "b647f648f08782f6", "doc_id": "hp_205b52451626bfb6", "type": "FOUNDED_BY"}]</data>
