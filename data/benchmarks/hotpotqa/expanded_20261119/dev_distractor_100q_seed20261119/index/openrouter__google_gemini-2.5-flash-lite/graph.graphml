<node id="Herculaneum: Voices from the Past">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "The title of the first episode of National Geographic Explorer.", "chunk_id": "f810a5fb38ef5d82", "doc_id": "hp_7baec64414b3f113"}]</data>
  <data key="d2">[{"text": "The first episode (\"Herculaneum: Voices from the Past\") was produced by WQED and featured long-time \"Explorer\" camerman Mark Knobil, who is the few staff members with the franchise during all 24 seasons.", "chunk_id": "f810a5fb38ef5d82", "doc_id": "hp_7baec64414b3f113"}]</data>
  <data key="d3">["hp_7baec64414b3f113"]</data>
  <data key="d4">False</data>
</node>
<node id="Mark Knobil">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A long-time cameraman for \"Explorer\" and one of the few staff members with the franchise during all 24 seasons.", "chunk_id": "f810a5fb38ef5d82", "doc_id": "hp_7baec64414b3f113"}]</data>
  <data key="d2">[{"text": "The first episode (\"Herculaneum: Voices from the Past\") was produced by WQED and featured long-time \"Explorer\" camerman Mark Knobil, who is the few staff members with the franchise during all 24 seasons.", "chunk_id": "f810a5fb38ef5d82", "doc_id": "hp_7baec64414b3f113"}]</data>
  <data key="d3">["hp_7baec64414b3f113"]</data>
  <data key="d4">False</data>
</node>
<node id="National Geographic Society">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "An organization that had been producing television specials for 20 years prior to \"Explorer\".", "chunk_id": "f810a5fb38ef5d82", "doc_id": "hp_7baec64414b3f113"}]</data>
  <data key="d2">[{"text": "Although the National Geographic Society had been producing specials for television for 20 years prior to \"Explorer\", the premiere of the series required an increase in production from 4 hours of programming a year to 156 hours.", "chunk_id": "f810a5fb38ef5d82", "doc_id": "hp_7baec64414b3f113"}]</data>
  <data key="d3">["hp_7baec64414b3f113"]</data>
  <data key="d4">False</data>
</node>
<node id="Tim Cowling">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An executive producer for the National Geographic Explorer series during its transition.", "chunk_id": "f810a5fb38ef5d82", "doc_id": "hp_7baec64414b3f113"}]</data>
  <data key="d2">[{"text": "Tim Cowling and Tim Kelly were the executive producers for the series during this transition.", "chunk_id": "f810a5fb38ef5d82", "doc_id": "hp_7baec64414b3f113"}]</data>
  <data key="d3">["hp_7baec64414b3f113"]</data>
  <data key="d4">False</data>
</node>
