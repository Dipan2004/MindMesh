<node id="Good Fairy Productions">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "The label that released Charlie Murphy's album \"Catch the Fire\".", "chunk_id": "bc64bf079d554c77", "doc_id": "hp_4e550c7b3015ae79"}]</data>
  <data key="d2">[{"text": "Charlie Murphy was an American singer-songwriter whose album \"Catch the Fire\" (1981), released on the Good Fairy Productions label, contained the original version of 'Burning Times', later covered by Christy Moore and Roy Bailey.", "chunk_id": "bc64bf079d554c77", "doc_id": "hp_4e550c7b3015ae79"}]</data>
