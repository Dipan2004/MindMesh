  <data key="d2">[{"text": "The screenplay by Seaton and Valentine Davies is based on the 1944 play of the same title by Julius J. Epstein and Philip G. Epstein, which was based on the memoir by Rosemary Taylor.", "chunk_id": "d929ba809a67fb56", "doc_id": "hp_b4603a37298b82a1"}]</data>
