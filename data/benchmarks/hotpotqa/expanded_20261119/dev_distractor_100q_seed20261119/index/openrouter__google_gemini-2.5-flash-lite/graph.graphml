<node id="Cúc Phương National Park">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Cúc Phương National Park is a national park located 25 km south-east of Pù Luông Nature Reserve.", "chunk_id": "4295252a903b89a1", "doc_id": "hp_c46e55e5febd3292"}]</data>
  <data key="d2">[{"text": "Pù Luông is endowed with great biodiversity, its flora and fauna is closely associated with the Cúc Phương National Park 25 km south-east.", "chunk_id": "4295252a903b89a1", "doc_id": "hp_c46e55e5febd3292"}]</data>
