<node id="Camellia sinensis">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "A species of evergreen shrub or small tree whose leaves and leaf buds are used to produce tea.", "chunk_id": "a5aa45896dba5811", "doc_id": "hp_e59ae7221bb43fd2"}]</data>
  <data key="d2">[{"text": "Camellia sinensis is a species of evergreen shrub or small tree whose leaves and leaf buds are used to produce tea.", "chunk_id": "a5aa45896dba5811", "doc_id": "hp_e59ae7221bb43fd2"}]</data>
  <data key="d3">["hp_e59ae7221bb43fd2"]</data>
