  <data key="d1">[{"text": "Boris Becker partnered with Slobodan Živojinović in the 1991 Donnay Indoor Championships – Doubles.", "chunk_id": "72b8f48b7ecf936b", "doc_id": "hp_335fb09af115eccf"}]</data>
  <data key="d2">[{"text": "Živojinović partnered Boris Becker, withdrawing prior to their semifinals match.", "chunk_id": "72b8f48b7ecf936b", "doc_id": "hp_335fb09af115eccf"}]</data>
