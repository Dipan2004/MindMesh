  <data key="d1">[{"text": "Carlos Cavazo is a songwriter for the song Eat Me Up Alive.", "chunk_id": "bb6e05f103a87cac", "doc_id": "hp_502c6729d1d13614"}]</data>
  <data key="d2">[{"text": "The song was written by Carlos Cavazo, Warren Demartini, and Stephen Pearcy for the team to have the song sound like it came out of 1984.", "chunk_id": "bb6e05f103a87cac", "doc_id": "hp_502c6729d1d13614"}]</data>
