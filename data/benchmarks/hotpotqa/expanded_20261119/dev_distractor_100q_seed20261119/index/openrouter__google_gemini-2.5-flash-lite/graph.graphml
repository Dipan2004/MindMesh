  <data key="d2">[{"text": "She turned professional in April 1996, and on February 9, 2004, she achieved her career-high singles ranking of 39, and on the same day she reached her career-high doubles ranking of 98.", "chunk_id": "12c382642ec2c72f", "doc_id": "hp_4e13c8c5b154ee99"}]</data>
