<node id="Good News Week">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An Australian satirical panel game show.", "chunk_id": "fe189654c6399c85", "doc_id": "hp_993b59bab3ae17d3"}]</data>
  <data key="d2">[{"text": "Good News Week was an Australian satirical panel game show hosted by Paul McDermott that aired from 19 April 1996 to 27 May 2000, and 11 February 2008 to 28 April 2012.", "chunk_id": "fe189654c6399c85", "doc_id": "hp_993b59bab3ae17d3"}]</data>
  <data key="d3">["hp_993b59bab3ae17d3"]</data>
