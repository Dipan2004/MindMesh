<node id="fiction">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A genre of literature that is characterized by imaginative or inventive elements.", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}]</data>
  <data key="d2">[{"text": "It contains an eclectic mix of fiction, poetry, and nonfiction, with an emphasis on speculative fiction, fantasy or slipstream.", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}]</data>
  <data key="d3">["hp_657ef87ed4283a25"]</data>
  <data key="d4">False</data>
</node>
<node id="poetry">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Literary work in which the expression of feelings and ideas is given intensity by the use of distinctive style and rhythm.", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}]</data>
  <data key="d2">[{"text": "It contains an eclectic mix of fiction, poetry, and nonfiction, with an emphasis on speculative fiction, fantasy or slipstream.", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}]</data>
  <data key="d3">["hp_657ef87ed4283a25"]</data>
  <data key="d4">False</data>
</node>
<node id="nonfiction">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "Prose writing that is based on facts, real events, and real people, such as biography or history.", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}]</data>
  <data key="d2">[{"text": "It contains an eclectic mix of fiction, poetry, and nonfiction, with an emphasis on speculative fiction, fantasy or slipstream.", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}]</data>
  <data key="d3">["hp_657ef87ed4283a25"]</data>
  <data key="d4">False</data>
</node>
<node id="speculative fiction">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A broad category of fiction encompassing genres like science fiction, fantasy, horror, and alternate history.", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}]</data>
  <data key="d2">[{"text": "It contains an eclectic mix of fiction, poetry, and nonfiction, with an emphasis on speculative fiction, fantasy or slipstream.", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}]</data>
  <data key="d3">["hp_657ef87ed4283a25"]</data>
  <data key="d4">False</data>
</node>
<node id="fantasy">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A genre of fiction that typically features magic, supernatural events, and mythical creatures.", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}, {"text": "Fantasy is a genre of fiction.", "chunk_id": "a437d927bff0c11c", "doc_id": "hp_af7dab417584284c"}, {"text": "A genre of speculative fiction.", "chunk_id": "c247beb830b15400", "doc_id": "hp_bf2ea5d754ea7865"}]</data>
  <data key="d2">[{"text": "It contains an eclectic mix of fiction, poetry, and nonfiction, with an emphasis on speculative fiction, fantasy or slipstream.", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}, {"text": "Karen Joy Fowler (born February 7, 1950) is an American author of science fiction, fantasy, and literary fiction.", "chunk_id": "a437d927bff0c11c", "doc_id": "hp_af7dab417584284c"}, {"text": "The following is a list of winners and shortlisted works of the James Tiptree Jr. Award, an annual literary prize for works of science fiction or fantasy that expand or explore one's understanding of gender.", "chunk_id": "c247beb830b15400", "doc_id": "hp_bf2ea5d754ea7865"}]</data>
  <data key="d3">["hp_657ef87ed4283a25", "hp_af7dab417584284c", "hp_bf2ea5d754ea7865"]</data>
  <data key="d4">False</data>
</node>
<node id="slipstream">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "A subgenre of speculative fiction that blends elements of science fiction, fantasy, and magical realism.", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}]</data>
  <data key="d2">[{"text": "It contains an eclectic mix of fiction, poetry, and nonfiction, with an emphasis on speculative fiction, fantasy or slipstream.", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}]</data>
  <data key="d3">["hp_657ef87ed4283a25"]</data>
  <data key="d4">False</data>
</node>
<node id="Ursula K. Le Guin">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "A prominent writer who has published in \"LCRW\".", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}]</data>
  <data key="d2">[{"text": "Link, Karen Joy Fowler, and Ursula K. Le Guin are among the most prominent of writers who have published in \"LCRW\".", "chunk_id": "4baee91ee87397fc", "doc_id": "hp_657ef87ed4283a25"}]</data>
  <data key="d3">["hp_657ef87ed4283a25"]</data>
  <data key="d4">False</data>
</node>
