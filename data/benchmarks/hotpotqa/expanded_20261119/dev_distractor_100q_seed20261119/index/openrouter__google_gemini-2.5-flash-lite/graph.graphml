  <data key="d7">[{"text": "Johnson's professional soccer administrative resume also includes holding the General Manager position with the Richmond Kickers (at the time members of the A-League/Division 2) and Major League Soccer's Kansas City Wizards (now known as Sporting Kansas City).", "chunk_id": "a5a5e072ef0dadfe", "doc_id": "hp_51337bcb6dcc3272", "type": "MEMBER_OF"}, {"text": "It is home of the Kansas City T-Bones of the independent American Association, and the former home of the Kansas City Wizards (now Sporting Kansas City) of Major League Soccer.", "chunk_id": "a27e4bf63c5efe9b", "doc_id": "hp_812fa33d19a7766e", "type": "PART_OF"}]</data>
