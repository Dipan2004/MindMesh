  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "A battle fought by the French Fifth Army and BEF in Belgium.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d2">[{"text": "The French Fifth Army and the British Expeditionary Force (BEF) advanced into Belgium and fought the Battle of Charleroi (21–23 August) and Battle of Mons (23 August), from the Meuse crossings in the east, to Mons in the west.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab"]</data>
  <data key="d4">False</data>
</node>
<node id="Meuse crossings">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Strategic points in the east from which the French Fifth Army and BEF advanced.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d2">[{"text": "The French Fifth Army and the British Expeditionary Force (BEF) advanced into Belgium and fought the Battle of Charleroi (21–23 August) and Battle of Mons (23 August), from the Meuse crossings in the east, to Mons in the west.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab"]</data>
  <data key="d4">False</data>
</node>
<node id="Mons">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A location in the west where the French Fifth Army and BEF advanced.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d2">[{"text": "The French Fifth Army and the British Expeditionary Force (BEF) advanced into Belgium and fought the Battle of Charleroi (21–23 August) and Battle of Mons (23 August), from the Meuse crossings in the east, to Mons in the west.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab"]</data>
  <data key="d4">False</data>
</node>
<node id="German troops">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Soldiers of the German forces.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d2">[{"text": "On 15 August 1914, German troops captured the Citadel of Dinant overlooking the town until it was recaptured by a French counter-attack during the afternoon.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab"]</data>
  <data key="d4">False</data>
</node>
<node id="Citadel of Dinant">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "A fortification overlooking the town of Dinant.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d2">[{"text": "On 15 August 1914, German troops captured the Citadel of Dinant overlooking the town until it was recaptured by a French counter-attack during the afternoon.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab"]</data>
  <data key="d4">False</data>
</node>
<node id="French counter-attack">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "An offensive action by French forces to retake the Citadel of Dinant.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d2">[{"text": "On 15 August 1914, German troops captured the Citadel of Dinant overlooking the town until it was recaptured by a French counter-attack during the afternoon.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab"]</data>
  <data key="d4">False</data>
</node>
<node id="French troops">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Soldiers of the French forces.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}, {"text": "The land forces of France that were defeated by British troops during the Battle of Morne de la Vierge.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}, {"text": "The opposing forces in the Battle of Amstetten, numbering roughly 10,000.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}, {"text": "French troops were encamped at Leith for twelve years.", "chunk_id": "fed038ae0c566b69", "doc_id": "hp_26004159736d7249"}, {"text": "French troops were involved in the Battle of Ligny.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}, {"text": "Military personnel from France.", "chunk_id": "45856128b6a22257", "doc_id": "hp_7e06d5c1c2ef0dce"}]</data>
  <data key="d2">[{"text": "French troops spent the next few days fortifying the Meuse crossings and exchanging fire with German troops on the east bank.", "chunk_id": "ee114cdffd80bb26", "doc_id": "hp_0ed4c305bc1ebeab"}, {"text": "During the Battle of St. Lucia the British fleet defeated a French fleet sent to reinforced the island, and a few days later French troops were soundly defeated by British troops during the Battle of Morne de la Vierge.", "chunk_id": "8523c82e4a1e2345", "doc_id": "hp_11c2671edfb8f605"}, {"text": "The total number of Russo-Austrian troops was around 6,700, while the French troops numbered roughly 10,000 troops.", "chunk_id": "0c7dbfb126626c8b", "doc_id": "hp_1fde0cb754789706"}, {"text": "The Siege of Leith ended a twelve-year encampment of French troops at Leith, the port near Edinburgh, Scotland.", "chunk_id": "fed038ae0c566b69", "doc_id": "hp_26004159736d7249"}, {"text": "In this battle, French troops of the Armée du Nord under Napoleon's command, defeated part of a Prussian army under Field Marshal Prince Blücher, near Ligny in present-day Belgium.", "chunk_id": "d6bc7645824694ce", "doc_id": "hp_45df433ff36c6e4e"}, {"text": "The Battle of Saint-Mihiel was a major World War I battle fought from 12–15 September 1918, involving the American Expeditionary Force (AEF) and 110,000 French troops under the command of General John J. Pershing of the United States against German positions.", "chunk_id": "45856128b6a22257", "doc_id": "hp_7e06d5c1c2ef0dce"}]</data>
  <data key="d3">["hp_0ed4c305bc1ebeab", "hp_11c2671edfb8f605", "hp_1fde0cb754789706", "hp_26004159736d7249", "hp_45df433ff36c6e4e", "hp_7e06d5c1c2ef0dce"]</data>
  <data key="d4">False</data>
</node>
<node id="Des McAleenan">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Des McAleenan was the goalkeeping coach for New York Red Bulls in Major League Soccer.", "chunk_id": "161d23869a931c5c", "doc_id": "hp_0f0066a63ba08f16"}]</data>
  <data key="d2">[{"text": "Des McAleenan was the goalkeeping coach for New York Red Bulls in Major League Soccer.", "chunk_id": "161d23869a931c5c", "doc_id": "hp_0f0066a63ba08f16"}]</data>
  <data key="d3">["hp_0f0066a63ba08f16"]</data>
  <data key="d4">False</data>
</node>
<node id="New York Red Bulls">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "New York Red Bulls is a professional soccer team based in Harrison, New Jersey.", "chunk_id": "161d23869a931c5c", "doc_id": "hp_0f0066a63ba08f16"}, {"text": "The New York Red Bulls is a professional soccer team that plays in Major League Soccer.", "chunk_id": "fa8b75f19429db6d", "doc_id": "hp_f0968af3cbb3184b"}]</data>
  <data key="d2">[{"text": "Des McAleenan was the goalkeeping coach for New York Red Bulls in Major League Soccer.", "chunk_id": "161d23869a931c5c", "doc_id": "hp_0f0066a63ba08f16"}, {"text": "Zach Thornton (born October 10, 1973 in Edgewood, Maryland) is a retired goalkeeper who spent 16 seasons in Major League Soccer (MLS) with the New York/New Jersey MetroStars (1996–1997), Chicago Fire (1998–2006), Colorado Rapids (2007), New York Red Bulls (2008) and Chivas USA (2008–2011).", "chunk_id": "fa8b75f19429db6d", "doc_id": "hp_f0968af3cbb3184b"}]</data>
  <data key="d3">["hp_0f0066a63ba08f16", "hp_f0968af3cbb3184b"]</data>
  <data key="d4">False</data>
</node>
<node id="Major League Soccer">
  <data key="d0">ORGANIZATION</data>
  <data key="d1">[{"text": "Major League Soccer is a professional men's soccer league in the United States and Canada.", "chunk_id": "161d23869a931c5c", "doc_id": "hp_0f0066a63ba08f16"}, {"text": "Major League Soccer is a professional soccer league in the United States and Canada.", "chunk_id": "8d4b7cbdddb5b474", "doc_id": "hp_4f29423425e909b7"}, {"text": "Major League Soccer is a professional soccer league.", "chunk_id": "a5a5e072ef0dadfe", "doc_id": "hp_51337bcb6dcc3272"}, {"text": "A professional soccer league founded in 1993, sanctioned by FIFA.", "chunk_id": "1221adbf4371c7a0", "doc_id": "hp_60e7d9ac9e049733"}, {"text": "A professional soccer league.", "chunk_id": "a27e4bf63c5efe9b", "doc_id": "hp_812fa33d19a7766e"}, {"text": "A professional soccer league in the United States and Canada.", "chunk_id": "4fff3c5799a91438", "doc_id": "hp_8d08fba9378453ea"}, {"text": "The professional soccer league in the United States and Canada.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}, {"text": "Major League Soccer is a professional soccer league in the United States and Canada.", "chunk_id": "43aad4e477f8ff50", "doc_id": "hp_daef9730974fe681"}, {"text": "The professional soccer league in the United States and Canada.", "chunk_id": "ea967b117448c7a9", "doc_id": "hp_f960cf6c89ae3463"}]</data>
  <data key="d2">[{"text": "Des McAleenan was the goalkeeping coach for New York Red Bulls in Major League Soccer.", "chunk_id": "161d23869a931c5c", "doc_id": "hp_0f0066a63ba08f16"}, {"text": "Shkëlzen Taib Gashi (born 15 July 1988) is an Albanian professional footballer who plays as a midfielder and forward for Major League Soccer club Colorado Rapids and the Albania national team.", "chunk_id": "8d4b7cbdddb5b474", "doc_id": "hp_4f29423425e909b7"}, {"text": "Johnson's professional soccer administrative resume also includes holding the General Manager position with the Richmond Kickers (at the time members of the A-League/Division 2) and Major League Soccer's Kansas City Wizards (now known as Sporting Kansas City).", "chunk_id": "a5a5e072ef0dadfe", "doc_id": "hp_51337bcb6dcc3272"}, {"text": "The 2010 Major League Soccer season was the 98th season of FIFA-sanctioned soccer, the 32nd with a national first-division league, in the United States and Canada, and the 15th in MLS history.", "chunk_id": "1221adbf4371c7a0", "doc_id": "hp_60e7d9ac9e049733"}, {"text": "It is home of the Kansas City T-Bones of the independent American Association, and the former home of the Kansas City Wizards (now Sporting Kansas City) of Major League Soccer.", "chunk_id": "a27e4bf63c5efe9b", "doc_id": "hp_812fa33d19a7766e"}, {"text": "Sporting Kansas City (formerly known as Kansas City Wiz and Kansas City Wizards) since the team's first Major League Soccer season in 1996.", "chunk_id": "4fff3c5799a91438", "doc_id": "hp_8d08fba9378453ea"}, {"text": "MLS Cup 2010, the 15th edition of Major League Soccer's championship match, was played between the Colorado Rapids and FC Dallas to decide the champion of the 2010 season.", "chunk_id": "86885df86b4bec3d", "doc_id": "hp_b8c5eba035057a5e"}, {"text": "Ian Francis Joyce (born July 12, 1985) is an American soccer player who most recently played for Major League Soccer club Colorado Rapids.", "chunk_id": "43aad4e477f8ff50", "doc_id": "hp_daef9730974fe681"}, {"text": "MLS Cup 2004, the ninth edition of Major League Soccer's championship match, was played between D.C. United and the Kansas City Wizards to decide the champion of the 2004 season.", "chunk_id": "ea967b117448c7a9", "doc_id": "hp_f960cf6c89ae3463"}]</data>
  <data key="d3">["hp_0f0066a63ba08f16", "hp_4f29423425e909b7", "hp_51337bcb6dcc3272", "hp_60e7d9ac9e049733", "hp_812fa33d19a7766e", "hp_8d08fba9378453ea", "hp_b8c5eba035057a5e", "hp_daef9730974fe681", "hp_f960cf6c89ae3463"]</data>
  <data key="d4">False</data>
</node>
<node id="Ireland">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "Ireland is an island in the North Atlantic.", "chunk_id": "161d23869a931c5c", "doc_id": "hp_0f0066a63ba08f16"}, {"text": "Ireland is a country where Alexander Amini is from.", "chunk_id": "fd7d14febf5321c2", "doc_id": "hp_3b72e36a921b4635"}]</data>
  <data key="d2">[{"text": "Born in Ireland, he was with the MetroStars franchise from 2002 until his firing on 28 February 2011.", "chunk_id": "161d23869a931c5c", "doc_id": "hp_0f0066a63ba08f16"}, {"text": "Alexander Amini (born April 29, 1995) is an American scientist from Dublin, Ireland, currently studying at the Massachusetts Institute of Technology (MIT) in America.", "chunk_id": "fd7d14febf5321c2", "doc_id": "hp_3b72e36a921b4635"}]</data>
  <data key="d3">["hp_0f0066a63ba08f16", "hp_3b72e36a921b4635"]</data>
  <data key="d4">False</data>
</node>
