<node id="ATP singles titles">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "ATP singles titles are championships won by male tennis players in singles matches.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}]</data>
  <data key="d2">[{"text": "To date, Gasquet has won fourteen ATP singles titles.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}]</data>
  <data key="d3">["hp_b9191c704d51a80c"]</data>
  <data key="d4">False</data>
</node>
<node id="2005 Hamburg Masters">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 2005 Hamburg Masters was a tennis tournament where Richard Gasquet was a runner-up.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}]</data>
  <data key="d2">[{"text": "He was also the runner-up at 2005 Hamburg Masters and Canada Masters in 2006 and 2012, a semi-finalist at the 2007 Wimbledon Championships and 2013 US Open and a bronze medallist in men's doubles with Julien Benneteau at the 2012 London Olympics.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}]</data>
  <data key="d3">["hp_b9191c704d51a80c"]</data>
  <data key="d4">False</data>
</node>
<node id="Canada Masters">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The Canada Masters is a tennis tournament where Richard Gasquet was a runner-up in 2006 and 2012.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}]</data>
  <data key="d2">[{"text": "He was also the runner-up at 2005 Hamburg Masters and Canada Masters in 2006 and 2012, a semi-finalist at the 2007 Wimbledon Championships and 2013 US Open and a bronze medallist in men's doubles with Julien Benneteau at the 2012 London Olympics.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}]</data>
  <data key="d3">["hp_b9191c704d51a80c"]</data>
  <data key="d4">False</data>
</node>
<node id="2007 Wimbledon Championships">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 2007 Wimbledon Championships was a tennis tournament where Richard Gasquet was a semi-finalist.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}, {"text": "The 2007 Wimbledon Championships was a tennis tournament where Richard Gasquet reached the semifinals in singles.", "chunk_id": "9427c18f95847c63", "doc_id": "hp_be33f525d9693352"}]</data>
  <data key="d2">[{"text": "He was also the runner-up at 2005 Hamburg Masters and Canada Masters in 2006 and 2012, a semi-finalist at the 2007 Wimbledon Championships and 2013 US Open and a bronze medallist in men's doubles with Julien Benneteau at the 2012 London Olympics.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}, {"text": "In singles, his best achievements in Grand Slams are reaching the semifinals of the 2007 and 2015 Wimbledon Championships and the semifinals of the 2013 US Open.", "chunk_id": "9427c18f95847c63", "doc_id": "hp_be33f525d9693352"}]</data>
  <data key="d3">["hp_b9191c704d51a80c", "hp_be33f525d9693352"]</data>
  <data key="d4">False</data>
</node>
<node id="2013 US Open">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 2013 US Open was a tennis tournament where Richard Gasquet was a semi-finalist.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}, {"text": "The 2013 US Open was a tennis tournament where Richard Gasquet reached the semifinals in singles.", "chunk_id": "9427c18f95847c63", "doc_id": "hp_be33f525d9693352"}]</data>
  <data key="d2">[{"text": "He was also the runner-up at 2005 Hamburg Masters and Canada Masters in 2006 and 2012, a semi-finalist at the 2007 Wimbledon Championships and 2013 US Open and a bronze medallist in men's doubles with Julien Benneteau at the 2012 London Olympics.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}, {"text": "In singles, his best achievements in Grand Slams are reaching the semifinals of the 2007 and 2015 Wimbledon Championships and the semifinals of the 2013 US Open.", "chunk_id": "9427c18f95847c63", "doc_id": "hp_be33f525d9693352"}]</data>
  <data key="d3">["hp_b9191c704d51a80c", "hp_be33f525d9693352"]</data>
  <data key="d4">False</data>
</node>
<node id="men's doubles">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "Men's doubles is a category in tennis where two male players compete as a team.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}]</data>
  <data key="d2">[{"text": "He was also the runner-up at 2005 Hamburg Masters and Canada Masters in 2006 and 2012, a semi-finalist at the 2007 Wimbledon Championships and 2013 US Open and a bronze medallist in men's doubles with Julien Benneteau at the 2012 London Olympics.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}]</data>
  <data key="d3">["hp_b9191c704d51a80c"]</data>
  <data key="d4">False</data>
</node>
<node id="Julien Benneteau">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "Julien Benneteau is a tennis player who won a bronze medal in men's doubles with Richard Gasquet at the 2012 London Olympics.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}, {"text": "Julien Benneteau is a doubles partner of Richard Gasquet who won an Olympic bronze medal with him in 2012.", "chunk_id": "9427c18f95847c63", "doc_id": "hp_be33f525d9693352"}]</data>
  <data key="d2">[{"text": "He was also the runner-up at 2005 Hamburg Masters and Canada Masters in 2006 and 2012, a semi-finalist at the 2007 Wimbledon Championships and 2013 US Open and a bronze medallist in men's doubles with Julien Benneteau at the 2012 London Olympics.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}, {"text": "He also won an Olympic bronze medal in 2012 with his doubles partner Julien Benneteau.", "chunk_id": "9427c18f95847c63", "doc_id": "hp_be33f525d9693352"}]</data>
  <data key="d3">["hp_b9191c704d51a80c", "hp_be33f525d9693352"]</data>
  <data key="d4">False</data>
</node>
<node id="2012 London Olympics">
  <data key="d0">EVENT</data>
  <data key="d1">[{"text": "The 2012 London Olympics was an event where Richard Gasquet and Julien Benneteau won a bronze medal in men's doubles.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}]</data>
  <data key="d2">[{"text": "He was also the runner-up at 2005 Hamburg Masters and Canada Masters in 2006 and 2012, a semi-finalist at the 2007 Wimbledon Championships and 2013 US Open and a bronze medallist in men's doubles with Julien Benneteau at the 2012 London Olympics.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}]</data>
  <data key="d3">["hp_b9191c704d51a80c"]</data>
  <data key="d4">False</data>
</node>
<node id="World No. 7">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "World No. 7 is the highest singles ranking achieved by Richard Gasquet in his career.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}]</data>
  <data key="d2">[{"text": "On July 9, 2007, Gasquet achieved a career high singles ranking of World No. 7.", "chunk_id": "e69c921a6e0f69d1", "doc_id": "hp_b9191c704d51a80c"}]</data>
  <data key="d3">["hp_b9191c704d51a80c"]</data>
  <data key="d4">False</data>
</node>
<node id="Pluck and Luck: Complete Stories of Adventure">
  <data key="d0">OTHER</data>
  <data key="d1">[{"text": "An American dime novel that was the longest-running dime novel.", "chunk_id": "2d777d1f8f167140", "doc_id": "hp_b98eb5ae42298539"}]</data>
  <data key="d2">[{"text": "Pluck and Luck: Complete Stories of Adventure was an American dime novel first published by Frank Tousey and was the longest-running dime novel.", "chunk_id": "2d777d1f8f167140", "doc_id": "hp_b98eb5ae42298539"}]</data>
  <data key="d3">["hp_b98eb5ae42298539"]</data>
  <data key="d4">False</data>
</node>
<node id="Frank Tousey">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The publisher of the American dime novel Pluck and Luck: Complete Stories of Adventure.", "chunk_id": "2d777d1f8f167140", "doc_id": "hp_b98eb5ae42298539"}]</data>
