<node id="Jacques Demy">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "The director of the 1963 French film Bay of Angels.", "chunk_id": "8e856130db352aa4", "doc_id": "hp_0a979625199eaa39"}, {"text": "The director of the 1961 film Lola.", "chunk_id": "f58d74090a79d846", "doc_id": "hp_231ed622feb34588"}, {"text": "A French director, lyricist, and screenwriter.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}, {"text": "A French writer-director who made the film 'Model Shop'.", "chunk_id": "3488ae8198c6ceab", "doc_id": "hp_654ac6630b014afb"}, {"text": "The director of the 1982 French film Une chambre en ville.", "chunk_id": "79ecca5757e35f6c", "doc_id": "hp_a7f67f1b79caebb6"}, {"text": "The director of the 1970 French musical film Donkey Skin.", "chunk_id": "8d587d634a322b19", "doc_id": "hp_f52c762de35c34e7"}]</data>
  <data key="d2">[{"text": "Bay of Angels (French: \"La baie des anges\" ) is a 1963 French film directed by Jacques Demy.", "chunk_id": "8e856130db352aa4", "doc_id": "hp_0a979625199eaa39"}, {"text": "Lola, is a 1961 romantic drama film, the debut film directed by Jacques Demy as a tribute to director Max Ophüls and is described by Demy as a \"musical without music\".", "chunk_id": "f58d74090a79d846", "doc_id": "hp_231ed622feb34588"}, {"text": "Jacques Demy (] ; 5 June 1931 – 27 October 1990) was a French director, lyricist, and screenwriter.", "chunk_id": "27dd0cc4171a09f6", "doc_id": "hp_4627d420baa4b1fd"}, {"text": "Model Shop is a 1969 American film by French writer-director Jacques Demy starring Gary Lockwood, Alexandra Hay and Anouk Aimée and featuring a guest appearance by Spirit who also recorded the soundtrack.", "chunk_id": "3488ae8198c6ceab", "doc_id": "hp_654ac6630b014afb"}, {"text": "Une chambre en ville (also known as A Room in Town) is a 1982 French film directed by Jacques Demy, with music by Michel Colombier, and starring Dominique Sanda, Danielle Darrieux, and Michel Piccoli.", "chunk_id": "79ecca5757e35f6c", "doc_id": "hp_a7f67f1b79caebb6"}, {"text": "Peau d'Âne (English: Donkey Skin) is a 1970 French musical film directed by Jacques Demy.", "chunk_id": "8d587d634a322b19", "doc_id": "hp_f52c762de35c34e7"}]</data>
  <data key="d3">["hp_0a979625199eaa39", "hp_231ed622feb34588", "hp_4627d420baa4b1fd", "hp_654ac6630b014afb", "hp_a7f67f1b79caebb6", "hp_f52c762de35c34e7"]</data>
  <data key="d4">False</data>
</node>
<node id="Jeanne Moreau">
  <data key="d0">PERSON</data>
  <data key="d1">[{"text": "An actress who starred in the 1963 film Bay of Angels.", "chunk_id": "8e856130db352aa4", "doc_id": "hp_0a979625199eaa39"}]</data>
  <data key="d2">[{"text": "Starring Jeanne Moreau and Claude Mann, it is Demy's second film and deals with the subject of gambling.", "chunk_id": "8e856130db352aa4", "doc_id": "hp_0a979625199eaa39"}]</data>
  <data key="d3">["hp_0a979625199eaa39"]</data>
