<node id="São Paulo">
  <data key="d0">LOCATION</data>
  <data key="d1">[{"text": "The city in Brazil where the Native Tour finished.", "chunk_id": "fbf2e81187688813", "doc_id": "hp_bf77c9d36b5389d5"}, {"text": "São Paulo is a state in Brazil where Mendoncia velloziana grows.", "chunk_id": "954299a74c533cc7", "doc_id": "hp_e7f8a5633759d23e"}]</data>
  <data key="d2">[{"text": "The tour began on April 2, 2013, in Milan, Italy and finished on September 20, 2015, in São Paulo, Brazil.", "chunk_id": "fbf2e81187688813", "doc_id": "hp_bf77c9d36b5389d5"}, {"text": "This plant grows in following states of Brazil: Bahia, Ceará Minas Gerais Rio de Janeiro, São Paulo, Paraná and Santa Catarina, and it is usually visited by the hummingbirds.", "chunk_id": "954299a74c533cc7", "doc_id": "hp_e7f8a5633759d23e"}]</data>
  <data key="d3">["hp_bf77c9d36b5389d5", "hp_e7f8a5633759d23e"]</data>
  <data key="d4">False</data>
</node>
