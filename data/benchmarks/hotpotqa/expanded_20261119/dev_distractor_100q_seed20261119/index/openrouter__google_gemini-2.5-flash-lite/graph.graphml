  <data key="d6">Gajendra Singh Sareen is the founder of Omni United Pte. Ltd.</data>
  <data key="d7">[{"text": "Gajendra Singh Sareen (born 7 Nov 1966) is a businessman of Indian origin and the founder, CEO and president of Singapore headquartered tire manufacturer and distributor Omni United Pte. Ltd.", "chunk_id": "e133f6d50efcfbac", "doc_id": "hp_90e4cdc4e01bfe58", "type": "FOUNDED_BY"}, {"text": "Gajendra Singh Sareen (born 7 Nov 1966) is a businessman of Indian origin and the founder, CEO and president of Singapore headquartered tire manufacturer and distributor Omni United Pte. Ltd.", "chunk_id": "e133f6d50efcfbac", "doc_id": "hp_90e4cdc4e01bfe58", "type": "CEO"}, {"text": "Gajendra Singh Sareen (born 7 Nov 1966) is a businessman of Indian origin and the founder, CEO and president of Singapore headquartered tire manufacturer and distributor Omni United Pte. Ltd.", "chunk_id": "e133f6d50efcfbac", "doc_id": "hp_90e4cdc4e01bfe58", "type": "PRESIDENT"}, {"text": "He founded Omni United in 2003 and has since received numerous entrepreneurship awards including \"Distinguished Business Leader Award\", \"DBS Insignia Spirit of Vision Prestige Award\" and in 2012 was named to Fortune magazine's list of \"Asia's Hottest People in Business\".", "chunk_id": "e133f6d50efcfbac", "doc_id": "hp_90e4cdc4e01bfe58", "type": "FOUNDED_BY"}]</data>
  <data key="d8">hp_90e4cdc4e01bfe58</data>
</edge>
