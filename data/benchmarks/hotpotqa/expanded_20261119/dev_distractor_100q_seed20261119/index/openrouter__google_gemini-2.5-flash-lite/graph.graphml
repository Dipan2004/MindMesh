  <data key="d1">[{"text": "A former labelmate who provided guest vocals on the song 'Hot Girls'.", "chunk_id": "4fbe89b0d5faec6f", "doc_id": "hp_233600b46cd7c338"}]</data>
  <data key="d2">[{"text": "The song features guest vocals by former labelmate Lil Wayne and production by frequent collaborator Bryan-Michael Cox.", "chunk_id": "4fbe89b0d5faec6f", "doc_id": "hp_233600b46cd7c338"}]</data>
