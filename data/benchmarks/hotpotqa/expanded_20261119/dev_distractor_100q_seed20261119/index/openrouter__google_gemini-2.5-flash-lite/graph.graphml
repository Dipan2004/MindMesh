  <data key="d1">[{"text": "A spiritual belief system associated with paganism.", "chunk_id": "bc64bf079d554c77", "doc_id": "hp_4e550c7b3015ae79"}]</data>
  <data key="d2">[{"text": "The album is notable for addressing LGBT issues and pagan spirituality within its lyrics.", "chunk_id": "bc64bf079d554c77", "doc_id": "hp_4e550c7b3015ae79"}]</data>
