</node>
<node id="Carl Flesch tradition">
  <data key="d0">CONCEPT</data>
  <data key="d1">[{"text": "The Carl Flesch tradition was a violinistic tradition of which Alma Moodie and Max Rostal were considered the greatest proponents.", "chunk_id": "5978fb5d2c7a87fb", "doc_id": "hp_ac759163e3bcf4aa"}]</data>
  <data key="d2">[{"text": "She and Max Rostal were regarded as the greatest proponents of the Carl Flesch tradition.", "chunk_id": "5978fb5d2c7a87fb", "doc_id": "hp_ac759163e3bcf4aa"}]</data>
  <data key="d3">["hp_ac759163e3bcf4aa"]</data>
