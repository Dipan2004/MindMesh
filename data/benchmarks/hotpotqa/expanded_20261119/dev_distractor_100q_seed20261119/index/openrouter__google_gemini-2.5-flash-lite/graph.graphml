<edge source="Darland's Lake Nature Reserve" target="England">
  <data key="d5">["LOCATED_IN"]</data>
  <data key="d6">Darland's Lake Nature Reserve is located in England.</data>
  <data key="d7">[{"text": "Darland's Lake Nature Reserve is a nature reserve south of Totteridge Village in Barnet, England.", "chunk_id": "71ca2b70887b01d6", "doc_id": "hp_e61b677c687681e5", "type": "LOCATED_IN"}]</data>
