  <data key="d8">hp_b81c660e7e08cae6</data>
</edge>
<edge source="France" target="Ferdinand de Lesseps">
  <data key="d5">["FOUNDED_BY"]</data>
  <data key="d6">France supported Ferdinand de Lesseps' efforts to build the canal.</data>
  <data key="d7">[{"text": "France made the first serious attempt to build a canal across the isthmus. The project was led by Ferdinand de Lesseps, the diplomat who had earlier developed the Suez Canal in Egypt.", "chunk_id": "11244e0939bd5300", "doc_id": "hp_b81c660e7e08cae6", "type": "FOUNDED_BY"}]</data>
  <data key="d8">hp_b81c660e7e08cae6</data>
</edge>
