  <data key="d6">Ferdinand de Lesseps led the project to build the Panama Canal.</data>
  <data key="d7">[{"text": "The project was led by Ferdinand de Lesseps, the diplomat who had earlier developed the Suez Canal in Egypt.", "chunk_id": "11244e0939bd5300", "doc_id": "hp_b81c660e7e08cae6", "type": "FOUNDED_BY"}, {"text": "The project was led by Ferdinand de Lesseps, the diplomat who had earlier developed the Suez Canal in Egypt.", "chunk_id": "11244e0939bd5300", "doc_id": "hp_b81c660e7e08cae6", "type": "PART_OF"}]</data>
