  <data key="d5">["FOUNDED_BY"]</data>
  <data key="d6">The United States took over the project to build the Panama Canal in 1904</data>
  <data key="d7">[{"text": "The United States took over the project in 1904, shortly after Panama became independent from Colombia.", "chunk_id": "f4303e0167d12798", "doc_id": "hp_c69cf471cb591ee9", "type": "FOUNDED_BY"}]</data>
  <data key="d8">hp_c69cf471cb591ee9</data>
