  <data key="d7">[{"text": "The new Agua Clara Locks on the Atlantic side and the Cocoli Locks on the Pacific side can handle much larger vessels, known as Neopanamax ships.", "chunk_id": "cea62c09c54ebb18", "doc_id": "hp_fc18f9bfeafb4ad2", "type": "PART_OF"}]</data>
