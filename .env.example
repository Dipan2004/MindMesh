# See CONFIG.md for full documentation of every variable below.

# --- Chunking ---
CHUNK_SIZE_EXTRACTION=450
CHUNK_OVERLAP_PCT=0.12
CHUNK_SIZE_CITATION=1200

# --- Extraction ---
MAX_GLEANINGS=1

# --- Embedding ---
EMBEDDING_MODEL=nomic-embed-text

# --- Zvec ---
ZVEC_COLLECTION_ENTITIES=entities_v1
ZVEC_COLLECTION_CHUNKS=chunks_v1
ZVEC_TOP_K_ENTRY=8
ZVEC_TOP_N_FLAT=8

# --- Graph retrieval ---
BFS_HOP_DEPTH=2
RANKING_METHOD=pagerank
TOP_N_CANDIDATES_AFTER_RANKING=20
TOP_N_FINAL_EVIDENCE=6

# --- Serialization ---
SERIALIZATION_FORMAT=toon

# --- LLM / mode ---
LLM_MODE=local
SLM_MODEL=qwen3:4b
# API_KEY is pasted in the UI at runtime, never stored here

# --- Observability ---
LANGCHAIN_PROJECT=graphrag-lite-eval
# LANGCHAIN_API_KEY=          # your LangSmith key, local dev only

# --- Cache ---
CACHE_BACKEND=diskcache
CACHE_DIR=data/cache

# --- Stress test ---
STRESS_CONCURRENCY_LEVELS=10,50,200,1000
STRESS_TIMEOUT_S=30
