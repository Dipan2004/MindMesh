# See CONFIG.md for full documentation of every variable below.

# --- Chunking ---
CHUNK_SIZE_EXTRACTION=450
CHUNK_OVERLAP_PCT=0.12
CHUNK_SIZE_CITATION=1200
CHUNKING_STRATEGY=markdown_aware

# --- Extraction ---
MAX_GLEANINGS=1
EXTRACTION_TEMPERATURE=0.0
EXTRACTION_SEED=42
LLM_NUM_PREDICT=4096
# Runtime context window. Ollama's default 4096 is NOT a hard cap on
# generation -- Ollama grows the runtime context to fit num_predict (measured:
# 8750 tokens in one request, prompt_eval=558 + eval=8192). But a request
# served by a runner still at 4096 can only generate (4096 - prompt tokens),
# so a 403-token extraction prompt leaves only 3693. Raising this to 8192
# moved that same request to the full num_predict. See CONFIG.md section 2.
LLM_NUM_CTX=8192
# Frequency penalty. 0.25 is the measured sweet spot (2026-10-22).
# Unlike repeat_penalty -- which applies the same flat penalty to every token
# ever seen -- this scales with HOW MANY TIMES a token has appeared, which is
# what breaks a degenerate repetition loop. On the one chunk that looped
# (4af3dc8c): no penalty = truncated and unparseable; 0.25 = 21 entities /
# 15 relationships, zero repetition; 0.5 and 0.75 stop the loop but
# under-extract; 1.0+ truncate the extraction mid-field.
# CAVEAT: on the full corpus this reduced but did not eliminate the failure
# rate (39/42 chunks parsed). The model is bistable -- it settles into one
# of several stable attractors depending on the server's numeric state, so
# a chunk that parses in one session can loop in the next. Retry a failed
# chunk with escalated settings; do not treat one success as proof.
# Set to 0 to disable.
LLM_FREQUENCY_PENALTY=0.25
# Escalation ladder for a chunk whose extraction failed to parse. Each entry
# is a frequency_penalty to retry with, in order, after the first attempt
# fails. The model is bistable, so a retry with different settings lands in
# a different attractor and has a good chance of succeeding. Set to [] to
# disable retries (a failed chunk is then recorded and skipped).
LLM_RETRY_FREQUENCY_PENALTIES=[0.5,1.0]
# Reasoning ("thinking") mode: auto | on | off
# qwen3-family models are reasoning models -- their thinking text eats the
# num_predict budget and leaves the visible response empty. Use "off" for them.
LLM_THINK=auto

# --- Embedding ---
EMBEDDING_MODEL=nomic-embed-text

# --- Zvec ---
# ZVEC_ROOT is where the Zvec collections live. Leave empty to use CACHE_DIR.
# Set it explicitly when CACHE_DIR points at a private experiment cache --
# the canonical collections are at data/cache.
ZVEC_ROOT=data/cache
ZVEC_COLLECTION_ENTITIES=entities_v1
ZVEC_COLLECTION_CHUNKS=chunks_v1
ZVEC_TOP_K_ENTRY=8
ZVEC_TOP_N_FLAT=8

# --- Graph retrieval ---
BFS_HOP_DEPTH=2
RANKING_METHOD=pagerank
TOP_N_CANDIDATES_AFTER_RANKING=20
TOP_N_FINAL_EVIDENCE=6
PIPELINE_B_SIM_WEIGHT=0.85
PIPELINE_B_PR_WEIGHT=0.15
PIPELINE_B_DROP_TYPE_LABELS=1

# --- Serialization ---
SERIALIZATION_FORMAT=toon

# --- LLM / mode ---
LLM_MODE=local
SLM_MODEL=qwen2.5:1.5b
LLM_TIMEOUT_S=300.0
ZVEC_ADOPT_UNTAGGED=0
# API_KEY is pasted in the UI at runtime, never stored here

# --- Observability ---
LANGCHAIN_PROJECT=graphrag-lite-eval
# LANGCHAIN_API_KEY=          # your LangSmith key, local dev only

# --- Cache ---
CACHE_BACKEND=diskcache
CACHE_DIR=data/cache

# --- Stress test ---
STRESS_CONCURRENCY_LEVELS=[10,50,200,1000]
STRESS_TIMEOUT_S=30
